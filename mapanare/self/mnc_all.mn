// ---- ElseClause kind + accessors ------------------------------------------

pub fn else_clause_kind(ec: ElseClause) -> String:
    match ec:
        ElseBlock(_) => { return "else_block" }
        ElseIf(_, _, _) => { return "else_if" }

pub fn else_clause_block(ec: ElseClause) -> Block:
    match ec { ElseBlock(b) => { return b }, _ => { let s: List<Stmt> = []; return new_block(make_span(0,0,0,0), s) } }
pub fn else_clause_cond(ec: ElseClause) -> Expr:
    match ec { ElseIf(c, _, _) => { return c }, _ => { return Expr::NoneLit } }
pub fn else_clause_then(ec: ElseClause) -> Block:
    match ec { ElseIf(_, b, _) => { return b }, _ => { let s: List<Stmt> = []; return new_block(make_span(0,0,0,0), s) } }
pub fn else_clause_else(ec: ElseClause) -> Option<ElseClause>:
    match ec { ElseIf(_, _, e) => { return e }, _ => { return none } }

// ===== lexer.mn =====
// lexer.mn — Mapanare lexer, self-hosted.
// Tokenizes .mn source files into a token stream.
// Character-by-character scanner replacing the Lark-based Python lexer.


// ---------------------------------------------------------------------------
// Token
// ---------------------------------------------------------------------------

struct Token:
    tok_type: String
    value: String
    line: Int
    column: Int
    end_line: Int
    end_column: Int

// ---------------------------------------------------------------------------
// LexError
// ---------------------------------------------------------------------------

struct LexError:
    message: String
    line: Int
    column: Int
    filename: String

// ---------------------------------------------------------------------------
// Lexer state
// ---------------------------------------------------------------------------

struct Lexer:
    source: String
    pos: Int
    line: Int
    column: Int
    filename: String

// ---------------------------------------------------------------------------
// Constructor functions
// ---------------------------------------------------------------------------

fn new_token(tok_type: String, value: String, line: Int, col: Int, end_line: Int, end_col: Int) -> Token = new Token { tok_type: tok_type, value: value, line: line, column: col, end_line: end_line, end_column: end_col }

fn new_lexer(source: String, pos: Int, line: Int, column: Int, filename: String) -> Lexer = new Lexer { source: source, pos: pos, line: line, column: column, filename: filename }

// ---------------------------------------------------------------------------
// Keywords (28 total)
// ---------------------------------------------------------------------------

fn is_keyword(name: String) -> Bool:
    if name == "let" { return true }
    if name == "pon" { return true }
    if name == "const" { return true }
    if name == "mut" { return true }
    if name == "fn" { return true }
    if name == "return" { return true }
    if name == "da" { return true }
    if name == "pub" { return true }
    if name == "self" { return true }
    if name == "yo" { return true }
    if name == "agent" { return true }
    if name == "spawn" { return true }
    if name == "sync" { return true }
    if name == "signal" { return true }
    if name == "stream" { return true }
    if name == "pipe" { return true }
    if name == "if" { return true }
    if name == "si" { return true }
    if name == "else" { return true }
    if name == "sino" { return true }
    if name == "match" { return true }
    if name == "for" { return true }
    if name == "cada" { return true }
    if name == "while" { return true }
    if name == "mien" { return true }
    if name == "in" { return true }
    if name == "en" { return true }
    if name == "type" { return true }
    if name == "tipo" { return true }
    if name == "struct" { return true }
    if name == "enum" { return true }
    if name == "impl" { return true }
    if name == "trait" { return true }
    if name == "modo" { return true }
    if name == "way" { return true }
    if name == "import" { return true }
    if name == "usa" { return true }
    if name == "export" { return true }
    if name == "extern" { return true }
    if name == "true" { return true }
    if name == "false" { return true }
    if name == "none" { return true }
    if name == "nada" { return true }
    if name == "new" { return true }
    if name == "input" { return true }
    if name == "output" { return true }
    if name == "assert" { return true }
    if name == "break" { return true }
    if name == "sal" { return true }
    if name == "continue" { return true }
    if name == "sigue" { return true }
    // v5.14.1 B.1: pass — required to mark empty colon-block bodies.
    // Mirror Python bootstrap (mapanare/parser.py:KW_PASS).
    if name == "pass" { return true }
    if name == "di" { return true }
    // v4.78.0: "const" moved to top of is_keyword (near "let")
    // v4.68.0: "async" / "await" restored (Arc 8). See v4.67.0/DESIGN.md.
    if name == "async" { return true }
    if name == "await" { return true }
    // v5.6.0 (Sh.6): "Tensor" keyword enables Tensor<T>[...] literal syntax.
    // Python grammar has `KW_TENSOR: "Tensor"` (mapanare.lark:426); mirror here
    // so parse_tensor_lit's `tt == "KW_TENSOR"` check actually fires.
    if name == "Tensor" { return true }
    return false

fn keyword_token_type(name: String) -> String:
    if name == "let" { return "KW_LET" }
    if name == "pon" { return "KW_LET" }
    if name == "const" { return "KW_CONST" }
    if name == "mut" { return "KW_MUT" }
    if name == "fn" { return "KW_FN" }
    if name == "return" { return "KW_RETURN" }
    if name == "da" { return "KW_RETURN" }
    if name == "pub" { return "KW_PUB" }
    if name == "self" { return "KW_SELF" }
    if name == "yo" { return "KW_SELF" }
    if name == "agent" { return "KW_AGENT" }
    if name == "spawn" { return "KW_SPAWN" }
    if name == "sync" { return "KW_SYNC" }
    if name == "signal" { return "KW_SIGNAL" }
    if name == "stream" { return "KW_STREAM" }
    if name == "pipe" { return "KW_PIPE" }
    if name == "if" { return "KW_IF" }
    if name == "si" { return "KW_IF" }
    if name == "else" { return "KW_ELSE" }
    if name == "sino" { return "KW_ELSE" }
    if name == "match" { return "KW_MATCH" }
    if name == "for" { return "KW_FOR" }
    if name == "cada" { return "KW_FOR" }
    if name == "while" { return "KW_WHILE" }
    if name == "mien" { return "KW_WHILE" }
    if name == "in" { return "KW_IN" }
    if name == "en" { return "KW_IN" }
    if name == "type" { return "KW_TYPE" }
    if name == "tipo" { return "KW_TYPE" }
    if name == "struct" { return "KW_STRUCT" }
    if name == "enum" { return "KW_ENUM" }
    if name == "impl" { return "KW_IMPL" }
    if name == "trait" { return "KW_TRAIT" }
    if name == "modo" { return "KW_TRAIT" }
    if name == "way" { return "KW_TRAIT" }
    if name == "import" { return "KW_IMPORT" }
    if name == "usa" { return "KW_IMPORT" }
    if name == "export" { return "KW_EXPORT" }
    if name == "extern" { return "KW_EXTERN" }
    if name == "true" { return "KW_TRUE" }
    if name == "false" { return "KW_FALSE" }
    if name == "none" { return "KW_NONE" }
    if name == "nada" { return "KW_NONE" }
    if name == "new" { return "KW_NEW" }
    if name == "input" { return "KW_INPUT" }
    if name == "output" { return "KW_OUTPUT" }
    if name == "assert" { return "KW_ASSERT" }
    if name == "break" { return "KW_BREAK" }
    if name == "sal" { return "KW_BREAK" }
    if name == "continue" { return "KW_CONTINUE" }
    if name == "sigue" { return "KW_CONTINUE" }
    if name == "pass" { return "KW_PASS" }
    if name == "di" { return "KW_DI" }
    // v4.78.0: "const" moved near "let" above (CARRY_FORWARD A10b)
    // v4.68.0: "async" / "await" restored (Arc 8). See v4.67.0/DESIGN.md.
    if name == "async" { return "KW_ASYNC" }
    if name == "await" { return "KW_AWAIT" }
    // v5.6.0 (Sh.6): Tensor becomes a keyword so `Tensor<T>[...]` literal
    // syntax can be disambiguated from `NAME LT` expressions.
    if name == "Tensor" { return "KW_TENSOR" }
    // v5.6.3 (Sh.6 Phase 4): standalone `_` lexes as UNDERSCORE so the
    // parser can route it to wildcard in subscripts (`a[0..2, _]`).
    // `_foo`, `__bar`, `_1` stay NAME — only exact `_` becomes UNDERSCORE.
    if name == "_" { return "UNDERSCORE" }
    return "NAME"

// ---------------------------------------------------------------------------
// Character classification helpers
// ---------------------------------------------------------------------------

fn is_alpha(ch: String) -> Bool:
    if ch == "_" { return true }
    if ch >= "a" { if ch <= "z" { return true } }
    if ch >= "A" { if ch <= "Z" { return true } }
    return false

fn is_digit(ch: String) -> Bool:
    if ch >= "0" { if ch <= "9" { return true } }
    return false

fn is_alnum(ch: String) -> Bool:
    if is_alpha(ch) { return true }
    if is_digit(ch) { return true }
    return false

fn is_whitespace(ch: String) -> Bool:
    if ch == " " { return true }
    if ch == "\t" { return true }
    if ch == "\r" { return true }
    return false

fn is_hex_digit(ch: String) -> Bool:
    if is_digit(ch) { return true }
    if ch >= "a" { if ch <= "f" { return true } }
    if ch >= "A" { if ch <= "F" { return true } }
    return false

// ---------------------------------------------------------------------------
// Lexer helpers — use positional args, no struct literals
// ---------------------------------------------------------------------------

fn lexer_at_end(source: String, pos: Int) -> Bool = pos >= len(source)

fn lexer_peek(source: String, pos: Int) -> String:
    if pos >= len(source) { return "" }
    return source.char_at(pos)

fn lexer_peek_at(source: String, pos: Int, offset: Int) -> String:
    let idx: Int = pos + offset
    if idx >= len(source) { return "" }
    return source.char_at(idx)

// ---------------------------------------------------------------------------
// Scan identifier / keyword
// ---------------------------------------------------------------------------

fn scan_ident(source: String, pos: Int, line: Int, col: Int) -> Token:
    let mut p: Int = pos
    let mut value: String = ""
    for _ in 0..10000:
        if p >= len(source) { return new_token(keyword_token_type(value), value, line, col, line, col + len(value)) }
        let ch: String = source.char_at(p)
        if is_alnum(ch):
            value = value + ch
            p = p + 1
        else:
            return new_token(keyword_token_type(value), value, line, col, line, col + len(value))
    return new_token(keyword_token_type(value), value, line, col, line, col + len(value))

// ---------------------------------------------------------------------------
// Scan number literal
// ---------------------------------------------------------------------------

fn scan_number(source: String, pos: Int, line: Int, col: Int) -> Token:
    let mut p: Int = pos
    let mut value: String = ""
    let mut is_float: Bool = false
    let ch0: String = source.char_at(p)

    // Check 0x, 0b, 0o prefixes
    if ch0 == "0":
        let ch1: String = lexer_peek(source, p + 1)
        if ch1 == "x":
            value = "0x"
            p = p + 2
            for _ in 0..100:
                if p >= len(source) { return new_token("HEX_INT", value, line, col, line, col + p - pos) }
                let hc: String = source.char_at(p)
                if is_hex_digit(hc) { value = value + hc } else { if hc != "_" { return new_token("HEX_INT", value, line, col, line, col + p - pos) } }
                p = p + 1
            return new_token("HEX_INT", value, line, col, line, col + p - pos)
        if ch1 == "b":
            value = "0b"
            p = p + 2
            for _ in 0..100:
                if p >= len(source) { return new_token("BIN_INT", value, line, col, line, col + p - pos) }
                let bc: String = source.char_at(p)
                if bc == "0" { value = value + bc } else { if bc == "1" { value = value + bc } else { if bc != "_" { return new_token("BIN_INT", value, line, col, line, col + p - pos) } } }
                p = p + 1
            return new_token("BIN_INT", value, line, col, line, col + p - pos)
        if ch1 == "o":
            value = "0o"
            p = p + 2
            for _ in 0..100:
                if p >= len(source) { return new_token("OCT_INT", value, line, col, line, col + p - pos) }
                let oc: String = source.char_at(p)
                if oc >= "0" { if oc <= "7" { value = value + oc } else { if oc != "_" { return new_token("OCT_INT", value, line, col, line, col + p - pos) } } } else { return new_token("OCT_INT", value, line, col, line, col + p - pos) }
                p = p + 1
            return new_token("OCT_INT", value, line, col, line, col + p - pos)

    // Decimal / float
    for _ in 0..100:
        if p >= len(source):
            if is_float { return new_token("FLOAT_LIT", value, line, col, line, col + p - pos) }
            return new_token("DEC_INT", value, line, col, line, col + p - pos)
        let dc: String = source.char_at(p)
        if is_digit(dc):
            value = value + dc
            p = p + 1
        else:
            if dc == "_":
                p = p + 1
            else:
                if dc == ".":
                    if lexer_peek(source, p + 1) == ".":
                        if is_float { return new_token("FLOAT_LIT", value, line, col, line, col + p - pos) }
                        return new_token("DEC_INT", value, line, col, line, col + p - pos)
                    is_float = true
                    value = value + "."
                    p = p + 1
                else:
                    if is_float { return new_token("FLOAT_LIT", value, line, col, line, col + p - pos) }
                    return new_token("DEC_INT", value, line, col, line, col + p - pos)
    if is_float { return new_token("FLOAT_LIT", value, line, col, line, col + p - pos) }
    return new_token("DEC_INT", value, line, col, line, col + p - pos)

// ---------------------------------------------------------------------------
// Scan string literal
// ---------------------------------------------------------------------------

fn scan_string(source: String, pos: Int, line: Int, col: Int) -> Token:
    let mut p: Int = pos + 1
    let mut value: String = ""
    let mut cur_line: Int = line
    for _ in 0..100000:
        if p >= len(source) { return new_token("STRING_LIT", value, line, col, cur_line, col + p - pos) }
        let ch: String = source.char_at(p)
        if ch == "\"":
            p = p + 1
            return new_token("STRING_LIT", value, line, col, cur_line, col + p - pos)
        if ch == "\\":
            p = p + 1
            if p >= len(source) { return new_token("STRING_LIT", value, line, col, cur_line, col + p - pos) }
            let esc: String = source.char_at(p)
            if esc == "n" { value = value + "\n" }
            if esc == "t" { value = value + "\t" }
            if esc == "r" { value = value + "\r" }
            if esc == "\\" { value = value + "\\" }
            if esc == "\"" { value = value + "\"" }
            if esc == "0" { value = value + "\0" }
            // v5.16.0 Te.4.B — preserve `\$` literally so split_interp_parts
            // can distinguish escaped `\${...}` from real interpolation.
            // Mirrors Python bootstrap: `_split_interp` operates on
            // pre-unescape source; STRING_LIT keeps the backslash.
            if esc == "$" { value = value + "\\" + "$" }
            p = p + 1
        else:
            if ch == "\n" { cur_line = cur_line + 1 }
            value = value + ch
            p = p + 1
    return new_token("STRING_LIT", value, line, col, cur_line, col + p - pos)

// ---------------------------------------------------------------------------
// Scan char literal
// ---------------------------------------------------------------------------

fn scan_char(source: String, pos: Int, line: Int, col: Int) -> Token:
    let mut p: Int = pos + 1
    let mut value: String = ""
    if p >= len(source) { return new_token("CHAR_LIT", "", line, col, line, col + 2) }
    let ch: String = source.char_at(p)
    if ch == "\\":
        p = p + 1
        let esc: String = source.char_at(p)
        if esc == "n" { value = "\n" }
        if esc == "t" { value = "\t" }
        if esc == "\\" { value = "\\" }
        if esc == "'" { value = "'" }
        p = p + 1
    else:
        value = ch
        p = p + 1
    if p < len(source) { if source.char_at(p) == "'" { p = p + 1 } }
    return new_token("CHAR_LIT", value, line, col, line, col + p - pos)

// ---------------------------------------------------------------------------
// Scan operator / punctuation — returns token + its width
// ---------------------------------------------------------------------------

fn scan_op(source: String, pos: Int, line: Int, col: Int) -> Token:
    let ch: String = source.char_at(pos)
    let ch1: String = lexer_peek(source, pos + 1)

    if ch == "|":
        if ch1 == ">" { return new_token("PIPE_OP", "|>", line, col, line, col + 2) }
        if ch1 == "|" { return new_token("OR", "||", line, col, line, col + 2) }
        return new_token("BAR", "|", line, col, line, col + 1)
    if ch == "&" { if ch1 == "&" { return new_token("AND", "&&", line, col, line, col + 2) } }
    if ch == "=":
        if ch1 == "=" { return new_token("EQEQ", "==", line, col, line, col + 2) }
        if ch1 == ">" { return new_token("FAT_ARROW", "=>", line, col, line, col + 2) }
        return new_token("ASSIGN", "=", line, col, line, col + 1)
    if ch == "!":
        if ch1 == "=" { return new_token("NEQ", "!=", line, col, line, col + 2) }
        return new_token("BANG", "!", line, col, line, col + 1)
    if ch == "<":
        if ch1 == "=" { return new_token("LTE", "<=", line, col, line, col + 2) }
        if ch1 == "-" { return new_token("SEND", "<-", line, col, line, col + 2) }
        return new_token("LT", "<", line, col, line, col + 1)
    if ch == ">":
        if ch1 == "=" { return new_token("GTE", ">=", line, col, line, col + 2) }
        return new_token("GT", ">", line, col, line, col + 1)
    if ch == "-":
        if ch1 == ">" { return new_token("ARROW", "->", line, col, line, col + 2) }
        if ch1 == "=" { return new_token("MINUS_EQ", "-=", line, col, line, col + 2) }
        return new_token("MINUS", "-", line, col, line, col + 1)
    if ch == "+":
        if ch1 == "=" { return new_token("PLUS_EQ", "+=", line, col, line, col + 2) }
        return new_token("PLUS", "+", line, col, line, col + 1)
    if ch == "*":
        if ch1 == "=" { return new_token("STAR_EQ", "*=", line, col, line, col + 2) }
        return new_token("STAR", "*", line, col, line, col + 1)
    if ch == "/":
        if ch1 == "=" { return new_token("SLASH_EQ", "/=", line, col, line, col + 2) }
        return new_token("SLASH", "/", line, col, line, col + 1)
    if ch == ":":
        if ch1 == ":" { return new_token("DOUBLE_COLON", "::", line, col, line, col + 2) }
        return new_token("COLON", ":", line, col, line, col + 1)
    if ch == ".":
        if ch1 == ".":
            if lexer_peek(source, pos + 2) == "=" { return new_token("RANGE_INCL", "..=", line, col, line, col + 3) }
            return new_token("RANGE", "..", line, col, line, col + 2)
        return new_token("DOT", ".", line, col, line, col + 1)
    if ch == "(" { return new_token("LPAREN", "(", line, col, line, col + 1) }
    if ch == ")" { return new_token("RPAREN", ")", line, col, line, col + 1) }
    if ch == "{" { return new_token("LBRACE", "{", line, col, line, col + 1) }
    if ch == "}" { return new_token("RBRACE", "}", line, col, line, col + 1) }
    if ch == "[" { return new_token("LBRACKET", "[", line, col, line, col + 1) }
    if ch == "]" { return new_token("RBRACKET", "]", line, col, line, col + 1) }
    if ch == "," { return new_token("COMMA", ",", line, col, line, col + 1) }
    if ch == ";" { return new_token("SEMICOLON", ";", line, col, line, col + 1) }
    if ch == "?" { return new_token("QUESTION", "?", line, col, line, col + 1) }
    if ch == "@" { return new_token("AT", "@", line, col, line, col + 1) }
    if ch == "%" { return new_token("PERCENT", "%", line, col, line, col + 1) }
    if ch == "#":
        if ch1 == "{" { return new_token("MAP_OPEN", "#{", line, col, line, col + 2) }
        return new_token("HASH", "#", line, col, line, col + 1)

    return new_token("UNKNOWN", ch, line, col, line, col + 1)

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

// Helper: skip to end of line comment, return new position.
// Uses return (not break) to exit the loop — return works, break doesn't.
fn skip_comment_to_eol(source: String, pos: Int, slen: Int) -> Int:
    let mut p: Int = pos
    for _ in 0..100000:
        if p >= slen { return p }
        if source.char_at(p) == "\n" { return p + 1 }
        p = p + 1
    return p

fn tokenize(source: String, filename: String) -> List<Token>:
    let mut tokens: List<Token> = []
    let mut pos: Int = 0
    let mut line: Int = 1
    let mut col: Int = 1
    let slen: Int = len(source)

    // Single loop: handles whitespace, comments, and tokens.
    while pos < slen:

        let c: String = source.char_at(pos)

        // --- Whitespace (one char per iteration, main loop repeats) ---
        let mut skip: Bool = false
        if c == " " { pos = pos + 1; col = col + 1; skip = true }
        if c == "\t" { pos = pos + 1; col = col + 1; skip = true }
        if c == "\r" { pos = pos + 1; skip = true }
        if c == "\n" { pos = pos + 1; line = line + 1; col = 1; skip = true }

        // --- Line comment (// to end of line) ---
        if c == "/":
            if lexer_peek(source, pos + 1) == "/":
                let new_pos: Int = skip_comment_to_eol(source, pos + 2, slen)
                pos = new_pos
                line = line + 1
                col = 1
                skip = true

        if !skip:
            // --- Token classification (flat if-chain, no nested else) ---
            let mut handled: Bool = false

            if is_alpha(c):
                handled = true
                let tok_id: Token = scan_ident(source, pos, line, col)
                pos = pos + len(tok_id.value)
                col = col + len(tok_id.value)
                tokens.push(tok_id)

            if !handled:
                if is_digit(c):
                    handled = true
                    let tok_num: Token = scan_number(source, pos, line, col)
                    let width_num: Int = tok_num.end_column - tok_num.column
                    pos = pos + width_num
                    col = col + width_num
                    tokens.push(tok_num)

            if !handled:
                if c == "\"":
                    handled = true
                    let tok_str: Token = scan_string(source, pos, line, col)
                    let width_str: Int = tok_str.end_column - tok_str.column
                    pos = pos + width_str
                    col = col + width_str
                    line = tok_str.end_line
                    tokens.push(tok_str)

            if !handled:
                if c == "'":
                    handled = true
                    let tok_chr: Token = scan_char(source, pos, line, col)
                    let width_chr: Int = tok_chr.end_column - tok_chr.column
                    pos = pos + width_chr
                    col = col + width_chr
                    tokens.push(tok_chr)

            if !handled:
                let tok_op: Token = scan_op(source, pos, line, col)
                let width_op: Int = len(tok_op.value)
                pos = pos + width_op
                col = col + width_op
                tokens.push(tok_op)

    return tokens

fn tokenize_with_newlines(source: String, filename: String) -> List<Token> = tokenize(source, filename)

// ===== parser.mn =====
// parser.mn — Mapanare parser, self-hosted.
// Recursive descent with precedence climbing.
// Builds AST from token stream produced by lexer.mn.
//
// NOTE: Struct construction syntax (Name { field: val }) is not yet in the
// Lark grammar, so all struct creation uses constructor functions.


// ---------------------------------------------------------------------------
// ParseError
// ---------------------------------------------------------------------------

struct ParseError:
    message: String
    line: Int
    column: Int
    filename: String

// ---------------------------------------------------------------------------
// Parser state
// ---------------------------------------------------------------------------

struct Parser:
    tokens: List<Token>
    pos: Int
    filename: String

// ---------------------------------------------------------------------------
// Token classification helpers
// ---------------------------------------------------------------------------

fn is_skip_token(tok_type: String) -> Bool:
    if tok_type == "KW_FN" { return true }
    if tok_type == "KW_ASYNC" { return true }
    if tok_type == "KW_LET" { return true }
    if tok_type == "KW_AGENT" { return true }
    if tok_type == "KW_PIPE" { return true }
    if tok_type == "KW_STRUCT" { return true }
    if tok_type == "KW_ENUM" { return true }
    if tok_type == "KW_TYPE" { return true }
    if tok_type == "KW_IMPL" { return true }
    if tok_type == "KW_IF" { return true }
    if tok_type == "KW_ELSE" { return true }
    if tok_type == "KW_MATCH" { return true }
    if tok_type == "KW_FOR" { return true }
    if tok_type == "KW_IN" { return true }
    if tok_type == "KW_RETURN" { return true }
    if tok_type == "KW_IMPORT" { return true }
    if tok_type == "KW_EXPORT" { return true }
    if tok_type == "KW_SPAWN" { return true }
    if tok_type == "KW_SYNC" { return true }
    if tok_type == "KW_SIGNAL" { return true }
    if tok_type == "KW_STREAM" { return true }
    if tok_type == "KW_INPUT" { return true }
    if tok_type == "KW_OUTPUT" { return true }
    if tok_type == "KW_TENSOR" { return true }
    if tok_type == "KW_WILDCARD" { return true }
    if tok_type == "KW_TRUE" { return true }
    if tok_type == "KW_FALSE" { return true }
    if tok_type == "KW_NONE" { return true }
    if tok_type == "LPAREN" { return true }
    if tok_type == "RPAREN" { return true }
    if tok_type == "LBRACE" { return true }
    if tok_type == "RBRACE" { return true }
    if tok_type == "LBRACKET" { return true }
    if tok_type == "RBRACKET" { return true }
    if tok_type == "COMMA" { return true }
    if tok_type == "COLON" { return true }
    if tok_type == "SEMICOLON" { return true }
    if tok_type == "ASSIGN" { return true }
    if tok_type == "ARROW" { return true }
    if tok_type == "FAT_ARROW" { return true }
    if tok_type == "PIPE_OP" { return true }
    if tok_type == "DOUBLE_COLON" { return true }
    if tok_type == "DOT" { return true }
    if tok_type == "QUESTION" { return true }
    if tok_type == "SEND" { return true }
    return false

fn is_keep_token(tok_type: String) -> Bool:
    if tok_type == "KW_PUB" { return true }
    if tok_type == "KW_MUT" { return true }
    if tok_type == "KW_SELF" { return true }
    if tok_type == "NAME" { return true }
    if tok_type == "DEC_INT" { return true }
    if tok_type == "HEX_INT" { return true }
    if tok_type == "BIN_INT" { return true }
    if tok_type == "OCT_INT" { return true }
    if tok_type == "FLOAT_LIT" { return true }
    if tok_type == "STRING_LIT" { return true }
    if tok_type == "CHAR_LIT" { return true }
    return false

// ---------------------------------------------------------------------------
// Integer parsing helpers
// ---------------------------------------------------------------------------

fn parse_int_token(tok_type: String, value: String) -> Int = 0

// ---------------------------------------------------------------------------
// Binary operator helpers
// ---------------------------------------------------------------------------

fn is_arithmetic_op(op: String) -> Bool:
    if op == "+" { return true }
    if op == "-" { return true }
    if op == "*" { return true }
    if op == "/" { return true }
    if op == "%" { return true }
    if op == "@" { return true }
    return false

fn is_comparison_op(op: String) -> Bool:
    if op == "<" { return true }
    if op == ">" { return true }
    if op == "<=" { return true }
    if op == ">=" { return true }
    if op == "==" { return true }
    if op == "!=" { return true }
    return false

fn is_logical_op(op: String) -> Bool:
    if op == "&&" { return true }
    if op == "||" { return true }
    return false

fn is_assign_op(op: String) -> Bool:
    if op == "=" { return true }
    if op == "+=" { return true }
    if op == "-=" { return true }
    if op == "*=" { return true }
    if op == "/=" { return true }
    return false

// ---------------------------------------------------------------------------
// Result structs — each parse function returns (value, new position)
// ---------------------------------------------------------------------------

struct ExprResult:
    expr: Expr
    pos: Int

struct StmtResult:
    stmt: Stmt
    pos: Int

struct BlockResult:
    block: Block
    pos: Int

struct TypeResult:
    type_expr: TypeExpr
    pos: Int

struct PatternResult:
    pattern: Pattern
    pos: Int

struct DefResult:
    def_node: Definition
    pos: Int

struct ParamResult:
    param: Param
    pos: Int

struct MatchArmResult:
    arm: MatchArm
    pos: Int

// v5.6.3 Sh.6 Phase 4 — subscript item parser result.
struct IndexItemResult:
    item: IndexItem
    pos: Int

// ---------------------------------------------------------------------------
// Constructor functions — populate result structs positionally
// ---------------------------------------------------------------------------

fn new_expr_result(expr: Expr, pos: Int) -> ExprResult = new ExprResult { expr: expr, pos: pos }

fn new_stmt_result(stmt: Stmt, pos: Int) -> StmtResult = new StmtResult { stmt: stmt, pos: pos }

fn new_block_result(block: Block, pos: Int) -> BlockResult = new BlockResult { block: block, pos: pos }

fn new_type_result(type_expr: TypeExpr, pos: Int) -> TypeResult = new TypeResult { type_expr: type_expr, pos: pos }

fn new_pattern_result(pattern: Pattern, pos: Int) -> PatternResult = new PatternResult { pattern: pattern, pos: pos }

fn new_def_result(def_node: Definition, pos: Int) -> DefResult = new DefResult { def_node: def_node, pos: pos }

fn new_param_result(param: Param, pos: Int) -> ParamResult = new ParamResult { param: param, pos: pos }

fn new_match_arm_result(arm: MatchArm, pos: Int) -> MatchArmResult = new MatchArmResult { arm: arm, pos: pos }

// AST node constructors (new_span, new_block, new_fn_def_data are in ast.mn)

fn new_param(name: String, type_ann: Option<TypeExpr>) -> Param = new Param { span: new_span(0, 0, 0, 0), name: name, type_annotation: type_ann }

fn new_struct_field(name: String, type_ann: TypeExpr) -> StructField = new StructField { span: new_span(0, 0, 0, 0), name: name, type_annotation: type_ann }

fn new_enum_variant(name: String, fields: List<TypeExpr>) -> EnumVariant = new EnumVariant { span: new_span(0, 0, 0, 0), name: name, fields: fields }

fn new_match_arm(pattern: Pattern, body: MatchArmBody, guard: Option<Expr>) -> MatchArm = new MatchArm { span: new_span(0, 0, 0, 0), pattern: pattern, body: body, guard: guard }

fn new_struct_def_data(name: String, public: Bool, type_params: List<String>, fields: List<StructField>) -> StructDefData = new StructDefData { span: new_span(0, 0, 0, 0), name: name, public: public, type_params: type_params, fields: fields }

fn new_enum_def_data(name: String, public: Bool, type_params: List<String>, variants: List<EnumVariant>) -> EnumDefData = new EnumDefData { span: new_span(0, 0, 0, 0), name: name, public: public, type_params: type_params, variants: variants }

fn new_agent_def_data(name: String, public: Bool, inputs: List<AgentInput>, outputs: List<AgentOutput>, state: List<Stmt>, methods: List<FnDefData>, decorators: List<Decorator>) -> AgentDefData = new AgentDefData { span: new_span(0, 0, 0, 0), name: name, public: public, inputs: inputs, outputs: outputs, state: state, methods: methods, decorators: decorators }

fn new_pipe_def_data(name: String, public: Bool, stages: List<Expr>) -> PipeDefData = new PipeDefData { span: new_span(0, 0, 0, 0), name: name, public: public, stages: stages }

fn new_decorator(name: String, args: List<Expr>) -> Decorator = new Decorator { span: new_span(0, 0, 0, 0), name: name, args: args }

// ---------------------------------------------------------------------------
// Token access helpers
// ---------------------------------------------------------------------------

fn peek_type(tokens: List<Token>, pos: Int) -> String:
    if pos >= len(tokens) { return "EOF" }
    let tok: Token = tokens[pos]
    return tok.tok_type

fn peek_value(tokens: List<Token>, pos: Int) -> String:
    if pos >= len(tokens) { return "" }
    let tok: Token = tokens[pos]
    return tok.value

fn at_end(tokens: List<Token>, pos: Int) -> Bool = pos >= len(tokens)

fn expect(tokens: List<Token>, pos: Int, expected: String) -> Int:
    let tt: String = peek_type(tokens, pos)
    if tt != expected:
        __mn_str_eprint("parse error: expected ")
        __mn_str_eprint(expected)
        __mn_str_eprint(" but got ")
        __mn_str_eprint(tt)
        __mn_str_eprint("\n")
    pos + 1

fn skip_semis(tokens: List<Token>, pos: Int) -> Int:
    let mut p: Int = pos
    for _ in 0..100000:
        if p >= len(tokens) { return p }
        if peek_type(tokens, p) == "SEMICOLON":
            p = p + 1
        else:
            return p
    return p

// ---------------------------------------------------------------------------
// Operator helpers
// ---------------------------------------------------------------------------

fn tok_to_binop(tt: String) -> String:
    if tt == "PLUS" { return "+" }
    if tt == "MINUS" { return "-" }
    if tt == "STAR" { return "*" }
    if tt == "SLASH" { return "/" }
    if tt == "PERCENT" { return "%" }
    if tt == "AT" { return "@" }
    if tt == "EQEQ" { return "==" }
    if tt == "NEQ" { return "!=" }
    if tt == "LT" { return "<" }
    if tt == "GT" { return ">" }
    if tt == "LTE" { return "<=" }
    if tt == "GTE" { return ">=" }
    if tt == "AND" { return "&&" }
    if tt == "OR" { return "||" }
    if tt == "PIPE_OP" { return "|>" }
    if tt == "RANGE" { return ".." }
    if tt == "RANGE_INCL" { return "..=" }
    return ""

fn op_precedence(op: String) -> Int:
    if op == "||" { return 1 }
    if op == "&&" { return 2 }
    // v5.21.0 Te.6 — D1: merge `==`/`!=` with ordering ops at single
    // precedence level (was 3; now 4). Required so `a == b < c` chains
    // as `(a == b) && (b < c)`. Audit confirmed no existing code relies
    // on the prior asymmetric precedence.
    if op == "==" { return 4 }
    if op == "!=" { return 4 }
    if op == "<" { return 4 }
    if op == ">" { return 4 }
    if op == "<=" { return 4 }
    if op == ">=" { return 4 }
    if op == "|>" { return 5 }
    if op == ".." { return 6 }
    if op == "..=" { return 6 }
    if op == "+" { return 7 }
    if op == "-" { return 7 }
    if op == "*" { return 8 }
    if op == "/" { return 8 }
    if op == "%" { return 8 }
    if op == "@" { return 8 }
    return 0

fn is_right_assoc(op: String) -> Bool:
    if op == ".." { return true }
    if op == "..=" { return true }
    return false

// v5.21.0 Te.6 — D1 chain operator set. Pure comparison only.
fn is_cmp_op(op: String) -> Bool:
    if op == "==" { return true }
    if op == "!=" { return true }
    if op == "<" { return true }
    if op == ">" { return true }
    if op == "<=" { return true }
    if op == ">=" { return true }
    return false

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

fn is_definition_start(tt: String) -> Bool:
    if tt == "KW_IMPORT" { return true }
    if tt == "KW_EXPORT" { return true }
    if tt == "KW_PUB" { return true }
    if tt == "KW_FN" { return true }
    if tt == "KW_ASYNC" { return true }
    if tt == "KW_STRUCT" { return true }
    if tt == "KW_ENUM" { return true }
    if tt == "KW_AGENT" { return true }
    if tt == "KW_PIPE" { return true }
    if tt == "KW_TYPE" { return true }
    if tt == "KW_IMPL" { return true }
    if tt == "KW_EXTERN" { return true }
    if tt == "KW_LET" { return true }
    // v4.126.0: KW_CONST + KW_TRAIT were missing — module-level const
    // and trait declarations were being misparsed as statements
    // (silently consumed, no scope binding). Closes 54_const_basic and
    // 58_const_scope golden tests; parse_definition already handles
    // both keywords via parse_const_def / inline parse path.
    if tt == "KW_CONST" { return true }
    if tt == "KW_TRAIT" { return true }
    if tt == "AT" { return true }
    return false

fn has_explicit_main(defs: List<Definition>) -> Bool:
    for i in 0..len(defs):
        let d: Definition = defs[i]
        match d {
            FnDef(fd) => {
                if fd.name == "main" {
                    return true
                }
            },
            _ => {}
        }
    return false

pub fn parse(source: String, filename: String) -> Program:
    // v5.23.2 Te.3.B.2: brace-block deprecation warning. Runs **before**
    // __mn_indent_to_braces so the detector sees the source as the user
    // wrote it (the preprocessor would otherwise convert every colon
    // block into brace form, making the two indistinguishable).
    // Mirrors mapanare/parser.py::parse — same call shape, byte-identical
    // warning text. Honors MAPANARE_NO_BRACE_WARNING=1 (handled inside
    // the C runtime). See runtime/native/mapanare_core.c::
    // __mn_count_user_brace_block_openers for the algorithm.
    let brace_count: Int = __mn_count_user_brace_block_openers(source)
    if brace_count > 0:
        __mn_emit_brace_deprecation_warning(filename, brace_count)
    // v5.14.1 B.5/B.6: colon-block preprocessor lives in the C runtime
    // (`runtime/native/mapanare_core.c::__mn_indent_to_braces`) and is
    // wired into the self-host as a builtin (semantic.mn::is_builtin_function,
    // lower.mn, emit_llvm.mn::declare_runtime_fn). It runs before
    // tokenize() — both top-level `compile()` and the import resolver
    // in main.mn route through this entry, so colon-style sources
    // (and brace-only sources, via the fast path) are handled
    // uniformly. Routed through C rather than .mn because the
    // bootstrap lower has pathologies on a .mn port of the algorithm.
    let preprocessed: String = __mn_indent_to_braces(source)
    let tokens: List<Token> = tokenize(preprocessed, filename)
    let mut pos: Int = 0
    let mut defs: List<Definition> = []
    let mut top_stmts: List<Stmt> = []

    for _ in 0..100000:
        pos = skip_semis(tokens, pos)
        if pos >= len(tokens):
            if len(top_stmts) > 0:
                if !has_explicit_main(defs):
                    let body_early: Block = new_block(new_span(0, 0, 0, 0), top_stmts)
                    let empty_tp: List<String> = []
                    let empty_params: List<Param> = []
                    let empty_decs: List<Decorator> = []
                    let main_fn_early: FnDefData = new_fn_def_data(new_span(0, 0, 0, 0), "main", false, empty_tp, empty_params, none, body_early, empty_decs)
                    defs.push(Definition::FnDef(main_fn_early))
            return Program::start(defs)

        let tt: String = peek_type(tokens, pos)
        if is_definition_start(tt):
            let r: DefResult = parse_definition(tokens, pos, filename)
            defs.push(r.def_node)
            pos = r.pos
        else:
            let sr: StmtResult = parse_stmt(tokens, pos, filename)
            top_stmts.push(sr.stmt)
            pos = sr.pos

    if len(top_stmts) > 0:
        if !has_explicit_main(defs):
            let body_final: Block = new_block(new_span(0, 0, 0, 0), top_stmts)
            let empty_tp2: List<String> = []
            let empty_params2: List<Param> = []
            let empty_decs2: List<Decorator> = []
            let main_fn_final: FnDefData = new_fn_def_data(new_span(0, 0, 0, 0), "main", false, empty_tp2, empty_params2, none, body_final, empty_decs2)
            defs.push(Definition::FnDef(main_fn_final))

    return Program::start(defs)

// ---------------------------------------------------------------------------
// Definition dispatch
// ---------------------------------------------------------------------------

fn parse_definition(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let tt: String = peek_type(tokens, pos)

    if tt == "KW_IMPORT":
        return parse_import_def(tokens, pos, filename)
    if tt == "KW_EXPORT":
        return parse_export_def(tokens, pos, filename)
    if tt == "KW_PUB":
        let next_tt: String = peek_type(tokens, pos + 1)
        if next_tt == "KW_FN" { return parse_fn_def(tokens, pos, filename) }
        // v4.68.0: ``KW_ASYNC`` dispatch restored (Arc 8).
        if next_tt == "KW_ASYNC" { return parse_fn_def(tokens, pos, filename) }
        if next_tt == "KW_STRUCT" { return parse_struct_def(tokens, pos, filename) }
        if next_tt == "KW_ENUM" { return parse_enum_def(tokens, pos, filename) }
        if next_tt == "KW_AGENT" { return parse_agent_def(tokens, pos, filename) }
        if next_tt == "KW_PIPE" { return parse_pipe_def(tokens, pos, filename) }
    // v4.68.0: ``KW_ASYNC`` top-level dispatch restored (Arc 8).
    if tt == "KW_ASYNC" { return parse_fn_def(tokens, pos, filename) }
    if tt == "KW_FN" { return parse_fn_def(tokens, pos, filename) }
    // v4.78.0 (CARRY_FORWARD A10b): const handled early — the compiled
    // binary has a codegen issue where checks late in long if-chains are
    // unreachable. Placed right after KW_FN which is known to work.
    if tt == "KW_CONST" { return parse_const_def(tokens, pos, filename) }
    if tt == "NAME":
        if peek_value(tokens, pos) == "const" { return parse_const_def(tokens, pos, filename) }
    if tt == "KW_STRUCT" { return parse_struct_def(tokens, pos, filename) }
    if tt == "KW_ENUM" { return parse_enum_def(tokens, pos, filename) }
    if tt == "KW_AGENT" { return parse_agent_def(tokens, pos, filename) }
    if tt == "KW_PIPE" { return parse_pipe_def(tokens, pos, filename) }
    if tt == "KW_TYPE":
        // tipo/type can be either a type alias (type Foo = Bar) or
        // a tipo definition (tipo Foo { fields/variants }). Peek ahead
        // to decide: KW_TYPE NAME LBRACE → struct-like, else → alias.
        let tipo_name_pos: Int = pos + 1
        if tipo_name_pos + 1 < len(tokens):
            let after_name_tt: String = peek_type(tokens, tipo_name_pos + 1)
            if after_name_tt == "LBRACE":
                return parse_tipo_def(tokens, pos, filename)
        return parse_type_alias_def(tokens, pos, filename)
    if tt == "KW_IMPL" { return parse_impl_def(tokens, pos, filename) }
    if tt == "KW_TRAIT":
        let mut tp: Int = pos + 1
        let trait_name: String = peek_value(tokens, tp)
        tp = tp + 1
        let mut trait_methods: List<FnDefData> = []
        if peek_type(tokens, tp) == "LBRACE":
            tp = tp + 1
            for _ in 0..100:
                if peek_type(tokens, tp) == "RBRACE":
                    tp = tp + 1
                    return new_def_result(Definition::TraitDef(trait_name, trait_methods), tp)
                if peek_type(tokens, tp) == "KW_FN":
                    let fr: FnDataResult = parse_fn_def_as_data(tokens, tp, filename)
                    trait_methods.push(fr.data)
                    tp = fr.pos
                else:
                    tp = tp + 1
            return new_def_result(Definition::TraitDef(trait_name, trait_methods), tp)
        return new_def_result(Definition::TraitDef(trait_name, trait_methods), tp)
    if tt == "KW_EXTERN" { return parse_extern_def(tokens, pos, filename) }
    if tt == "KW_LET" { return parse_module_let(tokens, pos, filename) }
    if tt == "KW_CONST" { return parse_const_def(tokens, pos, filename) }
    if tt == "AT" { return parse_decorated_def(tokens, pos, filename) }

    // Fallback: skip unknown token
    let empty_path: List<String> = []
    let empty_items: List<String> = []
    let d: Definition = Definition::ImportDef(empty_path, empty_items)
    return new_def_result(d, pos + 1)

// ---------------------------------------------------------------------------
// Import definition
// ---------------------------------------------------------------------------

fn parse_import_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos + 1
    let mut path: List<String> = []

    let name0: String = peek_value(tokens, p)
    path.push(name0)
    p = p + 1

    for _ in 0..100:
        if peek_type(tokens, p) != "DOUBLE_COLON":
            let imp_items: List<String> = []
            return new_def_result(Definition::ImportDef(path, imp_items), p)
        p = p + 1
        let seg: String = peek_value(tokens, p)
        path.push(seg)
        p = p + 1

    let trail_items: List<String> = []
    return new_def_result(Definition::ImportDef(path, trail_items), p)

// v4.55.0: const definition parsing
fn parse_const_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    // v4.78.0 (CARRY_FORWARD A10b): emit LetDef instead of ConstDef so
    // that const symbols use the same scope registration path as let
    // definitions. ConstDef (the last enum variant) has a codegen issue
    // in the compiled binary where its tag is unreachable in switch
    // statements. Emitting LetDef makes consts visible in fn bodies.
    let mut p: Int = pos + 1
    let name: String = peek_value(tokens, p)
    p = p + 1
    // Optional type annotation: ": TYPE"
    let mut type_name: String = ""
    if peek_type(tokens, p) == "COLON":
        p = p + 1
        type_name = peek_value(tokens, p)
        p = p + 1
    // Expect "="
    if peek_type(tokens, p) == "ASSIGN" { p = p + 1 }
    // Parse value expression
    let er: ExprResult = parse_expr(tokens, p, filename)
    p = er.pos
    p = skip_semis(tokens, p)
    return new_def_result(Definition::LetDef(name, type_name, er.expr), p)

// ---------------------------------------------------------------------------
// Extern "C" function declaration
// ---------------------------------------------------------------------------

fn parse_module_let(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    // let NAME: TYPE = EXPR
    let mut p: Int = pos + 1
    // Skip optional 'mut' (module-level let is always immutable, but tolerate it)
    if peek_type(tokens, p) == "KW_MUT" { p = p + 1 }
    let name: String = peek_value(tokens, p)
    p = p + 1
    // Optional type annotation: ": TYPE"
    let mut type_name: String = ""
    if peek_type(tokens, p) == "COLON":
        p = p + 1
        type_name = peek_value(tokens, p)
        p = p + 1
    // Expect "="
    if peek_type(tokens, p) == "ASSIGN":
        p = p + 1
    // Parse value expression
    let er: ExprResult = parse_expr(tokens, p, filename)
    p = er.pos
    // Skip optional semicolons/newlines
    p = skip_semis(tokens, p)
    return new_def_result(Definition::LetDef(name, type_name, er.expr), p)

// ---------------------------------------------------------------------------

fn parse_extern_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    // extern "C" fn name(params) -> RetType
    let mut p: Int = pos + 1
    // Skip the "C" string literal (ABI specifier)
    let abi: String = peek_value(tokens, p)
    p = p + 1
    p = expect(tokens, p, "KW_FN")

    let name: String = peek_value(tokens, p)
    p = p + 1

    // Parse parameters
    p = expect(tokens, p, "LPAREN")
    let mut params: List<Param> = []
    if peek_type(tokens, p) != "RPAREN":
        let pr: ParamResult = parse_param(tokens, p, filename)
        params.push(pr.param)
        p = pr.pos
        for _ in 0..50:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "RPAREN")
                let mut ret_type: Option<TypeExpr> = none
                if peek_type(tokens, p) == "ARROW":
                    p = p + 1
                    let tr: TypeResult = parse_type_expr(tokens, p, filename)
                    ret_type = Some(tr.type_expr)
                    p = tr.pos
                return new_def_result(Definition::ExternFnDef(abi, name, params, ret_type), p)
            p = p + 1
            let pr2: ParamResult = parse_param(tokens, p, filename)
            params.push(pr2.param)
            p = pr2.pos
    p = expect(tokens, p, "RPAREN")

    let mut ret_type: Option<TypeExpr> = none
    if peek_type(tokens, p) == "ARROW":
        p = p + 1
        let tr: TypeResult = parse_type_expr(tokens, p, filename)
        ret_type = Some(tr.type_expr)
        p = tr.pos
    return new_def_result(Definition::ExternFnDef(abi, name, params, ret_type), p)

// ---------------------------------------------------------------------------
// Export definition
// ---------------------------------------------------------------------------

fn parse_export_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos + 1
    let tt: String = peek_type(tokens, p)

    if tt == "KW_FN":
        let r_fn: DefResult = parse_fn_def(tokens, p, filename)
        let exp_items_fn: List<String> = []
        return new_def_result(Definition::ExportDef(none, exp_items_fn), r_fn.pos)
    if tt == "KW_STRUCT":
        let r_st: DefResult = parse_struct_def(tokens, p, filename)
        let exp_items_st: List<String> = []
        return new_def_result(Definition::ExportDef(none, exp_items_st), r_st.pos)

    let mut names: List<String> = []
    names.push(peek_value(tokens, p))
    p = p + 1
    for _ in 0..100:
        if peek_type(tokens, p) != "COMMA":
            return new_def_result(Definition::ExportDef(none, names), p)
        p = p + 1
        names.push(peek_value(tokens, p))
        p = p + 1
    return new_def_result(Definition::ExportDef(none, names), p)

// ---------------------------------------------------------------------------
// Function definition
// ---------------------------------------------------------------------------

fn parse_fn_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos
    let mut is_pub: Bool = false
    // v4.68.0: ``is_async`` activated — the lexer emits ``KW_ASYNC`` again.
    let mut is_async: Bool = false

    if peek_type(tokens, p) == "KW_PUB":
        is_pub = true
        p = p + 1
    // v4.68.0: check for ``async fn`` (KW_ASYNC before KW_FN).
    if peek_type(tokens, p) == "KW_ASYNC":
        is_async = true
        p = p + 1
    p = expect(tokens, p, "KW_FN")

    let name: String = peek_value(tokens, p)
    p = p + 1

    // Optional type params <T, U>
    let mut type_params: List<String> = []
    if peek_type(tokens, p) == "LT":
        p = p + 1
        type_params.push(peek_value(tokens, p))
        p = p + 1
        for _ in 0..20:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "GT")
                return parse_fn_params(tokens, p, filename, name, is_pub, type_params, is_async)
            p = p + 1
            type_params.push(peek_value(tokens, p))
            p = p + 1
        p = expect(tokens, p, "GT")

    return parse_fn_params(tokens, p, filename, name, is_pub, type_params, is_async)

fn parse_fn_params(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>, is_async: Bool) -> DefResult:
    let mut p: Int = pos
    p = expect(tokens, p, "LPAREN")
    let mut params: List<Param> = []

    if peek_type(tokens, p) != "RPAREN":
        let pr: ParamResult = parse_param(tokens, p, filename)
        params.push(pr.param)
        p = pr.pos

        for _ in 0..50:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "RPAREN")
                return parse_fn_body(tokens, p, filename, name, is_pub, type_params, params, is_async)
            p = p + 1
            if peek_type(tokens, p) == "RPAREN":
                p = p + 1
                return parse_fn_body(tokens, p, filename, name, is_pub, type_params, params, is_async)
            let pr2: ParamResult = parse_param(tokens, p, filename)
            params.push(pr2.param)
            p = pr2.pos
    p = expect(tokens, p, "RPAREN")

    return parse_fn_body(tokens, p, filename, name, is_pub, type_params, params, is_async)

fn parse_fn_body(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>, params: List<Param>, is_async: Bool) -> DefResult:
    let mut p: Int = pos

    let mut ret_type: Option<TypeExpr> = none
    if peek_type(tokens, p) == "ARROW":
        p = p + 1
        let tr: TypeResult = parse_type_expr(tokens, p, filename)
        ret_type = Some(tr.type_expr)
        p = tr.pos

    // v5.15.0 Te.2.D — implicit-return one-liner: ``fn name(args) = expr``.
    // Synthesize ``{ return expr }`` so downstream lowering is unchanged.
    let mut body_block: Block = new_block(new_span(0, 0, 0, 0), [])
    if peek_type(tokens, p) == "ASSIGN":
        p = p + 1
        let er: ExprResult = parse_expr(tokens, p, filename, 0)
        let mut implstmts: List<Stmt> = []
        implstmts.push(Stmt::Return(Some(er.expr)))
        body_block = new_block(new_span(0, 0, 0, 0), implstmts)
        p = er.pos
    else:
        let br: BlockResult = parse_block(tokens, p, filename)
        body_block = br.block
        p = br.pos

    let mut decorators: List<Decorator> = []
    if is_async:
        decorators.push(new_decorator("async"))
    let fd: FnDefData = new_fn_def_data(new_span(0, 0, 0, 0), name, is_pub, type_params, params, ret_type, body_block, decorators)
    return new_def_result(Definition::FnDef(fd), p)

fn parse_param(tokens: List<Token>, pos: Int, filename: String) -> ParamResult:
    let name: String = peek_value(tokens, pos)
    let mut p: Int = pos + 1
    // Handle bare "self" parameter (no type annotation)
    if name == "self":
        if peek_type(tokens, p) != "COLON":
            let param: Param = new_param("self", none)
            return new_param_result(param, p)
    p = expect(tokens, p, "COLON")
    let tr: TypeResult = parse_type_expr(tokens, p, filename)
    let param: Param = new_param(name, Some(tr.type_expr))
    return new_param_result(param, tr.pos)

// ---------------------------------------------------------------------------
// Struct definition
// ---------------------------------------------------------------------------

fn parse_struct_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos
    let mut is_pub: Bool = false

    if peek_type(tokens, p) == "KW_PUB":
        is_pub = true
        p = p + 1
    p = expect(tokens, p, "KW_STRUCT")

    let name: String = peek_value(tokens, p)
    p = p + 1

    let mut type_params: List<String> = []
    if peek_type(tokens, p) == "LT":
        p = p + 1
        type_params.push(peek_value(tokens, p))
        p = p + 1
        for _ in 0..20:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "GT")
                return parse_struct_fields(tokens, p, filename, name, is_pub, type_params)
            p = p + 1
            type_params.push(peek_value(tokens, p))
            p = p + 1
        p = expect(tokens, p, "GT")

    return parse_struct_fields(tokens, p, filename, name, is_pub, type_params)

fn parse_struct_fields(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>) -> DefResult:
    let mut p: Int = pos
    p = expect(tokens, p, "LBRACE")

    let mut fields: List<StructField> = []
    for _ in 0..100:
        p = skip_semis(tokens, p)
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            let sd_early: StructDefData = new_struct_def_data(name, is_pub, type_params, fields)
            return new_def_result(Definition::StructDef(sd_early), p)

        let fname: String = peek_value(tokens, p)
        p = p + 1
        p = expect(tokens, p, "COLON")
        let tr: TypeResult = parse_type_expr(tokens, p, filename)
        p = tr.pos

        let field: StructField = new_struct_field(fname, tr.type_expr)
        fields.push(field)

        if peek_type(tokens, p) == "COMMA" { p = p + 1 }

    let sd_final: StructDefData = new_struct_def_data(name, is_pub, type_params, fields)
    return new_def_result(Definition::StructDef(sd_final), p)

// ---------------------------------------------------------------------------
// Enum definition
// ---------------------------------------------------------------------------

fn parse_enum_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos
    let mut is_pub: Bool = false

    if peek_type(tokens, p) == "KW_PUB":
        is_pub = true
        p = p + 1
    p = expect(tokens, p, "KW_ENUM")

    let name: String = peek_value(tokens, p)
    p = p + 1

    let mut type_params: List<String> = []
    if peek_type(tokens, p) == "LT":
        p = p + 1
        type_params.push(peek_value(tokens, p))
        p = p + 1
        for _ in 0..20:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "GT")
                return parse_enum_body(tokens, p, filename, name, is_pub, type_params)
            p = p + 1
            type_params.push(peek_value(tokens, p))
            p = p + 1
        p = expect(tokens, p, "GT")

    return parse_enum_body(tokens, p, filename, name, is_pub, type_params)

fn parse_enum_body(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>) -> DefResult:
    let mut p: Int = pos
    p = expect(tokens, p, "LBRACE")

    let mut variants: List<EnumVariant> = []
    for _ in 0..100:
        p = skip_semis(tokens, p)
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            let ed_early: EnumDefData = new_enum_def_data(name, is_pub, type_params, variants)
            return new_def_result(Definition::EnumDef(ed_early), p)

        let vname: String = peek_value(tokens, p)
        p = p + 1
        let mut vtypes: List<TypeExpr> = []

        if peek_type(tokens, p) == "LPAREN":
            p = p + 1
            if peek_type(tokens, p) != "RPAREN":
                let tr: TypeResult = parse_type_expr(tokens, p, filename)
                vtypes.push(tr.type_expr)
                p = tr.pos
                for _ in 0..20:
                    if peek_type(tokens, p) != "COMMA":
                        p = expect(tokens, p, "RPAREN")
                        let v_inner: EnumVariant = new_enum_variant(vname, vtypes)
                        variants.push(v_inner)
                        if peek_type(tokens, p) == "COMMA" { p = p + 1 }
                        // Continue loop
                        return parse_enum_body_continue(tokens, p, filename, name, is_pub, type_params, variants)
                    p = p + 1
                    let tr2: TypeResult = parse_type_expr(tokens, p, filename)
                    vtypes.push(tr2.type_expr)
                    p = tr2.pos
            p = expect(tokens, p, "RPAREN")

        let v_outer: EnumVariant = new_enum_variant(vname, vtypes)
        variants.push(v_outer)

        if peek_type(tokens, p) == "COMMA" { p = p + 1 }

    let ed_final: EnumDefData = new_enum_def_data(name, is_pub, type_params, variants)
    return new_def_result(Definition::EnumDef(ed_final), p)

fn parse_enum_body_continue(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>, variants: List<EnumVariant>) -> DefResult:
    let mut p: Int = pos
    let mut vars: List<EnumVariant> = variants

    for _ in 0..100:
        p = skip_semis(tokens, p)
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            let ed_c_early: EnumDefData = new_enum_def_data(name, is_pub, type_params, vars)
            return new_def_result(Definition::EnumDef(ed_c_early), p)

        let vn: String = peek_value(tokens, p)
        p = p + 1
        let mut vt: List<TypeExpr> = []

        if peek_type(tokens, p) == "LPAREN":
            p = p + 1
            if peek_type(tokens, p) != "RPAREN":
                let tr: TypeResult = parse_type_expr(tokens, p, filename)
                vt.push(tr.type_expr)
                p = tr.pos
                for _ in 0..20:
                    if peek_type(tokens, p) != "COMMA":
                        p = expect(tokens, p, "RPAREN")
                        let v2: EnumVariant = new_enum_variant(vn, vt)
                        vars.push(v2)
                        if peek_type(tokens, p) == "COMMA" { p = p + 1 }
                        return parse_enum_body_continue(tokens, p, filename, name, is_pub, type_params, vars)
                    p = p + 1
                    let tr2: TypeResult = parse_type_expr(tokens, p, filename)
                    vt.push(tr2.type_expr)
                    p = tr2.pos
            p = expect(tokens, p, "RPAREN")

        let v: EnumVariant = new_enum_variant(vn, vt)
        vars.push(v)

        if peek_type(tokens, p) == "COMMA" { p = p + 1 }

    let ed_c_final: EnumDefData = new_enum_def_data(name, is_pub, type_params, vars)
    return new_def_result(Definition::EnumDef(ed_c_final), p)

// ---------------------------------------------------------------------------
// Type alias
// ---------------------------------------------------------------------------

fn parse_type_alias_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos + 1
    let name: String = peek_value(tokens, p)
    p = p + 1
    p = expect(tokens, p, "ASSIGN")
    let tr: TypeResult = parse_type_expr(tokens, p, filename)
    new_def_result(Definition::TypeAlias(name, tr.type_expr), tr.pos)

fn parse_tipo_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    // tipo Name { fields | variants } — unified type definition.
    // If first member starts with BAR → enum, else → struct.
    let mut p: Int = pos
    let mut is_pub: Bool = false
    if peek_type(tokens, p) == "KW_PUB":
        is_pub = true
        p = p + 1
    p = p + 1
    let name: String = peek_value(tokens, p)
    p = p + 1

    let mut type_params: List<String> = []
    if peek_type(tokens, p) == "LT":
        p = p + 1
        type_params.push(peek_value(tokens, p))
        p = p + 1
        for _ in 0..20:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "GT")
                // Peek after LBRACE to decide struct vs enum
                let peek_pos: Int = p + 1
                let first_tt: String = peek_type(tokens, skip_semis(tokens, peek_pos))
                if first_tt == "BAR":
                    return parse_tipo_enum(tokens, p, filename, name, is_pub, type_params)
                return parse_struct_fields(tokens, p, filename, name, is_pub, type_params)
            p = p + 1
            type_params.push(peek_value(tokens, p))
            p = p + 1
        p = expect(tokens, p, "GT")

    // Peek inside { to decide: BAR → enum variants, else → struct fields
    let peek_inside: Int = skip_semis(tokens, p + 1)
    if peek_type(tokens, peek_inside) == "BAR":
        return parse_tipo_enum(tokens, p, filename, name, is_pub, type_params)
    return parse_struct_fields(tokens, p, filename, name, is_pub, type_params)

fn parse_tipo_enum(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>) -> DefResult:
    // Parse { | Variant1 | Variant2(Type) | ... }
    let mut p: Int = pos
    p = expect(tokens, p, "LBRACE")

    let mut variants: List<EnumVariant> = []
    for _ in 0..200:
        p = skip_semis(tokens, p)
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            let ed: EnumDefData = new_enum_def_data(name, is_pub, type_params, variants)
            return new_def_result(Definition::EnumDef(ed), p)
        p = expect(tokens, p, "BAR")
        let vname: String = peek_value(tokens, p)
        p = p + 1

        let mut vtypes: List<TypeExpr> = []
        if peek_type(tokens, p) == "LPAREN":
            p = p + 1
            let mut done_args: Bool = false
            for _ in 0..20:
                if !done_args:
                    if peek_type(tokens, p) == "RPAREN":
                        p = p + 1
                        done_args = true
                if !done_args:
                    let tr: TypeResult = parse_type_expr(tokens, p, filename)
                    vtypes.push(tr.type_expr)
                    p = tr.pos
                    if peek_type(tokens, p) == "COMMA" { p = p + 1 }
        let v_parsed: EnumVariant = new_enum_variant(vname, vtypes)
        variants.push(v_parsed)
    let ed_final: EnumDefData = new_enum_def_data(name, is_pub, type_params, variants)
    return new_def_result(Definition::EnumDef(ed_final), p)

// ---------------------------------------------------------------------------
// Impl definition
// ---------------------------------------------------------------------------

// Parse a function definition and return just the FnDefData + new pos.
// Used by parse_impl_def to avoid DefResult.defn enum field access
// (Python emitter limitation: struct fields of enum type cause IR type mismatch).
struct FnDataResult:
    data: FnDefData
    pos: Int

fn parse_fn_def_as_data(tokens: List<Token>, pos: Int, filename: String) -> FnDataResult:
    let mut p: Int = pos
    let mut is_pub: Bool = false
    if peek_type(tokens, p) == "KW_PUB" { is_pub = true; p = p + 1 }
    p = expect(tokens, p, "KW_FN")
    let name: String = peek_value(tokens, p)
    p = p + 1
    let mut type_params: List<String> = []
    if peek_type(tokens, p) == "LT":
        p = p + 1
        type_params.push(peek_value(tokens, p))
        p = p + 1
        for _ in 0..20:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "GT")
                return parse_fn_params_as_data(tokens, p, filename, name, is_pub, type_params)
            p = p + 1
            type_params.push(peek_value(tokens, p))
            p = p + 1
        p = expect(tokens, p, "GT")
    return parse_fn_params_as_data(tokens, p, filename, name, is_pub, type_params)

fn parse_fn_params_as_data(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>) -> FnDataResult:
    let mut p: Int = pos
    p = expect(tokens, p, "LPAREN")
    let mut params: List<Param> = []
    if peek_type(tokens, p) != "RPAREN":
        let pr: ParamResult = parse_param(tokens, p, filename)
        params.push(pr.param)
        p = pr.pos
        for _ in 0..50:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "RPAREN")
                return parse_fn_body_as_data(tokens, p, filename, name, is_pub, type_params, params)
            p = p + 1
            if peek_type(tokens, p) == "RPAREN":
                p = p + 1
                return parse_fn_body_as_data(tokens, p, filename, name, is_pub, type_params, params)
            let pr2: ParamResult = parse_param(tokens, p, filename)
            params.push(pr2.param)
            p = pr2.pos
    p = expect(tokens, p, "RPAREN")
    return parse_fn_body_as_data(tokens, p, filename, name, is_pub, type_params, params)

fn parse_fn_body_as_data(tokens: List<Token>, pos: Int, filename: String, name: String, is_pub: Bool, type_params: List<String>, params: List<Param>) -> FnDataResult:
    let mut p: Int = pos
    let mut ret_type: Option<TypeExpr> = none
    if peek_type(tokens, p) == "ARROW":
        p = p + 1
        let tr: TypeResult = parse_type_expr(tokens, p, filename)
        ret_type = Some(tr.type_expr)
        p = tr.pos
    // v5.15.0 Te.2.D — implicit-return one-liner: ``fn name(args) = expr``.
    let mut body_block: Block = new_block(new_span(0, 0, 0, 0), [])
    if peek_type(tokens, p) == "ASSIGN":
        p = p + 1
        let er: ExprResult = parse_expr(tokens, p, filename, 0)
        let mut implstmts: List<Stmt> = []
        implstmts.push(Stmt::Return(Some(er.expr)))
        body_block = new_block(new_span(0, 0, 0, 0), implstmts)
        p = er.pos
    else:
        let br: BlockResult = parse_block(tokens, p, filename)
        body_block = br.block
        p = br.pos
    let decorators: List<Decorator> = []
    let fd: FnDefData = new_fn_def_data(new_span(0, 0, 0, 0), name, is_pub, type_params, params, ret_type, body_block, decorators)
    return new FnDataResult { data: fd, pos: p }

fn skip_brace_block(tokens: List<Token>, pos: Int) -> Int:
    let mut p: Int = pos
    if peek_type(tokens, p) == "LBRACE":
        p = p + 1
        let mut depth: Int = 1
        for _ in 0..500:
            if depth == 0 { return p }
            if peek_type(tokens, p) == "LBRACE" { depth = depth + 1 }
            if peek_type(tokens, p) == "RBRACE" { depth = depth - 1 }
            p = p + 1
    return p

fn parse_impl_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos + 1

    // Skip optional type params: impl<T, U> ...
    if peek_type(tokens, p) == "LT":
        p = p + 1
        let mut done_tp: Bool = false
        for _ in 0..20:
            if !done_tp:
                if peek_type(tokens, p) == "GT" { p = p + 1; done_tp = true }
                if !done_tp { p = p + 1 }

    let first_name: String = peek_value(tokens, p)
    p = p + 1

    // Skip optional type args: impl<T> Name<T> { ... }
    if peek_type(tokens, p) == "LT":
        p = p + 1
        let mut done_ta: Bool = false
        for _ in 0..20:
            if !done_ta:
                if peek_type(tokens, p) == "GT" { p = p + 1; done_ta = true }
                if !done_ta { p = p + 1 }

    // Check for "impl Trait for Type { ... }" syntax
    let mut target: String = first_name
    let mut trait_name: Option<String> = none
    if peek_type(tokens, p) == "KW_FOR":
        p = p + 1
        trait_name = Some(first_name)
        target = peek_value(tokens, p)
        p = p + 1

    p = expect(tokens, p, "LBRACE")

    let mut methods: List<FnDefData> = []
    for _ in 0..100:
        p = skip_semis(tokens, p)
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            return new_def_result(Definition::ImplDef(target, trait_name, methods), p)
        let r: FnDataResult = parse_fn_def_as_data(tokens, p, filename)
        methods.push(r.data)
        p = r.pos

    return new_def_result(Definition::ImplDef(target, trait_name, methods), p)

// ---------------------------------------------------------------------------
// Agent definition (brace-skip for bootstrap)
// ---------------------------------------------------------------------------

fn parse_agent_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    // Pre-create typed empty lists for AgentDefData constructor
    let no_inputs: List<AgentInput> = []
    let no_outputs: List<AgentOutput> = []
    let no_state: List<Stmt> = []
    let no_methods: List<FnDefData> = []
    let no_adecs: List<Decorator> = []
    let mut p: Int = pos
    let mut is_pub: Bool = false
    if peek_type(tokens, p) == "KW_PUB":
        is_pub = true
        p = p + 1
    p = expect(tokens, p, "KW_AGENT")
    let name: String = peek_value(tokens, p)
    p = p + 1
    p = expect(tokens, p, "LBRACE")
    let mut depth: Int = 1
    for _ in 0..100000:
        if p >= len(tokens):
            let ad_eof: AgentDefData = new_agent_def_data(name, is_pub, no_inputs, no_outputs, no_state, no_methods, no_adecs)
            return new_def_result(Definition::AgentDef(ad_eof), p)
        let tt: String = peek_type(tokens, p)
        if tt == "LBRACE" { depth = depth + 1 }
        if tt == "RBRACE":
            depth = depth - 1
            if depth == 0:
                p = p + 1
                let ad_close: AgentDefData = new_agent_def_data(name, is_pub, no_inputs, no_outputs, no_state, no_methods, no_adecs)
                return new_def_result(Definition::AgentDef(ad_close), p)
        p = p + 1
    let ad_end: AgentDefData = new_agent_def_data(name, is_pub, no_inputs, no_outputs, no_state, no_methods, no_adecs)
    return new_def_result(Definition::AgentDef(ad_end), p)

// ---------------------------------------------------------------------------
// Pipe definition (brace-skip for bootstrap)
// ---------------------------------------------------------------------------

fn parse_pipe_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let no_stages: List<Expr> = []
    let mut p: Int = pos
    let mut is_pub: Bool = false
    if peek_type(tokens, p) == "KW_PUB":
        is_pub = true
        p = p + 1
    p = expect(tokens, p, "KW_PIPE")
    let name: String = peek_value(tokens, p)
    p = p + 1
    p = expect(tokens, p, "LBRACE")
    let mut depth: Int = 1
    for _ in 0..100000:
        if p >= len(tokens):
            let pd_eof: PipeDefData = new_pipe_def_data(name, is_pub, no_stages)
            return new_def_result(Definition::PipeDef(pd_eof), p)
        let tt: String = peek_type(tokens, p)
        if tt == "LBRACE" { depth = depth + 1 }
        if tt == "RBRACE":
            depth = depth - 1
            if depth == 0:
                p = p + 1
                let pd_close: PipeDefData = new_pipe_def_data(name, is_pub, no_stages)
                return new_def_result(Definition::PipeDef(pd_close), p)
        p = p + 1
    let pd_end: PipeDefData = new_pipe_def_data(name, is_pub, no_stages)
    return new_def_result(Definition::PipeDef(pd_end), p)

// ---------------------------------------------------------------------------
// Decorated definition
// ---------------------------------------------------------------------------

fn parse_decorated_def(tokens: List<Token>, pos: Int, filename: String) -> DefResult:
    let mut p: Int = pos
    for _ in 0..10:
        if peek_type(tokens, p) != "AT" { return parse_definition(tokens, p, filename) }
        p = p + 1
        p = p + 1
        if peek_type(tokens, p) == "LPAREN":
            p = p + 1
            let mut depth: Int = 1
            for _ in 0..1000:
                if p >= len(tokens) { return parse_definition(tokens, p, filename) }
                if peek_type(tokens, p) == "LPAREN" { depth = depth + 1 }
                if peek_type(tokens, p) == "RPAREN":
                    depth = depth - 1
                    if depth == 0:
                        p = p + 1
                        return parse_definition(tokens, p, filename)
                p = p + 1
    return parse_definition(tokens, p, filename)

// ---------------------------------------------------------------------------
// Block
// ---------------------------------------------------------------------------

fn parse_block(tokens: List<Token>, pos: Int, filename: String) -> BlockResult:
    let mut p: Int = pos
    p = expect(tokens, p, "LBRACE")

    let mut stmts: List<Stmt> = []
    for _ in 0..100000:
        p = skip_semis(tokens, p)
        if at_end(tokens, p):
            let blk_eof: Block = new_block(new_span(0, 0, 0, 0), stmts)
            return new_block_result(blk_eof, p)
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            let blk_close: Block = new_block(new_span(0, 0, 0, 0), stmts)
            return new_block_result(blk_close, p)

        let sr: StmtResult = parse_stmt(tokens, p, filename)
        stmts.push(sr.stmt)
        p = sr.pos

    let blk_end: Block = new_block(new_span(0, 0, 0, 0), stmts)
    return new_block_result(blk_end, p)

// ---------------------------------------------------------------------------
// Statement dispatch
// ---------------------------------------------------------------------------

fn parse_stmt(tokens: List<Token>, pos: Int, filename: String) -> StmtResult:
    let tt: String = peek_type(tokens, pos)

    if tt == "KW_LET" { return parse_let_stmt(tokens, pos, filename) }
    if tt == "KW_RETURN" { return parse_return_stmt(tokens, pos, filename) }
    if tt == "KW_FOR" { return parse_for_stmt(tokens, pos, filename) }
    if tt == "KW_WHILE" { return parse_while_stmt(tokens, pos, filename) }
    if tt == "KW_BREAK" { return new_stmt_result(Stmt::Break, pos + 1) }
    if tt == "KW_CONTINUE" { return new_stmt_result(Stmt::Continue, pos + 1) }
    // v5.14.1 B.2: pass lowers to a no-op statement (mirror Python bootstrap).
    if tt == "KW_PASS" { return new_stmt_result(Stmt::Pass, pos + 1) }
    if tt == "KW_ASSERT" { return parse_assert_stmt(tokens, pos, filename) }

    let er: ExprResult = parse_expr(tokens, pos, filename, 0)
    return new_stmt_result(Stmt::ExprStmt(er.expr), er.pos)

// ---------------------------------------------------------------------------
// Let statement
// ---------------------------------------------------------------------------

fn parse_let_stmt(tokens: List<Token>, pos: Int, filename: String) -> StmtResult:
    let mut p: Int = pos + 1
    let mut is_mut: Bool = false

    if peek_type(tokens, p) == "KW_MUT":
        is_mut = true
        p = p + 1

    // v5.20.1 Te.5.F.D / Te.5.F.E dispatch by single-token lookahead.
    let t0: String = peek_type(tokens, p)
    let t1: String = peek_type(tokens, p + 1)

    // Te.5.F.D destructure: `let [mut] Name { ... } [: T] = expr`.
    if t0 == "NAME" && t1 == "LBRACE":
        return parse_let_destructure_body(tokens, p, filename, is_mut)

    // Te.5.F.E let-else with constructor pattern: `let Name(x) = expr else block`.
    if t0 == "NAME" && t1 == "LPAREN":
        return parse_let_else_body(tokens, p, filename)

    // Te.5.F.E let-else with wildcard pattern: `let _ = expr else block`.
    if t0 == "UNDERSCORE":
        return parse_let_else_body(tokens, p, filename)

    let name: String = peek_value(tokens, p)
    p = p + 1

    let mut type_ann: Option<TypeExpr> = none
    if peek_type(tokens, p) == "COLON":
        p = p + 1
        let tr: TypeResult = parse_type_expr(tokens, p, filename)
        type_ann = Some(tr.type_expr)
        p = tr.pos

    p = expect(tokens, p, "ASSIGN")

    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    return new_stmt_result(Stmt::Let(name, is_mut, type_ann, er.expr), er.pos)

// v5.20.1 Te.5.F.D — parse `Name { fields } [: T] = expr`. Caller has
// already consumed `KW_LET KW_MUT?`. `pos` points at the struct NAME.
fn parse_let_destructure_body(tokens: List<Token>, pos: Int, filename: String, is_mut: Bool) -> StmtResult:
    let pat_r: StructPatResult = parse_struct_dest_pat(tokens, pos, filename)
    let mut p: Int = pat_r.pos

    let mut type_ann: Option<TypeExpr> = none
    if peek_type(tokens, p) == "COLON":
        p = p + 1
        let tr: TypeResult = parse_type_expr(tokens, p, filename)
        type_ann = Some(tr.type_expr)
        p = tr.pos

    p = expect(tokens, p, "ASSIGN")

    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    return new_stmt_result(Stmt::LetDestructure(pat_r.pattern, is_mut, type_ann, er.expr), er.pos)

struct StructPatResult:
    pattern: StructPattern
    pos: Int

fn new_struct_pat_result(p: StructPattern, pos: Int) -> StructPatResult = new StructPatResult { pattern: p, pos: pos }

fn parse_struct_dest_pat(tokens: List<Token>, pos: Int, filename: String) -> StructPatResult:
    let name: String = peek_value(tokens, pos)
    let mut p: Int = pos + 1
    p = expect(tokens, p, "LBRACE")
    let mut fields: List<FieldPattern> = []
    let mut has_rest: Bool = false
    if peek_type(tokens, p) == "RBRACE":
        p = p + 1
        return new_struct_pat_result(new_struct_pattern(name, fields, has_rest), p)
    for _ in 0..200:
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            break
        if peek_type(tokens, p) == "RANGE":
            has_rest = true
            p = p + 1
            if peek_type(tokens, p) == "COMMA" { p = p + 1 }
            p = expect(tokens, p, "RBRACE")
            break
        let fr: FieldPatResult = parse_field_dest(tokens, p, filename)
        fields.push(fr.field_pattern)
        p = fr.pos
        if peek_type(tokens, p) == "COMMA" { p = p + 1 }
    return new_struct_pat_result(new_struct_pattern(name, fields, has_rest), p)

struct FieldPatResult:
    field_pattern: FieldPattern
    pos: Int

fn new_field_pat_result(fp: FieldPattern, pos: Int) -> FieldPatResult = new FieldPatResult { field_pattern: fp, pos: pos }

fn parse_field_dest(tokens: List<Token>, pos: Int, filename: String) -> FieldPatResult:
    let mut p: Int = pos
    let mut mutable: Bool = false
    if peek_type(tokens, p) == "KW_MUT":
        mutable = true
        p = p + 1
    let name: String = peek_value(tokens, p)
    p = p + 1
    let mut sub: Option<StructPattern> = none
    if peek_type(tokens, p) == "COLON":
        p = p + 1
        let sr: StructPatResult = parse_struct_dest_pat(tokens, p, filename)
        sub = Some(sr.pattern)
        p = sr.pos
        // `mut` on a nested-pattern field is meaningless (Python D4
        // discards quietly). Mirror that.
        mutable = false
    return new_field_pat_result(new_field_pattern(name, mutable, sub), p)

// v5.20.1 Te.5.F.E — parse `<pattern> = expr else block`. Caller has
// already consumed `KW_LET`. Pattern is constructor (NAME LPAREN ...)
// or wildcard (UNDERSCORE).
fn parse_let_else_body(tokens: List<Token>, pos: Int, filename: String) -> StmtResult:
    let pr: PatternResult = parse_pattern(tokens, pos, filename)
    let mut p: Int = pr.pos
    p = expect(tokens, p, "ASSIGN")
    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    p = er.pos
    p = expect(tokens, p, "KW_ELSE")
    let br: BlockResult = parse_block(tokens, p, filename)
    return new_stmt_result(Stmt::LetElse(pr.pattern, er.expr, br.block), br.pos)

// ---------------------------------------------------------------------------
// Return statement
// ---------------------------------------------------------------------------

fn parse_return_stmt(tokens: List<Token>, pos: Int, filename: String) -> StmtResult:
    let mut p: Int = pos + 1

    let tt: String = peek_type(tokens, p)
    if tt == "RBRACE" { return new_stmt_result(Stmt::Return(none), p) }
    if tt == "SEMICOLON" { return new_stmt_result(Stmt::Return(none), p) }
    if at_end(tokens, p) { return new_stmt_result(Stmt::Return(none), p) }

    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    return new_stmt_result(Stmt::Return(Some(er.expr)), er.pos)

// ---------------------------------------------------------------------------
// For statement
// ---------------------------------------------------------------------------

fn parse_for_stmt(tokens: List<Token>, pos: Int, filename: String) -> StmtResult:
    let mut p: Int = pos + 1
    let var_name: String = peek_value(tokens, p)
    p = p + 1
    p = expect(tokens, p, "KW_IN")

    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    p = er.pos

    let br: BlockResult = parse_block(tokens, p, filename)
    return new_stmt_result(Stmt::For(var_name, er.expr, br.block), br.pos)

fn parse_while_stmt(tokens: List<Token>, pos: Int, filename: String) -> StmtResult:
    let mut p: Int = pos + 1
    // v5.20.1 Te.5.F.E — `while let <pattern> = <scrutinee> { body }`.
    if peek_type(tokens, p) == "KW_LET":
        p = p + 1
        let wl_pat: PatternResult = parse_pattern(tokens, p, filename)
        p = wl_pat.pos
        p = expect(tokens, p, "ASSIGN")
        let wl_scrut: ExprResult = parse_expr(tokens, p, filename, 0)
        p = wl_scrut.pos
        let wl_body: BlockResult = parse_block(tokens, p, filename)
        return new_stmt_result(Stmt::WhileLet(wl_pat.pattern, wl_scrut.expr, wl_body.block), wl_body.pos)
    let cond_r: ExprResult = parse_expr(tokens, p, filename, 0)
    p = cond_r.pos
    let body_r: BlockResult = parse_block(tokens, p, filename)
    p = body_r.pos
    new_stmt_result(Stmt::While(cond_r.expr, body_r.block), p)

fn parse_assert_stmt(tokens: List<Token>, pos: Int, filename: String) -> StmtResult:
    let mut p: Int = pos + 1
    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    p = er.pos
    let mut msg: Option<String> = none
    if peek_type(tokens, p) == "COMMA":
        p = p + 1
        msg = Some(peek_value(tokens, p))
        p = p + 1
    new_stmt_result(Stmt::Assert(er.expr, msg), p)

// ---------------------------------------------------------------------------
// Expression parser — precedence climbing
// ---------------------------------------------------------------------------

fn parse_expr(tokens: List<Token>, pos: Int, filename: String, min_prec: Int) -> ExprResult:
    let mut left_r: ExprResult = parse_unary(tokens, pos, filename)
    let mut left: Expr = left_r.expr
    let mut p: Int = left_r.pos

    // Assignment operators (right-associative, lowest precedence)
    if min_prec == 0:
        let att: String = peek_type(tokens, p)
        if att == "ASSIGN":
            p = p + 1
            let rhs_eq: ExprResult = parse_expr(tokens, p, filename, 0)
            return new_expr_result(Expr::Assign(left, "=", rhs_eq.expr), rhs_eq.pos)
        if att == "PLUS_EQ":
            p = p + 1
            let rhs_add: ExprResult = parse_expr(tokens, p, filename, 0)
            return new_expr_result(Expr::Assign(left, "+=", rhs_add.expr), rhs_add.pos)
        if att == "MINUS_EQ":
            p = p + 1
            let rhs_sub: ExprResult = parse_expr(tokens, p, filename, 0)
            return new_expr_result(Expr::Assign(left, "-=", rhs_sub.expr), rhs_sub.pos)
        if att == "STAR_EQ":
            p = p + 1
            let rhs_mul: ExprResult = parse_expr(tokens, p, filename, 0)
            return new_expr_result(Expr::Assign(left, "*=", rhs_mul.expr), rhs_mul.pos)
        if att == "SLASH_EQ":
            p = p + 1
            let rhs_div: ExprResult = parse_expr(tokens, p, filename, 0)
            return new_expr_result(Expr::Assign(left, "/=", rhs_div.expr), rhs_div.pos)
        if att == "SEND":
            p = p + 1
            let rhs_send: ExprResult = parse_expr(tokens, p, filename, 0)
            return new_expr_result(Expr::Send(left, rhs_send.expr), rhs_send.pos)
        if att == "FAT_ARROW":
            p = p + 1
            let body: ExprResult = parse_expr(tokens, p, filename, 0)
            // Extract lambda params from the left-hand side expression.
            //   (n) => ...        parses as Ident("n")
            //   (a, b) => ...     parses as ListLit([Ident("a"), Ident("b")])
            //                     (parse_paren_expr collects comma-separated
            //                     elements into a ListLit)
            // v5.7.0 Sh.7: ListLit case was previously skipped, leaving
            // multi-param lambdas with zero params and undefined-variable
            // errors when their bodies referenced a, b, ...
            let mut params: List<Param> = []
            match left {
                Ident(name) => {
                    params.push(new_param(name, none))
                },
                ListLit(elems) => {
                    let mut li: Int = 0
                    for _ in 0..32 {
                        if li >= len(elems) { break }
                        let elem: Expr = elems[li]
                        if expr_kind(elem) == "ident" {
                            params.push(new_param(expr_ident_name(elem), none))
                        }
                        li = li + 1
                    }
                },
                _ => {}
            }
            return new_expr_result(Expr::Lambda(params, LambdaBody::ExprBody(body.expr)), body.pos)

    // Binary operator loop
    for _ in 0..10000:
        if at_end(tokens, p) { return new_expr_result(left, p) }

        let op_tt: String = peek_type(tokens, p)
        let op: String = tok_to_binop(op_tt)
        if op == "" { return new_expr_result(left, p) }

        let prec: Int = op_precedence(op)
        if prec < min_prec { return new_expr_result(left, p) }

        p = p + 1

        let mut next_prec: Int = prec + 1
        if is_right_assoc(op) { next_prec = prec }

        let right_r: ExprResult = parse_expr(tokens, p, filename, next_prec)
        p = right_r.pos

        if op == "|>":
            left = Expr::Pipe(left, right_r.expr)
        else:
            if op == "..":
                left = Expr::Range(left, right_r.expr, false)
            else:
                if op == "..=":
                    left = Expr::Range(left, right_r.expr, true)
                else:
                    if is_cmp_op(op):
                        // v5.21.0 Te.6 — collect consecutive comparisons
                        // into a chain. After consuming one cmp op,
                        // if the next op is also a cmp, accumulate.
                        let mut operands: List<Expr> = []
                        let mut ops: List<String> = []
                        operands.push(left)
                        operands.push(right_r.expr)
                        ops.push(op)
                        for _ in 0..1000:
                            if at_end(tokens, p) { break }
                            let nt: String = peek_type(tokens, p)
                            let n_op: String = tok_to_binop(nt)
                            if !is_cmp_op(n_op) { break }
                            let n_prec: Int = op_precedence(n_op)
                            if n_prec < min_prec { break }
                            p = p + 1
                            let n_next_prec: Int = n_prec + 1
                            let n_right_r: ExprResult = parse_expr(tokens, p, filename, n_next_prec)
                            p = n_right_r.pos
                            operands.push(n_right_r.expr)
                            ops.push(n_op)
                        if len(ops) == 1:
                            left = Expr::Binary(operands[0], ops[0], operands[1])
                        else:
                            left = Expr::ChainedCmp(operands, ops)
                    else:
                        left = Expr::Binary(left, op, right_r.expr)

    return new_expr_result(left, p)

// ---------------------------------------------------------------------------
// Unary expressions
// ---------------------------------------------------------------------------

fn parse_unary(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let tt: String = peek_type(tokens, pos)

    if tt == "MINUS":
        let r_neg: ExprResult = parse_unary(tokens, pos + 1, filename)
        return new_expr_result(Expr::Unary("-", r_neg.expr), r_neg.pos)
    if tt == "BANG":
        let r_not: ExprResult = parse_unary(tokens, pos + 1, filename)
        return new_expr_result(Expr::Unary("!", r_not.expr), r_not.pos)
    // v4.68.0: ``KW_AWAIT`` restored (Arc 8). See v4.67.0/DESIGN.md §3.2.
    if tt == "KW_AWAIT":
        let r_await: ExprResult = parse_unary(tokens, pos + 1, filename)
        return new_expr_result(Expr::Await(r_await.expr), r_await.pos)

    return parse_postfix(tokens, pos, filename)

// ---------------------------------------------------------------------------
// Postfix expressions
// ---------------------------------------------------------------------------

fn parse_postfix(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let mut ar: ExprResult = parse_atom(tokens, pos, filename)
    let mut left: Expr = ar.expr
    let mut p: Int = ar.pos

    for _ in 0..10000:
        if at_end(tokens, p) { return new_expr_result(left, p) }

        let tt: String = peek_type(tokens, p)

        if tt == "LPAREN":
            let cr: ExprResult = parse_call_args(tokens, p, filename, left)
            left = cr.expr
            p = cr.pos
        else:
            if tt == "DOT":
                p = p + 1
                let field_name: String = peek_value(tokens, p)
                p = p + 1

                if peek_type(tokens, p) == "LPAREN":
                    let mr: ExprResult = parse_method_args(tokens, p, filename, left, field_name)
                    left = mr.expr
                    p = mr.pos
                else:
                    left = Expr::FieldAccess(left, field_name)
            else:
                if tt == "LBRACKET":
                    p = p + 1
                    let mut items: List<IndexItem> = []
                    let first_ii: IndexItemResult = parse_index_item(tokens, p, filename)
                    p = first_ii.pos
                    items.push(first_ii.item)
                    for _ in 0..128:
                        if peek_type(tokens, p) == "COMMA":
                            p = p + 1
                            let nxt_ii: IndexItemResult = parse_index_item(tokens, p, filename)
                            p = nxt_ii.pos
                            items.push(nxt_ii.item)
                    p = expect(tokens, p, "RBRACKET")
                    // Route to Index (1 scalar), TensorIndex (≥2 scalars), or
                    // TensorSlice (any non-scalar item). v5.6.3 Sh.6 Phase 4.
                    let has_nonscalar: Bool = any_nonscalar_item(items)
                    if has_nonscalar:
                        left = Expr::TensorSlice(left, items)
                    else:
                        if len(items) == 1:
                            left = Expr::Index(left, items[0].expr)
                        else:
                            left = Expr::TensorIndex(left, scalar_exprs_of(items))
                else:
                    if tt == "QUESTION":
                        p = p + 1
                        left = Expr::ErrorProp(left)
                    else:
                        return new_expr_result(left, p)

    return new_expr_result(left, p)

// v5.6.3 Sh.6 Phase 4 — parse one subscript item (scalar / range / wildcard).
//
// Forms:
//   _              → wildcard (Expr::TensorSlice IndexItem kind="wildcard")
//   ..end          → range, open start (NoneLit..end)
//   start..        → range, open end   (start..NoneLit)   — detects COMMA/RBRACKET
//   start..end     → range
//   expr           → scalar
//
// The expression parser normally eats `..` as a binary range operator
// (precedence 6). We pass min_prec=7 so parse_expr stops before `..` and
// we can classify the item ourselves.
fn parse_index_item(tokens: List<Token>, pos: Int, filename: String) -> IndexItemResult:
    if peek_type(tokens, pos) == "UNDERSCORE":
        return new IndexItemResult { item: wildcard_index_item(), pos: pos + 1 }
    if peek_type(tokens, pos) == "RANGE":
        // `..end` — open start. Check for trailing `:step` (v5.45.0 Ts.3.A).
        let end_r: ExprResult = parse_expr(tokens, pos + 1, filename, 7)
        if peek_type(tokens, end_r.pos) == "COLON":
            let step_r: ExprResult = parse_expr(tokens, end_r.pos + 1, filename, 7)
            return new IndexItemResult { item: range_step_index_item(Expr::NoneLit, end_r.expr, step_r.expr), pos: step_r.pos }
        return new IndexItemResult { item: range_index_item(Expr::NoneLit, end_r.expr), pos: end_r.pos }
    let first: ExprResult = parse_expr(tokens, pos, filename, 7)
    if peek_type(tokens, first.pos) == "RANGE":
        let after_dd: Int = first.pos + 1
        let close: String = peek_type(tokens, after_dd)
        if close == "COMMA":
            return new IndexItemResult { item: range_index_item(first.expr, Expr::NoneLit), pos: after_dd }
        if close == "RBRACKET":
            return new IndexItemResult { item: range_index_item(first.expr, Expr::NoneLit), pos: after_dd }
        let end_r: ExprResult = parse_expr(tokens, after_dd, filename, 7)
        // v5.45.0 Ts.3.A — `start..end:step`. After the end expr, peek
        // for COLON; if found, parse the step at the same precedence
        // (7 to stop before any further `..`).
        if peek_type(tokens, end_r.pos) == "COLON":
            let step_r: ExprResult = parse_expr(tokens, end_r.pos + 1, filename, 7)
            return new IndexItemResult { item: range_step_index_item(first.expr, end_r.expr, step_r.expr), pos: step_r.pos }
        return new IndexItemResult { item: range_index_item(first.expr, end_r.expr), pos: end_r.pos }
    return new IndexItemResult { item: scalar_index_item(first.expr), pos: first.pos }

fn any_nonscalar_item(items: List<IndexItem>) -> Bool:
    let mut i: Int = 0
    let n: Int = len(items)
    for _ in 0..128:
        if i < n:
            if items[i].kind != "scalar" { return true }
            i = i + 1
    return false

fn scalar_exprs_of(items: List<IndexItem>) -> List<Expr>:
    let mut out: List<Expr> = []
    let mut i: Int = 0
    let n: Int = len(items)
    for _ in 0..128:
        if i < n:
            out.push(items[i].expr)
            i = i + 1
    out

fn parse_call_args(tokens: List<Token>, pos: Int, filename: String, callee: Expr) -> ExprResult:
    let mut p: Int = pos + 1
    let mut args: List<Expr> = []

    if peek_type(tokens, p) == "RPAREN":
        p = p + 1
        return new_expr_result(Expr::Call(callee, args), p)

    let a0: ExprResult = parse_expr(tokens, p, filename, 0)
    args.push(a0.expr)
    p = a0.pos

    while true:
        if peek_type(tokens, p) != "COMMA":
            p = expect(tokens, p, "RPAREN")
            return new_expr_result(Expr::Call(callee, args), p)
        p = p + 1
        if peek_type(tokens, p) == "RPAREN":
            p = p + 1
            return new_expr_result(Expr::Call(callee, args), p)
        let an: ExprResult = parse_expr(tokens, p, filename, 0)
        args.push(an.expr)
        p = an.pos

    p = expect(tokens, p, "RPAREN")
    return new_expr_result(Expr::Call(callee, args), p)

fn parse_method_args(tokens: List<Token>, pos: Int, filename: String, obj: Expr, method: String) -> ExprResult:
    let mut p: Int = pos + 1
    let mut args: List<Expr> = []

    if peek_type(tokens, p) == "RPAREN":
        p = p + 1
        return new_expr_result(Expr::MethodCall(obj, method, args), p)

    let a0: ExprResult = parse_expr(tokens, p, filename, 0)
    args.push(a0.expr)
    p = a0.pos

    for _ in 0..100:
        if peek_type(tokens, p) != "COMMA":
            p = expect(tokens, p, "RPAREN")
            return new_expr_result(Expr::MethodCall(obj, method, args), p)
        p = p + 1
        if peek_type(tokens, p) == "RPAREN":
            p = p + 1
            return new_expr_result(Expr::MethodCall(obj, method, args), p)
        let an: ExprResult = parse_expr(tokens, p, filename, 0)
        args.push(an.expr)
        p = an.pos

    p = expect(tokens, p, "RPAREN")
    return new_expr_result(Expr::MethodCall(obj, method, args), p)

// ---------------------------------------------------------------------------
// String interpolation helpers
// ---------------------------------------------------------------------------

// v5.16.0 Te.4.B — string interpolation detection.
// Mirrors mapanare/parser.py::_split_interp. Returns true iff `s`
// contains an unescaped `${`. The lexer preserves `\$` literally, so
// this scans for a backslash on the byte before the `$` rather than
// for a stripped escape prefix.
fn has_interpolation(s: String) -> Bool:
    let n: Int = len(s)
    for i in 0..n:
        if s.char_at(i) == "$":
            if i + 1 < n:
                if s.char_at(i + 1) == "{":
                    if i == 0 { return true }
                    if s.char_at(i - 1) != "\\" { return true }
    return false

// v5.16.0 Te.4.B/C — split a STRING_LIT value into a sequence of
// alternating `Expr::StringLit` (literal text) and `Expr` (interpolated)
// parts. Mirrors `_split_interp` + `_parse_interp_expr` from
// mapanare/parser.py. Each `${...}` site re-lexes and re-parses the
// inner expression text via `tokenize` + `parse_expr` so any expression
// form (Ident, MethodCall, Binary, Call, MapLit, ...) is supported.
// The caller wraps the result in `Expr::InterpString(parts)` so the
// lowerer can route through the existing `InterpConcat` MIR (which
// emits a chain of `__mn_str_concat` calls and Cast-to-string for
// non-StringLit parts).
fn split_interp_parts(s: String, filename: String) -> List<Expr>:
    // Position-based scan: track [seg_start, i) as the pending literal
    // segment instead of building char-by-char with `lit = lit + ch`.
    // The buffer-rebuilding approach hit a bootstrap lower bug where
    // the trailing-literal segment after an interp site emitted
    // garbage bytes into the LLVM string constant.
    let mut parts: List<Expr> = []
    let mut seg_start: Int = 0
    let mut i: Int = 0
    let n: Int = len(s)
    for _ in 0..100000:
        if i >= n { break }
        let ch: String = s.char_at(i)
        if ch == "\\":
            // Skip the escape and its next char so `\$` doesn't trip
            // the interp scanner. The literal segment kept as
            // s[seg_start..segment_end) preserves the backslash byte
            // that the lexer left intact for us.
            if i + 1 < n { i = i + 2 } else { i = i + 1 }
        else:
            if ch == "$" && i + 1 < n && s.char_at(i + 1) == "{":
                // Flush pending literal segment via substr, not a
                // rebuilt char buffer.
                if i > seg_start:
                    let lit_text: String = s.substr(seg_start, i - seg_start)
                    parts.push(Expr::StringLit(lit_text))
                let mut depth: Int = 1
                let mut j: Int = i + 2
                let mut found_close: Bool = false
                for _ in 0..100000:
                    if j >= n { break }
                    let cj: String = s.char_at(j)
                    if cj == "{":
                        depth = depth + 1
                    else:
                        if cj == "}":
                            depth = depth - 1
                            if depth == 0 { found_close = true; break }
                    j = j + 1
                if found_close == false:
                    // Unterminated `${...}` — fold the `$` into the
                    // pending segment and continue.
                    i = i + 1
                else:
                    let expr_len: Int = j - (i + 2)
                    let expr_text: String = s.substr(i + 2, expr_len)
                    let etokens: List<Token> = tokenize(expr_text, filename)
                    let er: ExprResult = parse_expr(etokens, 0, filename, 0)
                    parts.push(er.expr)
                    i = j + 1
                    seg_start = i
            else:
                i = i + 1
    if i > seg_start:
        let tail_text: String = s.substr(seg_start, i - seg_start)
        parts.push(Expr::StringLit(tail_text))
    return parts

// ---------------------------------------------------------------------------
// Atom expressions
// ---------------------------------------------------------------------------

fn parse_struct_fields_to_list(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    // Parse field values: `name: expr` or `name` (shorthand), comma-separated.
    // Returns a ListLit of the field values (ignoring field names).
    //
    // v5.20.1 Te.5.F.B — value-omitted shorthand: when `:` is absent,
    // synthesize `Ident(name)` as the value (mirrors Python `field_init`
    // fall-through at `mapanare/parser.py:1022`).
    let mut p: Int = pos
    let mut vals: List<Expr> = []
    for _ in 0..100:
        if peek_type(tokens, p) == "RBRACE":
            return new_expr_result(Expr::ListLit(vals), p + 1)
        let fname: String = peek_value(tokens, p)
        p = p + 1  // consume field name
        if peek_type(tokens, p) == "COLON":
            p = p + 1
            let er: ExprResult = parse_expr(tokens, p, filename, 0)
            p = er.pos
            vals.push(er.expr)
        else:
            vals.push(Expr::Ident(fname))
        if peek_type(tokens, p) == "COMMA" { p = p + 1 }
    return new_expr_result(Expr::ListLit(vals), p)

fn parse_struct_construct(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    // Parse: `new Name { field: val, ..., [..base] }`.
    //
    // Without a `..base` trailer, returns `Call(Ident("__new_Name"),
    // [val1, val2, ...])` — preserves IR shape for the 80+ legacy
    // goldens that pre-date Te.5. With a `..base` trailer, returns
    // `Expr::ConstructUpdate(name, overrides, base)` (v5.20.1
    // Te.5.F.C). The two forms cannot mix-and-match: once the parser
    // sees `..`, it consumes the base and expects the closing brace.
    let struct_name: String = peek_value(tokens, pos + 1)
    let mut p: Int = pos + 2
    p = expect(tokens, p, "LBRACE")

    let mut overrides: List<FieldInit> = []
    let mut has_base: Bool = false
    let mut base_expr: Expr = Expr::NoneLit

    // Empty body: `new T { }` — no fields, no base.
    if peek_type(tokens, p) == "RBRACE":
        let callee_e: Expr = Expr::Ident("__new_" + struct_name)
        let empty_e: List<Expr> = []
        return new_expr_result(Expr::Call(callee_e, empty_e), p + 1)

    // Bare `..base` form: `new T { ..base }`.
    if peek_type(tokens, p) == "RANGE":
        p = p + 1
        let bre: ExprResult = parse_expr(tokens, p, filename, 0)
        base_expr = bre.expr
        p = bre.pos
        if peek_type(tokens, p) == "COMMA" { p = p + 1 }
        p = expect(tokens, p, "RBRACE")
        return new_expr_result(Expr::ConstructUpdate(struct_name, overrides, base_expr), p)

    // Field-init list with optional trailing `..base`.
    for _ in 0..100:
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            break
        if peek_type(tokens, p) == "RANGE":
            p = p + 1
            let bre2: ExprResult = parse_expr(tokens, p, filename, 0)
            base_expr = bre2.expr
            p = bre2.pos
            has_base = true
            if peek_type(tokens, p) == "COMMA" { p = p + 1 }
            p = expect(tokens, p, "RBRACE")
            break
        let fname: String = peek_value(tokens, p)
        p = p + 1
        let mut val_expr: Expr = Expr::Ident(fname)
        if peek_type(tokens, p) == "COLON":
            p = p + 1
            let ver: ExprResult = parse_expr(tokens, p, filename, 0)
            val_expr = ver.expr
            p = ver.pos
        let fi: FieldInit = new FieldInit { span: new_span(0, 0, 0, 0), name: fname, value: val_expr }
        overrides.push(fi)
        if peek_type(tokens, p) == "COMMA" { p = p + 1 }

    if has_base:
        return new_expr_result(Expr::ConstructUpdate(struct_name, overrides, base_expr), p)

    // No base: collapse to legacy positional `Call(__new_X, vals)`
    // shape. Field names are dropped — same as pre-v5.20.1 behavior,
    // so existing 80 goldens IR-byte-identical.
    let mut vals: List<Expr> = []
    let mut vi: Int = 0
    let nov: Int = len(overrides)
    for _ in 0..500:
        if vi < nov:
            vals.push(overrides[vi].value)
            vi = vi + 1
    let callee: Expr = Expr::Ident("__new_" + struct_name)
    return new_expr_result(Expr::Call(callee, vals), p)

fn parse_atom(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let tt: String = peek_type(tokens, pos)
    let val: String = peek_value(tokens, pos)

    // Integer literals
    if tt == "DEC_INT" { return new_expr_result(Expr::IntLit(int(val)), pos + 1) }
    if tt == "HEX_INT" { return new_expr_result(Expr::IntLit(int(val)), pos + 1) }
    if tt == "BIN_INT" { return new_expr_result(Expr::IntLit(int(val)), pos + 1) }
    if tt == "OCT_INT" { return new_expr_result(Expr::IntLit(int(val)), pos + 1) }

    // Float literal
    if tt == "FLOAT_LIT" { return new_expr_result(Expr::FloatLit(float(val)), pos + 1) }

    // String literal — check for interpolation ${...}
    if tt == "STRING_LIT":
        if has_interpolation(val):
            let parts: List<Expr> = split_interp_parts(val, filename)
            // v5.16.0 Te.4.C — wrap in dedicated AST node mirroring
            // Python `InterpString`. Lowered via `InterpConcat` MIR.
            return new_expr_result(Expr::InterpString(parts), pos + 1)
        // No interp: STRING_LIT may still carry preserved `\$`
        // sequences from the lexer. Mirrors Python's post-`_split_interp`
        // path which leaves `\$` literal in the StringLit value.
        return new_expr_result(Expr::StringLit(val), pos + 1)

    // Char literal
    if tt == "CHAR_LIT" { return new_expr_result(Expr::CharLit(val), pos + 1) }

    // Bool literals
    if tt == "KW_TRUE" { return new_expr_result(Expr::BoolLit(true), pos + 1) }
    if tt == "KW_FALSE" { return new_expr_result(Expr::BoolLit(false), pos + 1) }

    // None literal
    if tt == "KW_NONE" { return new_expr_result(Expr::NoneLit, pos + 1) }

    // Self
    if tt == "KW_SELF" { return new_expr_result(Expr::Ident("self"), pos + 1) }

    // If expression
    if tt == "KW_IF" { return parse_if_expr(tokens, pos, filename) }

    // Match expression
    if tt == "KW_MATCH" { return parse_match_expr(tokens, pos, filename) }

    // Spawn expression
    if tt == "KW_SPAWN" { return parse_spawn_expr(tokens, pos, filename) }

    // Sync expression
    if tt == "KW_SYNC":
        let sr: ExprResult = parse_postfix(tokens, pos + 1, filename)
        return new_expr_result(Expr::Sync(sr.expr), sr.pos)

    // Signal expression
    if tt == "KW_SIGNAL" { return parse_signal_expr(tokens, pos, filename) }

    // Tensor literal: Tensor<Type>[elements]  (v4.42.0)
    if tt == "KW_TENSOR":
        if pos + 1 < len(tokens):
            let next_tt: String = tokens[pos + 1].tok_type
            if next_tt == "LT":
                return parse_tensor_lit(tokens, pos, filename)

    // Map literal: #{ key: val, ... }
    if tt == "MAP_OPEN" { return parse_map_lit(tokens, pos, filename) }

    // List literal
    if tt == "LBRACKET" { return parse_list_lit(tokens, pos, filename) }

    // v5.15.0 Te.2.F — terse lambda: ``|x| body``, ``|x, y| body``, ``|| body``.
    // BAR is never the start of an expression elsewhere, so this is
    // unambiguous in expression position.
    if tt == "BAR":
        let mut p: Int = pos + 1
        let mut params: List<Param> = []
        if peek_type(tokens, p) != "BAR":
            let n0: String = peek_value(tokens, p)
            params.push(new_param(n0, none))
            p = p + 1
            for _ in 0..32:
                if peek_type(tokens, p) != "COMMA" { break }
                p = p + 1
                let nn: String = peek_value(tokens, p)
                params.push(new_param(nn, none))
                p = p + 1
        p = expect(tokens, p, "BAR")
        let body_r: ExprResult = parse_expr(tokens, p, filename, 0)
        return new_expr_result(Expr::Lambda(params, LambdaBody::ExprBody(body_r.expr)), body_r.pos)

    // Parenthesized expression
    if tt == "LPAREN" { return parse_paren_expr(tokens, pos, filename) }

    // Struct constructor: new Name { field: val, ... }
    // Emits as Call(Ident("__new_Name"), [val1, val2, ...]).
    // The emitter handles __new_ calls as struct construction.
    if tt == "KW_NEW":
        return parse_struct_construct(tokens, pos, filename)

    // Identifier or namespace access
    // Soft keywords: allowed as identifiers in expression position
    if tt == "NAME" || tt == "KW_INPUT" || tt == "KW_OUTPUT" || tt == "KW_AGENT" || tt == "KW_DI" || tt == "KW_STREAM":
        let name: String = val
        if peek_type(tokens, pos + 1) == "DOUBLE_COLON":
            let ns_member: String = peek_value(tokens, pos + 2)
            return new_expr_result(Expr::NamespaceAccess(name, ns_member), pos + 3)
        return new_expr_result(Expr::Ident(name), pos + 1)

    // Fallback
    return new_expr_result(Expr::NoneLit, pos + 1)

// ---------------------------------------------------------------------------
// If expression
// ---------------------------------------------------------------------------

fn parse_if_expr(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let mut p: Int = pos + 1

    // v5.20.1 Te.5.F.E — `if let <pattern> = <scrutinee> { ... } [else { ... }]`.
    if peek_type(tokens, p) == "KW_LET":
        p = p + 1
        let il_pat: PatternResult = parse_pattern(tokens, p, filename)
        p = il_pat.pos
        p = expect(tokens, p, "ASSIGN")
        let il_scrut: ExprResult = parse_expr(tokens, p, filename, 0)
        p = il_scrut.pos
        let il_then: BlockResult = parse_block(tokens, p, filename)
        p = il_then.pos
        let mut il_else: Option<Block> = none
        if peek_type(tokens, p) == "KW_ELSE":
            p = p + 1
            let il_eb: BlockResult = parse_block(tokens, p, filename)
            il_else = Some(il_eb.block)
            p = il_eb.pos
        return new_expr_result(Expr::IfLet(il_pat.pattern, il_scrut.expr, il_then.block, il_else), p)

    let cond_r: ExprResult = parse_expr(tokens, p, filename, 0)
    p = cond_r.pos

    let then_r: BlockResult = parse_block(tokens, p, filename)
    p = then_r.pos

    if peek_type(tokens, p) != "KW_ELSE":
        return new_expr_result(Expr::If(cond_r.expr, then_r.block, none), p)

    p = p + 1

    if peek_type(tokens, p) == "KW_IF":
        let elif_r: ExprResult = parse_if_expr(tokens, p, filename)
        let else_stmts: List<Stmt> = [Stmt::ExprStmt(elif_r.expr)]
        let else_block: Block = new_block(new_span(0, 0, 0, 0), else_stmts)
        let ec_elif: ElseClause = ElseClause::ElseBlock(else_block)
        return new_expr_result(Expr::If(cond_r.expr, then_r.block, Some(ec_elif)), elif_r.pos)

    let else_r: BlockResult = parse_block(tokens, p, filename)
    let ec_else: ElseClause = ElseClause::ElseBlock(else_r.block)
    return new_expr_result(Expr::If(cond_r.expr, then_r.block, Some(ec_else)), else_r.pos)

// ---------------------------------------------------------------------------
// Match expression
// ---------------------------------------------------------------------------

fn parse_match_expr(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let mut p: Int = pos + 1

    let subj_r: ExprResult = parse_expr(tokens, p, filename, 0)
    p = subj_r.pos

    p = expect(tokens, p, "LBRACE")

    let mut arms: List<MatchArm> = []
    for _ in 0..100:
        p = skip_semis(tokens, p)
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            return new_expr_result(Expr::Match(subj_r.expr, arms), p)

        let mar: MatchArmResult = parse_match_arm_item(tokens, p, filename)
        arms.push(mar.arm)
        p = mar.pos

        if peek_type(tokens, p) == "COMMA" { p = p + 1 }

    return new_expr_result(Expr::Match(subj_r.expr, arms), p)

fn parse_match_arm_item(tokens: List<Token>, pos: Int, filename: String) -> MatchArmResult:
    let pr: PatternResult = parse_pattern(tokens, pos, filename)
    let mut p: Int = pr.pos

    // v4.35.0: optional guard — `if <expr>` before `=>`
    let mut guard: Option<Expr> = None
    if peek_type(tokens, p) == "KW_IF":
        p = p + 1
        let gr: ExprResult = parse_expr(tokens, p, filename, 0)
        guard = Some(gr.expr)
        p = gr.pos

    p = expect(tokens, p, "FAT_ARROW")

    if peek_type(tokens, p) == "LBRACE":
        let br: BlockResult = parse_block(tokens, p, filename)
        let arm_blk: MatchArm = new_match_arm(pr.pattern, MatchArmBody::BlockBody(br.block), guard)
        return new_match_arm_result(arm_blk, br.pos)

    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    let arm_expr: MatchArm = new_match_arm(pr.pattern, MatchArmBody::ExprBody(er.expr), guard)
    return new_match_arm_result(arm_expr, er.pos)

// ---------------------------------------------------------------------------
// Pattern
// ---------------------------------------------------------------------------

fn parse_pattern(tokens: List<Token>, pos: Int, filename: String) -> PatternResult:
    // v4.35.0: parse or-patterns — `pattern_alt (| pattern_alt)*`
    let first: PatternResult = parse_pattern_alt(tokens, pos, filename)
    let mut p: Int = first.pos
    if peek_type(tokens, p) != "BAR":
        return first
    let mut alts: List<Pattern> = [first.pattern]
    for _ in 0..20:
        if peek_type(tokens, p) != "BAR":
            return new_pattern_result(Pattern::OrPat(alts), p)
        p = p + 1
        let next: PatternResult = parse_pattern_alt(tokens, p, filename)
        alts.push(next.pattern)
        p = next.pos
    return new_pattern_result(Pattern::OrPat(alts), p)

fn parse_pattern_alt(tokens: List<Token>, pos: Int, filename: String) -> PatternResult:
    let tt: String = peek_type(tokens, pos)
    let val: String = peek_value(tokens, pos)

    if val == "_":
        return new_pattern_result(Pattern::Wildcard, pos + 1)

    if tt == "DEC_INT" { return new_pattern_result(Pattern::LiteralPat(Expr::IntLit(int(val))), pos + 1) }
    if tt == "FLOAT_LIT" { return new_pattern_result(Pattern::LiteralPat(Expr::FloatLit(float(val))), pos + 1) }
    if tt == "STRING_LIT" { return new_pattern_result(Pattern::LiteralPat(Expr::StringLit(val)), pos + 1) }
    if tt == "KW_TRUE" { return new_pattern_result(Pattern::LiteralPat(Expr::BoolLit(true)), pos + 1) }
    if tt == "KW_FALSE" { return new_pattern_result(Pattern::LiteralPat(Expr::BoolLit(false)), pos + 1) }

    if tt == "NAME":
        if peek_type(tokens, pos + 1) == "LPAREN":
            let name: String = val
            let mut p: Int = pos + 2
            let mut pats: List<Pattern> = []

            if peek_type(tokens, p) != "RPAREN":
                let p0: PatternResult = parse_pattern(tokens, p, filename)
                pats.push(p0.pattern)
                p = p0.pos
                for _ in 0..20:
                    if peek_type(tokens, p) != "COMMA":
                        p = expect(tokens, p, "RPAREN")
                        return new_pattern_result(Pattern::ConstructorPat(name, pats), p)
                    p = p + 1
                    let pn: PatternResult = parse_pattern(tokens, p, filename)
                    pats.push(pn.pattern)
                    p = pn.pos
            p = expect(tokens, p, "RPAREN")
            return new_pattern_result(Pattern::ConstructorPat(name, pats), p)

        return new_pattern_result(Pattern::IdentPat(val), pos + 1)

    return new_pattern_result(Pattern::Wildcard, pos + 1)

// ---------------------------------------------------------------------------
// Spawn expression
// ---------------------------------------------------------------------------

fn parse_spawn_expr(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let mut p: Int = pos + 1
    let name: String = peek_value(tokens, p)
    p = p + 1

    p = expect(tokens, p, "LPAREN")
    let mut args: List<Expr> = []
    if peek_type(tokens, p) != "RPAREN":
        let a0: ExprResult = parse_expr(tokens, p, filename, 0)
        args.push(a0.expr)
        p = a0.pos
        for _ in 0..50:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "RPAREN")
                let callee_early: Expr = Expr::Ident(name)
                return new_expr_result(Expr::Spawn(callee_early, args), p)
            p = p + 1
            let an: ExprResult = parse_expr(tokens, p, filename, 0)
            args.push(an.expr)
            p = an.pos
    p = expect(tokens, p, "RPAREN")
    let callee_final: Expr = Expr::Ident(name)
    return new_expr_result(Expr::Spawn(callee_final, args), p)

// ---------------------------------------------------------------------------
// Signal expression
// ---------------------------------------------------------------------------

fn parse_signal_expr(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let mut p: Int = pos + 1

    if peek_type(tokens, p) == "LPAREN":
        p = p + 1
        let er: ExprResult = parse_expr(tokens, p, filename, 0)
        p = er.pos
        p = expect(tokens, p, "RPAREN")
        return new_expr_result(Expr::SignalVal(er.expr, false), p)

    if peek_type(tokens, p) == "LBRACE":
        let br: BlockResult = parse_block(tokens, p, filename)
        return new_expr_result(Expr::SignalVal(Expr::NoneLit, true), br.pos)

    return new_expr_result(Expr::NoneLit, p)

// ---------------------------------------------------------------------------
// List literal
// ---------------------------------------------------------------------------

fn parse_map_lit(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    // MAP_OPEN = "#{", already consumed one token (pos is at MAP_OPEN)
    let mut p: Int = pos + 1
    let mut entries: List<MapEntry> = []

    // Empty map: #:
        pass
    if peek_type(tokens, p) == "RBRACE":
        p = p + 1
        return new_expr_result(Expr::MapLit(entries), p)

    // First entry: key: value
    let k0: ExprResult = parse_expr(tokens, p, filename, 0)
    p = k0.pos
    p = expect(tokens, p, "COLON")
    let v0: ExprResult = parse_expr(tokens, p, filename, 0)
    p = v0.pos

    // v5.15.1 — map comprehension disambiguator. After the first
    // `key: value` pair, a `for` keyword switches into comprehension
    // mode; otherwise this is a regular map literal.
    if peek_type(tokens, p) == "KW_FOR":
        return parse_map_comp_tail(tokens, p, filename, k0.expr, v0.expr)

    entries.push(new MapEntry { key: k0.expr, value: v0.expr })

    for _ in 0..10000:
        if peek_type(tokens, p) != "COMMA":
            p = expect(tokens, p, "RBRACE")
            return new_expr_result(Expr::MapLit(entries), p)
        p = p + 1
        if peek_type(tokens, p) == "RBRACE":
            p = p + 1
            return new_expr_result(Expr::MapLit(entries), p)
        let kn: ExprResult = parse_expr(tokens, p, filename, 0)
        p = kn.pos
        p = expect(tokens, p, "COLON")
        let vn: ExprResult = parse_expr(tokens, p, filename, 0)
        p = vn.pos
        entries.push(new MapEntry { key: kn.expr, value: vn.expr })

    p = expect(tokens, p, "RBRACE")
    return new_expr_result(Expr::MapLit(entries), p)

fn parse_list_lit(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let mut p: Int = pos + 1
    let mut elems: List<Expr> = []

    if peek_type(tokens, p) == "RBRACKET":
        p = p + 1
        return new_expr_result(Expr::ListLit(elems), p)

    let e0: ExprResult = parse_expr(tokens, p, filename, 0)
    p = e0.pos

    // v5.15.1 — list comprehension disambiguator. After the first
    // element, a `for` keyword switches into comprehension mode;
    // otherwise this is a regular list literal.
    if peek_type(tokens, p) == "KW_FOR":
        return parse_list_comp_tail(tokens, p, filename, e0.expr)

    elems.push(e0.expr)

    for _ in 0..10000:
        if peek_type(tokens, p) != "COMMA":
            p = expect(tokens, p, "RBRACKET")
            return new_expr_result(Expr::ListLit(elems), p)
        p = p + 1
        if peek_type(tokens, p) == "RBRACKET":
            p = p + 1
            return new_expr_result(Expr::ListLit(elems), p)
        let en_val: ExprResult = parse_expr(tokens, p, filename, 0)
        elems.push(en_val.expr)
        p = en_val.pos

    p = expect(tokens, p, "RBRACKET")
    return new_expr_result(Expr::ListLit(elems), p)

// ---------------------------------------------------------------------------
// Comprehension parsing (v5.15.1 — Cb.2/Cb.3)
//
// Mirrors mapanare/parser.py::list_comp / map_comp / comp_clause. Disambig
// happens at the call site (parse_list_lit / parse_map_lit) when the
// next token after the first element/entry is KW_FOR.
// ---------------------------------------------------------------------------

struct CompClauseResult:
    clause: CompClause
    pos: Int

fn new_comp_clause_result(clause: CompClause, pos: Int) -> CompClauseResult = new CompClauseResult { clause: clause, pos: pos }

fn parse_comp_clause(tokens: List<Token>, pos: Int, filename: String) -> CompClauseResult:
    // pos is at KW_FOR
    let mut p: Int = expect(tokens, pos, "KW_FOR")
    let target: String = peek_value(tokens, p)
    p = p + 1
    p = expect(tokens, p, "KW_IN")
    let iter_r: ExprResult = parse_expr(tokens, p, filename, 0)
    p = iter_r.pos

    let mut conditions: List<Expr> = []
    for _ in 0..32:
        if peek_type(tokens, p) != "KW_IF" { break }
        p = p + 1
        let cond_r: ExprResult = parse_expr(tokens, p, filename, 0)
        conditions.push(cond_r.expr)
        p = cond_r.pos

    return new_comp_clause_result(new_comp_clause(target, iter_r.expr, conditions), p)

fn parse_list_comp_tail(tokens: List<Token>, pos: Int, filename: String, first_expr: Expr) -> ExprResult:
    let mut p: Int = pos
    let mut clauses: List<CompClause> = []
    for _ in 0..32:
        if peek_type(tokens, p) != "KW_FOR" { break }
        let cr: CompClauseResult = parse_comp_clause(tokens, p, filename)
        clauses.push(cr.clause)
        p = cr.pos
    p = expect(tokens, p, "RBRACKET")
    new_expr_result(Expr::Comprehension("list", Some(first_expr), none, none, clauses), p)

fn parse_map_comp_tail(tokens: List<Token>, pos: Int, filename: String, first_key: Expr, first_value: Expr) -> ExprResult:
    let mut p: Int = pos
    let mut clauses: List<CompClause> = []
    for _ in 0..32:
        if peek_type(tokens, p) != "KW_FOR" { break }
        let cr: CompClauseResult = parse_comp_clause(tokens, p, filename)
        clauses.push(cr.clause)
        p = cr.pos
    p = expect(tokens, p, "RBRACE")
    new_expr_result(Expr::Comprehension("map", none, Some(first_key), Some(first_value), clauses), p)

// ---------------------------------------------------------------------------
// Tensor literal: Tensor<Type>[elements] (v4.42.0, v5.6.0 nested-array)
// Parses Tensor<Type>[...] with full nested-array support for 2D/3D/etc.:
//   Tensor<Float>[1.0, 2.0]                   -- shape [2]
//   Tensor<Float>[[1.0, 2.0], [3.0, 4.0]]     -- shape [2,2]
//   Tensor<Float>[[[1.0]]]                    -- shape [1,1,1]
// Shape is inferred from nesting depth; elements are flattened row-major
// into the returned Expr::TensorLit. Mirrors mapanare/parser.py::
// tensor_literal + _walk (v4.42.0).
//
// Implementation notes:
// - Iterative depth-stack walk rather than a recursive helper (the earlier
//   recursive version lost List<Expr> .push mutations across the function-
//   boundary return path).
// - Index-assignment into List<Int> inside an if-else chain that lives in
//   a self-compilation path triggers a pre-existing inliner/PHI bug in the
//   self-hosted emitter (emit_index_set's `ls.ok.N` blocks become the real
//   predecessor but the enclosing if_result PHI still references the if-
//   block label). To sidestep: _tensor_set_shape / _tensor_inc_count wrap
//   the list writes in their own single-block helpers, isolating the
//   `ls.ok.N` blocks from the caller's CFG.
// ---------------------------------------------------------------------------

fn _tensor_pad_list(list: List<Int>, min_len: Int) -> List<Int>:
    let mut out: List<Int> = list
    for _ in 0..64:
        if len(out) > min_len { break }
        out.push(0)
    out

fn _tensor_set_at(list: List<Int>, idx: Int, val: Int) -> List<Int>:
    let mut out: List<Int> = list
    out[idx] = val
    out

fn _tensor_inc_at(list: List<Int>, idx: Int) -> List<Int>:
    let mut out: List<Int> = list
    out[idx] = list[idx] + 1
    out

fn parse_tensor_lit(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    // pos points at KW_TENSOR. Consume Tensor < T > [ — we are at the first
    // token INSIDE the outermost literal body once parse_tensor_lit returns
    // control to its body loop.
    let mut p: Int = pos + 1
    p = expect(tokens, p, "LT")
    let tr: TypeResult = parse_type_expr(tokens, p, filename)
    p = tr.pos
    p = expect(tokens, p, "GT")
    p = expect(tokens, p, "LBRACKET")

    // depth = current nesting level (0 = outermost). counts[d] counts
    // siblings seen so far at depth d. shape[d] is finalized when we close
    // depth d via RBRACKET.
    let mut flat: List<Expr> = []
    let mut shape: List<Int> = []
    let mut counts: List<Int> = []
    counts.push(0)
    let mut depth: Int = 0

    for _ in 0..1000000:
        let tt: String = peek_type(tokens, p)
        if tt == "RBRACKET":
            shape = _tensor_pad_list(shape, depth)
            shape = _tensor_set_at(shape, depth, counts[depth])
            p = p + 1
            if depth == 0:
                return new_expr_result(Expr::TensorLit(flat, shape), p)
            depth = depth - 1
            counts = _tensor_inc_at(counts, depth)
        else if tt == "COMMA":
            p = p + 1
        else if tt == "LBRACKET":
            depth = depth + 1
            counts = _tensor_pad_list(counts, depth)
            counts = _tensor_set_at(counts, depth, 0)
            p = p + 1
        else:
            let er: ExprResult = parse_expr(tokens, p, filename, 0)
            flat.push(er.expr)
            counts = _tensor_inc_at(counts, depth)
            p = er.pos
    return new_expr_result(Expr::TensorLit(flat, shape), p)

// ---------------------------------------------------------------------------
// Parenthesized expression
// ---------------------------------------------------------------------------

fn parse_paren_expr(tokens: List<Token>, pos: Int, filename: String) -> ExprResult:
    let mut p: Int = pos + 1

    let er: ExprResult = parse_expr(tokens, p, filename, 0)
    p = er.pos

    if peek_type(tokens, p) == "RPAREN":
        p = p + 1
        return new_expr_result(er.expr, p)

    // Tuple: (expr, expr, ...)
    let mut elems: List<Expr> = [er.expr]
    for _ in 0..100:
        if peek_type(tokens, p) != "COMMA":
            p = expect(tokens, p, "RPAREN")
            return new_expr_result(Expr::ListLit(elems), p)
        p = p + 1
        let en_val: ExprResult = parse_expr(tokens, p, filename, 0)
        elems.push(en_val.expr)
        p = en_val.pos
    p = expect(tokens, p, "RPAREN")
    return new_expr_result(Expr::ListLit(elems), p)

// ---------------------------------------------------------------------------
// Type expression parser
// ---------------------------------------------------------------------------

fn parse_type_expr(tokens: List<Token>, pos: Int, filename: String) -> TypeResult:
    let tt: String = peek_type(tokens, pos)

    if tt == "KW_FN" { return parse_fn_type(tokens, pos, filename) }

    // v5.6.0 (Sh.6): KW_TENSOR treated as a type name in type position, so
    // `let x: Tensor<Int>` still parses (Tensor became a keyword to
    // disambiguate tensor literals). The token value is still "Tensor".
    if tt == "NAME" || tt == "KW_TENSOR":
        let mut name: String = peek_value(tokens, pos)
        let mut p: Int = pos + 1
        for _ in 0..10:
            if peek_type(tokens, p) != "DOT" { break }
            if peek_type(tokens, p + 1) != "NAME" { break }
            name = name + "." + peek_value(tokens, p + 1)
            p = p + 2
        if peek_type(tokens, p) == "LT":
            return parse_generic_type_at(tokens, p, name, filename)
        return new_type_result(TypeExpr::Named(name), p)

    return new_type_result(TypeExpr::Named("Void"), pos + 1)

fn parse_generic_type(tokens: List<Token>, pos: Int, filename: String) -> TypeResult:
    let name: String = peek_value(tokens, pos)
    parse_generic_type_at(tokens, pos + 1, name, filename)

fn parse_generic_type_at(tokens: List<Token>, pos: Int, name: String, filename: String) -> TypeResult:
    let mut p: Int = pos
    p = expect(tokens, p, "LT")

    let mut args: List<TypeExpr> = []
    let t0: TypeResult = parse_type_expr(tokens, p, filename)
    args.push(t0.type_expr)
    p = t0.pos

    for _ in 0..20:
        if peek_type(tokens, p) != "COMMA":
            p = expect(tokens, p, "GT")
            return new_type_result(TypeExpr::Generic(name, args), p)
        p = p + 1
        let tn: TypeResult = parse_type_expr(tokens, p, filename)
        args.push(tn.type_expr)
        p = tn.pos

    p = expect(tokens, p, "GT")
    return new_type_result(TypeExpr::Generic(name, args), p)

fn parse_fn_type(tokens: List<Token>, pos: Int, filename: String) -> TypeResult:
    let mut p: Int = pos + 1
    p = expect(tokens, p, "LPAREN")

    let mut param_types: List<TypeExpr> = []
    if peek_type(tokens, p) != "RPAREN":
        let t0: TypeResult = parse_type_expr(tokens, p, filename)
        param_types.push(t0.type_expr)
        p = t0.pos
        for _ in 0..20:
            if peek_type(tokens, p) != "COMMA":
                p = expect(tokens, p, "RPAREN")
                p = expect(tokens, p, "ARROW")
                let ret_early: TypeResult = parse_type_expr(tokens, p, filename)
                return new_type_result(TypeExpr::FnTy(param_types, ret_early.type_expr), ret_early.pos)
            p = p + 1
            let tn: TypeResult = parse_type_expr(tokens, p, filename)
            param_types.push(tn.type_expr)
            p = tn.pos
    p = expect(tokens, p, "RPAREN")
    p = expect(tokens, p, "ARROW")
    let ret_final: TypeResult = parse_type_expr(tokens, p, filename)
    return new_type_result(TypeExpr::FnTy(param_types, ret_final.type_expr), ret_final.pos)

// ===== semantic.mn =====
// semantic.mn — Semantic analysis for the Mapanare self-hosted compiler.
// Port of mapa/semantic.py to native Mapanare.
// Performs type checking and scope resolution via two-pass analysis:
//   Pass 1: register all top-level definitions (names & signatures)
//   Pass 2: check function bodies, expressions, and statements


// ---------------------------------------------------------------------------
// SemanticError
// ---------------------------------------------------------------------------

struct SemanticError:
    message: String
    line: Int
    column: Int
    filename: String

fn new_semantic_error(msg: String, line: Int, col: Int, fname: String) -> SemanticError = new SemanticError { message: msg, line: line, column: col, filename: fname }

// ---------------------------------------------------------------------------
// Type representation
// ---------------------------------------------------------------------------

struct TypeInfo:
    name: String
    args: List<TypeInfo>
    is_function: Bool
    param_types: List<TypeInfo>
    return_type: Option<TypeInfo>
    tensor_shape: Option<List<Int>>

fn new_type_info(name: String, args: List<TypeInfo>, is_fn: Bool, params: List<TypeInfo>, ret: Option<TypeInfo>, shape: Option<List<Int>>) -> TypeInfo = new TypeInfo { name: name, args: args, is_function: is_fn, param_types: params, return_type: ret, tensor_shape: shape }

// Singleton type constructors
fn unknown_type() -> TypeInfo = make_type("<unknown>")

// v4.53.0: UNRESOLVED/ERROR split (A8)
fn error_type() -> TypeInfo = make_type("<error>")

fn type_is_error(ti: TypeInfo) -> Bool = ti.name == "<error>"

// Returns true for <unknown>, <unresolved>, or <error> — any type where
// downstream checks should be skipped (either "not yet known" or "already broken").
fn type_should_skip(name: String) -> Bool:
    if name == "<unknown>" { return true }
    if name == "<unresolved>" { return true }
    if name == "<error>" { return true }
    return false

fn int_type() -> TypeInfo = make_type("Int")

fn float_type() -> TypeInfo = make_type("Float")

fn bool_type() -> TypeInfo = make_type("Bool")

fn string_type() -> TypeInfo = make_type("String")

fn char_type() -> TypeInfo = make_type("Char")

fn void_type() -> TypeInfo = make_type("Void")

fn make_type(name: String) -> TypeInfo:
    let args: List<TypeInfo> = []
    let params: List<TypeInfo> = []
    new_type_info(name, args, false, params, none, none)

fn make_generic_type(name: String, args: List<TypeInfo>) -> TypeInfo:
    let params: List<TypeInfo> = []
    new_type_info(name, args, false, params, none, none)

fn make_fn_type(params: List<TypeInfo>, ret: TypeInfo) -> TypeInfo:
    let args: List<TypeInfo> = []
    new_type_info("<fn>", args, true, params, Some(ret), none)

fn make_builtin_fn_type(ret: TypeInfo) -> TypeInfo:
    let args: List<TypeInfo> = []
    let params: List<TypeInfo> = []
    new_type_info("<builtin>", args, true, params, Some(ret), none)

// ---------------------------------------------------------------------------
// Primitive and builtin type sets
// ---------------------------------------------------------------------------

fn is_primitive_type(name: String) -> Bool:
    if name == "Int" { return true }
    if name == "Float" { return true }
    if name == "Bool" { return true }
    if name == "String" { return true }
    if name == "Char" { return true }
    if name == "Void" { return true }
    return false

fn is_builtin_generic(name: String) -> Bool:
    if name == "Option" { return true }
    if name == "Result" { return true }
    if name == "List" { return true }
    if name == "Map" { return true }
    if name == "Signal" { return true }
    if name == "Stream" { return true }
    if name == "Channel" { return true }
    if name == "Tensor" { return true }
    return false

fn is_builtin_function(name: String) -> Bool:
    if name == "print" { return true }
    if name == "println" { return true }
    if name == "len" { return true }
    if name == "toString" { return true }
    if name == "str" { return true }
    if name == "int" { return true }
    if name == "float" { return true }
    if name == "Some" { return true }
    if name == "Ok" { return true }
    if name == "Err" { return true }
    if name == "signal" { return true }
    if name == "stream" { return true }
    if name == "ord" { return true }
    if name == "chr" { return true }
    if name == "join" { return true }
    if name == "typeof" { return true }
    // C runtime functions used by the self-hosted compiler driver
    if name == "__mn_argc" { return true }
    if name == "__mn_argv" { return true }
    if name == "__mn_file_read_or_empty" { return true }
    if name == "__mn_exit" { return true }
    if name == "__mn_str_eprint" { return true }
    if name == "__mn_str_eprintln" { return true }
    if name == "__mn_system" { return true }
    if name == "__mn_file_write" { return true }
    // v5.8.4 Wb.2: host-detect (returns 1 on Windows, 0 elsewhere).
    if name == "__mn_host_is_win64" { return true }
    // v5.8.6 We.1: refined host-detect — splits Windows-detection
    // from arch-bits so the emitter can disambiguate Win32 (i686)
    // from Win64 (x86_64) without rerunning a flawed `_WIN32` check.
    if name == "__mn_host_is_windows" { return true }
    if name == "__mn_host_arch_bits" { return true }
    // v5.9.0 DX.2 / DX.3 / DX.4: native CLI hygiene exports.
    if name == "__mn_version_string" { return true }
    if name == "__mn_dev_null_redirect" { return true }
    if name == "__mn_clang_err_path" { return true }
    if name == "__mn_dir_count_files" { return true }
    if name == "__mn_dir_total_size" { return true }
    if name == "__mn_dir_remove_recursive" { return true }
    if name == "__mn_file_exists" { return true }
    // v5.10.0 Win.1b.D: bundled-toolchain lookup support.
    if name == "__mn_executable_dir" { return true }
    // v5.14.1 B.5/B.6: colon-block preprocessor (lives in C runtime
    // because the bootstrap lower has pathologies on a .mn port).
    if name == "__mn_indent_to_braces" { return true }
    // v5.23.2 Te.3.B.2: brace-deprecation detector + warning emitter.
    // Same C-runtime routing as __mn_indent_to_braces.
    if name == "__mn_count_user_brace_block_openers" { return true }
    if name == "__mn_emit_brace_deprecation_warning" { return true }
    // High-level I/O builtins (v3.41.0)
    if name == "read_line" { return true }
    if name == "read_file" { return true }
    if name == "write_file" { return true }
    if name == "append_file" { return true }
    if name == "file_exists" { return true }
    if name == "list_dir" { return true }
    // Network, crypto, regex builtins (v3.42.0)
    if name == "http_get" { return true }
    if name == "sha256" { return true }
    if name == "base64_encode" { return true }
    if name == "base64_decode" { return true }
    if name == "hmac_sha256" { return true }
    if name == "hex_encode" { return true }
    if name == "random_bytes" { return true }
    if name == "regex_match" { return true }
    if name == "regex_replace" { return true }
    // GPU builtins (v3.46.0)
    if name == "gpu_available" { return true }
    if name == "gpu_device_name" { return true }
    if name == "gpu_device_memory" { return true }
    if name == "gpu_tensor_add" { return true }
    if name == "gpu_tensor_sub" { return true }
    if name == "gpu_tensor_mul" { return true }
    if name == "gpu_tensor_div" { return true }
    if name == "gpu_tensor_matmul" { return true }
    // Async builtins (v5.5.0 Sh.4): block_on(future) drives a coroutine
    // to completion; return type is T of the awaited Future<T>, inferred
    // from the call site (we use <unknown> so downstream type checks skip).
    if name == "block_on" { return true }
    // Tensor builtins (v5.6.0 Sh.6 — mirrors mapanare/types.py:349-355).
    if name == "tensor_rank" { return true }
    if name == "tensor_size" { return true }
    if name == "tensor_get_f64" { return true }
    if name == "tensor_get_i64" { return true }
    if name == "tensor_shape_dim" { return true }
    if name == "tensor_print" { return true }
    return false

fn builtin_return_type(name: String) -> String:
    if name == "print" { return "Void" }
    if name == "println" { return "Void" }
    if name == "len" { return "Int" }
    if name == "toString" { return "String" }
    if name == "str" { return "String" }
    if name == "int" { return "Int" }
    if name == "float" { return "Float" }
    if name == "Some" { return "Option" }
    if name == "Ok" { return "Result" }
    if name == "Err" { return "Result" }
    if name == "signal" { return "Signal" }
    if name == "stream" { return "Stream" }
    if name == "ord" { return "Int" }
    if name == "chr" { return "String" }
    if name == "join" { return "String" }
    if name == "typeof" { return "String" }
    // High-level I/O builtins (v3.41.0)
    if name == "read_line" { return "String" }
    if name == "read_file" { return "String" }
    if name == "write_file" { return "Void" }
    if name == "append_file" { return "Void" }
    if name == "file_exists" { return "Bool" }
    if name == "list_dir" { return "List" }
    // Network, crypto, regex builtins (v3.42.0)
    if name == "http_get" { return "String" }
    if name == "sha256" { return "String" }
    if name == "base64_encode" { return "String" }
    if name == "base64_decode" { return "String" }
    if name == "hmac_sha256" { return "String" }
    if name == "hex_encode" { return "String" }
    if name == "random_bytes" { return "String" }
    if name == "regex_match" { return "Bool" }
    if name == "regex_replace" { return "String" }
    // GPU builtins (v3.46.0)
    if name == "gpu_available" { return "Bool" }
    if name == "gpu_device_name" { return "String" }
    if name == "gpu_device_memory" { return "Int" }
    if name == "gpu_tensor_add" { return "List" }
    if name == "gpu_tensor_sub" { return "List" }
    if name == "gpu_tensor_mul" { return "List" }
    if name == "gpu_tensor_div" { return "List" }
    if name == "gpu_tensor_matmul" { return "List" }
    // Async (v5.5.0 Sh.4): block_on returns the awaited T; type-inferred.
    if name == "block_on" { return "<unknown>" }
    // Tensor builtins (v5.6.0 Sh.6 — mirrors mapanare/types.py:349-355).
    if name == "tensor_rank" { return "Int" }
    if name == "tensor_size" { return "Int" }
    if name == "tensor_get_f64" { return "Float" }
    if name == "tensor_get_i64" { return "Int" }
    if name == "tensor_shape_dim" { return "Int" }
    if name == "tensor_print" { return "Void" }
    return "Void"

// ---------------------------------------------------------------------------
// Symbol table
// ---------------------------------------------------------------------------

struct Symbol:
    name: String
    kind: String
    type_info: TypeInfo
    mutable: Bool

fn new_symbol(name: String, kind: String, ti: TypeInfo, mutable: Bool) -> Symbol = new Symbol { name: name, kind: kind, type_info: ti, mutable: mutable }

struct Scope:
    parent: Option<Scope>
    symbols: List<Symbol>

fn new_scope(parent: Option<Scope>) -> Scope:
    let syms: List<Symbol> = []
    new Scope { parent: parent, symbols: syms }

fn scope_define(scope: Scope, name: String, sym: Symbol) -> Scope:
    // Append symbol to scope's symbol list.
    // Later entries shadow earlier ones (last-match-wins in lookup).
    let mut syms: List<Symbol> = scope.symbols
    syms.push(sym)
    new Scope { parent: scope.parent, symbols: syms }

fn scope_lookup(scope: Scope, name: String) -> Option<Symbol>:
    // Linear search through symbols (last to first for shadowing).
    let mut i: Int = len(scope.symbols) - 1
    for _ in 0..1000000:
        if i < 0:
            // Not found locally; walk to parent scope.
            match scope.parent:
                Some(parent) => { return scope_lookup(parent, name) }
                _ => { return none }
        let sym: Symbol = scope.symbols[i]
        if sym.name == name { return Some(sym) }
        i = i - 1
    return none

fn scope_lookup_local(scope: Scope, name: String) -> Option<Symbol>:
    // Only search the current scope (no parent walk).
    let mut i: Int = len(scope.symbols) - 1
    for _ in 0..1000000:
        if i < 0 { return none }
        let sym: Symbol = scope.symbols[i]
        if sym.name == name { return Some(sym) }
        i = i - 1
    return none

// ---------------------------------------------------------------------------
// Semantic checker state
// ---------------------------------------------------------------------------

struct SemanticChecker:
    filename: String
    errors: List<SemanticError>
    global_scope: Scope
    current_scope: Scope

fn new_checker(filename: String) -> SemanticChecker:
    let scope: Scope = new_scope(none)
    let errs: List<SemanticError> = []
    new SemanticChecker { filename: filename, errors: errs, global_scope: scope, current_scope: scope }

// ---------------------------------------------------------------------------
// State threading — result structs for functions that return a value + state
// ---------------------------------------------------------------------------

struct SemState:
    errors: List<SemanticError>
    scope: Scope
    filename: String
    current_span: Span
    current_fn_return: TypeInfo
    current_fn_name: String

struct InferResult:
    type_info: TypeInfo
    st: SemState

struct CheckResult:
    st: SemState

fn new_sem_state(filename: String) -> SemState:
    let scope: Scope = new_scope(none)
    let sem_errs: List<SemanticError> = []
    let zero_span: Span = make_span(0, 0, 0, 0)
    new SemState { errors: sem_errs, scope: scope, filename: filename, current_span: zero_span, current_fn_return: unknown_type(), current_fn_name: "" }

fn new_infer_result(ti: TypeInfo, st: SemState) -> InferResult = new InferResult { type_info: ti, st: st }

fn new_check_result(st: SemState) -> CheckResult = new CheckResult { st: st }

// ---------------------------------------------------------------------------
// Error helpers
// ---------------------------------------------------------------------------

fn add_error(st: SemState, msg: String, line: Int, col: Int) -> SemState:
    let err: SemanticError = new_semantic_error(msg, line, col, st.filename)
    let mut errs: List<SemanticError> = st.errors
    errs.push(err)
    new SemState { errors: errs, scope: st.scope, filename: st.filename, current_span: st.current_span, current_fn_return: st.current_fn_return, current_fn_name: st.current_fn_name }

fn add_error_here(st: SemState, msg: String) -> SemState = add_error(st, msg, st.current_span.line, st.current_span.column)

fn add_error_msg(st: SemState, msg: String) -> SemState = add_error_here(st, msg)

// ---------------------------------------------------------------------------
// Scope helpers
// ---------------------------------------------------------------------------

fn push_scope(st: SemState) -> SemState:
    let child: Scope = new_scope(Some(st.scope))
    let new_st: SemState = new SemState { errors: st.errors, scope: child, filename: st.filename, current_span: st.current_span, current_fn_return: st.current_fn_return, current_fn_name: st.current_fn_name }
    new_st

fn pop_scope(st: SemState) -> SemState:
    match st.scope.parent {
        Some(parent) => {
            let new_st: SemState = new SemState { errors: st.errors, scope: parent, filename: st.filename, current_span: st.current_span, current_fn_return: st.current_fn_return, current_fn_name: st.current_fn_name }
            return new_st
        },
        _ => { return st }
    }

fn set_span(st: SemState, span: Span) -> SemState = new SemState { errors: st.errors, scope: st.scope, filename: st.filename, current_span: span, current_fn_return: st.current_fn_return, current_fn_name: st.current_fn_name }

fn define_in_scope(st: SemState, name: String, sym: Symbol) -> SemState:
    let new_scope_val: Scope = scope_define(st.scope, name, sym)
    let new_st: SemState = new SemState { errors: st.errors, scope: new_scope_val, filename: st.filename, current_span: st.current_span, current_fn_return: st.current_fn_return, current_fn_name: st.current_fn_name }
    new_st

fn set_fn_context(st: SemState, fn_name: String, ret_type: TypeInfo) -> SemState = new SemState { errors: st.errors, scope: st.scope, filename: st.filename, current_span: st.current_span, current_fn_return: ret_type, current_fn_name: fn_name }

// ---------------------------------------------------------------------------
// Type compatibility checking
// ---------------------------------------------------------------------------

fn is_type_param(name: String) -> Bool:
    // Single uppercase letter (T, A, B, ...) or <builtin> are type parameters
    if name == "<builtin>" { return true }
    if len(name) == 1:
        let c: Int = name.byte_at(0)
        if c >= 65 && c <= 90 { return true }
    return false

fn types_compatible(a: TypeInfo, b: TypeInfo) -> Bool:
    // v4.53.0: skip check for unknown/unresolved/error types
    if type_should_skip(a.name) { return true }
    if type_should_skip(b.name) { return true }
    if is_type_param(a.name) { return true }
    if is_type_param(b.name) { return true }
    if a.is_function:
        if b.is_function:
            // Compare param counts
            if len(a.param_types) != len(b.param_types) { return false }
            // Compare parameter types pairwise
            let mut j: Int = 0
            for _ in 0..200:
                if j >= len(a.param_types) { break }
                if types_compatible(a.param_types[j], b.param_types[j]) == false { return false }
                j = j + 1
            // Compare return types
            match a.return_type {
                Some(a_ret) => {
                    match b.return_type {
                        Some(b_ret) => {
                            if types_compatible(a_ret, b_ret) == false { return false }
                        },
                        _ => {}
                    }
                },
                _ => {}
            }
            return true
        return false
    if a.name != b.name { return false }
    return true

fn is_numeric_type(name: String) -> Bool:
    if name == "Int" { return true }
    if name == "Float" { return true }
    if type_should_skip(name) { return true }
    return false

fn is_arithmetic_operand(name: String) -> Bool:
    if name == "Int" { return true }
    if name == "Float" { return true }
    if name == "String" { return true }
    if name == "Tensor" { return true }
    if type_should_skip(name) { return true }
    return false

fn type_exists(st: SemState, t: TypeInfo) -> Bool:
    if is_primitive_type(t.name) { return true }
    if is_builtin_generic(t.name) { return true }
    let sym: Option<Symbol> = scope_lookup(st.scope, t.name)
    match sym {
        Some(s) => {
            if s.kind == "struct" { return true }
            if s.kind == "enum" { return true }
            if s.kind == "agent" { return true }
            if s.kind == "type_alias" { return true }
            return false
        },
        _ => { return false }
    }

// ---------------------------------------------------------------------------
// Binary operator type rules
// ---------------------------------------------------------------------------

fn check_arithmetic_result(left: String, right: String, op: String) -> String:
    if left == "Tensor" { return "Tensor" }
    if right == "Tensor" { return "Tensor" }
    if op == "+":
        if left == "String" { return "String" }
        if right == "String" { return "String" }
    if left == "Float" { return "Float" }
    if right == "Float" { return "Float" }
    if left == "Int":
        if right == "Int" { return "Int" }
    return "<unknown>"

fn check_comparison_result(left: String, right: String) -> String = "Bool"

fn check_logical_result(left: String, right: String) -> String = "Bool"

// ---------------------------------------------------------------------------
// Type resolution — convert TypeExpr AST nodes to TypeInfo
// ---------------------------------------------------------------------------
// Cb.9a CLOSED (v5.0.5): Qualified type references (e.g., "device.DeviceKind")
// are stored as dotted strings in TypeExpr::Named by the self-hosted parser.
// bare_type_name() extracts the last component for primitive/builtin
// classification; the full dotted name is preserved in TypeInfo for emitter
// round-tripping. Mirrors Python semantic.py:416-420 (module_path lookup +
// bare-name TypeInfo). See also Gr.2 (grammar accepts NAME (DOT NAME)*
// since v4.139.0).
// ---------------------------------------------------------------------------

fn bare_type_name(name: String) -> String:
    let mut last_dot: Int = 0 - 1
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(name) { break }
        let ch: String = name.substr(i, 1)
        if ch == "." { last_dot = i }
        i = i + 1
    if last_dot < 0 { return name }
    return name.substr(last_dot + 1, len(name) - last_dot - 1)

fn resolve_type_expr(te: TypeExpr) -> TypeInfo:
    let tek: String = type_expr_kind(te)
    if tek == "named":
        let name: String = type_expr_name(te)
        let bare: String = bare_type_name(name)
        if is_primitive_type(bare) { return make_type(bare) }
        return make_type(name)
    if tek == "generic":
        let name: String = type_expr_name(te)
        let bare: String = bare_type_name(name)
        let args: List<TypeExpr> = type_expr_args(te)
        let mut resolved: List<TypeInfo> = []
        let mut i: Int = 0
        for _ in 0..200:
            if i >= len(args):
                if is_builtin_generic(bare) { return make_generic_type(bare, resolved) }
                return make_generic_type(name, resolved)
            let arg: TypeExpr = args[i]
            let rt: TypeInfo = resolve_type_expr(arg)
            resolved.push(rt)
            i = i + 1
        if is_builtin_generic(bare) { return make_generic_type(bare, resolved) }
        return make_generic_type(name, resolved)
    if tek == "fn":
        let param_types: List<TypeExpr> = type_expr_fn_params(te)
        let return_type: TypeExpr = type_expr_fn_ret(te)
        let mut params: List<TypeInfo> = []
        let mut i_fn: Int = 0
        for _ in 0..200:
            if i_fn >= len(param_types):
                let ret: TypeInfo = resolve_type_expr(return_type)
                return make_fn_type(params, ret)
            let pt: TypeExpr = param_types[i_fn]
            let rp: TypeInfo = resolve_type_expr(pt)
            params.push(rp)
            i_fn = i_fn + 1
        let ret2: TypeInfo = resolve_type_expr(return_type)
        return make_fn_type(params, ret2)
    return unknown_type()

fn resolve_type_opt(te: Option<TypeExpr>) -> TypeInfo:
    match te:
        Some(t) => { return resolve_type_expr(t) }
        _ => { return unknown_type() }

// ---------------------------------------------------------------------------
// Expression type inference
// ---------------------------------------------------------------------------

fn infer_expr(st: SemState, expr: Expr) -> InferResult:
    let ek: String = expr_kind(expr)
    if ek == "int_lit" { return new_infer_result(int_type(), st) }
    if ek == "float_lit" { return new_infer_result(float_type(), st) }
    if ek == "bool_lit" { return new_infer_result(bool_type(), st) }
    if ek == "string_lit" { return new_infer_result(string_type(), st) }
    if ek == "char_lit" { return new_infer_result(char_type(), st) }
    if ek == "none_lit" { return new_infer_result(make_type("Option"), st) }

    if ek == "ident":
        let name: String = expr_ident_name(expr)
        // v4.128.0 (Sh.8): bare `None` is a variant of Option. Mirrors
        // mapanare/lower.py::_lower_identifier. Prevents "Undefined
        // variable 'None'" at mnc_all.mn:3504 (`let mut guard: Option<Expr> = None`).
        if name == "None" { return new_infer_result(make_type("Option"), st) }
        let result: Option<Symbol> = scope_lookup(st.scope, name)
        match result {
            Some(sym) => { return new_infer_result(sym.type_info, st) },
            _ => {
                let st_ident_err: SemState = add_error_here(st, "Undefined variable '" + name + "'")
                return new_infer_result(error_type(), st_ident_err)
            }
        }

    if ek == "binary" { return check_binary_expr(st, expr_binary_left(expr), expr_binary_op(expr), expr_binary_right(expr)) }
    if ek == "chained_cmp":
        // v5.21.0 Te.6 — type-check each adjacent pair as a comparison.
        // Result is always Bool. Threading state through pair checks
        // mirrors how `infer_expr` handles other multi-subexpression
        // shapes (call args, method args).
        let mut st_chain: SemState = st
        let cc_operands: List<Expr> = expr_chained_operands(expr)
        let cc_ops: List<String> = expr_chained_ops(expr)
        let nco: Int = len(cc_ops)
        let mut ci: Int = 0
        for _ in 0..200:
            if ci >= nco { return new_infer_result(make_type("Bool"), st_chain) }
            let pr: InferResult = check_binary_expr(st_chain, cc_operands[ci], cc_ops[ci], cc_operands[ci + 1])
            st_chain = pr.st
            ci = ci + 1
        return new_infer_result(make_type("Bool"), st_chain)
    if ek == "unary" { return check_unary_expr(st, expr_unary_op(expr), expr_unary_operand(expr)) }
    if ek == "call" { return check_call_expr(st, expr_call_callee(expr), expr_call_args(expr)) }

    if ek == "method_call":
        let obj_r: InferResult = infer_expr(st, expr_method_obj(expr))
        // v4.53.0: cascade suppression — ERROR receiver propagates
        if type_is_error(obj_r.type_info) { return new_infer_result(error_type(), obj_r.st) }
        let mut st_method: SemState = obj_r.st
        let args: List<Expr> = expr_method_args(expr)
        let mut i_method: Int = 0
        for _ in 0..200:
            if i_method >= len(args) { return new_infer_result(unknown_type(), st_method) }
            let arg: Expr = args[i_method]
            let ar: InferResult = infer_expr(st_method, arg)
            st_method = ar.st
            i_method = i_method + 1
        return new_infer_result(unknown_type(), st_method)

    if ek == "field_access":
        let obj_r_field: InferResult = infer_expr(st, expr_field_obj(expr))
        // v4.53.0: cascade suppression — ERROR receiver propagates
        if type_is_error(obj_r_field.type_info) { return new_infer_result(error_type(), obj_r_field.st) }
        return new_infer_result(unknown_type(), obj_r_field.st)

    if ek == "namespace_access":
        return new_infer_result(unknown_type(), st)

    if ek == "index":
        let obj_r_idx: InferResult = infer_expr(st, expr_index_obj(expr))
        // v4.53.0: cascade suppression — ERROR receiver propagates
        if type_is_error(obj_r_idx.type_info):
            let idx_r_skip: InferResult = infer_expr(obj_r_idx.st, expr_index_idx(expr))
            return new_infer_result(error_type(), idx_r_skip.st)
        let idx_r: InferResult = infer_expr(obj_r_idx.st, expr_index_idx(expr))
        // List<T>[i] -> T
        if obj_r_idx.type_info.name == "List":
            if len(obj_r_idx.type_info.args) > 0:
                let elem_ti: TypeInfo = obj_r_idx.type_info.args[0]
                return new_infer_result(elem_ti, idx_r.st)
        return new_infer_result(unknown_type(), idx_r.st)

    // v5.6.1 Sh.6 Phase 2 — multi-dim tensor indexing `a[i, j]`. Walk the
    // object + all indices for side-effect inference (pushes diagnostics);
    // element type is Tensor<T>'s T, defaulting to Float when unknown.
    if ek == "tensor_index":
        let ti_obj_r: InferResult = infer_expr(st, expr_ti_obj(expr))
        let mut st_ti: SemState = ti_obj_r.st
        let ti_idxs: List<Expr> = expr_ti_indices(expr)
        let mut ki: Int = 0
        let n_idx: Int = len(ti_idxs)
        for _ in 0..128:
            if ki < n_idx:
                let ixr: InferResult = infer_expr(st_ti, ti_idxs[ki])
                st_ti = ixr.st
                ki = ki + 1
        if type_is_error(ti_obj_r.type_info):
            return new_infer_result(error_type(), st_ti)
        if ti_obj_r.type_info.name == "Tensor":
            if len(ti_obj_r.type_info.args) > 0:
                return new_infer_result(ti_obj_r.type_info.args[0], st_ti)
            return new_infer_result(make_type("Float"), st_ti)
        return new_infer_result(unknown_type(), st_ti)

    // v5.6.3 Sh.6 Phase 4 — tensor slicing `a[1..3, _]`. Walk the object
    // and every item's expression(s) for diagnostics. Result type is
    // Tensor<T> (same as input — rank is preserved/reduced at runtime,
    // not compile-time). Mirrors mapanare/semantic.py's TensorSlice arm.
    if ek == "tensor_slice":
        let sl_obj_r: InferResult = infer_expr(st, expr_slice_obj(expr))
        let mut st_sl: SemState = sl_obj_r.st
        let sl_items: List<IndexItem> = expr_slice_items(expr)
        let mut sl_i: Int = 0
        let n_items: Int = len(sl_items)
        for _ in 0..128:
            if sl_i < n_items:
                let it: IndexItem = sl_items[sl_i]
                if it.kind == "scalar":
                    let scr: InferResult = infer_expr(st_sl, it.expr)
                    st_sl = scr.st
                if it.kind == "range":
                    let rs_kind: String = expr_kind(it.start)
                    if rs_kind != "none_lit":
                        let rsr: InferResult = infer_expr(st_sl, it.start)
                        st_sl = rsr.st
                    let re_kind: String = expr_kind(it.end)
                    if re_kind != "none_lit":
                        let rer: InferResult = infer_expr(st_sl, it.end)
                        st_sl = rer.st
                sl_i = sl_i + 1
        if type_is_error(sl_obj_r.type_info):
            return new_infer_result(error_type(), st_sl)
        if sl_obj_r.type_info.name == "Tensor":
            return new_infer_result(sl_obj_r.type_info, st_sl)
        return new_infer_result(unknown_type(), st_sl)

    if ek == "pipe" { return check_pipe_expr(st, expr_pipe_left(expr), expr_pipe_right(expr)) }

    if ek == "range":
        let sr: InferResult = infer_expr(st, expr_range_start(expr))
        let er_range: InferResult = infer_expr(sr.st, expr_range_end(expr))
        return new_infer_result(make_type("Range"), er_range.st)

    if ek == "lambda" { return check_lambda_expr(st, expr_lambda_params(expr), expr_lambda_body(expr)) }
    if ek == "spawn" { return check_spawn_expr(st, expr_spawn_callee(expr), expr_spawn_args(expr)) }

    if ek == "sync":
        let ir_sync: InferResult = infer_expr(st, expr_sync_inner(expr))
        return new_infer_result(unknown_type(), ir_sync.st)

    if ek == "send":
        let st_send: SemState = check_send_expr(st, expr_send_target(expr), expr_send_value(expr))
        return new_infer_result(void_type(), st_send)

    if ek == "error_prop":
        let ir_errprop: InferResult = infer_expr(st, expr_errorprop_inner(expr))
        // v4.53.0: cascade suppression — ERROR inner propagates without new error
        if type_is_error(ir_errprop.type_info) { return new_infer_result(error_type(), ir_errprop.st) }
        let mut st_ep: SemState = ir_errprop.st
        let inner_name: String = ir_errprop.type_info.name
        // v4.52.0: validate ? operator (D1 fix)
        if !type_should_skip(inner_name):
            if inner_name != "Result":
                if inner_name != "Option":
                    st_ep = add_error_here(st_ep, "`?` requires `Result` or `Option`, got `" + inner_name + "`")
                    return new_infer_result(error_type(), st_ep)
        // Check enclosing function returns compatible type
        if inner_name == "Result":
            if !type_should_skip(st_ep.current_fn_return.name):
                if st_ep.current_fn_return.name != "Result":
                    st_ep = add_error_here(st_ep, "`?` on a `Result` value requires the enclosing function `" + st_ep.current_fn_name + "` to return `Result`")
                    return new_infer_result(error_type(), st_ep)
        if inner_name == "Option":
            if !type_should_skip(st_ep.current_fn_return.name):
                if st_ep.current_fn_return.name != "Option":
                    st_ep = add_error_here(st_ep, "`?` on an `Option` value requires the enclosing function `" + st_ep.current_fn_name + "` to return `Option`")
                    return new_infer_result(error_type(), st_ep)
        return new_infer_result(unknown_type(), st_ep)

    // v5.16.0 Te.4.C — string interpolation. Each part is inferred for
    // side effects (pushes diagnostics); the result is always String.
    // Mirrors Python's `_infer_expr` on `InterpString` (which delegates
    // type-checking to the per-part Cast at lower time).
    if ek == "interp_string":
        let iparts: List<Expr> = expr_interp_parts(expr)
        let mut st_interp: SemState = st
        let mut i_interp: Int = 0
        for _ in 0..1000:
            if i_interp >= len(iparts) { break }
            let ipart: Expr = iparts[i_interp]
            let ipr: InferResult = infer_expr(st_interp, ipart)
            st_interp = ipr.st
            i_interp = i_interp + 1
        return new_infer_result(string_type(), st_interp)

    if ek == "list_lit":
        let elements: List<Expr> = expr_list_elements(expr)
        if len(elements) > 0:
            let first: Expr = elements[0]
            let fr_list: InferResult = infer_expr(st, first)
            let mut st_list: SemState = fr_list.st
            let mut i_list: Int = 1
            for _ in 0..600:
                if i_list >= len(elements):
                    let args_list: List<TypeInfo> = []
                    return new_infer_result(make_generic_type("List", args_list), st_list)
                let elem: Expr = elements[i_list]
                let er_list: InferResult = infer_expr(st_list, elem)
                st_list = er_list.st
                i_list = i_list + 1
            let args2: List<TypeInfo> = []
            return new_infer_result(make_generic_type("List", args2), st_list)
        let empty_args: List<TypeInfo> = []
        return new_infer_result(make_generic_type("List", empty_args), st)

    // Tensor literal (v4.42.0)
    if ek == "tensor_lit":
        let elements: List<Expr> = expr_tensor_elements(expr)
        let mut st_tens: SemState = st
        let mut i_tens: Int = 0
        for _ in 0..2000:
            if i_tens >= len(elements):
                let args_tens: List<TypeInfo> = []
                return new_infer_result(make_generic_type("Tensor", args_tens), st_tens)
            let elem_t: Expr = elements[i_tens]
            let er_tens: InferResult = infer_expr(st_tens, elem_t)
            st_tens = er_tens.st
            i_tens = i_tens + 1
        let args2_t: List<TypeInfo> = []
        return new_infer_result(make_generic_type("Tensor", args2_t), st_tens)

    if ek == "construct":
        let name: String = expr_construct_name(expr)
        let fields: List<FieldInit> = expr_construct_fields(expr)
        let mut st_ctor: SemState = st
        let mut i_ctor: Int = 0
        for _ in 0..200:
            if i_ctor >= len(fields) { return new_infer_result(make_type(name), st_ctor) }
            let fi: FieldInit = fields[i_ctor]
            let fr_ctor: InferResult = infer_expr(st_ctor, fi.value)
            st_ctor = fr_ctor.st
            i_ctor = i_ctor + 1
        return new_infer_result(make_type(name), st_ctor)

    // v5.20.1 Te.5.F.C — struct update: type-check overrides + base.
    if ek == "construct_update":
        let cu_name: String = expr_construct_update_name(expr)
        let cu_overrides: List<FieldInit> = expr_construct_update_overrides(expr)
        let cu_base: Expr = expr_construct_update_base(expr)
        let mut st_cu: SemState = st
        let base_r_cu: InferResult = infer_expr(st_cu, cu_base)
        st_cu = base_r_cu.st
        let mut j_cu: Int = 0
        let n_cu: Int = len(cu_overrides)
        for _ in 0..200:
            if j_cu >= n_cu { return new_infer_result(make_type(cu_name), st_cu) }
            let ovi: FieldInit = cu_overrides[j_cu]
            let or_cu: InferResult = infer_expr(st_cu, ovi.value)
            st_cu = or_cu.st
            j_cu = j_cu + 1
        return new_infer_result(make_type(cu_name), st_cu)

    if ek == "some_wrap":
        let vr_some: InferResult = infer_expr(st, expr_wrap_inner(expr))
        let args_some: List<TypeInfo> = []
        return new_infer_result(make_generic_type("Option", args_some), vr_some.st)

    if ek == "ok_wrap":
        let vr_ok: InferResult = infer_expr(st, expr_wrap_inner(expr))
        let args_ok: List<TypeInfo> = []
        return new_infer_result(make_generic_type("Result", args_ok), vr_ok.st)

    if ek == "err_wrap":
        let vr_err: InferResult = infer_expr(st, expr_wrap_inner(expr))
        let args_err: List<TypeInfo> = []
        return new_infer_result(make_generic_type("Result", args_err), vr_err.st)

    if ek == "signal_val":
        let vr_signal: InferResult = infer_expr(st, expr_signal_inner(expr))
        let args_signal: List<TypeInfo> = []
        return new_infer_result(make_generic_type("Signal", args_signal), vr_signal.st)

    if ek == "assign" { return check_assign_expr(st, expr_assign_target(expr), expr_assign_op(expr), expr_assign_value(expr)) }
    if ek == "if" { return check_if_expr(st, expr_if_cond(expr), expr_if_then(expr), expr_if_else(expr)) }
    // v5.20.1 Te.5.F.E — if-let: infer scrutinee, bind pattern in
    // then-block scope; else block in a nested scope.
    if ek == "if_let":
        let il_pat: Pattern = expr_iflet_pattern(expr)
        let il_scrut: Expr = expr_iflet_scrutinee(expr)
        let il_then: Block = expr_iflet_then(expr)
        let il_else: Option<Block> = expr_iflet_else(expr)
        let sr_il: InferResult = infer_expr(st, il_scrut)
        let mut s_il: SemState = sr_il.st
        let inner_il: SemState = push_scope(s_il)
        let pk_il: String = pattern_kind(il_pat)
        let mut bound_il: SemState = inner_il
        if pk_il == "constructor":
            let pargs_il: List<Pattern> = pattern_ctor_args(il_pat)
            let mut j_il: Int = 0
            let nargs_il: Int = len(pargs_il)
            for _ in 0..16:
                if j_il >= nargs_il { break }
                let arg_il: Pattern = pargs_il[j_il]
                if pattern_kind(arg_il) == "ident":
                    let sym_il: Symbol = new_symbol(pattern_ident_name(arg_il), "variable", unknown_type(), false)
                    bound_il = define_in_scope(bound_il, pattern_ident_name(arg_il), sym_il)
                j_il = j_il + 1
        let after_il: SemState = check_block(bound_il, il_then)
        let mut after2_il: SemState = pop_scope(after_il)
        match il_else {
            Some(eb) => {
                let inner2_il: SemState = push_scope(after2_il)
                let after3_il: SemState = check_block(inner2_il, eb)
                after2_il = pop_scope(after3_il)
            },
            _ => {}
        }
        return new_infer_result(unknown_type(), after2_il)
    if ek == "match" { return check_match_expr(st, expr_match_subject(expr), expr_match_arms(expr)) }

    // v5.5.0 Sh.4: `await expr` — recurse into inner so errors inside are
    // caught; the awaited T is inferred at lower-level once Future<T> lands.
    if ek == "await":
        let ir_await: InferResult = infer_expr(st, expr_await_inner(expr))
        return new_infer_result(unknown_type(), ir_await.st)

    return new_infer_result(unknown_type(), st)

// ---------------------------------------------------------------------------
// Binary operators
// ---------------------------------------------------------------------------

fn check_binary_expr(st: SemState, left: Expr, op: String, right: Expr) -> InferResult:
    let lr: InferResult = infer_expr(st, left)
    let rr: InferResult = infer_expr(lr.st, right)
    let lt: String = lr.type_info.name
    let rt: String = rr.type_info.name
    let st2: SemState = rr.st
    // v4.53.0: cascade suppression — ERROR on either side propagates
    if lt == "<error>" { return new_infer_result(error_type(), st2) }
    if rt == "<error>" { return new_infer_result(error_type(), st2) }

    // Arithmetic operators
    if op == "+" { return check_arithmetic_binary(st2, lt, rt, op, lr.type_info, rr.type_info) }
    if op == "-" { return check_arithmetic_binary(st2, lt, rt, op, lr.type_info, rr.type_info) }
    if op == "*" { return check_arithmetic_binary(st2, lt, rt, op, lr.type_info, rr.type_info) }
    if op == "/" { return check_arithmetic_binary(st2, lt, rt, op, lr.type_info, rr.type_info) }
    if op == "%" { return check_arithmetic_binary(st2, lt, rt, op, lr.type_info, rr.type_info) }

    // Comparison and equality operators
    if op == "<" { return new_infer_result(bool_type(), st2) }
    if op == ">" { return new_infer_result(bool_type(), st2) }
    if op == "<=" { return new_infer_result(bool_type(), st2) }
    if op == ">=" { return new_infer_result(bool_type(), st2) }
    if op == "==" { return new_infer_result(bool_type(), st2) }
    if op == "!=" { return new_infer_result(bool_type(), st2) }

    // Logical operators
    if op == "&&" { return check_logical_binary(st2, lt, rt, op) }
    if op == "||" { return check_logical_binary(st2, lt, rt, op) }

    // Matrix multiply
    if op == "@" { return check_matmul_binary(st2, lt, rt, lr.type_info, rr.type_info) }

    return new_infer_result(unknown_type(), st2)

fn check_arithmetic_binary(st: SemState, lt: String, rt: String, op: String, left_ti: TypeInfo, right_ti: TypeInfo) -> InferResult:
    // Tensor element-wise operations
    if lt == "Tensor":
        if !type_should_skip(rt):
            if rt != "Tensor":
                if rt != "Int":
                    if rt != "Float":
                        let st_tensor_lt: SemState = add_error_here(st, "Operator '" + op + "' not supported for Tensor and " + rt)
                        return new_infer_result(make_type("Tensor"), st_tensor_lt)
        return new_infer_result(make_type("Tensor"), st)
    if rt == "Tensor":
        if !type_should_skip(lt):
            if lt != "Int":
                if lt != "Float":
                    let st_tensor_rt: SemState = add_error_here(st, "Operator '" + op + "' not supported for " + lt + " and Tensor")
                    return new_infer_result(make_type("Tensor"), st_tensor_rt)
        return new_infer_result(make_type("Tensor"), st)

    // Non-tensor arithmetic
    if !type_should_skip(lt):
        if lt != "Int":
            if lt != "Float":
                if lt != "String":
                    let st_arith_lt: SemState = add_error_here(st, "Operator '" + op + "' not supported for types " + lt + " and " + rt)
                    return new_infer_result(error_type(), st_arith_lt)
    if !type_should_skip(rt):
        if rt != "Int":
            if rt != "Float":
                if rt != "String":
                    let st_arith_rt: SemState = add_error_here(st, "Operator '" + op + "' not supported for types " + lt + " and " + rt)
                    return new_infer_result(error_type(), st_arith_rt)

    let result_name: String = check_arithmetic_result(lt, rt, op)
    return new_infer_result(make_type(result_name), st)

fn check_logical_binary(st: SemState, lt: String, rt: String, op: String) -> InferResult:
    let mut st2: SemState = st
    if !type_should_skip(lt):
        if lt != "Bool":
            st2 = add_error_here(st2, "Operator '" + op + "' requires Bool, got " + lt)
    if !type_should_skip(rt):
        if rt != "Bool":
            st2 = add_error_here(st2, "Operator '" + op + "' requires Bool, got " + rt)
    new_infer_result(bool_type(), st2)

fn check_matmul_binary(st: SemState, lt: String, rt: String, left_ti: TypeInfo, right_ti: TypeInfo) -> InferResult:
    let mut st2: SemState = st
    if !type_should_skip(lt):
        if lt != "Tensor":
            st2 = add_error_here(st2, "Operator '@' requires Tensor, got " + lt)
    if !type_should_skip(rt):
        if rt != "Tensor":
            st2 = add_error_here(st2, "Operator '@' requires Tensor, got " + rt)
    let elem: TypeInfo = unknown_type()
    if len(left_ti.args) > 0:
        let elem2: TypeInfo = left_ti.args[0]
        let mut args: List<TypeInfo> = []
        args.push(elem2)
        return new_infer_result(make_generic_type("Tensor", args), st2)
    let args3: List<TypeInfo> = []
    return new_infer_result(make_generic_type("Tensor", args3), st2)

// ---------------------------------------------------------------------------
// Unary operators
// ---------------------------------------------------------------------------

fn check_unary_expr(st: SemState, op: String, operand: Expr) -> InferResult:
    let or: InferResult = infer_expr(st, operand)
    let ot: String = or.type_info.name
    // v4.53.0: cascade suppression
    if ot == "<error>" { return new_infer_result(error_type(), or.st) }

    if op == "-":
        if !type_should_skip(ot):
            if ot != "Int":
                if ot != "Float":
                    let st_neg: SemState = add_error_here(or.st, "Unary '-' not supported for type " + ot)
                    return new_infer_result(error_type(), st_neg)
        return new_infer_result(or.type_info, or.st)

    if op == "!":
        if !type_should_skip(ot):
            if ot != "Bool":
                let st_not: SemState = add_error_here(or.st, "Unary '!' requires Bool, got " + ot)
                return new_infer_result(error_type(), st_not)
        return new_infer_result(bool_type(), or.st)

    return new_infer_result(unknown_type(), or.st)

// ---------------------------------------------------------------------------
// Call expression
// ---------------------------------------------------------------------------

fn check_call_expr(st: SemState, callee: Expr, args: List<Expr>) -> InferResult:
    // Infer argument types
    let mut st2: SemState = st
    let mut arg_types: List<TypeInfo> = []
    let mut i: Int = 0
    for _ in 0..200:
        if i >= len(args):
            return check_call_resolved(st2, callee, arg_types)
        let arg: Expr = args[i]
        let ar: InferResult = infer_expr(st2, arg)
        st2 = ar.st
        arg_types.push(ar.type_info)
        i = i + 1
    return check_call_resolved(st2, callee, arg_types)

fn check_call_resolved(st: SemState, callee: Expr, arg_types: List<TypeInfo>) -> InferResult:
    if expr_kind(callee) == "ident":
        let name: String = expr_ident_name(callee)
        let sym_opt: Option<Symbol> = scope_lookup(st.scope, name)
        match sym_opt {
            Some(sym) => {
                if sym.kind == "function" {
                    if sym.type_info.is_function {
                        match sym.type_info.return_type {
                            Some(ret) => {
                                if len(sym.type_info.param_types) > 0 {
                                    if len(arg_types) != len(sym.type_info.param_types) {
                                        let st_argc: SemState = add_error_here(st, "Function '" + name + "' argument count mismatch")
                                        return new_infer_result(ret, st_argc)
                                    }
                                }
                                return new_infer_result(ret, st)
                            },
                            _ => { return new_infer_result(unknown_type(), st) }
                        }
                    }
                    return new_infer_result(unknown_type(), st)
                }
                if sym.kind == "agent" {
                    return new_infer_result(make_type(sym.name), st)
                }
                if sym.kind == "struct" {
                    return new_infer_result(make_type(sym.name), st)
                }
                return new_infer_result(unknown_type(), st)
            },
            _ => {
                let st_undef: SemState = add_error_here(st, "Undefined function '" + name + "'")
                return new_infer_result(error_type(), st_undef)
            }
        }
    let cr: InferResult = infer_expr(st, callee)
    // v4.53.0: cascade suppression — ERROR callee propagates
    if type_is_error(cr.type_info) { return new_infer_result(error_type(), cr.st) }
    return new_infer_result(unknown_type(), cr.st)

// ---------------------------------------------------------------------------
// Assignment
// ---------------------------------------------------------------------------

fn check_assign_expr(st: SemState, target: Expr, op: String, value: Expr) -> InferResult:
    let vr: InferResult = infer_expr(st, value)

    if expr_kind(target) == "ident":
        let name: String = expr_ident_name(target)
        let sym_opt: Option<Symbol> = scope_lookup(vr.st.scope, name)
        match sym_opt {
            Some(sym) => {
                let mut st_assign: SemState = vr.st
                if sym.mutable == false {
                    st_assign = add_error_here(st_assign, "Cannot assign to immutable variable '" + name + "'")
                }
                // v4.53.0: skip type check if either side is error/unknown
                if !type_should_skip(sym.type_info.name) {
                    if !type_should_skip(vr.type_info.name) {
                        if types_compatible(sym.type_info, vr.type_info) == false {
                            st_assign = add_error_here(st_assign, "Type mismatch in assignment to '" + name + "'")
                        }
                    }
                }
                return new_infer_result(void_type(), st_assign)
            },
            _ => {
                let st_assign_undef: SemState = add_error_here(vr.st, "Undefined variable '" + name + "'")
                return new_infer_result(void_type(), st_assign_undef)
            }
        }
    // Field or index target — infer both sides
    let tr: InferResult = infer_expr(vr.st, target)
    return new_infer_result(void_type(), tr.st)

// ---------------------------------------------------------------------------
// If expression
// ---------------------------------------------------------------------------

fn check_if_expr(st: SemState, cond: Expr, then_block: Block, else_clause: Option<ElseClause>) -> InferResult:
    let cr: InferResult = infer_expr(st, cond)
    let mut st2: SemState = cr.st

    // v4.53.0: skip check for unknown/error types
    if !type_should_skip(cr.type_info.name):
        if cr.type_info.name != "Bool":
            st2 = add_error_here(st2, "If condition must be Bool, got " + cr.type_info.name)

    // Check then block
    let then_st: SemState = push_scope(st2)
    let after_then: SemState = check_block(then_st, then_block)
    st2 = pop_scope(after_then)

    // Check else clause
    match else_clause {
        Some(ec) => {
            st2 = check_else_clause(st2, ec)
        },
        _ => {}
    }

    return new_infer_result(unknown_type(), st2)

fn check_else_clause(st: SemState, ec: ElseClause) -> SemState:
    if else_clause_kind(ec) == "else_block":
        let inner: SemState = push_scope(st)
        let after: SemState = check_block(inner, else_clause_block(ec))
        return pop_scope(after)
    let r: InferResult = check_if_expr(st, else_clause_cond(ec), else_clause_then(ec), else_clause_else(ec))
    return r.st

// ---------------------------------------------------------------------------
// Match expression
// ---------------------------------------------------------------------------

fn check_match_expr(st: SemState, subject: Expr, arms: List<MatchArm>) -> InferResult:
    let sr: InferResult = infer_expr(st, subject)
    let mut st2: SemState = sr.st
    let mut i: Int = 0
    for _ in 0..200:
        if i >= len(arms) { return new_infer_result(unknown_type(), st2) }
        let arm: MatchArm = arms[i]
        let arm_st: SemState = push_scope(st2)
        let bound_st: SemState = bind_pattern(arm_st, arm.pattern)
        // v4.35.0: type-check optional guard (must be Bool)
        // v4.52.0: actually enforce Bool type (D2 fix)
        let mut guarded_st: SemState = bound_st
        match arm.guard {
            Some(g) => {
                let gr: InferResult = infer_expr(bound_st, g)
                guarded_st = gr.st
                if !type_should_skip(gr.type_info.name) {
                    if gr.type_info.name != "Bool" {
                        guarded_st = add_error_here(guarded_st, "match guard must be a Bool expression, got " + gr.type_info.name)
                    }
                }
            },
            None => {}
        }
        let after_arm: SemState = check_match_arm_body(guarded_st, arm.body)
        st2 = pop_scope(after_arm)
        i = i + 1
    return new_infer_result(unknown_type(), st2)

fn check_match_arm_body(st: SemState, body: MatchArmBody) -> SemState:
    if match_arm_body_kind(body) == "expr":
        let r: InferResult = infer_expr(st, match_arm_body_expr(body))
        return r.st
    return check_block(st, match_arm_body_block(body))

fn bind_pattern(st: SemState, pat: Pattern) -> SemState:
    let pk: String = pattern_kind(pat)
    if pk == "wildcard" { return st }
    if pk == "ident":
        let name: String = pattern_ident_name(pat)
        let sym: Symbol = new_symbol(name, "variable", unknown_type(), false)
        return define_in_scope(st, name, sym)
    if pk == "literal" { return st }
    if pk == "constructor":
        let args: List<Pattern> = pattern_ctor_args(pat)
        let mut st2: SemState = st
        let mut i: Int = 0
        for _ in 0..200:
            if i >= len(args) { return st2 }
            let arg: Pattern = args[i]
            st2 = bind_pattern(st2, arg)
            i = i + 1
        return st2
    // v4.35.0: or-patterns — bind from first alternative (all have same names)
    if pk == "or":
        let alts: List<Pattern> = pattern_or_alts(pat)
        if len(alts) > 0:
            return bind_pattern(st, alts[0])
    return st

// ---------------------------------------------------------------------------
// Lambda
// ---------------------------------------------------------------------------

fn check_lambda_expr(st: SemState, params: List<Param>, body: LambdaBody) -> InferResult:
    let inner: SemState = push_scope(st)
    let mut st2: SemState = inner
    let mut param_types: List<TypeInfo> = []
    let mut i: Int = 0

    // Register parameters
    for _ in 0..200:
        if i >= len(params):
            // Check body
            let body_result: InferResult = check_lambda_body(st2, body)
            let st3: SemState = pop_scope(body_result.st)
            let fn_ti: TypeInfo = make_fn_type(param_types, body_result.type_info)
            return new_infer_result(fn_ti, st3)
        let p: Param = params[i]
        let pt: TypeInfo = resolve_type_opt(p.type_annotation)
        param_types.push(pt)
        let sym: Symbol = new_symbol(p.name, "param", pt, false)
        st2 = define_in_scope(st2, p.name, sym)
        i = i + 1

    let st4: SemState = pop_scope(st2)
    return new_infer_result(unknown_type(), st4)

fn check_lambda_body(st: SemState, body: LambdaBody) -> InferResult:
    if lambda_body_kind(body) == "expr" { return infer_expr(st, lambda_body_expr(body)) }
    let st2: SemState = check_block(st, lambda_body_block(body))
    return new_infer_result(unknown_type(), st2)

// ---------------------------------------------------------------------------
// Spawn / Send
// ---------------------------------------------------------------------------

fn check_spawn_callee(st: SemState, callee: Expr) -> InferResult:
    if expr_kind(callee) == "ident":
        let name: String = expr_ident_name(callee)
        let sym_opt: Option<Symbol> = scope_lookup(st.scope, name)
        match sym_opt {
            Some(sym) => {
                let mut st2: SemState = st
                if sym.kind != "agent" {
                    if sym.kind != "variable" {
                        st2 = add_error_here(st2, "'spawn' requires an agent, but '" + name + "' is a " + sym.kind)
                    }
                }
                return new_infer_result(make_type(sym.name), st2)
            },
            _ => {
                let st_err: SemState = add_error_here(st, "Undefined agent '" + name + "'")
                return new_infer_result(error_type(), st_err)
            }
        }
    return new_infer_result(unknown_type(), st)

fn check_spawn_expr(st: SemState, callee: Expr, args: List<Expr>) -> InferResult:
    // Infer arguments first
    let mut st2: SemState = st
    let mut i: Int = 0
    for _ in 0..200:
        if i < len(args):
            let arg: Expr = args[i]
            let ar: InferResult = infer_expr(st2, arg)
            st2 = ar.st
            i = i + 1
    // Then check callee (no nested match-in-if-in-for)
    check_spawn_callee(st2, callee)

fn check_send_expr(st: SemState, value: Expr, target: Expr) -> SemState:
    let vr: InferResult = infer_expr(st, value)
    let tr: InferResult = infer_expr(vr.st, target)
    tr.st

// ---------------------------------------------------------------------------
// Pipe expression
// ---------------------------------------------------------------------------

fn check_pipe_expr(st: SemState, left: Expr, right: Expr) -> InferResult:
    let lr: InferResult = infer_expr(st, left)
    let st2: SemState = lr.st

    let rk: String = expr_kind(right)
    if rk == "ident":
        let name: String = expr_ident_name(right)
        let sym_opt: Option<Symbol> = scope_lookup(st2.scope, name)
        match sym_opt {
            Some(sym) => {
                if sym.kind == "function" {
                    if sym.type_info.is_function {
                        if len(sym.type_info.param_types) > 0 {
                            let expected: TypeInfo = sym.type_info.param_types[0]
                            if !type_should_skip(expected.name) {
                                if !type_should_skip(lr.type_info.name) {
                                    if types_compatible(expected, lr.type_info) == false {
                                        let st3_mismatch: SemState = add_error_here(st2, "Pipe type mismatch: piped to '" + name + "'")
                                        match sym.type_info.return_type {
                                            Some(ret) => { return new_infer_result(ret, st3_mismatch) },
                                            _ => { return new_infer_result(unknown_type(), st3_mismatch) }
                                        }
                                    }
                                }
                            }
                        }
                        match sym.type_info.return_type {
                            Some(ret) => { return new_infer_result(ret, st2) },
                            _ => { return new_infer_result(unknown_type(), st2) }
                        }
                    }
                }
                if sym.kind == "agent" {
                    return new_infer_result(make_type(sym.name), st2)
                }
                return new_infer_result(unknown_type(), st2)
            },
            _ => {
                let st3_undef: SemState = add_error_here(st2, "Undefined function '" + name + "'")
                return new_infer_result(error_type(), st3_undef)
            }
        }
    if rk == "call":
        return check_call_expr(st2, expr_call_callee(right), expr_call_args(right))
    let rr: InferResult = infer_expr(st2, right)
    return new_infer_result(unknown_type(), rr.st)

// ---------------------------------------------------------------------------
// Block and statement checking
// ---------------------------------------------------------------------------

fn check_block(st: SemState, block: Block) -> SemState:
    let mut st2: SemState = set_span(st, block.span)
    let mut i: Int = 0
    for _ in 0..600:
        if i >= len(block.stmts) { return st2 }
        let stmt: Stmt = block.stmts[i]
        st2 = check_stmt(st2, stmt)
        i = i + 1
    return st2

fn check_stmt(st: SemState, stmt: Stmt) -> SemState:
    let sk: String = stmt_kind(stmt)
    if sk == "let":
        return check_let_stmt(st, stmt_let_name(stmt), stmt_let_mutable(stmt), stmt_let_type(stmt), stmt_let_value(stmt))
    if sk == "expr_stmt":
        let r_expr: InferResult = infer_expr(st, stmt_expr(stmt))
        return r_expr.st
    if sk == "return":
        let value_opt: Option<Expr> = stmt_return_val(stmt)
        match value_opt {
            Some(value) => {
                let r_ret: InferResult = infer_expr(st, value)
                return r_ret.st
            },
            _ => { return st }
        }
    if sk == "for":
        return check_for_stmt(st, stmt_for_var(stmt), stmt_for_iter(stmt), stmt_for_body(stmt))
    if sk == "while":
        let wr: InferResult = infer_expr(st, stmt_while_cond(stmt))
        let mut st_while: SemState = wr.st
        // v4.52.0: while condition must be Bool (D3 fix)
        if !type_should_skip(wr.type_info.name):
            if wr.type_info.name != "Bool":
                st_while = add_error_here(st_while, "While condition must be Bool, got " + wr.type_info.name)
        let inner: SemState = push_scope(st_while)
        let after: SemState = check_block(inner, stmt_while_body(stmt))
        return pop_scope(after)
    if sk == "break" { return st }
    if sk == "continue" { return st }
    if sk == "assert":
        let ar: InferResult = infer_expr(st, stmt_assert_expr(stmt))
        return ar.st
    if sk == "signal_decl":
        return check_signal_decl(st, stmt_signal_name(stmt), stmt_signal_mutable(stmt), stmt_signal_type(stmt), stmt_signal_value(stmt))
    if sk == "stream_decl":
        return check_stream_decl(st, stmt_stream_name(stmt), stmt_stream_type(stmt), stmt_stream_value(stmt))
    // v5.20.1 Te.5.F.D — let destructure: type-check value + bind
    // each leaf field name in the surrounding scope.
    if sk == "let_destructure":
        return check_let_destructure(st, stmt_letdest_pattern(stmt), stmt_letdest_mutable(stmt), stmt_letdest_value(stmt))
    // v5.20.1 Te.5.F.E — let-else: type-check scrutinee + binds the
    // pattern's single ident (if any) in the surrounding scope; else
    // block runs in a nested scope.
    if sk == "let_else":
        return check_let_else(st, stmt_letelse_pattern(stmt), stmt_letelse_scrutinee(stmt), stmt_letelse_else(stmt))
    // v5.20.1 Te.5.F.E — while-let: scrutinee + body in nested scope.
    if sk == "while_let":
        return check_while_let(st, stmt_whilelet_pattern(stmt), stmt_whilelet_scrutinee(stmt), stmt_whilelet_body(stmt))
    return st

// ---------------------------------------------------------------------------
// Let binding
// ---------------------------------------------------------------------------

fn check_let_stmt(st: SemState, name: String, mutable: Bool, type_ann: Option<TypeExpr>, value: Expr) -> SemState:
    let vr: InferResult = infer_expr(st, value)
    let ann_type: TypeInfo = resolve_type_opt(type_ann)
    let mut st2: SemState = vr.st

    // Check annotation matches value type
    // v4.53.0: skip if either side is unknown/error (cascade suppression)
    if !type_should_skip(ann_type.name):
        if !type_should_skip(vr.type_info.name):
            if types_compatible(ann_type, vr.type_info) == false:
                st2 = add_error_here(st2, "Type mismatch: declared type " + ann_type.name + " but initial value is " + vr.type_info.name)

    // Use annotation if available, otherwise inferred
    let resolved: TypeInfo = ann_type
    if type_should_skip(ann_type.name):
        let resolved2: TypeInfo = vr.type_info
        let sym: Symbol = new_symbol(name, "variable", resolved2, mutable)
        return define_in_scope(st2, name, sym)
    let sym2: Symbol = new_symbol(name, "variable", resolved, mutable)
    return define_in_scope(st2, name, sym2)

// v5.20.1 Te.5.F.D — let destructure check: type-infer value, then
// recursively define each leaf field name in the current scope.
fn check_let_destructure(st: SemState, pattern: StructPattern, outer_mut: Bool, value: Expr) -> SemState:
    let vr: InferResult = infer_expr(st, value)
    let mut st2: SemState = vr.st
    return define_pattern_bindings(st2, pattern, outer_mut)

fn define_pattern_bindings(st: SemState, pattern: StructPattern, outer_mut: Bool) -> SemState:
    let mut s: SemState = st
    let n: Int = len(pattern.fields)
    let mut i: Int = 0
    for _ in 0..200:
        if i >= n { return s }
        let fp: FieldPattern = pattern.fields[i]
        match fp.sub_pattern {
            Some(sub) => {
                s = define_pattern_bindings(s, sub, outer_mut)
            },
            _ => {
                let mut leaf_mut: Bool = outer_mut
                if fp.mutable { leaf_mut = true }
                let sym: Symbol = new_symbol(fp.name, "variable", unknown_type(), leaf_mut)
                s = define_in_scope(s, fp.name, sym)
            }
        }
        i = i + 1
    return s

// v5.20.1 Te.5.F.E — let-else check: type-infer scrutinee, bind the
// pattern's single ident (if any) in the surrounding scope, type-check
// else block in a nested scope.
fn check_let_else(st: SemState, pattern: Pattern, scrutinee: Expr, else_block: Block) -> SemState:
    let sr: InferResult = infer_expr(st, scrutinee)
    let mut s: SemState = sr.st
    // Bind pattern leaves into the current scope (they "leak" — that's
    // the essence of let-else).
    let pk: String = pattern_kind(pattern)
    if pk == "constructor":
        let pargs: List<Pattern> = pattern_ctor_args(pattern)
        let mut j: Int = 0
        let nargs: Int = len(pargs)
        for _ in 0..16:
            if j >= nargs { break }
            let arg: Pattern = pargs[j]
            if pattern_kind(arg) == "ident":
                let sym: Symbol = new_symbol(pattern_ident_name(arg), "variable", unknown_type(), false)
                s = define_in_scope(s, pattern_ident_name(arg), sym)
            j = j + 1
    // Else block in a nested scope.
    let inner: SemState = push_scope(s)
    let after: SemState = check_block(inner, else_block)
    return pop_scope(after)

// v5.20.1 Te.5.F.E — while-let check.
fn check_while_let(st: SemState, pattern: Pattern, scrutinee: Expr, body: Block) -> SemState:
    let sr: InferResult = infer_expr(st, scrutinee)
    let mut s: SemState = sr.st
    let inner: SemState = push_scope(s)
    let pk: String = pattern_kind(pattern)
    let mut bound: SemState = inner
    if pk == "constructor":
        let pargs: List<Pattern> = pattern_ctor_args(pattern)
        let mut j: Int = 0
        let nargs: Int = len(pargs)
        for _ in 0..16:
            if j >= nargs { break }
            let arg: Pattern = pargs[j]
            if pattern_kind(arg) == "ident":
                let sym: Symbol = new_symbol(pattern_ident_name(arg), "variable", unknown_type(), false)
                bound = define_in_scope(bound, pattern_ident_name(arg), sym)
            j = j + 1
    let after: SemState = check_block(bound, body)
    return pop_scope(after)

// ---------------------------------------------------------------------------
// For loop
// ---------------------------------------------------------------------------

fn check_for_stmt(st: SemState, var_name: String, iterable: Expr, body: Block) -> SemState:
    let ir: InferResult = infer_expr(st, iterable)
    let inner: SemState = push_scope(ir.st)
    // Infer loop variable type from iterable
    let mut var_type: TypeInfo = unknown_type()
    if ir.type_info.kind == "range":
        var_type = int_type()
    if ir.type_info.kind == "list":
        if len(ir.type_info.args) > 0:
            var_type = ir.type_info.args[0]
    let sym: Symbol = new_symbol(var_name, "variable", var_type, false)
    let bound: SemState = define_in_scope(inner, var_name, sym)
    let after: SemState = check_block(bound, body)
    return pop_scope(after)

// ---------------------------------------------------------------------------
// Signal / Stream declarations
// ---------------------------------------------------------------------------

fn check_signal_decl(st: SemState, name: String, mutable: Bool, type_ann: Option<TypeExpr>, value: Expr) -> SemState:
    let vr: InferResult = infer_expr(st, value)
    let ann_type: TypeInfo = resolve_type_opt(type_ann)
    let resolved: TypeInfo = ann_type
    if type_should_skip(ann_type.name):
        let resolved2: TypeInfo = vr.type_info
        let mut args: List<TypeInfo> = []
        args.push(resolved2)
        let sig_type: TypeInfo = make_generic_type("Signal", args)
        let sym: Symbol = new_symbol(name, "variable", sig_type, mutable)
        return define_in_scope(vr.st, name, sym)
    let mut args2: List<TypeInfo> = []
    args2.push(resolved)
    let sig_type2: TypeInfo = make_generic_type("Signal", args2)
    let sym2: Symbol = new_symbol(name, "variable", sig_type2, mutable)
    return define_in_scope(vr.st, name, sym2)

fn check_stream_decl(st: SemState, name: String, type_ann: Option<TypeExpr>, value: Expr) -> SemState:
    let vr: InferResult = infer_expr(st, value)
    let ann_type: TypeInfo = resolve_type_opt(type_ann)
    let resolved: TypeInfo = ann_type
    if type_should_skip(ann_type.name):
        let resolved2: TypeInfo = vr.type_info
        let args: List<TypeInfo> = []
        let stream_type: TypeInfo = make_generic_type("Stream", args)
        let sym: Symbol = new_symbol(name, "variable", stream_type, false)
        return define_in_scope(vr.st, name, sym)
    let args2: List<TypeInfo> = []
    let stream_type2: TypeInfo = make_generic_type("Stream", args2)
    let sym2: Symbol = new_symbol(name, "variable", stream_type2, false)
    return define_in_scope(vr.st, name, sym2)

// ---------------------------------------------------------------------------
// Definition registration (first pass)
// ---------------------------------------------------------------------------

fn register_definitions(st: SemState, program: Program) -> SemState:
    let mut st2: SemState = st
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(program.definitions) { return st2 }
        let def: Definition = program.definitions[i]
        st2 = register_def(st2, def)
        i = i + 1
    return st2

fn register_def(st: SemState, def: Definition) -> SemState:
    let dk: String = def_kind(def)
    // v4.78.0 (CARRY_FORWARD A10b): handle const_def early, before the
    // long if-chain, to work around a codegen issue where later branches
    // are unreachable in the compiled binary.
    if dk == "const_def":
        let cn: String = def_const_name(def)
        let cte: TypeExpr = def_const_type_expr(def)
        let cty: TypeInfo = resolve_type_expr(cte)
        let csym: Symbol = new_symbol(cn, "variable", cty, false)
        return define_in_scope(st, cn, csym)
    if dk == "fn_def":
        let data: FnDefData = def_fn_data(def)
        let mut params: List<TypeInfo> = []
        let mut pi: Int = 0
        for _ in 0..200:
            if pi >= len(data.params):
                let ret: TypeInfo = resolve_type_opt(data.return_type)
                let fn_type: TypeInfo = make_fn_type(params, ret)
                let sym_fn: Symbol = new_symbol(data.name, "function", fn_type, false)
                return define_in_scope(st, data.name, sym_fn)
            let p: Param = data.params[pi]
            let pt: TypeInfo = resolve_type_opt(p.type_annotation)
            pi = pi + 1
        return st
    if dk == "agent_def":
        let data: AgentDefData = def_agent_data(def)
        let sym_agent: Symbol = new_symbol(data.name, "agent", make_type(data.name), false)
        return define_in_scope(st, data.name, sym_agent)
    if dk == "pipe_def":
        let sym_pipe: Symbol = new_symbol("pipe", "pipe", unknown_type(), false)
        return define_in_scope(st, "pipe", sym_pipe)
    if dk == "struct_def":
        let data: StructDefData = def_struct_data(def)
        let sym_struct: Symbol = new_symbol(data.name, "struct", make_type(data.name), false)
        let mut st2: SemState = define_in_scope(st, data.name, sym_struct)
        // Register __new_StructName constructor function
        let ctor_name: String = "__new_" + data.name
        let ctor_type: TypeInfo = make_builtin_fn_type(make_type(data.name))
        let ctor_sym: Symbol = new_symbol(ctor_name, "function", ctor_type, false)
        st2 = define_in_scope(st2, ctor_name, ctor_sym)
        return st2
    if dk == "enum_def":
        let data: EnumDefData = def_enum_data(def)
        let sym_enum: Symbol = new_symbol(data.name, "enum", make_type(data.name), false)
        let mut st2: SemState = define_in_scope(st, data.name, sym_enum)
        let mut vi: Int = 0
        for _ in 0..200:
            if vi >= len(data.variants) { return st2 }
            let v: EnumVariant = data.variants[vi]
            let variant_type: TypeInfo = make_builtin_fn_type(make_type(data.name))
            let vsym: Symbol = new_symbol(v.name, "function", variant_type, false)
            st2 = define_in_scope(st2, v.name, vsym)
            vi = vi + 1
        return st2
    if dk == "type_alias":
        let name: String = def_type_alias_name(def)
        let resolved: TypeInfo = resolve_type_expr(def_type_alias_type(def))
        let sym_alias: Symbol = new_symbol(name, "type_alias", resolved, false)
        return define_in_scope(st, name, sym_alias)
    if dk == "import_def":
        let path: List<String> = def_import_path(def)
        let items: List<String> = def_import_items(def)
        let mut st2: SemState = st
        if len(items) > 0:
            let mut ii: Int = 0
            for _ in 0..200:
                if ii >= len(items) { return st2 }
                let item: String = items[ii]
                let sym_item: Symbol = new_symbol(item, "variable", unknown_type(), false)
                st2 = define_in_scope(st2, item, sym_item)
                ii = ii + 1
        else:
            if len(path) > 0:
                let mod_name: String = path[len(path) - 1]
                let sym_mod: Symbol = new_symbol(mod_name, "variable", unknown_type(), false)
                st2 = define_in_scope(st2, mod_name, sym_mod)
        return st2
    if dk == "export_def":
        let inner_def: Option<Definition> = def_export_inner(def)
        match inner_def:
            Some(d) => { return register_def(st, d) }
            _ => { return st }
    if dk == "trait_def":
        let trait_name: String = def_trait_name(def)
        let trait_methods: List<FnDefData> = def_trait_methods(def)
        // Store method count in args list length for validation
        let mut trait_type: TypeInfo = make_type(trait_name)
        let sym_trait: Symbol = new_symbol(trait_name, "trait", trait_type, false)
        let mut st2_trait: SemState = define_in_scope(st, trait_name, sym_trait)
        // Register each trait method as "TraitName.method_name" for impl validation
        let mut tmi: Int = 0
        for _ in 0..200:
            if tmi >= len(trait_methods) { return st2_trait }
            let tm: FnDefData = trait_methods[tmi]
            let tm_key: String = trait_name + "." + tm.name
            let tm_sym: Symbol = new_symbol(tm_key, "trait_method", unknown_type(), false)
            st2_trait = define_in_scope(st2_trait, tm_key, tm_sym)
            tmi = tmi + 1
        return st2_trait
    if dk == "let_def":
        let let_name: String = def_let_name(def)
        let let_type_name: String = def_let_type(def)
        let mut let_ty: TypeInfo = unknown_type()
        if let_type_name == "Int" { let_ty = int_type() }
        if let_type_name == "Float" { let_ty = float_type() }
        if let_type_name == "Bool" { let_ty = bool_type() }
        if let_type_name == "String" { let_ty = string_type() }
        let sym_let: Symbol = new_symbol(let_name, "variable", let_ty, false)
        return define_in_scope(st, let_name, sym_let)
    // const_def handled at top of function (v4.78.0, CARRY_FORWARD A10b)
    // impl_def — methods handled in second pass
    return st

// ---------------------------------------------------------------------------
// Definition checking (second pass)
// ---------------------------------------------------------------------------

fn check_definitions(st: SemState, program: Program) -> SemState:
    let mut st2: SemState = st
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(program.definitions) { return st2 }
        let def: Definition = program.definitions[i]
        st2 = check_def(st2, def)
        i = i + 1
    return st2

fn check_def(st: SemState, def: Definition) -> SemState:
    let dk: String = def_kind(def)
    if dk == "fn_def" { return check_fn_body(st, def_fn_data(def)) }
    if dk == "agent_def" { return check_agent_body(st, def_agent_data(def)) }
    if dk == "pipe_def" { return check_pipe_stages(st, def_pipe_data(def)) }
    if dk == "impl_def" { return check_impl_body(st, def_impl_target(def), def_impl_trait_name(def), def_impl_methods(def)) }
    if dk == "export_def":
        let inner_def: Option<Definition> = def_export_inner(def)
        match inner_def:
            Some(d) => { return check_def(st, d) }
            _ => { return st }
    return st

// ---------------------------------------------------------------------------
// Function body checking
// ---------------------------------------------------------------------------

fn check_fn_body(st: SemState, data: FnDefData) -> SemState:
    let inner: SemState = push_scope(set_span(st, data.span))
    // v4.52.0: set function context for ? operator validation
    let ret_type: TypeInfo = resolve_type_opt(data.return_type)
    let mut st2: SemState = set_fn_context(inner, data.name, ret_type)

    // Register parameters
    let mut pi: Int = 0
    for _ in 0..200:
        if pi >= len(data.params):
            // Check body
            let after: SemState = check_block(st2, data.body)
            return pop_scope(after)
        let p: Param = data.params[pi]
        let pt: TypeInfo = resolve_type_opt(p.type_annotation)
        let sym: Symbol = new_symbol(p.name, "param", pt, false)
        st2 = define_in_scope(st2, p.name, sym)
        pi = pi + 1

    return pop_scope(st2)

// ---------------------------------------------------------------------------
// Agent body checking
// ---------------------------------------------------------------------------

fn check_agent_body(st: SemState, data: AgentDefData) -> SemState:
    let inner: SemState = push_scope(set_span(st, data.span))
    let mut st2: SemState = inner

    // Register self
    let self_sym: Symbol = new_symbol("self", "variable", make_type(data.name), false)
    st2 = define_in_scope(st2, "self", self_sym)

    // Register inputs
    let mut ii: Int = 0
    for _ in 0..200:
        if ii >= len(data.inputs):
            // Register outputs
            let mut oi: Int = 0
            for _ in 0..200:
                if oi >= len(data.outputs):
                    // Check state bindings
                    let mut si_idx: Int = 0
                    for _ in 0..200:
                        if si_idx >= len(data.state):
                            // Check methods
                            let mut mi: Int = 0
                            for _ in 0..200:
                                if mi >= len(data.methods):
                                    return pop_scope(st2)
                                let method: FnDefData = data.methods[mi]
                                st2 = check_fn_body(st2, method)
                                mi = mi + 1
                            return pop_scope(st2)
                        let state_stmt: Stmt = data.state[si_idx]
                        st2 = check_stmt(st2, state_stmt)
                        si_idx = si_idx + 1
                    return pop_scope(st2)
                let out: AgentOutput = data.outputs[oi]
                let out_type: TypeInfo = resolve_type_expr(out.type_annotation)
                let out_sym: Symbol = new_symbol(out.name, "variable", out_type, false)
                st2 = define_in_scope(st2, out.name, out_sym)
                oi = oi + 1
            return pop_scope(st2)
        let inp: AgentInput = data.inputs[ii]
        let inp_type: TypeInfo = resolve_type_expr(inp.type_annotation)
        let inp_sym: Symbol = new_symbol(inp.name, "variable", inp_type, false)
        st2 = define_in_scope(st2, inp.name, inp_sym)
        ii = ii + 1

    return pop_scope(st2)

// ---------------------------------------------------------------------------
// Impl block checking
// ---------------------------------------------------------------------------

fn check_impl_body(st: SemState, target: String, trait_name_opt: Option<String>, methods: List<FnDefData>) -> SemState:
    let sym_opt: Option<Symbol> = scope_lookup(st.scope, target)
    let mut st2: SemState = st
    match sym_opt {
        Some(_) => {},
        _ => {
            st2 = add_error_here(st2, "Undefined type '" + target + "' in impl block")
        }
    }

    // Validate trait requirements if this is "impl Trait for Type"
    match trait_name_opt {
        Some(trait_name) => {
            let trait_sym: Option<Symbol> = scope_lookup(st2.scope, trait_name)
            match trait_sym {
                Some(ts) => {
                    if ts.kind != "trait" {
                        st2 = add_error_here(st2, "'" + trait_name + "' is not a trait")
                    }
                    // Check each trait method is implemented
                    st2 = validate_trait_methods(st2, trait_name, target, methods)
                },
                _ => {
                    st2 = add_error_here(st2, "Undefined trait '" + trait_name + "'")
                }
            }
        },
        _ => {}
    }

    let mut mi: Int = 0
    for _ in 0..200:
        if mi >= len(methods) { return st2 }
        let method: FnDefData = methods[mi]
        st2 = check_fn_body(st2, method)
        mi = mi + 1
    return st2

fn validate_trait_methods(st: SemState, trait_name: String, target: String, impl_methods: List<FnDefData>) -> SemState:
    // Build list of implemented method names
    let mut impl_names: List<String> = []
    let mut ii: Int = 0
    for _ in 0..200:
        if ii >= len(impl_methods) { ii = len(impl_methods) + 1 }
        if ii < len(impl_methods):
            impl_names.push(impl_methods[ii].name)
            ii = ii + 1

    // Check each registered trait method "TraitName.method" exists in impl
    let mut st2: SemState = st
    let mut ti: Int = 0
    let scope_syms: List<Symbol> = st.scope.symbols
    for _ in 0..10000:
        if ti >= len(scope_syms) { return st2 }
        let sym: Symbol = scope_syms[ti]
        if sym.kind == "trait_method":
            let prefix: String = trait_name + "."
            if sym.name.starts_with(prefix):
                // Extract method name after "TraitName."
                let method_name: String = sym.name.substr(len(prefix), len(sym.name) - len(prefix))
                // Check if impl provides this method
                if !list_contains(impl_names, method_name):
                    st2 = add_error_here(st2, "Missing method '" + method_name + "' required by trait '" + trait_name + "' for type '" + target + "'")
        ti = ti + 1
    return st2

fn list_contains(lst: List<String>, item: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..200:
        if i >= len(lst) { return false }
        if lst[i] == item { return true }
        i = i + 1
    return false

// ---------------------------------------------------------------------------
// Pipe definition checking
// ---------------------------------------------------------------------------

fn check_pipe_stage_type(st: SemState, stage: Expr, pipe_name: String) -> TypeInfo:
    if expr_kind(stage) == "ident" { return resolve_pipe_ident_type(st, expr_ident_name(stage)) }
    return unknown_type()

fn resolve_pipe_ident_type(st: SemState, name: String) -> TypeInfo:
    let sym_opt: Option<Symbol> = scope_lookup(st.scope, name)
    match sym_opt {
        Some(sym) => {
            return resolve_sym_output_type(sym)
        },
        _ => { return unknown_type() }
    }

fn resolve_sym_output_type(sym: Symbol) -> TypeInfo:
    if sym.kind != "function" { return unknown_type() }
    if !sym.type_info.is_function { return unknown_type() }
    match sym.type_info.return_type:
        Some(ret) => { return ret }
        _ => { return unknown_type() }

fn check_pipe_stage_err(st: SemState, stage: Expr, pipe_name: String) -> SemState:
    if expr_kind(stage) == "ident":
        let name: String = expr_ident_name(stage)
        let sym_opt: Option<Symbol> = scope_lookup(st.scope, name)
        match sym_opt:
            Some(sym) => { return st }
            _ => { return add_error_here(st, "Undefined stage '" + name + "' in pipe '" + pipe_name + "'") }
    let sr: InferResult = infer_expr(st, stage)
    return sr.st

fn check_pipe_stages(st: SemState, data: PipeDefData) -> SemState:
    if len(data.stages) < 2 { return st }

    let mut st2: SemState = st
    let mut prev_output: TypeInfo = unknown_type()
    let mut si_idx: Int = 0

    for _ in 0..200:
        if si_idx >= len(data.stages) { return st2 }
        let stage: Expr = data.stages[si_idx]
        prev_output = check_pipe_stage_type(st2, stage, data.name)
        let stage_err: SemState = check_pipe_stage_err(st2, stage, data.name)
        st2 = stage_err
        si_idx = si_idx + 1
    return st2

// ---------------------------------------------------------------------------
// Builtin registration
// ---------------------------------------------------------------------------

fn register_builtins(st: SemState) -> SemState:
    let mut st2: SemState = st

    // print, println -> Void
    let print_sym: Symbol = new_symbol("print", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "print", print_sym)
    let println_sym: Symbol = new_symbol("println", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "println", println_sym)

    // len -> Int
    let len_sym: Symbol = new_symbol("len", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "len", len_sym)

    // toString -> String
    let tostr_sym: Symbol = new_symbol("toString", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "toString", tostr_sym)

    // str -> String (alias for toString)
    let str_sym: Symbol = new_symbol("str", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "str", str_sym)

    // int -> Int, float -> Float (type conversions)
    let int_sym: Symbol = new_symbol("int", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "int", int_sym)
    let float_sym: Symbol = new_symbol("float", "function", make_builtin_fn_type(make_type("Float")), false)
    st2 = define_in_scope(st2, "float", float_sym)

    // Some -> Option
    let some_sym: Symbol = new_symbol("Some", "function", make_builtin_fn_type(make_type("Option")), false)
    st2 = define_in_scope(st2, "Some", some_sym)

    // Ok, Err -> Result
    let ok_sym: Symbol = new_symbol("Ok", "function", make_builtin_fn_type(make_type("Result")), false)
    st2 = define_in_scope(st2, "Ok", ok_sym)
    let err_sym: Symbol = new_symbol("Err", "function", make_builtin_fn_type(make_type("Result")), false)
    st2 = define_in_scope(st2, "Err", err_sym)

    // signal -> Signal
    let sig_sym: Symbol = new_symbol("signal", "function", make_builtin_fn_type(make_type("Signal")), false)
    st2 = define_in_scope(st2, "signal", sig_sym)

    // stream -> Stream
    let stream_sym: Symbol = new_symbol("stream", "function", make_builtin_fn_type(make_type("Stream")), false)
    st2 = define_in_scope(st2, "stream", stream_sym)

    // ord -> Int
    let ord_sym: Symbol = new_symbol("ord", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "ord", ord_sym)

    // chr -> String
    let chr_sym: Symbol = new_symbol("chr", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "chr", chr_sym)

    // join -> String
    let join_sym: Symbol = new_symbol("join", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "join", join_sym)

    // typeof -> String
    let typeof_sym: Symbol = new_symbol("typeof", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "typeof", typeof_sym)

    // C runtime functions used by the self-hosted compiler driver
    let argc_sym: Symbol = new_symbol("__mn_argc", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_argc", argc_sym)
    let argv_sym: Symbol = new_symbol("__mn_argv", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "__mn_argv", argv_sym)
    let fread_sym: Symbol = new_symbol("__mn_file_read_or_empty", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "__mn_file_read_or_empty", fread_sym)
    let exit_sym: Symbol = new_symbol("__mn_exit", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "__mn_exit", exit_sym)
    let eprint_sym: Symbol = new_symbol("__mn_str_eprint", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "__mn_str_eprint", eprint_sym)
    let eprintln_sym: Symbol = new_symbol("__mn_str_eprintln", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "__mn_str_eprintln", eprintln_sym)
    let system_sym: Symbol = new_symbol("__mn_system", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_system", system_sym)
    let fwrite_sym: Symbol = new_symbol("__mn_file_write", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "__mn_file_write", fwrite_sym)
    // v5.8.4 Wb.2: host-detect for OS-1 detection mechanism.
    let hostwin_sym: Symbol = new_symbol("__mn_host_is_win64", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_host_is_win64", hostwin_sym)
    // v5.8.6 We.1: refined (is_windows, arch_bits) pair.
    let hostiswin_sym: Symbol = new_symbol("__mn_host_is_windows", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_host_is_windows", hostiswin_sym)
    let hostbits_sym: Symbol = new_symbol("__mn_host_arch_bits", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_host_arch_bits", hostbits_sym)
    // v5.9.0 DX.2 / DX.3 / DX.4: native CLI hygiene exports.
    let vsym: Symbol = new_symbol("__mn_version_string", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "__mn_version_string", vsym)
    let dnsym: Symbol = new_symbol("__mn_dev_null_redirect", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "__mn_dev_null_redirect", dnsym)
    let cesym: Symbol = new_symbol("__mn_clang_err_path", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "__mn_clang_err_path", cesym)
    let dcfsym: Symbol = new_symbol("__mn_dir_count_files", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_dir_count_files", dcfsym)
    let dtssym: Symbol = new_symbol("__mn_dir_total_size", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_dir_total_size", dtssym)
    let drrsym: Symbol = new_symbol("__mn_dir_remove_recursive", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_dir_remove_recursive", drrsym)
    let fesym: Symbol = new_symbol("__mn_file_exists", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_file_exists", fesym)
    // v5.10.0 Win.1b.D: directory of running binary, used by find_clang().
    let edsym: Symbol = new_symbol("__mn_executable_dir", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "__mn_executable_dir", edsym)
    // v5.14.1 B.5/B.6: colon-block preprocessor (in C runtime).
    let itbsym: Symbol = new_symbol("__mn_indent_to_braces", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "__mn_indent_to_braces", itbsym)
    // v5.23.2 Te.3.B.2: brace-deprecation detector + warning emitter.
    let cubbsym: Symbol = new_symbol("__mn_count_user_brace_block_openers", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "__mn_count_user_brace_block_openers", cubbsym)
    let ebdwsym: Symbol = new_symbol("__mn_emit_brace_deprecation_warning", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "__mn_emit_brace_deprecation_warning", ebdwsym)

    // High-level I/O builtins (v3.41.0)
    let readline_sym: Symbol = new_symbol("read_line", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "read_line", readline_sym)
    let readfile_sym: Symbol = new_symbol("read_file", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "read_file", readfile_sym)
    let writefile_sym: Symbol = new_symbol("write_file", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "write_file", writefile_sym)
    let appendfile_sym: Symbol = new_symbol("append_file", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "append_file", appendfile_sym)
    let fileexists_sym: Symbol = new_symbol("file_exists", "function", make_builtin_fn_type(make_type("Bool")), false)
    st2 = define_in_scope(st2, "file_exists", fileexists_sym)
    let listdir_sym: Symbol = new_symbol("list_dir", "function", make_builtin_fn_type(make_type("List")), false)
    st2 = define_in_scope(st2, "list_dir", listdir_sym)

    // Network, crypto, regex builtins (v3.42.0)
    let httpget_sym: Symbol = new_symbol("http_get", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "http_get", httpget_sym)
    let sha256_sym: Symbol = new_symbol("sha256", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "sha256", sha256_sym)
    let b64enc_sym: Symbol = new_symbol("base64_encode", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "base64_encode", b64enc_sym)
    let b64dec_sym: Symbol = new_symbol("base64_decode", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "base64_decode", b64dec_sym)
    let hmac_sym: Symbol = new_symbol("hmac_sha256", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "hmac_sha256", hmac_sym)
    let hexenc_sym: Symbol = new_symbol("hex_encode", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "hex_encode", hexenc_sym)
    let randbytes_sym: Symbol = new_symbol("random_bytes", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "random_bytes", randbytes_sym)
    let regmatch_sym: Symbol = new_symbol("regex_match", "function", make_builtin_fn_type(make_type("Bool")), false)
    st2 = define_in_scope(st2, "regex_match", regmatch_sym)
    let regrepl_sym: Symbol = new_symbol("regex_replace", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "regex_replace", regrepl_sym)

    // GPU builtins (v3.46.0)
    let gpu_avail_sym: Symbol = new_symbol("gpu_available", "function", make_builtin_fn_type(make_type("Bool")), false)
    st2 = define_in_scope(st2, "gpu_available", gpu_avail_sym)
    let gpu_name_sym: Symbol = new_symbol("gpu_device_name", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "gpu_device_name", gpu_name_sym)
    let gpu_mem_sym: Symbol = new_symbol("gpu_device_memory", "function", make_builtin_fn_type(make_type("Int")), false)
    st2 = define_in_scope(st2, "gpu_device_memory", gpu_mem_sym)
    let gpu_tadd_sym: Symbol = new_symbol("gpu_tensor_add", "function", make_builtin_fn_type(make_type("List")), false)
    st2 = define_in_scope(st2, "gpu_tensor_add", gpu_tadd_sym)
    let gpu_tsub_sym: Symbol = new_symbol("gpu_tensor_sub", "function", make_builtin_fn_type(make_type("List")), false)
    st2 = define_in_scope(st2, "gpu_tensor_sub", gpu_tsub_sym)
    let gpu_tmul_sym: Symbol = new_symbol("gpu_tensor_mul", "function", make_builtin_fn_type(make_type("List")), false)
    st2 = define_in_scope(st2, "gpu_tensor_mul", gpu_tmul_sym)
    let gpu_tdiv_sym: Symbol = new_symbol("gpu_tensor_div", "function", make_builtin_fn_type(make_type("List")), false)
    st2 = define_in_scope(st2, "gpu_tensor_div", gpu_tdiv_sym)
    let gpu_tmat_sym: Symbol = new_symbol("gpu_tensor_matmul", "function", make_builtin_fn_type(make_type("List")), false)
    st2 = define_in_scope(st2, "gpu_tensor_matmul", gpu_tmat_sym)

    // String methods (lowered from .method() calls to function calls)
    let sw_sym: Symbol = new_symbol("starts_with", "function", make_builtin_fn_type(make_type("Bool")), false)
    st2 = define_in_scope(st2, "starts_with", sw_sym)
    let ew_sym: Symbol = new_symbol("ends_with", "function", make_builtin_fn_type(make_type("Bool")), false)
    st2 = define_in_scope(st2, "ends_with", ew_sym)
    let find_sym: Symbol = new_symbol("find", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "find", find_sym)
    let contains_sym2: Symbol = new_symbol("contains", "function", make_builtin_fn_type(make_type("Bool")), false)
    st2 = define_in_scope(st2, "contains", contains_sym2)
    let substr_sym: Symbol = new_symbol("substr", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "substr", substr_sym)
    let charat_sym: Symbol = new_symbol("char_at", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "char_at", charat_sym)
    let byteat_sym: Symbol = new_symbol("byte_at", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "byte_at", byteat_sym)
    let trim_sym: Symbol = new_symbol("trim", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "trim", trim_sym)
    let toupper_sym: Symbol = new_symbol("to_upper", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "to_upper", toupper_sym)
    let tolower_sym: Symbol = new_symbol("to_lower", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "to_lower", tolower_sym)
    let replace_sym: Symbol = new_symbol("replace", "function", make_builtin_fn_type(string_type()), false)
    st2 = define_in_scope(st2, "replace", replace_sym)
    let split_sym: Symbol = new_symbol("split", "function", make_builtin_fn_type(make_type("List")), false)
    st2 = define_in_scope(st2, "split", split_sym)
    // List methods
    let push_sym: Symbol = new_symbol("push", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "push", push_sym)

    // Async builtins (v5.5.0 Sh.4): block_on(future) -> T. The return
    // type is inferred from the awaited Future<T> at the call site; we
    // register <unknown> so the type system skips downstream checks.
    let blockon_sym: Symbol = new_symbol("block_on", "function", make_builtin_fn_type(unknown_type()), false)
    st2 = define_in_scope(st2, "block_on", blockon_sym)

    // Tensor builtins (v5.6.0 Sh.6). Mirrors mapanare/types.py:349-355 and
    // is_builtin_function/builtin_return_type above.
    let trank_sym: Symbol = new_symbol("tensor_rank", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "tensor_rank", trank_sym)
    let tsize_sym: Symbol = new_symbol("tensor_size", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "tensor_size", tsize_sym)
    let tgetf_sym: Symbol = new_symbol("tensor_get_f64", "function", make_builtin_fn_type(make_type("Float")), false)
    st2 = define_in_scope(st2, "tensor_get_f64", tgetf_sym)
    let tgeti_sym: Symbol = new_symbol("tensor_get_i64", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "tensor_get_i64", tgeti_sym)
    let tsdim_sym: Symbol = new_symbol("tensor_shape_dim", "function", make_builtin_fn_type(int_type()), false)
    st2 = define_in_scope(st2, "tensor_shape_dim", tsdim_sym)
    let tprint_sym: Symbol = new_symbol("tensor_print", "function", make_builtin_fn_type(void_type()), false)
    st2 = define_in_scope(st2, "tensor_print", tprint_sym)

    return st2

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

pub fn check(program: Program, filename: String) -> List<SemanticError>:
    // Create initial state with builtins
    let mut st: SemState = new_sem_state(filename)
    st = register_builtins(st)

    // Pass 1: register all top-level definitions
    st = register_definitions(st, program)

    // Pass 2: check all definition bodies
    st = check_definitions(st, program)

    return st.errors

fn check_or_raise(program: Program, filename: String) -> List<SemanticError>:
    let errors: List<SemanticError> = check(program, filename)
    errors

// ===== mir.mn =====
// mir.mn — MIR (Mid-level Intermediate Representation) data structures.
// Shared by lower.mn, lower_state.mn, and emit_llvm.mn.
//
// Defines all MIR types, values, instructions, basic blocks, functions,
// modules, and associated helper structs/constructors.

// ---------------------------------------------------------------------------
// MIR type representation
// ---------------------------------------------------------------------------

struct MIRType:
    name: String
    kind: Int
    args: List<MIRType>

// MIRType kind constants — integer tags (no string comparisons)
pub fn TK_INT() -> Int { return 0 }
pub fn TK_FLOAT() -> Int { return 1 }
pub fn TK_BOOL() -> Int { return 2 }
pub fn TK_STRING() -> Int { return 3 }
pub fn TK_VOID() -> Int { return 4 }
pub fn TK_LIST() -> Int { return 5 }
pub fn TK_MAP() -> Int { return 6 }
pub fn TK_OPTION() -> Int { return 7 }
pub fn TK_RESULT() -> Int { return 8 }
pub fn TK_ENUM() -> Int { return 9 }
pub fn TK_STRUCT() -> Int { return 10 }
pub fn TK_FN() -> Int { return 11 }
pub fn TK_SIGNAL() -> Int { return 12 }
pub fn TK_UNKNOWN() -> Int { return 13 }
pub fn TK_CHAR() -> Int { return 14 }
pub fn TK_AGENT() -> Int { return 15 }
pub fn TK_RANGE() -> Int { return 16 }
pub fn TK_STREAM() -> Int { return 17 }
pub fn TK_TENSOR() -> Int { return 18 }
pub fn TK_PTR() -> Int { return 19 }

// Convert kind tag to string name (for emit_llvm_ir and diagnostics)
pub fn tk_name(k: Int) -> String:
    if k == 0 { return "int" }
    if k == 1 { return "float" }
    if k == 2 { return "bool" }
    if k == 3 { return "string" }
    if k == 4 { return "void" }
    if k == 5 { return "list" }
    if k == 6 { return "map" }
    if k == 7 { return "option" }
    if k == 8 { return "result" }
    if k == 9 { return "enum" }
    if k == 10 { return "struct" }
    if k == 11 { return "fn" }
    if k == 12 { return "signal" }
    if k == 13 { return "unknown" }
    if k == 14 { return "char" }
    if k == 15 { return "agent" }
    if k == 16 { return "range" }
    return "unknown"

fn new_mir_type(name: String, kind: Int) -> MIRType:
    let args: List<MIRType> = []
    new MIRType { name: name, kind: kind, args: args }

fn new_mir_type_with_args(name: String, kind: Int, args: List<MIRType>) -> MIRType = new MIRType { name: name, kind: kind, args: args }

fn mir_int() -> MIRType { return new_mir_type("Int", TK_INT()) }
fn mir_float() -> MIRType { return new_mir_type("Float", TK_FLOAT()) }
fn mir_bool() -> MIRType { return new_mir_type("Bool", TK_BOOL()) }
fn mir_string() -> MIRType { return new_mir_type("String", TK_STRING()) }
fn mir_void() -> MIRType { return new_mir_type("Void", TK_VOID()) }
fn mir_unknown() -> MIRType { return new_mir_type("<unknown>", TK_UNKNOWN()) }
fn mir_option() -> MIRType { return new_mir_type("Option", TK_OPTION()) }
fn mir_option_of(inner: MIRType) -> MIRType:
    let mut t: MIRType = new_mir_type("Option", TK_OPTION())
    t.args.push(inner)
    t
fn mir_result() -> MIRType { return new_mir_type("Result", TK_RESULT()) }
fn mir_list() -> MIRType { return new_mir_type("List", TK_LIST()) }
// v5.6.0 Sh.6: tensor values travel as ptr through the LLVM backend.
fn mir_tensor() -> MIRType { return new_mir_type("Tensor", TK_TENSOR()) }
// v5.6.1 Sh.6 Phase 2: carry the tensor element type so multi-dim index
// lowering can pick between __mn_tensor_get_f64_nd and _i64_nd. Resolves
// to the same `ptr` at the LLVM layer — args are inspected only by
// lowering, not by resolve_mir_type.
fn mir_tensor_of(elem: MIRType) -> MIRType:
    let mut t: MIRType = new_mir_type("Tensor", TK_TENSOR())
    t.args.push(elem)
    t
fn mir_map() -> MIRType { return new_mir_type("Map", TK_MAP()) }
fn mir_signal() -> MIRType { return new_mir_type("Signal", TK_SIGNAL()) }
fn mir_range() -> MIRType { return new_mir_type("Range", TK_RANGE()) }
fn mir_fn_type() -> MIRType { return new_mir_type("<fn>", TK_FN()) }

fn mir_struct(name: String) -> MIRType = new_mir_type(name, TK_STRUCT())

fn mir_enum(name: String) -> MIRType = new_mir_type(name, TK_ENUM())

fn mir_agent(name: String) -> MIRType = new_mir_type(name, TK_AGENT())

// ---------------------------------------------------------------------------
// MIR values — SSA virtual registers
// ---------------------------------------------------------------------------

struct Value:
    name: String
    ty: MIRType

fn new_value(name: String, ty: MIRType) -> Value = new Value { name: name, ty: ty }

fn void_value() -> Value = new_value("%void", mir_void())

// ---------------------------------------------------------------------------
// MIR instructions — encoded as tagged enum
// ---------------------------------------------------------------------------

enum BinOpKind:
    Add, Sub, Mul, Div, Mod
    Eq, Ne, Lt, Gt, Le, Ge
    And, Or

enum UnaryOpKind:
    Neg, Not

enum StreamOpKind:
    Map, Filter, Fold, Take, Skip, Collect

// Field pair for struct init
struct FieldPair:
    name: String
    val: Value

fn new_field_pair(name: String, val: Value) -> FieldPair = new FieldPair { name: name, val: val }

// Key-value pair for map init
struct KVPair:
    key: Value
    val: Value

fn new_kv_pair(key: Value, val: Value) -> KVPair = new KVPair { key: key, val: val }

// Phi incoming entry
struct PhiEntry:
    block_label: String
    val: Value

fn new_phi_entry(label: String, val: Value) -> PhiEntry = new PhiEntry { block_label: label, val: val }

// Switch case entry
struct SwitchCase:
    tag_value: String
    block_label: String

fn new_switch_case(tag: String, label: String) -> SwitchCase = new SwitchCase { tag_value: tag, block_label: label }

enum Instruction:
    // Values
    Const(Value, MIRType, String)
    Copy(Value, Value)
    Cast(Value, Value, MIRType)
    // Arithmetic
    BinOp(Value, BinOpKind, Value, Value)
    UnaryOp(Value, UnaryOpKind, Value)
    // Aggregates
    StructInit(Value, MIRType, List<FieldPair>)
    FieldGet(Value, Value, String)
    FieldSet(Value, String, Value)
    ListInit(Value, MIRType, List<Value>)
    TensorInit(Value, MIRType, List<Int>, List<Value>)
    IndexGet(Value, Value, Value)
    IndexSet(Value, Value, Value)
    Alloca(Value, MIRType)
    Load(Value, Value)
    Store(Value, Value)
    MapInit(Value, MIRType, MIRType, List<KVPair>)
    // Enum
    EnumInit(Value, MIRType, String, List<Value>)
    EnumTag(Value, Value)
    EnumPayload(Value, Value, String)
    // Option/Result
    WrapSome(Value, Value)
    WrapNone(Value, MIRType)
    WrapOk(Value, Value)
    WrapErr(Value, Value)
    Unwrap(Value, Value)
    // Functions
    Call(Value, String, List<Value>)
    Return(Option<Value>)
    // Control flow
    Jump(String)
    Branch(Value, String, String)
    Switch(Value, List<SwitchCase>, String)
    // Agents
    AgentSpawn(Value, MIRType, List<Value>)
    AgentSend(Value, String, Value)
    AgentSync(Value, Value, String)
    // Signals
    SignalInit(Value, MIRType, Value)
    SignalGet(Value, Value)
    SignalSet(Value, Value)
    // Streams
    StreamOp(Value, StreamOpKind, Value, List<Value>)
    // Strings
    InterpConcat(Value, List<Value>)
    // SSA
    Phi(Value, List<PhiEntry>)
    // v5.4.0 Own.1 Phase 2 — ownership transfer marker (no dest)
    Move(Value)
    // v5.5.1 Sh.4 Phase 2 — coroutine suspension + block-on wait.
    // AwaitSuspend(dest, future): inside an async fn, suspend until the
    // future is ready, then extract T. The emitter (v5.5.2) lowers to
    // coro.save + coro.suspend + switch + fast-path readiness check.
    // BlockOn(dest, future): outside an async fn (e.g. main), drive the
    // coroutine to completion via __mn_coro_scheduler_run, then extract T.
    AwaitSuspend(Value, Value)
    BlockOn(Value, Value)

// ---------------------------------------------------------------------------
// Basic block
// ---------------------------------------------------------------------------

struct BasicBlock:
    label: String
    instructions: List<Instruction>

fn new_basic_block(label: String) -> BasicBlock:
    let instrs: List<Instruction> = []
    new BasicBlock { label: label, instructions: instrs }

fn is_terminator(inst: Instruction) -> Bool:
    match inst:
        Jump(_) => { return true }
        Branch(_, _, _) => { return true }
        Switch(_, _, _) => { return true }
        Return(_) => { return true }
        _ => { return false }

fn block_terminated(bb: BasicBlock) -> Bool:
    if len(bb.instructions) == 0 { return false }
    let last: Instruction = bb.instructions[len(bb.instructions) - 1]
    return is_terminator(last)

// ---------------------------------------------------------------------------
// MIR function
// ---------------------------------------------------------------------------

struct MIRParam:
    name: String
    ty: MIRType

fn new_mir_param(name: String, ty: MIRType) -> MIRParam = new MIRParam { name: name, ty: ty }

struct MIRFunction:
    name: String
    params: List<MIRParam>
    return_type: MIRType
    blocks: List<BasicBlock>
    decorators: List<String>
    is_public: Bool

fn new_mir_function(name: String, params: List<MIRParam>, ret: MIRType, decorators: List<String>, is_public: Bool) -> MIRFunction:
    let blocks: List<BasicBlock> = []
    new MIRFunction { name: name, params: params, return_type: ret, blocks: blocks, decorators: decorators, is_public: is_public }

// ---------------------------------------------------------------------------
// MIR module
// ---------------------------------------------------------------------------

struct StructInfo:
    name: String
    fields: List<FieldPair>

fn new_struct_info(name: String, fields: List<FieldPair>) -> StructInfo = new StructInfo { name: name, fields: fields }

struct EnumVariantInfo:
    name: String
    payload_types: List<MIRType>

fn new_enum_variant_info(name: String, types: List<MIRType>) -> EnumVariantInfo = new EnumVariantInfo { name: name, payload_types: types }

struct EnumInfo:
    name: String
    variants: List<EnumVariantInfo>

fn new_enum_info(name: String, variants: List<EnumVariantInfo>) -> EnumInfo = new EnumInfo { name: name, variants: variants }

struct ExternFnInfo:
    abi: String
    module_name: String
    fn_name: String
    param_types: List<MIRType>
    return_type: MIRType

fn new_extern_fn_info(abi: String, module_name: String, fn_name: String, params: List<MIRType>, ret: MIRType) -> ExternFnInfo = new ExternFnInfo { abi: abi, module_name: module_name, fn_name: fn_name, param_types: params, return_type: ret }

struct AgentInfo:
    name: String
    inputs: List<String>
    outputs: List<String>
    method_names: List<String>

fn new_agent_info(name: String, inputs: List<String>, outputs: List<String>, methods: List<String>) -> AgentInfo = new AgentInfo { name: name, inputs: inputs, outputs: outputs, method_names: methods }

struct PipeInfo:
    name: String
    stages: List<String>

fn new_pipe_info(name: String, stages: List<String>) -> PipeInfo = new PipeInfo { name: name, stages: stages }

struct ImportInfo:
    path: List<String>
    items: List<String>

fn new_import_info(path: List<String>, items: List<String>) -> ImportInfo = new ImportInfo { path: path, items: items }

struct ModuleConst:
    name: String
    type_name: String
    int_value: Int
    str_value: String
    is_string: Bool

fn new_module_const_int(name: String, type_name: String, value: Int) -> ModuleConst = new ModuleConst { name: name, type_name: type_name, int_value: value, str_value: "", is_string: false }

fn new_module_const_str(name: String, type_name: String, value: String) -> ModuleConst = new ModuleConst { name: name, type_name: type_name, int_value: 0, str_value: value, is_string: true }

struct MIRModule:
    name: String
    functions: List<MIRFunction>
    structs: List<StructInfo>
    enums: List<EnumInfo>
    extern_fns: List<ExternFnInfo>
    agents: List<AgentInfo>
    pipes: List<PipeInfo>
    imports: List<ImportInfo>
    trait_names: List<String>
    consts: List<ModuleConst>

fn new_mir_module(name: String) -> MIRModule:
    let functions: List<MIRFunction> = []
    let structs: List<StructInfo> = []
    let enums: List<EnumInfo> = []
    let extern_fns: List<ExternFnInfo> = []
    let agents: List<AgentInfo> = []
    let pipes: List<PipeInfo> = []
    let imports: List<ImportInfo> = []
    let trait_names: List<String> = []
    let consts: List<ModuleConst> = []
    return new MIRModule { name: name, functions: functions, structs: structs, enums: enums, extern_fns: extern_fns, agents: agents, pipes: pipes, imports: imports, trait_names: trait_names, consts: consts }

// ---------------------------------------------------------------------------
// Variable tracking
// ---------------------------------------------------------------------------

struct VarInfo:
    name: String
    current: Value
    mutable: Bool

fn new_var_info(name: String, val: Value, mutable: Bool) -> VarInfo = new VarInfo { name: name, current: val, mutable: mutable }

// Impl method mapping: "Type.method" -> "Type_method"
struct ImplEntry:
    key: String
    mir_name: String

fn new_impl_entry(key: String, mir_name: String) -> ImplEntry = new ImplEntry { key: key, mir_name: mir_name }

// Struct field names and types mapping
struct StructFieldInfo:
    name: String
    field_names: List<String>
    field_types: List<MIRType>

fn new_struct_field_info(name: String, fields: List<String>, types: List<MIRType>) -> StructFieldInfo = new StructFieldInfo { name: name, field_names: fields, field_types: types }

// Enum variant names mapping
struct EnumVariantNames:
    enum_name: String
    variant_names: List<String>

fn new_enum_variant_names(name: String, variants: List<String>) -> EnumVariantNames = new EnumVariantNames { enum_name: name, variant_names: variants }

// Lambda variable mapping
struct LambdaEntry:
    var_name: String
    fn_name: String

fn new_lambda_entry(var_name: String, fn_name: String) -> LambdaEntry = new LambdaEntry { var_name: var_name, fn_name: fn_name }

// ---------------------------------------------------------------------------
// Enum-to-string conversion (used by emit_llvm.mn and pretty-printer)
// ---------------------------------------------------------------------------

pub fn binop_kind_to_str(op: BinOpKind) -> String:
    match op:
        Add => { return "add" }
        Sub => { return "sub" }
        Mul => { return "mul" }
        Div => { return "div" }
        Mod => { return "mod" }
        Eq => { return "eq" }
        Ne => { return "ne" }
        Lt => { return "lt" }
        Gt => { return "gt" }
        Le => { return "le" }
        Ge => { return "ge" }
        And => { return "and" }
        Or => { return "or" }

pub fn unaryop_kind_to_str(op: UnaryOpKind) -> String:
    match op:
        Neg => { return "neg" }
        Not => { return "not" }

pub fn streamop_kind_to_str(op: StreamOpKind) -> String:
    match op:
        Map => { return "map" }
        Filter => { return "filter" }
        Fold => { return "fold" }
        Take => { return "take" }
        Skip => { return "skip" }
        Collect => { return "collect" }

// ---------------------------------------------------------------------------
// String-tagged dispatch: instr_kind + field accessors
// These functions use match WITHIN mir.mn (same module as the Instruction
// enum), so enum tags are always correct regardless of which compiler
// produced this binary.  Consumers in other modules (emit_llvm.mn,
// lower.mn) call these instead of matching on Instruction directly.
// ---------------------------------------------------------------------------

pub fn instr_kind(i: Instruction) -> String:
    match i:
        Const(_, _, _) => { return "const" }
        Copy(_, _) => { return "copy" }
        Cast(_, _, _) => { return "cast" }
        BinOp(_, _, _, _) => { return "binop" }
        UnaryOp(_, _, _) => { return "unaryop" }
        StructInit(_, _, _) => { return "struct_init" }
        FieldGet(_, _, _) => { return "field_get" }
        FieldSet(_, _, _) => { return "field_set" }
        ListInit(_, _, _) => { return "list_init" }
        TensorInit(_, _, _, _) => { return "tensor_init" }
        IndexGet(_, _, _) => { return "index_get" }
        IndexSet(_, _, _) => { return "index_set" }
        Alloca(_, _) => { return "alloca" }
        Load(_, _) => { return "load" }
        Store(_, _) => { return "store" }
        MapInit(_, _, _, _) => { return "map_init" }
        EnumInit(_, _, _, _) => { return "enum_init" }
        EnumTag(_, _) => { return "enum_tag" }
        EnumPayload(_, _, _) => { return "enum_payload" }
        WrapSome(_, _) => { return "wrap_some" }
        WrapNone(_, _) => { return "wrap_none" }
        WrapOk(_, _) => { return "wrap_ok" }
        WrapErr(_, _) => { return "wrap_err" }
        Unwrap(_, _) => { return "unwrap" }
        Call(_, _, _) => { return "call" }
        Return(_) => { return "return" }
        Jump(_) => { return "jump" }
        Branch(_, _, _) => { return "branch" }
        Switch(_, _, _) => { return "switch" }
        AgentSpawn(_, _, _) => { return "agent_spawn" }
        AgentSend(_, _, _) => { return "agent_send" }
        AgentSync(_, _, _) => { return "agent_sync" }
        SignalInit(_, _, _) => { return "signal_init" }
        SignalGet(_, _) => { return "signal_get" }
        SignalSet(_, _) => { return "signal_set" }
        StreamOp(_, _, _, _) => { return "stream_op" }
        InterpConcat(_, _) => { return "interp_concat" }
        Phi(_, _) => { return "phi" }
        Move(_) => { return "move" }
        AwaitSuspend(_, _) => { return "await_suspend" }
        BlockOn(_, _) => { return "block_on" }

// --- Instruction field accessors ---
// Each function extracts one field from a specific variant (or group of
// variants).  The _ => default is never reached when callers check
// instr_kind() first.

pub fn instr_dest(i: Instruction) -> Value:
    match i:
        Const(d, _, _) => { return d }
        Copy(d, _) => { return d }
        Cast(d, _, _) => { return d }
        BinOp(d, _, _, _) => { return d }
        UnaryOp(d, _, _) => { return d }
        StructInit(d, _, _) => { return d }
        FieldGet(d, _, _) => { return d }
        ListInit(d, _, _) => { return d }
        TensorInit(d, _, _, _) => { return d }
        IndexGet(d, _, _) => { return d }
        Alloca(d, _) => { return d }
        Load(d, _) => { return d }
        MapInit(d, _, _, _) => { return d }
        EnumInit(d, _, _, _) => { return d }
        EnumTag(d, _) => { return d }
        EnumPayload(d, _, _) => { return d }
        WrapSome(d, _) => { return d }
        WrapNone(d, _) => { return d }
        WrapOk(d, _) => { return d }
        WrapErr(d, _) => { return d }
        Unwrap(d, _) => { return d }
        Call(d, _, _) => { return d }
        AgentSpawn(d, _, _) => { return d }
        AgentSync(d, _, _) => { return d }
        SignalInit(d, _, _) => { return d }
        SignalGet(d, _) => { return d }
        StreamOp(d, _, _, _) => { return d }
        InterpConcat(d, _) => { return d }
        Phi(d, _) => { return d }
        AwaitSuspend(d, _) => { return d }
        BlockOn(d, _) => { return d }
        _ => { return void_value() }

