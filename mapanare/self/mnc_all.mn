// v5.5.1 Sh.4 Phase 2: scan the function's decorators for "async".
// The parser stashes `async fn` as a decorator per parser.mn:797-798;
// this is the authoritative check for "is this a coroutine function"
// that the emitter will use in v5.5.2 when wrapping the function body
// with coro.id/coro.begin/initial-suspend.
pub fn fn_is_async(f: MIRFunction) -> Bool:
    let mut i: Int = 0
    for _ in 0..512:
        if i >= len(f.decorators) { return false }
        if f.decorators[i] == "async" { return true }
        i = i + 1
    return false

// ===== lower_state.mn =====
// lower_state.mn — Lowerer state, scope management, lookups, and type resolution.
// Extracted from lower.mn to reduce file size and share lookup utilities.


// ---------------------------------------------------------------------------
// Lowerer state — threaded through all lowering functions
// ---------------------------------------------------------------------------

struct LowerState:
    module: MIRModule
    current_fn: Option<MIRFunction>
    current_block_idx: Int
    tmp_counter: Int
    block_counter: Int
    vars: List<VarInfo>
    scope_stack: List<Int>
    impl_methods: List<ImplEntry>
    struct_fields: List<StructFieldInfo>
    enum_variants: List<EnumVariantNames>
    lambda_vars: List<LambdaEntry>
    fn_blocks: List<BasicBlock>
    generic_fns: List<FnDefData>
    generic_structs: List<StructDefData>
    generic_enums: List<EnumDefData>
    loop_header_label: String
    loop_exit_label: String
    // v5.15.1 — type-hint plumbing for comprehension lowering. lower_let
    // sets this before lowering a Comprehension RHS so the synthesizer
    // can thread the user's `List<T>` / `Map<K, V>` annotation onto the
    // internal accumulator. Cleared on entry to the synthesizer so
    // nested comprehensions don't accidentally inherit it.
    comp_type_hint: Option<TypeExpr>
    // v5.20.1 Te.5.F.C/D — counter for synthesized base/destructure tmp
    // names (`__mn_base_N`, `__mn_dst_N`). Separate from `tmp_counter`
    // so synthesized base tmps don't perturb the global `%tN` sequence,
    // keeping IR byte-identical to the manual long form. Reset per fn.
    struct_update_counter: Int
    // v5.21.0 Te.6 — counter for synthesized chained-compare temp names
    // (`__mn_chain_N`). Same rationale as `struct_update_counter`. Reset
    // per fn alongside the others.
    chain_compare_counter: Int

fn new_lower_state(module_name: String) -> LowerState:
    let module: MIRModule = new_mir_module(module_name)
    let vars: List<VarInfo> = []
    let scope_stack: List<Int> = []
    let impl_methods: List<ImplEntry> = []
    let struct_fields: List<StructFieldInfo> = []
    let enum_variants: List<EnumVariantNames> = []
    let lambda_vars: List<LambdaEntry> = []
    let fn_blocks: List<BasicBlock> = []
    let generic_fns: List<FnDefData> = []
    let generic_structs: List<StructDefData> = []
    let generic_enums: List<EnumDefData> = []
    return new LowerState { module: module, current_fn: none, current_block_idx: 0, tmp_counter: 0, block_counter: 0, vars: vars, scope_stack: scope_stack, impl_methods: impl_methods, struct_fields: struct_fields, enum_variants: enum_variants, lambda_vars: lambda_vars, fn_blocks: fn_blocks, generic_fns: generic_fns, generic_structs: generic_structs, generic_enums: generic_enums, loop_header_label: "", loop_exit_label: "", comp_type_hint: none, struct_update_counter: 0, chain_compare_counter: 0 }

// Lower result: value + updated state
struct LowerResult:
    value: Value
    state: LowerState

fn new_lower_result(val: Value, st: LowerState) -> LowerResult = new LowerResult { value: val, state: st }

// ---------------------------------------------------------------------------
// Name generation
// ---------------------------------------------------------------------------

fn fresh_tmp(st: LowerState, prefix: String) -> LowerResult:
    let name: String = "%" + prefix + toString(st.tmp_counter)
    let mut new_st: LowerState = st
    new_st.tmp_counter = st.tmp_counter + 1
    let val: Value = new_value(name, mir_unknown())
    new_lower_result(val, new_st)

fn fresh_block_label(st: LowerState, prefix: String) -> LowerResult:
    let name: String = prefix + toString(st.block_counter)
    let mut new_st: LowerState = st
    new_st.block_counter = st.block_counter + 1
    let val: Value = new_value(name, mir_unknown())
    new_lower_result(val, new_st)

fn make_value(st: LowerState, ty: MIRType, prefix: String) -> LowerResult:
    let r: LowerResult = fresh_tmp(st, prefix)
    let val: Value = new_value(r.value.name, ty)
    new_lower_result(val, r.state)

// ---------------------------------------------------------------------------
// Block management
// ---------------------------------------------------------------------------

fn add_block(st: LowerState, label: String) -> LowerState:
    let bb: BasicBlock = new_basic_block(label)
    let mut new_st: LowerState = st
    let idx: Int = len(st.fn_blocks)
    let mut blocks: List<BasicBlock> = new_st.fn_blocks
    blocks.push(bb)
    new_st.fn_blocks = blocks
    new_st.current_block_idx = idx
    return new_st

fn is_some_fn(opt: Option<MIRFunction>) -> Bool:
    match opt:
        Some(_) => { return true }
        _ => { return false }

fn set_block(st: LowerState, idx: Int) -> LowerState:
    let mut new_st: LowerState = st
    new_st.current_block_idx = idx
    new_st

fn emit_instr(st: LowerState, instr: Instruction) -> LowerState:
    // Append instruction to current block using flattened fn_blocks list.
    // Extract → modify → reassign to handle COW write-back correctly.
    let mut new_st: LowerState = st
    let idx: Int = st.current_block_idx
    if idx >= 0:
        if idx < len(st.fn_blocks):
            let bb: BasicBlock = st.fn_blocks[idx]
            let mut instrs: List<Instruction> = bb.instructions
            instrs.push(instr)
            let new_bb: BasicBlock = new BasicBlock { label: bb.label, instructions: instrs }
            let mut blocks: List<BasicBlock> = new_st.fn_blocks
            blocks[idx] = new_bb
            new_st.fn_blocks = blocks
    new_st

fn current_block_terminated(st: LowerState) -> Bool:
    let idx: Int = st.current_block_idx
    if idx >= 0:
        if idx < len(st.fn_blocks):
            let bb: BasicBlock = st.fn_blocks[idx]
            return block_terminated(bb)
    return true

// ---------------------------------------------------------------------------
// Scope management
// ---------------------------------------------------------------------------

fn lower_push_scope(st: LowerState) -> LowerState:
    // Save the current variable count. On pop, truncate vars back to this length.
    let mut new_st: LowerState = st
    let var_count: Int = len(st.vars)
    let mut stack: List<Int> = new_st.scope_stack
    stack.push(var_count)
    new_st.scope_stack = stack
    new_st

fn lower_pop_scope(st: LowerState) -> LowerState:
    let mut new_st: LowerState = st
    if len(st.scope_stack) > 0:
        let saved_len: Int = st.scope_stack[len(st.scope_stack) - 1]
        // Truncate vars back to the saved length
        // (removes variables defined in the inner scope)
        let mut restored: List<VarInfo> = []
        let mut i: Int = 0
        let nv: Int = len(st.vars)
        for _ in 0..2000:
            if i < saved_len:
                if i < nv:
                    restored.push(st.vars[i])
                    i = i + 1
        new_st.vars = restored
    new_st

fn define_var(st: LowerState, name: String, val: Value, mutable: Bool) -> LowerState:
    let mut new_st: LowerState = st
    let vi: VarInfo = new_var_info(name, val, mutable)
    let mut vs: List<VarInfo> = new_st.vars
    vs.push(vi)
    new_st.vars = vs
    new_st

fn lookup_var(st: LowerState, name: String) -> Option<Value>:
    let mut i: Int = len(st.vars) - 1
    for _ in 0..2000:
        if i < 0 { return none }
        let v: VarInfo = st.vars[i]
        if v.name == name { return Some(v.current) }
        i = i - 1
    return none

fn update_var(st: LowerState, name: String, val: Value) -> LowerState:
    let mut new_st: LowerState = st
    let mut i: Int = len(st.vars) - 1
    for _ in 0..2000:
        if i < 0 { return new_st }
        let v: VarInfo = st.vars[i]
        if v.name == name:
            let updated: VarInfo = new_var_info(name, val, v.mutable)
            st.vars[i] = updated
            return new_st
        i = i - 1
    return new_st

// ---------------------------------------------------------------------------
// Lookup helpers
// ---------------------------------------------------------------------------

fn find_struct_fields(st: LowerState, name: String) -> Option<List<String>>:
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(st.struct_fields) { return none }
        let sf: StructFieldInfo = st.struct_fields[i]
        if sf.name == name { return Some(sf.field_names) }
        i = i + 1
    return none

fn is_struct_name(st: LowerState, name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(st.struct_fields) { return false }
        let sf: StructFieldInfo = st.struct_fields[i]
        if sf.name == name { return true }
        i = i + 1
    return false

fn get_struct_field_names(st: LowerState, name: String) -> List<String>:
    let mut i: Int = 0
    let nsf: Int = len(st.struct_fields)
    for _ in 0..2000:
        if i < nsf:
            let sf: StructFieldInfo = st.struct_fields[i]
            if sf.name == name { return sf.field_names }
            i = i + 1
    let empty: List<String> = []
    return empty

fn find_enum_variants(st: LowerState, name: String) -> Option<List<String>>:
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(st.enum_variants) { return none }
        let ev: EnumVariantNames = st.enum_variants[i]
        if ev.enum_name == name { return Some(ev.variant_names) }
        i = i + 1
    return none

fn is_variant_of_enum(st: LowerState, enum_name: String, variant: String) -> Bool:
    let mut i: Int = 0
    let nev0: Int = len(st.enum_variants)
    for _ in 0..2000:
        if i < nev0:
            let ev: EnumVariantNames = st.enum_variants[i]
            if ev.enum_name == enum_name:
                let mut j: Int = 0
                let nvn0: Int = len(ev.variant_names)
                for _ in 0..2000:
                    if j < nvn0:
                        if ev.variant_names[j] == variant { return true }
                        j = j + 1
                return false
            i = i + 1
    return false

fn is_enum_variant(st: LowerState, name: String) -> Bool:
    let mut i: Int = 0
    let nev: Int = len(st.enum_variants)
    for _ in 0..2000:
        if i < nev:
            let ev: EnumVariantNames = st.enum_variants[i]
            let mut j: Int = 0
            let nvn: Int = len(ev.variant_names)
            for _ in 0..2000:
                if j < nvn:
                    let vn: String = ev.variant_names[j]
                    if vn == name { return true }
                    j = j + 1
            i = i + 1
    return false

fn variant_index(st: LowerState, variant: String) -> Int:
    let mut i: Int = 0
    let nev2: Int = len(st.enum_variants)
    for _ in 0..2000:
        if i < nev2:
            let ev: EnumVariantNames = st.enum_variants[i]
            let mut j: Int = 0
            let nvn2: Int = len(ev.variant_names)
            for _ in 0..2000:
                if j < nvn2:
                    if ev.variant_names[j] == variant { return j }
                    j = j + 1
            i = i + 1
    return 0

fn enum_name_for_variant(st: LowerState, variant: String) -> String:
    let mut i: Int = 0
    let nev3: Int = len(st.enum_variants)
    for _ in 0..2000:
        if i < nev3:
            let ev: EnumVariantNames = st.enum_variants[i]
            let mut j: Int = 0
            let nvn3: Int = len(ev.variant_names)
            for _ in 0..2000:
                if j < nvn3:
                    let vn: String = ev.variant_names[j]
                    if vn == variant { return ev.enum_name }
                    j = j + 1
            i = i + 1
    return ""

fn find_impl_method(st: LowerState, type_name: String, method: String) -> Option<String>:
    let key: String = type_name + "." + method
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(st.impl_methods) { return none }
        let e: ImplEntry = st.impl_methods[i]
        if e.key == key { return Some(e.mir_name) }
        i = i + 1
    return none

fn find_lambda(st: LowerState, name: String) -> Option<String>:
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(st.lambda_vars) { return none }
        let e: LambdaEntry = st.lambda_vars[i]
        if e.var_name == name { return Some(e.fn_name) }
        i = i + 1
    return none

// ---------------------------------------------------------------------------
// Type resolution: AST TypeExpr -> MIRType
// ---------------------------------------------------------------------------

fn lower_resolve_type_expr(te: TypeExpr) -> MIRType:
    match te {
        Named(name) => {
            return resolve_type_name(name)
        },
        Generic(name, args) => {
            let mut resolved_args: List<MIRType> = []
            let mut i: Int = 0
            for _ in 0..100 {
                if i >= len(args) {
                    let kind: Int = kind_from_name(name)
                    if kind != TK_UNKNOWN() {
                        return new_mir_type_with_args(name, kind, resolved_args)
                    }
                    return new_mir_type_with_args(name, TK_STRUCT(), resolved_args)
                }
                let arg: TypeExpr = args[i]
                let resolved: MIRType = lower_resolve_type_expr(arg)
                resolved_args.push(resolved)
                i = i + 1
            }
            return mir_unknown()
        },
        FnTy(param_types, return_type) => {
            return mir_fn_type()
        },
        _ => { return mir_unknown() }
    }

fn resolve_type_name(name: String) -> MIRType:
    if name == "Int" { return mir_int() }
    if name == "Float" { return mir_float() }
    if name == "Bool" { return mir_bool() }
    if name == "String" { return mir_string() }
    if name == "Char" { return mir_string() }
    if name == "Void" { return mir_void() }
    if name == "Option" { return mir_option() }
    if name == "Result" { return mir_result() }
    if name == "List" { return mir_list() }
    if name == "Map" { return mir_map() }
    if name == "Signal" { return mir_signal() }
    return mir_struct(name)

// State-aware type resolution: distinguishes structs from enums
fn resolve_type_name_checked(st: LowerState, name: String) -> MIRType:
    if name == "Int" { return mir_int() }
    if name == "Float" { return mir_float() }
    if name == "Bool" { return mir_bool() }
    if name == "String" { return mir_string() }
    if name == "Char" { return mir_string() }
    if name == "Void" { return mir_void() }
    if name == "Option" { return mir_option() }
    if name == "Result" { return mir_result() }
    if name == "List" { return mir_list() }
    if name == "Map" { return mir_map() }
    if name == "Signal" { return mir_signal() }
    // Check if this is a registered enum
    let mut i: Int = 0
    let nev_r: Int = len(st.enum_variants)
    for _ in 0..10000:
        if i < nev_r:
            if st.enum_variants[i].enum_name == name:
                return mir_enum(name)
            i = i + 1
    return mir_struct(name)

fn kind_from_name(name: String) -> Int:
    if name == "Int" { return TK_INT() }
    if name == "Float" { return TK_FLOAT() }
    if name == "Bool" { return TK_BOOL() }
    if name == "String" { return TK_STRING() }
    if name == "Char" { return TK_STRING() }
    if name == "Void" { return TK_VOID() }
    if name == "Option" { return TK_OPTION() }
    if name == "Result" { return TK_RESULT() }
    if name == "List" { return TK_LIST() }
    if name == "Map" { return TK_MAP() }
    if name == "Signal" { return TK_SIGNAL() }
    if name == "Stream" { return TK_STREAM() }
    if name == "Agent" { return TK_AGENT() }
    if name == "Tensor" { return TK_TENSOR() }
    if name == "Range" { return TK_RANGE() }
    return TK_UNKNOWN()

fn lower_resolve_type_opt(te: Option<TypeExpr>) -> MIRType:
    match te:
        Some(t) => { return lower_resolve_type_expr(t) }
        _ => { return mir_unknown() }

fn lower_resolve_type_opt_checked(st: LowerState, te: Option<TypeExpr>) -> MIRType:
    match te:
        Some(t) => { return lower_resolve_type_checked(st, t) }
        _ => { return mir_unknown() }

fn resolve_return_type(te: Option<TypeExpr>) -> MIRType:
    match te:
        Some(t) => { return lower_resolve_type_expr(t) }
        _ => { return mir_void() }

// State-aware type expression resolver (distinguishes enums from structs)
fn resolve_generic_args_rec(st: LowerState, args: List<TypeExpr>, idx: Int, acc: List<MIRType>) -> List<MIRType>:
    if idx >= len(args) { return acc }
    let arg: TypeExpr = args[idx]
    let resolved: MIRType = lower_resolve_type_checked(st, arg)
    acc.push(resolved)
    return resolve_generic_args_rec(st, args, idx + 1, acc)

fn lower_resolve_type_checked(st: LowerState, te: TypeExpr) -> MIRType:
    match te {
        Named(name) => {
            return resolve_type_name_checked(st, name)
        },
        Generic(name, args) => {
            // Use recursion instead of for-loop to avoid the alloca aliasing bug
            let init_args: List<MIRType> = []
            let resolved_args: List<MIRType> = resolve_generic_args_rec(st, args, 0, init_args)
            let kind: Int = kind_from_name(name)
            if kind != TK_UNKNOWN() {
                return new_mir_type_with_args(name, kind, resolved_args)
            }
            let checked: MIRType = resolve_type_name_checked(st, name)
            return new_mir_type_with_args(name, checked.kind, resolved_args)
        },
        FnTy(param_types, return_type) => {
            return mir_fn_type()
        },
        _ => { return mir_unknown() }
    }

fn resolve_return_type_checked(st: LowerState, te: Option<TypeExpr>) -> MIRType:
    match te:
        Some(t) => { return lower_resolve_type_checked(st, t) }
        _ => { return mir_void() }

// ---------------------------------------------------------------------------
// Operator mapping
// ---------------------------------------------------------------------------

fn binop_from_str(op: String) -> Option<BinOpKind>:
    if op == "+" { return Some(BinOpKind::Add) }
    if op == "-" { return Some(BinOpKind::Sub) }
    if op == "*" { return Some(BinOpKind::Mul) }
    if op == "/" { return Some(BinOpKind::Div) }
    if op == "%" { return Some(BinOpKind::Mod) }
    if op == "==" { return Some(BinOpKind::Eq) }
    if op == "!=" { return Some(BinOpKind::Ne) }
    if op == "<" { return Some(BinOpKind::Lt) }
    if op == ">" { return Some(BinOpKind::Gt) }
    if op == "<=" { return Some(BinOpKind::Le) }
    if op == ">=" { return Some(BinOpKind::Ge) }
    if op == "&&" { return Some(BinOpKind::And) }
    if op == "||" { return Some(BinOpKind::Or) }
    return none

fn unaryop_from_str(op: String) -> Option<UnaryOpKind>:
    if op == "-" { return Some(UnaryOpKind::Neg) }
    if op == "!" { return Some(UnaryOpKind::Not) }
    return none

fn stream_op_from_str(name: String) -> Option<StreamOpKind>:
    if name == "map" { return Some(StreamOpKind::Map) }
    if name == "filter" { return Some(StreamOpKind::Filter) }
    if name == "fold" { return Some(StreamOpKind::Fold) }
    if name == "take" { return Some(StreamOpKind::Take) }
    if name == "skip" { return Some(StreamOpKind::Skip) }
    if name == "collect" { return Some(StreamOpKind::Collect) }
    return none

fn is_comparison_binop(op: BinOpKind) -> Bool:
    match op:
        Eq => { return true }
        Ne => { return true }
        Lt => { return true }
        Gt => { return true }
        Le => { return true }
        Ge => { return true }
        And => { return true }
        Or => { return true }
        _ => { return false }

fn kind_to_type_name(kind: Int) -> String:
    if kind == TK_INT() { return "Int" }
    if kind == TK_FLOAT() { return "Float" }
    if kind == TK_BOOL() { return "Bool" }
    if kind == TK_STRING() { return "String" }
    if kind == TK_CHAR() { return "Char" }
    if kind == TK_VOID() { return "Void" }
    if kind == TK_LIST() { return "List" }
    if kind == TK_MAP() { return "Map" }
    return "Int"

// binop_kind_to_str and unaryop_kind_to_str live in mir.mn (near the enums they convert)

// ===== lower.mn =====
// lower.mn — AST → MIR lowering pass for the Mapanare self-hosted compiler.
// Core lowering logic: declaration registration, definition lowering,
// expression/statement lowering, control flow, pretty-printer, verifier.
//
// Data structures (MIRType, Value, Instruction, etc.) are in mir.mn.
// State management (LowerState, lookups, type resolution) is in lower_state.mn.


// ---------------------------------------------------------------------------
// Declaration registration (Pass 1)
// ---------------------------------------------------------------------------

fn register_declarations(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    // Pass 1: register enums first so struct field types can distinguish enum vs struct
    s = register_declarations_pass1(s, program)
    // Pass 2: register structs, impls, functions, imports
    s = register_declarations_pass2(s, program)
    s

// Pass 1: register enums. Extracted to helper to use return-based loop exit.
fn register_declarations_pass1(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(program.definitions) { return s }
        let defn: Definition = program.definitions[i]
        // Use register_enum_if_enum to avoid match PHI zeroinitializer bug
        s = register_enum_if_enum(s, defn)
        i = i + 1
    return s

// If defn is EnumDef, register it. Generic enums are deferred.
fn register_enum_if_enum(st: LowerState, defn: Definition) -> LowerState:
    if def_kind(defn) == "enum_def":
        let ed: EnumDefData = def_enum_data(defn)
        if len(ed.type_params) > 0:
            let mut new_st_ge: LowerState = st
            let mut ge_list: List<EnumDefData> = new_st_ge.generic_enums
            ge_list.push(ed)
            new_st_ge.generic_enums = ge_list
            return new_st_ge
        return register_enum(st, ed)
    return st

// Pass 2: register non-enum definitions. Extracted for return-based exit.
fn register_declarations_pass2(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(program.definitions) { return s }
        let defn: Definition = program.definitions[i]
        s = register_nonenums(s, defn)
        i = i + 1
    return s

// If defn is NOT EnumDef, register it. Otherwise return state unchanged.
fn register_nonenums(st: LowerState, defn: Definition) -> LowerState:
    if def_kind(defn) == "enum_def" { return st }
    return register_definition(st, defn)

fn register_definition(st: LowerState, defn: Definition) -> LowerState:
    let dk: String = def_kind(defn)
    if dk == "struct_def":
        let sd: StructDefData = def_struct_data(defn)
        if len(sd.type_params) > 0:
            let mut new_st_gs: LowerState = st
            let mut gs_list: List<StructDefData> = new_st_gs.generic_structs
            gs_list.push(sd)
            new_st_gs.generic_structs = gs_list
            return new_st_gs
        return register_struct(st, sd)
    if dk == "enum_def":
        let ed: EnumDefData = def_enum_data(defn)
        if len(ed.type_params) > 0:
            let mut new_st_ge: LowerState = st
            let mut ge_list: List<EnumDefData> = new_st_ge.generic_enums
            ge_list.push(ed)
            new_st_ge.generic_enums = ge_list
            return new_st_ge
        return register_enum(st, ed)
    if dk == "impl_def":
        let impl_target: String = def_impl_target(defn)
        // Check if target is a generic struct — if so, store methods for later monomorphization
        let gs_check: Option<StructDefData> = find_generic_struct(st, impl_target)
        match gs_check {
            Some(gs_data) => {
                // Store each method in generic_fns with target prefix and struct's type_params
                let mut s_gi: LowerState = st
                let gi_methods: List<FnDefData> = def_impl_methods(defn)
                let mut gi: Int = 0
                for _ in 0..500 {
                    if gi >= len(gi_methods) { return s_gi }
                    let gm: FnDefData = gi_methods[gi]
                    // Create a copy with prefixed name and struct type params
                    let prefixed_name: String = impl_target + "_" + gm.name
                    let impl_fn: FnDefData = new_fn_def_data(gm.span, prefixed_name, false, gs_data.type_params, gm.params, gm.return_type, gm.body, gm.decorators)
                    let mut gfn_list: List<FnDefData> = s_gi.generic_fns
                    gfn_list.push(impl_fn)
                    s_gi.generic_fns = gfn_list
                    gi = gi + 1
                }
                return s_gi
            },
            _ => { return register_impl(st, impl_target, def_impl_methods(defn)) }
        }
    if dk == "import_def":
        let info: ImportInfo = new_import_info(def_import_path(defn), def_import_items(defn))
        let mut new_st_imp: LowerState = st
        let mut mod_tmp: MIRModule = new_st_imp.module
        let mut imp_list: List<ImportInfo> = mod_tmp.imports
        imp_list.push(info)
        mod_tmp.imports = imp_list
        new_st_imp.module = mod_tmp
        return new_st_imp
    if dk == "export_def":
        let inner_opt: Option<Definition> = def_export_inner(defn)
        match inner_opt:
            Some(inner) => { return register_definition(st, inner) }
            _ => { return st }
    if dk == "fn_def":
        let fd: FnDefData = def_fn_data(defn)
        // Store generic functions for on-demand monomorphization
        if len(fd.type_params) > 0:
            let mut new_st_gen: LowerState = st
            let mut gfns: List<FnDefData> = new_st_gen.generic_fns
            gfns.push(fd)
            new_st_gen.generic_fns = gfns
            return new_st_gen
        // Register function return type via lambda_vars (top-level list,
        // properly COW-cloned). Using "__ret__fn_name" as the key.
        // This avoids the nested MIRModule.functions COW corruption issue.
        let ret_ty: MIRType = resolve_return_type_checked(st, fd.return_type)
        let ret_key: String = "__ret__" + fd.name
        let ret_val: String = tk_name(ret_ty.kind) + ":" + ret_ty.name
        let entry: LambdaEntry = new_lambda_entry(ret_key, ret_val)
        let mut new_st_fn: LowerState = st
        let mut lv_fn: List<LambdaEntry> = new_st_fn.lambda_vars
        lv_fn.push(entry)
        new_st_fn.lambda_vars = lv_fn
        return new_st_fn
    if dk == "extern_fn_def":
        return register_extern_fn(st, defn)
    if dk == "let_def":
        return register_module_let(st, defn)
    // v4.55.0: const_def — register same as let_def for lowering
    if dk == "const_def":
        return register_module_const(st, defn)
    return st

fn register_module_let(st: LowerState, defn: Definition) -> LowerState:
    let name: String = def_let_name(defn)
    let type_name: String = def_let_type(defn)
    let value_expr: Expr = def_let_value(defn)
    let ek: String = expr_kind(value_expr)
    let mut s: LowerState = st
    let mut mod_tmp: MIRModule = s.module
    let mut consts_list: List<ModuleConst> = mod_tmp.consts
    let mut lv: List<LambdaEntry> = s.lambda_vars
    if ek == "int_lit":
        let iv: Int = expr_int_val(value_expr)
        let mc: ModuleConst = new_module_const_int(name, type_name, iv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "int:" + toString(iv))
        lv.push(entry)
    if ek == "string_lit":
        let sv: String = expr_string_val(value_expr)
        let mc: ModuleConst = new_module_const_str(name, type_name, sv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "string:" + sv)
        lv.push(entry)
    if ek == "float_lit":
        let mc: ModuleConst = new_module_const_int(name, type_name, 0)
        consts_list.push(mc)
    if ek == "bool_lit":
        let bv: Int = 0
        if expr_bool_val(value_expr) { let bv: Int = 1 }
        let mc: ModuleConst = new_module_const_int(name, type_name, bv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "bool:" + toString(bv))
        lv.push(entry)
    mod_tmp.consts = consts_list
    s.module = mod_tmp
    s.lambda_vars = lv
    return s

// v4.55.0: const lowering — same as let but uses ConstDef accessors
fn register_module_const(st: LowerState, defn: Definition) -> LowerState:
    let name: String = def_const_name(defn)
    let te: TypeExpr = def_const_type_expr(defn)
    let type_name: String = type_expr_name(te)
    let value_expr: Expr = def_const_value(defn)
    let ek: String = expr_kind(value_expr)
    let mut s: LowerState = st
    let mut mod_tmp: MIRModule = s.module
    let mut consts_list: List<ModuleConst> = mod_tmp.consts
    let mut lv: List<LambdaEntry> = s.lambda_vars
    if ek == "int_lit":
        let iv: Int = expr_int_val(value_expr)
        let mc: ModuleConst = new_module_const_int(name, type_name, iv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "int:" + toString(iv))
        lv.push(entry)
    if ek == "string_lit":
        let sv: String = expr_string_val(value_expr)
        let mc: ModuleConst = new_module_const_str(name, type_name, sv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "string:" + sv)
        lv.push(entry)
    if ek == "float_lit":
        let mc: ModuleConst = new_module_const_int(name, type_name, 0)
        consts_list.push(mc)
    if ek == "bool_lit":
        let bv: Int = 0
        if expr_bool_val(value_expr) { let bv: Int = 1 }
        let mc: ModuleConst = new_module_const_int(name, type_name, bv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "bool:" + toString(bv))
        lv.push(entry)
    mod_tmp.consts = consts_list
    s.module = mod_tmp
    s.lambda_vars = lv
    return s

fn register_extern_fn(st: LowerState, defn: Definition) -> LowerState:
    let abi: String = def_extern_abi(defn)
    let fn_name: String = def_extern_name(defn)
    let params: List<Param> = def_extern_params(defn)
    let ret_opt: Option<TypeExpr> = def_extern_return_type(defn)

    // Resolve return type
    let ret_ty: MIRType = resolve_return_type_checked(st, ret_opt)

    // Register function return type in lambda_vars (for call resolution)
    let ret_key: String = "__ret__" + fn_name
    let ret_val: String = tk_name(ret_ty.kind) + ":" + ret_ty.name
    let entry: LambdaEntry = new_lambda_entry(ret_key, ret_val)
    let mut s: LowerState = st
    let mut lv: List<LambdaEntry> = s.lambda_vars
    lv.push(entry)
    s.lambda_vars = lv

    // Resolve parameter types
    let mut param_types: List<MIRType> = []
    let mut i: Int = 0
    for _ in 0..50:
        if i >= len(params):
            // Push ExternFnInfo to module.extern_fns
            let info: ExternFnInfo = new_extern_fn_info(abi, "", fn_name, param_types, ret_ty)
            let mut mod_tmp: MIRModule = s.module
            let mut ext_list: List<ExternFnInfo> = mod_tmp.extern_fns
            ext_list.push(info)
            mod_tmp.extern_fns = ext_list
            s.module = mod_tmp
            return s
        let p: Param = params[i]
        match p.type_annotation {
            Some(te) => {
                param_types.push(lower_resolve_type_checked(s, te))
            },
            _ => {
                param_types.push(mir_unknown())
            }
        }
        i = i + 1

    // Fallback: push whatever we have
    let info_fb: ExternFnInfo = new_extern_fn_info(abi, "", fn_name, param_types, ret_ty)
    let mut mod_fb: MIRModule = s.module
    let mut ext_fb: List<ExternFnInfo> = mod_fb.extern_fns
    ext_fb.push(info_fb)
    mod_fb.extern_fns = ext_fb
    s.module = mod_fb
    return s

fn register_struct(st: LowerState, data: StructDefData) -> LowerState:
    let mut fields: List<FieldPair> = []
    let mut field_names: List<String> = []
    let mut field_types: List<MIRType> = []
    let mut i: Int = 0
    let mut s: LowerState = st

    for _ in 0..500:
        if i >= len(data.fields):
            let info: StructInfo = new_struct_info(data.name, fields)
            s.module = module_push_struct(s.module, info)
            let sfi: StructFieldInfo = new_struct_field_info(data.name, field_names, field_types)
            let mut sf_lst: List<StructFieldInfo> = s.struct_fields
            sf_lst.push(sfi)
            s.struct_fields = sf_lst
            // Own.1 (v5.1.3): clear moved-ownership locals.
            // Mirrors Cb.7 pattern at monomorphize sites (lines 1795-1798).
            // fields/field_names/field_types ownership moved into module via
            // info and sfi. Zero headers so future drop-glue won't double-free.
            fields = []
            field_names = []
            field_types = []
            return s
        let field: StructField = data.fields[i]
        let fty: MIRType = lower_resolve_type_checked(s, field.type_annotation)
        let fp: FieldPair = new_field_pair(field.name, new_value("", fty))
        fields.push(fp)
        field_names.push(field.name)
        field_types.push(fty)
        i = i + 1
    return s

fn register_enum(st: LowerState, data: EnumDefData) -> LowerState:
    let mut variants: List<EnumVariantInfo> = []
    let mut variant_names: List<String> = []
    let mut i: Int = 0
    let mut s: LowerState = st

    for _ in 0..500:
        if i >= len(data.variants):
            let info: EnumInfo = new_enum_info(data.name, variants)
            s.module = module_push_enum(s.module, info)
            let evn: EnumVariantNames = new_enum_variant_names(data.name, variant_names)
            let mut ev_lst: List<EnumVariantNames> = s.enum_variants
            ev_lst.push(evn)
            s.enum_variants = ev_lst
            // Own.1 (v5.1.3): clear moved-ownership locals.
            // Mirrors Cb.7 pattern at monomorphize sites (lines 1997-1998).
            // variants/variant_names ownership moved into module via
            // info and evn. Zero headers so future drop-glue won't double-free.
            variants = []
            variant_names = []
            return s
        let variant: EnumVariant = data.variants[i]
        let mut payload_types: List<MIRType> = []
        let mut j: Int = 0
        for _ in 0..100:
            if j < len(variant.fields):
                let fty: MIRType = lower_resolve_type_expr(variant.fields[j])
                payload_types.push(fty)
                j = j + 1
        let vi: EnumVariantInfo = new_enum_variant_info(variant.name, payload_types)
        variants.push(vi)
        variant_names.push(variant.name)
        i = i + 1
    return s

fn register_impl(st: LowerState, target: String, methods: List<FnDefData>) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(methods) { return s }
        let method: FnDefData = methods[i]
        let key: String = target + "." + method.name
        let mir_name: String = target + "_" + method.name
        let entry: ImplEntry = new_impl_entry(key, mir_name)
        let mut im_lst: List<ImplEntry> = s.impl_methods
        im_lst.push(entry)
        s.impl_methods = im_lst
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// Definition lowering (Pass 2)
// ---------------------------------------------------------------------------

fn lower_definitions(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(program.definitions):
            return s
        let defn: Definition = program.definitions[i]
        let new_s: LowerState = lower_definition(s, defn)
        s = new_s
        i = i + 1
    return s

fn lower_definition(st: LowerState, defn: Definition) -> LowerState:
    let dk: String = def_kind(defn)
    if dk == "fn_def":
        let fd: FnDefData = def_fn_data(defn)
        if len(fd.type_params) > 0 { return st }
        return lower_fn(st, fd, "")
    if dk == "agent_def":
        return lower_agent(st, def_agent_data(defn))
    if dk == "impl_def":
        let impl_tgt: String = def_impl_target(defn)
        // Skip generic impls — methods lowered on demand via struct monomorphization
        let gs_lower: Option<StructDefData> = find_generic_struct(st, impl_tgt)
        match gs_lower:
            Some(_) => { return st }
            _ => { return lower_impl(st, impl_tgt, def_impl_methods(defn)) }
    if dk == "export_def":
        let inner_opt: Option<Definition> = def_export_inner(defn)
        match inner_opt {
            Some(inner) => {
                let s: LowerState = lower_definition(st, inner)
                return s
            },
            _ => { return st }
        }
    return st

// ---------------------------------------------------------------------------
// Function lowering
// ---------------------------------------------------------------------------

// Helper: build MIR params from FnDefData.params (helper for clarity)
fn build_mir_params(st: LowerState, fn_params: List<Param>) -> List<MIRParam>:
    let mut params: List<MIRParam> = []
    let mut pi: Int = 0
    for _ in 0..500:
        if pi >= len(fn_params) { return params }
        let p: Param = fn_params[pi]
        let pty: MIRType = lower_resolve_type_opt_checked(st, p.type_annotation)
        let mp: MIRParam = new_mir_param(p.name, pty)
        params.push(mp)
        pi = pi + 1
    return params

// Helper: collect decorator names (helper for clarity)
fn collect_decorator_names(decorators: List<Decorator>) -> List<String>:
    let mut names: List<String> = []
    let mut dix: Int = 0
    for _ in 0..100:
        if dix >= len(decorators) { return names }
        let dec: Decorator = decorators[dix]
        names.push(dec.name)
        dix = dix + 1
    return names

// Helper: bind params as variables in entry block (helper for clarity)
fn bind_fn_params(st: LowerState, fn_params: List<Param>) -> LowerState:
    let mut s: LowerState = st
    let mut bi: Int = 0
    for _ in 0..500:
        if bi >= len(fn_params) { return s }
        let p: Param = fn_params[bi]
        let pty: MIRType = lower_resolve_type_opt_checked(s, p.type_annotation)
        let addr_name: String = "%" + p.name + ".addr"
        let addr: Value = new_value(addr_name, pty)
        let param_val: Value = new_value("%" + p.name, pty)
        s = emit_instr(s, Instruction::Alloca(addr, pty))
        s = emit_instr(s, Instruction::Store(addr, param_val))
        s = define_var(s, p.name, addr, false)
        bi = bi + 1
    return s

fn lower_fn(st: LowerState, fn_def: FnDefData, name_prefix: String) -> LowerState:
    let fn_name: String = name_prefix + fn_def.name

    // Build params and decorators using helpers (helper for clarity)
    let params: List<MIRParam> = build_mir_params(st, fn_def.params)
    let ret_type: MIRType = resolve_return_type_checked(st, fn_def.return_type)
    let decorators: List<String> = collect_decorator_names(fn_def.decorators)

    let mir_fn: MIRFunction = new_mir_function(fn_name, params, ret_type, decorators, fn_def.public)

    // Save state
    let prev_fn: Option<MIRFunction> = st.current_fn
    let prev_block_idx: Int = st.current_block_idx
    let prev_tmp: Int = st.tmp_counter
    let prev_blk_cnt: Int = st.block_counter
    let prev_vars: List<VarInfo> = st.vars
    let prev_blocks: List<BasicBlock> = st.fn_blocks

    let mut s: LowerState = st
    s.current_fn = Some(mir_fn)
    s.tmp_counter = 0
    s.block_counter = 0
    // v5.20.1 Te.5.F — reset synthesized-base counter per fn so
    // `__mn_base_N` / `__mn_dst_N` numbering restarts at 0 each function.
    s.struct_update_counter = 0
    // v5.21.0 Te.6 — reset chained-compare temp counter per fn.
    s.chain_compare_counter = 0
    let fresh_vars: List<VarInfo> = []
    s.vars = fresh_vars
    let fresh_blocks: List<BasicBlock> = []
    s.fn_blocks = fresh_blocks

    // Create entry block
    s = add_block(s, "entry")
    s = set_block(s, 0)

    // Bind params as variables
    let mut bi: Int = 0
    s = bind_fn_params(s, fn_def.params)

    // Lower body
    let body_r: LowerResult = lower_block(s, fn_def.body)
    s = body_r.state

    // Add implicit return if block isn't terminated
    if !current_block_terminated(s):
        if ret_type.kind == TK_VOID():
            s = emit_instr(s, Instruction::Return(none))
        else:
            s = emit_instr(s, Instruction::Return(Some(body_r.value)))

    // Copy fn_blocks into MIRFunction and add to module.
    let mut final_fn: MIRFunction = mir_fn
    final_fn.blocks = s.fn_blocks
    s.module = module_push_function(s.module, final_fn)

    // Restore state
    s.current_fn = prev_fn
    s.current_block_idx = prev_block_idx
    s.tmp_counter = prev_tmp
    s.block_counter = prev_blk_cnt
    s.vars = prev_vars
    s.fn_blocks = prev_blocks

    return s

fn lower_agent(st: LowerState, data: AgentDefData) -> LowerState:
    let mut s: LowerState = st
    let mut method_names: List<String> = []

    // Lower each method
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(data.methods):
            let inputs: List<String> = extract_agent_input_names(data)
            let outputs: List<String> = extract_agent_output_names(data)
            let info: AgentInfo = new_agent_info(data.name, inputs, outputs, method_names)
            s.module = module_push_agent(s.module, info)
            return s
        let method: FnDefData = data.methods[i]
        s = lower_fn(s, method, data.name + "_")
        let method_mir_name: String = data.name + "_" + method.name
        method_names.push(method_mir_name)
        i = i + 1
    return s

fn extract_agent_input_names(data: AgentDefData) -> List<String>:
    let mut names: List<String> = []
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(data.inputs) { return names }
        let inp: AgentInput = data.inputs[i]
        names.push(inp.name)
        i = i + 1
    return names

fn extract_agent_output_names(data: AgentDefData) -> List<String>:
    let mut names: List<String> = []
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(data.outputs) { return names }
        let out: AgentOutput = data.outputs[i]
        names.push(out.name)
        i = i + 1
    return names

fn lower_impl(st: LowerState, target: String, methods: List<FnDefData>) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(methods) { return s }
        let method: FnDefData = methods[i]
        // Fix self parameter type: inject target struct type for untyped "self"
        let fixed: FnDefData = fix_self_param_type(method, target)
        s = lower_fn(s, fixed, target + "_")
        i = i + 1
    return s

fn fix_self_param_type(method: FnDefData, target: String) -> FnDefData:
    if len(method.params) == 0 { return method }
    let first: Param = method.params[0]
    if first.name != "self" { return method }
    // Check if self already has a type annotation
    match first.type_annotation:
        Some(_) => { return method }
        _ => {}
    // Inject target struct type for self
    let self_type: TypeExpr = TypeExpr::Named(target)
    let fixed_self: Param = new Param { span: first.span, name: "self", type_annotation: Some(self_type) }
    let mut new_params: List<Param> = []
    new_params.push(fixed_self)
    for pi in 1..len(method.params):
        new_params.push(method.params[pi])
    return new_fn_def_data(method.span, method.name, method.public, method.type_params, new_params, method.return_type, method.body, method.decorators)

// ---------------------------------------------------------------------------
// Block / statement lowering
// ---------------------------------------------------------------------------

fn lower_block(st: LowerState, block: Block) -> LowerResult:
    let s: LowerState = lower_push_scope(st)
    // Use helper to iterate statements (avoids return-inside-if-inside-for bug)
    let r: LowerResult = lower_block_stmts(s, block.stmts)
    let final_s: LowerState = lower_pop_scope(r.state)
    return new_lower_result(r.value, final_s)

// Helper: iterate block statements. Uses return-based exit.
fn lower_block_stmts(st: LowerState, stmts: List<Stmt>) -> LowerResult:
    let mut s: LowerState = st
    let mut last_val: Value = void_value()
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(stmts) { return new_lower_result(last_val, s) }
        if current_block_terminated(s) { return new_lower_result(last_val, s) }
        let stmt: Stmt = stmts[i]
        let r: LowerResult = lower_stmt(s, stmt)
        s = r.state
        last_val = r.value
        i = i + 1
    return new_lower_result(last_val, s)

fn lower_stmt(st: LowerState, stmt: Stmt) -> LowerResult:
    let sk: String = stmt_kind(stmt)
    if sk == "let":
        let s_let: LowerState = lower_let(st, stmt_let_name(stmt), stmt_let_mutable(stmt), stmt_let_type(stmt), stmt_let_value(stmt))
        return new_lower_result(void_value(), s_let)
    if sk == "expr_stmt":
        return lower_expr(st, stmt_expr(stmt))
    if sk == "return":
        let s_ret: LowerState = lower_return(st, stmt_return_val(stmt))
        return new_lower_result(void_value(), s_ret)
    if sk == "for":
        let s_for: LowerState = lower_for(st, stmt_for_var(stmt), stmt_for_iter(stmt), stmt_for_body(stmt))
        return new_lower_result(void_value(), s_for)
    if sk == "while":
        let s_while: LowerState = lower_while(st, stmt_while_cond(stmt), stmt_while_body(stmt))
        return new_lower_result(void_value(), s_while)
    if sk == "break":
        if st.loop_exit_label != "":
            let s_brk: LowerState = emit_instr(st, Instruction::Jump(st.loop_exit_label))
            return new_lower_result(void_value(), s_brk)
        return new_lower_result(void_value(), st)
    if sk == "continue":
        if st.loop_header_label != "":
            let s_cont: LowerState = emit_instr(st, Instruction::Jump(st.loop_header_label))
            return new_lower_result(void_value(), s_cont)
        return new_lower_result(void_value(), st)
    // v5.14.1 B.4: `pass` is a no-op — emit zero MIR.
    if sk == "pass" { return new_lower_result(void_value(), st) }
    if sk == "assert":
        let s_assert: LowerState = lower_assert(st, stmt_assert_expr(stmt), stmt_assert_msg(stmt))
        return new_lower_result(void_value(), s_assert)
    if sk == "signal_decl":
        let s_sig: LowerState = lower_signal_decl(st, stmt_signal_name(stmt), stmt_signal_mutable(stmt), stmt_signal_type(stmt), stmt_signal_value(stmt))
        return new_lower_result(void_value(), s_sig)
    if sk == "stream_decl":
        let s_strm: LowerState = lower_stream_decl(st, stmt_stream_name(stmt), stmt_stream_value(stmt))
        return new_lower_result(void_value(), s_strm)
    // v5.20.1 Te.5.F.D — `let Point { x, y } = expr`.
    if sk == "let_destructure":
        let s_ld: LowerState = lower_let_destructure(st, stmt_letdest_pattern(stmt), stmt_letdest_mutable(stmt), stmt_letdest_type(stmt), stmt_letdest_value(stmt))
        return new_lower_result(void_value(), s_ld)
    // v5.20.1 Te.5.F.E — `let Some(x) = expr else block`.
    if sk == "let_else":
        let s_le: LowerState = lower_let_else(st, stmt_letelse_pattern(stmt), stmt_letelse_scrutinee(stmt), stmt_letelse_else(stmt))
        return new_lower_result(void_value(), s_le)
    // v5.20.1 Te.5.F.E — `while let <pat> = expr block`.
    if sk == "while_let":
        let s_wl: LowerState = lower_while_let(st, stmt_whilelet_pattern(stmt), stmt_whilelet_scrutinee(stmt), stmt_whilelet_body(stmt))
        return new_lower_result(void_value(), s_wl)
    return new_lower_result(void_value(), st)

// ---------------------------------------------------------------------------
// Let binding
// ---------------------------------------------------------------------------

fn lower_let(st_in: LowerState, name: String, mutable: Bool, type_ann: Option<TypeExpr>, value: Expr) -> LowerState:
    // Check if the value expression is a None literal BEFORE lowering.
    // This flag is used later to decide whether to re-wrap with typed WrapNone.
    let mut is_none_literal: Bool = false
    if expr_kind(value) == "none_lit" { is_none_literal = true }

    // v5.15.1 — comprehension type-hint plumbing. When the RHS is a
    // comprehension and the binding has a `List<T>` / `Map<K, V>`
    // annotation, hand it to `lower_comprehension` via the lowerer
    // state so the synthesizer can thread it onto the internal
    // accumulator. Cleared in `lower_comprehension` on entry. Mirror
    // of Python `lower.py::_lower_let` v5.15.0 Te.2.
    let mut st: LowerState = st_in
    if expr_kind(value) == "comprehension":
        match type_ann:
            Some(_) => { st.comp_type_hint = type_ann }
            _ => { st.comp_type_hint = none }
    else:
        st.comp_type_hint = none

    // v5.6.7 Ve.2 fix — empty-list elem_ty propagation. When lowering
    // `let xs: List<T> = []`, the default path `lower_expr → lower_list`
    // can't see the type annotation and emits MIR with
    // `elem_ty.kind=TK_UNKNOWN`. Downstream, `resolve_mir_type` maps
    // UNKNOWN to "i64" and `emit_list_init` allocates 8-byte slots for
    // lists whose elements are 16-byte Strings, 48-byte Params, etc. —
    // silent corruption previously masked by a 384-byte floor. Fix:
    // when value is a list literal AND type_ann is `Generic("List", [T])`,
    // route through `lower_list_typed` so the emitter sees the
    // annotation's element type on `Instruction::ListInit`.
    //
    // v5.6.12 Lk.1 fix — destination passing for List let-bindings.
    // When the hint path applies, pre-compute the var's alloca name
    // and lower the list literal directly into it via
    // `lower_list_typed_into`. Skips the post-emit Alloca + Store pair
    // entirely (those would create a duplicate alloca + useless copy
    // — exactly the alloca-aliasing leak from v5.6.10 Lk.1).
    let hint_elem: MIRType = lower_let_list_hint(st, value, type_ann)
    if hint_elem.kind != TK_UNKNOWN():
        let mut s: LowerState = st
        // Reserve the var's name + alloca BEFORE lowering the value so
        // the ListInit dest (`%<name><M>`) and emit_list_init's derived
        // alloca name (`%<name><M>.addr`) match the var slot.
        let var_base: String = "%" + name + toString(s.tmp_counter)
        let addr_name: String = var_base + ".addr"
        s.tmp_counter = s.tmp_counter + 1

        // Resolve declared val_ty (List<T>). Carries the element-type
        // arg for downstream lookups (e.g. method dispatch).
        let mut val_ty: MIRType = mir_list()
        match type_ann {
            Some(te) => {
                let declared: MIRType = lower_resolve_type_checked(s, te)
                if declared.kind != TK_UNKNOWN() {
                    val_ty = declared
                }
            },
            _ => {}
        }

        // Lower into var_base. The emitter hoists the alloca + zero-init
        // into the entry prelude AND stores the new list into it; no
        // explicit Alloca/Store needed here.
        let r2: LowerResult = lower_list_typed_into(s, expr_list_elements(value), hint_elem, var_base)
        s = r2.state

        // Bind the var to the alloca derived from var_base.
        let addr2: Value = new_value(addr_name, val_ty)
        s = define_var(s, name, addr2, mutable)
        return s

    // v5.6.13 Layer 1 extension — destination passing for struct
    // let-bindings. The parser encodes `let foo: Foo = new Foo {...}`
    // as `Call(Ident("__new_Foo"), [val1, val2, ...])` — see
    // parser.mn::parse_struct_construct. lower_call_by_name unwraps
    // this into `Instruction::StructInit` with a fresh-tmp dest. For
    // a let-binding, route through lower_struct_new_into and use the
    // var's alloca name directly so the emitter's renamed `.addr`
    // scratch (was `.si` pre-v5.6.13) for `%foo<N>` produces
    // `%foo<N>.addr` — the let's binding alloca itself. One alloca
    // instead of (.addr scratch + .addr binding) and one fewer
    // load+store at the let boundary. Same mechanism as v5.6.12's
    // list path; no observable leak in the corpus drives this change
    // (preventive cleanup only).
    if expr_kind(value) == "call":
        let callee_v: Expr = expr_call_callee(value)
        if expr_kind(callee_v) == "ident":
            let callee_name_v: String = expr_ident_name(callee_v)
            if callee_name_v.starts_with("__new_"):
                let struct_name_v: String = callee_name_v.substr(6, len(callee_name_v) - 6)
                // Only non-generic registered structs go through the fast
                // path. Generics need try_monomorphize_struct in
                // lower_call_by_name; let those fall through to the
                // existing path.
                if is_struct_name(st, struct_name_v):
                    let mut s: LowerState = st
                    let var_base: String = "%" + name + toString(s.tmp_counter)
                    let addr_name: String = var_base + ".addr"
                    s.tmp_counter = s.tmp_counter + 1

                    let r2: LowerResult = lower_struct_new_into(s, struct_name_v, expr_call_args(value), var_base)
                    s = r2.state

                    let struct_ty: MIRType = mir_struct(struct_name_v)
                    let addr2: Value = new_value(addr_name, struct_ty)
                    s = define_var(s, name, addr2, mutable)
                    return s

    let r: LowerResult = lower_expr(st, value)
    let mut s: LowerState = r.state

    // Update lambda registration: lower_lambda left var_name empty
    let num_lv: Int = len(s.lambda_vars)
    if num_lv > 0:
        let last_e: LambdaEntry = s.lambda_vars[num_lv - 1]
        if last_e.var_name == "":
            let updated: LambdaEntry = new_lambda_entry(name, last_e.fn_name)
            s.lambda_vars[num_lv - 1] = updated

    // Prefer the declared type annotation over the expression's inferred type.
    // This is critical: function calls return mir_unknown(), but the declared
    // type (e.g., `let ch: String = lexer_peek(source)`) carries the real type.
    let mut val_ty: MIRType = r.value.ty
    let mut val: Value = r.value
    match type_ann {
        Some(te) => {
            let declared: MIRType = lower_resolve_type_checked(s, te)
            if declared.kind != TK_UNKNOWN() {
                val_ty = declared
                // Patch the value to carry the declared type (same SSA name, correct type)
                val = new_value(r.value.name, declared)
            }
        },
        _ => {}
    }

    // Find or create alloca for this variable (use counter for uniqueness
    // when the same variable name appears in different branches)
    let addr_name: String = "%" + name + toString(s.tmp_counter) + ".addr"
    s.tmp_counter = s.tmp_counter + 1

    let addr: Value = new_value(addr_name, val_ty)

    // Emit Alloca with the resolved type
    s = emit_instr(s, Instruction::Alloca(addr, val_ty))

    // For None stored to a typed Option alloca: re-emit WrapNone with the
    // declared type so the value and alloca types match.
    // ONLY do this for actual None literals (value name contains "tnone" or
    // is the WrapNone result), NOT for function call results that happen to
    // have untyped Option return. Check: if the expression was NoneLit, the
    // value name starts with "%t" and has no "_val" (it's a direct constant,
    // not a loaded variable or call result).
    if is_none_literal && val_ty.kind == TK_OPTION() && len(val_ty.args) > 0:
        let typed_none_r: LowerResult = make_value(s, val_ty, "tnone")
        s = emit_instr(typed_none_r.state, Instruction::WrapNone(typed_none_r.value, val_ty))
        val = typed_none_r.value

    // Store value to alloca
    s = emit_instr(s, Instruction::Store(addr, val))

    // Track the alloca address in our variable map
    s = define_var(s, name, addr, mutable)
    return s

// ---------------------------------------------------------------------------
// Return
// ---------------------------------------------------------------------------

fn lower_return(st: LowerState, value_opt: Option<Expr>) -> LowerState:
    match value_opt {
        Some(expr) => {
            let r: LowerResult = lower_expr(st, expr)
            // Return the value directly — no Copy needed.
            // (Avoids `add i64 0, %struct_val` type mismatch for struct returns.)
            return emit_instr(r.state, Instruction::Return(Some(r.value)))
        },
        _ => {
            return emit_instr(st, Instruction::Return(none))
        }
    }

// ---------------------------------------------------------------------------
// For loop
// ---------------------------------------------------------------------------

fn lower_for_map(st: LowerState, var_name: String, map_val: Value, body: Block) -> LowerState:
    let mut s: LowerState = st

    // Get keys list: __mn_map_keys(map_ptr)
    // First extract the map pointer from the {ptr, i64} map value
    let keys_r: LowerResult = make_value(s, mir_list(), "map_keys")
    s = keys_r.state
    let mut keys_args: List<Value> = []
    keys_args.push(map_val)
    s = emit_instr(s, Instruction::Call(keys_r.value, "__mn_map_keys", keys_args))

    // Get key count: len(keys)
    let len_r: LowerResult = make_value(s, mir_int(), "map_len")
    s = len_r.state
    let mut len_args: List<Value> = []
    len_args.push(keys_r.value)
    s = emit_instr(s, Instruction::Call(len_r.value, "len", len_args))

    // Counter alloca
    let counter_addr: Value = new_value("%for_counter" + toString(s.tmp_counter) + ".addr", mir_int())
    s.tmp_counter = s.tmp_counter + 1
    s = emit_instr(s, Instruction::Alloca(counter_addr, mir_int()))
    let zero_r: LowerResult = make_value(s, mir_int(), "zero")
    s = zero_r.state
    s = emit_instr(s, Instruction::Const(zero_r.value, mir_int(), "0"))
    s = emit_instr(s, Instruction::Store(counter_addr, zero_r.value))

    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let header_r: LowerResult = fresh_block_label(s, "mapfor_hdr")
    s = header_r.state
    let header_label: String = header_r.value.name
    s = add_block(s, header_label)
    let header_idx: Int = s.current_block_idx

    let body_r: LowerResult = fresh_block_label(s, "mapfor_body")
    s = body_r.state
    let body_label: String = body_r.value.name
    s = add_block(s, body_label)
    let body_idx: Int = s.current_block_idx

    let exit_r: LowerResult = fresh_block_label(s, "mapfor_exit")
    s = exit_r.state
    let exit_label: String = exit_r.value.name
    s = add_block(s, exit_label)
    let exit_idx: Int = s.current_block_idx

    // Entry → header
    s = set_block(s, entry_idx)
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Header: load counter, compare < len, branch
    s = set_block(s, header_idx)
    let ci: LowerResult = make_value(s, mir_int(), "mapfor_i")
    s = ci.state
    s = emit_instr(s, Instruction::Load(ci.value, counter_addr))
    let cmp: LowerResult = make_value(s, mir_bool(), "mapfor_cmp")
    s = cmp.state
    s = emit_instr(s, Instruction::BinOp(cmp.value, BinOpKind::Lt, ci.value, len_r.value))
    s = emit_instr(s, Instruction::Branch(cmp.value, body_label, exit_label))

    // Body: get key from list, define loop variable, execute body, increment
    s = set_block(s, body_idx)
    // Load current index
    let idx_val: LowerResult = make_value(s, mir_int(), "mapfor_idx")
    s = idx_val.state
    s = emit_instr(s, Instruction::Load(idx_val.value, counter_addr))
    // Get key from keys list: keys[idx]
    let key_r: LowerResult = make_value(s, mir_string(), "mapfor_key")
    s = key_r.state
    let mut get_args: List<Value> = []
    get_args.push(keys_r.value)
    get_args.push(idx_val.value)
    s = emit_instr(s, Instruction::Call(key_r.value, "__list_get_string", get_args))
    // Define loop variable
    let var_addr: LowerResult = make_value(s, mir_string(), var_name + "_addr")
    s = var_addr.state
    s = emit_instr(s, Instruction::Alloca(var_addr.value, mir_string()))
    s = emit_instr(s, Instruction::Store(var_addr.value, key_r.value))
    s = define_var(s, var_name, var_addr.value, false)

    s = lower_push_scope(s)
    let body_result: LowerResult = lower_block(s, body)
    s = body_result.state
    s = lower_pop_scope(s)

    // Increment counter, jump to header
    if !current_block_terminated(s):
        let inc_i: LowerResult = make_value(s, mir_int(), "mapfor_ci")
        s = inc_i.state
        s = emit_instr(s, Instruction::Load(inc_i.value, counter_addr))
        let one_r: LowerResult = make_value(s, mir_int(), "mapfor_one")
        s = one_r.state
        s = emit_instr(s, Instruction::Const(one_r.value, mir_int(), "1"))
        let inc_r: LowerResult = make_value(s, mir_int(), "mapfor_inc")
        s = inc_r.state
        s = emit_instr(s, Instruction::BinOp(inc_r.value, BinOpKind::Add, inc_i.value, one_r.value))
        s = emit_instr(s, Instruction::Store(counter_addr, inc_r.value))
        s = emit_instr(s, Instruction::Jump(header_label))

    s = set_block(s, exit_idx)
    return s

fn lower_for(st: LowerState, var_name: String, iterable: Expr, body: Block) -> LowerState:
    // Lower the iterable (Range expression: start..end, or collection)
    let iter_r: LowerResult = lower_expr(st, iterable)
    let mut s: LowerState = iter_r.state

    // Map iteration: cada key en map → iterate over __mn_map_keys(map)
    if iter_r.value.ty.kind == TK_MAP():
        return lower_for_map(s, var_name, iter_r.value, body)

    // Counter-based loop: use __mn_range_start/end to extract bounds.
    // SSA-based iterator can't mutate, so we use alloca counter.
    let counter_addr: Value = new_value("%for_counter" + toString(s.tmp_counter) + ".addr", mir_int())
    s.tmp_counter = s.tmp_counter + 1
    s = emit_instr(s, Instruction::Alloca(counter_addr, mir_int()))

    // Extract start/end from range via runtime calls
    let start_r: LowerResult = make_value(s, mir_int(), "for_start")
    s = start_r.state
    let mut start_args: List<Value> = []
    start_args.push(iter_r.value)
    s = emit_instr(s, Instruction::Call(start_r.value, "__mn_range_start", start_args))
    let end_r: LowerResult = make_value(s, mir_int(), "for_end")
    s = end_r.state
    let mut end_args: List<Value> = []
    end_args.push(iter_r.value)
    s = emit_instr(s, Instruction::Call(end_r.value, "__mn_range_end", end_args))

    // Store start value to counter
    s = emit_instr(s, Instruction::Store(counter_addr, start_r.value))

    // Save current (entry) block index
    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let header_r2: LowerResult = fresh_block_label(s, "for_header")
    s = header_r2.state
    let header_label: String = header_r2.value.name
    s = add_block(s, header_label)
    let header_idx: Int = s.current_block_idx

    let body_r2: LowerResult = fresh_block_label(s, "for_body")
    s = body_r2.state
    let body_label: String = body_r2.value.name
    s = add_block(s, body_label)
    let body_idx: Int = s.current_block_idx

    let exit_r2: LowerResult = fresh_block_label(s, "for_exit")
    s = exit_r2.state
    let exit_label: String = exit_r2.value.name
    s = add_block(s, exit_label)
    let exit_idx: Int = s.current_block_idx

    // Jump from entry block to header
    s = set_block(s, entry_idx)
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Header block: load counter, compare < end, branch
    s = set_block(s, header_idx)
    let counter_val: LowerResult = make_value(s, mir_int(), "for_i")
    s = counter_val.state
    s = emit_instr(s, Instruction::Load(counter_val.value, counter_addr))
    let cmp_r: LowerResult = make_value(s, mir_bool(), "for_cmp")
    s = cmp_r.state
    s = emit_instr(s, Instruction::BinOp(cmp_r.value, BinOpKind::Lt, counter_val.value, end_r.value))
    s = emit_instr(s, Instruction::Branch(cmp_r.value, body_label, exit_label))

    // Body block: define loop variable, execute body, increment counter
    s = set_block(s, body_idx)
    let loop_addr_r: LowerResult = make_value(s, mir_int(), var_name + "_addr")
    s = loop_addr_r.state
    s = emit_instr(s, Instruction::Alloca(loop_addr_r.value, mir_int()))
    // Load current counter value for the loop variable
    let cur_i: LowerResult = make_value(s, mir_int(), "cur_i")
    s = cur_i.state
    s = emit_instr(s, Instruction::Load(cur_i.value, counter_addr))
    s = emit_instr(s, Instruction::Store(loop_addr_r.value, cur_i.value))
    s = define_var(s, var_name, loop_addr_r.value, false)

    let old_header2: String = s.loop_header_label
    let old_exit2: String = s.loop_exit_label
    s.loop_header_label = header_label
    s.loop_exit_label = exit_label
    s = lower_push_scope(s)
    let body_result: LowerResult = lower_block(s, body)
    s = body_result.state
    s = lower_pop_scope(s)
    s.loop_header_label = old_header2
    s.loop_exit_label = old_exit2

    // Increment counter and jump back to header
    if !current_block_terminated(s):
        let inc_val: LowerResult = make_value(s, mir_int(), "for_inc")
        s = inc_val.state
        let inc_i: LowerResult = make_value(s, mir_int(), "for_ci")
        s = inc_i.state
        s = emit_instr(s, Instruction::Load(inc_i.value, counter_addr))
        let one_r: LowerResult = make_value(s, mir_int(), "one")
        s = one_r.state
        s = emit_instr(s, Instruction::Const(one_r.value, mir_int(), "1"))
        s = emit_instr(s, Instruction::BinOp(inc_val.value, BinOpKind::Add, inc_i.value, one_r.value))
        s = emit_instr(s, Instruction::Store(counter_addr, inc_val.value))
        s = emit_instr(s, Instruction::Jump(header_label))

    // Exit block
    s = set_block(s, exit_idx)
    return s

// ---------------------------------------------------------------------------
// While loop
// ---------------------------------------------------------------------------

fn lower_while(st: LowerState, cond: Expr, body: Block) -> LowerState:
    let mut s: LowerState = st
    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let header_r: LowerResult = fresh_block_label(s, "while_header")
    s = header_r.state
    let header_label: String = header_r.value.name
    s = add_block(s, header_label)
    let header_idx: Int = s.current_block_idx

    let body_r: LowerResult = fresh_block_label(s, "while_body")
    s = body_r.state
    let body_label: String = body_r.value.name
    s = add_block(s, body_label)
    let body_idx: Int = s.current_block_idx

    let exit_r: LowerResult = fresh_block_label(s, "while_exit")
    s = exit_r.state
    let exit_label: String = exit_r.value.name
    s = add_block(s, exit_label)
    let exit_idx: Int = s.current_block_idx

    // Jump from entry to header
    s = set_block(s, entry_idx)
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Header: evaluate condition, branch
    s = set_block(s, header_idx)
    let cond_r: LowerResult = lower_expr(s, cond)
    s = cond_r.state
    s = emit_instr(s, Instruction::Branch(cond_r.value, body_label, exit_label))

    // Body: save loop context, lower body, jump to header
    s = set_block(s, body_idx)
    let old_header: String = s.loop_header_label
    let old_exit: String = s.loop_exit_label
    s.loop_header_label = header_label
    s.loop_exit_label = exit_label
    s = lower_push_scope(s)
    let body_result: LowerResult = lower_block(s, body)
    s = body_result.state
    s = lower_pop_scope(s)
    s.loop_header_label = old_header
    s.loop_exit_label = old_exit
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Exit
    s = set_block(s, exit_idx)
    return s

// ---------------------------------------------------------------------------
// Assert
// ---------------------------------------------------------------------------

fn lower_assert(st: LowerState, cond_expr: Expr, msg: Option<String>) -> LowerState:
    let mut s: LowerState = st
    let cond_r: LowerResult = lower_expr(s, cond_expr)
    s = cond_r.state

    let ok_r: LowerResult = fresh_block_label(s, "assert_ok")
    s = ok_r.state
    let ok_label: String = ok_r.value.name
    s = add_block(s, ok_label)
    let ok_idx: Int = s.current_block_idx

    let fail_r: LowerResult = fresh_block_label(s, "assert_fail")
    s = fail_r.state
    let fail_label: String = fail_r.value.name
    s = add_block(s, fail_label)
    let fail_idx: Int = s.current_block_idx

    // Branch on condition
    let prev_idx: Int = s.current_block_idx
    s = set_block(s, s.current_block_idx - 2)
    s = emit_instr(s, Instruction::Branch(cond_r.value, ok_label, fail_label))

    // Fail block: call __mn_assert_fail. v5.13.1 At.2: pass the
    // user-supplied message (assert COND, "msg") through to the
    // runtime so `mnc test` failure output surfaces something more
    // useful than a bare "assertion failed". Pre-v5.13.1 this was
    // hardcoded to the literal string "assertion failed", which the
    // C side then prefixed with another "assertion failed" — the
    // user message was parsed and dropped.
    s = set_block(s, fail_idx)
    let msg_val: LowerResult = make_value(s, mir_string(), "assert_msg")
    s = msg_val.state
    let mut msg_str: String = ""
    match msg:
        Some(m) => { msg_str = m }
        _ => {}
    s = emit_instr(s, Instruction::Const(msg_val.value, mir_string(), msg_str))
    let mut fail_args: List<Value> = []
    fail_args.push(msg_val.value)
    let fail_ret: LowerResult = make_value(s, mir_void(), "assert_ret")
    s = fail_ret.state
    s = emit_instr(s, Instruction::Call(fail_ret.value, "__mn_assert_fail", fail_args))
    s = emit_instr(s, Instruction::Jump(ok_label))

    // OK block: continue
    s = set_block(s, ok_idx)
    return s

// ---------------------------------------------------------------------------
// Signal / stream declarations
// ---------------------------------------------------------------------------

fn lower_signal_decl(st: LowerState, name: String, mutable: Bool, type_ann: Option<TypeExpr>, value: Expr) -> LowerState:
    let init_r: LowerResult = lower_expr(st, value)
    let sig_type: MIRType = lower_resolve_type_opt(type_ann)
    let dest_r: LowerResult = make_value(init_r.state, mir_signal(), "sig")
    let mut s: LowerState = emit_instr(dest_r.state, Instruction::SignalInit(dest_r.value, sig_type, init_r.value))
    s = define_var(s, name, dest_r.value, mutable)
    s

fn lower_stream_decl(st: LowerState, name: String, value: Expr) -> LowerState:
    let r: LowerResult = lower_expr(st, value)
    define_var(r.state, name, r.value, false)

// ---------------------------------------------------------------------------
// Expression lowering
// ---------------------------------------------------------------------------

fn lower_expr(st: LowerState, expr: Expr) -> LowerResult:
    let ek: String = expr_kind(expr)
    if ek == "int_lit":
        let n: Int = expr_int_val(expr)
        let r_int: LowerResult = make_value(st, mir_int(), "t")
        let s_int: LowerState = emit_instr(r_int.state, Instruction::Const(r_int.value, mir_int(), toString(n)))
        return new_lower_result(r_int.value, s_int)
    if ek == "float_lit":
        let f: Float = expr_float_val(expr)
        let r_flt: LowerResult = make_value(st, mir_float(), "t")
        let s_flt: LowerState = emit_instr(r_flt.state, Instruction::Const(r_flt.value, mir_float(), toString(f)))
        return new_lower_result(r_flt.value, s_flt)
    if ek == "bool_lit":
        let b: Bool = expr_bool_val(expr)
        let r_bool: LowerResult = make_value(st, mir_bool(), "t")
        let mut val_str: String = "false"
        if b { val_str = "true" }
        let s_bool: LowerState = emit_instr(r_bool.state, Instruction::Const(r_bool.value, mir_bool(), val_str))
        return new_lower_result(r_bool.value, s_bool)
    if ek == "string_lit":
        let text: String = expr_string_val(expr)
        let r_str: LowerResult = make_value(st, mir_string(), "t")
        let s_str: LowerState = emit_instr(r_str.state, Instruction::Const(r_str.value, mir_string(), text))
        return new_lower_result(r_str.value, s_str)
    if ek == "char_lit":
        let ch: String = expr_char_val(expr)
        let r_chr: LowerResult = make_value(st, mir_string(), "t")
        let s_chr: LowerState = emit_instr(r_chr.state, Instruction::Const(r_chr.value, mir_string(), ch))
        return new_lower_result(r_chr.value, s_chr)
    if ek == "none_lit":
        let r_none: LowerResult = make_value(st, mir_option(), "t")
        let s_none: LowerState = emit_instr(r_none.state, Instruction::WrapNone(r_none.value, mir_option()))
        return new_lower_result(r_none.value, s_none)
    if ek == "ident":
        return lower_identifier(st, expr_ident_name(expr))
    if ek == "binary":
        return lower_binary(st, expr_binary_left(expr), expr_binary_op(expr), expr_binary_right(expr))
    if ek == "chained_cmp":
        return lower_chained_cmp(st, expr_chained_operands(expr), expr_chained_ops(expr))
    if ek == "unary":
        return lower_unary(st, expr_unary_op(expr), expr_unary_operand(expr))
    if ek == "call":
        return lower_call(st, expr_call_callee(expr), expr_call_args(expr))
    if ek == "method_call":
        return lower_method_call(st, expr_method_obj(expr), expr_method_name(expr), expr_method_args(expr))
    if ek == "field_access":
        return lower_field_access(st, expr_field_obj(expr), expr_field_name(expr))
    if ek == "namespace_access":
        return lower_namespace_access(st, expr_ns_name(expr), expr_ns_member(expr))
    if ek == "index":
        return lower_index(st, expr_index_obj(expr), expr_index_idx(expr))
    if ek == "tensor_index":
        return lower_tensor_index_get(st, expr_ti_obj(expr), expr_ti_indices(expr))
    if ek == "tensor_slice":
        return lower_tensor_slice(st, expr_slice_obj(expr), expr_slice_items(expr))
    if ek == "pipe":
        return lower_pipe(st, expr_pipe_left(expr), expr_pipe_right(expr))
    if ek == "range":
        return lower_range(st, expr_range_start(expr), expr_range_end(expr), expr_range_inclusive(expr))
    if ek == "lambda":
        return lower_lambda(st, expr_lambda_params(expr), expr_lambda_body(expr))
    if ek == "spawn":
        return lower_spawn(st, expr_spawn_callee(expr), expr_spawn_args(expr))
    if ek == "sync":
        return lower_sync(st, expr_sync_inner(expr))
    if ek == "await":
        // v5.5.1 Sh.4 Phase 2: emit AwaitSuspend MIR so the v5.5.2
        // emitter can wrap this in coro.save + coro.suspend + switch.
        // The inner expression evaluates to a Future<T>; dest receives T.
        let inner_r: LowerResult = lower_expr(st, expr_await_inner(expr))
        let dr_aw: LowerResult = make_value(inner_r.state, mir_unknown(), "t")
        let s_aw: LowerState = emit_instr(dr_aw.state, Instruction::AwaitSuspend(dr_aw.value, inner_r.value))
        return new_lower_result(dr_aw.value, s_aw)
    if ek == "send":
        return lower_send(st, expr_send_target(expr), expr_send_value(expr))
    if ek == "error_prop":
        return lower_error_prop(st, expr_errorprop_inner(expr))
    if ek == "list_lit":
        return lower_list(st, expr_list_elements(expr))
    // v5.16.0 Te.4.D — string interpolation. Mirrors
    // mapanare/lower.py::_lower_interp_string. Each non-StringLit part
    // is wrapped in a Cast-to-String (the emitter routes Cast(X→String)
    // to `__mn_str_from_int` / `_float` / `_bool` and emits a tracker
    // for the fresh allocation; Cast(String→String) is an alias).
    // The full chain becomes a single `InterpConcat` MIR instruction.
    if ek == "interp_string":
        return lower_interp_string(st, expr_interp_parts(expr))
    if ek == "tensor_lit":
        return lower_tensor(st, expr_tensor_elements(expr), expr_tensor_shape(expr))
    if ek == "map_lit":
        return lower_map(st, expr_map_entries(expr))
    if ek == "construct":
        return lower_construct(st, expr_construct_name(expr), expr_construct_fields(expr))
    // v5.20.1 Te.5.F.C — struct update: `new T { x: 5, ..base }`.
    if ek == "construct_update":
        return lower_struct_update(st, expr_construct_update_name(expr), expr_construct_update_overrides(expr), expr_construct_update_base(expr))
    // v5.20.1 Te.5.F.E — if-let.
    if ek == "if_let":
        return lower_if_let(st, expr_iflet_pattern(expr), expr_iflet_scrutinee(expr), expr_iflet_then(expr), expr_iflet_else(expr))
    if ek == "some_wrap":
        let inner: Expr = expr_wrap_inner(expr)
        let r_some: LowerResult = lower_expr(st, inner)
        let dr_some: LowerResult = make_value(r_some.state, mir_option(), "t")
        let s_some: LowerState = emit_instr(dr_some.state, Instruction::WrapSome(dr_some.value, r_some.value))
        // v5.4.4 — wrapper takes ownership of the payload.
        let s_some2: LowerState = emit_instr(s_some, Instruction::Move(r_some.value))
        return new_lower_result(dr_some.value, s_some2)
    if ek == "ok_wrap":
        let inner: Expr = expr_wrap_inner(expr)
        let r_ok: LowerResult = lower_expr(st, inner)
        let dr_ok: LowerResult = make_value(r_ok.state, mir_result(), "t")
        let s_ok: LowerState = emit_instr(dr_ok.state, Instruction::WrapOk(dr_ok.value, r_ok.value))
        // v5.4.4 — Ok wrapper owns its payload.
        let s_ok2: LowerState = emit_instr(s_ok, Instruction::Move(r_ok.value))
        return new_lower_result(dr_ok.value, s_ok2)
    if ek == "err_wrap":
        let inner: Expr = expr_wrap_inner(expr)
        let r_err: LowerResult = lower_expr(st, inner)
        let dr_err: LowerResult = make_value(r_err.state, mir_result(), "t")
        let s_err: LowerState = emit_instr(dr_err.state, Instruction::WrapErr(dr_err.value, r_err.value))
        // v5.4.4 — Err wrapper owns its payload.
        let s_err2: LowerState = emit_instr(s_err, Instruction::Move(r_err.value))
        return new_lower_result(dr_err.value, s_err2)
    if ek == "signal_val":
        return lower_signal_expr(st, expr_signal_inner(expr))
    if ek == "assign":
        return lower_assign(st, expr_assign_target(expr), expr_assign_op(expr), expr_assign_value(expr))
    if ek == "if":
        return lower_if(st, expr_if_cond(expr), expr_if_then(expr), expr_if_else(expr))
    if ek == "match":
        return lower_match(st, expr_match_subject(expr), expr_match_arms(expr))
    if ek == "comprehension":
        return lower_comprehension(st, expr)
    // Fallback
    let r_fallback: LowerResult = make_value(st, mir_unknown(), "t")
    return new_lower_result(r_fallback.value, r_fallback.state)

// ---------------------------------------------------------------------------
// Identifier lowering
// ---------------------------------------------------------------------------

fn lower_identifier(st: LowerState, name: String) -> LowerResult:
    // v4.134.0 Sh.12: bare `None` identifier. The lexer keyword
    // `KW_NONE` only matches lowercase `none`/`nada`; capital `None`
    // (used throughout self-hosted `.mn` sources) tokenizes as NAME
    // and parses as Expr::Ident("None"). Without this branch we'd
    // fall through to the "Unknown — emit placeholder" path below,
    // producing a Const(mir_unknown, "") that emit_const refuses to
    // materialise — leaving an undef SSA reference (%None<N>) that
    // breaks llvm-as. Mirror the parser KW_NONE → Expr::NoneLit
    // lowering at line 1196 so both spellings produce identical IR.
    if name == "None":
        let r_none: LowerResult = make_value(st, mir_option(), "tnone")
        let s_none: LowerState = emit_instr(r_none.state, Instruction::WrapNone(r_none.value, mir_option()))
        return new_lower_result(r_none.value, s_none)

    // Check variable scope
    let var_opt: Option<Value> = lookup_var(st, name)
    match var_opt {
        Some(addr) => {
            // var_opt now returns the alloca address. Emit a Load to get the value.
            let r_var: LowerResult = make_value(st, addr.ty, name + "_val")
            let s_var: LowerState = emit_instr(r_var.state, Instruction::Load(r_var.value, addr))
            return new_lower_result(r_var.value, s_var)
        },
        _ => {}
    }

    // Check if it's a module-level constant
    let const_key: String = "__const__" + name
    let const_opt: Option<String> = find_lambda(st, const_key)
    match const_opt {
        Some(const_val) => {
            if const_val.starts_with("int:") {
                let iv_str: String = const_val.substr(4, len(const_val) - 4)
                let r_const: LowerResult = make_value(st, mir_int(), name)
                let s_const: LowerState = emit_instr(r_const.state, Instruction::Const(r_const.value, mir_int(), iv_str))
                return new_lower_result(r_const.value, s_const)
            }
            if const_val.starts_with("string:") {
                let sv: String = const_val.substr(7, len(const_val) - 7)
                let r_const: LowerResult = make_value(st, mir_string(), name)
                let s_const: LowerState = emit_instr(r_const.state, Instruction::Const(r_const.value, mir_string(), sv))
                return new_lower_result(r_const.value, s_const)
            }
            if const_val.starts_with("bool:") {
                let bv_str: String = const_val.substr(5, len(const_val) - 5)
                let r_const: LowerResult = make_value(st, mir_bool(), name)
                let s_const: LowerState = emit_instr(r_const.state, Instruction::Const(r_const.value, mir_bool(), bv_str))
                return new_lower_result(r_const.value, s_const)
            }
        },
        _ => {}
    }

    // Check if it's a bare enum variant (no payload)
    if is_enum_variant(st, name):
        let enum_name: String = enum_name_for_variant(st, name)
        let enum_ty: MIRType = mir_enum(enum_name)
        let r_enum: LowerResult = make_value(st, enum_ty, "t")
        let empty_payload: List<Value> = []
        let s_enum: LowerState = emit_instr(r_enum.state, Instruction::EnumInit(r_enum.value, enum_ty, name, empty_payload))
        return new_lower_result(r_enum.value, s_enum)

    // Unknown — emit placeholder
    let r_unk: LowerResult = make_value(st, mir_unknown(), name)
    let s_unk: LowerState = emit_instr(r_unk.state, Instruction::Const(r_unk.value, mir_unknown(), ""))
    return new_lower_result(r_unk.value, s_unk)

// ---------------------------------------------------------------------------
// Binary expression lowering
// ---------------------------------------------------------------------------

// v5.6.2 Sh.6 Phase 3 — tensor broadcast + scalar binop dispatch.
// Mirrors mapanare/lower.py::_lower_tensor_binop. Routes tensor⊕tensor
// through __mn_tensor_{op}_broadcast_{ty}, tensor⊕scalar through
// _scalar_{ty}, and non-commutative scalar⊕tensor through
// _r{op}_scalar_{ty} (rsub / rdiv twins).
fn tensor_op_suffix(op: String) -> String:
    if op == "+" { return "add" }
    if op == "-" { return "sub" }
    if op == "*" { return "mul" }
    if op == "/" { return "div" }
    return "add"

fn is_tensor_value(v: Value) -> Bool = v.ty.kind == TK_TENSOR()

fn lower_tensor_binop(st: LowerState, op: String, lhs: Value, rhs: Value) -> LowerResult:
    let op_suffix: String = tensor_op_suffix(op)
    let mut tensor_val: Value = lhs
    if !is_tensor_value(lhs) { tensor_val = rhs }
    let elem_kind: Int = tensor_elem_kind_of(tensor_val)
    let mut ty_suffix: String = "f64"
    if elem_kind == TK_INT() { ty_suffix = "i64" }

    let both_tensor: Bool = is_tensor_value(lhs) && is_tensor_value(rhs)
    let mut dest_r: LowerResult = make_value(st, tensor_val.ty, "tbop")
    let mut args: List<Value> = []

    if both_tensor:
        let fn_name: String = "__mn_tensor_" + op_suffix + "_broadcast_" + ty_suffix
        args.push(lhs)
        args.push(rhs)
        let s1: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
        return new_lower_result(dest_r.value, s1)

    if is_tensor_value(lhs):
        // tensor op scalar
        let fn_name_ts: String = "__mn_tensor_" + op_suffix + "_scalar_" + ty_suffix
        args.push(lhs)
        args.push(rhs)
        let s2: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name_ts, args))
        return new_lower_result(dest_r.value, s2)

    // scalar op tensor
    if op == "+" || op == "*":
        // Commutative — forward scalar fn with args swapped
        let fn_name_cs: String = "__mn_tensor_" + op_suffix + "_scalar_" + ty_suffix
        args.push(rhs)
        args.push(lhs)
        let s3: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name_cs, args))
        return new_lower_result(dest_r.value, s3)
    // Non-commutative — reverse scalar fn (rsub / rdiv). Call takes
    // (scalar, tensor) per the Python recipe (emit_llvm_text.py:3781).
    let fn_name_rs: String = "__mn_tensor_r" + op_suffix + "_scalar_" + ty_suffix
    args.push(lhs)
    args.push(rhs)
    let s4: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name_rs, args))
    return new_lower_result(dest_r.value, s4)

fn lower_binary(st: LowerState, left: Expr, op: String, right: Expr) -> LowerResult:
    // Handle pipe operator
    if op == "|>":
        return lower_pipe(st, left, right)

    let lhs_r: LowerResult = lower_expr(st, left)
    let rhs_r: LowerResult = lower_expr(lhs_r.state, right)

    // Type coercion: if one operand is unknown and the other is typed,
    // propagate the known type to the unknown operand.
    let mut lhs_val: Value = lhs_r.value
    let mut rhs_val: Value = rhs_r.value
    if lhs_val.ty.kind == TK_UNKNOWN() && rhs_val.ty.kind != TK_UNKNOWN():
        lhs_val = new_value(lhs_val.name, rhs_val.ty)
    if rhs_val.ty.kind == TK_UNKNOWN() && lhs_val.ty.kind != TK_UNKNOWN():
        rhs_val = new_value(rhs_val.name, lhs_val.ty)

    // v5.6.2 Sh.6 Phase 3 — tensor binop dispatch before generic numeric arm.
    if is_tensor_value(lhs_val) || is_tensor_value(rhs_val):
        if op == "+" || op == "-" || op == "*" || op == "/":
            return lower_tensor_binop(rhs_r.state, op, lhs_val, rhs_val)

    let binop_opt: Option<BinOpKind> = binop_from_str(op)
    match binop_opt {
        Some(binop) => {
            // Use string comparison on the operator (not enum match on BinOpKind)
            // because enum match falls through in the compiled binary
            let is_cmp: Bool = op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "and" || op == "or"
            let mut result_ty: MIRType = lhs_val.ty
            if is_cmp { result_ty = mir_bool() }
            let dr_binop: LowerResult = make_value(rhs_r.state, result_ty, "t")
            let s_binop: LowerState = emit_instr(dr_binop.state, Instruction::BinOp(dr_binop.value, binop, lhs_val, rhs_val))
            return new_lower_result(dr_binop.value, s_binop)
        },
        _ => {
            // Unknown operator — emit as call
            let dr_opcall: LowerResult = make_value(rhs_r.state, mir_unknown(), "t")
            let mut args: List<Value> = []
            args.push(lhs_r.value)
            args.push(rhs_r.value)
            let s_opcall: LowerState = emit_instr(dr_opcall.state, Instruction::Call(dr_opcall.value, "__op_" + op, args))
            return new_lower_result(dr_opcall.value, s_opcall)
        }
    }

// ---------------------------------------------------------------------------
// v5.21.0 Te.6 — chained comparison lowering
// ---------------------------------------------------------------------------

// D4 triviality predicate: trivial = side-effect-free, single-evaluation
// read. Trivial operands skip the temp; everything else gets a temp so
// each operand evaluates exactly once (D3).
fn is_trivial_chain_operand(e: Expr) -> Bool:
    let k: String = expr_kind(e)
    if k == "ident" { return true }
    if k == "int_lit" { return true }
    if k == "float_lit" { return true }
    if k == "bool_lit" { return true }
    if k == "string_lit" { return true }
    if k == "char_lit" { return true }
    if k == "none_lit" { return true }
    return false

// Desugar `a op1 b op2 c op3 d` to
// `(a op1 b) && (b op2 c) && (c op3 d)`. Interior non-trivial operands
// are bound to a synthesized `__mn_chain_N` local before the chain so
// each operand evaluates exactly once. Mirror of
// `mapanare/lower.py::_lower_chained_compare`.
fn lower_chained_cmp(st: LowerState, operands: List<Expr>, ops: List<String>) -> LowerResult:
    let mut s: LowerState = st
    let n: Int = len(operands)
    // Replace non-trivial interior operands with bound temps.
    let mut chain_operands: List<Expr> = []
    let mut i: Int = 0
    for _ in 0..n:
        if i < n:
            chain_operands.push(operands[i])
            i = i + 1
    let mut j: Int = 1
    for _ in 0..n:
        if j < n - 1:
            let sub: Expr = chain_operands[j]
            if !is_trivial_chain_operand(sub):
                let tmp_idx: Int = s.chain_compare_counter
                s.chain_compare_counter = tmp_idx + 1
                let tmp_name: String = "__mn_chain_" + toString(tmp_idx)
                let synth_let: Stmt = Stmt::Let(tmp_name, false, none, sub)
                let let_r: LowerResult = lower_stmt(s, synth_let)
                s = let_r.state
                chain_operands[j] = Expr::Ident(tmp_name)
            j = j + 1
    // Build pairwise BinaryExprs joined by `&&`.
    let nops: Int = len(ops)
    let mut result: Expr = Expr::Binary(chain_operands[0], ops[0], chain_operands[1])
    let mut k: Int = 1
    for _ in 0..nops:
        if k < nops:
            let next_pair: Expr = Expr::Binary(chain_operands[k], ops[k], chain_operands[k + 1])
            result = Expr::Binary(result, "&&", next_pair)
            k = k + 1
    return lower_expr(s, result)

// ---------------------------------------------------------------------------
// Unary expression lowering
// ---------------------------------------------------------------------------

fn resolve_unary_result_type(uop: UnaryOpKind, operand_ty: MIRType) -> MIRType:
    if unaryop_kind_to_str(uop) == "not" { return mir_bool() }
    return operand_ty

fn lower_unary(st: LowerState, op: String, operand: Expr) -> LowerResult:
    let op_r: LowerResult = lower_expr(st, operand)
    let uop_opt: Option<UnaryOpKind> = unaryop_from_str(op)
    match uop_opt {
        Some(uop) => {
            let result_ty: MIRType = resolve_unary_result_type(uop, op_r.value.ty)
            let dr_uop: LowerResult = make_value(op_r.state, result_ty, "t")
            let s_uop: LowerState = emit_instr(dr_uop.state, Instruction::UnaryOp(dr_uop.value, uop, op_r.value))
            return new_lower_result(dr_uop.value, s_uop)
        },
        _ => {
            let dr_ucall: LowerResult = make_value(op_r.state, mir_unknown(), "t")
            let mut args: List<Value> = []
            args.push(op_r.value)
            let s_ucall: LowerState = emit_instr(dr_ucall.state, Instruction::Call(dr_ucall.value, "__unary_" + op, args))
            return new_lower_result(dr_ucall.value, s_ucall)
        }
    }

// ---------------------------------------------------------------------------
// Call lowering
// ---------------------------------------------------------------------------

fn lower_call(st: LowerState, callee: Expr, arg_exprs: List<Expr>) -> LowerResult:
    // Lower all arguments first (guard pattern for clarity)
    let mut s: LowerState = st
    let mut args: List<Value> = []
    let mut i: Int = 0
    let nae: Int = len(arg_exprs)
    for _ in 0..500:
        if i < nae:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            args.push(arg_r.value)
            i = i + 1

    // Dispatch on callee type
    let ck: String = expr_kind(callee)
    if ck == "ident":
        return lower_call_by_name(s, expr_ident_name(callee), args)
    if ck == "field_access":
        // obj.method(args) that parsed as Call(FieldAccess, args)
        let method: String = expr_field_name(callee)
        let obj_r: LowerResult = lower_expr(s, expr_field_obj(callee))
        let dr_meth: LowerResult = make_value(obj_r.state, mir_unknown(), "t")
        let mut all_args: List<Value> = []
        all_args.push(obj_r.value)
        for j in 0..len(args):
            all_args.push(args[j])
        let ns_meth: LowerState = emit_instr(dr_meth.state, Instruction::Call(dr_meth.value, method, all_args))
        return new_lower_result(dr_meth.value, ns_meth)
    if ck == "namespace_access":
        let ns: String = expr_ns_name(callee)
        let member: String = expr_ns_member(callee)
        // Check if this is an enum variant constructor: Enum::Variant(...)
        // Directly check if the namespace enum has this variant (avoids
        // returning the wrong enum when variants share names like Return).
        if is_variant_of_enum(s, ns, member):
            let enum_ty: MIRType = mir_enum(ns)
            let dr_evar: LowerResult = make_value(s, enum_ty, "t")
            let ns_evar: LowerState = emit_instr(dr_evar.state, Instruction::EnumInit(dr_evar.value, enum_ty, member, args))
            // v5.4.4 — enum variant owns its payload values.
            let ns_evar2: LowerState = emit_move_vals(ns_evar, args)
            return new_lower_result(dr_evar.value, ns_evar2)
        // For struct statics like Program::start(defs), try bare function
        // name first (the function is `start`, not `Program_start`).
        return lower_call_by_name(s, member, args)
    // Dynamic call (lambda, etc.)
    let callee_r: LowerResult = lower_expr(s, callee)
    let dr_dyn: LowerResult = make_value(callee_r.state, mir_unknown(), "t")
    let ns_dyn: LowerState = emit_instr(dr_dyn.state, Instruction::Call(dr_dyn.value, callee_r.value.name, args))
    return new_lower_result(dr_dyn.value, ns_dyn)

// ---------------------------------------------------------------------------
// Generics monomorphization
// ---------------------------------------------------------------------------

fn decode_ret_type(encoded: String) -> MIRType:
    if encoded == "" { return mir_unknown() }
    let colon: Int = encoded.find(":")
    if colon < 0 { return mir_unknown() }
    let kind: String = encoded.substr(0, colon)
    let name: String = encoded.substr(colon + 1, len(encoded))
    if kind == "int" { return mir_int() }
    if kind == "float" { return mir_float() }
    if kind == "string" { return mir_string() }
    if kind == "bool" { return mir_bool() }
    if kind == "void" { return mir_void() }
    if kind == "struct" { return mir_struct(name) }
    if kind == "enum" { return mir_enum(name) }
    if kind == "option" { return mir_option() }
    if kind == "result" { return mir_result() }
    if kind == "list" { return mir_list() }
    if kind == "map" { return mir_map() }
    return mir_unknown()

fn find_generic_fn(st: LowerState, name: String) -> Option<FnDefData>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_fns):
            if st.generic_fns[i].name == name { return Some(st.generic_fns[i]) }
            i = i + 1
    return none

fn mangle_generic_name(base: String, arg_types: List<MIRType>) -> String:
    let mut result: String = base + "__"
    let mut i: Int = 0
    for _ in 0..20:
        if i < len(arg_types):
            if i > 0 { result = result + "_" }
            let tk: Int = arg_types[i].kind
            if tk == TK_INT() { result = result + "Int" }
            if tk == TK_FLOAT() { result = result + "Float" }
            if tk == TK_BOOL() { result = result + "Bool" }
            if tk == TK_STRING() { result = result + "String" }
            if tk == TK_STRUCT() { result = result + arg_types[i].name }
            if tk == TK_ENUM() { result = result + arg_types[i].name }
            if tk == TK_LIST() { result = result + "List" }
            if tk == TK_MAP() { result = result + "Map" }
            if tk == TK_OPTION() { result = result + "Option" }
            if tk == TK_RESULT() { result = result + "Result" }
            if tk == TK_VOID() { result = result + "Void" }
            if tk == TK_UNKNOWN() { result = result + "Unknown" }
            i = i + 1
    result

fn infer_type_args_from_call(gfn: FnDefData, arg_types: List<MIRType>) -> List<MIRType>:
    // Build substitution: match type_params[i] against param annotations
    let mut result: List<MIRType> = []
    let ntp: Int = len(gfn.type_params)
    let mut ti: Int = 0
    for _ in 0..20:
        if ti < ntp:
            let tp_name: String = gfn.type_params[ti]
            // Find the first parameter whose type annotation matches this type param
            let mut found: Bool = false
            let mut pi: Int = 0
            for _ in 0..50:
                if pi < len(gfn.params) && !found:
                    let p: Param = gfn.params[pi]
                    match p.type_annotation {
                        Some(ann) => {
                            if type_expr_name(ann) == tp_name {
                                if pi < len(arg_types) {
                                    result.push(arg_types[pi])
                                    found = true
                                }
                            }
                        },
                        _ => {}
                    }
                    pi = pi + 1
            if !found { result.push(mir_unknown()) }
            ti = ti + 1
    result

fn substitute_type_annotation(ann: Option<TypeExpr>, type_params: List<String>, concrete: List<MIRType>) -> Option<TypeExpr>:
    match ann {
        Some(te) => {
            let te_name: String = type_expr_name(te)
            let mut i: Int = 0
            for _ in 0..20 {
                if i < len(type_params) {
                    if type_params[i] == te_name {
                        if i < len(concrete) {
                            // Replace with concrete type name
                            let mut cname: String = concrete[i].name
                            if cname == "" { cname = kind_to_type_name(concrete[i].kind) }
                            return Some(TypeExpr::Named(cname))
                        }
                    }
                    i = i + 1
                }
            }
            return ann
        },
        _ => { return none }
    }

fn specialize_fn(gfn: FnDefData, mangled: String, type_params: List<String>, concrete: List<MIRType>) -> FnDefData:
    // Build new params with substituted type annotations
    let mut new_params: List<Param> = []
    let mut pi: Int = 0
    for _ in 0..50:
        if pi < len(gfn.params):
            let p: Param = gfn.params[pi]
            let new_ann: Option<TypeExpr> = substitute_type_annotation(p.type_annotation, type_params, concrete)
            let np: Param = new Param { span: p.span, name: p.name, type_annotation: new_ann }
            new_params.push(np)
            pi = pi + 1
    // Substitute return type
    let new_ret: Option<TypeExpr> = substitute_type_annotation(gfn.return_type, type_params, concrete)
    let empty_tp: List<String> = []
    return new_fn_def_data(gfn.span, mangled, gfn.public, empty_tp, new_params, new_ret, gfn.body, gfn.decorators)

fn is_already_specialized(st: LowerState, mangled: String) -> Bool:
    // Check if __ret__mangled exists in lambda_vars
    let key: String = "__ret__" + mangled
    match find_lambda(st, key):
        Some(_) => { return true }
        _ => { return false }

fn try_monomorphize_call(st: LowerState, fn_name: String, args: List<Value>) -> LowerResult:
    let gfn_opt: Option<FnDefData> = find_generic_fn(st, fn_name)
    match gfn_opt {
        Some(gfn) => {
            // Infer concrete types from argument types
            let mut arg_types: List<MIRType> = []
            let mut ai: Int = 0
            for _ in 0..50 {
                if ai < len(args) {
                    arg_types.push(args[ai].ty)
                    ai = ai + 1
                }
            }
            let concrete: List<MIRType> = infer_type_args_from_call(gfn, arg_types)
            let mangled: String = mangle_generic_name(fn_name, concrete)

            let mut s: LowerState = st
            if !is_already_specialized(s, mangled) {
                // Specialize and lower the function
                let specialized: FnDefData = specialize_fn(gfn, mangled, gfn.type_params, concrete)
                s = lower_fn(s, specialized, "")
            }

            // Look up return type and emit call
            let ret_key: String = "__ret__" + mangled
            let ret_ty: MIRType = decode_ret_type(unwrap_or_default(find_lambda(s, ret_key), ""))

            let dr: LowerResult = make_value(s, ret_ty, "t")
            let s2: LowerState = emit_instr(dr.state, Instruction::Call(dr.value, mangled, args))
            return new_lower_result(dr.value, s2)
        },
        _ => {
            // Not a generic function — return sentinel
            return new_lower_result(void_value(), st)
        }
    }

fn find_type_param_index(type_params: List<String>, name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..20:
        if i < len(type_params):
            if type_params[i] == name { return i }
            i = i + 1
    return 0 - 1

fn substitute_field_type(st: LowerState, ann: Option<TypeExpr>, type_params: List<String>, concrete: List<MIRType>) -> MIRType:
    let fty: MIRType = lower_resolve_type_opt_checked(st, ann)
    match ann {
        Some(a) => {
            let idx: Int = find_type_param_index(type_params, type_expr_name(a))
            if idx >= 0 {
                if idx < len(concrete) { return concrete[idx] }
            }
            return fty
        },
        _ => { return fty }
    }

fn find_generic_struct(st: LowerState, name: String) -> Option<StructDefData>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_structs):
            if st.generic_structs[i].name == name { return Some(st.generic_structs[i]) }
            i = i + 1
    return none

fn infer_struct_type_args(gs: StructDefData, args: List<Value>) -> List<MIRType>:
    let mut concrete: List<MIRType> = []
    let mut ti: Int = 0
    for _ in 0..20:
        if ti < len(gs.type_params):
            let tp_name: String = gs.type_params[ti]
            let idx: Int = find_struct_field_for_tp(gs, tp_name)
            if idx >= 0:
                if idx < len(args) { concrete.push(args[idx].ty) }
            if idx < 0 { concrete.push(mir_unknown()) }
            ti = ti + 1
    concrete

fn find_struct_field_for_tp(gs: StructDefData, tp_name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..50:
        if i < len(gs.fields):
            if type_expr_name(gs.fields[i].type_annotation) == tp_name { return i }
            i = i + 1
    return 0 - 1

fn try_monomorphize_struct(st: LowerState, struct_name: String, args: List<Value>) -> LowerResult:
    let gs_opt: Option<StructDefData> = find_generic_struct(st, struct_name)
    match gs_opt {
        Some(gs) => {
            let concrete: List<MIRType> = infer_struct_type_args(gs, args)
            let mangled: String = mangle_generic_name(struct_name, concrete)

            let mut s: LowerState = st
            if !is_struct_name(s, mangled) {
                let mut fields: List<FieldPair> = []
                let mut field_names: List<String> = []
                let mut field_types: List<MIRType> = []
                let mut fi: Int = 0
                for _ in 0..500 {
                    if fi < len(gs.fields) {
                        let sf: StructField = gs.fields[fi]
                        let fty: MIRType = substitute_field_type(s, Some(sf.type_annotation), gs.type_params, concrete)
                        fields.push(new_field_pair(sf.name, new_value("", fty)))
                        field_names.push(sf.name)
                        field_types.push(fty)
                        fi = fi + 1
                    }
                }
                let info: StructInfo = new_struct_info(mangled, fields)
                s.module = module_push_struct(s.module, info)
                let sfi: StructFieldInfo = new_struct_field_info(mangled, field_names, field_types)
                let mut sf_lst: List<StructFieldInfo> = s.struct_fields
                sf_lst.push(sfi)
                s.struct_fields = sf_lst
                // Cb.7 (v4.144.0): clear moved-ownership locals.
                fields = []
                field_names = []
                field_types = []

                // Monomorphize generic impl methods for this struct
                s = monomorphize_impl_methods(s, struct_name, mangled, gs.type_params, concrete)
            }
            let fnames: List<String> = get_struct_field_names(s, mangled)
            let mut init_pairs: List<FieldPair> = []
            let mut pi: Int = 0
            for _ in 0..500 {
                if pi < len(fnames) {
                    if pi < len(args) { init_pairs.push(new_field_pair(fnames[pi], args[pi])) }
                    pi = pi + 1
                }
            }
            let struct_ty: MIRType = mir_struct(mangled)
            let dr: LowerResult = make_value(s, struct_ty, "t")
            let s2: LowerState = emit_instr(dr.state, Instruction::StructInit(dr.value, struct_ty, init_pairs))
            // v5.4.4 — StructInit takes ownership of each field value.
            let s3: LowerState = emit_move_fields(s2, init_pairs)
            return new_lower_result(dr.value, s3)
        },
        _ => { return new_lower_result(void_value(), st) }
    }

fn monomorphize_impl_methods(st: LowerState, base_name: String, mangled: String, type_params: List<String>, concrete: List<MIRType>) -> LowerState:
    // Find generic impl methods stored as "Base_method" in generic_fns
    let prefix: String = base_name + "_"
    let prefix_len: Int = len(prefix)
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(s.generic_fns) { return s }
        let gfn: FnDefData = s.generic_fns[i]
        if starts_with(gfn.name, prefix):
            // This is a generic impl method — specialize it
            let method_name: String = substr(gfn.name, prefix_len, len(gfn.name) - prefix_len)
            let mir_name: String = mangled + "_" + method_name
            // Register impl method for dispatch
            let impl_key: String = mangled + "." + method_name
            let entry: ImplEntry = new_impl_entry(impl_key, mir_name)
            let mut im_list: List<ImplEntry> = s.impl_methods
            im_list.push(entry)
            s.impl_methods = im_list
            // Specialize the method
            let specialized: FnDefData = specialize_fn(gfn, mir_name, type_params, concrete)
            // Fix self param type to the monomorphized struct
            let fixed: FnDefData = fix_self_param_type(specialized, mangled)
            // Register return type
            let ret_ty: MIRType = resolve_return_type_checked(s, fixed.return_type)
            let ret_key: String = "__ret__" + mir_name
            let ret_val: String = tk_name(ret_ty.kind) + ":" + ret_ty.name
            let ret_entry: LambdaEntry = new_lambda_entry(ret_key, ret_val)
            let mut lv_list: List<LambdaEntry> = s.lambda_vars
            lv_list.push(ret_entry)
            s.lambda_vars = lv_list
            // Lower the specialized method (name is already set by specialize_fn)
            s = lower_fn(s, fixed, "")
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// Generic enum monomorphization
// ---------------------------------------------------------------------------

fn find_generic_enum(st: LowerState, name: String) -> Option<EnumDefData>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_enums):
            if st.generic_enums[i].name == name { return Some(st.generic_enums[i]) }
            i = i + 1
    return none

fn is_generic_enum_variant(st: LowerState, variant_name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_enums):
            let ge: EnumDefData = st.generic_enums[i]
            let mut j: Int = 0
            for _ in 0..100:
                if j < len(ge.variants):
                    if ge.variants[j].name == variant_name { return true }
                    j = j + 1
            i = i + 1
    return false

fn generic_enum_name_for_variant(st: LowerState, variant_name: String) -> String:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_enums):
            let ge: EnumDefData = st.generic_enums[i]
            let mut j: Int = 0
            for _ in 0..100:
                if j < len(ge.variants):
                    if ge.variants[j].name == variant_name { return ge.name }
                    j = j + 1
            i = i + 1
    return ""

fn find_variant_in_enum(ge: EnumDefData, variant_name: String) -> Option<EnumVariant>:
    let mut i: Int = 0
    for _ in 0..100:
        if i < len(ge.variants):
            if ge.variants[i].name == variant_name { return Some(ge.variants[i]) }
            i = i + 1
    return none

fn infer_enum_type_args(ge: EnumDefData, variant: EnumVariant, args: List<Value>) -> List<MIRType>:
    // Match variant field type annotations against concrete arg types
    let mut concrete: List<MIRType> = []
    let mut ti: Int = 0
    for _ in 0..20:
        if ti < len(ge.type_params):
            let tp_name: String = ge.type_params[ti]
            // Find which variant field uses this type param
            let mut found: Bool = false
            let mut fi: Int = 0
            for _ in 0..100:
                if fi < len(variant.fields):
                    if type_expr_name(variant.fields[fi]) == tp_name:
                        if fi < len(args):
                            concrete.push(args[fi].ty)
                            found = true
                    fi = fi + 1
            if !found { concrete.push(mir_unknown()) }
            ti = ti + 1
    concrete

fn try_monomorphize_enum(st: LowerState, variant_name: String, args: List<Value>) -> LowerResult:
    let enum_name: String = generic_enum_name_for_variant(st, variant_name)
    if len(enum_name) == 0 { return new_lower_result(void_value(), st) }

    let ge_opt: Option<EnumDefData> = find_generic_enum(st, enum_name)
    match ge_opt {
        Some(ge) => {
            let v_opt: Option<EnumVariant> = find_variant_in_enum(ge, variant_name)
            match v_opt {
                Some(variant) => {
                    let concrete: List<MIRType> = infer_enum_type_args(ge, variant, args)
                    let mangled: String = mangle_generic_name(enum_name, concrete)

                    let mut s: LowerState = st
                    if !is_enum_name(s, mangled) {
                        // Monomorphize: create EnumInfo with substituted variant types
                        let mut new_variants: List<EnumVariantInfo> = []
                        let mut new_variant_names: List<String> = []
                        let mut vi: Int = 0
                        for _ in 0..500 {
                            if vi < len(ge.variants) {
                                let orig_v: EnumVariant = ge.variants[vi]
                                let mut payload_types: List<MIRType> = []
                                let mut fi: Int = 0
                                for _ in 0..100 {
                                    if fi < len(orig_v.fields) {
                                        let fty: MIRType = substitute_field_type(s, Some(orig_v.fields[fi]), ge.type_params, concrete)
                                        payload_types.push(fty)
                                        fi = fi + 1
                                    }
                                }
                                let vi_info: EnumVariantInfo = new_enum_variant_info(orig_v.name, payload_types)
                                new_variants.push(vi_info)
                                new_variant_names.push(orig_v.name)
                                vi = vi + 1
                            }
                        }
                        let info: EnumInfo = new_enum_info(mangled, new_variants)
                        s.module = module_push_enum(s.module, info)
                        let evn: EnumVariantNames = new_enum_variant_names(mangled, new_variant_names)
                        let mut ev_lst: List<EnumVariantNames> = s.enum_variants
                        ev_lst.push(evn)
                        s.enum_variants = ev_lst
                        // Ownership of the specialized enum metadata has moved
                        // into the returned state. Clear the local list headers
                        // so the function epilogue does not free the same
                        // buffers while the emitter still needs them.
                        new_variants = []
                        new_variant_names = []
                    }

                    // Emit EnumInit with mangled type name
                    let enum_ty: MIRType = mir_enum(mangled)
                    let dr_enum: LowerResult = make_value(s, enum_ty, "t")
                    let s2: LowerState = emit_instr(dr_enum.state, Instruction::EnumInit(dr_enum.value, enum_ty, variant_name, args))
                    // v5.4.4 — enum variant takes ownership of each arg.
                    let s3: LowerState = emit_move_vals(s2, args)
                    return new_lower_result(dr_enum.value, s3)
                },
                _ => { return new_lower_result(void_value(), st) }
            }
        },
        _ => { return new_lower_result(void_value(), st) }
    }

fn lower_call_by_name(st: LowerState, fn_name: String, args: List<Value>) -> LowerResult:
    // v5.5.1 Sh.4 Phase 2: block_on(future) — drive a coroutine to
    // completion from non-async context (e.g. main). Emit BlockOn MIR
    // so the v5.5.2 emitter can lower to scheduler_register +
    // scheduler_run + coro.destroy + value extraction.  Checked before
    // monomorphization: block_on is a builtin, not a user-defined fn.
    if fn_name == "block_on":
        if len(args) == 1:
            let dr_bo: LowerResult = make_value(st, mir_unknown(), "t")
            let s_bo: LowerState = emit_instr(dr_bo.state, Instruction::BlockOn(dr_bo.value, args[0]))
            return new_lower_result(dr_bo.value, s_bo)

    // Monomorphize generic function calls
    let mono_r: LowerResult = try_monomorphize_call(st, fn_name, args)
    if mono_r.value.name != "%void" { return mono_r }

    // Builtin void functions
    if fn_name == "print":
        let dr_print: LowerResult = make_value(st, mir_void(), "t")
        let s_print: LowerState = emit_instr(dr_print.state, Instruction::Call(dr_print.value, fn_name, args))
        return new_lower_result(dr_print.value, s_print)
    if fn_name == "println":
        let dr_pln: LowerResult = make_value(st, mir_void(), "t")
        let s_pln: LowerState = emit_instr(dr_pln.state, Instruction::Call(dr_pln.value, fn_name, args))
        return new_lower_result(dr_pln.value, s_pln)
    // Builtin conversion functions — set correct MIR return types
    if fn_name == "int":
        let dr_int: LowerResult = make_value(st, mir_int(), "t")
        let s_int: LowerState = emit_instr(dr_int.state, Instruction::Call(dr_int.value, fn_name, args))
        return new_lower_result(dr_int.value, s_int)
    if fn_name == "float":
        let dr_flt: LowerResult = make_value(st, mir_float(), "t")
        let s_flt: LowerState = emit_instr(dr_flt.state, Instruction::Call(dr_flt.value, fn_name, args))
        return new_lower_result(dr_flt.value, s_flt)
    if fn_name == "str" || fn_name == "toString":
        let dr_str: LowerResult = make_value(st, mir_string(), "t")
        let s_str: LowerState = emit_instr(dr_str.state, Instruction::Call(dr_str.value, fn_name, args))
        return new_lower_result(dr_str.value, s_str)
    if fn_name == "len":
        let dr_len: LowerResult = make_value(st, mir_int(), "t")
        let s_len: LowerState = emit_instr(dr_len.state, Instruction::Call(dr_len.value, fn_name, args))
        return new_lower_result(dr_len.value, s_len)

    // Runtime: process + file I/O
    if fn_name == "__mn_argc":
        let dr_argc: LowerResult = make_value(st, mir_int(), "t")
        let s_argc: LowerState = emit_instr(dr_argc.state, Instruction::Call(dr_argc.value, fn_name, args))
        return new_lower_result(dr_argc.value, s_argc)
    if fn_name == "__mn_argv":
        let dr_argv: LowerResult = make_value(st, mir_string(), "t")
        let s_argv: LowerState = emit_instr(dr_argv.state, Instruction::Call(dr_argv.value, fn_name, args))
        return new_lower_result(dr_argv.value, s_argv)
    if fn_name == "__mn_file_read_or_empty":
        let dr_fr: LowerResult = make_value(st, mir_string(), "t")
        let s_fr: LowerState = emit_instr(dr_fr.state, Instruction::Call(dr_fr.value, fn_name, args))
        return new_lower_result(dr_fr.value, s_fr)
    if fn_name == "__mn_exit":
        let dr_exit: LowerResult = make_value(st, mir_void(), "t")
        let s_exit: LowerState = emit_instr(dr_exit.state, Instruction::Call(dr_exit.value, fn_name, args))
        return new_lower_result(dr_exit.value, s_exit)
    if fn_name == "__mn_str_eprint":
        let dr_epr: LowerResult = make_value(st, mir_void(), "t")
        let s_epr: LowerState = emit_instr(dr_epr.state, Instruction::Call(dr_epr.value, fn_name, args))
        return new_lower_result(dr_epr.value, s_epr)
    // v5.8.4 Wb.2: __mn_host_is_win64 returns Int (0 or 1).
    if fn_name == "__mn_host_is_win64":
        let dr_hw: LowerResult = make_value(st, mir_int(), "t")
        let s_hw: LowerState = emit_instr(dr_hw.state, Instruction::Call(dr_hw.value, fn_name, args))
        return new_lower_result(dr_hw.value, s_hw)
    // v5.8.6 We.1: refined (is_windows, arch_bits) pair. Both return Int.
    if fn_name == "__mn_host_is_windows":
        let dr_hwn: LowerResult = make_value(st, mir_int(), "t")
        let s_hwn: LowerState = emit_instr(dr_hwn.state, Instruction::Call(dr_hwn.value, fn_name, args))
        return new_lower_result(dr_hwn.value, s_hwn)
    if fn_name == "__mn_host_arch_bits":
        let dr_hab: LowerResult = make_value(st, mir_int(), "t")
        let s_hab: LowerState = emit_instr(dr_hab.state, Instruction::Call(dr_hab.value, fn_name, args))
        return new_lower_result(dr_hab.value, s_hab)
    // v5.9.0 DX.2 / DX.3 / DX.4: native CLI hygiene exports.
    if fn_name == "__mn_version_string":
        let dr_vs: LowerResult = make_value(st, mir_string(), "t")
        let s_vs: LowerState = emit_instr(dr_vs.state, Instruction::Call(dr_vs.value, fn_name, args))
        return new_lower_result(dr_vs.value, s_vs)
    // v5.14.1 B.5/B.6: colon-block preprocessor — see runtime/native/
    // mapanare_core.c::__mn_indent_to_braces for why this lives in C.
    if fn_name == "__mn_indent_to_braces":
        let dr_itb: LowerResult = make_value(st, mir_string(), "t")
        let s_itb: LowerState = emit_instr(dr_itb.state, Instruction::Call(dr_itb.value, fn_name, args))
        return new_lower_result(dr_itb.value, s_itb)
    // v5.23.2 Te.3.B.2: brace-deprecation detector + warning emitter.
    // Same C-runtime routing as __mn_indent_to_braces.
    if fn_name == "__mn_count_user_brace_block_openers":
        let dr_cubb: LowerResult = make_value(st, mir_int(), "t")
        let s_cubb: LowerState = emit_instr(dr_cubb.state, Instruction::Call(dr_cubb.value, fn_name, args))
        return new_lower_result(dr_cubb.value, s_cubb)
    if fn_name == "__mn_emit_brace_deprecation_warning":
        let dr_ebdw: LowerResult = make_value(st, mir_void(), "t")
        let s_ebdw: LowerState = emit_instr(dr_ebdw.state, Instruction::Call(dr_ebdw.value, fn_name, args))
        return new_lower_result(dr_ebdw.value, s_ebdw)
    if fn_name == "__mn_dev_null_redirect":
        let dr_dn: LowerResult = make_value(st, mir_string(), "t")
        let s_dn: LowerState = emit_instr(dr_dn.state, Instruction::Call(dr_dn.value, fn_name, args))
        return new_lower_result(dr_dn.value, s_dn)
    if fn_name == "__mn_clang_err_path":
        let dr_ce: LowerResult = make_value(st, mir_string(), "t")
        let s_ce: LowerState = emit_instr(dr_ce.state, Instruction::Call(dr_ce.value, fn_name, args))
        return new_lower_result(dr_ce.value, s_ce)
    if fn_name == "__mn_dir_count_files":
        let dr_dcf: LowerResult = make_value(st, mir_int(), "t")
        let s_dcf: LowerState = emit_instr(dr_dcf.state, Instruction::Call(dr_dcf.value, fn_name, args))
        return new_lower_result(dr_dcf.value, s_dcf)
    if fn_name == "__mn_dir_total_size":
        let dr_dts: LowerResult = make_value(st, mir_int(), "t")
        let s_dts: LowerState = emit_instr(dr_dts.state, Instruction::Call(dr_dts.value, fn_name, args))
        return new_lower_result(dr_dts.value, s_dts)
    if fn_name == "__mn_dir_remove_recursive":
        let dr_drr: LowerResult = make_value(st, mir_int(), "t")
        let s_drr: LowerState = emit_instr(dr_drr.state, Instruction::Call(dr_drr.value, fn_name, args))
        return new_lower_result(dr_drr.value, s_drr)
    if fn_name == "__mn_file_exists":
        let dr_fe: LowerResult = make_value(st, mir_int(), "t")
        let s_fe: LowerState = emit_instr(dr_fe.state, Instruction::Call(dr_fe.value, fn_name, args))
        return new_lower_result(dr_fe.value, s_fe)
    // v5.10.0 Win.1b.D: directory of running binary, used by find_clang().
    if fn_name == "__mn_executable_dir":
        let dr_ed: LowerResult = make_value(st, mir_string(), "t")
        let s_ed: LowerState = emit_instr(dr_ed.state, Instruction::Call(dr_ed.value, fn_name, args))
        return new_lower_result(dr_ed.value, s_ed)
    // v5.6.0 Sh.6 — tensor builtin return types. Without these the default
    // mir_unknown resolves to i64 and emit_builtin_tostring would route
    // `str(tensor_get_f64(...))` through __mn_str_from_int with a double
    // arg (type mismatch). tensor_get_f64 must travel as Float.
    if fn_name == "tensor_rank":
        let dr_tr: LowerResult = make_value(st, mir_int(), "t")
        let s_tr: LowerState = emit_instr(dr_tr.state, Instruction::Call(dr_tr.value, fn_name, args))
        return new_lower_result(dr_tr.value, s_tr)
    if fn_name == "tensor_size":
        let dr_ts: LowerResult = make_value(st, mir_int(), "t")
        let s_ts: LowerState = emit_instr(dr_ts.state, Instruction::Call(dr_ts.value, fn_name, args))
        return new_lower_result(dr_ts.value, s_ts)
    if fn_name == "tensor_get_f64":
        let dr_tgf: LowerResult = make_value(st, mir_float(), "t")
        let s_tgf: LowerState = emit_instr(dr_tgf.state, Instruction::Call(dr_tgf.value, fn_name, args))
        return new_lower_result(dr_tgf.value, s_tgf)
    if fn_name == "tensor_get_i64":
        let dr_tgi: LowerResult = make_value(st, mir_int(), "t")
        let s_tgi: LowerState = emit_instr(dr_tgi.state, Instruction::Call(dr_tgi.value, fn_name, args))
        return new_lower_result(dr_tgi.value, s_tgi)
    if fn_name == "tensor_shape_dim":
        let dr_tsd: LowerResult = make_value(st, mir_int(), "t")
        let s_tsd: LowerState = emit_instr(dr_tsd.state, Instruction::Call(dr_tsd.value, fn_name, args))
        return new_lower_result(dr_tsd.value, s_tsd)
    if fn_name == "tensor_print":
        let dr_tp: LowerResult = make_value(st, mir_void(), "t")
        let s_tp: LowerState = emit_instr(dr_tp.state, Instruction::Call(dr_tp.value, fn_name, args))
        return new_lower_result(dr_tp.value, s_tp)

    if fn_name == "chr":
        let dr_chr: LowerResult = make_value(st, mir_string(), "t")
        let s_chr: LowerState = emit_instr(dr_chr.state, Instruction::Call(dr_chr.value, "chr", args))
        return new_lower_result(dr_chr.value, s_chr)
    if fn_name == "ord":
        let dr_ord: LowerResult = make_value(st, mir_int(), "t")
        let s_ord: LowerState = emit_instr(dr_ord.state, Instruction::Call(dr_ord.value, "ord", args))
        return new_lower_result(dr_ord.value, s_ord)

    // Handle Option/Result builtins
    if fn_name == "Some":
        if len(args) == 1:
            let dr_some: LowerResult = make_value(st, mir_option(), "t")
            let s_some: LowerState = emit_instr(dr_some.state, Instruction::WrapSome(dr_some.value, args[0]))
            // v5.4.4 — Some wrapper takes ownership.
            let s_some2: LowerState = emit_instr(s_some, Instruction::Move(args[0]))
            return new_lower_result(dr_some.value, s_some2)
    if fn_name == "Ok":
        if len(args) == 1:
            // Use the function's return type (with generic args) if available
            let mut res_ty_ok: MIRType = mir_result()
            match st.current_fn {
                Some(cf) => {
                    if cf.return_type.kind == TK_RESULT() {
                        res_ty_ok = cf.return_type
                    }
                },
                _ => {}
            }
            // Eu.2 (v5.26.1): if no enclosing Result type was found, default
            // args to <ok_arg_ty, String> mirroring mapanare/lower.py:2398.
            // Without this, dest.ty.args is empty and emit_wrap_ok's outer
            // type falls back to {i1, {ptr, ptr}} while inner uses the real
            // ok type — three disagreeing insertvalue widths in one chain.
            if len(res_ty_ok.args) < 2:
                let mut ok_arg_ty: MIRType = args[0].ty
                if ok_arg_ty.kind == TK_UNKNOWN() { ok_arg_ty = mir_int() }
                res_ty_ok = new_mir_type_with_args("Result", TK_RESULT(), [ok_arg_ty, mir_string()])
            let dr_ok: LowerResult = make_value(st, res_ty_ok, "t")
            let s_ok: LowerState = emit_instr(dr_ok.state, Instruction::WrapOk(dr_ok.value, args[0]))
            // v5.4.4 — Ok wrapper takes ownership.
            let s_ok2: LowerState = emit_instr(s_ok, Instruction::Move(args[0]))
            return new_lower_result(dr_ok.value, s_ok2)
    if fn_name == "Err":
        if len(args) == 1:
            let mut res_ty_err: MIRType = mir_result()
            match st.current_fn {
                Some(cf) => {
                    if cf.return_type.kind == TK_RESULT() {
                        res_ty_err = cf.return_type
                    }
                },
                _ => {}
            }
            // Eu.2 (v5.26.1): default args to <Int, err_arg_ty> when no
            // enclosing Result type. Mirrors mapanare/lower.py:2411.
            if len(res_ty_err.args) < 2:
                let mut err_arg_ty: MIRType = args[0].ty
                if err_arg_ty.kind == TK_UNKNOWN() { err_arg_ty = mir_string() }
                res_ty_err = new_mir_type_with_args("Result", TK_RESULT(), [mir_int(), err_arg_ty])
            let dr_err: LowerResult = make_value(st, res_ty_err, "t")
            let s_err: LowerState = emit_instr(dr_err.state, Instruction::WrapErr(dr_err.value, args[0]))
            // v5.4.4 — Err wrapper takes ownership.
            let s_err2: LowerState = emit_instr(s_err, Instruction::Move(args[0]))
            return new_lower_result(dr_err.value, s_err2)

    // Handle __new_StructName calls (from `new StructName { ... }` syntax)
    if fn_name.starts_with("__new_"):
        let struct_name: String = fn_name.substr(6, len(fn_name) - 6)
        // Check for generic struct — specialize on demand
        let mono_struct_r: LowerResult = try_monomorphize_struct(st, struct_name, args)
        if mono_struct_r.value.name != "%void" { return mono_struct_r }
        if is_struct_name(st, struct_name):
            let field_names: List<String> = get_struct_field_names(st, struct_name)
            let struct_ty: MIRType = mir_struct(struct_name)
            let mut field_pairs: List<FieldPair> = []
            let mut fi: Int = 0
            let nfn: Int = len(field_names)
            let na: Int = len(args)
            for _ in 0..500:
                if fi < nfn:
                    if fi < na:
                        let fp: FieldPair = new_field_pair(field_names[fi], args[fi])
                        field_pairs.push(fp)
                        fi = fi + 1
            let dr_new: LowerResult = make_value(st, struct_ty, "t")
            let s_new: LowerState = emit_instr(dr_new.state, Instruction::StructInit(dr_new.value, struct_ty, field_pairs))
            // v5.4.4 — StructInit takes ownership of each field value.
            let s_new2: LowerState = emit_move_fields(s_new, field_pairs)
            return new_lower_result(dr_new.value, s_new2)

    // Check if it's a generic enum variant constructor (monomorphize on demand)
    if is_generic_enum_variant(st, fn_name):
        let ge_r: LowerResult = try_monomorphize_enum(st, fn_name, args)
        if ge_r.value.name != "%void" { return ge_r }

    // Check if it's an enum variant constructor
    if is_enum_variant(st, fn_name):
        let enum_name: String = enum_name_for_variant(st, fn_name)
        let enum_ty: MIRType = mir_enum(enum_name)
        let dr_enum: LowerResult = make_value(st, enum_ty, "t")
        let s_enum: LowerState = emit_instr(dr_enum.state, Instruction::EnumInit(dr_enum.value, enum_ty, fn_name, args))
        // v5.4.4 — enum variant takes ownership of payload args.
        let s_enum2: LowerState = emit_move_vals(s_enum, args)
        return new_lower_result(dr_enum.value, s_enum2)

    // Check if it's a struct constructor (use if instead of match to avoid
    // control flow issues with return-inside-match)
    if is_struct_name(st, fn_name):
        let field_names: List<String> = get_struct_field_names(st, fn_name)
        let struct_ty: MIRType = mir_struct(fn_name)
        let mut field_pairs: List<FieldPair> = []
        let mut fi: Int = 0
        let nfn: Int = len(field_names)
        let na: Int = len(args)
        for _ in 0..500:
            if fi < nfn:
                if fi < na:
                    let fp: FieldPair = new_field_pair(field_names[fi], args[fi])
                    field_pairs.push(fp)
                    fi = fi + 1
        let dr_ctor: LowerResult = make_value(st, struct_ty, "t")
        let s_ctor: LowerState = emit_instr(dr_ctor.state, Instruction::StructInit(dr_ctor.value, struct_ty, field_pairs))
        // v5.4.4 — StructInit takes ownership of each field value.
        let s_ctor2: LowerState = emit_move_fields(s_ctor, field_pairs)
        return new_lower_result(dr_ctor.value, s_ctor2)

    // v5.7.0 Sh.7: indirect call through a fn-typed local variable.
    // Mirrors mapanare/lower.py::_lower_call (v4.103.0 docket #5). When
    // an identifier resolves to a parameter/binding annotated
    // `fn(T) -> T`, the alloca's MIR type has kind TK_FN. Load the
    // value and emit a Call whose fn_name is the loaded SSA name —
    // emit_call_ir / emit_call_void recognise the leading `%` and
    // emit `call <ret_ty> %fn(<args>)` rather than `call ... @<name>`.
    let var_lookup: Option<Value> = lookup_var(st, fn_name)
    match var_lookup {
        Some(addr_v) => {
            if addr_v.ty.kind == TK_FN() {
                let load_r: LowerResult = make_value(st, addr_v.ty, fn_name + "_val")
                let load_s: LowerState = emit_instr(load_r.state, Instruction::Load(load_r.value, addr_v))
                let dr_ind: LowerResult = make_value(load_s, mir_unknown(), "t")
                let s_ind: LowerState = emit_instr(dr_ind.state, Instruction::Call(dr_ind.value, load_r.value.name, args))
                return new_lower_result(dr_ind.value, s_ind)
            }
        },
        _ => {}
    }

    // Resolve lambda variable names to actual function names
    let resolved: String = unwrap_or_default(find_lambda(st, fn_name), fn_name)

    // For non-lambda calls, emit directly (no state copy needed).
    // Look up function return type from lambda_vars registry (__ret__fn_name).
    if resolved.find(":") < 0:
        let mut call_ret: MIRType = mir_unknown()
        let ret_key: String = "__ret__" + resolved
        let ret_opt: Option<String> = find_lambda(st, ret_key)
        match ret_opt {
            Some(ret_encoded) => {
                // Decode "kind:name" → MIRType
                let colon: Int = ret_encoded.find(":")
                if colon >= 0 {
                    let kind: String = ret_encoded.substr(0, colon)
                    // substr(start, count) — count is clamped to s.len
                    let name: String = ret_encoded.substr(colon + 1, len(ret_encoded))
                    if kind == "struct" { call_ret = mir_struct(name) }
                    if kind == "enum" { call_ret = mir_enum(name) }
                    if kind == "int" { call_ret = mir_int() }
                    if kind == "float" { call_ret = mir_float() }
                    if kind == "string" { call_ret = mir_string() }
                    if kind == "bool" { call_ret = mir_bool() }
                    if kind == "void" { call_ret = mir_void() }
                    if kind == "option" { call_ret = mir_option() }
                    if kind == "result" {
                        // Look up the FULL parameterized return type from the
                        // module's function list (preserves generic args).
                        let mut found_full: Bool = false
                        let mut fk: Int = 0
                        for _ in 0..5000 {
                            if fk < len(st.module.functions) {
                                if st.module.functions[fk].name == resolved {
                                    call_ret = st.module.functions[fk].return_type
                                    found_full = true
                                    fk = len(st.module.functions)
                                }
                                fk = fk + 1
                            }
                        }
                        if found_full == false { call_ret = mir_result() }
                    }
                    if kind == "list" { call_ret = mir_list() }
                    if kind == "map" { call_ret = mir_map() }
                }
            },
            _ => {}
        }
        let dr_call: LowerResult = make_value(st, call_ret, "t")
        let s_call: LowerState = emit_instr(dr_call.state, Instruction::Call(dr_call.value, resolved, args))
        return new_lower_result(dr_call.value, s_call)

    // Lambda call with captures — decode "lambda1:x,y" and load captured vars.
    // Chain state through make_value/emit_instr (byref, no LowerState copy).
    let actual_fn: String = resolved.substr(0, resolved.find(":"))
    let cp: Int = resolved.find(":")
    let caps_str: String = resolved.substr(cp + 1, len(resolved))
    let cap_parts: List<String> = caps_str.split(",")
    return lower_call_with_captures(st, actual_fn, args, cap_parts, 0)

fn lower_call_with_captures(st: LowerState, fn_name: String, args: List<Value>, captures: List<String>, idx: Int) -> LowerResult:
    // Base case: all captures loaded — emit the call
    if idx >= len(captures):
        let dest_r: LowerResult = make_value(st, mir_unknown(), "t")
        let s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
        return new_lower_result(dest_r.value, s)

    // Load one captured variable and recurse
    let cap_name: String = captures[idx]
    let var_opt: Option<Value> = lookup_var(st, cap_name)
    match var_opt {
        Some(addr) => {
            let lr: LowerResult = make_value(st, addr.ty, "cap")
            let ns: LowerState = emit_instr(lr.state, Instruction::Load(lr.value, addr))
            args.push(lr.value)
            return lower_call_with_captures(ns, fn_name, args, captures, idx + 1)
        },
        _ => {
            return lower_call_with_captures(st, fn_name, args, captures, idx + 1)
        }
    }

// ---------------------------------------------------------------------------
// Method call lowering
// ---------------------------------------------------------------------------

fn str_method_return_type(method: String) -> MIRType:
    if method == "char_at" { return mir_string() }
    if method == "substr" { return mir_string() }
    if method == "to_upper" { return mir_string() }
    if method == "to_lower" { return mir_string() }
    if method == "replace" { return mir_string() }
    if method == "trim" { return mir_string() }
    if method == "trim_start" { return mir_string() }
    if method == "trim_end" { return mir_string() }
    if method == "concat" { return mir_string() }
    if method == "join" { return mir_string() }
    if method == "strip" { return mir_string() }
    if method == "upper" { return mir_string() }
    if method == "lower" { return mir_string() }
    if method == "slice" { return mir_string() }
    if method == "reverse" { return mir_string() }
    if method == "repeat" { return mir_string() }
    if method == "center" { return mir_string() }
    if method == "pad_start" { return mir_string() }
    if method == "pad_end" { return mir_string() }
    if method == "byte_at" { return mir_int() }
    if method == "find" { return mir_int() }
    if method == "index" { return mir_int() }
    if method == "len" { return mir_int() }
    if method == "count" { return mir_int() }
    if method == "starts_with" { return mir_bool() }
    if method == "ends_with" { return mir_bool() }
    if method == "contains" { return mir_bool() }
    if method == "is_empty" { return mir_bool() }
    if method == "split" { return mir_list() }
    return mir_unknown()

fn list_method_return_type(method: String) -> MIRType:
    if method == "len" { return mir_int() }
    if method == "push" { return mir_void() }
    if method == "is_empty" { return mir_bool() }
    if method == "contains" { return mir_bool() }
    if method == "pop" { return mir_unknown() }
    if method == "reverse" { return mir_list() }
    if method == "sort" { return mir_list() }
    if method == "concat" { return mir_list() }
    return mir_unknown()

fn map_method_return_type(method: String) -> MIRType:
    if method == "len" { return mir_int() }
    if method == "contains_key" { return mir_bool() }
    if method == "is_empty" { return mir_bool() }
    if method == "keys" { return mir_list() }
    if method == "values" { return mir_list() }
    if method == "get" { return mir_unknown() }
    if method == "set" { return mir_void() }
    if method == "remove" { return mir_void() }
    return mir_unknown()

fn lower_method_call(st: LowerState, obj: Expr, method: String, arg_exprs: List<Expr>) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)
    let mut s: LowerState = obj_r.state

    // Special handling for push: pass the list ALLOCA address (not the loaded value)
    // so the emitter can push directly to the alloca, avoiding copy semantics.
    if method == "push":
        return lower_push_method(s, obj, obj_r, arg_exprs)

    // v5.41.0 Ts.1 → v5.45.0 Ts.2.B — tensor.reshape(shape) and tensor.view(shape).
    // Mirror of mapanare/lower.py unified reshape+view branch. v5.45.0
    // swap: reshape semantics changed from copy to alias (delegates to
    // __mn_tensor_view in the runtime). The lowerer emits a Call to the
    // appropriate runtime fn name; the noalias attribute drop is in
    // emit_llvm.mn (Phase 5.4).
    if method == "reshape" || method == "view":
        if obj_r.value.ty.kind == TK_TENSOR():
            if len(arg_exprs) >= 1:
                let shape_r: LowerResult = lower_expr(s, arg_exprs[0])
                s = shape_r.state
                let elem_kind_rs: Int = tensor_elem_kind_of(obj_r.value)
                let mut elem_ty_rs: MIRType = mir_float()
                if elem_kind_rs == TK_INT() { elem_ty_rs = mir_int() }
                let res_ty_rs: MIRType = mir_tensor_of(elem_ty_rs)
                let mut fn_name_rs: String = "__mn_tensor_reshape"
                let mut prefix_rs: String = "treshape"
                if method == "view":
                    fn_name_rs = "__mn_tensor_view"
                    prefix_rs = "tview"
                let rs_dest: LowerResult = make_value(s, res_ty_rs, prefix_rs)
                let mut rs_args: List<Value> = []
                rs_args.push(obj_r.value)
                rs_args.push(shape_r.value)
                let s_rs: LowerState = emit_instr(rs_dest.state, Instruction::Call(rs_dest.value, fn_name_rs, rs_args))
                return new_lower_result(rs_dest.value, s_rs)

    // v5.6.3 Sh.6 Phase 4 — tensor reduction methods
    // `a.sum()/.mean()/.max()/.min()/.argmax()/.argmin()` route to the
    // `__mn_tensor_{method}_{f64,i64}` runtime family. mean always goes
    // to the f64 variant (no _i64 runtime). Mirrors
    // mapanare/lower.py::_lower_method_call:2503-2522.
    if is_tensor_reduction_method(method):
        if obj_r.value.ty.kind == TK_TENSOR():
            let elem_kind_red: Int = tensor_elem_kind_of(obj_r.value)
            let mut ty_suffix: String = "f64"
            if elem_kind_red == TK_INT() { ty_suffix = "i64" }
            if method == "mean" { ty_suffix = "f64" }
            let red_fn: String = "__mn_tensor_" + method + "_" + ty_suffix
            let red_ret_ty: MIRType = tensor_reduction_ret_ty(method, elem_kind_red)
            let red_dest: LowerResult = make_value(s, red_ret_ty, "tred")
            let mut red_args: List<Value> = []
            red_args.push(obj_r.value)
            let s_red: LowerState = emit_instr(red_dest.state, Instruction::Call(red_dest.value, red_fn, red_args))
            return new_lower_result(red_dest.value, s_red)

    // Build arg list: [obj_value, arg_values...]
    let mut all_args: List<Value> = []
    all_args.push(obj_r.value)
    let nae: Int = len(arg_exprs)
    let mut i: Int = 0
    for _ in 0..500:
        if i < nae:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            all_args.push(arg_r.value)
            i = i + 1

    let mut ret_ty: MIRType = mir_unknown()
    if obj_r.value.ty.kind == TK_STRING():
        ret_ty = str_method_return_type(method)
    if obj_r.value.ty.kind == TK_LIST():
        ret_ty = list_method_return_type(method)
    if obj_r.value.ty.kind == TK_MAP():
        ret_ty = map_method_return_type(method)

    // Resolve impl method: if obj has struct/enum type, check impl_methods
    let mut call_name: String = method
    let obj_type_name: String = obj_r.value.ty.name
    if obj_type_name != "":
        let impl_key: String = obj_type_name + "." + method
        let impl_opt: Option<String> = lookup_impl_method(s, impl_key)
        match impl_opt:
            Some(mangled) => { call_name = mangled }
            _ => {}

    let dest_r: LowerResult = make_value(s, ret_ty, "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, call_name, all_args))
    return new_lower_result(dest_r.value, new_s)

fn lookup_impl_method(st: LowerState, key: String) -> Option<String>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.impl_methods):
            if st.impl_methods[i].key == key { return Some(st.impl_methods[i].mir_name) }
            i = i + 1
    return none

// v5.4.4 Own.1 Phase 2 — Move-emission helpers.
// emit_move_vals / emit_move_fields append one Move instruction per
// input value. Used after list.push, map_set, struct_init, enum_init,
// and Option/Result wrappers so the emitter's drop glue can see that
// the resource's ownership transferred into the container.
fn emit_move_vals(st: LowerState, vals: List<Value>) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(vals)
    let mut i: Int = 0
    for _ in 0..500:
        if i >= n { return s }
        s = emit_instr(s, Instruction::Move(vals[i]))
        i = i + 1
    return s

fn emit_move_fields(st: LowerState, fields: List<FieldPair>) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(fields)
    let mut i: Int = 0
    for _ in 0..500:
        if i >= n { return s }
        s = emit_instr(s, Instruction::Move(fields[i].val))
        i = i + 1
    return s

fn emit_move_kvpairs(st: LowerState, pairs: List<KVPair>) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(pairs)
    let mut i: Int = 0
    for _ in 0..500:
        if i >= n { return s }
        s = emit_instr(s, Instruction::Move(pairs[i].key))
        s = emit_instr(s, Instruction::Move(pairs[i].val))
        i = i + 1
    return s

fn lower_push_method(st: LowerState, obj: Expr, obj_r: LowerResult, arg_exprs: List<Expr>) -> LowerResult:
    let mut s: LowerState = st
    // Lower the element
    let arg_r: LowerResult = lower_expr(s, arg_exprs[0])
    s = arg_r.state
    // Find the alloca for the list.
    // For simple Ident: use lookup_var → alloca address
    // For FieldAccess: use the struct alloca + field name
    //   The emitter handles this via the @field: prefix
    let list_ref: Value = find_list_alloca(s, obj, obj_r)
    let mut all_args: List<Value> = []
    all_args.push(list_ref)
    all_args.push(arg_r.value)
    let dest_r: LowerResult = make_value(s, mir_void(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, "push", all_args))
    // v5.4.4 — list.push copies the element into the list buffer; the
    // container owns it now. Drop glue must skip the caller's slot.
    let moved_s: LowerState = emit_instr(new_s, Instruction::Move(arg_r.value))
    return new_lower_result(dest_r.value, moved_s)

fn find_list_alloca(st: LowerState, obj: Expr, obj_r: LowerResult) -> Value:
    let ok: String = expr_kind(obj)
    if ok == "ident":
        // Simple variable push: use the variable's alloca directly
        let var_opt: Option<Value> = lookup_var(st, expr_ident_name(obj))
        match var_opt:
            Some(addr) => { return addr }
            _ => { return obj_r.value }
    if ok == "field_access":
        // struct.field.push(): GEP into the struct alloca
        // to get a pointer to the list field
        return find_field_alloca(st, expr_field_obj(obj), expr_field_name(obj), obj_r)
    return obj_r.value

fn find_field_alloca(st: LowerState, inner: Expr, field_name: String, obj_r: LowerResult) -> Value:
    if expr_kind(inner) == "ident":
        let name: String = expr_ident_name(inner)
        let var_opt: Option<Value> = lookup_var(st, name)
        match var_opt {
            Some(addr) => {
                // Encode the field name in the Value's type name
                // so the emitter can find the correct field index.
                // Convention: ty.name = "StructName:field_name"
                let combined: MIRType = new_mir_type(addr.ty.name + ":" + field_name, addr.ty.kind)
                return new_value(addr.name, combined)
            },
            _ => { return obj_r.value }
        }
    return obj_r.value

// ---------------------------------------------------------------------------
// Field access lowering
// ---------------------------------------------------------------------------

fn lookup_struct_field_type(st: LowerState, struct_name: String, field_name: String) -> MIRType:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.struct_fields) { return mir_unknown() }
        let info: StructFieldInfo = st.struct_fields[i]
        if info.name == struct_name:
            let mut j: Int = 0
            for _ in 0..500:
                if j >= len(info.field_names) { return mir_unknown() }
                if info.field_names[j] == field_name:
                    if j < len(info.field_types):
                        return info.field_types[j]
                    return mir_unknown()
                j = j + 1
        i = i + 1
    return mir_unknown()

fn lower_field_access(st: LowerState, obj: Expr, field_name: String) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)

    // Only emit SignalGet for actual signal types, not for struct .value fields
    if field_name == "value" && obj_r.value.ty.kind == TK_SIGNAL():
        let dr_sig: LowerResult = make_value(obj_r.state, mir_unknown(), "t")
        let s_sig: LowerState = emit_instr(dr_sig.state, Instruction::SignalGet(dr_sig.value, obj_r.value))
        return new_lower_result(dr_sig.value, s_sig)

    // Resolve field type from struct registry
    let field_ty: MIRType = lookup_struct_field_type(obj_r.state, obj_r.value.ty.name, field_name)

    let dr_fld: LowerResult = make_value(obj_r.state, field_ty, "t")
    let s_fld: LowerState = emit_instr(dr_fld.state, Instruction::FieldGet(dr_fld.value, obj_r.value, field_name))
    return new_lower_result(dr_fld.value, s_fld)

// ---------------------------------------------------------------------------
// Namespace access lowering
// ---------------------------------------------------------------------------

fn is_enum_name(st: LowerState, name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(st.enum_variants) { return false }
        if st.enum_variants[i].enum_name == name { return true }
        i = i + 1
    return false

fn lower_namespace_access(st: LowerState, ns: String, member: String) -> LowerResult:
    // Check if namespace is a registered enum → emit EnumInit
    if is_enum_name(st, ns):
        let enum_ty: MIRType = mir_enum(ns)
        let dr_ns_enum: LowerResult = make_value(st, enum_ty, "t")
        let eargs_enum: List<Value> = []
        let s_ns_enum: LowerState = emit_instr(dr_ns_enum.state, Instruction::EnumInit(dr_ns_enum.value, enum_ty, member, eargs_enum))
        return new_lower_result(dr_ns_enum.value, s_ns_enum)
    // Otherwise: module function call
    let dr_ns_mod: LowerResult = make_value(st, mir_unknown(), "t")
    let fn_name: String = ns + "_" + member
    let eargs_mod: List<Value> = []
    let s_ns_mod: LowerState = emit_instr(dr_ns_mod.state, Instruction::Call(dr_ns_mod.value, fn_name, eargs_mod))
    return new_lower_result(dr_ns_mod.value, s_ns_mod)

// ---------------------------------------------------------------------------
// Index lowering
// ---------------------------------------------------------------------------

fn lower_index(st: LowerState, obj: Expr, idx: Expr) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)

    // v5.6.1 Sh.6 Phase 2 — single-subscript on tensor (`b[0]`) routes
    // through the same __mn_tensor_get_*_nd runtime as multi-dim,
    // matching mapanare/lower.py::_lower_index.
    if obj_r.value.ty.kind == TK_TENSOR():
        let mut one_idx: List<Expr> = []
        one_idx.push(idx)
        let obj_name_e: Expr = Expr::NoneLit
        let idx_r_ti: LowerResult = lower_expr(obj_r.state, idx)
        let mut s_ti: LowerState = idx_r_ti.state

        let elem_kind_ti: Int = tensor_elem_kind_of(obj_r.value)
        let mut fn_name_ti: String = "__mn_tensor_get_f64_nd"
        let mut elem_ty_ti: MIRType = mir_float()
        if elem_kind_ti == TK_INT():
            fn_name_ti = "__mn_tensor_get_i64_nd"
            elem_ty_ti = mir_int()

        let rank_r_ti: LowerResult = make_value(s_ti, mir_int(), "trank")
        s_ti = emit_instr(rank_r_ti.state, Instruction::Const(rank_r_ti.value, mir_int(), "1"))

        let mut all_args_ti: List<Value> = []
        all_args_ti.push(obj_r.value)
        all_args_ti.push(rank_r_ti.value)
        all_args_ti.push(idx_r_ti.value)

        let dest_r_ti: LowerResult = make_value(s_ti, elem_ty_ti, "tget")
        let s_out: LowerState = emit_instr(dest_r_ti.state, Instruction::Call(dest_r_ti.value, fn_name_ti, all_args_ti))
        return new_lower_result(dest_r_ti.value, s_out)

    let idx_r: LowerResult = lower_expr(obj_r.state, idx)

    // For string indexing, result is a string (char_at)
    // For list indexing, result is the element type from List<T>.args[0]
    // For map indexing, result is the value type from Map<K,V>.args[1]
    let mut elem_ty: MIRType = mir_unknown()
    if obj_r.value.ty.kind == TK_STRING():
        elem_ty = mir_string()
    else if obj_r.value.ty.kind == TK_LIST():
        if len(obj_r.value.ty.args) > 0:
            elem_ty = obj_r.value.ty.args[0]
    else if obj_r.value.ty.kind == TK_MAP():
        if len(obj_r.value.ty.args) > 1:
            elem_ty = obj_r.value.ty.args[1]

    let dest_r: LowerResult = make_value(idx_r.state, elem_ty, "t")
    let s: LowerState = emit_instr(dest_r.state, Instruction::IndexGet(dest_r.value, obj_r.value, idx_r.value))
    return new_lower_result(dest_r.value, s)

// v5.6.1 Sh.6 Phase 2 — `a[i, j]` / `a[i, j, k]` lowered as a variadic
// Call to __mn_tensor_get_{f64,i64}_nd. Element type is pulled from the
// tensor value's MIR type args (populated by lower_tensor); defaults to
// Float when unknown, matching Python's _lower_tensor_get fallback.
fn tensor_elem_kind_of(v: Value) -> Int:
    if v.ty.kind == TK_TENSOR():
        if len(v.ty.args) > 0:
            return v.ty.args[0].kind
    return TK_FLOAT()

// v5.6.3 Sh.6 Phase 4 — helpers for tensor reduction method dispatch.
fn is_tensor_reduction_method(m: String) -> Bool:
    if m == "sum" { return true }
    if m == "mean" { return true }
    if m == "max" { return true }
    if m == "min" { return true }
    if m == "argmax" { return true }
    if m == "argmin" { return true }
    return false

// Return type for a tensor reduction method on element kind `elem_kind`:
//   sum/max/min → element type (Int or Float)
//   mean        → always Float (no i64 mean runtime)
//   argmax/argmin → Int
fn tensor_reduction_ret_ty(method: String, elem_kind: Int) -> MIRType:
    if method == "argmax" { return mir_int() }
    if method == "argmin" { return mir_int() }
    if method == "mean" { return mir_float() }
    if elem_kind == TK_INT() { return mir_int() }
    return mir_float()

fn lower_tensor_index_get(st: LowerState, obj: Expr, indices: List<Expr>) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)
    let mut s: LowerState = obj_r.state

    let mut idx_vals: List<Value> = []
    let mut i: Int = 0
    let nidx: Int = len(indices)
    for _ in 0..128:
        if i < nidx:
            let ir: LowerResult = lower_expr(s, indices[i])
            s = ir.state
            idx_vals.push(ir.value)
            i = i + 1

    let elem_kind: Int = tensor_elem_kind_of(obj_r.value)
    let mut fn_name: String = "__mn_tensor_get_f64_nd"
    let mut elem_ty: MIRType = mir_float()
    if elem_kind == TK_INT():
        fn_name = "__mn_tensor_get_i64_nd"
        elem_ty = mir_int()

    // rank constant
    let rank_r: LowerResult = make_value(s, mir_int(), "trank")
    s = emit_instr(rank_r.state, Instruction::Const(rank_r.value, mir_int(), toString(nidx)))

    // build args: [tensor, rank, i0, i1, ...]
    let mut all_args: List<Value> = []
    all_args.push(obj_r.value)
    all_args.push(rank_r.value)
    for k in 0..nidx:
        all_args.push(idx_vals[k])

    let dest_r: LowerResult = make_value(s, elem_ty, "tget")
    s = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, all_args))
    return new_lower_result(dest_r.value, s)

// v5.6.3 Sh.6 Phase 4 — `a[1..3, _]` lowers to a Call to __mn_tensor_slice
// with flat args `[tensor, s0, s1, ..., e0, e1, ..., rank]`. The emitter
// special-cases __mn_tensor_slice to repackage the flat args into two
// stack-allocated [rank × i64] arrays before calling the runtime.
// Mirrors mapanare/lower.py::_lower_tensor_slice:2788-2835.
//
// v5.45.0 Ts.3.B — when any IndexItem has step != Expr::NoneLit, route
// to __mn_tensor_step_slice with `[obj, s0..e0..k0..rank]` (3*rank+2
// args). Non-stepped axes use step=1. Step <= 0 is rejected at runtime
// by __mn_tensor_step_slice (the C runtime backstop). The Python
// bootstrap also catches literal step <= 0 at lower time; the self-host
// version skips this check for simplicity (the runtime is sufficient
// and the literal-vs-non-literal decomposition would touch every Expr
// match arm).
fn lower_tensor_slice(st: LowerState, obj: Expr, items: List<IndexItem>) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)
    let mut s: LowerState = obj_r.state

    let rank: Int = len(items)
    let mut starts: List<Value> = []
    let mut ends: List<Value> = []
    let mut steps: List<Value> = []
    let mut any_stepped: Bool = false

    let mut d: Int = 0
    for _ in 0..128:
        if d < rank:
            let it: IndexItem = items[d]
            if it.kind == "range":
                // start
                let sv: LowerResult = make_value(s, mir_int(), "ci")
                s = sv.state
                if expr_kind(it.start) == "none_lit":
                    s = emit_instr(s, Instruction::Const(sv.value, mir_int(), "0"))
                    starts.push(sv.value)
                else:
                    let start_r: LowerResult = lower_expr(s, it.start)
                    s = start_r.state
                    starts.push(start_r.value)
                // end
                if expr_kind(it.end) == "none_lit":
                    let ev: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(ev.state, Instruction::Const(ev.value, mir_int(), "0"))
                    ends.push(ev.value)
                else:
                    let end_r: LowerResult = lower_expr(s, it.end)
                    s = end_r.state
                    ends.push(end_r.value)
            else:
                if it.kind == "wildcard":
                    // start = 0
                    let sv_w: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(sv_w.state, Instruction::Const(sv_w.value, mir_int(), "0"))
                    starts.push(sv_w.value)
                    // end = tensor_shape_dim(obj, d)
                    let dv: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(dv.state, Instruction::Const(dv.value, mir_int(), toString(d)))
                    let shape_dest: LowerResult = make_value(s, mir_int(), "sdim")
                    s = shape_dest.state
                    let mut shape_args: List<Value> = []
                    shape_args.push(obj_r.value)
                    shape_args.push(dv.value)
                    s = emit_instr(s, Instruction::Call(shape_dest.value, "tensor_shape_dim", shape_args))
                    ends.push(shape_dest.value)
                else:
                    // scalar in slice context — treat as [k, k+1]
                    let scalar_r: LowerResult = lower_expr(s, it.expr)
                    s = scalar_r.state
                    starts.push(scalar_r.value)
                    let one_r: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(one_r.state, Instruction::Const(one_r.value, mir_int(), "1"))
                    let end_d: LowerResult = make_value(s, mir_int(), "send")
                    s = emit_instr(end_d.state, Instruction::BinOp(end_d.value, BinOpKind::Add, scalar_r.value, one_r.value))
                    ends.push(end_d.value)

            // v5.45.0 Ts.3.B — step (default to const 1 when absent).
            if expr_kind(it.step) == "none_lit":
                let kc: LowerResult = make_value(s, mir_int(), "ci")
                s = emit_instr(kc.state, Instruction::Const(kc.value, mir_int(), "1"))
                steps.push(kc.value)
            else:
                let step_r: LowerResult = lower_expr(s, it.step)
                s = step_r.state
                steps.push(step_r.value)
                any_stepped = true

            d = d + 1

    // rank constant
    let rank_r: LowerResult = make_value(s, mir_int(), "trank")
    s = emit_instr(rank_r.state, Instruction::Const(rank_r.value, mir_int(), toString(rank)))

    // Result type = Tensor<T> (same element type as obj)
    let elem_kind_sl: Int = tensor_elem_kind_of(obj_r.value)
    let mut elem_ty_sl: MIRType = mir_float()
    if elem_kind_sl == TK_INT() { elem_ty_sl = mir_int() }
    let res_ty: MIRType = mir_tensor_of(elem_ty_sl)

    if any_stepped:
        // v5.45.0 Ts.3.B — stepped slice (copy semantics).
        // Flat args: [obj, s0..s_{n-1}, e0..e_{n-1}, k0..k_{n-1}, rank]
        let dest_ss: LowerResult = make_value(s, res_ty, "tstepslice")
        s = dest_ss.state
        let mut ss_args: List<Value> = []
        ss_args.push(obj_r.value)
        for a_i in 0..rank:
            ss_args.push(starts[a_i])
        for b_i in 0..rank:
            ss_args.push(ends[b_i])
        for c_i in 0..rank:
            ss_args.push(steps[c_i])
        ss_args.push(rank_r.value)
        s = emit_instr(s, Instruction::Call(dest_ss.value, "__mn_tensor_step_slice", ss_args))
        return new_lower_result(dest_ss.value, s)

    let dest_sl: LowerResult = make_value(s, res_ty, "tslice")
    s = dest_sl.state

    // Flat args: [obj, s0, s1, ..., e0, e1, ..., rank]
    let mut all_args: List<Value> = []
    all_args.push(obj_r.value)
    for a_i in 0..rank:
        all_args.push(starts[a_i])
    for b_i in 0..rank:
        all_args.push(ends[b_i])
    all_args.push(rank_r.value)

    s = emit_instr(s, Instruction::Call(dest_sl.value, "__mn_tensor_slice", all_args))
    return new_lower_result(dest_sl.value, s)

// ---------------------------------------------------------------------------
// Pipe lowering
// ---------------------------------------------------------------------------

fn lower_pipe_call(arg_r: LowerResult, fn_name: String, extra_exprs: List<Expr>) -> LowerResult:
    let mut s: LowerState = arg_r.state
    let mut args: List<Value> = []
    args.push(arg_r.value)
    let mut i: Int = 0
    let nee: Int = len(extra_exprs)
    for _ in 0..500:
        if i < nee:
            let extra_r: LowerResult = lower_expr(s, extra_exprs[i])
            s = extra_r.state
            args.push(extra_r.value)
            i = i + 1
    let dest_r: LowerResult = make_value(s, mir_unknown(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
    return new_lower_result(dest_r.value, new_s)

fn lower_pipe_with_call(arg_r: LowerResult, callee: Expr, extra_arg_exprs: List<Expr>) -> LowerResult:
    if expr_kind(callee) == "ident":
        return lower_pipe_call(arg_r, expr_ident_name(callee), extra_arg_exprs)
    return new_lower_result(arg_r.value, arg_r.state)

fn lower_pipe(st: LowerState, left: Expr, right: Expr) -> LowerResult:
    let arg_r: LowerResult = lower_expr(st, left)

    let rk: String = expr_kind(right)
    if rk == "ident":
        // v5.6.10 — bind via typed let so the empty extras list flows
        // through `lower_let_list_hint` and gets a known elem_ty
        // (Expr is an enum → GEP-trick path in emit_list_init).
        let empty_extras: List<Expr> = []
        return lower_pipe_call(arg_r, expr_ident_name(right), empty_extras)
    if rk == "call":
        return lower_pipe_with_call(arg_r, expr_call_callee(right), expr_call_args(right))

    // General case
    let fn_r: LowerResult = lower_expr(arg_r.state, right)
    let dest_r: LowerResult = make_value(fn_r.state, mir_unknown(), "t")
    let mut args: List<Value> = []
    args.push(arg_r.value)
    let s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_r.value.name, args))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Range lowering
// ---------------------------------------------------------------------------

fn lower_range(st: LowerState, start: Expr, end: Expr, inclusive: Bool) -> LowerResult:
    let start_r: LowerResult = lower_expr(st, start)
    let end_r: LowerResult = lower_expr(start_r.state, end)
    let dest_r: LowerResult = make_value(end_r.state, mir_range(), "t")
    let mut fn_name: String = "__mn_range"
    if inclusive { fn_name = "__mn_range_inclusive" }
    let mut args: List<Value> = []
    args.push(start_r.value)
    args.push(end_r.value)
    let s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Lambda lowering
// ---------------------------------------------------------------------------

fn find_expr_alloca(st: LowerState, expr: Expr, obj_r: LowerResult) -> Value:
    // For Ident(name), return the variable's alloca address
    if expr_kind(expr) == "ident":
        let var_opt: Option<Value> = lookup_var(st, expr_ident_name(expr))
        match var_opt:
            Some(addr) => { return addr }
            _ => { return obj_r.value }
    return obj_r.value

// Module mutation: extract list to local variable, push, reconstruct.
// This avoids struct field push (GEP index issues) by rebuilding the
// current MIRModule layout explicitly, including consts.
fn module_push_struct(m: MIRModule, info: StructInfo) -> MIRModule:
    let mut lst: List<StructInfo> = m.structs
    lst.push(info)
    new MIRModule { name: m.name, functions: m.functions, structs: lst, enums: m.enums, extern_fns: m.extern_fns, agents: m.agents, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn module_push_enum(m: MIRModule, info: EnumInfo) -> MIRModule:
    let mut lst: List<EnumInfo> = m.enums
    lst.push(info)
    new MIRModule { name: m.name, functions: m.functions, structs: m.structs, enums: lst, extern_fns: m.extern_fns, agents: m.agents, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn module_push_function(m: MIRModule, f: MIRFunction) -> MIRModule:
    let mut lst: List<MIRFunction> = m.functions
    lst.push(f)
    new MIRModule { name: m.name, functions: lst, structs: m.structs, enums: m.enums, extern_fns: m.extern_fns, agents: m.agents, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn module_push_agent(m: MIRModule, info: AgentInfo) -> MIRModule:
    let mut lst: List<AgentInfo> = m.agents
    lst.push(info)
    new MIRModule { name: m.name, functions: m.functions, structs: m.structs, enums: m.enums, extern_fns: m.extern_fns, agents: lst, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn lower_arm_body(st: LowerState, body: MatchArmBody) -> LowerResult:
    if match_arm_body_kind(body) == "block" { return lower_block(st, match_arm_body_block(body)) }
    return lower_expr(st, match_arm_body_expr(body))

fn extract_ident_name(expr: Expr) -> String:
    if expr_kind(expr) == "ident" { return expr_ident_name(expr) }
    return ""

fn unwrap_or_default(opt: Option<String>, default: String) -> String:
    match opt:
        Some(val) => { return val }
        _ => { return default }

fn lambda_body_to_block(body: LambdaBody) -> Block:
    if lambda_body_kind(body) == "block" { return lambda_body_block(body) }
    let ret_stmt: Stmt = Stmt::Return(Some(lambda_body_expr(body)))
    let stmts: List<Stmt> = []
    stmts.push(ret_stmt)
    let span: Span = new_span(0, 0, 0, 0)
    return new_block(span, stmts)

fn count_actual_lambdas(st: LowerState) -> Int:
    let mut count: Int = 0
    let mut i: Int = 0
    for _ in 0..1000:
        if i >= len(st.lambda_vars) { return count }
        let e: LambdaEntry = st.lambda_vars[i]
        if !e.var_name.starts_with("__ret__"):
            count = count + 1
        i = i + 1
    return count

fn lower_lambda(st: LowerState, params: List<Param>, body: LambdaBody) -> LowerResult:
    // v5.7.0 Sh.7: name lambdas after the tmp_counter at creation time
    // (matching mapanare/lower.py::_lower_lambda which calls
    // self._fresh_tmp("lambda")). The harness compares function-name
    // sets; without this, bootstrap (lambdaN where N matches main's
    // tmp_counter) and stage1 (lambdaK from a separate
    // count_actual_lambdas counter) diverged on names like
    // 64_closure_typed.mn — bootstrap emitted lambda0/2/4 while
    // stage1 emitted lambda1/2/3, failing the function-name parity
    // check.
    let name_r: LowerResult = fresh_tmp(st, "lambda")
    let lambda_name: String = name_r.value.name.substr(1, len(name_r.value.name) - 1)

    let body_block: Block = lambda_body_to_block(body)

    // Build extended params: explicit params + captured parent vars
    let parent_vars: List<VarInfo> = name_r.state.vars
    let mut all_params: List<Param> = []
    let mut capture_suffix: String = ""
    for pi in 0..len(params):
        all_params.push(params[pi])
    let mut ci: Int = 0
    let npv: Int = len(parent_vars)
    for _ in 0..500:
        if ci < npv:
            let pv: VarInfo = parent_vars[ci]
            let cap_param: Param = new Param { span: new_span(0, 0, 0, 0), name: pv.name, type_annotation: none }
            all_params.push(cap_param)
            if ci == 0:
                capture_suffix = ":" + pv.name
            else:
                capture_suffix = capture_suffix + "," + pv.name
            ci = ci + 1

    // Create FnDefData with Int return type
    let span: Span = new_span(0, 0, 0, 0)
    let empty_type_params: List<String> = []
    let empty_decorators: List<Decorator> = []
    let int_ret: TypeExpr = make_int_type()
    let fn_def: FnDefData = new_fn_def_data(span, lambda_name, false, empty_type_params, all_params, Some(int_ret), body_block, empty_decorators)

    // Lower as a nested function (lower_fn saves/restores function scope)
    let mut s: LowerState = lower_fn(name_r.state, fn_def, "")

    // Register lambda with capture info
    let encoded_name: String = lambda_name + capture_suffix
    let entry: LambdaEntry = new_lambda_entry("", encoded_name)
    let mut lv_lam: List<LambdaEntry> = s.lambda_vars
    lv_lam.push(entry)
    s.lambda_vars = lv_lam

    // Return a reference to the lambda function
    let dest_r: LowerResult = make_value(s, mir_fn_type(), "t")
    s = emit_instr(dest_r.state, Instruction::Const(dest_r.value, mir_fn_type(), lambda_name))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Spawn / Sync / Send lowering
// ---------------------------------------------------------------------------

fn lower_spawn(st: LowerState, callee: Expr, arg_exprs: List<Expr>) -> LowerResult:
    let mut s: LowerState = st
    let mut args: List<Value> = []
    let mut i: Int = 0
    let nae_sp: Int = len(arg_exprs)
    for _ in 0..500:
        if i < nae_sp:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            args.push(arg_r.value)
            i = i + 1

    let agent_name: String = extract_ident_name(callee)

    let agent_ty: MIRType = mir_agent(agent_name)
    let dest_r: LowerResult = make_value(s, agent_ty, "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::AgentSpawn(dest_r.value, agent_ty, args))
    return new_lower_result(dest_r.value, new_s)

fn lower_sync(st: LowerState, inner: Expr) -> LowerResult:
    if expr_kind(inner) == "field_access":
        let obj_r: LowerResult = lower_expr(st, expr_field_obj(inner))
        let dr_sync_fa: LowerResult = make_value(obj_r.state, mir_unknown(), "t")
        let s_sync_fa: LowerState = emit_instr(dr_sync_fa.state, Instruction::AgentSync(dr_sync_fa.value, obj_r.value, expr_field_name(inner)))
        return new_lower_result(dr_sync_fa.value, s_sync_fa)
    let val_r: LowerResult = lower_expr(st, inner)
    let dr_sync_bare: LowerResult = make_value(val_r.state, mir_unknown(), "t")
    let s_sync_bare: LowerState = emit_instr(dr_sync_bare.state, Instruction::AgentSync(dr_sync_bare.value, val_r.value, ""))
    return new_lower_result(dr_sync_bare.value, s_sync_bare)

fn lower_send(st: LowerState, target: Expr, value: Expr) -> LowerResult:
    let val_r: LowerResult = lower_expr(st, value)

    if expr_kind(target) == "field_access":
        let obj_r: LowerResult = lower_expr(val_r.state, expr_field_obj(target))
        let s_field: LowerState = emit_instr(obj_r.state, Instruction::AgentSend(obj_r.value, expr_field_name(target), val_r.value))
        let dr_field: LowerResult = make_value(s_field, mir_void(), "t")
        let s2_field: LowerState = emit_instr(dr_field.state, Instruction::Const(dr_field.value, mir_void(), ""))
        return new_lower_result(dr_field.value, s2_field)
    let target_r: LowerResult = lower_expr(val_r.state, target)
    let s_plain: LowerState = emit_instr(target_r.state, Instruction::AgentSend(target_r.value, "", val_r.value))
    let dr_plain: LowerResult = make_value(s_plain, mir_void(), "t")
    let s2_plain: LowerState = emit_instr(dr_plain.state, Instruction::Const(dr_plain.value, mir_void(), ""))
    return new_lower_result(dr_plain.value, s2_plain)

// ---------------------------------------------------------------------------
// Error propagation lowering
// ---------------------------------------------------------------------------

// v4.33.0: fixed block ordering bug — add_block sets current_block_idx,
// so the Branch must be emitted BEFORE creating the ok/err blocks.
// Otherwise the Branch ends up in the err block and the entry block
// has no terminator (MIR verifier: "block does not end with a
// terminator").
fn lower_error_prop(st: LowerState, inner: Expr) -> LowerResult:
    let val_r: LowerResult = lower_expr(st, inner)
    let mut s: LowerState = val_r.state

    // Extract tag
    let tag_r: LowerResult = make_value(s, mir_bool(), "tag")
    s = emit_instr(tag_r.state, Instruction::EnumTag(tag_r.value, val_r.value))

    // Create block labels (but do NOT add them yet — we need to emit
    // the Branch into the CURRENT block first)
    let ok_label_r: LowerResult = fresh_block_label(s, "prop_ok")
    s = ok_label_r.state
    let ok_label: String = ok_label_r.value.name

    let err_label_r: LowerResult = fresh_block_label(s, "prop_err")
    s = err_label_r.state
    let err_label: String = err_label_r.value.name

    // Branch on tag — emitted into the CURRENT (entry) block
    s = emit_instr(s, Instruction::Branch(tag_r.value, ok_label, err_label))

    // Now create the target blocks (this switches current_block_idx)
    s = add_block(s, err_label)
    let err_idx: Int = s.current_block_idx

    // Error path: return the error
    s = emit_instr(s, Instruction::Return(Some(val_r.value)))

    // Create ok block
    s = add_block(s, ok_label)
    let ok_idx: Int = s.current_block_idx

    // Ok path: unwrap
    let dest_r: LowerResult = make_value(s, mir_unknown(), "t")
    s = emit_instr(dest_r.state, Instruction::Unwrap(dest_r.value, val_r.value))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// List lowering
// ---------------------------------------------------------------------------

fn lower_list(st: LowerState, elements: List<Expr>) -> LowerResult = lower_list_typed(st, elements, mir_unknown())

// v5.16.0 Te.4.D — lower a string-interpolation expression to a chain
// of concat operations. Mirrors mapanare/lower.py::_lower_interp_string.
//
// For each part:
//   * `StringLit` parts pass through unmodified (already mir_string-typed).
//   * Any other part is wrapped in `Cast(target=mir_string)`. The
//     emitter routes Cast(Int/Float/Bool→String) to the matching
//     `__mn_str_from_*` runtime call (with drop tracking on the fresh
//     allocation) and treats Cast(String→String) as an SSA alias.
//
// All resulting Values are bundled into a single `InterpConcat` MIR
// instruction; `emit_interp_concat` (already in emit_llvm.mn) chains
// `__mn_str_concat` calls left-to-right.
fn lower_interp_string(st: LowerState, parts: List<Expr>) -> LowerResult:
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let np: Int = len(parts)
    for _ in 0..1000:
        if i >= np { break }
        let p: Expr = parts[i]
        let pr: LowerResult = lower_expr(s, p)
        s = pr.state
        if expr_kind(p) == "string_lit":
            vals.push(pr.value)
        else:
            let cr: LowerResult = make_value(s, mir_string(), "t")
            s = emit_instr(cr.state, Instruction::Cast(cr.value, pr.value, mir_string()))
            vals.push(cr.value)
        i = i + 1
    let dr: LowerResult = make_value(s, mir_string(), "t")
    let s_final: LowerState = emit_instr(dr.state, Instruction::InterpConcat(dr.value, vals))
    return new_lower_result(dr.value, s_final)

// v5.6.7 Ve.2 fix — explicit-element-type variant for lowering list
// literals. When the context provides an element-type hint (e.g.
// `let xs: List<String> = []` from `lower_let`, pattern-match on
// `Generic("List", [inner])`), use it instead of the default
// `mir_unknown()` fallback when the literal is empty. Otherwise the
// emitter sees `elem_ty.kind=TK_UNKNOWN → resolve_mir_type returns
// "i64"`, and allocates 8-byte slots for lists that actually hold
// 16-byte Strings / 48-byte Params / variable-size structs — the
// exact root cause of the stage2 runtime corruption that had been
// masked by the 384-byte floor in `emit_list_init`.
fn lower_list_typed(st: LowerState, elements: List<Expr>, hinted_elem_ty: MIRType) -> LowerResult:
    // Touch st to force materialization before any list operations.
    // Without this, clang -O0 may leave the LowerState in stale registers
    // from the caller's sret return, causing corruption in subsequent ops.
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let nel: Int = len(elements)
    for _ in 0..2000:
        if i < nel:
            let el_r: LowerResult = lower_expr(s, elements[i])
            s = el_r.state
            vals.push(el_r.value)
            i = i + 1

    // Prefer the element type inferred from the first element (concrete,
    // post-lower). Fall back to the caller's hint (from the `let`
    // annotation). Last resort: mir_unknown() — safe because downstream
    // emit_list_init keeps a 384-byte floor for unknown/scalar fallback.
    let mut elem_type: MIRType = mir_unknown()
    if len(vals) > 0:
        let first_v: Value = vals[0]
        elem_type = first_v.ty
    else:
        if hinted_elem_ty.kind != TK_UNKNOWN():
            elem_type = hinted_elem_ty
    let dest_r: LowerResult = make_value(s, mir_list(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::ListInit(dest_r.value, elem_type, vals))
    return new_lower_result(dest_r.value, new_s)

// v5.6.12 Lk.1 fix — destination-passing variant of lower_list_typed.
// Closes the alloca-aliasing leak class at its structural root: when
// `let mut a: List<T> = []` is the value's destination, the lowerer
// emits the ListInit directly into a's slot instead of fresh-tmp'ing
// %t<N> and then copying it into %a<M>.addr (the duplicate-alloca
// pattern). The emitter's `dn + ".addr"` convention turns a `dest_name`
// of "%a<M>" into the alloca name "%a<M>.addr", which the caller then
// binds for the variable. One alloca, one tracking entry, no copy.
//
// Mirrors Rust's destination-passing codegen (PlaceRef in
// rustc_codegen_llvm) — result-location semantics rather than
// value-then-copy.
fn lower_list_typed_into(st: LowerState, elements: List<Expr>, hinted_elem_ty: MIRType, dest_name: String) -> LowerResult:
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let nel: Int = len(elements)
    for _ in 0..2000:
        if i < nel:
            let el_r: LowerResult = lower_expr(s, elements[i])
            s = el_r.state
            vals.push(el_r.value)
            i = i + 1
    let mut elem_type: MIRType = mir_unknown()
    if len(vals) > 0:
        let first_v: Value = vals[0]
        elem_type = first_v.ty
    else:
        if hinted_elem_ty.kind != TK_UNKNOWN():
            elem_type = hinted_elem_ty
    // Use the caller-supplied dest_name (e.g. "%indices0") instead of
    // fresh-tmp. tmp_counter is NOT bumped here; the caller already
    // reserved the slot when it picked the variable's name.
    let dest_val: Value = new_value(dest_name, mir_list())
    let new_s: LowerState = emit_instr(s, Instruction::ListInit(dest_val, elem_type, vals))
    return new_lower_result(dest_val, new_s)

// v5.6.7 Ve.2 helper — unwrap `List<T>` type annotation to T (as MIRType).
// Returns `mir_unknown()` for any type expression that isn't a
// recognized list generic; callers use the UNKNOWN sentinel to mean
// "no hint available".
fn extract_list_elem_ty(st: LowerState, te: TypeExpr) -> MIRType:
    match te {
        Generic(name, args) => {
            if name == "List" && len(args) >= 1 {
                return lower_resolve_type_checked(st, args[0])
            }
            return mir_unknown()
        },
        _ => { return mir_unknown() }
    }

// v5.6.7 Ve.2 helper — resolve a `let x: List<T> = []` pattern to its
// element type hint for `lower_list_typed`. Returns mir_unknown() when
// the pattern doesn't apply (value isn't a list literal, or type_ann
// isn't `List<T>`), letting the caller fall through to the default
// path.
fn lower_let_list_hint(st: LowerState, value: Expr, type_ann: Option<TypeExpr>) -> MIRType:
    if expr_kind(value) != "list_lit" { return mir_unknown() }
    match type_ann:
        Some(te) => { return extract_list_elem_ty(st, te) }
        _ => { return mir_unknown() }

// ---------------------------------------------------------------------------
// Tensor lowering (v4.42.0)
// ---------------------------------------------------------------------------

fn lower_tensor(st: LowerState, elements: List<Expr>, shape: List<Int>) -> LowerResult:
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let nel: Int = len(elements)
    for _ in 0..2000:
        if i < nel:
            let el_r: LowerResult = lower_expr(s, elements[i])
            s = el_r.state
            vals.push(el_r.value)
            i = i + 1

    let mut elem_type: MIRType = mir_unknown()
    if len(vals) > 0:
        let first_v: Value = vals[0]
        elem_type = first_v.ty
    // v5.6.0 Sh.6: tensor value is typed as TENSOR so emit_llvm.mn resolves
    // it as llvm_ptr() — matches the ret type of __mn_tensor_alloc and the
    // arg type of every __mn_tensor_* builtin. Without this the var slot
    // alloca'd for `let a = <tensor>` becomes i64 and llvm-as rejects the
    // ptr/i64 store mismatch.
    // v5.6.1 Sh.6 Phase 2: carry elem_type so `a[i, j]` can dispatch between
    // __mn_tensor_get_f64_nd and _i64_nd. resolve_mir_type still returns ptr.
    let dest_r: LowerResult = make_value(s, mir_tensor_of(elem_type), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::TensorInit(dest_r.value, elem_type, shape, vals))
    return new_lower_result(dest_r.value, new_s)

// ---------------------------------------------------------------------------
// Map lowering
// ---------------------------------------------------------------------------

fn lower_map(st: LowerState, entries: List<MapEntry>) -> LowerResult:
    let mut s: LowerState = st
    let mut pairs: List<KVPair> = []
    let mut i: Int = 0
    let nent: Int = len(entries)
    for _ in 0..2000:
        if i < nent:
            let entry: MapEntry = entries[i]
            let kr: LowerResult = lower_expr(s, entry.key)
            s = kr.state
            let vr: LowerResult = lower_expr(s, entry.value)
            s = vr.state
            pairs.push(new_kv_pair(kr.value, vr.value))
            i = i + 1

    let mut key_ty: MIRType = mir_string()
    let mut val_ty: MIRType = mir_unknown()
    if len(pairs) > 0:
        key_ty = pairs[0].key.ty
        val_ty = pairs[0].val.ty
    let dest_r: LowerResult = make_value(s, mir_map(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::MapInit(dest_r.value, key_ty, val_ty, pairs))
    // v5.4.4 — map owns each key/value pair.
    let moved_s: LowerState = emit_move_kvpairs(new_s, pairs)
    return new_lower_result(dest_r.value, moved_s)

// ---------------------------------------------------------------------------
// Comprehension lowering (v5.15.1 Cb.4)
//
// Mirrors mapanare/lower.py::_lower_comprehension. Synthesizes a fresh
// accumulator (`__mn_comp_N`), nested for/if structure, and per-step
// push (lists) or `m[k] = v` assignment (maps). The result is identical
// to a hand-written loop modulo SSA naming.
//
// For range iterables (e.g. `for x in 0..n`), emits a direct For. For
// non-range iterables (lists), emits the index-based pattern
// `for __i in 0..len(__src) { let target = __src[__i]; ... }` because
// `for x in some_list` is not yet supported by the generic ForLoop
// lowering (the runtime `__iter_*` shims only know about ranges).
// ---------------------------------------------------------------------------

fn wrap_comp_for(st: LowerState, clause: CompClause, inner: Block) -> Block:
    // Range iterables: direct ForLoop.
    if expr_kind(clause.iter) == "range":
        let mut stmts: List<Stmt> = []
        stmts.push(Stmt::For(clause.target, clause.iter, inner))
        return new_block(make_span(0, 0, 0, 0), stmts)

    // Non-range iterables: hoist source binding, iterate via index.
    let n: Int = st.tmp_counter
    let src_name: String = "__mn_comp_src_" + toString(n)
    let idx_name: String = "__mn_comp_i_" + toString(n)

    // Build inner: `let target = __src[__i]; <inner.stmts>`
    let get_elem: Expr = Expr::Index(Expr::Ident(src_name), Expr::Ident(idx_name))
    let mut body_stmts: List<Stmt> = []
    body_stmts.push(Stmt::Let(clause.target, false, none, get_elem))
    for i in 0..len(inner.stmts):
        body_stmts.push(inner.stmts[i])
    let new_body: Block = new_block(make_span(0, 0, 0, 0), body_stmts)

    let mut len_args: List<Expr> = []
    len_args.push(Expr::Ident(src_name))
    let len_call: Expr = Expr::Call(Expr::Ident("len"), len_args)
    let range_e: Expr = Expr::Range(Expr::IntLit(0), len_call, false)

    let mut outer_stmts: List<Stmt> = []
    outer_stmts.push(Stmt::Let(src_name, false, none, clause.iter))
    outer_stmts.push(Stmt::For(idx_name, range_e, new_body))
    return new_block(make_span(0, 0, 0, 0), outer_stmts)

fn lower_comprehension(st: LowerState, expr: Expr) -> LowerResult:
    let kind: String = expr_comp_kind(expr)
    let clauses: List<CompClause> = expr_comp_clauses(expr)

    // Snapshot and clear the type hint so nested comps inside the
    // element / key / value don't accidentally inherit it.
    let mut s: LowerState = st
    let type_hint: Option<TypeExpr> = s.comp_type_hint
    s.comp_type_hint = none

    // Reserve a stable accumulator name. `tmp_counter` bumps separately
    // from `__mn_comp_src_N` / `__mn_comp_i_N` (handed out by
    // `wrap_comp_for`).
    let comp_n: Int = s.tmp_counter
    s.tmp_counter = s.tmp_counter + 1
    let result_name: String = "__mn_comp_" + toString(comp_n)

    // Build the init expression and the per-iteration write expression.
    let empty_list_init: List<Expr> = []
    let mut init: Expr = Expr::ListLit(empty_list_init)
    let mut inner_call: Expr = Expr::NoneLit
    if kind == "list":
        let elem_opt: Option<Expr> = expr_comp_element(expr)
        let mut elem_e: Expr = Expr::NoneLit
        match elem_opt:
            Some(e) => { elem_e = e }
            _ => {}
        let mut push_args: List<Expr> = []
        push_args.push(elem_e)
        inner_call = Expr::MethodCall(Expr::Ident(result_name), "push", push_args)
    else:
        let key_opt: Option<Expr> = expr_comp_key(expr)
        let val_opt: Option<Expr> = expr_comp_value(expr)
        let mut key_e: Expr = Expr::NoneLit
        let mut val_e: Expr = Expr::NoneLit
        match key_opt:
            Some(k) => { key_e = k }
            _ => {}
        match val_opt:
            Some(v) => { val_e = v }
            _ => {}
        let empty_entries: List<MapEntry> = []
        init = Expr::MapLit(empty_entries)
        // Map insertion via `m[k] = v` — IndexSet handles both list and
        // map writes; mirrors Python's _AssignExpr/IndexExpr synthesis.
        let target_idx: Expr = Expr::Index(Expr::Ident(result_name), key_e)
        inner_call = Expr::Assign(target_idx, "=", val_e)

    // Synthesize and lower `let mut __mn_comp_N: <hint> = <init>`.
    let let_stmt: Stmt = Stmt::Let(result_name, true, type_hint, init)
    let let_r: LowerResult = lower_stmt(s, let_stmt)
    s = let_r.state

    // For map comprehensions with an explicit `Map<K, V>` annotation,
    // post-patch the most recent MapInit instruction's key/val types
    // (mirror of Python `lower.py::_lower_let` v5.15.0 Te.2.C). Without
    // this, indexing the comprehension's result would see UNKNOWN
    // value type and the LLVM emitter would fall back to raw-pointer
    // reads (printing `<?>`).
    if kind == "map":
        match type_hint:
            Some(te) => { s = patch_last_mapinit_types(s, te) }
            _ => {}

    // Build the loop body innermost-out: filters then for-clauses,
    // both in reverse source order.
    let mut body_stmts0: List<Stmt> = []
    body_stmts0.push(Stmt::ExprStmt(inner_call))
    let mut body: Block = new_block(make_span(0, 0, 0, 0), body_stmts0)
    let nclauses: Int = len(clauses)
    let mut ci: Int = nclauses - 1
    for _ in 0..32:
        if ci < 0 { break }
        let clause: CompClause = clauses[ci]
        // Wrap body in `if cond { body }` for each filter, reversed.
        let mut fi: Int = len(clause.conditions) - 1
        for _ in 0..32:
            if fi < 0 { break }
            let cond: Expr = clause.conditions[fi]
            let if_expr: Expr = Expr::If(cond, body, none)
            let mut wrap: List<Stmt> = []
            wrap.push(Stmt::ExprStmt(if_expr))
            body = new_block(make_span(0, 0, 0, 0), wrap)
            fi = fi - 1
        body = wrap_comp_for(s, clause, body)
        ci = ci - 1

    // Lower each statement of the synthesized outer block.
    let mut bi: Int = 0
    let nbs: Int = len(body.stmts)
    for _ in 0..256:
        if bi < nbs:
            let r_bs: LowerResult = lower_stmt(s, body.stmts[bi])
            s = r_bs.state
            bi = bi + 1

    // Return the populated accumulator (Load from its alloca).
    return lower_identifier(s, result_name)

// Find the most recent MapInit instruction in the current block and
// patch its key_type / val_type from a `Map<K, V>` TypeExpr. No-op if
// the type expression isn't shaped like Map<_, _>.
fn patch_last_mapinit_types(st: LowerState, te: TypeExpr) -> LowerState:
    if type_expr_kind(te) != "generic" { return st }
    if type_expr_name(te) != "Map" { return st }
    let args: List<TypeExpr> = type_expr_args(te)
    if len(args) < 2 { return st }
    let k_ty: MIRType = lower_resolve_type_checked(st, args[0])
    let v_ty: MIRType = lower_resolve_type_checked(st, args[1])

    let idx: Int = st.current_block_idx
    if idx < 0 { return st }
    if idx >= len(st.fn_blocks) { return st }
    let bb: BasicBlock = st.fn_blocks[idx]
    let mut instrs: List<Instruction> = bb.instructions
    let mut j: Int = len(instrs) - 1
    for _ in 0..512:
        if j < 0 { return st }
        let inst: Instruction = instrs[j]
        match inst {
            MapInit(dest, _, _, pairs) => {
                instrs[j] = Instruction::MapInit(dest, k_ty, v_ty, pairs)
                let new_bb: BasicBlock = new BasicBlock { label: bb.label, instructions: instrs }
                let mut blocks: List<BasicBlock> = st.fn_blocks
                blocks[idx] = new_bb
                let mut new_st: LowerState = st
                new_st.fn_blocks = blocks
                return new_st
            },
            _ => {}
        }
        j = j - 1
    return st

// ---------------------------------------------------------------------------
// v5.20.1 Te.5.F.D — Let destructure lowering
// ---------------------------------------------------------------------------

// Mirrors `mapanare/lower.py::_lower_let_destructure`. When the RHS is
// a bare Identifier already in scope, run field accesses directly on
// the source name (IR byte-identical to manual `let x = p.x; let y =
// p.y`). Otherwise lower the RHS once into a `__mn_dst_N` tmp.
fn lower_let_destructure(st: LowerState, pattern: StructPattern, outer_mut: Bool, type_ann: Option<TypeExpr>, value: Expr) -> LowerState:
    let mut s: LowerState = st

    // Bare-Ident RHS optimization: skip the synthesized base tmp.
    if expr_kind(value) == "ident":
        let src_name: String = expr_ident_name(value)
        let lookup: Option<Value> = lookup_var(s, src_name)
        match lookup {
            Some(_) => {
                return emit_destructure_pattern(s, pattern, src_name, outer_mut)
            },
            _ => {}
        }

    // General case: synthesize `let __mn_dst_N = value` first.
    let tmp_idx: Int = s.struct_update_counter
    s.struct_update_counter = tmp_idx + 1
    let base_name: String = "__mn_dst_" + toString(tmp_idx)
    s = lower_let(s, base_name, false, type_ann, value)
    return emit_destructure_pattern(s, pattern, base_name, outer_mut)

// Walk a StructPattern; emit per-field `let` for leaf bindings, recurse
// for nested struct sub-patterns. Mirrors `_emit_destructure_pattern`.
fn emit_destructure_pattern(st: LowerState, pattern: StructPattern, base_name: String, outer_mut: Bool) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(pattern.fields)
    let mut i: Int = 0
    for _ in 0..200:
        if i >= n { return s }
        let fp: FieldPattern = pattern.fields[i]
        let fa: Expr = Expr::FieldAccess(Expr::Ident(base_name), fp.name)
        match fp.sub_pattern {
            Some(sub) => {
                let nested_idx: Int = s.struct_update_counter
                s.struct_update_counter = nested_idx + 1
                let nested_base: String = "__mn_dst_" + toString(nested_idx)
                let none_t: Option<TypeExpr> = none
                s = lower_let(s, nested_base, false, none_t, fa)
                s = emit_destructure_pattern(s, sub, nested_base, outer_mut)
            },
            _ => {
                let mut leaf_mut: Bool = outer_mut
                if fp.mutable { leaf_mut = true }
                let none_t2: Option<TypeExpr> = none
                s = lower_let(s, fp.name, leaf_mut, none_t2, fa)
            }
        }
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// v5.20.1 Te.5.F.E — if-let / while-let / let-else
// ---------------------------------------------------------------------------

// Mirrors `mapanare/lower.py::_lower_if_let`. Desugars to a 2-arm
// match: success arm runs then_block, wildcard arm runs else_block
// (or empty Block when omitted).
fn lower_if_let(st: LowerState, pattern: Pattern, scrutinee: Expr, then_block: Block, else_block: Option<Block>) -> LowerResult:
    let none_guard: Option<Expr> = none
    let success_arm: MatchArm = new_match_arm(pattern, MatchArmBody::BlockBody(then_block), none_guard)
    let mut else_body_block: Block = then_block  // placeholder
    let empty_stmts: List<Stmt> = []
    else_body_block = new_block(make_span(0, 0, 0, 0), empty_stmts)
    match else_block {
        Some(eb) => { else_body_block = eb },
        _ => {}
    }
    let wildcard_arm: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(else_body_block), none_guard)
    let mut arms: List<MatchArm> = []
    arms.push(success_arm)
    arms.push(wildcard_arm)
    return lower_match(st, scrutinee, arms)

// Mirrors `_lower_while_let`. Desugars to:
//   while true { match scrutinee { pat => body, _ => break } }
fn lower_while_let(st: LowerState, pattern: Pattern, scrutinee: Expr, body: Block) -> LowerState:
    let none_guard: Option<Expr> = none
    let success_arm: MatchArm = new_match_arm(pattern, MatchArmBody::BlockBody(body), none_guard)
    let break_stmts: List<Stmt> = [Stmt::Break]
    let break_block: Block = new_block(make_span(0, 0, 0, 0), break_stmts)
    let break_arm: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(break_block), none_guard)
    let mut arms: List<MatchArm> = []
    arms.push(success_arm)
    arms.push(break_arm)
    let match_expr: Expr = Expr::Match(scrutinee, arms)
    let body_stmts: List<Stmt> = [Stmt::ExprStmt(match_expr)]
    let while_body: Block = new_block(make_span(0, 0, 0, 0), body_stmts)
    return lower_while(st, Expr::BoolLit(true), while_body)

// Mirrors `_lower_let_else`. Strategy 2 (synthesized return):
//   let bound = match scrutinee { Some(bound) => bound, _ => else_block }
// Pattern shapes supported in v5.20.1:
//   - Pattern::Wildcard
//   - ConstructorPat with 0 args                       (e.g. None)
//   - ConstructorPat with 1 ident arg (Some(x), Ok(v), Err(e))
//   - ConstructorPat with 1 wildcard arg (Some(_))
// Multi-binding patterns deferred to v5.21.0+.
fn lower_let_else(st: LowerState, pattern: Pattern, scrutinee: Expr, else_block: Block) -> LowerState:
    let mut s: LowerState = st
    // Note: Python raises a RuntimeError at lower time when the else
    // block doesn't diverge. The bootstrap can't easily emit a
    // structured diagnostic from inside lower; we proceed with the
    // desugar and let downstream type-check or runtime catch it.
    // `block_diverges` is exposed for the cross-bootstrap test that
    // exercises the negative case.
    let _div: Bool = block_diverges(else_block)

    let none_guard: Option<Expr> = none
    let pk: String = pattern_kind(pattern)

    // Wildcard or 0-arg / 1-wildcard-arg constructor: emit as match
    // statement with no outer binding.
    if pk == "wildcard":
        let wild_body: Block = new_block(make_span(0, 0, 0, 0), [])
        let arm0: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(wild_body), none_guard)
        let arms_w: List<MatchArm> = [arm0]
        let mr_w: LowerResult = lower_match(s, scrutinee, arms_w)
        return mr_w.state

    if pk == "constructor":
        let pargs: List<Pattern> = pattern_ctor_args(pattern)
        let nargs: Int = len(pargs)
        let mut single_ident: Bool = false
        let mut single_wild: Bool = false
        if nargs == 1:
            let pak: String = pattern_kind(pargs[0])
            if pak == "ident" { single_ident = true }
            if pak == "wildcard" { single_wild = true }

        if nargs == 0 || single_wild:
            // No outer binding — emit as match-statement.
            let empty_stmts: List<Stmt> = []
            let succ_body: Block = new_block(make_span(0, 0, 0, 0), empty_stmts)
            let succ_arm: MatchArm = new_match_arm(pattern, MatchArmBody::BlockBody(succ_body), none_guard)
            let wild_arm: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(else_block), none_guard)
            let arms_le: List<MatchArm> = [succ_arm, wild_arm]
            let mr_le: LowerResult = lower_match(s, scrutinee, arms_le)
            return mr_le.state

        if single_ident:
            // `let Some(x) = opt else { ... }` →
            // `let x = match opt { Some(x) => x, _ => else_block }`.
            let bound_name: String = pattern_ident_name(pargs[0])
            let succ_arm2: MatchArm = new_match_arm(pattern, MatchArmBody::ExprBody(Expr::Ident(bound_name)), none_guard)
            let wild_arm2: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(else_block), none_guard)
            let arms_si: List<MatchArm> = [succ_arm2, wild_arm2]
            let synth_match: Expr = Expr::Match(scrutinee, arms_si)
            let none_t: Option<TypeExpr> = none
            return lower_let(s, bound_name, false, none_t, synth_match)

    // Unsupported pattern shape — fall through; produces a degenerate
    // empty match that evaluates the scrutinee for side effects.
    let only_match_body: Block = new_block(make_span(0, 0, 0, 0), [])
    let arm_only: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(only_match_body), none_guard)
    let arms_default: List<MatchArm> = [arm_only]
    let mr_def: LowerResult = lower_match(s, scrutinee, arms_default)
    return mr_def.state

// v5.20.1 Te.5.F.E divergence helpers. Mirrors `_block_diverges` /
// `_stmt_diverges` / `_expr_or_block_diverges` in lower.py — used by
// `lower_let_else` to enforce D5/D6.
fn block_diverges(block: Block) -> Bool:
    if len(block.stmts) == 0 { return false }
    return stmt_diverges(block.stmts[len(block.stmts) - 1])

fn stmt_diverges(s: Stmt) -> Bool:
    let sk: String = stmt_kind(s)
    if sk == "return" { return true }
    if sk == "break" { return true }
    if sk == "continue" { return true }
    if sk == "expr_stmt":
        let e: Expr = stmt_expr(s)
        let ek: String = expr_kind(e)
        if ek == "call":
            let callee: Expr = expr_call_callee(e)
            if expr_kind(callee) == "ident":
                let cn: String = expr_ident_name(callee)
                if cn == "panic" { return true }
                if cn == "abort" { return true }
                if cn == "exit" { return true }
        if ek == "match":
            let arms: List<MatchArm> = expr_match_arms(e)
            if len(arms) == 0 { return false }
            let mut i: Int = 0
            for _ in 0..200:
                if i >= len(arms) { return true }
                if !match_arm_body_diverges(arms[i].body) { return false }
                i = i + 1
            return true
        if ek == "if":
            let then_b: Block = expr_if_then(e)
            if !block_diverges(then_b) { return false }
            let else_opt: Option<ElseClause> = expr_if_else(e)
            match else_opt {
                Some(ec) => {
                    let eck: String = else_clause_kind(ec)
                    if eck == "else_block":
                        return block_diverges(else_clause_block(ec))
                    return false
                },
                _ => { return false }
            }
    return false

fn match_arm_body_diverges(body: MatchArmBody) -> Bool:
    let bk: String = match_arm_body_kind(body)
    if bk == "block":
        return block_diverges(match_arm_body_block(body))
    let synth_stmt: Stmt = Stmt::ExprStmt(match_arm_body_expr(body))
    return stmt_diverges(synth_stmt)

// ---------------------------------------------------------------------------
// v5.20.1 Te.5.F.C — Struct update lowering
// ---------------------------------------------------------------------------

// Lower `new T { x: 5, ..base }` (and `new T { ..base }`) by synthesizing
// a regular Construct whose fields are in struct-declaration order:
// overrides slotted by name, holes filled with `__mn_base_N.<field>`
// accesses. Mirrors `mapanare/lower.py::_lower_struct_update`.
fn lower_struct_update(st: LowerState, name: String, overrides: List<FieldInit>, base: Expr) -> LowerResult:
    let mut s: LowerState = st

    // Resolve full field list. Reject unknown structs.
    if !is_struct_name(s, name):
        return lower_construct(s, name, overrides)
    let field_names: List<String> = get_struct_field_names(s, name)
    let nfn: Int = len(field_names)

    // Synthesize a fresh base tmp name. Use a dedicated counter so
    // tmp_counter stays byte-identical to the manual long form.
    let base_idx: Int = s.struct_update_counter
    s.struct_update_counter = base_idx + 1
    let base_tmp_name: String = "__mn_base_" + toString(base_idx)

    // Lower the base expression once and register it under the
    // synthesized name so later FieldAccess(Ident(base_tmp_name), ...)
    // lookups find the same Value.
    //
    // The bootstrap's `define_var` semantically registers an alloca
    // *pointer*; lower_identifier then emits a Load on lookup. Mirror
    // that contract here: alloca + store + define_var(addr).
    let base_r: LowerResult = lower_expr(s, base)
    s = base_r.state
    let struct_ty_b: MIRType = mir_struct(name)
    let base_addr: Value = new_value("%" + base_tmp_name + ".addr", struct_ty_b)
    s = emit_instr(s, Instruction::Alloca(base_addr, struct_ty_b))
    s = emit_instr(s, Instruction::Store(base_addr, base_r.value))
    s = define_var(s, base_tmp_name, base_addr, false)

    // Build the full FieldInit list in struct-declaration order.
    // Overrides take precedence; the rest are FieldAccess from base.
    let mut full_fields: List<FieldInit> = []
    let mut fi: Int = 0
    let novr: Int = len(overrides)
    for _ in 0..500:
        if fi < nfn:
            let fname: String = field_names[fi]
            let mut found_override: Bool = false
            let mut override_expr: Expr = Expr::NoneLit
            let mut oi: Int = 0
            for _ in 0..500:
                if oi < novr:
                    let ov: FieldInit = overrides[oi]
                    if ov.name == fname:
                        found_override = true
                        override_expr = ov.value
                        break
                    oi = oi + 1
            let mut val_expr: Expr = Expr::FieldAccess(Expr::Ident(base_tmp_name), fname)
            if found_override { val_expr = override_expr }
            let synth_fi: FieldInit = new FieldInit { span: make_span(0, 0, 0, 0), name: fname, value: val_expr }
            full_fields.push(synth_fi)
            fi = fi + 1

    return lower_construct(s, name, full_fields)

// ---------------------------------------------------------------------------
// Construct (struct literal) lowering
// ---------------------------------------------------------------------------

fn lower_construct(st: LowerState, name: String, field_inits: List<FieldInit>) -> LowerResult:
    let mut s: LowerState = st

    let nfields: Int = len(field_inits)

    // Lower each field value
    let mut vals: List<Value> = []
    let mut i: Int = 0
    for _ in 0..500:
        if i < nfields:
            let fi: FieldInit = field_inits[i]
            let val_r: LowerResult = lower_expr(s, fi.value)
            s = val_r.state
            vals.push(val_r.value)
            i = i + 1

    // Emit as Call to "__new_<StructName>" (emitter handles this specially)
    let struct_ty: MIRType = mir_struct(name)
    let dest_r: LowerResult = make_value(s, struct_ty, "t")
    s = emit_instr(dest_r.state, Instruction::Call(dest_r.value, "__new_" + name, vals))
    // v5.4.4 — struct literal takes ownership of each field expression.
    s = emit_move_vals(s, vals)
    return new_lower_result(dest_r.value, s)

// v5.6.13 Layer 1 extension — destination-passing variant of
// `__new_<Struct>` constructor lowering, mirroring v5.6.12's
// lower_list_typed_into. Used by lower_let when the value is a
// struct constructor. Pairs each positional arg with the struct's
// declared field name (matching lower_call_by_name's __new_ branch
// at line ~2374), then emits `Instruction::StructInit` with a
// caller-supplied dest_name instead of a fresh tmp. The emitter's
// renamed `.addr` scratch (see emit_struct_init / emit_struct_init
// _from_values) then materializes `%<dest_name>.addr` — which IS
// the let's binding alloca, eliminating the duplicate alloca + the
// load+store dance at the let boundary.
//
// Mirrors Rust's destination-passing codegen (PlaceRef in
// rustc_codegen_llvm) for non-list aggregate types.
fn lower_struct_new_into(st: LowerState, struct_name: String, arg_exprs: List<Expr>, dest_name: String) -> LowerResult:
    let mut s: LowerState = st

    // Lower each constructor argument (parallel to lower_call's arg
    // pre-lowering at line ~1644).
    let mut args: List<Value> = []
    let mut i: Int = 0
    let nae: Int = len(arg_exprs)
    for _ in 0..500:
        if i < nae:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            args.push(arg_r.value)
            i = i + 1

    // Pair positional args with declared field names — same logic
    // as lower_call_by_name's __new_ branch at line ~2380.
    let field_names: List<String> = get_struct_field_names(s, struct_name)
    let struct_ty: MIRType = mir_struct(struct_name)
    let mut field_pairs: List<FieldPair> = []
    let mut fi: Int = 0
    let nfn: Int = len(field_names)
    let na: Int = len(args)
    for _ in 0..500:
        if fi < nfn:
            if fi < na:
                let fp: FieldPair = new_field_pair(field_names[fi], args[fi])
                field_pairs.push(fp)
                fi = fi + 1

    // Use caller-supplied dest_name (e.g. "%foo3") instead of
    // fresh-tmp. tmp_counter is NOT bumped here; the caller already
    // reserved the slot when it picked the variable's name.
    let dest_val: Value = new_value(dest_name, struct_ty)
    s = emit_instr(s, Instruction::StructInit(dest_val, struct_ty, field_pairs))
    // v5.4.4 — StructInit takes ownership of each field value.
    s = emit_move_fields(s, field_pairs)
    return new_lower_result(dest_val, s)

// ---------------------------------------------------------------------------
// Signal expression lowering
// ---------------------------------------------------------------------------

fn lower_signal_expr(st: LowerState, inner: Expr) -> LowerResult:
    let init_r: LowerResult = lower_expr(st, inner)
    let dest_r: LowerResult = make_value(init_r.state, mir_signal(), "t")
    let s: LowerState = emit_instr(dest_r.state, Instruction::SignalInit(dest_r.value, mir_signal(), init_r.value))
    new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Assignment lowering
// ---------------------------------------------------------------------------

// v5.6.10 Ve.2 residual helper — return the element-type hint for an
// assignment of `[]` to a `mut` typed `List<T>` variable. Mirrors the
// v5.6.7 `lower_let_list_hint` pattern but pulls the hint from the
// variable's alloca type instead of an explicit annotation. Returns
// `mir_unknown()` whenever the hint cannot be recovered, letting the
// caller fall through to `lower_expr` and the 384-byte safety floor in
// `emit_list_init`.
fn lower_assign_list_hint(st: LowerState, target: Expr, value: Expr) -> MIRType:
    if expr_kind(value) != "list_lit" { return mir_unknown() }
    if expr_kind(target) != "ident" { return mir_unknown() }
    let tname: String = expr_ident_name(target)
    let opt_addr: Option<Value> = lookup_var(st, tname)
    match opt_addr {
        Some(addr) => {
            if addr.ty.kind == TK_LIST() && len(addr.ty.args) > 0 {
                return addr.ty.args[0]
            }
            return mir_unknown()
        },
        _ => { return mir_unknown() }
    }

fn lower_assign(st: LowerState, target: Expr, op: String, value: Expr) -> LowerResult:
    // v5.6.10 — empty-list reassignment elem_ty hint. Same pattern as
    // v5.6.7's `lower_let`: route `xs = []` through `lower_list_typed`
    // when the variable's alloca carries a `List<T>` type. Without
    // this, the RHS lowers via `lower_list → lower_list_typed(... mir_unknown())`
    // and `emit_list_init` falls through to the 384-byte safety floor.
    let hint_elem_asgn: MIRType = lower_assign_list_hint(st, target, value)
    let val_r: LowerResult = if hint_elem_asgn.kind != TK_UNKNOWN() {
            lower_list_typed(st, expr_list_elements(value), hint_elem_asgn)
        } else {
            lower_expr(st, value)
        }
    let mut s: LowerState = val_r.state

    let tk: String = expr_kind(target)
    if tk == "ident":
        let name: String = expr_ident_name(target)
        if op != "=":
            // Compound assignment: x += 1 → x = x + 1
            let old_r: LowerResult = lower_identifier(s, name)
            s = old_r.state
            let op_str: String = strip_assign_op(op)
            let binop_opt: Option<BinOpKind> = binop_from_str(op_str)
            match binop_opt {
                Some(binop) => {
                    let result_r: LowerResult = make_value(s, old_r.value.ty, "t")
                    s = emit_instr(result_r.state, Instruction::BinOp(result_r.value, binop, old_r.value, val_r.value))

                    let var_opt_cmp: Option<Value> = lookup_var(s, name)
                    match var_opt_cmp {
                        Some(addr) => {
                            s = emit_instr(s, Instruction::Store(addr, result_r.value))
                            return new_lower_result(result_r.value, s)
                        },
                        _ => {}
                    }
                },
                _ => {}
            }

        let var_opt_asgn: Option<Value> = lookup_var(s, name)
        match var_opt_asgn {
            Some(addr) => {
                // Update var type if the new value is more specific
                // (e.g. from unknown/i64 to a concrete struct type)
                let mut store_addr: Value = addr
                if addr.ty.kind == TK_UNKNOWN() && val_r.value.ty.kind != TK_UNKNOWN() {
                    store_addr = new_value(addr.name, val_r.value.ty)
                    s = define_var(s, name, store_addr, true)
                }
                s = emit_instr(s, Instruction::Store(store_addr, val_r.value))
                return new_lower_result(val_r.value, s)
            },
            _ => {}
        }
        return new_lower_result(val_r.value, s)
    if tk == "field_access":
        // Pass the ALLOCA address (not loaded value) so the emitter
        // can GEP+store directly to the struct field.
        let fa_obj: Expr = expr_field_obj(target)
        let obj_r_fa: LowerResult = lower_expr(s, fa_obj)
        let obj_alloca: Value = find_expr_alloca(obj_r_fa.state, fa_obj, obj_r_fa)
        s = emit_instr(obj_r_fa.state, Instruction::FieldSet(obj_alloca, expr_field_name(target), val_r.value))
        return new_lower_result(val_r.value, s)
    if tk == "index":
        let obj_r_idx: LowerResult = lower_expr(s, expr_index_obj(target))
        let idx_r: LowerResult = lower_expr(obj_r_idx.state, expr_index_idx(target))
        s = emit_instr(idx_r.state, Instruction::IndexSet(obj_r_idx.value, idx_r.value, val_r.value))
        // v5.4.4 — map_set / list_set memcpy key+val into the container;
        // ownership transfers. Emit Move so drop glue skips the slot.
        s = emit_instr(s, Instruction::Move(idx_r.value))
        s = emit_instr(s, Instruction::Move(val_r.value))
        return new_lower_result(val_r.value, s)
    // v5.6.1 Sh.6 Phase 2 — `d[i, j] = val` for Tensor assignment. Lower as
    // a direct Call to __mn_tensor_set_{f64,i64}_nd (variadic); skip
    // IndexSet since the runtime owns the tensor storage.
    if tk == "tensor_index":
        let ti_obj: Expr = expr_ti_obj(target)
        let ti_idxs: List<Expr> = expr_ti_indices(target)
        let obj_r_ti: LowerResult = lower_expr(s, ti_obj)
        s = obj_r_ti.state

        let mut ti_idx_vals: List<Value> = []
        let mut ii: Int = 0
        let nti: Int = len(ti_idxs)
        for _ in 0..128:
            if ii < nti:
                let ir_ti: LowerResult = lower_expr(s, ti_idxs[ii])
                s = ir_ti.state
                ti_idx_vals.push(ir_ti.value)
                ii = ii + 1

        let elem_kind_ti: Int = tensor_elem_kind_of(obj_r_ti.value)
        let mut fn_name_ti: String = "__mn_tensor_set_f64_nd"
        if elem_kind_ti == TK_INT():
            fn_name_ti = "__mn_tensor_set_i64_nd"

        let rank_r_ti: LowerResult = make_value(s, mir_int(), "trank")
        s = emit_instr(rank_r_ti.state, Instruction::Const(rank_r_ti.value, mir_int(), toString(nti)))

        let mut all_args_ti: List<Value> = []
        all_args_ti.push(obj_r_ti.value)
        all_args_ti.push(rank_r_ti.value)
        for kk in 0..nti:
            all_args_ti.push(ti_idx_vals[kk])
        all_args_ti.push(val_r.value)

        let void_dest_ti: LowerResult = make_value(s, mir_void(), "tset")
        s = emit_instr(void_dest_ti.state, Instruction::Call(void_dest_ti.value, fn_name_ti, all_args_ti))
        return new_lower_result(val_r.value, s)
    return new_lower_result(val_r.value, s)

// Strip the '=' suffix from compound assignment operators: "+=" → "+"
fn strip_assign_op(op: String) -> String:
    if op == "+=" { return "+" }
    if op == "-=" { return "-" }
    if op == "*=" { return "*" }
    if op == "/=" { return "/" }
    if op == "%=" { return "%" }
    return op

// ---------------------------------------------------------------------------
// If/else lowering
// ---------------------------------------------------------------------------

fn build_if_phi_entries(then_term: Bool, else_term: Bool, then_val: Value, else_val: Value, then_lbl: String, else_lbl: String) -> List<PhiEntry>:
    let mut result: List<PhiEntry> = []
    // Add then arm if it has a usable value (not terminated, not void)
    let then_ok: Bool = !then_term
    let then_non_void: Bool = then_val.ty.kind != TK_VOID()
    if then_ok:
        if then_non_void:
            result.push(new_phi_entry(then_lbl, then_val))
    // Add else arm if it has a usable value
    let else_ok: Bool = !else_term
    let else_non_void: Bool = else_val.ty.kind != TK_VOID()
    if else_ok:
        if else_non_void:
            result.push(new_phi_entry(else_lbl, else_val))
    // If one arm has value but other is void, add undef for the void arm.
    // Ge.1r: zeroinitializer is a concrete all-zeros value that LLVM -O2
    // propagates through struct fields, corrupting list elem_size to 0.
    // undef means "don't care" and is safe for dead PHI branches.
    if len(result) == 1:
        let r0_pe: PhiEntry = result[0]
        let r0_val: Value = r0_pe.val
        let r0_ty: MIRType = r0_val.ty
        if then_ok:
            if !then_non_void:
                let zero_v_then: Value = new_value("undef", r0_ty)
                result.push(new_phi_entry(then_lbl, zero_v_then))
        if else_ok:
            if !else_non_void:
                let zero_v_else: Value = new_value("undef", r0_ty)
                result.push(new_phi_entry(else_lbl, zero_v_else))
    return result

fn infer_variant_payload_type(st: LowerState, subject: Value, variant_name: String, field_idx: Int) -> MIRType:
    // Result types
    if subject.ty.kind == TK_RESULT():
        if len(subject.ty.args) >= 2:
            if variant_name == "Ok" { return subject.ty.args[0] }
            if variant_name == "Err" { return subject.ty.args[1] }
    // Option types
    if subject.ty.kind == TK_OPTION():
        if len(subject.ty.args) >= 1:
            return subject.ty.args[0]
    // Regular enums — look up from module registry
    // Also handle kind=="struct" when the name is a registered enum
    // (happens when enum types appear as generic args, e.g. List<TomlValue>)
    let is_enum_kind: Bool = subject.ty.kind == TK_ENUM()
    let is_struct_actually_enum: Bool = subject.ty.kind == TK_STRUCT() && is_enum_name(st, subject.ty.name)
    if is_enum_kind || is_struct_actually_enum:
        let enum_name: String = subject.ty.name
        let mut ei: Int = 0
        let nei: Int = len(st.module.enums)
        for _ in 0..500:
            if ei < nei:
                let einfo: EnumInfo = st.module.enums[ei]
                if einfo.name == enum_name:
                    let mut vi: Int = 0
                    let nvi: Int = len(einfo.variants)
                    for _ in 0..500:
                        if vi < nvi:
                            let vinfo: EnumVariantInfo = einfo.variants[vi]
                            if vinfo.name == variant_name:
                                if field_idx < len(vinfo.payload_types):
                                    return vinfo.payload_types[field_idx]
                            vi = vi + 1
                ei = ei + 1
    return mir_unknown()

fn is_some_else_clause(clause: Option<ElseClause>) -> Bool:
    match clause:
        Some(c) => { return true }
        _ => { return false }

fn lower_else_clause(st: LowerState, clause_opt: Option<ElseClause>) -> LowerResult:
    match clause_opt {
        Some(clause) => {
            return lower_else_clause_inner(st, clause)
        },
        _ => { return new_lower_result(void_value(), st) }
    }

fn lower_else_clause_inner(st: LowerState, clause: ElseClause) -> LowerResult:
    if else_clause_kind(clause) == "else_block":
        return lower_block(st, else_clause_block(clause))
    return lower_if(st, else_clause_cond(clause), else_clause_then(clause), else_clause_else(clause))

fn lower_if(st: LowerState, cond: Expr, then_block: Block, else_clause: Option<ElseClause>) -> LowerResult:
    let cond_r: LowerResult = lower_expr(st, cond)
    let mut s: LowerState = cond_r.state

    // Save the current (entry) block index for the branch
    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let then_label_r: LowerResult = fresh_block_label(s, "if_then")
    s = then_label_r.state
    let then_label: String = then_label_r.value.name
    s = add_block(s, then_label)
    let then_idx: Int = s.current_block_idx

    let else_label_r: LowerResult = fresh_block_label(s, "if_else")
    s = else_label_r.state
    let else_label: String = else_label_r.value.name
    s = add_block(s, else_label)
    let else_idx: Int = s.current_block_idx

    // Reserve if_merge label (block added AFTER then/else — see below)
    let merge_label_r: LowerResult = fresh_block_label(s, "if_merge")
    s = merge_label_r.state
    let merge_label: String = merge_label_r.value.name

    // Branch (emitted in the entry block, not the merge block)
    s = set_block(s, entry_idx)
    s = emit_instr(s, Instruction::Branch(cond_r.value, then_label, else_label))

    // Then block
    s = set_block(s, then_idx)
    let then_r: LowerResult = lower_block(s, then_block)
    s = then_r.state
    let then_val: Value = then_r.value
    let then_exit_idx: Int = s.current_block_idx
    let then_terminated: Bool = current_block_terminated(s)
    if !then_terminated:
        s = emit_instr(s, Instruction::Jump(merge_label))

    // Else block
    s = set_block(s, else_idx)
    let mut else_val: Value = void_value()
    let has_else: Bool = is_some_else_clause(else_clause)
    if has_else:
        let else_r: LowerResult = lower_else_clause(s, else_clause)
        s = else_r.state
        else_val = else_r.value
    let else_exit_idx: Int = s.current_block_idx
    let else_terminated: Bool = current_block_terminated(s)
    if !else_terminated:
        s = emit_instr(s, Instruction::Jump(merge_label))

    // NOW add the if_merge block — after all inner blocks from then/else
    s = add_block(s, merge_label)
    let merge_idx: Int = s.current_block_idx

    // Merge block with phi — only include arms that reach the merge block
    s = set_block(s, merge_idx)

    let then_exit_label: String = get_block_label(s, then_exit_idx)
    let else_exit_label: String = get_block_label(s, else_exit_idx)

    // Build Phi directly — no list intermediary to avoid return-by-value bugs.
    // Determine what kind of Phi we need:
    // - Both arms have values → 2-entry Phi
    // - One arm has value, other void → 2-entry Phi with zeroinitializer
    // - Neither has value → void fallback
    let then_ok: Bool = !then_terminated
    let mut then_non_void: Bool = true
    if then_val.ty.kind == TK_VOID() { then_non_void = false }
    if then_val.ty.kind == TK_UNKNOWN() { then_non_void = false }
    if then_val.name == "%void" { then_non_void = false }
    let else_ok: Bool = !else_terminated
    let mut else_non_void: Bool = true
    if else_val.ty.kind == TK_VOID() { else_non_void = false }
    if else_val.ty.kind == TK_UNKNOWN() { else_non_void = false }
    if else_val.name == "%void" { else_non_void = false }

    // Determine case using simple flags
    let mut both: Bool = false
    let mut only_then: Bool = false
    let mut only_else: Bool = false
    if then_ok:
        if then_non_void:
            if else_ok:
                if else_non_void:
                    both = true
                if !else_non_void:
                    only_then = true
        if !then_non_void:
            if else_ok:
                if else_non_void:
                    only_else = true
    if !then_ok:
        if else_ok:
            if else_non_void:
                only_else = true

    let mut final_val: Value = void_value()
    if both:
        // When both arms produce values, check if types match.
        // Mismatched types (e.g., i64 vs Expr from side-effect if-else) → void fallback.
        let types_match: Bool = then_val.ty.kind == else_val.ty.kind
        if types_match:
            let mut ents_both: List<PhiEntry> = []
            ents_both.push(new_phi_entry(then_exit_label, then_val))
            ents_both.push(new_phi_entry(else_exit_label, else_val))
            let rr_both: LowerResult = make_value(s, then_val.ty, "if_result")
            s = rr_both.state
            s = emit_instr(s, Instruction::Phi(rr_both.value, ents_both))
            final_val = rr_both.value
    if only_then:
        let mut ents_then: List<PhiEntry> = []
        ents_then.push(new_phi_entry(then_exit_label, then_val))
        // Only include else branch if it's not terminated (reaches merge).
        // Use "undef" (not "zeroinitializer") for the missing-value branch:
        // zeroinitializer is a concrete all-zeros value that LLVM -O2 propagates
        // through struct fields, corrupting list elem_size to 0 (Ge.1r).
        // undef means "don't care" — LLVM can fold it without injecting zeros.
        if !else_terminated:
            let zero_v_t: Value = new_value("undef", then_val.ty)
            ents_then.push(new_phi_entry(else_exit_label, zero_v_t))
        let rr_then: LowerResult = make_value(s, then_val.ty, "if_result")
        s = rr_then.state
        s = emit_instr(s, Instruction::Phi(rr_then.value, ents_then))
        final_val = rr_then.value
    if only_else:
        let mut ents_else: List<PhiEntry> = []
        // Only include then branch if it's not terminated (reaches merge).
        // Use "undef" for the same reason as the only_then case (Ge.1r).
        if !then_terminated:
            let zero_v_e: Value = new_value("undef", else_val.ty)
            ents_else.push(new_phi_entry(then_exit_label, zero_v_e))
        ents_else.push(new_phi_entry(else_exit_label, else_val))
        let rr_else: LowerResult = make_value(s, else_val.ty, "if_result")
        s = rr_else.state
        s = emit_instr(s, Instruction::Phi(rr_else.value, ents_else))
        final_val = rr_else.value
    let is_void: Bool = !both && !only_then && !only_else
    if is_void:
        let rr_void: LowerResult = make_value(s, mir_void(), "t")
        s = emit_instr(rr_void.state, Instruction::Const(rr_void.value, mir_void(), ""))
        final_val = rr_void.value
        // Both branches terminated — merge block is unreachable.
        // Emit return terminator AFTER const so current_block_terminated returns true
        // and callers don't emit additional jumps to this block's successors.
        let both_terminated: Bool = then_terminated && else_terminated
        if both_terminated:
            let fn_ret: MIRType = get_current_fn_ret_type(s)
            let dummy_val: Value = new_value("zeroinitializer", fn_ret)
            s = emit_instr(s, Instruction::Return(Some(dummy_val)))
    return new_lower_result(final_val, s)

fn get_current_fn_ret_type(st: LowerState) -> MIRType:
    match st.current_fn:
        Some(f) => { return f.return_type }
        _ => { return mir_void() }

fn get_block_label(st: LowerState, idx: Int) -> String:
    if idx >= 0:
        if idx < len(st.fn_blocks):
            let bb: BasicBlock = st.fn_blocks[idx]
            return bb.label
    return "unknown"

// ---------------------------------------------------------------------------
// Match lowering
// ---------------------------------------------------------------------------

// Eu.4 (v5.26.1): does this or-pattern's alt set need an entry-time
// disambiguation (because at least one alt is a constructor with a
// literal sub-arg, e.g., `Some(0)`)?
fn or_pattern_has_literal_alt(alts: List<Pattern>) -> Bool:
    let mut i: Int = 0
    let n: Int = len(alts)
    for _ in 0..20:
        if i < n:
            let alt: Pattern = alts[i]
            if pattern_kind(alt) == "constructor":
                let aargs: List<Pattern> = pattern_ctor_args(alt)
                let mut j: Int = 0
                for _ in 0..10:
                    if j < len(aargs):
                        if pattern_kind(aargs[j]) == "literal" { return true }
                        j = j + 1
            i = i + 1
    return false

struct MatchBuildResult:
    state: LowerState
    arm_labels: List<String>
    arm_indices: List<Int>
    cases: List<SwitchCase>
    default_label: String

// Eu.4 (v5.26.1): track tag values seen so far so we never add a
// duplicate switch case (LLVM rejects "duplicate case value in switch").
// The first arm with each ctor/literal wins the switch entry; subsequent
// same-tag arms are reachable only through fall-through chaining.
fn list_contains_str(xs: List<String>, s: String) -> Bool:
    let mut i: Int = 0
    let n: Int = len(xs)
    for _ in 0..500:
        if i >= n { return false }
        if xs[i] == s { return true }
        i = i + 1
    return false

// Eu.4 (v5.26.1): the parser produces `None` / `Some` / `Ok` / `Err`
// as `IdentPat`, not `ConstructorPat`, even when they refer to the
// built-in Option/Result variants. `is_enum_variant` checks the
// user-registered enums and returns false for these built-ins, so the
// or-pattern alt-loop would mis-classify `None` as a binding ident
// (setting default_lbl) rather than a switch case. Recognize the four
// built-in variant names here.
fn is_builtin_variant_name(name: String) -> Bool:
    if name == "None" { return true }
    if name == "Some" { return true }
    if name == "Ok"   { return true }
    if name == "Err"  { return true }
    return false

fn build_match_arms(st: LowerState, arms: List<MatchArm>, merge_label: String) -> MatchBuildResult:
    let mut labels: List<String> = []
    let mut indices: List<Int> = []
    let mut cases: List<SwitchCase> = []
    let mut seen_tags: List<String> = []
    let mut default_lbl: String = merge_label
    let mut default_set: Bool = false
    let mut s: LowerState = st
    let mut i: Int = 0
    let n: Int = len(arms)
    for _ in 0..500:
        if i < n:
            let label_r: LowerResult = fresh_block_label(s, "match_arm")
            s = label_r.state
            let label: String = label_r.value.name
            s = add_block(s, label)
            labels.push(label)
            indices.push(s.current_block_idx)
            let arm: MatchArm = arms[i]
            let pk_arm: String = pattern_kind(arm.pattern)
            if pk_arm == "constructor":
                let ctor_n: String = pattern_ctor_name(arm.pattern)
                if !list_contains_str(seen_tags, ctor_n):
                    cases.push(new_switch_case(ctor_n, label))
                    seen_tags.push(ctor_n)
            if pk_arm == "literal":
                let lit_v: String = get_literal_value(pattern_literal_expr(arm.pattern))
                if !list_contains_str(seen_tags, lit_v):
                    cases.push(new_switch_case(lit_v, label))
                    seen_tags.push(lit_v)
            if pk_arm == "ident":
                let pn: String = pattern_ident_name(arm.pattern)
                if is_enum_variant(s, pn) || is_builtin_variant_name(pn):
                    if !list_contains_str(seen_tags, pn):
                        cases.push(new_switch_case(pn, label))
                        seen_tags.push(pn)
                else:
                    if !default_set { default_lbl = label; default_set = true }
            if pk_arm == "wildcard":
                if !default_set { default_lbl = label; default_set = true }
            // v4.35.0: or-patterns — add one switch case per alternative
            if pk_arm == "or":
                let alts: List<Pattern> = pattern_or_alts(arm.pattern)
                let mut oi: Int = 0
                for _ in 0..20:
                    if oi >= len(alts) { oi = len(alts) } else:
                        let alt: Pattern = alts[oi]
                        let apk: String = pattern_kind(alt)
                        if apk == "constructor":
                            let alt_ctor: String = pattern_ctor_name(alt)
                            if !list_contains_str(seen_tags, alt_ctor):
                                cases.push(new_switch_case(alt_ctor, label))
                                seen_tags.push(alt_ctor)
                        if apk == "literal":
                            let alt_lit: String = get_literal_value(pattern_literal_expr(alt))
                            if !list_contains_str(seen_tags, alt_lit):
                                cases.push(new_switch_case(alt_lit, label))
                                seen_tags.push(alt_lit)
                        if apk == "ident":
                            let apn: String = pattern_ident_name(alt)
                            if is_enum_variant(s, apn) || is_builtin_variant_name(apn):
                                if !list_contains_str(seen_tags, apn):
                                    cases.push(new_switch_case(apn, label))
                                    seen_tags.push(apn)
                            else:
                                if !default_set { default_lbl = label; default_set = true }
                        if apk == "wildcard":
                            if !default_set { default_lbl = label; default_set = true }
                        oi = oi + 1
            i = i + 1
    // Build result ONLY after all mutations are done — avoids aliasing
    // the LowerState (which shares fn_blocks buffers with s)
    return new MatchBuildResult { state: s, arm_labels: labels, arm_indices: indices, cases: cases, default_label: default_lbl }

fn lower_match(st: LowerState, subject: Expr, arms: List<MatchArm>) -> LowerResult:
    let subject_r: LowerResult = lower_expr(st, subject)
    let mut s: LowerState = subject_r.state

    // Save entry block for switch/branch emission
    let match_entry_idx: Int = s.current_block_idx

    // Reserve merge label (block added AFTER arms — see below)
    let merge_label_r: LowerResult = fresh_block_label(s, "match_merge")
    s = merge_label_r.state
    let merge_label: String = merge_label_r.value.name

    // Create arm blocks AND build switch cases.
    // Note: we use build_match_arms which returns accumulated results,
    // avoiding the for-loop local variable aliasing bug in the compiled binary.
    let build_r: MatchBuildResult = build_match_arms(s, arms, merge_label)
    s = build_r.state
    let arm_labels: List<String> = build_r.arm_labels
    let arm_indices: List<Int> = build_r.arm_indices
    let cases: List<SwitchCase> = build_r.cases
    let default_label: String = build_r.default_label

    // Emit switch or branch (in the entry block)
    s = set_block(s, match_entry_idx)
    // Eu.3 (v5.26.1): primitive subjects (Int/Bool/String) cannot pass
    // through `EnumTag` — `extractvalue i64 %v, 0` is rejected by LLVM
    // (i64 is not an aggregate). Bypass the switch entirely and emit a
    // sequential cascade — jump to arm[0]; each arm's entry re-tests its
    // pattern (literal / guard / wildcard) and falls through to the next
    // arm on miss. The arm-body loop below recognises primitive-subject
    // mode and inserts the implicit equality test for literal patterns.
    let subj_kind: Int = subject_r.value.ty.kind
    let is_primitive_subject: Bool = subj_kind == TK_INT() || subj_kind == TK_BOOL() || subj_kind == TK_STRING()
    if is_primitive_subject:
        if len(arm_labels) > 0:
            s = emit_instr(s, Instruction::Jump(arm_labels[0]))
        else:
            s = emit_instr(s, Instruction::Jump(merge_label))
    else if len(cases) > 0:
        let tag_r: LowerResult = make_value(s, subject_r.value.ty, "tag")
        s = tag_r.state
        s = emit_instr(s, Instruction::EnumTag(tag_r.value, subject_r.value))
        s = emit_instr(s, Instruction::Switch(tag_r.value, cases, default_label))
    else:
        if len(arm_labels) > 0:
            s = emit_instr(s, Instruction::Jump(arm_labels[0]))

    // Lower each arm
    let mut arm_results: List<PhiEntry> = []
    let mut ai: Int = 0
    let na_match: Int = len(arms)
    for _ in 0..500:
        if ai < na_match:
            let arm: MatchArm = arms[ai]
            let arm_idx: Int = arm_indices[ai]

            s = set_block(s, arm_idx)
            s = lower_push_scope(s)

            // Eu.4 (v5.26.1): or-pattern with literal-bearing alts (e.g.,
            // `Some(0) | None`) needs an entry-time disambiguating switch.
            // The outer match switch dedups (Some, label0)/(None, label0),
            // so both Some and None tags reach this arm. We must verify
            // which alt actually fires:
            //   * None alt → matches unconditionally (no payload to check)
            //   * Some(0) alt → matches only if payload == 0
            // On no match → fall through to next arm. Mirrors the v4.79.0
            // P3 jump-to-next discipline but for or-patterns.
            let or_next_label: String = if ai + 1 < na_match { arm_labels[ai + 1] } else { merge_label }
            let mut arm_block_idx: Int = arm_idx
            if pattern_kind(arm.pattern) == "or":
                let or_alts: List<Pattern> = pattern_or_alts(arm.pattern)
                if or_pattern_has_literal_alt(or_alts):
                    let body_run_r: LowerResult = fresh_block_label(s, "or_body")
                    s = body_run_r.state
                    let body_run_label: String = body_run_r.value.name
                    // Pass 1: build switch cases, allocating chk blocks for
                    // alts that need payload checks.
                    let mut alt_cases: List<SwitchCase> = []
                    let mut chk_labels: List<String> = []
                    let mut chk_ctors: List<String> = []
                    let mut chk_lit_exprs: List<Expr> = []
                    let mut oi2: Int = 0
                    for _ in 0..20:
                        if oi2 < len(or_alts):
                            let oalt: Pattern = or_alts[oi2]
                            let oalt_pk: String = pattern_kind(oalt)
                            if oalt_pk == "constructor":
                                let oc: String = pattern_ctor_name(oalt)
                                let oargs: List<Pattern> = pattern_ctor_args(oalt)
                                let mut o_lit_idx: Int = -1
                                let mut oa: Int = 0
                                for _ in 0..10:
                                    if oa < len(oargs):
                                        if o_lit_idx < 0 && pattern_kind(oargs[oa]) == "literal":
                                            o_lit_idx = oa
                                        oa = oa + 1
                                if o_lit_idx >= 0:
                                    let cr: LowerResult = fresh_block_label(s, "alt_chk")
                                    s = cr.state
                                    alt_cases.push(new_switch_case(oc, cr.value.name))
                                    chk_labels.push(cr.value.name)
                                    chk_ctors.push(oc)
                                    chk_lit_exprs.push(pattern_literal_expr(oargs[o_lit_idx]))
                                else:
                                    alt_cases.push(new_switch_case(oc, body_run_label))
                            // Eu.4 (v5.26.1): IdentPat("None") / "Some" / "Ok"
                            // / "Err" are parsed as ident, not constructor.
                            // They behave as no-payload constructors —
                            // direct alt match on tag.
                            if oalt_pk == "ident":
                                let oan: String = pattern_ident_name(oalt)
                                if is_enum_variant(s, oan) || is_builtin_variant_name(oan):
                                    alt_cases.push(new_switch_case(oan, body_run_label))
                            oi2 = oi2 + 1
                    // Emit dispatching switch in the arm-entry block.
                    // Tag dest type = subject type (TK_OPTION/TK_RESULT/TK_ENUM)
                    // so emit_enum_tag zexts to i64 — Switch dispatches on i64.
                    let or_tag_r: LowerResult = make_value(s, subject_r.value.ty, "ortag")
                    s = or_tag_r.state
                    s = emit_instr(s, Instruction::EnumTag(or_tag_r.value, subject_r.value))
                    s = emit_instr(s, Instruction::Switch(or_tag_r.value, alt_cases, or_next_label))
                    // Pass 2: emit each payload-check block.
                    let mut ck: Int = 0
                    for _ in 0..20:
                        if ck < len(chk_labels):
                            s = add_block(s, chk_labels[ck])
                            let pty: MIRType = infer_variant_payload_type(s, subject_r.value, chk_ctors[ck], 0)
                            let pr: LowerResult = make_value(s, pty, "altpay")
                            s = pr.state
                            s = emit_instr(s, Instruction::EnumPayload(pr.value, subject_r.value, chk_ctors[ck] + ":0"))
                            let lr: LowerResult = lower_expr(s, chk_lit_exprs[ck])
                            s = lr.state
                            let xr: LowerResult = make_value(s, mir_bool(), "altpaycmp")
                            s = xr.state
                            s = emit_instr(s, Instruction::BinOp(xr.value, BinOpKind::Eq, pr.value, lr.value))
                            s = emit_instr(s, Instruction::Branch(xr.value, body_run_label, or_next_label))
                            ck = ck + 1
                    // Continue arm body in the body_run block.
                    s = add_block(s, body_run_label)
                    arm_block_idx = s.current_block_idx

            // Bind pattern variables — uses helper + explicit typed temp
            // to preserve LowerState type (avoids emitter type tracking loss)
            let s_bound: LowerState = bind_arm_pattern(s, subject_r.value, arm.pattern)
            s = s_bound

            // Eu.3 (v5.26.1): under the primitive-subject sequential
            // cascade, literal patterns must re-test `subject == LIT` at
            // arm entry — without this, falling through from a previous
            // arm's failed guard would execute the wrong body (e.g., n=42
            // entering the `0 => "zero"` arm).
            if is_primitive_subject:
                let pk_lit: String = pattern_kind(arm.pattern)
                if pk_lit == "literal":
                    let lit_expr: Expr = pattern_literal_expr(arm.pattern)
                    let lit_r: LowerResult = lower_expr(s, lit_expr)
                    s = lit_r.state
                    let cmp_r: LowerResult = make_value(s, mir_bool(), "litcmp")
                    s = cmp_r.state
                    s = emit_instr(s, Instruction::BinOp(cmp_r.value, BinOpKind::Eq, subject_r.value, lit_r.value))
                    let lpass_r: LowerResult = fresh_block_label(s, "lit_pass")
                    s = lpass_r.state
                    let lpass_label: String = lpass_r.value.name
                    let lfail_r: LowerResult = fresh_block_label(s, "lit_fail")
                    s = lfail_r.state
                    let lfail_label: String = lfail_r.value.name
                    s = emit_instr(s, Instruction::Branch(cmp_r.value, lpass_label, lfail_label))
                    s = add_block(s, lfail_label)
                    if ai + 1 < na_match {
                        s = emit_instr(s, Instruction::Jump(arm_labels[ai + 1]))
                    } else {
                        s = emit_instr(s, Instruction::Jump(merge_label))
                    }
                    s = add_block(s, lpass_label)

            // v4.79.0 (CARRY_FORWARD P3): guard fall-through — evaluate
            // guard, branch on result. On guard failure, jump to the next
            // arm's block (which re-binds pattern variables and re-checks
            // its own guard). This is the jump-to-next approach, which is
            // correct for the common case where successive arms match the
            // same scrutinee type (e.g., integer guards). The Python
            // pipeline uses a full decision-tree rebuild on guard failure
            // (lower.py:3281-3290) — that approach handles complex cases
            // where the next arm's constructor pattern differs. Porting
            // the full decision-tree approach requires build_decision_tree
            // in the self-hosted lowerer (future work).
            match arm.guard {
                Some(guard_expr) => {
                    let guard_r: LowerResult = lower_expr(s, guard_expr)
                    s = guard_r.state
                    let pass_r: LowerResult = fresh_block_label(s, "guard_pass")
                    s = pass_r.state
                    let pass_label: String = pass_r.value.name
                    let fail_r: LowerResult = fresh_block_label(s, "guard_fail")
                    s = fail_r.state
                    let fail_label: String = fail_r.value.name
                    s = emit_instr(s, Instruction::Branch(guard_r.value, pass_label, fail_label))
                    // Guard fail: jump to next arm (re-bind + re-check)
                    // or to merge if this is the last arm.
                    s = add_block(s, fail_label)
                    if ai + 1 < na_match {
                        let next_label: String = arm_labels[ai + 1]
                        s = emit_instr(s, Instruction::Jump(next_label))
                    } else {
                        s = emit_instr(s, Instruction::Jump(merge_label))
                    }
                    // Guard pass: continue to body
                    s = add_block(s, pass_label)
                },
                None => {}
            }

            // Lower arm body
            let arm_val_r: LowerResult = lower_arm_body(s, arm.body)
            s = arm_val_r.state

            let exit_label: String = get_block_label(s, s.current_block_idx)
            let arm_terminated: Bool = current_block_terminated(s)

            // Jump to merge if not terminated
            if !arm_terminated:
                s = emit_instr(s, Instruction::Jump(merge_label))
                // Track arm result for phi (include all arms that reach merge).
                // Ge.1r: use undef (not zeroinitializer) for void results —
                // zeroinitializer propagates zeros through struct fields at -O2.
                //
                // v5.20.1 Te.5.F.E: TK_UNKNOWN is no longer demoted to undef.
                // The let-else desugar produces match arms whose body is
                // `Expr::Ident(bound_name)` where the bound name was attached
                // by `bind_one_pattern_field` with payload type from
                // `infer_variant_payload_type` — for function-call scrutinees,
                // that resolves to TK_UNKNOWN. Demoting to undef forces phi
                // skip, then `lower_let` sees void and emits `alloca void`.
                // Treating TK_UNKNOWN as a real value lets the emitter resolve
                // the LLVM type from incoming values (`emit_mir_phi` step 1).
                let arm_kind: Int = arm_val_r.value.ty.kind
                if arm_kind == TK_VOID() || arm_val_r.value.name == "%void":
                    let zero_arm: Value = new_value("undef", arm_val_r.value.ty)
                    let pe_zero: PhiEntry = new_phi_entry(exit_label, zero_arm)
                    arm_results.push(pe_zero)
                else:
                    let pe_val: PhiEntry = new_phi_entry(exit_label, arm_val_r.value)
                    arm_results.push(pe_val)
            s = lower_pop_scope(s)
            ai = ai + 1

    // NOW add the merge block — after all arms, so arm-internal blocks
    // (from nested if/match) are emitted first, avoiding forward references.
    s = add_block(s, merge_label)
    let merge_idx: Int = s.current_block_idx

    // Add undef entry for switch default→merge path (Ge.1r: not zeroinitializer)
    if default_label == merge_label && len(arm_results) > 0:
        let entry_label: String = get_block_label(s, match_entry_idx)
        let first_pe: PhiEntry = arm_results[0]
        let first_val: Value = first_pe.val
        let zero_ty: MIRType = first_val.ty
        let zero_def: Value = new_value("undef", zero_ty)
        let def_pe: PhiEntry = new_phi_entry(entry_label, zero_def)
        arm_results.push(def_pe)

    // Merge block
    s = set_block(s, merge_idx)
    // Skip PHI when all arm results are undef (dead match result)
    let mut all_zero: Bool = true
    if len(arm_results) > 0:
        let mut zi: Int = 0
        for _ in 0..500:
            if zi < len(arm_results):
                if arm_results[zi].val.name != "undef" && arm_results[zi].val.name != "zeroinitializer" { all_zero = false }
                zi = zi + 1
    if len(arm_results) > 0 && !all_zero:
        let first_pe2: PhiEntry = arm_results[0]
        let first_val2: Value = first_pe2.val
        let phi_ty: MIRType = first_val2.ty
        let rr_phi: LowerResult = make_value(s, phi_ty, "match_result")
        s = rr_phi.state
        s = emit_instr(s, Instruction::Phi(rr_phi.value, arm_results))
        return new_lower_result(rr_phi.value, s)

    // All arms terminated (all have return/break) OR all arms produced
    // void results (statement-context match, e.g. v5.20.1 if-let
    // / while-let / let-else when used in a `fn main()` body).
    // Merge block may be unreachable but callers may reference the
    // result. When fn_ret is void, emitting `alloca void` is invalid
    // LLVM — return void_value() and let the caller drop the result.
    let fn_ret: MIRType = get_current_fn_ret_type(s)
    if fn_ret.kind == TK_VOID():
        return new_lower_result(void_value(), s)
    let rr_unreach: LowerResult = make_value(s, fn_ret, "match_result")
    s = rr_unreach.state
    let dummy_addr: Value = new_value(rr_unreach.value.name + ".dummy", fn_ret)
    s = emit_instr(s, Instruction::Alloca(dummy_addr, fn_ret))
    s = emit_instr(s, Instruction::Load(rr_unreach.value, dummy_addr))
    return new_lower_result(rr_unreach.value, s)

fn get_literal_value(expr: Expr) -> String:
    let ek: String = expr_kind(expr)
    if ek == "int_lit" { return toString(expr_int_val(expr)) }
    if ek == "float_lit" { return toString(expr_float_val(expr)) }
    if ek == "bool_lit" { if expr_bool_val(expr) { return "true" } else { return "false" } }
    if ek == "string_lit" { return expr_string_val(expr) }
    return ""

// ---------------------------------------------------------------------------
// Pretty-printer
// ---------------------------------------------------------------------------

// Bind pattern fields for a constructor pattern like Rect(w, h).
// Extracted from inline loop for clarity.
// Uses return-based iteration (return works, break doesn't).
fn has_non_zero_phi(entries: List<PhiEntry>) -> Bool:
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(entries) { return false }
        let pe: PhiEntry = entries[i]
        if pe.val.name != "zeroinitializer" { return true }
        i = i + 1
    return false

fn bind_arm_pattern(st: LowerState, subject_val: Value, pat: Pattern) -> LowerState:
    let pk: String = pattern_kind(pat)
    if pk == "constructor":
        return bind_pattern_fields(st, subject_val, pattern_ctor_name(pat), pattern_ctor_args(pat))
    if pk == "ident":
        return bind_ident_pattern(st, subject_val, pattern_ident_name(pat))
    // v4.35.0: or-patterns — bind from first alternative
    if pk == "or":
        let alts: List<Pattern> = pattern_or_alts(pat)
        if len(alts) > 0:
            return bind_arm_pattern(st, subject_val, alts[0])
    return st

fn bind_ident_pattern(st: LowerState, subject_val: Value, name: String) -> LowerState:
    if is_enum_variant(st, name) { return st }
    // Eu.3 (v5.26.1): uniquify the alloca SSA name. Pre-Eu.3, every
    // ident-pattern arm got `%<name>.addr` verbatim — under switch
    // dispatch this was harmless because most arms were unreachable, but
    // the primitive-subject sequential cascade reaches every arm and
    // LLVM rejects multiple `alloca` definitions with the same name.
    // Mirrors the pattern in bind_one_pattern_field (line ~4727).
    let mut s: LowerState = st
    let ident_addr: Value = new_value("%" + name + toString(s.tmp_counter) + ".addr", subject_val.ty)
    s.tmp_counter = s.tmp_counter + 1
    s = emit_instr(s, Instruction::Alloca(ident_addr, subject_val.ty))
    s = emit_instr(s, Instruction::Store(ident_addr, subject_val))
    s = define_var(s, name, ident_addr, false)
    return s

fn bind_one_pattern_field(st: LowerState, sub_pat: Pattern, subject: Value, variant_name: String, pi: Int) -> LowerState:
    if pattern_kind(sub_pat) != "ident" { return st }
    let var_name: String = pattern_ident_name(sub_pat)
    let pay_ty: MIRType = infer_variant_payload_type(st, subject, variant_name, pi)
    let payload_r: LowerResult = make_value(st, pay_ty, var_name)
    let mut s: LowerState = payload_r.state
    let indexed_name: String = variant_name + ":" + toString(pi)
    s = emit_instr(s, Instruction::EnumPayload(payload_r.value, subject, indexed_name))
    let payload_addr: Value = new_value("%" + var_name + toString(s.tmp_counter) + ".addr", pay_ty)
    s.tmp_counter = s.tmp_counter + 1
    s = emit_instr(s, Instruction::Alloca(payload_addr, pay_ty))
    s = emit_instr(s, Instruction::Store(payload_addr, payload_r.value))
    s = define_var(s, var_name, payload_addr, false)
    return s

fn bind_pattern_fields(st: LowerState, subject: Value, variant_name: String, sub_patterns: List<Pattern>) -> LowerState:
    let mut s: LowerState = st
    let mut pi: Int = 0
    for _ in 0..100:
        if pi >= len(sub_patterns) { return s }
        let sub_pat: Pattern = sub_patterns[pi]
        let s_next: LowerState = bind_one_pattern_field(s, sub_pat, subject, variant_name, pi)
        s = s_next
        pi = pi + 1
    return s

fn format_value(v: Value) -> String = v.name

fn format_type(t: MIRType) -> String = t.name

fn format_instruction(inst: Instruction) -> String:
    let k: String = instr_kind(inst)
    let d: Value = instr_dest(inst)
    if k == "const" { return d.name + " = const " + format_type(instr_const_type(inst)) + " " + instr_const_val(inst) }
    if k == "copy" { return d.name + " = copy " + instr_copy_src(inst).name }
    if k == "cast" { return d.name + " = cast " + instr_cast_src(inst).name + " to " + format_type(instr_cast_type(inst)) }
    if k == "binop" { return d.name + " = binop " + instr_binop_lhs(inst).name + ", " + instr_binop_rhs(inst).name }
    if k == "unaryop" { return d.name + " = unaryop " + instr_unaryop_operand(inst).name }
    if k == "struct_init" { return d.name + " = struct_init " + format_type(instr_struct_type(inst)) }
    if k == "field_get" { return d.name + " = field_get " + instr_fieldget_obj(inst).name + "." + instr_fieldget_name(inst) }
    if k == "field_set" { return "field_set " + instr_fieldset_obj(inst).name + "." + instr_fieldset_name(inst) + " = " + instr_fieldset_val(inst).name }
    if k == "list_init" { return d.name + " = list_init " + format_type(instr_list_type(inst)) }
    if k == "index_get" { return d.name + " = index_get " + instr_indexget_obj(inst).name + "[" + instr_indexget_idx(inst).name + "]" }
    if k == "index_set" { return "index_set " + instr_indexset_obj(inst).name + "[" + instr_indexset_idx(inst).name + "] = " + instr_indexset_val(inst).name }
    if k == "alloca" { return d.name + " = alloca " + format_type(instr_alloca_type(inst)) }
    if k == "load" { return d.name + " = load " + instr_load_ptr(inst).name }
    if k == "store" { return "store " + instr_store_val(inst).name + " to " + instr_store_ptr(inst).name }
    if k == "map_init" { return "map_init" }
    if k == "enum_init" { return d.name + " = enum_init " + format_type(instr_enum_type(inst)) + "::" + instr_enum_variant(inst) }
    if k == "enum_tag" { return d.name + " = enum_tag " + instr_enumtag_val(inst).name }
    if k == "enum_payload" { return d.name + " = enum_payload " + instr_enumpayload_val(inst).name + "::" + instr_enumpayload_variant(inst) }
    if k == "wrap_some" { return d.name + " = wrap_some " + instr_wrap_val(inst).name }
    if k == "wrap_none" { return d.name + " = wrap_none " + format_type(instr_wrapnone_type(inst)) }
    if k == "wrap_ok" { return d.name + " = wrap_ok " + instr_wrap_val(inst).name }
    if k == "wrap_err" { return d.name + " = wrap_err " + instr_wrap_val(inst).name }
    if k == "unwrap" { return d.name + " = unwrap " + instr_wrap_val(inst).name }
    if k == "call" { return d.name + " = call " + instr_call_fn(inst) + "(...)" }
    if k == "return":
        let val_opt: Option<Value> = instr_return_val(inst)
        match val_opt:
            Some(v) => { return "ret " + v.name }
            _ => { return "ret void" }
    if k == "jump" { return "jump " + instr_jump_target(inst) }
    if k == "branch" { return "branch " + instr_branch_cond(inst).name + ", " + instr_branch_true(inst) + ", " + instr_branch_false(inst) }
    if k == "switch" { return "switch " + instr_switch_tag(inst).name + " default " + instr_switch_default(inst) }
    if k == "agent_spawn" { return d.name + " = agent_spawn " + format_type(instr_agent_type(inst)) }
    if k == "agent_send" { return "agent_send" }
    if k == "agent_sync" { return "agent_sync" }
    if k == "signal_init" { return d.name + " = signal_init " + format_type(instr_signal_type(inst)) + " " + instr_signal_val(inst).name }
    if k == "signal_get" { return d.name + " = signal_get " + instr_signalget_sig(inst).name }
    if k == "signal_set" { return "signal_set " + instr_signalset_sig(inst).name + " = " + instr_signalset_val(inst).name }
    if k == "stream_op" { return "stream_op" }
    if k == "interp_concat" { return d.name + " = interp_concat [...]" }
    if k == "phi" { return d.name + " = phi [...]" }
    return "<unknown_instruction>"

fn pretty_print_block(bb: BasicBlock) -> String:
    let mut result: String = "  " + bb.label + ":\n"
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(bb.instructions) { return result }
        let inst: Instruction = bb.instructions[i]
        result = result + "    " + format_instruction(inst) + "\n"
        i = i + 1
    return result

fn pretty_print_function(f: MIRFunction) -> String:
    let mut params_str: String = ""
    let mut i: Int = 0
    let nfp: Int = len(f.params)
    for _ in 0..500:
        if i < nfp:
            let p: MIRParam = f.params[i]
            if i > 0 { params_str = params_str + ", " }
            params_str = params_str + p.name + ": " + format_type(p.ty)
            i = i + 1

    let header: String = "fn " + f.name + "(" + params_str + ") -> " + format_type(f.return_type)
    if len(f.blocks) == 0 { return header + " {}" }

    let mut result: String = header + " {\n"
    let mut bi: Int = 0
    let nfb: Int = len(f.blocks)
    for _ in 0..2000:
        if bi < nfb:
            let bb: BasicBlock = f.blocks[bi]
            result = result + pretty_print_block(bb)
            bi = bi + 1
    result = result + "}"
    return result

fn pretty_print_module(module: MIRModule) -> String:
    let mut result: String = ""
    if module.name != "":
        result = "module " + module.name + "\n\n"

    // Print structs
    let mut si_idx: Int = 0
    let nms: Int = len(module.structs)
    for _ in 0..500:
        if si_idx < nms:
            let s: StructInfo = module.structs[si_idx]
            result = result + "struct " + s.name + " {...}\n"
            si_idx = si_idx + 1

    // Print enums
    let mut ei: Int = 0
    let nme: Int = len(module.enums)
    for _ in 0..500:
        if ei < nme:
            let e: EnumInfo = module.enums[ei]
            result = result + "enum " + e.name + " {...}\n"
            ei = ei + 1

    if len(module.structs) > 0 { result = result + "\n" }
    if len(module.enums) > 0 { result = result + "\n" }

    // Print functions
    let mut fi: Int = 0
    let nmf: Int = len(module.functions)
    for _ in 0..2000:
        if fi < nmf:
            let f: MIRFunction = module.functions[fi]
            result = result + pretty_print_function(f) + "\n\n"
            fi = fi + 1

    return result

// ---------------------------------------------------------------------------
// MIR verifier
// ---------------------------------------------------------------------------

struct VerifyError:
    fn_name: String
    block_label: String
    message: String

fn new_verify_error(fn_name: String, block: String, msg: String) -> VerifyError = new VerifyError { fn_name: fn_name, block_label: block, message: msg }

fn verify_module(module: MIRModule) -> List<VerifyError>:
    let mut errors: List<VerifyError> = []
    for i in 0..len(module.functions):
        let f: MIRFunction = module.functions[i]
        let fn_errors: List<VerifyError> = verify_function(f)
        for j in 0..len(fn_errors):
            errors.push(fn_errors[j])
    return errors

fn verify_function(f: MIRFunction) -> List<VerifyError>:
    let mut errors: List<VerifyError> = []

    if len(f.blocks) == 0:
        let e: VerifyError = new_verify_error(f.name, "", "function has no basic blocks")
        errors.push(e)
        return errors

    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(f.blocks) { return errors }
        let bb: BasicBlock = f.blocks[i]
        let bb_errors: List<VerifyError> = verify_block(f.name, bb, f)
        let mut j: Int = 0
        let nbe: Int = len(bb_errors)
        for _ in 0..2000:
            if j < nbe:
                errors.push(bb_errors[j])
                j = j + 1
        i = i + 1
    return errors

fn verify_block(fn_name: String, bb: BasicBlock, f: MIRFunction) -> List<VerifyError>:
    let mut errors: List<VerifyError> = []

    if len(bb.instructions) == 0:
        let e_empty: VerifyError = new_verify_error(fn_name, bb.label, "block has no instructions")
        errors.push(e_empty)
        return errors

    // Check terminator
    let last: Instruction = bb.instructions[len(bb.instructions) - 1]
    if !is_terminator(last):
        let e_noterm: VerifyError = new_verify_error(fn_name, bb.label, "block does not end with a terminator")
        errors.push(e_noterm)

    // Check no terminators in the middle
    let mut i: Int = 0
    let nbi_m1: Int = len(bb.instructions) - 1
    for _ in 0..2000:
        if i < nbi_m1:
            let inst_mid: Instruction = bb.instructions[i]
            if is_terminator(inst_mid):
                let e_midterm: VerifyError = new_verify_error(fn_name, bb.label, "terminator at position " + toString(i) + " (not last)")
                errors.push(e_midterm)
            i = i + 1

    // Check phi nodes are at the start
    let mut seen_non_phi: Bool = false
    let mut phi_i: Int = 0
    let nbi_phi: Int = len(bb.instructions)
    for _ in 0..2000:
        if phi_i < nbi_phi:
            let inst_phi: Instruction = bb.instructions[phi_i]
            if instr_kind(inst_phi) == "phi":
                if seen_non_phi:
                    let e_phi: VerifyError = new_verify_error(fn_name, bb.label, "phi node after non-phi instruction")
                    errors.push(e_phi)
            else:
                seen_non_phi = true
            phi_i = phi_i + 1

    return errors

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

pub fn lower(program: Program, module_name: String) -> MIRModule:
    let mut st: LowerState = new_lower_state(module_name)

    // Pass 1: register declarations
    st = register_declarations(st, program)

    // Pass 2: lower function bodies
    st = lower_definitions(st, program)

    return st.module

// ===== emit_llvm_ir.mn =====
// emit_llvm_ir.mn — LLVM IR type constants and instruction string builders.
// Pure string-producing functions, shared by emit_llvm.mn.


// ---------------------------------------------------------------------------
// LLVM type constants (as string representations)
// ---------------------------------------------------------------------------

fn llvm_int() -> String = "i64"

fn llvm_float() -> String = "double"

fn llvm_bool() -> String = "i1"

fn llvm_char() -> String = "i8"

fn llvm_void() -> String = "void"

fn llvm_string() -> String = "{ptr, i64}"
    // v4.128.0: no inner space — matches Python emitter canonical form
    // (`{ptr, i64}`). Previously `{ ptr, i64 }` with spaces; the difference
    // propagated to every runtime declaration and was the dominant
    // character-level divergence in the A bucket.

// ---------------------------------------------------------------------------
// Composite type builders
// ---------------------------------------------------------------------------

fn llvm_option_type(inner: String) -> String = "{i1, " + inner + "}"

fn llvm_result_type(ok_ty: String, err_ty: String) -> String = "{i1, {" + ok_ty + ", " + err_ty + "}}"

fn llvm_tensor_type(elem_ty: String) -> String = "{ptr, i64, ptr, i64}"

fn llvm_map_type() -> String = "{ptr, i64}"

fn llvm_ptr() -> String = "ptr"

fn llvm_list_rt() -> String = "{ptr, i64, i64, i64, i64}"

// ---------------------------------------------------------------------------
// MIR type → LLVM type resolution
// ---------------------------------------------------------------------------

fn resolve_mir_type(t: MIRType) -> String:
    if t.kind == TK_INT() { return llvm_int() }
    if t.kind == TK_FLOAT() { return llvm_float() }
    if t.kind == TK_BOOL() { return llvm_bool() }
    if t.kind == TK_STRING() { return llvm_string() }
    if t.kind == TK_VOID() { return llvm_void() }
    if t.kind == TK_CHAR() { return llvm_char() }
    if t.kind == TK_LIST() { return llvm_list_rt() }
    if t.kind == TK_MAP() { return llvm_map_type() }
    if t.kind == TK_OPTION():
        // Universal type erasure: all Option types use {i1, ptr}.
        // The payload is stored via alloca and accessed through the ptr.
        // This ensures Option types are always consistent between
        // function signatures and match extraction.
        return llvm_option_type(llvm_ptr())
    if t.kind == TK_RESULT():
        if len(t.args) >= 2:
            let ok_ty: String = resolve_mir_type(t.args[0])
            let err_ty: String = resolve_mir_type(t.args[1])
            return llvm_result_type(ok_ty, err_ty)
        return llvm_result_type(llvm_ptr(), llvm_ptr())
    if t.kind == TK_SIGNAL() { return llvm_ptr() }
    if t.kind == TK_AGENT() { return llvm_ptr() }
    if t.kind == TK_STRUCT() { return "%struct." + t.name }
    if t.kind == TK_ENUM() { return "%enum." + t.name }
    if t.kind == TK_RANGE() { return "{i64, i64}" }
    if t.kind == TK_FN() { return llvm_ptr() }
    if t.kind == TK_UNKNOWN() { return llvm_int() }
    // v5.6.0 Sh.6: tensor values travel as opaque pointer (__mn_tensor_alloc
    // returns ptr; all __mn_tensor_* builtins accept ptr).
    if t.kind == TK_TENSOR() { return llvm_ptr() }
    return llvm_int()

// ---------------------------------------------------------------------------
// LLVM IR instruction builders (string-based)
// ---------------------------------------------------------------------------

fn llvm_alloca(name: String, ty: String) -> String = "  " + name + " = alloca " + ty

fn llvm_store(ty: String, value: String, ptr: String) -> String = "  store " + ty + " " + value + ", ptr " + ptr

fn llvm_load(name: String, ty: String, ptr: String) -> String = "  " + name + " = load " + ty + ", ptr " + ptr

// v4.32.0 Phase 1.2: signed integer arithmetic emits `nsw` for parity
// with the Python bootstrap emitter at emit_llvm_text.py:2060-2062. The
// `nsw` ("no signed wrap") modifier lets LLVM prove that i64 add/sub/mul
// won't overflow signed bounds, enabling a raft of downstream
// optimizations (InstCombine, LoopStrengthReduce, LoopVectorize).
// Unsigned overflow is still fine because Mapanare's Int is signed i64.
fn emit_add(name: String, ty: String, left: String, right: String) -> String = "  " + name + " = add nsw " + ty + " " + left + ", " + right

fn emit_sub(name: String, ty: String, left: String, right: String) -> String = "  " + name + " = sub nsw " + ty + " " + left + ", " + right

fn emit_mul(name: String, ty: String, left: String, right: String) -> String = "  " + name + " = mul nsw " + ty + " " + left + ", " + right

fn emit_sdiv(name: String, ty: String, left: String, right: String) -> String = "  " + name + " = sdiv " + ty + " " + left + ", " + right

fn emit_srem(name: String, ty: String, left: String, right: String) -> String = "  " + name + " = srem " + ty + " " + left + ", " + right

fn emit_fadd(name: String, left: String, right: String) -> String = "  " + name + " = fadd double " + left + ", " + right

fn emit_fsub(name: String, left: String, right: String) -> String = "  " + name + " = fsub double " + left + ", " + right

fn emit_fmul(name: String, left: String, right: String) -> String = "  " + name + " = fmul double " + left + ", " + right

fn emit_fdiv(name: String, left: String, right: String) -> String = "  " + name + " = fdiv double " + left + ", " + right

fn emit_frem(name: String, left: String, right: String) -> String = "  " + name + " = frem double " + left + ", " + right

fn emit_fneg(name: String, operand: String) -> String = "  " + name + " = fneg double " + operand

fn emit_neg(name: String, ty: String, operand: String) -> String = "  " + name + " = sub nsw " + ty + " 0, " + operand

fn emit_not(name: String, operand: String) -> String = "  " + name + " = xor i1 " + operand + ", true"

// ---------------------------------------------------------------------------
// Comparison instruction builders
// ---------------------------------------------------------------------------

fn emit_icmp(name: String, cmp: String, ty: String, left: String, right: String) -> String = "  " + name + " = icmp " + cmp + " " + ty + " " + left + ", " + right

fn emit_fcmp(name: String, cmp: String, left: String, right: String) -> String = "  " + name + " = fcmp o" + cmp + " double " + left + ", " + right

// ---------------------------------------------------------------------------
// Logical operators
// ---------------------------------------------------------------------------

fn emit_and_instr(name: String, left: String, right: String) -> String = "  " + name + " = and i1 " + left + ", " + right

fn emit_or_instr(name: String, left: String, right: String) -> String = "  " + name + " = or i1 " + left + ", " + right

// ---------------------------------------------------------------------------
// Control flow
// ---------------------------------------------------------------------------

fn emit_br(label: String) -> String = "  br label %" + label

fn emit_cbranch(cond: String, true_label: String, false_label: String) -> String = "  br i1 " + cond + ", label %" + true_label + ", label %" + false_label

fn emit_phi_instr(name: String, ty: String, val1: String, bb1: String, val2: String, bb2: String) -> String = "  " + name + " = phi " + ty + " [ " + val1 + ", %" + bb1 + " ], [ " + val2 + ", %" + bb2 + " ]"

fn emit_switch_hdr(subject: String, default_label: String) -> String = "  switch i64 " + subject + ", label %" + default_label + " ["

fn emit_switch_case(value: String, label: String) -> String = "    i64 " + value + ", label %" + label

// ---------------------------------------------------------------------------
// Function / call builders
// ---------------------------------------------------------------------------

fn emit_call_ir(name: String, ret_ty: String, callee: String, args: String) -> String:
    // v5.7.0 Sh.7: callees starting with `%` are SSA values (indirect
    // call through a closure-typed local) — emit without `@` prefix.
    if callee.starts_with("%"):
        return "  " + name + " = call " + ret_ty + " " + callee + "(" + args + ")"
    return "  " + name + " = call " + ret_ty + " @" + callee + "(" + args + ")"

fn emit_call_void(callee: String, args: String) -> String:
    if callee.starts_with("%"):
        return "  call void " + callee + "(" + args + ")"
    return "  call void @" + callee + "(" + args + ")"

fn emit_ret(ty: String, value: String) -> String = "  ret " + ty + " " + value

fn emit_ret_void() -> String = "  ret void"

// ---------------------------------------------------------------------------
// GEP / insertvalue / extractvalue builders
// ---------------------------------------------------------------------------

fn emit_gep(name: String, ty: String, ptr: String, idx: String) -> String = "  " + name + " = getelementptr inbounds " + ty + ", ptr " + ptr + ", i64 0, i64 " + idx

fn emit_insertvalue(name: String, struct_ty: String, agg: String, val: String, val_ty: String, idx: String) -> String = "  " + name + " = insertvalue " + struct_ty + " " + agg + ", " + val_ty + " " + val + ", " + idx

fn emit_extractvalue(name: String, struct_ty: String, agg: String, idx: String) -> String = "  " + name + " = extractvalue " + struct_ty + " " + agg + ", " + idx

fn emit_bitcast(name: String, src_ty: String, val: String, dst_ty: String) -> String = "  " + name + " = bitcast " + src_ty + " " + val + " to " + dst_ty

// ===== abi.mn =====
// abi.mn — ABI return-convention classifier for the self-hosted compiler.
// Ported from mapanare/abi.py at v5.0.4 (Cb.15).
//
// Pure classification logic — no EmitState dependency.
// The emitter wrapper use_sret_return() in emit_llvm.mn resolves type
// sizes via the struct/enum tables, then calls abi_classify_return_sret().
//
// Reference: mapanare/abi.py (Python, 99 LOC). This file must produce
// byte-identical classifications on every type in
// tests/llvm/test_abi_struct_return.py.
//
// v5.0.4 — closes Cb.15 (ABI.1 sret classifier is Python-only).

// ---------------------------------------------------------------------------
// Per-target classifiers
// ---------------------------------------------------------------------------

// System V AMD64 ABI §3.2.3 return classification.
//
// Aggregates <= 16 bytes whose eightbyte chunks are all INTEGER class
// return in rax + rdx. Larger aggregates use sret.
//
// Mapanare aggregates contain only integer-class fields (i64, i32, i8,
// i1, ptr), so every eightbyte classifies as INTEGER and the 16-byte
// size threshold is the only check needed.
fn abi_sysv_use_sret(total_size: Int) -> Bool:
    if total_size <= 16 { return false }
    return true

// Win64 x64 calling convention return classification.
//
// Only aggregates of exactly 1, 2, 4, or 8 bytes can be returned in
// rax. All other sizes use sret (hidden first parameter in rcx).
fn abi_win64_use_sret(total_size: Int) -> Bool:
    if total_size == 1 { return false }
    if total_size == 2 { return false }
    if total_size == 4 { return false }
    if total_size == 8 { return false }
    return true

// AArch64 AAPCS64 return classification.
//
// Aggregates <= 16 bytes return in x0 / x1. Larger aggregates use the
// indirect result register x8 (equivalent to sret).
fn abi_aapcs64_use_sret(total_size: Int) -> Bool:
    if total_size <= 16 { return false }
    return true

// v5.8.6 We.1: i686-w64-mingw32 / i386 cdecl return classification.
//
// Aggregates <= 8 bytes return in EAX:EDX register pair. Anything
// larger takes the sret hidden-first-arg path. Empirical probe with
// i686-w64-mingw32-gcc 13 confirms: struct sizes 12 / 16 / 24 / 64 /
// 80 all use sret; size 8 uses register pair. See SESSION_REPORT
// §Phase 0 for the assembly trace.
fn abi_i686_cdecl_use_sret(total_size: Int) -> Bool:
    if total_size <= 8 { return false }
    return true

// ---------------------------------------------------------------------------
// Unified classifier
// ---------------------------------------------------------------------------

// Classify whether a return type of the given byte size should use sret.
//
// Parameters:
//   is_aggregate — true if the type is a struct, enum, or inline aggregate
//                  (starts with "{", "%struct.", or "%enum.")
//   total_size   — ABI byte size of the type
//   target       — target triple string (e.g. "x86_64-unknown-linux-gnu")
//
// Returns true if sret is needed, false if the value fits in registers.
fn abi_classify_return_sret(is_aggregate: Bool, total_size: Int, target: String) -> Bool:
    // Scalars always return in a register.
    if !is_aggregate { return false }
    if total_size == 0 { return false }

    // Dispatch by target triple — mirrors abi.py::classify_return.
    // v5.8.6 We.1: i686 must come BEFORE the generic "windows" branch
    // because i686-w64-windows-gnu / i686-pc-windows-gnu would
    // otherwise route to Win64 rules. i686 cdecl uses a > 8 B sret
    // threshold, identical in shape to Win64 but at a different
    // boundary (Win64: only 1/2/4/8 B in regs; i686: any size <= 8).
    if target.starts_with("i686") { return abi_i686_cdecl_use_sret(total_size) }
    if target.starts_with("i386") { return abi_i686_cdecl_use_sret(total_size) }
    if target.contains("windows") { return abi_win64_use_sret(total_size) }
    if target.starts_with("aarch64") { return abi_aapcs64_use_sret(total_size) }
    // Default: System V AMD64
    return abi_sysv_use_sret(total_size)

// ===== mir_opt.mn =====
// mir_opt.mn — MIR optimizer for the Mapanare self-hosted compiler.
// Seven passes: constant folding, constant propagation, dead block elimination,
// strength reduction, function inlining, LICM, escape analysis.
// v4.97.0: ported all Arc 11-12 optimization passes from Python bootstrap.
// Wired into compile() after lower(), before emit().


// ---------------------------------------------------------------------------
// Pass 1: Constant folding
// Fold BinOp(Const(a), op, Const(b)) → Const(result)
// ---------------------------------------------------------------------------

fn fold_int_binop(op: BinOpKind, a: Int, b: Int) -> Option<Int>:
    match op:
        Add => { return Some(a + b) }
        Sub => { return Some(a - b) }
        Mul => { return Some(a * b) }
        _ => { return none }

fn try_fold_instruction(inst: Instruction) -> Option<Instruction>:
    let ik: String = instr_kind(inst)
    if ik != "binop" { return none }
    let lhs: Value = instr_binop_lhs(inst)
    let rhs: Value = instr_binop_rhs(inst)
    let op: BinOpKind = instr_binop_op(inst)
    let dest: Value = instr_dest(inst)
    // Both operands must be named constants (format: literal value string)
    // Check if lhs and rhs names are integer literals
    if lhs.ty.kind != TK_INT() { return none }
    if rhs.ty.kind != TK_INT() { return none }
    // Names that start with % are SSA temps, not constants
    if lhs.name.starts_with("%") { return none }
    if rhs.name.starts_with("%") { return none }
    let a: Int = int(lhs.name)
    let b: Int = int(rhs.name)
    let result_opt: Option<Int> = fold_int_binop(op, a, b)
    match result_opt {
        Some(r) => {
            return Some(Instruction::Const(dest, mir_int(), toString(r)))
        },
        _ => { return none }
    }

fn constant_fold_block(bb: BasicBlock) -> BasicBlock:
    let mut new_instrs: List<Instruction> = []
    let mut i: Int = 0
    let mut changed: Bool = false
    for _ in 0..10000:
        if i >= len(bb.instructions):
            if changed:
                return new BasicBlock { label: bb.label, instructions: new_instrs }
            return bb
        let inst: Instruction = bb.instructions[i]
        let folded: Option<Instruction> = try_fold_instruction(inst)
        match folded {
            Some(new_inst) => {
                new_instrs.push(new_inst)
                changed = true
            },
            _ => { new_instrs.push(inst) }
        }
        i = i + 1
    return bb

fn constant_fold_function(f: MIRFunction) -> MIRFunction:
    let mut new_blocks: List<BasicBlock> = []
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(f.blocks):
            return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }
        new_blocks.push(constant_fold_block(f.blocks[i]))
        i = i + 1
    return f

// ---------------------------------------------------------------------------
// Pass 2: Constant propagation
// If Const(dest, ty, val), replace all uses of dest.name with the constant value.
// ---------------------------------------------------------------------------

struct ConstEntry:
    name: String
    value: String
    ty: MIRType

fn find_const(consts: List<ConstEntry>, name: String) -> Option<String>:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(consts) { return none }
        if consts[i].name == name { return Some(consts[i].value) }
        i = i + 1
    return none

fn find_const_ty(consts: List<ConstEntry>, name: String) -> MIRType:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(consts) { return mir_unknown() }
        if consts[i].name == name { return consts[i].ty }
        i = i + 1
    return mir_unknown()

fn replace_value(v: Value, consts: List<ConstEntry>) -> Value:
    let opt: Option<String> = find_const(consts, v.name)
    match opt {
        Some(cv) => {
            let ct: MIRType = find_const_ty(consts, v.name)
            return new Value { name: cv, ty: ct }
        },
        _ => { return v }
    }

fn propagate_in_instruction(inst: Instruction, consts: List<ConstEntry>) -> Instruction:
    let ik: String = instr_kind(inst)
    // Replace operands in BinOp
    if ik == "binop":
        let lhs: Value = replace_value(instr_binop_lhs(inst), consts)
        let rhs: Value = replace_value(instr_binop_rhs(inst), consts)
        return Instruction::BinOp(instr_dest(inst), instr_binop_op(inst), lhs, rhs)
    // Replace source in Copy
    if ik == "copy":
        let src: Value = replace_value(instr_copy_src(inst), consts)
        return Instruction::Copy(instr_dest(inst), src)
    return inst

fn const_prop_function(f: MIRFunction) -> MIRFunction:
    // Collect all Const definitions across all blocks
    let mut consts: List<ConstEntry> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let bb: BasicBlock = f.blocks[bi]
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(bb.instructions) { break }
            let inst: Instruction = bb.instructions[ii]
            if instr_kind(inst) == "const":
                let dest: Value = instr_dest(inst)
                let cval: String = instr_const_val(inst)
                // Only propagate simple integer constants (safe for BinOp operands)
                if len(cval) > 0 && dest.name.starts_with("%") && dest.ty.kind == TK_INT():
                    let entry: ConstEntry = new ConstEntry { name: dest.name, value: cval, ty: dest.ty }
                    consts.push(entry)
            ii = ii + 1
        bi = bi + 1
    if len(consts) == 0 { return f }
    // Propagate constants through instructions
    let mut new_blocks: List<BasicBlock> = []
    let mut bi2: Int = 0
    for _ in 0..5000:
        if bi2 >= len(f.blocks) { break }
        let bb: BasicBlock = f.blocks[bi2]
        let mut new_instrs: List<Instruction> = []
        let mut ji: Int = 0
        for _ in 0..10000:
            if ji >= len(bb.instructions) { break }
            new_instrs.push(propagate_in_instruction(bb.instructions[ji], consts))
            ji = ji + 1
        new_blocks.push(new BasicBlock { label: bb.label, instructions: new_instrs })
        bi2 = bi2 + 1
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }

// ---------------------------------------------------------------------------
// Pass 3: Dead block elimination
// Walk from entry block, mark reachable blocks, delete unreachable
// ---------------------------------------------------------------------------

fn collect_targets(inst: Instruction) -> List<String>:
    let ik: String = instr_kind(inst)
    let mut targets: List<String> = []
    if ik == "jump":
        targets.push(instr_jump_target(inst))
    if ik == "branch":
        targets.push(instr_branch_true(inst))
        targets.push(instr_branch_false(inst))
    if ik == "switch":
        // Switch: collect case targets + default
        let cases: List<SwitchCase> = instr_switch_cases(inst)
        let mut ci: Int = 0
        for _ in 0..200:
            if ci >= len(cases) { break }
            targets.push(cases[ci].block_label)
            ci = ci + 1
        targets.push(instr_switch_default(inst))
    targets

fn is_in_list(name: String, lst: List<String>) -> Bool:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(lst) { return false }
        if lst[i] == name { return true }
        i = i + 1
    return false

fn clean_phi_entries(inst: Instruction, reachable: List<String>) -> Instruction:
    let entries: List<PhiEntry> = instr_phi_entries(inst)
    let mut kept: List<PhiEntry> = []
    let mut ei: Int = 0
    for _ in 0..200:
        if ei >= len(entries) { break }
        if is_in_list(entries[ei].block_label, reachable):
            kept.push(entries[ei])
        ei = ei + 1
    if len(kept) == len(entries) { return inst }
    return Instruction::Phi(instr_dest(inst), kept)

fn phi_needs_cleaning(bb: BasicBlock, reachable: List<String>) -> Bool:
    // Check if any PHI in this block references a non-reachable block
    let mut ji: Int = 0
    for _ in 0..10000:
        if ji >= len(bb.instructions) { break }
        let inst: Instruction = bb.instructions[ji]
        if instr_kind(inst) == "phi":
            let entries: List<PhiEntry> = instr_phi_entries(inst)
            let mut ei: Int = 0
            for _ in 0..200:
                if ei >= len(entries) { break }
                if is_in_list(entries[ei].block_label, reachable) == false:
                    return true
                ei = ei + 1
        ji = ji + 1
    return false

fn clean_phis_in_block(bb: BasicBlock, reachable: List<String>) -> BasicBlock:
    // Only rebuild if this block actually has PHIs referencing removed blocks
    if phi_needs_cleaning(bb, reachable) == false { return bb }
    let saved_label: String = bb.label
    let mut new_instrs: List<Instruction> = []
    let mut ji: Int = 0
    for _ in 0..10000:
        if ji >= len(bb.instructions) { break }
        let inst: Instruction = bb.instructions[ji]
        if instr_kind(inst) == "phi":
            let cleaned: Instruction = clean_phi_entries(inst, reachable)
            new_instrs.push(cleaned)
        else:
            new_instrs.push(inst)
        ji = ji + 1
    return new BasicBlock { label: saved_label, instructions: new_instrs }

fn block_terminator_targets(bb: BasicBlock) -> List<String>:
    // Only check the last instruction (terminator) — matches Python _compute_reachable
    if len(bb.instructions) == 0:
        let empty: List<String> = []
        return empty
    let last: Instruction = bb.instructions[len(bb.instructions) - 1]
    return collect_targets(last)

fn find_block_by_label(blocks: List<BasicBlock>, label: String) -> Option<BasicBlock>:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(blocks) { return none }
        if blocks[i].label == label { return Some(blocks[i]) }
        i = i + 1
    return none

fn add_targets_to_worklist(targets: List<String>, reachable: List<String>, worklist: List<String>) -> Bool:
    let mut ti: Int = 0
    let mut added: Bool = false
    for _ in 0..500:
        if ti >= len(targets) { break }
        if is_in_list(targets[ti], reachable) == false:
            reachable.push(targets[ti])
            worklist.push(targets[ti])
            added = true
        ti = ti + 1
    added

fn collect_phi_refs(f: MIRFunction) -> List<String>:
    // Collect all block labels referenced by PHI entries in any block
    let mut refs: List<String> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            if instr_kind(f.blocks[bi].instructions[ii]) == "phi":
                let entries: List<PhiEntry> = instr_phi_entries(f.blocks[bi].instructions[ii])
                let mut ei: Int = 0
                for _ in 0..200:
                    if ei >= len(entries) { break }
                    if is_in_list(entries[ei].block_label, refs) == false:
                        refs.push(entries[ei].block_label)
                    ei = ei + 1
            ii = ii + 1
        bi = bi + 1
    refs

fn dead_block_elim_function(f: MIRFunction) -> MIRFunction:
    if len(f.blocks) <= 1 { return f }
    // Fixed-point reachability: start with entry, iterate until stable
    let mut reachable: List<String> = []
    reachable.push(f.blocks[0].label)
    let mut changed: Bool = true
    for _ in 0..1000:
        if changed == false { break }
        changed = false
        let mut bi: Int = 0
        for _ in 0..5000:
            if bi >= len(f.blocks) { break }
            if is_in_list(f.blocks[bi].label, reachable):
                let targets: List<String> = block_terminator_targets(f.blocks[bi])
                let mut ti: Int = 0
                for _ in 0..500:
                    if ti >= len(targets) { break }
                    if is_in_list(targets[ti], reachable) == false:
                        reachable.push(targets[ti])
                        changed = true
                    ti = ti + 1
            bi = bi + 1
    // Also keep blocks referenced by PHI entries to avoid dangling labels
    let phi_refs: List<String> = collect_phi_refs(f)
    let mut pi: Int = 0
    for _ in 0..5000:
        if pi >= len(phi_refs) { break }
        if is_in_list(phi_refs[pi], reachable) == false:
            reachable.push(phi_refs[pi])
        pi = pi + 1
    // Extend reachability from PHI-preserved blocks (they may jump to other blocks)
    let mut changed2: Bool = true
    for _ in 0..1000:
        if changed2 == false { break }
        changed2 = false
        let mut bi2: Int = 0
        for _ in 0..5000:
            if bi2 >= len(f.blocks) { break }
            if is_in_list(f.blocks[bi2].label, reachable):
                let targets2: List<String> = block_terminator_targets(f.blocks[bi2])
                let mut ti2: Int = 0
                for _ in 0..500:
                    if ti2 >= len(targets2) { break }
                    if is_in_list(targets2[ti2], reachable) == false:
                        reachable.push(targets2[ti2])
                        changed2 = true
                    ti2 = ti2 + 1
            bi2 = bi2 + 1
    // v4.30.0 Phase 3.3: walk the surviving blocks once and drop PHI
    // entries that reference blocks that did NOT survive. Prior to
    // v4.30.0, ``clean_phis_in_block`` was defined (line 262) but
    // never invoked — Rattler #6 flagged it as dead-code-in-the-
    // optimizer. Without this step, the pass could leave a PHI
    // referencing a block that the block removal loop just deleted,
    // which is the "dangling label" class of bug.
    let mut cleaned_blocks: List<BasicBlock> = []
    let mut ki: Int = 0
    for _ in 0..5000:
        if ki >= len(f.blocks) { break }
        if is_in_list(f.blocks[ki].label, reachable):
            let cleaned: BasicBlock = clean_phis_in_block(f.blocks[ki], reachable)
            cleaned_blocks.push(cleaned)
        ki = ki + 1
    if len(cleaned_blocks) >= len(f.blocks):
        // Same block count — either nothing was dropped, or every
        // dropped block had already been pruned by a previous pass.
        // Still return the cleaned version because PHI entries may
        // have been trimmed even when no block vanished.
        return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: cleaned_blocks, decorators: f.decorators, is_public: f.is_public }
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: cleaned_blocks, decorators: f.decorators, is_public: f.is_public }

// ---------------------------------------------------------------------------
// Pass 4: Strength reduction (v4.97.0)
// x % 2^n → x & (2^n - 1) — replace modulo by power-of-two with bitmask
// ---------------------------------------------------------------------------

fn is_power_of_two(n: Int) -> Bool:
    if n <= 0 { return false }
    // n & (n-1) == 0 means n is a power of 2
    let check: Int = n - 1
    // Mapanare doesn't have bitwise AND on Int, so check manually
    // Powers of 2: 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, ...
    let mut p: Int = 1
    for _ in 0..63:
        if p == n { return true }
        p = p * 2
    return false

fn power_of_two_mask(n: Int) -> Int = n - 1
    // Returns n - 1 (the bitmask for x % n when n is power of 2)

fn try_strength_reduce(inst: Instruction) -> Option<Instruction>:
    let ik: String = instr_kind(inst)
    if ik != "binop" { return none }
    let op: BinOpKind = instr_binop_op(inst)
    // Only reduce Mod operations
    match op {
        Mod => {
            let rhs: Value = instr_binop_rhs(inst)
            // RHS must be a constant integer
            if rhs.ty.kind != TK_INT() { return none }
            if rhs.name.starts_with("%") { return none }
            let n: Int = int(rhs.name)
            if is_power_of_two(n) {
                let mask: Int = power_of_two_mask(n)
                let mask_val: Value = new Value { name: toString(mask), ty: rhs.ty }
                // x % 2^n → x & (2^n - 1)
                return Some(Instruction::BinOp(instr_dest(inst), BinOpKind::And, instr_binop_lhs(inst), mask_val))
            }
            return none
        },
        _ => { return none }
    }

fn strength_reduce_block(bb: BasicBlock) -> BasicBlock:
    let mut new_instrs: List<Instruction> = []
    let mut i: Int = 0
    let mut changed: Bool = false
    for _ in 0..10000:
        if i >= len(bb.instructions):
            if changed:
                return new BasicBlock { label: bb.label, instructions: new_instrs }
            return bb
        let inst: Instruction = bb.instructions[i]
        let reduced: Option<Instruction> = try_strength_reduce(inst)
        match reduced {
            Some(new_inst) => {
                new_instrs.push(new_inst)
                changed = true
            },
            _ => { new_instrs.push(inst) }
        }
        i = i + 1
    return bb

fn strength_reduce_function(f: MIRFunction) -> MIRFunction:
    let mut new_blocks: List<BasicBlock> = []
    let mut i: Int = 0
    let mut changed: Bool = false
    for _ in 0..5000:
        if i >= len(f.blocks):
            if changed:
                return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }
            return f
        let orig: BasicBlock = f.blocks[i]
        let reduced: BasicBlock = strength_reduce_block(orig)
        new_blocks.push(reduced)
        if reduced.label != orig.label || len(reduced.instructions) != len(orig.instructions):
            changed = true
        i = i + 1
    return f

// ---------------------------------------------------------------------------
// Pass 5: Function inlining (v4.97.0)
// Inline small, non-recursive, single-block callees into their call sites.
// Heuristic: body < 20 instructions, not recursive, call_count * body_size < 200.
// Caps at 5 inlines per function to prevent cascading.
// ---------------------------------------------------------------------------

struct FnLookupEntry:
    name: String
    func: MIRFunction

fn find_fn_by_name(lookup: List<FnLookupEntry>, name: String) -> Option<MIRFunction>:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(lookup) { return none }
        if lookup[i].name == name { return Some(lookup[i].func) }
        i = i + 1
    return none

fn instruction_count(f: MIRFunction) -> Int:
    let mut count: Int = 0
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return count }
        count = count + len(f.blocks[bi].instructions)
        bi = bi + 1
    return count

fn is_recursive(f: MIRFunction) -> Bool:
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return false }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            if instr_kind(inst) == "call":
                if instr_call_fn(inst) == f.name { return true }
            ii = ii + 1
        bi = bi + 1
    return false

fn should_inline(callee: MIRFunction, call_count: Int) -> Bool:
    // Only single-block callees (no branches, no phi, no switch)
    if len(callee.blocks) != 1 { return false }
    if is_recursive(callee) { return false }
    if callee.name == "main" { return false }
    // v5.5.4 Sh.4 Phase 1: never inline async fns. In v5.5.4+ the
    // emitter wraps every async fn with coroutine scaffolding
    // (presplitcoroutine attr + coro.id/begin prologue + future
    // alloc + initial suspend + ret→future.payload rewrite + coro.
    // final/cleanup/ret epilogue). Inlining that body into a non-
    // async caller would splice coroutine intrinsics into a
    // non-presplit function — LLVM's CoroSplit pass wouldn't run
    // and the IR would be malformed. Safe to reject categorically
    // because async fns are called via BlockOn or AwaitSuspend
    // (which handle the future extraction), never invoked as a
    // plain call whose result is used directly.
    if fn_is_async(callee) { return false }
    let body_size: Int = instruction_count(callee)
    if body_size == 0 { return false }
    if body_size > 20 { return false }
    if call_count * body_size > 200 { return false }
    return true

// Count how many times each function is called within fn
struct CallCount:
    name: String
    count: Int

fn count_calls(f: MIRFunction, lookup: List<FnLookupEntry>) -> List<CallCount>:
    let mut counts: List<CallCount> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            if instr_kind(inst) == "call":
                let fn_name: String = instr_call_fn(inst)
                // Check if this function exists in lookup
                let fn_opt: Option<MIRFunction> = find_fn_by_name(lookup, fn_name)
                match fn_opt {
                    Some(_) => {
                        // Find or create count entry
                        let mut found: Bool = false
                        let mut ci: Int = 0
                        for _ in 0..1000 {
                            if ci >= len(counts) { break }
                            if counts[ci].name == fn_name {
                                counts[ci] = new CallCount { name: fn_name, count: counts[ci].count + 1 }
                                found = true
                                break
                            }
                            ci = ci + 1
                        }
                        if found == false {
                            counts.push(new CallCount { name: fn_name, count: 1 })
                        }
                    },
                    _ => {}
                }
            ii = ii + 1
        bi = bi + 1
    counts

fn get_call_count(counts: List<CallCount>, name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..1000:
        if i >= len(counts) { return 0 }
        if counts[i].name == name { return counts[i].count }
        i = i + 1
    return 0

// Rename a value with an inline prefix
fn rename_value(v: Value, prefix: String, renames: List<ConstEntry>) -> Value:
    // Check if this value has been renamed
    let opt: Option<String> = find_const(renames, v.name)
    match opt {
        Some(new_name) => { return new Value { name: new_name, ty: v.ty } },
        _ => {
            // If it starts with %, rename with prefix
            if v.name.starts_with("%") {
                let new_name: String = "%" + prefix + v.name.substr(1, len(v.name) - 1)
                return new Value { name: new_name, ty: v.ty }
            }
            return v
        }
    }

// v5.1.2 In.1: Replace one value name if it matches old_name.
fn replace_use(v: Value, old_name: String, new_name: String) -> Value:
    if v.name == old_name:
        return new Value { name: new_name, ty: v.ty }
    return v

// v5.1.2 In.1: Replace all VALUE USES (not definitions) of old_name with
// new_name in an instruction. Used after inlining to rename the caller's
// destination register to a fresh name across downstream instructions,
// preventing SSA name collisions that cause llvm-as to reject the IR.
fn replace_uses_in_instr(inst: Instruction, old_name: String, new_name: String) -> Instruction:
    let ik: String = instr_kind(inst)
    // No value uses
    if ik == "const" { return inst }
    if ik == "alloca" { return inst }
    if ik == "jump" { return inst }
    if ik == "wrap_none" { return inst }
    // Single-use instructions
    if ik == "copy":
        return Instruction::Copy(instr_dest(inst), replace_use(instr_copy_src(inst), old_name, new_name))
    if ik == "cast":
        return Instruction::Cast(instr_dest(inst), replace_use(instr_cast_src(inst), old_name, new_name), instr_cast_type(inst))
    if ik == "unaryop":
        return Instruction::UnaryOp(instr_dest(inst), instr_unaryop_op(inst), replace_use(instr_unaryop_operand(inst), old_name, new_name))
    if ik == "load":
        return Instruction::Load(instr_dest(inst), replace_use(instr_load_ptr(inst), old_name, new_name))
    if ik == "unwrap":
        return Instruction::Unwrap(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "enum_tag":
        return Instruction::EnumTag(instr_dest(inst), replace_use(instr_enumtag_val(inst), old_name, new_name))
    if ik == "enum_payload":
        return Instruction::EnumPayload(instr_dest(inst), replace_use(instr_enumpayload_val(inst), old_name, new_name), instr_enumpayload_variant(inst))
    if ik == "wrap_some":
        return Instruction::WrapSome(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "wrap_ok":
        return Instruction::WrapOk(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "wrap_err":
        return Instruction::WrapErr(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "signal_get":
        return Instruction::SignalGet(instr_dest(inst), replace_use(instr_agentsync_agent(inst), old_name, new_name))
    // Two-use instructions
    if ik == "binop":
        return Instruction::BinOp(instr_dest(inst), instr_binop_op(inst), replace_use(instr_binop_lhs(inst), old_name, new_name), replace_use(instr_binop_rhs(inst), old_name, new_name))
    if ik == "store":
        return Instruction::Store(replace_use(instr_store_ptr(inst), old_name, new_name), replace_use(instr_store_val(inst), old_name, new_name))
    if ik == "field_get":
        return Instruction::FieldGet(instr_dest(inst), replace_use(instr_fieldget_obj(inst), old_name, new_name), instr_fieldget_name(inst))
    if ik == "field_set":
        return Instruction::FieldSet(replace_use(instr_fieldset_obj(inst), old_name, new_name), instr_fieldset_name(inst), replace_use(instr_fieldset_val(inst), old_name, new_name))
    if ik == "index_get":
        return Instruction::IndexGet(instr_dest(inst), replace_use(instr_indexget_obj(inst), old_name, new_name), replace_use(instr_indexget_idx(inst), old_name, new_name))
    if ik == "index_set":
        return Instruction::IndexSet(replace_use(instr_indexset_obj(inst), old_name, new_name), replace_use(instr_indexset_idx(inst), old_name, new_name), replace_use(instr_indexset_val(inst), old_name, new_name))
    if ik == "signal_set":
        return Instruction::SignalSet(replace_use(instr_agentsync_agent(inst), old_name, new_name), replace_use(instr_agentsend_val(inst), old_name, new_name))
    // Branch/switch — condition value
    if ik == "branch":
        return Instruction::Branch(replace_use(instr_branch_cond(inst), old_name, new_name), instr_branch_true(inst), instr_branch_false(inst))
    if ik == "switch":
        return Instruction::Switch(replace_use(instr_switch_tag(inst), old_name, new_name), instr_switch_cases(inst), instr_switch_default(inst))
    // Return
    if ik == "return":
        let rv: Option<Value> = instr_return_val(inst)
        match rv {
            Some(val) => {
                return Instruction::Return(Some(replace_use(val, old_name, new_name)))
            },
            _ => { return inst }
        }
    // Call — rename args (and fn_name when it's an indirect-call SSA value)
    if ik == "call":
        let args: List<Value> = instr_call_args(inst)
        let mut new_args: List<Value> = []
        let mut ai: Int = 0
        for _ in 0..100:
            if ai >= len(args) { break }
            new_args.push(replace_use(args[ai], old_name, new_name))
            ai = ai + 1
        // v5.7.0 Sh.7: indirect calls store the loaded SSA name as fn_name
        // (e.g. "%f_val0"). When the caller's dest is renamed downstream,
        // the indirect call's fn_name must follow.
        let mut new_fn: String = instr_call_fn(inst)
        if new_fn == old_name { new_fn = new_name }
        return Instruction::Call(instr_dest(inst), new_fn, new_args)
    // Phi — rename incoming values
    if ik == "phi":
        let entries: List<PhiEntry> = instr_phi_entries(inst)
        let mut new_entries: List<PhiEntry> = []
        let mut pi: Int = 0
        for _ in 0..100:
            if pi >= len(entries) { break }
            new_entries.push(new PhiEntry { block_label: entries[pi].block_label, val: replace_use(entries[pi].val, old_name, new_name) })
            pi = pi + 1
        return Instruction::Phi(instr_dest(inst), new_entries)
    // InterpConcat — rename parts
    if ik == "interp_concat":
        let parts: List<Value> = instr_concat_parts(inst)
        let mut new_parts: List<Value> = []
        let mut ci: Int = 0
        for _ in 0..100:
            if ci >= len(parts) { break }
            new_parts.push(replace_use(parts[ci], old_name, new_name))
            ci = ci + 1
        return Instruction::InterpConcat(instr_dest(inst), new_parts)
    // StructInit — rename field values
    if ik == "struct_init":
        let fields: List<FieldPair> = instr_struct_fields(inst)
        let mut new_fields: List<FieldPair> = []
        let mut fi: Int = 0
        for _ in 0..100:
            if fi >= len(fields) { break }
            new_fields.push(new FieldPair { name: fields[fi].name, val: replace_use(fields[fi].val, old_name, new_name) })
            fi = fi + 1
        return Instruction::StructInit(instr_dest(inst), instr_struct_type(inst), new_fields)
    // ListInit — rename elements
    if ik == "list_init":
        let elems: List<Value> = instr_list_elements(inst)
        let mut new_elems: List<Value> = []
        let mut ei: Int = 0
        for _ in 0..100:
            if ei >= len(elems) { break }
            new_elems.push(replace_use(elems[ei], old_name, new_name))
            ei = ei + 1
        return Instruction::ListInit(instr_dest(inst), instr_list_type(inst), new_elems)
    // EnumInit — rename payload values
    if ik == "enum_init":
        let payload: List<Value> = instr_enum_payload(inst)
        let mut new_payload: List<Value> = []
        let mut epi: Int = 0
        for _ in 0..100:
            if epi >= len(payload) { break }
            new_payload.push(replace_use(payload[epi], old_name, new_name))
            epi = epi + 1
        return Instruction::EnumInit(instr_dest(inst), instr_enum_type(inst), instr_enum_variant(inst), new_payload)
    // v5.5.2 Sh.4 Phase 3 — BlockOn/AwaitSuspend future operand rename.
    // Required so the inliner's post-call rename of the caller's dest
    // also updates BlockOn's future ref when block_on(inlined_call())
    // is in the source.  Without this, `%t0` survives after inlining
    // renamed it to `%_inl0_0_dst` and llvm-as rejects with "use of
    // undefined value '%t0'".
    if ik == "await_suspend":
        return Instruction::AwaitSuspend(instr_dest(inst), replace_use(instr_await_suspend_future(inst), old_name, new_name))
    if ik == "block_on":
        return Instruction::BlockOn(instr_dest(inst), replace_use(instr_block_on_future(inst), old_name, new_name))
    // For remaining rare types (agent_spawn, agent_send, agent_sync,
    // signal_init, stream_op, tensor_init, map_init), keep as-is.
    return inst

// Clone a single instruction with renamed values
fn clone_instr_for_inline(inst: Instruction, prefix: String, renames: List<ConstEntry>, merge_label: String) -> List<Instruction>:
    let ik: String = instr_kind(inst)
    let mut result: List<Instruction> = []

    // Return → Copy + Jump to merge
    if ik == "return":
        let ret_val: Option<Value> = instr_return_val(inst)
        match ret_val {
            Some(rv) => {
                let renamed_rv: Value = rename_value(rv, prefix, renames)
                let ret_dest: Value = new Value { name: "%" + prefix + "retval", ty: renamed_rv.ty }
                result.push(Instruction::Copy(ret_dest, renamed_rv))
            },
            _ => {}
        }
        result.push(Instruction::Jump(merge_label))
        return result

    // Const
    if ik == "const":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        result.push(Instruction::Const(new_dest, instr_const_type(inst), instr_const_val(inst)))
        return result

    // Copy
    if ik == "copy":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_src: Value = rename_value(instr_copy_src(inst), prefix, renames)
        result.push(Instruction::Copy(new_dest, new_src))
        return result

    // BinOp
    if ik == "binop":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_lhs: Value = rename_value(instr_binop_lhs(inst), prefix, renames)
        let new_rhs: Value = rename_value(instr_binop_rhs(inst), prefix, renames)
        result.push(Instruction::BinOp(new_dest, instr_binop_op(inst), new_lhs, new_rhs))
        return result

    // Call
    if ik == "call":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let args: List<Value> = instr_call_args(inst)
        let mut new_args: List<Value> = []
        let mut ai: Int = 0
        for _ in 0..100:
            if ai >= len(args) { break }
            new_args.push(rename_value(args[ai], prefix, renames))
            ai = ai + 1
        // v5.7.0 Sh.7: indirect calls have fn_name == "%localval" and
        // must be renamed alongside other SSA values; direct calls
        // (`@some_fn`) keep their bare-symbol name unchanged.
        let fn_str: String = instr_call_fn(inst)
        let mut new_fn_str: String = fn_str
        if fn_str.starts_with("%"):
            let bare: String = fn_str.substr(1, len(fn_str) - 1)
            let rn_opt: Option<String> = find_const(renames, fn_str)
            match rn_opt:
                Some(rn) => { new_fn_str = rn }
                _ => { new_fn_str = "%" + prefix + bare }
        result.push(Instruction::Call(new_dest, new_fn_str, new_args))
        return result

    // Alloca
    if ik == "alloca":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        result.push(Instruction::Alloca(new_dest, instr_alloca_type(inst)))
        return result

    // Load
    if ik == "load":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_ptr: Value = rename_value(instr_load_ptr(inst), prefix, renames)
        result.push(Instruction::Load(new_dest, new_ptr))
        return result

    // Store
    if ik == "store":
        let new_ptr: Value = rename_value(instr_store_ptr(inst), prefix, renames)
        let new_val: Value = rename_value(instr_store_val(inst), prefix, renames)
        result.push(Instruction::Store(new_ptr, new_val))
        return result

    // UnaryOp
    if ik == "unaryop":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_operand: Value = rename_value(instr_unaryop_operand(inst), prefix, renames)
        result.push(Instruction::UnaryOp(new_dest, instr_unaryop_op(inst), new_operand))
        return result

    // Cast
    if ik == "cast":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_src: Value = rename_value(instr_cast_src(inst), prefix, renames)
        result.push(Instruction::Cast(new_dest, new_src, instr_cast_type(inst)))
        return result

    // FieldGet — dest + obj (the v5.3.2 crash site)
    if ik == "field_get":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_obj: Value = rename_value(instr_fieldget_obj(inst), prefix, renames)
        result.push(Instruction::FieldGet(new_dest, new_obj, instr_fieldget_name(inst)))
        return result

    // FieldSet — no dest (void)
    if ik == "field_set":
        let new_obj: Value = rename_value(instr_fieldset_obj(inst), prefix, renames)
        let new_val: Value = rename_value(instr_fieldset_val(inst), prefix, renames)
        result.push(Instruction::FieldSet(new_obj, instr_fieldset_name(inst), new_val))
        return result

    // StructInit — dest + list of FieldPair
    if ik == "struct_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let fields: List<FieldPair> = instr_struct_fields(inst)
        let mut new_fields: List<FieldPair> = []
        let mut fi2: Int = 0
        for _ in 0..100:
            if fi2 >= len(fields) { break }
            new_fields.push(new FieldPair { name: fields[fi2].name, val: rename_value(fields[fi2].val, prefix, renames) })
            fi2 = fi2 + 1
        result.push(Instruction::StructInit(new_dest, instr_struct_type(inst), new_fields))
        return result

    // ListInit — dest + list of Value
    if ik == "list_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let elems: List<Value> = instr_list_elements(inst)
        let mut new_elems: List<Value> = []
        let mut ei2: Int = 0
        for _ in 0..100:
            if ei2 >= len(elems) { break }
            new_elems.push(rename_value(elems[ei2], prefix, renames))
            ei2 = ei2 + 1
        result.push(Instruction::ListInit(new_dest, instr_list_type(inst), new_elems))
        return result

    // TensorInit — dest + shape (ints, keep) + list of Value
    if ik == "tensor_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let t_elems: List<Value> = instr_tensor_elements(inst)
        let mut new_t_elems: List<Value> = []
        let mut ti2: Int = 0
        for _ in 0..100:
            if ti2 >= len(t_elems) { break }
            new_t_elems.push(rename_value(t_elems[ti2], prefix, renames))
            ti2 = ti2 + 1
        result.push(Instruction::TensorInit(new_dest, instr_tensor_type(inst), instr_tensor_shape(inst), new_t_elems))
        return result

    // IndexGet — dest + obj + idx
    if ik == "index_get":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_obj: Value = rename_value(instr_indexget_obj(inst), prefix, renames)
        let new_idx: Value = rename_value(instr_indexget_idx(inst), prefix, renames)
        result.push(Instruction::IndexGet(new_dest, new_obj, new_idx))
        return result

    // IndexSet — no dest (void)
    if ik == "index_set":
        let new_obj: Value = rename_value(instr_indexset_obj(inst), prefix, renames)
        let new_idx: Value = rename_value(instr_indexset_idx(inst), prefix, renames)
        let new_val: Value = rename_value(instr_indexset_val(inst), prefix, renames)
        result.push(Instruction::IndexSet(new_obj, new_idx, new_val))
        return result

    // MapInit — dest + key_type + val_type + list of KVPair
    if ik == "map_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let pairs: List<KVPair> = instr_map_pairs(inst)
        let mut new_pairs: List<KVPair> = []
        let mut mi2: Int = 0
        for _ in 0..100:
            if mi2 >= len(pairs) { break }
            new_pairs.push(new KVPair { key: rename_value(pairs[mi2].key, prefix, renames), val: rename_value(pairs[mi2].val, prefix, renames) })
            mi2 = mi2 + 1
        result.push(Instruction::MapInit(new_dest, instr_map_key_type(inst), instr_map_val_type(inst), new_pairs))
        return result

    // EnumInit — dest + type + variant + list of Value
    if ik == "enum_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let payload: List<Value> = instr_enum_payload(inst)
        let mut new_payload: List<Value> = []
        let mut epi2: Int = 0
        for _ in 0..100:
            if epi2 >= len(payload) { break }
            new_payload.push(rename_value(payload[epi2], prefix, renames))
            epi2 = epi2 + 1
        result.push(Instruction::EnumInit(new_dest, instr_enum_type(inst), instr_enum_variant(inst), new_payload))
        return result

    // EnumTag — dest + val
    if ik == "enum_tag":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_enumtag_val(inst), prefix, renames)
        result.push(Instruction::EnumTag(new_dest, new_val))
        return result

    // EnumPayload — dest + val + variant
    if ik == "enum_payload":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_enumpayload_val(inst), prefix, renames)
        result.push(Instruction::EnumPayload(new_dest, new_val, instr_enumpayload_variant(inst)))
        return result

    // WrapSome — dest + val
    if ik == "wrap_some":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::WrapSome(new_dest, new_val))
        return result

    // WrapNone — dest + type (no value operand)
    if ik == "wrap_none":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        result.push(Instruction::WrapNone(new_dest, instr_wrapnone_type(inst)))
        return result

    // WrapOk — dest + val
    if ik == "wrap_ok":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::WrapOk(new_dest, new_val))
        return result

    // WrapErr — dest + val
    if ik == "wrap_err":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::WrapErr(new_dest, new_val))
        return result

    // Unwrap — dest + val
    if ik == "unwrap":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::Unwrap(new_dest, new_val))
        return result

    // InterpConcat — dest + list of Value
    if ik == "interp_concat":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let parts: List<Value> = instr_concat_parts(inst)
        let mut new_parts: List<Value> = []
        let mut ci2: Int = 0
        for _ in 0..100:
            if ci2 >= len(parts) { break }
            new_parts.push(rename_value(parts[ci2], prefix, renames))
            ci2 = ci2 + 1
        result.push(Instruction::InterpConcat(new_dest, new_parts))
        return result

    // Phi — dest + list of PhiEntry
    if ik == "phi":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let entries: List<PhiEntry> = instr_phi_entries(inst)
        let mut new_entries: List<PhiEntry> = []
        let mut pi4: Int = 0
        for _ in 0..100:
            if pi4 >= len(entries) { break }
            new_entries.push(new PhiEntry { block_label: prefix + entries[pi4].block_label, val: rename_value(entries[pi4].val, prefix, renames) })
            pi4 = pi4 + 1
        result.push(Instruction::Phi(new_dest, new_entries))
        return result

    // AgentSpawn — dest + type + list of Value
    if ik == "agent_spawn":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let a_args: List<Value> = instr_agent_args(inst)
        let mut new_a_args: List<Value> = []
        let mut ai2: Int = 0
        for _ in 0..100:
            if ai2 >= len(a_args) { break }
            new_a_args.push(rename_value(a_args[ai2], prefix, renames))
            ai2 = ai2 + 1
        result.push(Instruction::AgentSpawn(new_dest, instr_agent_type(inst), new_a_args))
        return result

    // AgentSend — no dest (void): agent + channel + val
    if ik == "agent_send":
        let new_agent: Value = rename_value(instr_agentsend_agent(inst), prefix, renames)
        let new_val: Value = rename_value(instr_agentsend_val(inst), prefix, renames)
        result.push(Instruction::AgentSend(new_agent, instr_agentsend_channel(inst), new_val))
        return result

    // AgentSync — dest + agent + channel
    if ik == "agent_sync":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_agent: Value = rename_value(instr_agentsync_agent(inst), prefix, renames)
        result.push(Instruction::AgentSync(new_dest, new_agent, instr_agentsync_channel(inst)))
        return result

    // SignalInit — dest + type + val
    if ik == "signal_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_signal_val(inst), prefix, renames)
        result.push(Instruction::SignalInit(new_dest, instr_signal_type(inst), new_val))
        return result

    // SignalGet — dest + sig
    if ik == "signal_get":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_sig: Value = rename_value(instr_signalget_sig(inst), prefix, renames)
        result.push(Instruction::SignalGet(new_dest, new_sig))
        return result

    // SignalSet — no dest (void): sig + val
    if ik == "signal_set":
        let new_sig: Value = rename_value(instr_signalset_sig(inst), prefix, renames)
        let new_val: Value = rename_value(instr_signalset_val(inst), prefix, renames)
        result.push(Instruction::SignalSet(new_sig, new_val))
        return result

    // StreamOp — dest + kind + source + list of Value
    if ik == "stream_op":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_src: Value = rename_value(instr_streamop_source(inst), prefix, renames)
        let s_args: List<Value> = instr_streamop_args(inst)
        let mut new_s_args: List<Value> = []
        let mut si2: Int = 0
        for _ in 0..100:
            if si2 >= len(s_args) { break }
            new_s_args.push(rename_value(s_args[si2], prefix, renames))
            si2 = si2 + 1
        result.push(Instruction::StreamOp(new_dest, instr_streamop_kind(inst), new_src, new_s_args))
        return result

    // Jump — rename block label
    if ik == "jump":
        result.push(Instruction::Jump(prefix + instr_jump_target(inst)))
        return result

    // Branch — rename condition + block labels
    if ik == "branch":
        let new_cond: Value = rename_value(instr_branch_cond(inst), prefix, renames)
        result.push(Instruction::Branch(new_cond, prefix + instr_branch_true(inst), prefix + instr_branch_false(inst)))
        return result

    // Switch — rename tag + case/default labels
    if ik == "switch":
        let new_tag: Value = rename_value(instr_switch_tag(inst), prefix, renames)
        let cases: List<SwitchCase> = instr_switch_cases(inst)
        let mut new_cases: List<SwitchCase> = []
        let mut sci: Int = 0
        for _ in 0..100:
            if sci >= len(cases) { break }
            new_cases.push(new SwitchCase { tag_value: cases[sci].tag_value, block_label: prefix + cases[sci].block_label })
            sci = sci + 1
        result.push(Instruction::Switch(new_tag, new_cases, prefix + instr_switch_default(inst)))
        return result

    // v5.5.2 Sh.4 Phase 3 — AwaitSuspend/BlockOn rename in inlined body.
    // When an async fn like `outer()` (which may contain `await inner()`)
    // is inlined into main()'s BlockOn body, every AwaitSuspend inside
    // outer() needs its dest + future ref prefixed/renamed to the
    // inline scope so SSA stays valid. Without these cases the
    // fallthrough keeps the instruction as-is and llvm-as rejects with
    // duplicate-use or undefined-ref errors.
    if ik == "await_suspend":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_fut: Value = rename_value(instr_await_suspend_future(inst), prefix, renames)
        result.push(Instruction::AwaitSuspend(new_dest, new_fut))
        return result
    if ik == "block_on":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_fut: Value = rename_value(instr_block_on_future(inst), prefix, renames)
        result.push(Instruction::BlockOn(new_dest, new_fut))
        return result
    // Fallthrough: any future variant added to Instruction — keep as-is
    result.push(inst)
    return result

// Rename PHI predecessor labels: old_label → new_label
fn rename_phi_pred(inst: Instruction, old_label: String, new_label: String) -> Instruction:
    if instr_kind(inst) != "phi" { return inst }
    let entries: List<PhiEntry> = instr_phi_entries(inst)
    let mut new_entries: List<PhiEntry> = []
    let mut changed: Bool = false
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(entries) { break }
        if entries[i].block_label == old_label:
            new_entries.push(new PhiEntry { block_label: new_label, val: entries[i].val })
            changed = true
        else:
            new_entries.push(entries[i])
        i = i + 1
    if changed:
        return Instruction::Phi(instr_dest(inst), new_entries)
    return inst

fn inline_small_functions(f: MIRFunction, lookup: List<FnLookupEntry>) -> MIRFunction:

    // Count calls per callee
    let call_counts: List<CallCount> = count_calls(f, lookup)
    if len(call_counts) == 0 { return f }

    // Find eligible callees
    let mut eligible: List<String> = []
    let mut ci: Int = 0
    for _ in 0..1000:
        if ci >= len(call_counts) { break }
        let cc: CallCount = call_counts[ci]
        let callee_opt: Option<MIRFunction> = find_fn_by_name(lookup, cc.name)
        match callee_opt {
            Some(callee) => {
                if should_inline(callee, cc.count) {
                    eligible.push(cc.name)
                }
            },
            _ => {}
        }
        ci = ci + 1
    if len(eligible) == 0 { return f }

    // Find first eligible call site and inline it
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return f }
        let bb: BasicBlock = f.blocks[bi]
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(bb.instructions) { break }
            let inst: Instruction = bb.instructions[ii]
            if instr_kind(inst) == "call":
                let callee_name: String = instr_call_fn(inst)
                if is_in_list(callee_name, eligible):
                    // Found an eligible call site — inline it
                    let callee_opt2: Option<MIRFunction> = find_fn_by_name(lookup, callee_name)
                    match callee_opt2 {
                        Some(callee) => {
                            // Safety: skip if arg count != param count (name collision)
                            let call_args_pre: List<Value> = instr_call_args(inst)
                            if len(call_args_pre) == len(callee.params) {

                            // Use block index + instruction index for unique prefix
                            let prefix: String = "_inl" + toString(bi) + "_" + toString(ii) + "_"
                            let merge_label: String = prefix + "ret"

                            // Build rename map: callee params → call arguments
                            let mut renames: List<ConstEntry> = []
                            let call_args: List<Value> = call_args_pre
                            let mut pi2: Int = 0
                            for _ in 0..100 {
                                if pi2 >= len(callee.params) { break }
                                if pi2 < len(call_args) {
                                    renames.push(new ConstEntry { name: "%" + callee.params[pi2].name, value: call_args[pi2].name, ty: call_args[pi2].ty })
                                }
                                pi2 = pi2 + 1
                            }

                            // Split: pre-call instructions
                            let mut pre_insts: List<Instruction> = []
                            let mut ki: Int = 0
                            for _ in 0..10000 {
                                if ki >= ii { break }
                                pre_insts.push(bb.instructions[ki])
                                ki = ki + 1
                            }

                            // Clone callee's single block instructions
                            let callee_entry: String = prefix + callee.blocks[0].label
                            pre_insts.push(Instruction::Jump(callee_entry))

                            // Clone callee block
                            let mut cloned_insts: List<Instruction> = []
                            let mut cli: Int = 0
                            for _ in 0..10000 {
                                if cli >= len(callee.blocks[0].instructions) { break }
                                let cloned: List<Instruction> = clone_instr_for_inline(callee.blocks[0].instructions[cli], prefix, renames, merge_label)
                                let mut cj: Int = 0
                                for _ in 0..10 {
                                    if cj >= len(cloned) { break }
                                    cloned_insts.push(cloned[cj])
                                    cj = cj + 1
                                }
                                cli = cli + 1
                            }

                            // Post-call instructions
                            // v5.1.2 In.1: use a fresh dest name for the inlined result
                            // to prevent SSA name collision. The original %tN may collide
                            // with names in other blocks after the LLVM emitter maps MIR
                            // names to LLVM IR (which requires function-wide uniqueness).
                            // All downstream uses of the original name are renamed.
                            let mut post_insts: List<Instruction> = []
                            let call_dest: Value = instr_dest(inst)
                            let do_rename: Bool = call_dest.name.starts_with("%")
                            let fresh_dest_name: String = "%" + prefix + "dst"
                            if do_rename {
                                let fresh_dest: Value = new Value { name: fresh_dest_name, ty: call_dest.ty }
                                let ret_val: Value = new Value { name: "%" + prefix + "retval", ty: call_dest.ty }
                                post_insts.push(Instruction::Copy(fresh_dest, ret_val))
                            }
                            let mut pi3: Int = ii + 1
                            for _ in 0..10000 {
                                if pi3 >= len(bb.instructions) { break }
                                if do_rename {
                                    post_insts.push(replace_uses_in_instr(bb.instructions[pi3], call_dest.name, fresh_dest_name))
                                } else {
                                    post_insts.push(bb.instructions[pi3])
                                }
                                pi3 = pi3 + 1
                            }

                            // Build new block list
                            let mut new_blocks: List<BasicBlock> = []
                            // Current block with pre-call instrs
                            new_blocks.push(new BasicBlock { label: bb.label, instructions: pre_insts })
                            // Cloned callee block
                            new_blocks.push(new BasicBlock { label: callee_entry, instructions: cloned_insts })
                            // Merge block with post-call instrs
                            new_blocks.push(new BasicBlock { label: merge_label, instructions: post_insts })
                            // Remaining blocks — rename uses of old dest name
                            // and fix PHI predecessors (bb.label → merge_label)
                            let orig_label: String = bb.label
                            let mut ri: Int = bi + 1
                            for _ in 0..5000 {
                                if ri >= len(f.blocks) { break }
                                let rbb: BasicBlock = f.blocks[ri]
                                let mut renamed_instrs: List<Instruction> = []
                                let mut rii: Int = 0
                                for _ in 0..10000 {
                                    if rii >= len(rbb.instructions) { break }
                                    let mut rinst: Instruction = rbb.instructions[rii]
                                    if do_rename {
                                        rinst = replace_uses_in_instr(rinst, call_dest.name, fresh_dest_name)
                                    }
                                    rinst = rename_phi_pred(rinst, orig_label, merge_label)
                                    renamed_instrs.push(rinst)
                                    rii = rii + 1
                                }
                                new_blocks.push(new BasicBlock { label: rbb.label, instructions: renamed_instrs })
                                ri = ri + 1
                            }
                            // Prepend blocks before current
                            let mut final_blocks: List<BasicBlock> = []
                            let mut fi: Int = 0
                            for _ in 0..5000 {
                                if fi >= bi { break }
                                final_blocks.push(f.blocks[fi])
                                fi = fi + 1
                            }
                            let mut ni: Int = 0
                            for _ in 0..5000 {
                                if ni >= len(new_blocks) { break }
                                final_blocks.push(new_blocks[ni])
                                ni = ni + 1
                            }

                            return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: final_blocks, decorators: f.decorators, is_public: f.is_public }
                            } // end param-count guard
                        },
                        _ => {}
                    }
            ii = ii + 1
        bi = bi + 1
    return f

// ---------------------------------------------------------------------------
// Pass 6: LICM — Loop-invariant code motion (v4.97.0)
// Detect natural loops via back-edge detection, hoist invariant instructions
// to the loop preheader.
// ---------------------------------------------------------------------------

// Compute successor labels for a block
fn block_successors(bb: BasicBlock) -> List<String>:
    if len(bb.instructions) == 0:
        let empty: List<String> = []
        return empty
    return collect_targets(bb.instructions[len(bb.instructions) - 1])

// Check if instruction is side-effect-free (safe to hoist)
fn is_pure_instruction(inst: Instruction) -> Bool:
    let ik: String = instr_kind(inst)
    // Pure: const, copy, binop, unaryop, cast
    if ik == "const" { return true }
    if ik == "copy" { return true }
    if ik == "binop" { return true }
    if ik == "unaryop" { return true }
    if ik == "cast" { return true }
    // Not pure: call, store, load (may have side effects), control flow
    return false

// Check if all uses of an instruction are defined outside the loop
fn is_loop_invariant(inst: Instruction, loop_body: List<String>, loop_defs: List<String>) -> Bool:
    if is_pure_instruction(inst) == false { return false }
    let ik: String = instr_kind(inst)
    // Check operands
    if ik == "binop":
        let lhs: Value = instr_binop_lhs(inst)
        let rhs: Value = instr_binop_rhs(inst)
        if lhs.name.starts_with("%") && is_in_list(lhs.name, loop_defs) { return false }
        if rhs.name.starts_with("%") && is_in_list(rhs.name, loop_defs) { return false }
        return true
    if ik == "copy":
        let src: Value = instr_copy_src(inst)
        if src.name.starts_with("%") && is_in_list(src.name, loop_defs) { return false }
        return true
    if ik == "unaryop":
        let operand: Value = instr_unaryop_operand(inst)
        if operand.name.starts_with("%") && is_in_list(operand.name, loop_defs) { return false }
        return true
    if ik == "cast":
        let src: Value = instr_cast_src(inst)
        if src.name.starts_with("%") && is_in_list(src.name, loop_defs) { return false }
        return true
    if ik == "const" { return true }
    return false

// Collect all definitions (dest names) in loop body blocks
fn collect_loop_defs(f: MIRFunction, loop_body: List<String>) -> List<String>:
    let mut defs: List<String> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        if is_in_list(f.blocks[bi].label, loop_body):
            let mut ii: Int = 0
            for _ in 0..10000:
                if ii >= len(f.blocks[bi].instructions) { break }
                let inst: Instruction = f.blocks[bi].instructions[ii]
                let dest: Value = instr_dest(inst)
                if len(dest.name) > 0 && dest.name.starts_with("%"):
                    if is_in_list(dest.name, defs) == false:
                        defs.push(dest.name)
                ii = ii + 1
        bi = bi + 1
    defs

// Find the index of a block label that appears before position `before_idx`
fn find_earlier_block(blocks: List<BasicBlock>, label: String, before_idx: Int) -> Int:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= before_idx { return -1 }
        if blocks[i].label == label { return i }
        i = i + 1
    return -1

// Find a loop-invariant instruction in the loop body (excluding header)
// Returns (block_index, instruction_index) encoded as block_index * 100000 + inst_index
// Returns -1 if none found
fn find_invariant_in_loop(f: MIRFunction, header_idx: Int, back_idx: Int, loop_body: List<String>, loop_defs: List<String>) -> Int:
    let mut lbi: Int = header_idx + 1
    for _ in 0..5000:
        if lbi > back_idx { return -1 }
        let mut lii: Int = 0
        for _ in 0..10000:
            if lii >= len(f.blocks[lbi].instructions) { break }
            let linst: Instruction = f.blocks[lbi].instructions[lii]
            if is_loop_invariant(linst, loop_body, loop_defs):
                let dest: Value = instr_dest(linst)
                if len(dest.name) > 0:
                    return lbi * 100000 + lii
            lii = lii + 1
        lbi = lbi + 1
    return -1

// Hoist one instruction from src_block[src_idx] to header[before terminator]
fn hoist_instruction(f: MIRFunction, header_idx: Int, src_block_idx: Int, src_inst_idx: Int) -> MIRFunction:
    let hoisted: Instruction = f.blocks[src_block_idx].instructions[src_inst_idx]
    // Remove from source block
    let mut src_instrs: List<Instruction> = []
    let mut ri: Int = 0
    for _ in 0..10000:
        if ri >= len(f.blocks[src_block_idx].instructions) { break }
        if ri != src_inst_idx:
            src_instrs.push(f.blocks[src_block_idx].instructions[ri])
        ri = ri + 1
    // Insert into header before terminator
    let header_bb: BasicBlock = f.blocks[header_idx]
    let mut hdr_instrs: List<Instruction> = []
    let insert_pos: Int = len(header_bb.instructions) - 1
    let mut hi2: Int = 0
    for _ in 0..10000:
        if hi2 >= len(header_bb.instructions) { break }
        if hi2 == insert_pos:
            hdr_instrs.push(hoisted)
        hdr_instrs.push(header_bb.instructions[hi2])
        hi2 = hi2 + 1
    // Rebuild blocks
    let mut new_blocks: List<BasicBlock> = []
    let mut nbi: Int = 0
    for _ in 0..5000:
        if nbi >= len(f.blocks) { break }
        if nbi == header_idx:
            new_blocks.push(new BasicBlock { label: header_bb.label, instructions: hdr_instrs })
        else if nbi == src_block_idx:
            new_blocks.push(new BasicBlock { label: f.blocks[src_block_idx].label, instructions: src_instrs })
        else:
            new_blocks.push(f.blocks[nbi])
        nbi = nbi + 1
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }

// Simple LICM: find back edges, identify loop-invariant instructions, hoist to header
fn licm_function(f: MIRFunction) -> MIRFunction:
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return f }
        let bb: BasicBlock = f.blocks[bi]
        let succs: List<String> = block_successors(bb)
        let mut s_idx: Int = 0
        for _ in 0..10:
            if s_idx >= len(succs) { break }
            let header_idx: Int = find_earlier_block(f.blocks, succs[s_idx], bi)
            if header_idx >= 0:
                // Found a back edge: bi → header_idx
                let mut loop_body: List<String> = []
                let mut li: Int = header_idx
                for _ in 0..5000:
                    if li > bi { break }
                    loop_body.push(f.blocks[li].label)
                    li = li + 1
                let loop_defs: List<String> = collect_loop_defs(f, loop_body)
                let encoded: Int = find_invariant_in_loop(f, header_idx, bi, loop_body, loop_defs)
                if encoded >= 0:
                    let src_block: Int = encoded / 100000
                    let src_inst: Int = encoded - src_block * 100000
                    return hoist_instruction(f, header_idx, src_block, src_inst)
            s_idx = s_idx + 1
        bi = bi + 1
    return f

// ---------------------------------------------------------------------------
// Pass 7: Escape analysis — heap-to-stack promotion (v4.97.0)
// Track allocations (StructInit, EnumInit, ListInit, etc.), determine if
// the allocated value escapes the function (returned, stored in struct,
// passed to unknown call). If non-escaping, mark for stack allocation.
// ---------------------------------------------------------------------------

fn is_alloc_instruction(inst: Instruction) -> Bool:
    let ik: String = instr_kind(inst)
    if ik == "struct_init" { return true }
    if ik == "enum_init" { return true }
    if ik == "list_init" { return true }
    if ik == "map_init" { return true }
    if ik == "wrap_some" { return true }
    if ik == "wrap_none" { return true }
    if ik == "wrap_ok" { return true }
    if ik == "wrap_err" { return true }
    if ik == "interp_concat" { return true }
    return false

// Check if a value name is used in ways that cause it to escape
fn check_escape(f: MIRFunction, alloc_name: String) -> Bool:
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            let ik: String = instr_kind(inst)
            // Returned — escapes
            if ik == "return":
                let rv: Option<Value> = instr_return_val(inst)
                match rv {
                    Some(val) => {
                        if val.name == alloc_name { return true }
                    },
                    _ => {}
                }
            // Stored in a struct field — escapes
            if ik == "field_set":
                if instr_fieldset_val(inst).name == alloc_name { return true }
            // Stored in a container — escapes
            if ik == "index_set":
                if instr_indexset_val(inst).name == alloc_name { return true }
            // Passed to a call (conservative: any call = escape)
            if ik == "call":
                let args: List<Value> = instr_call_args(inst)
                let mut ai: Int = 0
                for _ in 0..100:
                    if ai >= len(args) { break }
                    if args[ai].name == alloc_name { return true }
                    ai = ai + 1
            // Agent send — escapes
            if ik == "agent_send":
                if instr_agentsend_val(inst).name == alloc_name { return true }
            ii = ii + 1
        bi = bi + 1
    return false

fn escape_analysis_function(f: MIRFunction) -> MIRFunction:
    // v5.1.2 Ea.1: full escape analysis — identify non-escaping allocations.
    // The self-hosted Instruction enum does not carry an alloc_kind field
    // (unlike the Python MIR dataclasses), so the result cannot be annotated
    // on the instruction directly. Instead, we compute the escape set and
    // return f unchanged — the Python emitter (which IS the active emitter
    // during bootstrap and golden tests) already runs escape_analysis_promotion
    // via mir_opt.py. The self-hosted analysis serves as:
    //   (a) parity evidence that the computation mirrors Python's,
    //   (b) the hook point for when the self-hosted Instruction enum gains
    //       an alloc_kind discriminant (v5.2+ scope).

    // Find all allocation sites
    let mut alloc_names: List<String> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            if is_alloc_instruction(inst):
                let dest: Value = instr_dest(inst)
                if dest.name.starts_with("%"):
                    alloc_names.push(dest.name)
            ii = ii + 1
        bi = bi + 1
    if len(alloc_names) == 0 { return f }

    // Run escape analysis for each allocation
    let mut non_escaping: Int = 0
    let mut ai: Int = 0
    for _ in 0..10000:
        if ai >= len(alloc_names) { break }
        let escapes: Bool = check_escape(f, alloc_names[ai])
        if escapes == false:
            non_escaping = non_escaping + 1
        ai = ai + 1

    // Analysis complete. non_escaping allocations identified but not yet
    // annotated (no alloc_kind field on self-hosted Instruction enum).
    // The Python emitter path handles the actual STACK promotion via
    // mir_opt.py::escape_analysis_promotion at line 1659.
    return f

// ---------------------------------------------------------------------------
// Public API: optimize a MIR module
// ---------------------------------------------------------------------------

pub fn optimize_mir(module: MIRModule) -> MIRModule:
    // Build function lookup table for inlining
    let mut lookup: List<FnLookupEntry> = []
    let mut li: Int = 0
    for _ in 0..5000:
        if li >= len(module.functions) { break }
        lookup.push(new FnLookupEntry { name: module.functions[li].name, func: module.functions[li] })
        li = li + 1
    let mut new_fns: List<MIRFunction> = []
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(module.functions):
            return new MIRModule { name: module.name, functions: new_fns, structs: module.structs, enums: module.enums, extern_fns: module.extern_fns, agents: module.agents, pipes: module.pipes, imports: module.imports, trait_names: module.trait_names, consts: module.consts }
        let f: MIRFunction = module.functions[i]
        // Pass 1: constant folding
        let f2: MIRFunction = constant_fold_function(f)
        // Pass 2: constant propagation
        let f3: MIRFunction = const_prop_function(f2)
        // Pass 3: dead block elimination
        let f4: MIRFunction = dead_block_elim_function(f3)
        // Pass 4: strength reduction (v4.97.0) — disabled v4.111.0
        // Corroborates with inline_small_functions in producing MIR that the
        // verifier rejects ("block has no instructions", "block does not end
        // with a terminator") on golden tests with user-defined functions
        // (03_function onward, 13 tests). Zero-ROI per v4.109.0.
        // v4.152.0 re-evaluation: safe (no crash, 54/66 goldens hold), but
        // still zero-ROI — pass runs, finds 0 mod-by-power-of-2 patterns in
        // the self-hosted MIR, golden IR byte-identical, stage2.ll +1 line
        // (the call itself). LLVM instcombine at -O2 covers this. Keep disabled.
        // Note: Python mir_opt.py has strength_reduction enabled (line 2390);
        // divergence is tolerable — self-hosted optimizer skip costs nothing.
        let f5: MIRFunction = f4
        // Pass 5: function inlining (v4.97.0)
        // v4.111.0: disabled — verify_block crash on golden tests with function calls.
        // v4.152.0 re-evaluation: crash GONE. SSA name collision remained (In.1).
        // v5.1.2 In.1 CLOSED: replace_uses_in_instr renames the caller's destination
        // register to a fresh prefixed name (%_inlN_M_dst) after inlining, and
        // renames all downstream uses in post-call and remaining blocks. The original
        // %tN name is never redefined. Python/self-hosted parity restored.
        let f6: MIRFunction = inline_small_functions(f5, lookup)
        // Pass 6: LICM (v4.97.0) — STILL DISABLED
        // v4.111.0: disabled — block_successors crash.
        // v4.152.0: crash GONE. 3 golden regressions (05_for_loop, 21_list_ops,
        //   33_break_continue) from duplicate definitions.
        // v5.1.2 Li.1: attempted re-enable. Unit tests pass (LICM logic is
        //   correct in isolation), but live golden tests reproduce the v4.152.0
        //   regressions. Root cause: licm_function hoists ONE instruction per
        //   call without a fixpoint loop, and the interaction with downstream
        //   passes creates patterns that duplicate defs. Needs proper preheader
        //   insertion + fixpoint to be safe. Li.1 remains OPEN for v5.2.
        let f7: MIRFunction = f6
        // Pass 7: escape analysis (v4.97.0)
        // v4.111.0: disabled — +0x3f3 crash on tests with user-defined functions.
        // v4.152.0: crash GONE (Ge.1 fix). Stub remained (Ea.1).
        // v5.1.2 Ea.1 CLOSED: escape_analysis_function now runs the full escape
        //   analysis (check_escape for each allocation site). The self-hosted
        //   Instruction enum lacks an alloc_kind field, so the result is computed
        //   but not annotated on instructions. The Python mir_opt.py version
        //   (escape_analysis_promotion) sets alloc_kind=STACK on the MIR
        //   dataclasses; the self-hosted path is parity-equivalent in analysis
        //   but defers codegen annotation to when the Instruction enum gains
        //   the alloc_kind discriminant (v5.2+ scope). Safe: returns f unchanged.
        let f8: MIRFunction = escape_analysis_function(f7)
        new_fns.push(f8)
        i = i + 1
    return module

// ===== emit_llvm.mn =====
// emit_llvm.mn — LLVM IR emitter for the Mapanare self-hosted compiler.
// Consumes MIR (from lower.mn) and produces LLVM IR text (string-based).
//
// Architecture:
//   - emit_mir_module walks MIR structs, enums, extern fns, then functions
//   - emit_mir_function emits function header + basic blocks
//   - emit_mir_basic_block emits block label + instructions
//   - emit_mir_instruction maps each MIR opcode to LLVM IR instructions
//   - A local counter produces unique SSA names (%0, %1, ...)
//
// LLVM type constants and IR string builders are in emit_llvm_ir.mn.


// ---------------------------------------------------------------------------
// Emitter state
// ---------------------------------------------------------------------------

struct StructEntry:
    name: String
    field_names: List<String>
    field_types: List<String>
    llvm_type: String

fn new_struct_entry(name: String, fields: List<String>, types: List<String>, ty: String) -> StructEntry = new StructEntry { name: name, field_names: fields, field_types: types, llvm_type: ty }

fn lookup_struct_field_types(st: EmitState, name: String) -> List<String>:
    // v5.6.5 Ve.1 fix: register_internal_struct pushes entries with empty
    // field_types (field NAMES only, for find_field_index's index-0-bug
    // fallback). The real MIR registration pushes full entries later via
    // register_mir_struct. A forward match-first-entry search finds the
    // empty internal entry (e.g., for Value, MIRType, EmitState, LowerState)
    // instead of the real one — callers would then see a 0-length field list
    // and misbehave (compute_payload_alloc_size would fall back to the
    // 256 upper-bound, under-allocating FnDefData's 264 bytes, etc.).
    // Skip empty entries so the real later-registered entry wins.
    let mut i: Int = 0
    let nstructs: Int = len(st.structs)
    for _ in 0..10000:
        if i < nstructs:
            let entry: StructEntry = st.structs[i]
            if entry.name == name:
                if len(entry.field_types) > 0:
                    return entry.field_types
            i = i + 1
    let empty: List<String> = []
    return empty

struct FnEntry:
    name: String
    ret_type: String
    param_types: List<String>

fn new_fn_entry(name: String, ret: String, params: List<String>) -> FnEntry = new FnEntry { name: name, ret_type: ret, param_types: params }

struct EmitState:
    lines: List<String>
    counter: Int
    functions: List<FnEntry>
    structs: List<StructEntry>
    module_name: String
    str_counter: Int
    str_globals: List<String>
    current_ret_type: String
    enum_names: List<String>
    enum_infos: List<EnumInfo>
    enum_inline_slots: List<Int>
    // v5.4.0 Own.1 Phase 2 — per-function ownership tracking.
    // Reset at emit_fn entry. Read by emit_drop_glue before ret.
    str_owned: List<String>
    list_owned: List<String>
    boxed_owned: List<String>
    // v5.6.4 Own.1 Phase 3 — Rt.06 tensor drop-glue. Parallel to
    // str_owned / list_owned / boxed_owned, but slots are a single
    // ptr (tensors are heap-allocated via __mn_tensor_alloc and
    // returned as a raw ptr). Drop-glue iterates at function exit
    // and calls __mn_tensor_free on each non-moved, non-returned
    // slot. Mirrors mapanare/emit_llvm_text.py::_tensor_vars.
    tensor_owned: List<String>
    moved_locals: List<String>
    // v5.4.1 — entry-block prelude for tracking-slot allocas.
    // emit_track_string / _boxed / _closure can fire from any basic
    // block, so we accumulate alloca + zero-init lines here for the
    // whole function and flush at function close. Mirrors
    // emit_llvm_text.py self._ent.
    entry_prelude_lines: List<String>
    // v5.4.1 — buffered body of the current function. While
    // in_entry_block is true, emit_line redirects here so the prelude
    // can be spliced ahead of the body, placing tracking allocas at
    // the top of the entry block per LLVM ABI.
    entry_block_body: List<String>
    in_entry_block: Bool
    // v5.4.3 — nested-loop depth at the current emission point.
    // Pushed when emit_mir_basic_block enters a block whose label
    // starts with for_body / while_body / mapfor_body; popped when the
    // block's instructions finish. emit_track_string / _boxed /
    // _closure consult this to prepend free-before-store to tracking
    // stores inside loops, preventing the Rt.03 leak pattern.
    loop_depth: Int
    // v5.4.4 Own.1 Phase 2 — slot-to-source parallel arrays.
    // Each tracking slot is allocated for a specific SSA source name
    // (e.g. "t14"). The lowerer emits Move(t14) when the resource
    // transfers ownership; drop glue matches the slot's recorded
    // source against moved_locals to skip the free. Indexes align
    // with str_owned / list_owned / boxed_owned respectively.
    str_owned_source: List<String>
    list_owned_source: List<String>
    boxed_owned_source: List<String>
    // v5.6.4 — parallel source-SSA list for tensor_owned.
    tensor_owned_source: List<String>
    // v5.8.6 We.1: host target detection (OS-1 mechanism, refined).
    // Replaces the v5.8.4 single `is_win64` flag — that name claimed
    // to mean "Win64" but was set whenever `_WIN32` was defined
    // which is true for *both* i686-w64-mingw32 (32-bit cdecl) and
    // x86_64-w64-mingw32 (64-bit Win64). Splitting into a Windows
    // gate plus an explicit pointer-width field lets the emitter
    // dispatch a 3-way: SysV/AAPCS64 (default), Win64 sret/sarg
    // (is_windows && win_arch == 64), or i686 cdecl sret/byval
    // (is_windows && win_arch == 32). Use the helpers
    // `use_win64_abi(st)` / `use_i686_abi(st)` instead of reading
    // these fields directly. Set in emit_mir_module from
    // __mn_host_is_windows() + __mn_host_arch_bits() so the
    // *running* compiler emits IR for its own host.
    is_windows: Bool
    win_arch: Int

fn new_emit_state(module_name: String) -> EmitState:
    let lines: List<String> = []
    let functions: List<FnEntry> = []
    // Build internal struct entries BEFORE constructing EmitState.
    // This avoids the circular dependency: pushing to st.structs needs
    // EmitState field info, but EmitState isn't registered yet.
    let structs: List<StructEntry> = build_internal_struct_list()
    let str_globals: List<String> = []
    let enum_names: List<String> = []
    let enum_infos: List<EnumInfo> = []
    let enum_inline_slots: List<Int> = []
    let str_owned: List<String> = []
    let list_owned: List<String> = []
    let boxed_owned: List<String> = []
    let tensor_owned: List<String> = []
    let moved_locals: List<String> = []
    let entry_prelude_lines: List<String> = []
    let entry_block_body: List<String> = []
    let str_owned_source: List<String> = []
    let list_owned_source: List<String> = []
    let boxed_owned_source: List<String> = []
    let tensor_owned_source: List<String> = []
    return new EmitState { lines: lines, counter: 0, functions: functions, structs: structs, module_name: module_name, str_counter: 0, str_globals: str_globals, current_ret_type: "void", enum_names: enum_names, enum_infos: enum_infos, enum_inline_slots: enum_inline_slots, str_owned: str_owned, list_owned: list_owned, boxed_owned: boxed_owned, tensor_owned: tensor_owned, moved_locals: moved_locals, entry_prelude_lines: entry_prelude_lines, entry_block_body: entry_block_body, in_entry_block: false, loop_depth: 0, str_owned_source: str_owned_source, list_owned_source: list_owned_source, boxed_owned_source: boxed_owned_source, tensor_owned_source: tensor_owned_source, is_windows: false, win_arch: 0 }

fn build_internal_struct_list() -> List<StructEntry>:
    let mut list: List<StructEntry> = []
    // StructEntry MUST be first — make_entry creates StructEntry values,
    // and the emitter needs StructEntry's field info to generate correct
    // insertvalue indices for subsequent make_entry calls.
    list.push(make_entry("StructEntry", ["name", "field_names", "field_types", "llvm_type"]))
    list.push(make_entry("MIRModule", ["name", "functions", "structs", "enums", "extern_fns", "agents", "pipes", "imports", "trait_names", "consts"]))
    list.push(make_entry("LowerState", ["module", "current_fn", "current_block_idx", "tmp_counter", "block_counter", "vars", "scope_stack", "impl_methods", "struct_fields", "enum_variants", "lambda_vars", "fn_blocks", "generic_fns", "generic_structs", "generic_enums", "loop_header_label", "loop_exit_label", "comp_type_hint", "struct_update_counter", "chain_compare_counter"]))
    list.push(make_entry("EmitState", ["lines", "counter", "functions", "structs", "module_name", "str_counter", "str_globals", "current_ret_type", "enum_names", "enum_infos", "enum_inline_slots", "str_owned", "list_owned", "boxed_owned", "tensor_owned", "moved_locals", "entry_prelude_lines", "entry_block_body", "in_entry_block", "loop_depth", "str_owned_source", "list_owned_source", "boxed_owned_source", "tensor_owned_source", "is_windows", "win_arch"]))
    list.push(make_entry("LowerResult", ["value", "state"]))
    list.push(make_entry("CompileResult", ["success", "ir_text", "errors"]))
    list.push(make_entry("MatchBuildResult", ["state", "arm_labels", "arm_indices", "cases", "default_label"]))
    list.push(make_entry("FnEntry", ["name", "ret_type", "param_types"]))
    // StructEntry already registered first (above)
    list.push(make_entry("VarInfo", ["name", "current", "mutable"]))
    list.push(make_entry("StructFieldInfo", ["name", "field_names", "field_types"]))
    list.push(make_entry("EnumVariantNames", ["enum_name", "variant_names"]))
    list.push(make_entry("LambdaEntry", ["var_name", "fn_name"]))
    list.push(make_entry("ExternFnInfo", ["abi", "module_name", "fn_name", "param_types", "return_type"]))
    list.push(make_entry("VerifyError", ["fn_name", "block_label", "message"]))
    list.push(make_entry("ImplEntry", ["key", "mir_name"]))
    list.push(make_entry("ImportInfo", ["path", "items"]))
    list.push(make_entry("ModuleConst", ["name", "type_name", "int_value", "str_value", "is_string"]))
    list.push(make_entry("AgentInfo", ["name", "inputs", "outputs", "method_names"]))
    list.push(make_entry("PipeInfo", ["name", "stages"]))
    list.push(make_entry("MIRFunction", ["name", "params", "return_type", "blocks", "decorators", "is_public"]))
    list.push(make_entry("BasicBlock", ["label", "instructions"]))
    list.push(make_entry("MIRType", ["name", "kind", "args"]))
    list.push(make_entry("Value", ["name", "ty"]))
    return list

fn make_entry(name: String, field_names: List<String>) -> StructEntry:
    let types: List<String> = []
    new_struct_entry(name, field_names, types, "%struct." + name)

// Pre-register internal compiler struct types that may not be in the MIR module.
// Without these, find_field_index returns 0 for all fields (index-0 bug).
fn register_internal_struct(st: EmitState, name: String, fields: List<String>) -> EmitState:
    let types: List<String> = []
    let entry: StructEntry = new_struct_entry(name, fields, types, "%struct." + name)
    st.structs.push(entry)
    st

fn register_all_internal_structs(st: EmitState) -> EmitState:
    let mut s: EmitState = st
    // MIRModule: name, functions, structs, enums, extern_fns, agents, pipes, imports, trait_names, consts
    s = register_internal_struct(s, "MIRModule", ["name", "functions", "structs", "enums", "extern_fns", "agents", "pipes", "imports", "trait_names", "consts"])
    // LowerState: module, current_fn, current_block_idx, tmp_counter, block_counter, vars, scope_stack, impl_methods, struct_fields, enum_variants, lambda_vars, fn_blocks, generic_fns, generic_structs, generic_enums, loop_header_label, loop_exit_label, comp_type_hint, struct_update_counter, chain_compare_counter
    s = register_internal_struct(s, "LowerState", ["module", "current_fn", "current_block_idx", "tmp_counter", "block_counter", "vars", "scope_stack", "impl_methods", "struct_fields", "enum_variants", "lambda_vars", "fn_blocks", "generic_fns", "generic_structs", "generic_enums", "loop_header_label", "loop_exit_label", "comp_type_hint", "struct_update_counter", "chain_compare_counter"])
    // EmitState: lines, counter, functions, structs, module_name, str_counter, str_globals, current_ret_type, enum_names, enum_infos, enum_inline_slots, str_owned, list_owned, boxed_owned, tensor_owned, moved_locals, entry_prelude_lines, entry_block_body, in_entry_block, loop_depth, str_owned_source, list_owned_source, boxed_owned_source, tensor_owned_source, is_windows, win_arch
    s = register_internal_struct(s, "EmitState", ["lines", "counter", "functions", "structs", "module_name", "str_counter", "str_globals", "current_ret_type", "enum_names", "enum_infos", "enum_inline_slots", "str_owned", "list_owned", "boxed_owned", "tensor_owned", "moved_locals", "entry_prelude_lines", "entry_block_body", "in_entry_block", "loop_depth", "str_owned_source", "list_owned_source", "boxed_owned_source", "tensor_owned_source", "is_windows", "win_arch"])
    // LowerResult: value, state
    s = register_internal_struct(s, "LowerResult", ["value", "state"])
    // CompileResult: success, ir_text, errors
    s = register_internal_struct(s, "CompileResult", ["success", "ir_text", "errors"])
    // MatchBuildResult: state, arm_labels, arm_indices, cases, default_label
    s = register_internal_struct(s, "MatchBuildResult", ["state", "arm_labels", "arm_indices", "cases", "default_label"])
    // FnEntry: name, ret_type, param_types
    s = register_internal_struct(s, "FnEntry", ["name", "ret_type", "param_types"])
    // StructEntry: name, field_names, field_types, llvm_type
    s = register_internal_struct(s, "StructEntry", ["name", "field_names", "field_types", "llvm_type"])
    // VarInfo: name, current, mutable
    s = register_internal_struct(s, "VarInfo", ["name", "current", "mutable"])
    // StructFieldInfo: name, field_names, field_types
    s = register_internal_struct(s, "StructFieldInfo", ["name", "field_names", "field_types"])
    // EnumVariantNames: enum_name, variant_names
    s = register_internal_struct(s, "EnumVariantNames", ["enum_name", "variant_names"])
    // LambdaEntry: var_name, fn_name
    s = register_internal_struct(s, "LambdaEntry", ["var_name", "fn_name"])
    // ExternFnInfo: abi, module_name, fn_name, param_types, return_type
    s = register_internal_struct(s, "ExternFnInfo", ["abi", "module_name", "fn_name", "param_types", "return_type"])
    // VerifyError: fn_name, block_label, message
    s = register_internal_struct(s, "VerifyError", ["fn_name", "block_label", "message"])
    // ImplEntry: key, mir_name
    s = register_internal_struct(s, "ImplEntry", ["key", "mir_name"])
    // ImportInfo: path, items
    s = register_internal_struct(s, "ImportInfo", ["path", "items"])
    // ModuleConst: name, type_name, int_value, str_value, is_string
    s = register_internal_struct(s, "ModuleConst", ["name", "type_name", "int_value", "str_value", "is_string"])
    // AgentInfo: name, inputs, outputs, method_names
    s = register_internal_struct(s, "AgentInfo", ["name", "inputs", "outputs", "method_names"])
    // PipeInfo: name, stages
    s = register_internal_struct(s, "PipeInfo", ["name", "stages"])
    // MIRFunction: name, params, return_type, blocks, decorators, is_public
    s = register_internal_struct(s, "MIRFunction", ["name", "params", "return_type", "blocks", "decorators", "is_public"])
    // BasicBlock: label, instructions
    s = register_internal_struct(s, "BasicBlock", ["label", "instructions"])
    // MIRType: name, kind, args
    s = register_internal_struct(s, "MIRType", ["name", "kind", "args"])
    // Value: name, ty
    s = register_internal_struct(s, "Value", ["name", "ty"])
    return s

fn emit_global(st: EmitState, line: String) -> EmitState:
    st.str_globals.push(line)
    st

fn emit_fresh_tmp(st: EmitState, prefix: String) -> String = prefix + "." + toString(st.counter)

// ---------------------------------------------------------------------------
// Line emission
// ---------------------------------------------------------------------------

fn emit_line(st: EmitState, line: String) -> EmitState:
    // v5.4.1 — entry-block emission is buffered so the prelude
    // (tracking-slot allocas queued by emit_track_string / _boxed /
    // _closure) can be flushed in front of it before pushing to lines.
    if st.in_entry_block:
        st.entry_block_body.push(line)
    else:
        st.lines.push(line)
    st

fn emit_blank(st: EmitState) -> EmitState = emit_line(st, "")

// ---------------------------------------------------------------------------
// Counter helpers
// ---------------------------------------------------------------------------

fn next_ssa(st: EmitState) -> EmitState = st
    // Returns state with counter incremented; caller uses st.counter for name

fn ssa_name(st: EmitState) -> String = "%" + toString(st.counter)

fn next_str_name(st: EmitState) -> String = "@str." + toString(st.str_counter)

// ---------------------------------------------------------------------------
// Lookup helpers
// ---------------------------------------------------------------------------

fn find_function(st: EmitState, name: String) -> Option<FnEntry>:
    let mut i: Int = len(st.functions) - 1
    for _ in 0..2000:
        if i < 0 { return none }
        let f: FnEntry = st.functions[i]
        if f.name == name { return Some(f) }
        i = i - 1
    return none

fn find_struct_entry(st: EmitState, name: String) -> Option<StructEntry>:
    let mut i: Int = len(st.structs) - 1
    for _ in 0..2000:
        if i < 0 { return none }
        let s: StructEntry = st.structs[i]
        if s.name == name { return Some(s) }
        i = i - 1
    return none

// ---------------------------------------------------------------------------
// State-aware type resolution (corrects struct→enum misclassification)
// ---------------------------------------------------------------------------

fn resolve_type(st: EmitState, ty: MIRType) -> String:
    let resolved: String = resolve_mir_type(ty)
    if resolved.starts_with("%struct.") && is_enum_type(st, ty.name):
        return "%enum." + ty.name
    return resolved

// ---------------------------------------------------------------------------
// Runtime function declarations
// ---------------------------------------------------------------------------

// v4.32.0 Phase 1.2: mirrors the Python `_RUNTIME_FN_ATTRS` table at
// mapanare/emit_llvm_text.py:243-399. The v4.30.0 CARRY_FORWARD.md
// claim "six 7-cycle emitter items re-verified clean" was Python-side-
// only — Rattler #8 and Cobra #14 at the v4.31.0 arc-end panel flagged
// the self-hosted emitter as still producing plain `nounwind readonly`
// with no `noalias`/`willreturn` annotations. This release closes the
// asymmetry.
//
// The attribute rule (from emit_llvm_text.py:239-242):
//   - allocators  gain `noalias` (on return, ptr only) + `willreturn`
//   - read-only   queries gain `readonly` + `willreturn`
//   - every deterministic terminating function keeps `nounwind`
//
// `noalias` is a RETURN-VALUE attribute and LLVM rejects it on any non-
// pointer return type, so we emit it in the ret_prefix (before the
// return type) only when the declared ret is `ptr`. Every other
// attribute is a FUNCTION attribute and emitted as a suffix after the
// params list. This matches the split Python performs at
// emit_llvm_text.py:790-794.

fn declare_runtime_fn(st: EmitState, name: String, ret: String, params: String) -> EmitState:
    let mut ret_prefix: String = ""
    if ret == "ptr":
        ret_prefix = get_fn_ret_prefix(name)
    let suffix: String = get_fn_attrs(name)
    // v5.8.4 Wb.2 + v5.8.6 We.1: 3-way ABI dispatch.
    //
    //   Win64: aggregate-by-value params > 8 B → bare `ptr` (sarg
    //   pattern at call site); aggregate returns > 8 B → `void` with
    //   a `ptr sret(<orig>)` hidden first arg. Mirrors Python
    //   emit_llvm_text._decl_fn line 1271.
    //
    //   i686 cdecl: aggregate-by-value params > 8 B → `ptr byval(<orig>)
    //   align 4` (LLVM i686 backend lowers this as caller-pushes-by-
    //   value); aggregate returns > 8 B → same sret pattern as Win64.
    //   Empirical probe (i686-w64-mingw32-gcc 13) confirms structs
    //   sized 12 / 16 / 24 / 64 / 80 take this path; size 8 returns
    //   in EAX:EDX register pair without rewriting.
    //
    //   SysV / AAPCS64: by-value as today, no rewriting.
    if use_win64_abi(st):
        let abi_params: String = win64_rewrite_decl_params(params)
        let mut abi_ret: String = ret
        let mut prefix_args: String = ""
        if is_large_aggregate(ret):
            abi_ret = "void"
            prefix_args = "ptr sret(" + ret + ")"
            ret_prefix = ""
        let mut combined: String = abi_params
        if len(prefix_args) > 0:
            combined = prefix_args
            if len(abi_params) > 0:
                combined = prefix_args + ", " + abi_params
        let line_w: String = "declare " + ret_prefix + abi_ret + " @" + name + "(" + combined + ")" + suffix
        return emit_line(st, line_w)
    if use_i686_abi(st):
        let abi_params_i: String = i686_rewrite_decl_params(params)
        let mut abi_ret_i: String = ret
        let mut prefix_args_i: String = ""
        if is_large_aggregate(ret):
            abi_ret_i = "void"
            prefix_args_i = "ptr sret(" + ret + ") align 8"
            ret_prefix = ""
        let mut combined_i: String = abi_params_i
        if len(prefix_args_i) > 0:
            combined_i = prefix_args_i
            if len(abi_params_i) > 0:
                combined_i = prefix_args_i + ", " + abi_params_i
        let line_i: String = "declare " + ret_prefix + abi_ret_i + " @" + name + "(" + combined_i + ")" + suffix
        return emit_line(st, line_i)
    // v5.8.8 Da.1: SysV / AAPCS64 default — > 16 B aggregate returns
    // must use sret. SysV's "memory class" rule (AMD64 §3.2.3) and
    // AAPCS64's x8 indirect-result rule both lower a 40-byte struct
    // return via a hidden first-arg pointer. LLVM's x86_64 backend
    // *silently* rewrites first-class aggregate returns to sret-style
    // memory return, so the old `declare {ptr, i64, ...} @fn()` shape
    // worked on Linux by accident; LLVM's arm64 backend does not have
    // an equivalent rewrite, so the same IR miscompiles on Apple
    // Silicon. Emitting the canonical sret form on both targets
    // matches what clang produces from C and produces equivalent
    // machine code via either backend. See
    // docs/roadmap/v5/v5.8.7/PHASE_0_FINDINGS.md.
    let ret_size: Int = llvm_type_size(ret)
    if is_large_aggregate(ret) && ret_size > 16:
        let abi_ret_d: String = "void"
        let prefix_d: String = "ptr sret(" + ret + ") align 8"
        let mut combined_d: String = prefix_d
        if len(params) > 0:
            combined_d = prefix_d + ", " + params
        let line_d: String = "declare " + abi_ret_d + " @" + name + "(" + combined_d + ")" + suffix
        return emit_line(st, line_d)
    let line: String = "declare " + ret_prefix + ret + " @" + name + "(" + params + ")" + suffix
    return emit_line(st, line)

// v5.8.4 Wb.2: rewrites a comma-separated declaration param list for
// the Win64 ABI. Aggregate-by-value param types > 8 bytes (e.g.
// "{ptr, i64}", "{ptr, i64, i64, i64, i64}") become "ptr"; scalar
// params are unchanged. The runtime fn declarations are well-formed
// and known — their param strings are constant string literals built
// out of the llvm_string()/llvm_list_rt() helpers. We do textual
// rewrites on those exact known forms (rather than a general parser)
// because the brace-depth tracker has a Mapanare-side build-time bug
// that produced corrupted strings on this codepath. Listing the
// concrete prefixes is bounded and enumerable.
fn win64_rewrite_decl_params(params: String) -> String:
    let mut out: String = params
    // Replace each occurrence of an aggregate-by-value type with `ptr`.
    // Order matters — replace the longest first so substrings don't
    // partially match.
    out = replace_all_str(out, "{ptr, i64, i64, i64, i64}", "ptr")
    out = replace_all_str(out, "{ptr, i64, i64, i64}", "ptr")
    out = replace_all_str(out, "{ptr, i64, ptr, i64}", "ptr")
    out = replace_all_str(out, "{ptr, i64}", "ptr")
    out = replace_all_str(out, "{i64, i64}", "ptr")
    out = replace_all_str(out, "{i1, ptr}", "ptr")
    return out

// Simple non-overlapping string replacer: finds every occurrence of
// `needle` in `haystack` and replaces with `repl`. Pure Mapanare-side
// implementation — no runtime help needed.
fn replace_all_str(haystack: String, needle: String, repl: String) -> String:
    let nlen: Int = len(needle)
    if nlen == 0 { return haystack }
    let mut out: String = ""
    let mut start: Int = 0
    let hlen: Int = len(haystack)
    let mut i: Int = 0
    for _ in 0..10000:
        if i + nlen > hlen { break }
        let candidate: String = haystack.substr(i, nlen)
        if candidate == needle:
            out = out + haystack.substr(start, i - start) + repl
            i = i + nlen
            start = i
        else:
            i = i + 1
    if start < hlen:
        out = out + haystack.substr(start, hlen - start)
    return out

// True iff `ty` is an aggregate value > 8 bytes — the Win64 threshold
// for sret/sarg lowering. Mirrors Python emit_llvm_text._is_large_struct.
fn is_large_aggregate(ty: String) -> Bool:
    if !ty.starts_with("{") { return false }
    if !ty.ends_with("}") { return false }
    return llvm_type_size(ty) > 8

// v5.8.6 We.1: ABI-mode dispatch helpers. Replace the v5.8.4 single
// `st.is_win64` boolean — that flag conflated "is Windows" with "use
// Win64 ABI rules" because its source `__mn_host_is_win64()` actually
// reads `_WIN32` (defined for both 32-bit and 64-bit Windows). Now
// the running compiler reads `__mn_host_is_windows()` +
// `__mn_host_arch_bits()` and these two helpers gate the three
// distinct ABI paths the emitter supports.
//
//   use_win64_abi(st) — Win64: aggregate args > 8 B alloca'd to ptr
//   (sarg pattern); aggregate returns > 8 B use sret void prefix.
//
//   use_i686_abi(st) — i686 cdecl: aggregate args > 8 B alloca'd
//   then passed as `ptr byval(<orig>) align 4`; aggregate returns
//   > 8 B use the same sret void prefix as Win64. Stack alignment
//   on i686 is 4 B (vs Win64's 16 B), so alloca + byval both use
//   align 4 to match clang's i686-w64-windows-gnu emission.
//
//   Default (neither): SysV / AAPCS64 — pass and return aggregates
//   by value as today.
fn use_win64_abi(st: EmitState) -> Bool:
    if !st.is_windows { return false }
    if st.win_arch != 64 { return false }
    return true

fn use_i686_abi(st: EmitState) -> Bool:
    if !st.is_windows { return false }
    if st.win_arch != 32 { return false }
    return true

// v5.8.6 We.1: rewrites a comma-separated declaration param list for
// the i686 cdecl ABI. Aggregate-by-value param types > 8 bytes get
// the `byval` attribute decoration so LLVM's i686 backend lowers
// them as stack-pushed-by-value (matching gcc/clang's C ABI for
// MnString-shaped runtime fns). Caller pushes the entire struct on
// the stack; callee reads from positive %ebp offsets. Mirrors clang
// --target=i686-w64-windows-gnu emission for `void f(MnString s)`.
fn i686_rewrite_decl_params(params: String) -> String:
    let mut out: String = params
    // Order matters — replace the longest first so substrings don't
    // partially match. Each aggregate-by-value type gets the
    // `ptr byval(<orig>) align 4` decoration.
    out = replace_all_str(out, "{ptr, i64, i64, i64, i64}", "ptr byval({ptr, i64, i64, i64, i64}) align 4")
    out = replace_all_str(out, "{ptr, i64, i64, i64}", "ptr byval({ptr, i64, i64, i64}) align 4")
    out = replace_all_str(out, "{ptr, i64, ptr, i64}", "ptr byval({ptr, i64, ptr, i64}) align 4")
    out = replace_all_str(out, "{ptr, i64}", "ptr byval({ptr, i64}) align 4")
    out = replace_all_str(out, "{i64, i64}", "ptr byval({i64, i64}) align 4")
    out = replace_all_str(out, "{i1, ptr}", "ptr byval({i1, ptr}) align 4")
    return out

// v5.8.6 We.1: like win64_sarg_rewrite_args but emits the byval-
// decorated form. Win64 expects callers to push a *pointer* to the
// caller-allocated struct; i686 cdecl expects callers to push the
// *struct contents* on the stack. The IR-level difference is the
// `byval(<agg_ty>) align 4` decoration on the pointer pass — LLVM's
// i686 backend reads this and generates the stack-push lowering.
// Pre-conditions identical to win64_sarg_rewrite_args; caller MUST
// follow with i686_sarg_advance_state on the same args_text + agg_ty
// to keep counter / alloca / store emission in sync.
fn i686_sarg_rewrite_args(args_text: String, agg_ty: String, st: EmitState) -> String:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0 { return args_text }
    let h_len: Int = len(args_text)
    if h_len == 0 { return args_text }
    let mut out: String = ""
    let mut start: Int = 0
    let mut i: Int = 0
    let mut sarg_n: Int = st.counter
    for _ in 0..1000:
        if i + aty_len > h_len { break }
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            let mut j: Int = i + aty_len
            if j < h_len && args_text.substr(j, 1) == " " { j = j + 1 }
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len { break }
                let c: String = args_text.substr(k, 1)
                if c == "," { break }
                k = k + 1
            out = out + args_text.substr(start, i - start)
            out = out + "ptr byval(" + agg_ty + ") align 4 %sarg." + toString(sarg_n)
            sarg_n = sarg_n + 1
            i = k
            start = k
        else:
            i = i + 1
    if start < h_len:
        out = out + args_text.substr(start, h_len - start)
    return out

// v5.8.6 We.1: emits the alloca + store sarg-prelude lines for each
// occurrence of `agg_ty` in `args_text` for i686 cdecl. Mechanically
// identical to win64_sarg_advance_state except `align 4` on the
// alloca — i686's stack pointer alignment is 4 B, and clang's
// i686-w64-windows-gnu emission uses align 4 for stack-pushed
// aggregates regardless of contained field types (i64s included).
// Bumps `st.counter` once per occurrence; counter values must match
// those consumed by i686_sarg_rewrite_args on the same input.
fn i686_sarg_advance_state(st: EmitState, args_text: String, agg_ty: String) -> EmitState:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0 { return st }
    let h_len: Int = len(args_text)
    if h_len == 0 { return st }
    let mut s: EmitState = st
    let mut i: Int = 0
    for _ in 0..1000:
        if i + aty_len > h_len { break }
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            let mut j: Int = i + aty_len
            if j < h_len && args_text.substr(j, 1) == " " { j = j + 1 }
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len { break }
                let c: String = args_text.substr(k, 1)
                if c == "," { break }
                k = k + 1
            let aval: String = ws_trim(args_text.substr(j, k - j))
            let sarg_n: Int = s.counter
            s.counter = s.counter + 1
            let slot: String = "%sarg." + toString(sarg_n)
            s = emit_line(s, "  " + slot + " = alloca " + agg_ty + ", align 4")
            s = emit_line(s, "  store " + agg_ty + " " + aval + ", ptr " + slot)
            i = k
        else:
            i = i + 1
    return s

// Manual whitespace trimming. The self-hosted lowerer doesn't yet
// translate `.trim()` method calls to `__mn_str_trim` runtime fn, so
// our helpers spell trimming out manually rather than rely on the
// String method.
fn ws_trim(s: String) -> String:
    let n: Int = len(s)
    if n == 0 { return s }
    let mut start: Int = 0
    for _ in 0..10000:
        if start >= n { break }
        let c0: String = s.substr(start, 1)
        if c0 != " " && c0 != "\t" { break }
        start = start + 1
    let mut end: Int = n
    for _ in 0..10000:
        if end <= start { break }
        let c1: String = s.substr(end - 1, 1)
        if c1 != " " && c1 != "\t" { break }
        end = end - 1
    if start == 0 && end == n { return s }
    return s.substr(start, end - start)

// v5.8.4 Wb.2: emit a runtime function call with target-aware ABI
// handling. On non-Win64, identical to
//   emit_line(st, emit_call_ir(dn, ret_ty, fn_name, args_text)).
// On Win64, aggregate-by-value args > 8 bytes are rewritten to sarg
// (alloca + store + ptr) and aggregate returns > 8 bytes use sret
// (alloca + call void with hidden ptr + load). Mirrors Python
// emit_llvm_text._rt at line 1502.
//
// Args text format (caller-built):
//   "i64 5"
//   "{ptr, i64} %x, i64 5"
//   "{ptr, i64} %x, {ptr, i64} %y"
//   etc.
// We rewrite aggregate args in two passes:
//   1) For each known aggregate type literal that appears, generate
//      sarg alloca/store entries (one per occurrence), then
//   2) Replace the textual occurrence with "ptr %sarg.N".
fn emit_rt_call(st: EmitState, dn: String, ret_ty: String, fn_name: String, args_text: String) -> EmitState:
    if use_win64_abi(st):
        let mut s: EmitState = st
        let mut new_args: String = args_text
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, i64, i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, i64, i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i1, ptr}", s)
        s = win64_sarg_advance_state(s, args_text, "{i1, ptr}")
        if is_large_aggregate(ret_ty):
            let sret_n: Int = s.counter
            s.counter = s.counter + 1
            let sret_slot: String = "%sret." + toString(sret_n)
            s = emit_line(s, "  " + sret_slot + " = alloca " + ret_ty + ", align 8")
            let sret_arg: String = "ptr sret(" + ret_ty + ") " + sret_slot
            let mut combined: String = sret_arg
            if len(new_args) > 0:
                combined = sret_arg + ", " + new_args
            s = emit_line(s, "  call void @" + fn_name + "(" + combined + ")")
            s = emit_line(s, "  " + dn + " = load " + ret_ty + ", ptr " + sret_slot)
            return s
        return emit_line(s, emit_call_ir(dn, ret_ty, fn_name, new_args))
    if use_i686_abi(st):
        let mut s2: EmitState = st
        let mut new_args2: String = args_text
        // v5.8.6 We.1: same enumeration order as Win64 — replace
        // longest aggregate strings first to avoid substring overlap.
        // i686 emits `ptr byval(<orig>) align 4 %sarg.N` instead of
        // bare `ptr %sarg.N`, but the alloca + store + counter
        // mechanics are identical. align 4 on the alloca matches
        // i686 stack-alignment conventions and clang's i686 emission.
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, i64, i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, i64, i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i1, ptr}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i1, ptr}")
        if is_large_aggregate(ret_ty):
            let sret_n2: Int = s2.counter
            s2.counter = s2.counter + 1
            let sret_slot2: String = "%sret." + toString(sret_n2)
            s2 = emit_line(s2, "  " + sret_slot2 + " = alloca " + ret_ty + ", align 8")
            let sret_arg2: String = "ptr sret(" + ret_ty + ") align 8 " + sret_slot2
            let mut combined2: String = sret_arg2
            if len(new_args2) > 0:
                combined2 = sret_arg2 + ", " + new_args2
            s2 = emit_line(s2, "  call void @" + fn_name + "(" + combined2 + ")")
            s2 = emit_line(s2, "  " + dn + " = load " + ret_ty + ", ptr " + sret_slot2)
            return s2
        return emit_line(s2, emit_call_ir(dn, ret_ty, fn_name, new_args2))
    // v5.8.8 Da.1: SysV / AAPCS64 default — sret call shape for
    // > 16 B aggregate returns. Mirrors declare_runtime_fn's default
    // sret declaration. Caller alloca + sret call + load.
    let ret_sz_d: Int = llvm_type_size(ret_ty)
    if is_large_aggregate(ret_ty) && ret_sz_d > 16:
        let mut s_d: EmitState = st
        let sret_n_d: Int = s_d.counter
        s_d.counter = s_d.counter + 1
        let sret_slot_d: String = "%sret." + toString(sret_n_d)
        s_d = emit_line(s_d, "  " + sret_slot_d + " = alloca " + ret_ty + ", align 8")
        let sret_arg_d: String = "ptr sret(" + ret_ty + ") align 8 " + sret_slot_d
        let mut combined_d: String = sret_arg_d
        if len(args_text) > 0:
            combined_d = sret_arg_d + ", " + args_text
        s_d = emit_line(s_d, "  call void @" + fn_name + "(" + combined_d + ")")
        s_d = emit_line(s_d, "  " + dn + " = load " + ret_ty + ", ptr " + sret_slot_d)
        return s_d
    return emit_line(st, emit_call_ir(dn, ret_ty, fn_name, args_text))

// v5.8.4 Wb.2 + v5.8.6 We.1: void variant — same arg-rewrite logic,
// no return value to load. Ret is implicitly "void". 3-way dispatch
// parallels emit_rt_call.
fn emit_rt_call_void(st: EmitState, fn_name: String, args_text: String) -> EmitState:
    if use_win64_abi(st):
        let mut s: EmitState = st
        let mut new_args: String = args_text
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, i64, i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, i64, i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i1, ptr}", s)
        s = win64_sarg_advance_state(s, args_text, "{i1, ptr}")
        return emit_line(s, emit_call_void(fn_name, new_args))
    if use_i686_abi(st):
        let mut s2: EmitState = st
        let mut new_args2: String = args_text
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, i64, i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, i64, i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i1, ptr}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i1, ptr}")
        return emit_line(s2, emit_call_void(fn_name, new_args2))
    return emit_line(st, emit_call_void(fn_name, args_text))

// Helper: scans `args_text` for occurrences of `agg_ty` followed by
// " <value>". For each, replaces the pair with "ptr %sarg.N" using
// fresh counters from `st.counter`. Returns rewritten text.
//
// Caveat: this function does NOT mutate `st` — it must NOT be called
// in isolation. The caller MUST follow with win64_sarg_advance_state
// using the same args_text and agg_ty so subsequent counters / emits
// stay consistent. We split the work this way because Mapanare's
// build-time emitter has trouble with mutual return-position passing
// of a struct + string from a single helper (binary corruption seen
// in a more general parser). The two-helper pattern uses only string
// concatenation and integer arithmetic which is well-tested.
fn win64_sarg_rewrite_args(args_text: String, agg_ty: String, st: EmitState) -> String:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0 { return args_text }
    let h_len: Int = len(args_text)
    if h_len == 0 { return args_text }
    let mut out: String = ""
    let mut start: Int = 0
    let mut i: Int = 0
    let mut sarg_n: Int = st.counter
    for _ in 0..1000:
        if i + aty_len > h_len { break }
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            // After the type, expect " <value>" where <value> ends at
            // ',' or end-of-string.
            let mut j: Int = i + aty_len
            // Skip the leading space (LLVM IR convention "{ty} %v").
            if j < h_len && args_text.substr(j, 1) == " " { j = j + 1 }
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len { break }
                let c: String = args_text.substr(k, 1)
                if c == "," { break }
                k = k + 1
            // Append [start, i), then "ptr %sarg.N", then advance.
            out = out + args_text.substr(start, i - start)
            out = out + "ptr %sarg." + toString(sarg_n)
            sarg_n = sarg_n + 1
            i = k
            start = k
        else:
            i = i + 1
    if start < h_len:
        out = out + args_text.substr(start, h_len - start)
    return out

// Helper: emits the alloca + store sarg-prelude lines for each
// occurrence of `agg_ty` in `args_text`, mirroring the rewrite done
// by win64_sarg_rewrite_args. Bumps `st.counter` once per occurrence.
fn win64_sarg_advance_state(st: EmitState, args_text: String, agg_ty: String) -> EmitState:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0 { return st }
    let h_len: Int = len(args_text)
    if h_len == 0 { return st }
    let mut s: EmitState = st
    let mut i: Int = 0
    for _ in 0..1000:
        if i + aty_len > h_len { break }
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            // Extract the value name immediately following.
            let mut j: Int = i + aty_len
            if j < h_len && args_text.substr(j, 1) == " " { j = j + 1 }
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len { break }
                let c: String = args_text.substr(k, 1)
                if c == "," { break }
                k = k + 1
            let aval: String = ws_trim(args_text.substr(j, k - j))
            let sarg_n: Int = s.counter
            s.counter = s.counter + 1
            let slot: String = "%sarg." + toString(sarg_n)
            s = emit_line(s, "  " + slot + " = alloca " + agg_ty + ", align 8")
            s = emit_line(s, "  store " + agg_ty + " " + aval + ", ptr " + slot)
            i = k
        else:
            i = i + 1
    return s

// Return-value attribute prefix. Only ``noalias`` qualifies, and only
// for allocator functions that return a freshly-heap-allocated pointer
// the caller did not previously hold. LLVM rejects ``noalias`` on any
// non-pointer return type; the caller (``declare_runtime_fn``) guards
// this with ``if ret == "ptr"`` before invoking us.
fn get_fn_ret_prefix(name: String) -> String:
    if name == "malloc" { return "noalias " }
    if name == "__mn_alloc" { return "noalias " }
    if name == "__mn_map_new" { return "noalias " }
    if name == "__mn_signal_new" { return "noalias " }
    if name == "mapanare_agent_new" { return "noalias " }
    if name == "mn_arena_create" { return "noalias " }
    if name == "mn_arena_alloc" { return "noalias " }
    if name == "__mapanare_tensor_alloc" { return "noalias " }
    if name == "__mapanare_tensor_add" { return "noalias " }
    if name == "__mapanare_tensor_sub" { return "noalias " }
    if name == "__mapanare_tensor_mul" { return "noalias " }
    if name == "__mapanare_tensor_div" { return "noalias " }
    if name == "__mapanare_matmul" { return "noalias " }
    // v5.6.2 Sh.6 Phase 3 — broadcast / scalar / reverse-scalar binops
    // return a fresh heap-allocated tensor pointer (noalias).
    if name == "__mn_tensor_add_broadcast_f64" { return "noalias " }
    if name == "__mn_tensor_sub_broadcast_f64" { return "noalias " }
    if name == "__mn_tensor_mul_broadcast_f64" { return "noalias " }
    if name == "__mn_tensor_div_broadcast_f64" { return "noalias " }
    if name == "__mn_tensor_add_broadcast_i64" { return "noalias " }
    if name == "__mn_tensor_sub_broadcast_i64" { return "noalias " }
    if name == "__mn_tensor_mul_broadcast_i64" { return "noalias " }
    if name == "__mn_tensor_div_broadcast_i64" { return "noalias " }
    if name == "__mn_tensor_add_scalar_f64" { return "noalias " }
    if name == "__mn_tensor_sub_scalar_f64" { return "noalias " }
    if name == "__mn_tensor_mul_scalar_f64" { return "noalias " }
    if name == "__mn_tensor_div_scalar_f64" { return "noalias " }
    if name == "__mn_tensor_add_scalar_i64" { return "noalias " }
    if name == "__mn_tensor_sub_scalar_i64" { return "noalias " }
    if name == "__mn_tensor_mul_scalar_i64" { return "noalias " }
    if name == "__mn_tensor_div_scalar_i64" { return "noalias " }
    if name == "__mn_tensor_rsub_scalar_f64" { return "noalias " }
    if name == "__mn_tensor_rdiv_scalar_f64" { return "noalias " }
    if name == "__mn_tensor_rsub_scalar_i64" { return "noalias " }
    if name == "__mn_tensor_rdiv_scalar_i64" { return "noalias " }
    // v5.6.3 Sh.6 Phase 4 — slice returns a fresh heap tensor (noalias).
    if name == "__mn_tensor_slice" { return "noalias " }
    // v5.45.0 Ts.2.B — __mn_tensor_reshape semantic swap to alias.
    // The noalias attribute would be a lie under aliasing semantics
    // (writes to result visible in source). __mn_tensor_view is the
    // alias-flavor sibling shipped at v5.45.0. __mn_tensor_step_slice
    // returns a fresh contiguous tensor (copy semantics) — no noalias
    // for v5.45.0 conservatively (consistent with the rest of the
    // tensor-producing surface).
    return ""

// Function-attribute suffix. Mirrors the Python `_RUNTIME_FN_ATTRS`
// table, excluding `noalias` (which is a return-value attribute handled
// by get_fn_ret_prefix). Entries that aren't declared by this emitter
// (e.g. DB / HTML / crypto-str variants used only by the Python
// bootstrap) are included for consistency — unreachable declare calls
// won't fire the branches, and the cost of an unused branch is ~0.
fn get_fn_attrs(name: String) -> String:
    // -- Read-only string/collection queries --
    if name == "__mn_str_len" { return " nounwind readonly willreturn" }
    if name == "__mn_str_eq" { return " nounwind readonly willreturn" }
    if name == "__mn_str_cmp" { return " nounwind readonly willreturn" }
    if name == "__mn_str_hash" { return " nounwind readonly willreturn" }
    if name == "__mn_str_byte_at" { return " nounwind readonly willreturn" }
    if name == "__mn_str_starts_with" { return " nounwind readonly willreturn" }
    if name == "__mn_str_ends_with" { return " nounwind readonly willreturn" }
    if name == "__mn_str_find" { return " nounwind readonly willreturn" }
    if name == "__mn_str_contains" { return " nounwind readonly willreturn" }
    if name == "__mn_str_to_int" { return " nounwind readonly willreturn" }
    if name == "__mn_str_to_float" { return " nounwind readonly willreturn" }
    if name == "__mn_str_ord" { return " nounwind readonly willreturn" }
    if name == "__mn_list_len" { return " nounwind readonly willreturn" }
    if name == "__mn_list_get" { return " nounwind readonly willreturn" }
    if name == "__mn_map_len" { return " nounwind readonly willreturn" }
    if name == "__mn_map_contains" { return " nounwind readonly willreturn" }
    if name == "__mn_range" { return " nounwind readonly willreturn" }
    // -- Allocators (noalias in prefix; suffix = nounwind willreturn) --
    if name == "malloc" { return " nounwind willreturn" }
    if name == "__mn_alloc" { return " nounwind willreturn" }
    if name == "__mn_str_concat" { return " nounwind willreturn" }
    if name == "__mn_str_from_int" { return " nounwind willreturn" }
    if name == "__mn_str_from_float" { return " nounwind willreturn" }
    if name == "__mn_str_from_bool" { return " nounwind willreturn" }
    if name == "__mn_str_substr" { return " nounwind willreturn" }
    if name == "__mn_str_chr" { return " nounwind willreturn" }
    if name == "__mn_str_to_upper" { return " nounwind willreturn" }
    if name == "__mn_str_to_lower" { return " nounwind willreturn" }
    if name == "__mn_str_replace" { return " nounwind willreturn" }
    if name == "__mn_str_split" { return " nounwind willreturn" }
    if name == "__mn_str_trim" { return " nounwind willreturn" }
    if name == "__mn_str_join" { return " nounwind willreturn" }
    if name == "__mn_list_new" { return " nounwind willreturn" }
    if name == "__mn_list_concat" { return " nounwind willreturn" }
    if name == "__mn_map_new" { return " nounwind willreturn" }
    if name == "__mn_map_keys" { return " nounwind willreturn" }
    if name == "__mn_signal_new" { return " nounwind willreturn" }
    if name == "mapanare_agent_new" { return " nounwind willreturn" }
    if name == "mn_arena_create" { return " nounwind willreturn" }
    if name == "mn_arena_alloc" { return " nounwind willreturn" }
    // -- Cleanup / free (willreturn, no readonly — frees memory) --
    if name == "free" { return " nounwind willreturn" }
    if name == "__mn_str_free" { return " nounwind willreturn" }
    if name == "__mn_list_free" { return " nounwind willreturn" }
    if name == "__mn_map_free" { return " nounwind willreturn" }
    if name == "__mn_map_free_deep" { return " nounwind willreturn" }
    if name == "__mn_stream_free" { return " nounwind willreturn" }
    if name == "__mn_stream_free_chain" { return " nounwind willreturn" }
    if name == "__mn_range_free" { return " nounwind willreturn" }
    if name == "__mn_signal_free" { return " nounwind willreturn" }
    if name == "mn_arena_destroy" { return " nounwind willreturn" }
    if name == "__mapanare_tensor_free" { return " nounwind willreturn" }
    // -- Mutation (nounwind only — writes through caller-owned memory) --
    if name == "__mn_list_push" { return " nounwind" }
    if name == "__mn_list_set" { return " nounwind" }
    if name == "__mn_map_set" { return " nounwind" }
    if name == "__mn_map_get" { return " nounwind" }
    // -- Print / I/O writes (observable but terminate) --
    if name == "__mn_print" { return " nounwind willreturn" }
    if name == "__mn_println" { return " nounwind willreturn" }
    if name == "__mn_str_print" { return " nounwind willreturn" }
    if name == "__mn_str_println" { return " nounwind willreturn" }
    if name == "__mn_str_eprint" { return " nounwind willreturn" }
    if name == "__mn_indent_to_braces" { return " nounwind willreturn" }
    if name == "__mn_count_user_brace_block_openers" { return " nounwind willreturn" }
    if name == "__mn_emit_brace_deprecation_warning" { return " nounwind willreturn" }
    if name == "__mn_str_eprintln" { return " nounwind willreturn" }
    // -- I/O (v3.41.0) --
    if name == "__mn_read_line" { return " nounwind willreturn" }
    if name == "__mn_file_append" { return " nounwind willreturn" }
    if name == "__mn_dir_list_strings" { return " nounwind willreturn" }
    if name == "__mn_file_exists" { return " nounwind readonly willreturn" }
    if name == "__mn_file_remove" { return " nounwind willreturn" }
    if name == "__mn_file_size" { return " nounwind readonly willreturn" }
    if name == "__mn_file_mtime" { return " nounwind readonly willreturn" }
    if name == "__mn_dir_create" { return " nounwind willreturn" }
    if name == "__mn_dir_remove" { return " nounwind willreturn" }
    if name == "__mn_file_rename" { return " nounwind willreturn" }
    if name == "__mn_file_copy" { return " nounwind willreturn" }
    if name == "__mn_realpath" { return " nounwind willreturn" }
    if name == "__mn_tmpfile_path" { return " nounwind willreturn" }
    // -- Network / crypto / regex (v3.42.0) --
    if name == "__mn_http_get" { return " nounwind willreturn" }
    if name == "__mn_sha256_str" { return " nounwind willreturn" }
    if name == "__mn_base64_encode_str" { return " nounwind willreturn" }
    if name == "__mn_base64_decode_str" { return " nounwind willreturn" }
    if name == "__mn_hmac_sha256_str" { return " nounwind willreturn" }
    if name == "__mn_hex_encode_str" { return " nounwind willreturn" }
    if name == "__mn_random_bytes_str" { return " nounwind willreturn" }
    if name == "__mn_regex_compile_str" { return " nounwind willreturn" }
    if name == "__mn_regex_exec_str" { return " nounwind willreturn" }
    if name == "__mn_regex_replace_str" { return " nounwind willreturn" }
    if name == "__mn_regex_free" { return " nounwind willreturn" }
    // -- GPU (v3.46.0) --
    if name == "__mn_gpu_available" { return " nounwind readonly willreturn" }
    if name == "__mn_gpu_device_name" { return " nounwind willreturn" }
    if name == "__mn_gpu_device_memory" { return " nounwind readonly willreturn" }
    if name == "__mn_gpu_tensor_add" { return " nounwind willreturn" }
    if name == "__mn_gpu_tensor_sub" { return " nounwind willreturn" }
    if name == "__mn_gpu_tensor_mul" { return " nounwind willreturn" }
    if name == "__mn_gpu_tensor_div" { return " nounwind willreturn" }
    if name == "__mn_gpu_tensor_matmul" { return " nounwind willreturn" }
    // -- Tensor runtime --
    if name == "__mapanare_tensor_add" { return " nounwind willreturn" }
    if name == "__mapanare_tensor_sub" { return " nounwind willreturn" }
    if name == "__mapanare_tensor_mul" { return " nounwind willreturn" }
    if name == "__mapanare_tensor_div" { return " nounwind willreturn" }
    if name == "__mapanare_matmul" { return " nounwind willreturn" }
    if name == "__mapanare_tensor_alloc" { return " nounwind willreturn" }
    if name == "__mapanare_tensor_shape_eq" { return " nounwind readonly willreturn" }
    // v5.6.0 Sh.6 __mn_tensor_* attrs (mirrors emit_llvm_text.py RUNTIME_ATTRS).
    if name == "__mn_tensor_alloc" { return " nounwind willreturn" }
    if name == "__mn_tensor_free" { return " nounwind willreturn" }
    if name == "__mn_tensor_store_f64" { return " nounwind willreturn" }
    if name == "__mn_tensor_store_i64" { return " nounwind willreturn" }
    if name == "__mn_tensor_get_f64" { return " nounwind readonly willreturn" }
    if name == "__mn_tensor_get_i64" { return " nounwind readonly willreturn" }
    if name == "__mn_tensor_rank" { return " nounwind readonly willreturn" }
    if name == "__mn_tensor_size" { return " nounwind readonly willreturn" }
    if name == "__mn_tensor_shape_dim" { return " nounwind readonly willreturn" }
    if name == "__mn_tensor_print_f64" { return " nounwind willreturn" }
    // v5.6.1 Sh.6 Phase 2 — variadic nd getters/setters; nounwind only,
    // no `readonly` because LLVM varargs intrinsics are conservative.
    if name == "__mn_tensor_get_f64_nd" { return " nounwind" }
    if name == "__mn_tensor_get_i64_nd" { return " nounwind" }
    if name == "__mn_tensor_set_f64_nd" { return " nounwind" }
    if name == "__mn_tensor_set_i64_nd" { return " nounwind" }
    // v5.6.2 Sh.6 Phase 3 — broadcast / scalar / reverse-scalar binops
    // (mirrors emit_llvm_text.py:357-377). `noalias` is emitted as a
    // return-value prefix by get_fn_ret_prefix; the fn-attr suffix is
    // just `nounwind`.
    if name == "__mn_tensor_add_broadcast_f64" { return " nounwind" }
    if name == "__mn_tensor_sub_broadcast_f64" { return " nounwind" }
    if name == "__mn_tensor_mul_broadcast_f64" { return " nounwind" }
    if name == "__mn_tensor_div_broadcast_f64" { return " nounwind" }
    if name == "__mn_tensor_add_broadcast_i64" { return " nounwind" }
    if name == "__mn_tensor_sub_broadcast_i64" { return " nounwind" }
    if name == "__mn_tensor_mul_broadcast_i64" { return " nounwind" }
    if name == "__mn_tensor_div_broadcast_i64" { return " nounwind" }
    if name == "__mn_tensor_add_scalar_f64" { return " nounwind" }
    if name == "__mn_tensor_sub_scalar_f64" { return " nounwind" }
    if name == "__mn_tensor_mul_scalar_f64" { return " nounwind" }
    if name == "__mn_tensor_div_scalar_f64" { return " nounwind" }
    if name == "__mn_tensor_add_scalar_i64" { return " nounwind" }
    if name == "__mn_tensor_sub_scalar_i64" { return " nounwind" }
    if name == "__mn_tensor_mul_scalar_i64" { return " nounwind" }
    if name == "__mn_tensor_div_scalar_i64" { return " nounwind" }
    if name == "__mn_tensor_rsub_scalar_f64" { return " nounwind" }
    if name == "__mn_tensor_rdiv_scalar_f64" { return " nounwind" }
    if name == "__mn_tensor_rsub_scalar_i64" { return " nounwind" }
    if name == "__mn_tensor_rdiv_scalar_i64" { return " nounwind" }
    // v5.6.3 Sh.6 Phase 4 — reductions are readonly (pure over tensor data);
    // slice returns a new tensor (nounwind + noalias via ret prefix).
    if name == "__mn_tensor_sum_f64" { return " nounwind readonly" }
    if name == "__mn_tensor_mean_f64" { return " nounwind readonly" }
    if name == "__mn_tensor_max_f64" { return " nounwind readonly" }
    if name == "__mn_tensor_min_f64" { return " nounwind readonly" }
    if name == "__mn_tensor_argmax_f64" { return " nounwind readonly" }
    if name == "__mn_tensor_argmin_f64" { return " nounwind readonly" }
    if name == "__mn_tensor_sum_i64" { return " nounwind readonly" }
    if name == "__mn_tensor_max_i64" { return " nounwind readonly" }
    if name == "__mn_tensor_min_i64" { return " nounwind readonly" }
    if name == "__mn_tensor_argmax_i64" { return " nounwind readonly" }
    if name == "__mn_tensor_argmin_i64" { return " nounwind readonly" }
    if name == "__mn_tensor_slice" { return " nounwind" }
    if name == "__mn_tensor_reshape" { return " nounwind" }
    // v5.45.0 Ts.2.B / Ts.3.B — view + step_slice exports.
    if name == "__mn_tensor_view" { return " nounwind" }
    if name == "__mn_tensor_step_slice" { return " nounwind" }
    // -- Agent runtime (v3.43.0) --
    if name == "mapanare_agent_spawn" { return " nounwind willreturn" }
    if name == "mapanare_agent_send" { return " nounwind willreturn" }
    if name == "mapanare_agent_recv_blocking" { return " nounwind" }
    if name == "mapanare_agent_stop" { return " nounwind willreturn" }
    if name == "mapanare_agent_destroy" { return " nounwind willreturn" }
    if name == "__mn_agent_spawn" { return " nounwind willreturn" }
    if name == "__mn_agent_send" { return " nounwind willreturn" }
    if name == "__mn_agent_sync" { return " nounwind willreturn" }
    // -- Signal runtime --
    if name == "__mn_signal_get" { return " nounwind" }
    if name == "__mn_signal_set" { return " nounwind willreturn" }
    // -- Iterator --
    if name == "__iter_has_next" { return " nounwind readonly willreturn" }
    if name == "__iter_next" { return " nounwind" }
    // v5.1.0 Perf.1: inline list access emits bounds-check trap via abort()
    if name == "abort" { return " noreturn nounwind" }
    return ""

fn declare_all_runtime(st: EmitState) -> EmitState:
    let mut s: EmitState = st

    // String runtime
    s = declare_runtime_fn(s, "__mn_str_concat", llvm_string(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_eq", llvm_int(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_cmp", llvm_int(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_len", llvm_int(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_char_at", llvm_string(), llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_str_byte_at", llvm_int(), llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_str_substr", llvm_string(), llvm_string() + ", i64, i64")
    s = declare_runtime_fn(s, "__mn_str_from_int", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_str_from_bool", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_str_from_float", llvm_string(), "double")
    s = declare_runtime_fn(s, "__mn_str_to_int", llvm_int(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_to_float", llvm_float(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_println", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_print", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_starts_with", llvm_bool(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_ends_with", llvm_bool(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_find", llvm_int(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_join", llvm_string(), llvm_string() + ", ptr")

    // v5.4.1 Own.1 Phase 2 — drop-glue free entry points. Required by
    // emit_drop_glue_strings / _lists / _boxed once owner lists are
    // populated by emit_track_string / _boxed / _closure (see Phase
    // 3.x). __mn_str_free / __mn_list_free are heap-aware (skip
    // is_heap=0); free is the libc allocator the closure-env path
    // routes through.
    s = declare_runtime_fn(s, "__mn_str_free", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_list_free", "void", "ptr")
    s = declare_runtime_fn(s, "free", "void", "ptr")

    // List runtime
    s = declare_runtime_fn(s, "__mn_list_new", llvm_list_rt(), "i64")
    s = declare_runtime_fn(s, "__mn_list_push", "void", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_list_get", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_list_len", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_list_set", "void", "ptr, i64, ptr")
    s = declare_runtime_fn(s, "__mn_list_concat", llvm_list_rt(), "ptr, ptr")

    // Iterator runtime
    s = declare_runtime_fn(s, "__iter_has_next", llvm_bool(), "{i64, i64}")
    s = declare_runtime_fn(s, "__iter_next", llvm_int(), "{i64, i64}")
    s = declare_runtime_fn(s, "__mn_range", "{i64, i64}", "i64, i64")
    s = declare_runtime_fn(s, "__mn_range_free", "void", "ptr")

    // String methods
    s = declare_runtime_fn(s, "__mn_str_to_upper", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_to_lower", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_replace", llvm_string(), llvm_string() + ", " + llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_split", llvm_list_rt(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_trim", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_contains", llvm_bool(), llvm_string() + ", " + llvm_string())

    // v5.1.0 Perf.1: abort for inline list bounds-check trap
    s = declare_runtime_fn(s, "abort", "void", "")

    // Panic / process
    s = declare_runtime_fn(s, "__mn_panic", "void", llvm_string())
    // v5.13.1 At.2: assertion-failure runtime, called from the lowered
    // fail block of every `assert` statement (see lower_assert in
    // lower.mn). Pre-v5.13.1 the call was emitted but never declared,
    // so `mnc test` died at clang IR-parse with "use of undefined
    // value '@__mn_assert_fail'". Defined in runtime/native/mapanare_core.c.
    s = declare_runtime_fn(s, "__mn_assert_fail", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_exit", "void", "i64")
    s = declare_runtime_fn(s, "__mn_argc", "i64", "")
    s = declare_runtime_fn(s, "__mn_argv", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_file_read_or_empty", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_file_write", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_system", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_eprint", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_eprintln", "void", llvm_string())
    // v5.8.4 Wb.2: host-detect for ABI classifier OS-1 mechanism.
    // Kept declared so v5.8.5-vintage stage1 binaries and any
    // Mapanare-level code that calls __mn_host_is_win64 directly
    // continues to link.
    s = declare_runtime_fn(s, "__mn_host_is_win64", "i64", "")
    // v5.8.6 We.1: refined host detection — the (is_windows,
    // arch_bits) pair lets the emitter dispatch a 3-way ABI
    // (Win64 sret/sarg vs i686 cdecl sret/byval vs SysV by-value).
    s = declare_runtime_fn(s, "__mn_host_is_windows", "i64", "")
    s = declare_runtime_fn(s, "__mn_host_arch_bits", "i64", "")
    // v5.9.0 DX.2: build-time-baked version string. Replaces the
    // __MN_VERSION__ source-tree placeholder dance — the compiler now
    // calls this at runtime to embed its own version into both the
    // mnc-stage1 ``version()`` surface and the IR metadata node it
    // emits into compiled programs (see emit_metadata_node below).
    s = declare_runtime_fn(s, "__mn_version_string", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_indent_to_braces", llvm_string(), llvm_string())
    // v5.23.2 Te.3.B.2: brace-deprecation detector + warning emitter.
    // Counts user-written `{` block openers (excluding struct/map literals)
    // and emits a single stderr warning with `mnc fmt` migration hint.
    // Mirrors mapanare/parser.py::count_user_brace_block_openers and
    // ::_emit_brace_deprecation_warning byte-for-byte. Lives in C runtime
    // so the Python and native sides have a single source of truth (see
    // runtime/native/mapanare_core.c for the same C-routing rationale
    // as __mn_indent_to_braces).
    s = declare_runtime_fn(s, "__mn_count_user_brace_block_openers", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_emit_brace_deprecation_warning", "void", llvm_string() + ", i64")
    // v5.9.0 DX.4: native cache stats + dev-null redirect shim. Replaces
    // POSIX-only shell-outs (``find | wc -l``, ``du -sh``, ``rm -rf``,
    // ``2>/dev/null``) that fell through cmd.exe on Windows.
    s = declare_runtime_fn(s, "__mn_dev_null_redirect", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_dir_count_files", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_total_size", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_remove_recursive", "i64", llvm_string())
    // v5.9.0 DX.3: platform-portable temp path for clang stderr capture.
    s = declare_runtime_fn(s, "__mn_clang_err_path", llvm_string(), "")
    // v5.10.0 Win.1b.D: directory of the running binary. find_clang()
    // in main.mn calls this to locate a bundled LLVM toolchain at
    // <exe_dir>/llvm/clang(.exe) before falling back to PATH clang.
    s = declare_runtime_fn(s, "__mn_executable_dir", llvm_string(), "")

    // chr/ord
    s = declare_runtime_fn(s, "__mn_str_chr", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_str_ord", "i64", llvm_string())

    // Map runtime
    // v4.32.0 Phase 1.2: __mn_map_new takes (key_size, val_size, key_type, val_type)
    // — four i64 arguments. The runtime signature is at
    // runtime/native/mapanare_core.c:1561. Python bootstrap has always
    // passed four args; the self-hosted emitter was declaring three
    // (panel carry-forward, 7th cycle closed here).
    s = declare_runtime_fn(s, "__mn_map_new", "ptr", "i64, i64, i64, i64")
    s = declare_runtime_fn(s, "__mn_map_set", "void", "ptr, ptr, ptr")
    s = declare_runtime_fn(s, "__mn_map_get", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_map_len", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_map_contains", "i64", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_map_keys", llvm_list_rt(), "ptr")

    // Malloc (for enum payload allocation)
    s = declare_runtime_fn(s, "malloc", "ptr", "i64")

    // Printf
    s = declare_runtime_fn(s, "printf", "i32", "ptr, ...")

    // Tensor runtime
    s = declare_runtime_fn(s, "__mapanare_tensor_add", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_sub", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_mul", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_div", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_matmul", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_alloc", "ptr", "i64, i64*, i64")
    s = declare_runtime_fn(s, "__mapanare_tensor_free", "void", "ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_shape_eq", "i1", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_detect_gpus", "ptr", "")

    // v5.6.0 Sh.6: __mn_tensor_* — the full tensor-literal + builtin
    // runtime surface implemented in runtime/native/mapanare_gpu_builtins.c.
    // Mirrors the RUNTIME_ATTRS entries in mapanare/emit_llvm_text.py:
    // 337-398. Declared unconditionally; linker drops unused.
    s = declare_runtime_fn(s, "__mn_tensor_alloc", "ptr", "i64, ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_free", "void", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_store_f64", "void", "ptr, i64, double")
    s = declare_runtime_fn(s, "__mn_tensor_store_i64", "void", "ptr, i64, i64")
    s = declare_runtime_fn(s, "__mn_tensor_get_f64", "double", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_get_i64", "i64", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_rank", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_size", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_shape_dim", "i64", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_print_f64", "void", "ptr")

    // v5.6.1 Sh.6 Phase 2: variadic nd get/set for multi-dim indexing.
    // `...` at the tail of the params string emits as LLVM varargs; call
    // sites use the explicit function-type prefix form below.
    s = declare_runtime_fn(s, "__mn_tensor_get_f64_nd", "double", "ptr, i64, ...")
    s = declare_runtime_fn(s, "__mn_tensor_get_i64_nd", "i64", "ptr, i64, ...")
    s = declare_runtime_fn(s, "__mn_tensor_set_f64_nd", "void", "ptr, i64, ...")
    s = declare_runtime_fn(s, "__mn_tensor_set_i64_nd", "void", "ptr, i64, ...")

    // v5.6.2 Sh.6 Phase 3: broadcast / scalar / reverse-scalar binops.
    // Reverse-scalar fns take (scalar, tensor) — see emit_llvm_text.py:3781.
    s = declare_runtime_fn(s, "__mn_tensor_add_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_sub_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_mul_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_div_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_add_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_sub_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_mul_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_div_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_add_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_sub_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_mul_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_div_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_add_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_sub_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_mul_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_div_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_rsub_scalar_f64", "ptr", "double, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_rdiv_scalar_f64", "ptr", "double, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_rsub_scalar_i64", "ptr", "i64, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_rdiv_scalar_i64", "ptr", "i64, ptr")

    // v5.6.3 Sh.6 Phase 4 — 6 reductions × 2 element types (- no mean_i64,
    // + 5 argmax/argmin always-i64 variants) = 11 runtime fns. All take a
    // single tensor ptr and return a scalar.
    s = declare_runtime_fn(s, "__mn_tensor_sum_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_mean_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_max_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_min_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmax_f64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmin_f64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_sum_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_max_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_min_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmax_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmin_i64", "i64", "ptr")

    // v5.6.3 Sh.6 Phase 4 — tensor slice: runtime signature is
    // (ptr tensor, ptr starts, ptr ends, i64 rank). Self-hosted lowerer
    // passes flat args [tensor, s0..., e0..., rank]; emit_mir_call
    // repackages into stack allocated arrays before the call.
    s = declare_runtime_fn(s, "__mn_tensor_slice", "ptr", "ptr, ptr, ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_reshape", "ptr", "ptr, ptr")
    // v5.45.0 Ts.2.B + Ts.3.B — view (aliasing) + step_slice (copy).
    s = declare_runtime_fn(s, "__mn_tensor_view", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_step_slice", "ptr", "ptr, ptr, ptr, ptr, i64")

    // Agent runtime
    s = declare_runtime_fn(s, "__mn_agent_spawn", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_agent_send", "void", "ptr, ptr, ptr")
    s = declare_runtime_fn(s, "__mn_agent_sync", "ptr", "ptr, ptr")

    // Signal runtime
    s = declare_runtime_fn(s, "__mn_signal_new", "ptr", "ptr")
    s = declare_runtime_fn(s, "__mn_signal_get", "ptr", "ptr")
    s = declare_runtime_fn(s, "__mn_signal_set", "void", "ptr, ptr")

    // I/O builtins (v3.41.0)
    s = declare_runtime_fn(s, "__mn_read_line", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_file_append", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_file_exists", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_list_strings", llvm_list_rt(), llvm_string())
    // Network/crypto/regex builtins (v3.42.0)
    s = declare_runtime_fn(s, "__mn_http_get", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_sha256_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_base64_encode_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_base64_decode_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_hmac_sha256_str", llvm_string(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_hex_encode_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_random_bytes_str", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_regex_compile_str", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_regex_exec_str", "i64", "i64, " + llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_regex_replace_str", llvm_string(), "i64, " + llvm_string() + ", " + llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_regex_free", "i64", "i64")
    // Missing I/O builtins (v3.47.0)
    s = declare_runtime_fn(s, "__mn_file_remove", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_file_size", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_file_mtime", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_create", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_remove", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_file_rename", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_file_copy", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_realpath", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_tmpfile_path", llvm_string(), "")
    // GPU builtins (v3.46.0)
    s = declare_runtime_fn(s, "__mn_gpu_available", "i64", "")
    s = declare_runtime_fn(s, "__mn_gpu_device_name", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_gpu_device_memory", "i64", "")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_add", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_sub", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_mul", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_div", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_matmul", llvm_list_rt(), "ptr, ptr, i64, i64, i64")

    // v5.5.2 Sh.4 Phase 3 — async runtime + LLVM coro intrinsics.
    // Mirrors Python bootstrap's emit_llvm_text.py:898–908 conditional
    // declaration block. We declare unconditionally here: the linker
    // drops unused declarations and IR-level cost is ~10 lines. This
    // avoids needing a _module_has_async scan pass at emission start.
    //
    // Scheduler entry points — runtime/native/mapanare_runtime.c v4.92.0+:
    s = declare_runtime_fn(s, "__mn_coro_scheduler_init", "void", "i32")
    s = declare_runtime_fn(s, "__mn_coro_scheduler_destroy", "void", "")
    s = declare_runtime_fn(s, "__mn_coro_scheduler_register", "void", "ptr")
    s = declare_runtime_fn(s, "__mn_coro_scheduler_run", "void", "")
    s = declare_runtime_fn(s, "__mn_coro_register_wait", "void", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_coro_spawn", "void", "ptr")
    // LLVM coroutine intrinsics — required once any async fn is emitted
    // with `presplitcoroutine`. v5.5.2 Option A: async fns stay plain
    // (no presplit wrapping), so these are never called — but we
    // declare them for llvm-as validity of programs that reference them
    // via AwaitSuspend / BlockOn.
    s = declare_runtime_fn(s, "llvm.coro.id", "token", "i32, ptr, ptr, ptr")
    s = declare_runtime_fn(s, "llvm.coro.alloc", "i1", "token")
    s = declare_runtime_fn(s, "llvm.coro.size.i64", "i64", "")
    s = declare_runtime_fn(s, "llvm.coro.begin", "ptr", "token, ptr")
    s = declare_runtime_fn(s, "llvm.coro.suspend", "i8", "token, i1")
    s = declare_runtime_fn(s, "llvm.coro.end", "i1", "ptr, i1, token")
    s = declare_runtime_fn(s, "llvm.coro.free", "ptr", "token, ptr")
    s = declare_runtime_fn(s, "llvm.coro.resume", "void", "ptr")
    s = declare_runtime_fn(s, "llvm.coro.destroy", "void", "ptr")
    s = declare_runtime_fn(s, "llvm.coro.done", "i1", "ptr")
    s = declare_runtime_fn(s, "llvm.coro.save", "token", "ptr")

    return emit_blank(s)

// ---------------------------------------------------------------------------
// Struct type registration from MIR
// ---------------------------------------------------------------------------

fn register_mir_struct(st: EmitState, info: StructInfo) -> EmitState:
    let mut field_names: List<String> = []
    let mut field_types: List<String> = []
    let mut llvm_fields: String = ""
    let mut fi: Int = 0

    for _ in 0..500:
        if fi >= len(info.fields):
            let ty: String = "{ " + llvm_fields + " }"
            let entry: StructEntry = new_struct_entry(info.name, field_names, field_types, ty)
            st.structs.push(entry)

            // Emit named struct type definition
            let mut s: EmitState = emit_line(st, "%struct." + info.name + " = type " + ty)
            return s
        let fp: FieldPair = info.fields[fi]
        let mut fty: String = resolve_mir_type(fp.val.ty)
        // Detect self-referential fields (e.g. TypeInfo has Option<TypeInfo>).
        // Replace with ptr to avoid infinite recursion in LLVM type layout.
        // Use boundary-aware match: check for exact type name followed by
        // non-alphanumeric (space, comma, }, etc.) to avoid false positives
        // like MatchArm matching MatchArmBody.
        let self_struct: String = "%struct." + info.name + " "
        let self_struct2: String = "%struct." + info.name + "}"
        let self_enum: String = "%enum." + info.name + " "
        let self_enum2: String = "%enum." + info.name + "}"
        if fty.contains(self_struct) || fty.contains(self_struct2) || fty.contains(self_enum) || fty.contains(self_enum2):
            fty = llvm_ptr()
        field_names.push(fp.name)
        field_types.push(fty)
        if fi > 0:
            llvm_fields = llvm_fields + ", " + fty
        else:
            llvm_fields = fty
        fi = fi + 1
    return st

// ---------------------------------------------------------------------------
// Enum type registration from MIR
// ---------------------------------------------------------------------------

fn is_enum_type(st: EmitState, name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.enum_names) { return false }
        if st.enum_names[i] == name { return true }
        i = i + 1
    return false

fn is_struct_type(st: EmitState, name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.structs) { return false }
        if st.structs[i].name == name { return true }
        i = i + 1
    return false

// Compute size of an LLVM type in i64 units (8-byte slots)
fn type_size_in_slots(st: EmitState, ty: MIRType) -> Int:
    let resolved: String = resolve_mir_type(ty)
    if resolved == "i64" { return 1 }
    if resolved == "double" { return 1 }
    if resolved == "i1" { return 1 }
    if resolved == "i8" { return 1 }
    if resolved == "ptr" { return 1 }
    if resolved == "void" { return 0 }
    // String: {ptr, i64} = 2 slots
    if resolved == "{ptr, i64}" { return 2 }
    // List: {ptr, i64, i64, i64, i64} = 5 slots (data, len, cap, elem_size, managed)
    if resolved == "{ptr, i64, i64, i64, i64}" { return 5 }
    // Range: {i64, i64} = 2 slots
    if resolved == "{i64, i64}" { return 2 }
    // Option: {i1, T} ≈ 2 slots minimum
    if ty.kind == TK_OPTION():
        if len(ty.args) > 0:
            return 1 + type_size_in_slots(st, ty.args[0])
        return 2
    // Result: {i1, {T, E}}
    if ty.kind == TK_RESULT() { return 4 }
    // Map: {ptr, i64} = 2 slots
    if ty.kind == TK_MAP() { return 2 }
    // Enum: 1 (tag) + max_payload_slots.
    // If registered, look up; otherwise return 48 (conservative for recursive enums).
    if ty.kind == TK_ENUM():
        let mut ei: Int = 0
        let neinfos: Int = len(st.enum_infos)
        for _ in 0..500:
            if ei < neinfos:
                let e_info: EnumInfo = st.enum_infos[ei]
                if e_info.name == ty.name:
                    return 1 + variant_payload_slots_max(st, e_info)
                ei = ei + 1
        // Not registered yet (recursive reference or forward ref): use 48 slots.
        // This is conservative: Expr needs ~30, Stmt ~25, Definition ~32.
        return 48
    // Struct: field_count * 4 (average 4 slots per field — covers Span=4, String=2, List=4)
    if ty.kind == TK_STRUCT():
        let struct_opt: Option<StructEntry> = find_struct_entry(st, ty.name)
        match struct_opt:
            Some(se) => { return len(se.field_types) * 4 }
            _ => { return 8 }
    // Default: 8 slots (conservative fallback)
    return 8

// Compute actual i64 slot count for a variant's payload.
// Extracted to a helper function because return-inside-for works,
// but cross-scope variable assignment after a for loop does not.
fn variant_payload_slots(st: EmitState, variant: EnumVariantInfo) -> Int:
    let mut total: Int = 0
    let mut pi: Int = 0
    for _ in 0..100:
        if pi >= len(variant.payload_types) { return total }
        total = total + type_size_in_slots(st, variant.payload_types[pi])
        pi = pi + 1
    return total

fn max_int(a: Int, b: Int) -> Int:
    if a > b { return a }
    return b

// Max payload slots across all variants of an enum.
fn variant_payload_slots_max(st: EmitState, info: EnumInfo) -> Int:
    let mut mx: Int = 0
    let mut vi: Int = 0
    for _ in 0..500:
        if vi >= len(info.variants) { return mx }
        let count: Int = variant_payload_slots(st, info.variants[vi])
        // Use max_int instead of `if count > mx { mx = count }` because
        // the Python lowerer generates `store i64 0` for conditional
        // assignments inside for loops (cross-scope assignment bug).
        mx = max_int(mx, count)
        vi = vi + 1
    return mx

// v4.140.0 Cb.5: inline enum eligibility — mirrors Python _type_fits_inline_slot.
fn type_fits_inline_slot(resolved: String) -> Bool:
    // Cb.6 (v4.144.0): reject typed-pointer-legacy forms like "i64*".
    // Mapanare's emitter uses opaque `ptr`; any trailing `*` is a bug
    // in the caller or a stale type string from a legacy path.
    if resolved.ends_with("*"):
        return false
    if resolved == "i64" { return true }
    if resolved == "double" { return true }
    if resolved == "i1" { return true }
    if resolved == "i8" { return true }
    if resolved == "i16" { return true }
    if resolved == "i32" { return true }
    if resolved == "ptr" { return true }
    return false

fn is_enum_self_ref(enum_name: String, ty: MIRType) -> Bool:
    if ty.name == enum_name:
        if ty.kind == TK_ENUM() || ty.kind == TK_STRUCT() { return true }
    if ty.kind == TK_OPTION():
        if len(ty.args) > 0:
            if ty.args[0].name == enum_name { return true }
    if ty.kind == TK_RESULT():
        let mut ai: Int = 0
        for _ in 0..2:
            if ai < len(ty.args):
                if ty.args[ai].name == enum_name { return true }
                ai = ai + 1
    return false

// v4.140.0 Cb.5: compute inline slot count for an enum (0 = boxed).
// Mirrors Python _compute_enum_inline_slots: every variant's payload
// fields must be i64-packable, no self-reference, max 2 fields.
fn compute_enum_inline_slots(st: EmitState, info: EnumInfo) -> Int:
    let max_inline: Int = 2
    let mut max_fields: Int = 0
    let mut vi: Int = 0
    for _ in 0..500:
        if vi >= len(info.variants) { return max_fields }
        let variant: EnumVariantInfo = info.variants[vi]
        let npt: Int = len(variant.payload_types)
        if npt > max_inline { return 0 }
        if npt > max_fields { max_fields = npt }
        let mut fi: Int = 0
        for _ in 0..100:
            if fi < npt:
                if is_enum_self_ref(info.name, variant.payload_types[fi]) { return 0 }
                let ft: String = resolve_mir_type(variant.payload_types[fi])
                if !type_fits_inline_slot(ft) { return 0 }
                fi = fi + 1
        vi = vi + 1
    return max_fields

fn lookup_enum_inline(st: EmitState, enum_name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.enum_names) { return 0 }
        if st.enum_names[i] == enum_name { return st.enum_inline_slots[i] }
        i = i + 1
    return 0

fn enum_inline_type(slots: Int) -> String:
    let n: Int = max_int(slots, 1)
    if n == 1 { return "{i64, i64}" }
    return "{i64, i64, i64}"

fn register_mir_enum(st: EmitState, info: EnumInfo) -> EmitState:
    let mut s: EmitState = st
    s.enum_names.push(info.name)
    s.enum_infos.push(info)
    let slots: Int = compute_enum_inline_slots(s, info)
    s.enum_inline_slots.push(slots)
    if slots > 0:
        s = emit_line(s, "%enum." + info.name + " = type " + enum_inline_type(slots))
    else:
        s = emit_line(s, "%enum." + info.name + " = type {i64, ptr}")
    return s

// ---------------------------------------------------------------------------
// Extern function declaration from MIR
// ---------------------------------------------------------------------------

fn is_already_declared(st: EmitState, name: String) -> Bool:
    // Check if a function was already declared in the runtime block
    let needle: String = "@" + name + "("
    let mut i: Int = 0
    let n: Int = len(st.lines)
    for _ in 0..10000:
        if i >= n { return false }
        let line: String = st.lines[i]
        if line.starts_with("declare ") && line.contains(needle):
            return true
        i = i + 1
    return false

fn declare_mir_extern(st: EmitState, info: ExternFnInfo) -> EmitState:
    // Skip if already declared (avoids duplicate declarations)
    if is_already_declared(st, info.fn_name) { return st }
    let ret_ty: String = resolve_mir_type(info.return_type)
    let mut params_str: String = ""
    let mut i: Int = 0
    let nptypes: Int = len(info.param_types)
    for _ in 0..500:
        if i < nptypes:
            let pty: String = resolve_mir_type(info.param_types[i])
            if i > 0:
                params_str = params_str + ", " + pty
            else:
                params_str = pty
            i = i + 1
    return emit_line(st, "declare " + ret_ty + " @" + info.fn_name + "(" + params_str + ")")

// ---------------------------------------------------------------------------
// MIR instruction emission → LLVM IR
// ---------------------------------------------------------------------------

fn emit_mir_instruction(st: EmitState, inst: Instruction) -> EmitState:
    // String-tagged dispatch: uses instr_kind() from mir.mn (same module as
    // the Instruction enum) so that enum tags are always correct regardless
    // of which compiler produced this binary.  Dispatches via match-on-string
    // (not match-on-enum) for cross-compilation stability.
    let kind: String = instr_kind(inst)
    emit_mir_by_kind(st, inst, kind)

fn emit_mir_by_kind(st: EmitState, inst: Instruction, kind: String) -> EmitState:
    if kind == "const" { return emit_const(st, instr_dest(inst), instr_const_type(inst), instr_const_val(inst)) }
    if kind == "copy" { return emit_copy(st, instr_dest(inst), instr_copy_src(inst)) }
    if kind == "cast" { return emit_cast(st, instr_dest(inst), instr_cast_src(inst), instr_cast_type(inst)) }
    if kind == "binop" { return emit_binop(st, instr_dest(inst), instr_binop_op(inst), instr_binop_lhs(inst), instr_binop_rhs(inst)) }
    if kind == "unaryop" { return emit_unaryop(st, instr_dest(inst), instr_unaryop_op(inst), instr_unaryop_operand(inst)) }
    if kind == "struct_init" { return emit_struct_init(st, instr_dest(inst), instr_struct_type(inst), instr_struct_fields(inst)) }
    if kind == "field_get" { return emit_field_get(st, instr_dest(inst), instr_fieldget_obj(inst), instr_fieldget_name(inst)) }
    if kind == "field_set" { return emit_field_set(st, instr_fieldset_obj(inst), instr_fieldset_name(inst), instr_fieldset_val(inst)) }
    if kind == "list_init" { return emit_list_init_checked(st, inst) }
    if kind == "tensor_init" { return emit_tensor_init(st, inst) }
    if kind == "index_get" { return emit_index_get(st, instr_dest(inst), instr_indexget_obj(inst), instr_indexget_idx(inst)) }
    if kind == "index_set" { return emit_index_set(st, instr_indexset_obj(inst), instr_indexset_idx(inst), instr_indexset_val(inst)) }
    if kind == "alloca" { return emit_alloca(st, instr_dest(inst), instr_alloca_type(inst)) }
    if kind == "load" { return emit_load(st, instr_dest(inst), instr_load_ptr(inst)) }
    if kind == "store" { return emit_store(st, instr_store_ptr(inst), instr_store_val(inst)) }
    if kind == "map_init" { return emit_map_init(st, instr_dest(inst), instr_map_key_type(inst), instr_map_val_type(inst), instr_map_pairs(inst)) }
    if kind == "enum_init" { return emit_enum_init(st, instr_dest(inst), instr_enum_type(inst), instr_enum_variant(inst), instr_enum_payload(inst)) }
    if kind == "enum_tag" { return emit_enum_tag(st, instr_dest(inst), instr_enumtag_val(inst)) }
    if kind == "enum_payload" { return emit_enum_payload(st, instr_dest(inst), instr_enumpayload_val(inst), instr_enumpayload_variant(inst)) }
    if kind == "wrap_some" { return emit_wrap_some(st, instr_dest(inst), instr_wrap_val(inst)) }
    if kind == "wrap_none" { return emit_wrap_none(st, instr_dest(inst), instr_wrapnone_type(inst)) }
    if kind == "wrap_ok" { return emit_wrap_ok(st, instr_dest(inst), instr_wrap_val(inst)) }
    if kind == "wrap_err" { return emit_wrap_err(st, instr_dest(inst), instr_wrap_val(inst)) }
    if kind == "unwrap" { return emit_unwrap(st, instr_dest(inst), instr_wrap_val(inst)) }
    if kind == "call":
        let call_dest: Value = instr_dest(inst)
        let call_fn_name: String = instr_call_fn(inst)
        let mut s_call: EmitState = emit_mir_call(st, call_dest, call_fn_name, instr_call_args(inst))
        // v5.4.1 Phase 3.2 — track String results from runtime + user
        // calls. emit_mir_call has many branches but they all leave
        // dest in dn (the call's SSA result); a single post-call hook
        // here covers __mn_str_concat, __mn_str_from_int, substr,
        // user fns returning String, and so on. emit_track_string is
        // safe to call on values backed by .rodata (literal pass-
        // through) — __mn_str_free is_heap-aware.
        //
        // v5.4.2 Phase 3.1 — fallback for builtins whose MIR dest falls
        // through to mir_unknown() in lower_call_by_name (no specific
        // handler + no __ret__fn_name in lambda_vars). is_string_returning_
        // builtin matches the subset of semantic.mn::builtin_return_type
        // where return == "String" but lower.mn doesn't type-tag the dest.
        // Without this fallback, read_file / sha256 / regex_replace /
        // http_get / base64_* / hmac_sha256 / hex_encode / random_bytes
        // / gpu_device_name / read_line / join / typeof all leak.
        if call_dest.ty.kind == TK_STRING() || is_string_returning_builtin(call_fn_name):
            s_call = emit_track_string(s_call, call_dest.name)
        return s_call
    if kind == "return" { return emit_mir_return(st, instr_return_val(inst)) }
    if kind == "jump" { return emit_line(st, emit_br(instr_jump_target(inst))) }
    if kind == "branch" { return emit_mir_branch(st, inst) }
    if kind == "switch" { return emit_mir_switch(st, instr_switch_tag(inst), instr_switch_cases(inst), instr_switch_default(inst)) }
    if kind == "agent_spawn" { return emit_agent_spawn(st, instr_dest(inst), instr_agent_type(inst), instr_agent_args(inst)) }
    if kind == "agent_send" { return emit_agent_send(st, instr_agentsend_agent(inst), instr_agentsend_channel(inst), instr_agentsend_val(inst)) }
    if kind == "agent_sync" { return emit_agent_sync(st, instr_dest(inst), instr_agentsync_agent(inst), instr_agentsync_channel(inst)) }
    if kind == "signal_init" { return emit_signal_init(st, instr_dest(inst), instr_signal_type(inst), instr_signal_val(inst)) }
    if kind == "signal_get" { return emit_signal_get(st, instr_dest(inst), instr_signalget_sig(inst)) }
    if kind == "signal_set" { return emit_signal_set(st, instr_signalset_sig(inst), instr_signalset_val(inst)) }
    if kind == "stream_op" { return emit_stream_op(st, instr_dest(inst), instr_streamop_kind(inst), instr_streamop_source(inst), instr_streamop_args(inst)) }
    if kind == "interp_concat" { return emit_interp_concat(st, instr_dest(inst), instr_concat_parts(inst)) }
    if kind == "phi" { return emit_mir_phi(st, instr_dest(inst), instr_phi_entries(inst)) }
    if kind == "move":
        // v5.4.0 Own.1 Phase 2 — record an explicit ownership transfer.
        // Push the stripped local name onto st.moved_locals so
        // emit_drop_glue skips it.  Idempotent: duplicates are ignored.
        // Lowerer Move emission is deferred to v5.4.1 (see RESCOPE.md);
        // this handler is symmetric with the Python _do_move stub
        // installed in Phase 1 and ready to consume lowerer output.
        let mv_val: Value = instr_move_val(inst)
        let stripped: String = ret_val_base(mv_val.name)
        if stripped == "" { return st }
        if list_has_string(st.moved_locals, stripped) { return st }
        let mut s: EmitState = st
        s.moved_locals.push(stripped)
        return s
    // v5.5.4 Sh.4 Phase 2 — real coroutine drive.
    // Async fns now return `ptr %future` from their initial suspend
    // (see emit_mir_function).  BlockOn and AwaitSuspend must drive
    // the suspended coroutine to its final suspend, then extract the
    // boxed return value from the future.payload slot.
    //
    // v5.5.4 is SYNCHRONOUS — the caller inline-resumes the coroutine
    // rather than registering it with the scheduler.  That's fine for
    // the 5 Sh.4 goldens (no real I/O, no cross-thread fanout) and
    // matches how LLVM's CoroElide optimizes trivially-inlinable
    // coroutines.  v5.5.6 adds the scheduler-driven path for
    // concurrency-aware programs.
    //
    // Critical (v4.102.0 foot-gun, emit_llvm_text.py:5459): the
    // future.payload slot initially holds the coroutine handle (set
    // during async fn prologue) but after the coroutine reaches its
    // final suspend, the slot is overwritten with the result-box
    // pointer.  Load the handle ONCE before coro.resume and reuse it
    // for coro.destroy — never reload slot 1 for the handle after
    // resume.
    if kind == "await_suspend":
        // v5.5.5: scheduler-driven AwaitSuspend. Replaces v5.5.4's
        // synchronous llvm.coro.resume drive with the real
        // save/suspend/switch pattern mirroring
        // emit_llvm_text.py:5305-5372 (the _fn_is_async branch).
        //
        // 6-block layout emitted inline (entry is the current BB):
        //   entry   -> fast-path: load future.state, goto ready if already 1
        //   aw.drive.N  -> load handle, coro.resume once, goto check
        //   aw.check.N  -> re-load state, goto ready or suspend
        //   aw.suspend.N -> register_wait + coro.save + coro.suspend + switch
        //   aw.resume.N -> scheduler woke us, fall through to ready
        //   aw.ready.N  -> load payload, extract value, destroy inner, free
        //
        // AwaitSuspend is only emitted inside async fns (semantic guard),
        // so %coro.hdl, coro.ret, coro.cleanup are always defined by
        // v5.5.4's emit_mir_function prologue/epilogue.
        let aw_dest: Value = instr_dest(inst)
        let aw_fut: Value = instr_await_suspend_future(inst)
        let n: Int = st.counter
        let mut s_aw: EmitState = st
        s_aw.counter = n + 1
        let tag: String = toString(n)
        let drive_lbl: String = "aw.drive." + tag
        let check_lbl: String = "aw.check." + tag
        let susp_lbl: String = "aw.suspend." + tag
        let res_lbl: String = "aw.resume." + tag
        let rdy_lbl: String = "aw.ready." + tag
        let sp: String = "%aw.st.ptr." + tag
        let sv: String = "%aw.st." + tag
        let rd: String = "%aw.rdy." + tag
        let hp: String = "%aw.hdl.ptr." + tag
        let hd: String = "%aw.hdl." + tag
        let s2: String = "%aw.st2." + tag
        let rd2: String = "%aw.rdy2." + tag
        let sav: String = "%aw.save." + tag
        let sus: String = "%aw.susp." + tag
        let vp: String = "%aw.val.ptr." + tag
        let vb: String = "%aw.val.box." + tag
        let vr: String = "%aw.val." + tag

        s_aw = emit_line(s_aw, "  ; v5.5.7 await_suspend " + tag + " — scheduler-driven suspend + cleanup")
        // v5.5.7 — hoist the inner-handle load into the entry BB
        // (BEFORE the fast-path branch) so %aw.hdl.N dominates every
        // edge into aw.ready.N (fast-path, drive→check→ready, and
        // scheduler-resume→ready). Required to call coro.destroy +
        // free in aw.ready.N without violating SSA dominance.
        // The inner coroutine has already initialised future.handle
        // by the time we reach AwaitSuspend (initial-suspend path of
        // the inner's coro.entry stored %coro.hdl into slot 1), so
        // the load is well-defined.
        s_aw = emit_line(s_aw, "  " + hp + " = getelementptr inbounds {i8, ptr}, ptr " + aw_fut.name + ", i32 0, i32 1")
        s_aw = emit_line(s_aw, "  " + hd + " = load ptr, ptr " + hp)
        // Fast-path: check if future is already Ready.
        s_aw = emit_line(s_aw, "  " + sp + " = getelementptr inbounds {i8, ptr}, ptr " + aw_fut.name + ", i32 0, i32 0")
        s_aw = emit_line(s_aw, "  " + sv + " = load i8, ptr " + sp)
        s_aw = emit_line(s_aw, "  " + rd + " = icmp eq i8 " + sv + ", 1")
        s_aw = emit_line(s_aw, "  br i1 " + rd + ", label %" + rdy_lbl + ", label %" + drive_lbl)

        // aw.drive.N — resume once, go to check. Handle was already
        // loaded in entry (hoisted v5.5.7); reuse %aw.hdl.N here.
        s_aw = emit_line(s_aw, drive_lbl + ":")
        s_aw = emit_line(s_aw, "  call void @llvm.coro.resume(ptr " + hd + ")")
        s_aw = emit_line(s_aw, "  br label %" + check_lbl)

        // aw.check.N — re-check readiness after driving.
        s_aw = emit_line(s_aw, check_lbl + ":")
        s_aw = emit_line(s_aw, "  " + s2 + " = load i8, ptr " + sp)
        s_aw = emit_line(s_aw, "  " + rd2 + " = icmp eq i8 " + s2 + ", 1")
        s_aw = emit_line(s_aw, "  br i1 " + rd2 + ", label %" + rdy_lbl + ", label %" + susp_lbl)

        // aw.suspend.N — register wait, save, suspend outer, switch.
        s_aw = emit_line(s_aw, susp_lbl + ":")
        s_aw = emit_line(s_aw, "  call void @__mn_coro_register_wait(ptr %coro.hdl, ptr " + aw_fut.name + ")")
        s_aw = emit_line(s_aw, "  " + sav + " = call token @llvm.coro.save(ptr %coro.hdl)")
        s_aw = emit_line(s_aw, "  " + sus + " = call i8 @llvm.coro.suspend(token " + sav + ", i1 false)")
        s_aw = emit_line(s_aw, "  switch i8 " + sus + ", label %coro.ret [")
        s_aw = emit_line(s_aw, "    i8 0, label %" + res_lbl)
        s_aw = emit_line(s_aw, "    i8 1, label %coro.cleanup")
        s_aw = emit_line(s_aw, "  ]")

        // aw.resume.N — scheduler resumed us.
        s_aw = emit_line(s_aw, res_lbl + ":")
        s_aw = emit_line(s_aw, "  br label %" + rdy_lbl)

        // aw.ready.N — future is Ready, extract payload + destroy.
        // v5.5.7: with %aw.hdl.N hoisted to entry (above), it now
        // dominates this block from all three predecessors — the
        // fast-path branch, aw.check.N→ready, and aw.resume.N→ready.
        // Safe to call coro.destroy + free without an SSA
        // dominance violation.
        //
        // Mirrors v5.5.6's BlockOn cleanup. v4.102.0 foot-gun
        // applies: %aw.hdl.N was loaded BEFORE any potential
        // scheduler_run drive (in the entry BB), so the slot-1
        // clobber that scheduler_run performs (overwriting the
        // handle with the result box) is irrelevant — we still
        // hold the original handle in %aw.hdl.N.
        s_aw = emit_line(s_aw, rdy_lbl + ":")
        s_aw = emit_line(s_aw, "  " + vp + " = getelementptr inbounds {i8, ptr}, ptr " + aw_fut.name + ", i32 0, i32 1")
        s_aw = emit_line(s_aw, "  " + vb + " = load ptr, ptr " + vp)
        s_aw = emit_line(s_aw, "  " + vr + " = load i64, ptr " + vb)
        s_aw = emit_line(s_aw, "  " + aw_dest.name + " = add i64 0, " + vr)
        s_aw = emit_line(s_aw, "  call void @llvm.coro.destroy(ptr " + hd + ")")
        s_aw = emit_line(s_aw, "  call void @free(ptr " + vb + ")")
        s_aw = emit_line(s_aw, "  call void @free(ptr " + aw_fut.name + ")")
        return s_aw
    if kind == "block_on":
        // v5.5.6 Sh.4 Phase 3 — scheduler-driven BlockOn. Replaces
        // v5.5.4's inline llvm.coro.resume drive. Mirrors the
        // scheduler-driven path of emit_llvm_text.py:5429-5441 (the
        // `_module_has_async` branch of `_do_block_on`). The
        // synchronous fallback is unreachable here because BlockOn is
        // only lowered inside modules that already contain async fns;
        // `module_has_async` is therefore true for every main that
        // reaches this emitter.
        //
        // The scheduler runs the caller thread as worker 0 and drives
        // any additional pre-spawned workers (v5.1.4 lazy-spawn policy)
        // until `active_tasks == 0`. When it returns, the registered
        // coroutine's final-suspend path has written `future.state=1`
        // and stored the boxed payload into future.payload. v4.102.0's
        // handle-reload foot-gun still applies: slot 1 of the Future
        // is now the RESULT BOX, not the coroutine handle, so we keep
        // `%bo.hdl.<tag>` (loaded BEFORE register) around for
        // llvm.coro.destroy.
        let bo_dest: Value = instr_dest(inst)
        let bo_fut: Value = instr_block_on_future(inst)
        let n: Int = st.counter
        let mut s_bo: EmitState = st
        s_bo.counter = n + 1
        let tag: String = toString(n)
        s_bo = emit_line(s_bo, "  ; v5.5.6 block_on " + tag + " — scheduler-driven")
        let hp: String = "%bo.hdl.ptr." + tag
        let hd: String = "%bo.hdl." + tag
        let vp: String = "%bo.val.ptr." + tag
        let vb: String = "%bo.val.box." + tag
        let vr: String = "%bo.val." + tag
        // Load the handle BEFORE register: scheduler_run overwrites
        // future.payload with the result box, so re-reading slot 1
        // afterwards would hand coro.destroy an 8-byte malloc'd int
        // and segfault.
        s_bo = emit_line(s_bo, "  " + hp + " = getelementptr inbounds {i8, ptr}, ptr " + bo_fut.name + ", i32 0, i32 1")
        s_bo = emit_line(s_bo, "  " + hd + " = load ptr, ptr " + hp)
        // Register + run — drains active_tasks to 0 and participates
        // as worker 0 alongside any lazily-spawned worker threads.
        s_bo = emit_line(s_bo, "  call void @__mn_coro_scheduler_register(ptr " + hd + ")")
        s_bo = emit_line(s_bo, "  call void @__mn_coro_scheduler_run()")
        // Extract result: payload slot now holds the boxed T.
        s_bo = emit_line(s_bo, "  " + vp + " = getelementptr inbounds {i8, ptr}, ptr " + bo_fut.name + ", i32 0, i32 1")
        s_bo = emit_line(s_bo, "  " + vb + " = load ptr, ptr " + vp)
        s_bo = emit_line(s_bo, "  " + vr + " = load i64, ptr " + vb)
        s_bo = emit_line(s_bo, "  " + bo_dest.name + " = add i64 0, " + vr)
        // Cleanup — reuse `hd` loaded above (slot 1 is clobbered now).
        s_bo = emit_line(s_bo, "  call void @llvm.coro.destroy(ptr " + hd + ")")
        s_bo = emit_line(s_bo, "  call void @free(ptr " + vb + ")")
        s_bo = emit_line(s_bo, "  call void @free(ptr " + bo_fut.name + ")")
        return s_bo
    __mn_str_eprint("ERROR: unknown MIR instruction kind: ")
    __mn_str_eprint(kind)
    __mn_str_eprint("\n")
    return st

fn emit_mir_branch(st: EmitState, inst: Instruction) -> EmitState:
    let cond: Value = instr_branch_cond(inst)
    emit_line(st, emit_cbranch(cond.name, instr_branch_true(inst), instr_branch_false(inst)))

fn emit_list_init_checked(st: EmitState, inst: Instruction) -> EmitState:
    let dest: Value = instr_dest(inst)
    let elem_ty: MIRType = instr_list_type(inst)
    let elements: List<Value> = instr_list_elements(inst)
    // v5.6.7 Ve.2 fix — when dest is definitively `TK_LIST` (set by
    // `make_value(s, mir_list(), "t")` in `lower_list_typed`), skip
    // the struct-reinterpretation heuristics below. They were added
    // to handle cases where the lowerer mis-typed a struct literal as
    // a list init, but they misfire for correctly-typed
    // `List<SomeStruct>` literals (where elem_ty.name matches a
    // registered struct) — the whole ListInit gets dropped and
    // replaced with a broken struct_init, leaving the list dest
    // undefined at every use site.
    if dest.ty.kind == TK_LIST():
        return emit_list_init(st, dest, elem_ty, elements)
    let struct_check: Option<StructEntry> = find_struct_entry(st, dest.ty.name)
    let struct_check2: Option<StructEntry> = find_struct_entry(st, elem_ty.name)
    match struct_check:
        Some(_) => { return emit_struct_init_from_values(st, dest, dest.ty, elements) }
        _ => {}
    match struct_check2:
        Some(_) => { return emit_struct_init_from_values(st, dest, elem_ty, elements) }
        _ => {}
    return emit_list_init(st, dest, elem_ty, elements)

// ---------------------------------------------------------------------------
// Tensor literal emission (v4.42.0)
// ---------------------------------------------------------------------------

fn emit_tensor_init(st: EmitState, inst: Instruction) -> EmitState:
    // v5.6.0 Sh.6: Full tensor literal emission, mirroring
    // emit_llvm_text.py::_do_tensor_init (v4.42.0).
    //   1. Stack-allocate [rank x i64] shape array
    //   2. Store each shape dimension
    //   3. Call __mn_tensor_alloc(rank, shape_ptr, elem_size) -> dest
    //   4. For each element: __mn_tensor_store_{f64,i64}(dest, idx, elem)
    // Element type is inferred from the first lowered element's MIRType
    // (see lower.mn::lower_tensor). Int/Bool -> i64 storage; everything
    // else -> f64 (consistent with the tensor element types the goldens
    // actually exercise).
    let dest: Value = instr_dest(inst)
    let elem_type: MIRType = instr_tensor_type(inst)
    let shape: List<Int> = instr_tensor_shape(inst)
    let elements: List<Value> = instr_tensor_elements(inst)
    let mut s: EmitState = st
    let dn: String = dest.name
    let rank: Int = len(shape)
    let rank_str: String = toString(rank)
    let shape_arr_ty: String = "[" + rank_str + " x i64]"

    // Step 1: alloca shape array. Lives in entry-block prelude so it
    // dominates the alloc call regardless of control flow.
    let shape_a: String = dn + ".shape"
    s.entry_prelude_lines.push("  " + shape_a + " = alloca " + shape_arr_ty + ", align 8")

    // Step 2: store each dim value. Stays at emission point.
    let mut i_dim: Int = 0
    for _ in 0..32:
        if i_dim >= rank { break }
        let gep: String = dn + ".sd" + toString(i_dim)
        s = emit_line(s, "  " + gep + " = getelementptr inbounds " + shape_arr_ty + ", ptr " + shape_a + ", i64 0, i64 " + toString(i_dim))
        s = emit_line(s, "  store i64 " + toString(shape[i_dim]) + ", ptr " + gep)
        i_dim = i_dim + 1

    // Step 3: pick store fn + ty based on element type.
    let mut store_fn: String = "__mn_tensor_store_f64"
    let mut store_ty: String = "double"
    if elem_type.kind == TK_INT():
        store_fn = "__mn_tensor_store_i64"
        store_ty = "i64"
    if elem_type.kind == TK_BOOL():
        store_fn = "__mn_tensor_store_i64"
        store_ty = "i64"

    // Step 4: call __mn_tensor_alloc. Element size is always 8 (double
    // or int64). v5.6.4 Rt.06 — result is tracked for drop-glue;
    // emit_drop_glue emits __mn_tensor_free on non-moved, non-returned
    // slots at every ret edge.
    s = emit_line(s, "  " + dn + " = call noalias ptr @__mn_tensor_alloc(i64 " + rank_str + ", ptr " + shape_a + ", i64 8)")
    s = emit_track_tensor(s, dn)

    // Step 5: store each element. Elements are lowered to their own SSA
    // names; types match elem_type by construction in lower_tensor.
    let mut j: Int = 0
    for _ in 0..100000:
        if j >= len(elements) { break }
        let elem: Value = elements[j]
        // Note: "en" is a Mapanare keyword (Spanish "in"), so use `elem_val`
        // for the SSA name — identifiers that collide with keywords cause
        // `let en: String` bindings to silently infer as <unknown>/Option
        // downstream, triggering "String + Option" binop errors during
        // self-compilation.
        let elem_val: String = elem.name
        // If the element is a constant from parse but its MIR type doesn't
        // match store_ty, coerce. UnaryExpr(-, FloatLit) arrives as Float
        // already from semantic inference, so coercion is rare. Keep the
        // simple happy path first; sitofp/fptosi deferred to v5.6.1 if
        // broadcast/mixed literals hit the edge case.
        s = emit_line(s, "  call void @" + store_fn + "(ptr " + dn + ", i64 " + toString(j) + ", " + store_ty + " " + elem_val + ")")
        j = j + 1
    return s

// ---------------------------------------------------------------------------
// Const instruction
// ---------------------------------------------------------------------------

fn emit_const(st: EmitState, dest: Value, ty: MIRType, val: String) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    let llvm_ty: String = resolve_mir_type(ty)

    // Void constants are no-ops
    if ty.kind == TK_VOID():
        return s

    // String constant: emit global at module level, build struct inline
    if ty.kind == TK_STRING():
        // Escape special chars for LLVM IR string constants
        let escaped: String = val.replace("\\", "\\5C").replace("\"", "\\22").replace("\n", "\\0A").replace("\t", "\\09").replace("\r", "\\0D")
        let slen: Int = len(val)
        let gname: String = next_str_name(s)
        s.str_counter = s.str_counter + 1
        let arr_ty: String = "[" + toString(slen) + " x i8]"
        s = emit_global(s, gname + " = private constant " + arr_ty + " c\"" + escaped + "\", align 2")
        let ptr_name: String = dn + ".ptr"
        s = emit_line(s, "  " + ptr_name + " = getelementptr inbounds " + arr_ty + ", " + "ptr " + gname + ", i64 0, i64 0")
        let s1_name: String = dn + ".s1"
        s = emit_line(s, emit_insertvalue(s1_name, llvm_string(), "undef", ptr_name, "ptr", "0"))
        s = emit_line(s, emit_insertvalue(dn, llvm_string(), s1_name, toString(slen), "i64", "1"))
        // v5.4.1 note: do NOT track String literal Consts. Their data
        // ptr points at .rodata so __mn_str_free is_heap=0 no-ops on
        // them, but tracking each literal explodes stage2.ll
        // quadratically (e.g. get_fn_attrs has ~225 returns × ~225
        // literals → every ret emits drop-glue for every tracked
        // literal, producing ~250k drop-glue lines in one function).
        // Python's _mkstr omits tracking for the same reason. Heap
        // allocations from runtime calls (Phase 3.2) ARE tracked.
        return s

    // Bool constant
    if ty.kind == TK_BOOL():
        let mut bval: String = "0"
        if val == "true" { bval = "1" }
        s = emit_line(s, "  " + dn + " = add i1 0, " + bval)
        return s

    // Int constant: emit `%dest = add i64 0, <val>` to define the SSA value
    if ty.kind == TK_INT():
        s = emit_line(s, "  " + dn + " = add i64 0, " + val)
        return s

    // Float constant: emit `%dest = fadd double 0.0, <val>`
    // Ensure the value has a decimal point for valid LLVM IR.
    // Handle scientific notation: "1e+09" → "1.0e+09" (not "1e+09.0")
    if ty.kind == TK_FLOAT():
        let mut fval: String = val
        if fval.contains("e"):
            // Scientific notation — ensure mantissa has a decimal point
            if !fval.contains("."):
                let mut ei: Int = 0
                for ci in 0..len(fval):
                    if fval.char_at(ci) == "e" { ei = ci }
                fval = fval.substr(0, ei) + ".0" + fval.substr(ei, len(fval) - ei)
        else:
            if !fval.contains(".") { fval = fval + ".0" }
        s = emit_line(s, "  " + dn + " = fadd double 0.0, " + fval)
        return s

    // Struct constant (undef initializer for struct construction)
    if ty.kind == TK_STRUCT():
        s = emit_line(s, "  " + dn + " = insertvalue " + llvm_ty + " undef, " + llvm_ty + " undef, 0")
        return s

    // Function constant: emit function pointer reference
    if ty.kind == TK_FN():
        s = emit_line(s, "  " + dn + " = bitcast void ()* @" + val + " to ptr")
        return s

    // Unknown type — no-op
    return s

// ---------------------------------------------------------------------------
// Copy instruction
// ---------------------------------------------------------------------------

fn emit_copy(st: EmitState, dest: Value, src: Value) -> EmitState:
    let mut s: EmitState = st
    let ty: String = resolve_type(st, dest.ty)
    let src_ty: String = resolve_type(st, src.ty)
    // Use source type when dest is unknown/scalar but source is aggregate.
    // This handles match pattern bindings where the payload type is known
    // from enum info but the pattern variable type is unknown.
    let mut use_ty: String = ty
    if ty == "ptr":
        use_ty = src_ty
    if ty == "i64" && (src_ty.starts_with("%struct.") || src_ty.starts_with("%enum.") || src_ty.starts_with("{")):
        use_ty = src_ty

    // Bool: use bitwise identity (and true)
    if ty == "i1":
        return emit_line(s, "  " + dest.name + " = and i1 " + src.name + ", true")
    // Aggregate types (structs, enums, options, results, lists) cannot use `add`.
    // Use alloca/store/load to copy the value through memory.
    if use_ty.starts_with("%struct.") || use_ty.starts_with("%enum.") || use_ty.starts_with("{"):
        let tmp_a: String = dest.name + ".cpy"
        s = emit_line(s, "  " + tmp_a + " = alloca " + use_ty)
        s = emit_line(s, "  store " + use_ty + " " + src.name + ", " + "ptr " + tmp_a)
        return emit_line(s, "  " + dest.name + " = load " + use_ty + ", " + "ptr " + tmp_a)
    // Scalars (i64, double, ptr, etc.): use add 0 identity
    return emit_line(s, "  " + dest.name + " = add " + use_ty + " 0, " + src.name)

// ---------------------------------------------------------------------------
// Cast instruction
// ---------------------------------------------------------------------------

fn emit_cast(st: EmitState, dest: Value, src: Value, target_ty: MIRType) -> EmitState:
    let mut s: EmitState = st
    let sn: String = src.name
    let dn: String = dest.name

    let src_ty: String = resolve_mir_type(src.ty)
    let dst_ty: String = resolve_mir_type(target_ty)

    // Int → Float
    if src.ty.kind == TK_INT():
        if target_ty.kind == TK_FLOAT():
            s = emit_line(s, "  " + dn + " = sitofp i64 " + sn + " to double")
            return s
    // Float → Int
    if src.ty.kind == TK_FLOAT():
        if target_ty.kind == TK_INT():
            s = emit_line(s, "  " + dn + " = fptosi double " + sn + " to i64")
            return s
    // v5.16.0 Te.4.D — Int/Float/Bool → String for string interpolation.
    // Mirrors mapanare/emit_llvm_text.py::_do_cast. Emits the matching
    // `__mn_str_from_*` runtime call and tracks the fresh allocation
    // for drop-glue. Cast(String→String) collapses to emit_copy (no
    // tracker — alias of source).
    if target_ty.kind == TK_STRING():
        if src.ty.kind == TK_STRING():
            return emit_copy(s, dest, src)
        if src.ty.kind == TK_INT():
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_int", "i64 " + sn)
            s = emit_track_string(s, dn)
            return s
        if src.ty.kind == TK_FLOAT():
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_float", "double " + sn)
            s = emit_track_string(s, dn)
            return s
        if src.ty.kind == TK_BOOL():
            let cnt_zb: String = toString(s.counter)
            s.counter = s.counter + 1
            let zext_b: String = "%zb" + cnt_zb
            s = emit_line(s, "  " + zext_b + " = zext i1 " + sn + " to i64")
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_bool", "i64 " + zext_b)
            s = emit_track_string(s, dn)
            return s
        // Unknown source type — assume i64 (best-effort, matches
        // emit_builtin_tostring's fallback).
        s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_int", "i64 " + sn)
        s = emit_track_string(s, dn)
        return s
    // Fallback: bitcast
    s = emit_line(s, emit_bitcast(dn, src_ty, sn, dst_ty))
    return s

// ---------------------------------------------------------------------------
// BinOp instruction
// ---------------------------------------------------------------------------

fn emit_binop(st: EmitState, dest: Value, op: BinOpKind, lhs: Value, rhs: Value) -> EmitState:
    let mut s: EmitState = st
    let ln: String = lhs.name
    let rn: String = rhs.name

    let dn: String = dest.name
    let is_float: Bool = lhs.ty.kind == TK_FLOAT()
    let is_string: Bool = lhs.ty.kind == TK_STRING()
    let is_bool: Bool = lhs.ty.kind == TK_BOOL()
    let mut cmp_ty: String = llvm_int()
    if is_bool { cmp_ty = "i1" }

    // Use binop_kind_to_str (defined in lower.mn where BinOpKind is local)
    // to convert the enum tag to a string, then dispatch with if/else
    let op_str: String = binop_kind_to_str(op)

    if op_str == "add":
        if is_string:
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_concat", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            // v5.4.1 Phase 4 — binop "+" on Strings lowers to a direct
            // emit_call_ir, bypassing the call-dispatch hook in Phase
            // 3.2. Track the heap-allocated concat result here.
            s = emit_track_string(s, dn)
        else if lhs.ty.kind == TK_LIST():
            // List concatenation: alloca both sides, call __mn_list_concat
            let la_name: String = dn + ".la"
            let ra_name: String = dn + ".ra"
            s = emit_line(s, "  " + la_name + " = alloca " + llvm_list_rt())
            s = emit_line(s, "  store " + llvm_list_rt() + " " + ln + ", ptr " + la_name)
            s = emit_line(s, "  " + ra_name + " = alloca " + llvm_list_rt())
            s = emit_line(s, "  store " + llvm_list_rt() + " " + rn + ", ptr " + ra_name)
            s = emit_rt_call(s, dn, llvm_list_rt(), "__mn_list_concat", "ptr " + la_name + ", ptr " + ra_name)
        else:
            if is_float { s = emit_line(s, emit_fadd(dn, ln, rn)) } else { s = emit_line(s, emit_add(dn, llvm_int(), ln, rn)) }
    else if op_str == "sub":
        if is_float { s = emit_line(s, emit_fsub(dn, ln, rn)) } else { s = emit_line(s, emit_sub(dn, llvm_int(), ln, rn)) }
    else if op_str == "mul":
        if is_float { s = emit_line(s, emit_fmul(dn, ln, rn)) } else { s = emit_line(s, emit_mul(dn, llvm_int(), ln, rn)) }
    else if op_str == "div":
        if is_float { s = emit_line(s, emit_fdiv(dn, ln, rn)) } else { s = emit_line(s, emit_sdiv(dn, llvm_int(), ln, rn)) }
    else if op_str == "mod":
        if is_float { s = emit_line(s, emit_frem(dn, ln, rn)) } else { s = emit_line(s, emit_srem(dn, llvm_int(), ln, rn)) }
    else if op_str == "eq":
        if is_string:
            let eq_raw_eq: String = dn + ".sr"
            s = emit_rt_call(s, eq_raw_eq, llvm_int(), "__mn_str_eq", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "ne", llvm_int(), eq_raw_eq, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "eq", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "eq", cmp_ty, ln, rn)) }
    else if op_str == "ne":
        if is_string:
            let eq_raw_ne: String = dn + ".sr"
            s = emit_rt_call(s, eq_raw_ne, llvm_int(), "__mn_str_eq", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "eq", llvm_int(), eq_raw_ne, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "ne", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "ne", cmp_ty, ln, rn)) }
    else if op_str == "lt":
        if is_string:
            let cmp_r_lt: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_lt, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "slt", llvm_int(), cmp_r_lt, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "lt", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "slt", llvm_int(), ln, rn)) }
    else if op_str == "gt":
        if is_string:
            let cmp_r_gt: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_gt, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "sgt", llvm_int(), cmp_r_gt, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "gt", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "sgt", llvm_int(), ln, rn)) }
    else if op_str == "le":
        if is_string:
            let cmp_r_le: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_le, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "sle", llvm_int(), cmp_r_le, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "le", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "sle", llvm_int(), ln, rn)) }
    else if op_str == "ge":
        if is_string:
            let cmp_r_ge: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_ge, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "sge", llvm_int(), cmp_r_ge, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "ge", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "sge", llvm_int(), ln, rn)) }
    else if op_str == "and":
        s = emit_line(s, emit_and_instr(dn, ln, rn))
    else if op_str == "or":
        s = emit_line(s, emit_or_instr(dn, ln, rn))
    else:
        // Fallback: add
        s = emit_line(s, emit_add(dn, llvm_int(), ln, rn))

    return s

// ---------------------------------------------------------------------------
// UnaryOp instruction
// ---------------------------------------------------------------------------

fn emit_unaryop(st: EmitState, dest: Value, op: UnaryOpKind, operand: Value) -> EmitState:
    let mut s: EmitState = st
    let on: String = operand.name
    let dn: String = dest.name
    let op_str: String = unaryop_kind_to_str(op)

    if op_str == "neg":
        if operand.ty.kind == TK_FLOAT():
            s = emit_line(s, emit_fneg(dn, on))
        else:
            s = emit_line(s, emit_neg(dn, llvm_int(), on))
        return s
    if op_str == "not":
        s = emit_line(s, emit_not(dn, on))
        return s
    return s

// ---------------------------------------------------------------------------
// StructInit instruction
// ---------------------------------------------------------------------------

fn emit_struct_init(st: EmitState, dest: Value, ty: MIRType, fields: List<FieldPair>) -> EmitState:
    let struct_ty: String = resolve_mir_type(ty)
    let mut s: EmitState = st
    let dn: String = dest.name
    let mut agg: String = "undef"
    let mut i: Int = 0

    // Lookup struct field types from the registry (more reliable than MIR types)
    let field_types: List<String> = lookup_struct_field_types(s, ty.name)

    let nfields: Int = len(fields)
    for _ in 0..500:
        if i < nfields:
            let fp: FieldPair = fields[i]
            let mut fty: String = resolve_mir_type(fp.val.ty)
            let val_name: String = fp.val.name
            // If MIR type is unknown, use the registered struct field type
            if fty == "i64" && fp.val.ty.kind == TK_UNKNOWN() && i < len(field_types):
                fty = field_types[i]
            let tmp_name: String = dn + ".f" + toString(i)
            s = emit_line(s, emit_insertvalue(tmp_name, struct_ty, agg, val_name, fty, toString(i)))
            agg = tmp_name
            i = i + 1
    // Copy the final insertvalue result to dest via alloca/store/load
    // (aggregate types cannot use `add 0` identity).
    //
    // v5.6.13 — scratch alloca renamed `.si` → `.addr` so that the
    // destination-passing path in `lower_let` (struct branch) lands
    // its binding alloca on the SAME name the emitter materializes
    // here. When dn is a v5.6.13 destination-passed name (e.g.
    // "%foo3"), `dn + ".addr"` IS the let-binding's alloca; for
    // tmp-prefixed dests (e.g. "%t<N>") this is just a rename of
    // the v5.6.12 scratch with no behavioral change (downstream
    // SROA elides it).
    if nfields > 0:
        let cpy_a: String = dn + ".addr"
        s = emit_line(s, "  " + cpy_a + " = alloca " + struct_ty)
        s = emit_line(s, "  store " + struct_ty + " " + agg + ", " + "ptr " + cpy_a)
        s = emit_line(s, "  " + dn + " = load " + struct_ty + ", " + "ptr " + cpy_a)
    return s

// ---------------------------------------------------------------------------
// FieldGet instruction
// ---------------------------------------------------------------------------

fn emit_field_get(st: EmitState, dest: Value, obj: Value, field_name: String) -> EmitState:
    let mut s: EmitState = st
    let on: String = obj.name
    let dn: String = dest.name
    let obj_ty: String = resolve_type(st, obj.ty)

    // String .len → extractvalue index 1, then mask off the is_heap
    // flag (v4.100.0 packs is_heap into bit 63 of the second eightbyte;
    // the LLVM struct type is still {ptr, i64} so LLVM hands back the
    // raw word). The C runtime sees the bitfield directly and doesn't
    // need the mask; Mapanare-emitted IR has to apply it.
    if obj.ty.kind == TK_STRING():
        if field_name == "len":
            let raw: String = dn + ".raw"
            s = emit_line(s, emit_extractvalue(raw, llvm_string(), on, "1"))
            s = emit_line(s, "  " + dn + " = and i64 " + raw + ", 9223372036854775807")
            return s
        // String methods (contains, starts_with, etc.) — not struct fields.
        // The actual call is handled by the Call instruction that follows.
        // Just pass the object through as the "method reference".
        return emit_copy(s, dest, obj)

    // List .len
    if obj.ty.kind == TK_LIST():
        if field_name == "len":
            let lt: String = llvm_list_rt()
            let tmp: String = dn + ".lp"
            s = emit_line(s, "  " + tmp + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + on + ", " + "ptr " + tmp)
            s = emit_rt_call(s, dn, llvm_int(), "__mn_list_len", "ptr " + tmp)
            return s
        // List methods (push, etc.) — pass object through
        return emit_copy(s, dest, obj)

    // Look up field index from registered structs (internal + module)
    let struct_opt: Option<StructEntry> = find_struct_entry(s, obj.ty.name)
    match struct_opt {
        Some(se) => {
            let idx: Int = find_field_index(se.field_names, field_name)
            s = emit_line(s, emit_extractvalue(dn, obj_ty, on, toString(idx)))
            return s
        },
        _ => {
            // Struct not registered — emit index 0 with error to stderr
            __mn_str_eprint("ERROR: struct not registered: ")
            __mn_str_eprint(obj.ty.name)
            __mn_str_eprint(".")
            __mn_str_eprint(field_name)
            __mn_str_eprint("\n")
            s = emit_line(s, emit_extractvalue(dn, obj_ty, on, "0"))
            return s
        }
    }

fn find_field_index_placeholder_deleted() -> Int { return 0 }

fn find_field_index(fields: List<String>, name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(fields) { return 0 }
        if fields[i] == name { return i }
        i = i + 1
    return 0

// ---------------------------------------------------------------------------
// FieldSet instruction
// ---------------------------------------------------------------------------

fn emit_field_set(st: EmitState, obj: Value, field_name: String, val: Value) -> EmitState:
    let mut s: EmitState = st

    let val_ty: String = resolve_mir_type(val.ty)

    // Look up field index from registered structs
    let struct_opt: Option<StructEntry> = find_struct_entry(s, obj.ty.name)
    let mut idx: Int = 0
    match struct_opt {
        Some(se) => {
            idx = find_field_index(se.field_names, field_name)
        },
        _ => {
            __mn_str_eprint("ERROR: struct not registered for field_set: ")
            __mn_str_eprint(obj.ty.name)
            __mn_str_eprint(".")
            __mn_str_eprint(field_name)
            __mn_str_eprint("\n")
        }
    }
    let struct_ty: String = resolve_type(s, obj.ty)
    if obj.name.contains(".addr"):
        let gep: String = "%" + strip_percent(obj.name) + "_fp" + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + gep + " = getelementptr inbounds " + struct_ty + ", ptr " + obj.name + ", i32 0, i32 " + toString(idx))
        s = emit_line(s, "  store " + val_ty + " " + val.name + ", ptr " + gep)
    else:
        let tmp_name: String = "%" + strip_percent(obj.name) + "_set" + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, emit_insertvalue(tmp_name, struct_ty, obj.name, val.name, val_ty, toString(idx)))
    return s

// ---------------------------------------------------------------------------
// ListInit instruction
// ---------------------------------------------------------------------------

fn strip_percent(name: String) -> String:
    if name.starts_with("%"):
        return name.substr(1, len(name) - 1)
    return name

fn has_struct(st: EmitState, name: String) -> Bool:
    let opt: Option<StructEntry> = find_struct_entry(st, name)
    match opt:
        Some(_) => { return true }
        _ => { return false }

fn try_emit_struct_construct(st: EmitState, dest: Value, fn_name: String, args: List<Value>) -> EmitState:
    // Check if fn_name is "__new_<StructName>" and emit struct construction.
    // Uses ternary expressions to avoid early returns inside if/match.
    let is_new: Bool = len(fn_name) > 6
    let mut prefix: String = ""
    if is_new { prefix = fn_name.substr(0, 6) }
    let mut struct_name: String = ""
    if prefix == "__new_" { struct_name = fn_name.substr(6, len(fn_name) - 6) }
    let mut found: Bool = false
    if struct_name != "" { found = has_struct(st, struct_name) }
    let mut result: EmitState = st
    if found { result = emit_struct_init_from_values(st, dest, dest.ty, args) }
    return result

fn emit_struct_init_from_values(st: EmitState, dest: Value, ty: MIRType, values: List<Value>) -> EmitState:
    // Build struct from a list of values (field order matches struct definition)
    let struct_ty: String = resolve_mir_type(ty)
    let mut s: EmitState = st
    let dn: String = dest.name
    let mut agg: String = "undef"
    let nfields: Int = len(values)

    // Lookup registered field types for this struct
    let field_types: List<String> = lookup_struct_field_types(s, ty.name)

    let mut i: Int = 0
    for _ in 0..500:
        if i < nfields:
            let v: Value = values[i]
            let mut fty: String = resolve_type(st, v.ty)
            let vname: String = v.name
            // Always prefer registered field types for struct construction.
            // MIR value types are often wrong (unknown/empty name) due to
            // COW corruption in nested lists. The emitter's struct registry
            // (from type definitions) is authoritative.
            if i < len(field_types):
                let rft: String = field_types[i]
                if len(rft) > 2 && rft != "i64":
                    fty = rft
            let tmp_name: String = dn + ".f" + toString(i)
            s = emit_line(s, emit_insertvalue(tmp_name, struct_ty, agg, vname, fty, toString(i)))
            agg = tmp_name
            i = i + 1
    // Copy the final insertvalue result to dest.
    //
    // v5.6.13 — scratch alloca renamed `.si` → `.addr` to align with
    // emit_struct_init above. See that function's comment for the
    // destination-passing rationale.
    if nfields > 0:
        let cpy_a: String = dn + ".addr"
        s = emit_line(s, "  " + cpy_a + " = alloca " + struct_ty)
        s = emit_line(s, "  store " + struct_ty + " " + agg + ", " + "ptr " + cpy_a)
        s = emit_line(s, "  " + dn + " = load " + struct_ty + ", " + "ptr " + cpy_a)
    return s

fn find_list_field_index(st: EmitState, struct_name: String, dest: Value) -> String:
    // The struct_name may be "StructName:field_name" (encoded by lowerer)
    let colon_pos: Int = struct_name.find(":")
    if colon_pos > 0:
        let base: String = strip_colon_suffix(struct_name)
        let field: String = extract_after_colon(struct_name, colon_pos)
        let opt: Option<StructEntry> = find_struct_entry(st, base)
        match opt {
            Some(se) => {
                let idx: Int = find_field_index(se.field_names, field)
                return toString(idx)
            },
            _ => { return "0" }
        }
    return "0"

fn find_alloca_by_search(lines: List<String>, value_name: String) -> String:
    // Search FORWARD for "value_name =load TYPE, ptr %alloca"
    // Use the LAST match (most recent load of this value)
    let search_pat: String = value_name + " = load"
    let n: Int = len(lines)
    let mut result: String = ""
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= n { return result }
        let line: String = lines[i]
        if line.contains(search_pat):
            let pp: Int = line.find(", ptr ")
            if pp > 0:
                result = line.substr(pp + 6, len(line) - pp - 6)
        i = i + 1
    return result

fn is_name_in_byref(byref_names: List<String>, name: String) -> Bool:
    // Check if alloca name matches a byref param EXACTLY.
    // Alloca names: "%{param_name}.addr" (params have no counter suffix).
    // Local vars: "%{name}{counter}.addr" — these should NOT match.
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(byref_names) { return false }
        let bn: String = byref_names[i]
        // Exact match: the alloca is %{param_name}.addr
        let expected: String = "%" + bn + ".addr"
        if name == expected { return true }
        i = i + 1
    return false

// v4.112.0 docket #7: real struct size computation.
// llvm_type_size() returns 256 for all %struct.Foo (a safe upper
// bound for malloc), but that over-classifies small user structs as
// byref. is_byref_type_st() resolves %struct.Foo through the
// registered struct table and uses the inline {...} form for size
// computation, matching the Python bootstrap's _tsz behavior.
fn is_byref_type_st(st: EmitState, ty: String) -> Bool:
    // Named struct: resolve to inline {...} form via registered entry.
    if ty.starts_with("%struct."):
        let sz_real: Int = struct_byte_size(st, ty)
        if sz_real > 64 { return true }
        return false
    // Inline struct: compute directly.
    if ty.starts_with("{"):
        let sz_lit: Int = llvm_type_size(ty)
        if sz_lit > 64 { return true }
    return false

// Back-compat wrapper for any call site that lacks EmitState access.
// Uses the legacy 256 heuristic (over-classifies named structs as
// byref) — only called from contexts where st is not threaded.
fn is_byref_type(ty: String) -> Bool:
    if ty.starts_with("%struct."):
        let sz_st: Int = llvm_type_size(ty)
        if sz_st > 64 { return true }
        return false
    if ty.starts_with("{"):
        let sz_lit: Int = llvm_type_size(ty)
        if sz_lit > 64 { return true }
    return false

// Compute real byte size of a named struct type by looking up its
// llvm_type (the inline {...} form) in the struct table.
// Returns 256 as a safe upper bound if the struct is not registered
// (e.g. forward reference before registration, opaque type).
fn struct_byte_size(st: EmitState, ty: String) -> Int = llvm_sizeof_st(st, ty)
    // v5.6.10 — delegate to llvm_sizeof_st for correct recursive sizing.
    //
    // Prior body walked the struct table via llvm_aggregate_size which
    // counts ALL commas in entry.llvm_type — including those inside
    // nested aggregates like `{ptr, i64}` (a String field) — yielding
    // wrong totals (e.g. Value = 24 instead of 80; the registry stub
    // entries pushed by register_internal_struct also shadowed real
    // entries with named "%struct.X" form). v5.6.8 documented the bug
    // and tested this delegation against Ve.3; the patch was reverted
    // because it didn't close Ve.3. v5.6.10 re-applies it post-Ve.3:
    // llvm_sizeof_st uses lookup_struct_field_types which skips
    // empty-fields stub entries (v5.6.5 fix) and recursively resolves
    // each field at its real LLVM size, then 8-byte aligns each field.
    //
    // Cost: stage2.ll grows ~7% from corrected sret/byref classification
    // (more functions hit the > 16-byte threshold and switch to sret).
    // v5.6.10/PLAN.md §D2 conditions the patch on green sanitizers and
    // a preserved fixed-point — verified post-Ve.3 in the v5.6.10
    // session report.

// v5.0.4 Cb.15: compute real byte size of a named enum type.
// Inline enums: (1 + max_inline_slots) * 8 bytes.
// Boxed enums: {i64, ptr} = 16 bytes.
// Returns 16 as default if not found (all boxed enums are 16B).
fn enum_byte_size(st: EmitState, ty: String) -> Int:
    if !ty.starts_with("%enum.") { return llvm_type_size(ty) }
    let name: String = ty.substr(6, len(ty) - 6)
    let mut i: Int = 0
    let n: Int = len(st.enum_names)
    for _ in 0..10000:
        if i >= n { return 16 }
        if st.enum_names[i] == name:
            if i < len(st.enum_inline_slots):
                let slots: Int = st.enum_inline_slots[i]
                if slots > 0:
                    // Inline: tag (i64) + N payload slots (each i64)
                    return (1 + slots) * 8
            return 16
        i = i + 1
    return 16

// v5.0.4 Cb.15: ABI-aware sret classification for return types.
// Replaces is_byref_type_st for return values only. Uses per-target
// ABI classifier (abi.mn) instead of the blanket 64B threshold.
// Argument passing still uses is_byref_type_st (64B threshold).
//
// Mirrors mapanare/emit_llvm_text.py::_use_sret (v4.149.0 E5/ABI.1).
fn use_sret_return(st: EmitState, ty: String) -> Bool:
    // Scalars: never sret
    let is_agg: Bool = ty.starts_with("{") || ty.starts_with("%struct.") || ty.starts_with("%enum.")
    if !is_agg { return false }
    // Compute byte size — resolve named types through tables
    let mut sz: Int = 0
    if ty.starts_with("%struct."):
        sz = struct_byte_size(st, ty)
    else:
        if ty.starts_with("%enum."):
            sz = enum_byte_size(st, ty)
        else:
            sz = llvm_type_size(ty)
    // Classify per target ABI.
    // v5.8.4 Wb.2 + v5.8.6 We.1: host-aware via EmitState's
    // is_windows + win_arch fields (set in emit_mir_module from
    // __mn_host_is_windows() + __mn_host_arch_bits()). Mirrors the
    // Python emitter's self._use_sret which dispatches off
    // self._triple. The 3-way dispatch lets i686-w64-mingw32 use
    // its > 8 B sret threshold instead of inheriting Win64 rules.
    if use_win64_abi(st):
        return abi_classify_return_sret(true, sz, "x86_64-w64-windows-gnu")
    if use_i686_abi(st):
        return abi_classify_return_sret(true, sz, "i686-w64-windows-gnu")
    return abi_classify_return_sret(true, sz, "x86_64-unknown-linux-gnu")

fn find_alloca_for_value(st: EmitState, value_name: String) -> String:
    // Scan backward through emitted lines to find:
    //   %value_name =load TYPE, ptr %ALLOCA
    // Return %ALLOCA name so FieldSet can store back.
    let search: String = value_name + " ="
    let n: Int = len(st.lines)
    let mut i: Int = n - 1
    for _ in 0..10000:
        if i < 0 { return "" }
        let line: String = st.lines[i]
        if line.contains(search):
            if line.contains("load"):
                let ptr_pos: Int = line.find(", ptr ")
                if ptr_pos > 0:
                    let after: String = line.substr(ptr_pos + 6, len(line) - ptr_pos - 6)
                    return after
            return ""
        i = i - 1
    return ""

fn llvm_type_size(ty: String) -> Int:
    if ty == "i1" { return 1 }
    if ty == "i8" { return 1 }
    if ty == "i32" { return 4 }
    if ty == "i64" { return 8 }
    if ty == "double" { return 8 }
    if ty == "ptr" { return 8 }
    if ty == "void" { return 0 }
    // String = {ptr, i64} = 16
    if ty == llvm_string() { return 16 }
    // List = {ptr, i64, i64, i64, i64} = 40 (data, len, cap, elem_size, managed)
    if ty == llvm_list_rt() { return 40 }
    // v5.0.6 Rt.4: enum layouts depend on inline slot count:
    //   boxed        {i64, ptr}        = 16 bytes
    //   1-slot inline {i64, i64}       = 16 bytes
    //   2-slot inline {i64, i64, i64}  = 24 bytes  (Rt.1 v4.124.0)
    // llvm_type_size cannot see EmitState, so return the safe upper
    // bound (24) for any %enum.*. Callers use this for alloca/malloc
    // sizing; over-allocating by up to 8B is safe, under-allocating is
    // a latent heap overflow. The prior "always 16" hardcode + comment
    // became actively false once Rt.1 landed.
    if ty.starts_with("%enum.") { return 24 }
    // Structs: use field_count * 32 as safe upper bound.
    // This is used for malloc allocation, so must be >= actual size.
    if ty.starts_with("%struct.") { return 256 }
    // Aggregate types: count fields
    if ty.starts_with("{") { return llvm_aggregate_size(ty) }
    return 8

fn llvm_aggregate_size(ty: String) -> Int:
    // Count comma-separated fields, each assumed 8 bytes
    let inner: String = ty.substr(1, len(ty) - 2)
    let parts: List<String> = inner.split(",")
    len(parts) * 8

// v5.6.5 Ve.1 fix — state-aware ABI byte size.
// llvm_type_size returns a hardcoded 256 for any %struct.* (safe upper
// bound in theory, but false for FnDefData = 264 bytes → malloc(256) +
// store %struct.FnDefData writes 8 B past the block). This helper
// resolves %struct.X through the registered struct table and sums
// field sizes recursively, padding each field to 8-byte alignment
// (safe for all Mapanare struct layouts — every aggregate contains at
// least one ptr/i64 field and so has align 8).
fn llvm_sizeof_st(st: EmitState, ty: String) -> Int:
    if ty.starts_with("%struct."):
        let sname: String = ty.substr(8, len(ty) - 8)
        let ftypes: List<String> = lookup_struct_field_types(st, sname)
        let nf: Int = len(ftypes)
        if nf == 0:
            // Unknown struct (forward reference or only an internal
            // empty-field_types entry registered) — fall back to the
            // legacy upper bound so we never alloc too little.
            // Self-referential fields are rewritten to `ptr` in
            // register_mir_struct, so recursion always terminates.
            return 256
        let mut total: Int = 0
        let mut i: Int = 0
        for _ in 0..500:
            if i >= nf { return total }
            let mut fsz: Int = llvm_sizeof_st(st, ftypes[i])
            let rem: Int = fsz % 8
            if rem != 0 { fsz = fsz + (8 - rem) }
            total = total + fsz
            i = i + 1
        return total
    return llvm_type_size(ty)

fn emit_list_push_call(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    let mut s: EmitState = st
    if len(args) >= 2:
        let list_ref: String = args[0].name
        let list_ty_kind: Int = args[0].ty.kind
        let elem_name: String = args[1].name
        let mut elem_ty: String = resolve_type(st, args[1].ty)
        if elem_ty == "i64" { elem_ty = resolve_mir_type(args[1].ty) }
        // If type is still i64 but the list knows its element type from
        // type args, use that. Handles cross-module field access where the
        // element's own MIR type wasn't fully resolved.
        if elem_ty == "i64":
            if len(args[0].ty.args) > 0:
                let list_elem_ty: String = resolve_mir_type(args[0].ty.args[0])
                if list_elem_ty != "i64":
                    elem_ty = list_elem_ty
        // If type is still i64 but the MIR type has a struct/enum name,
        // use the named type. This handles struct-in-list push where the
        // lowerer's type info doesn't propagate through method dispatch.
        if elem_ty == "i64":
            if len(args[1].ty.name) > 0:
                if is_struct_type(st, args[1].ty.name):
                    elem_ty = "%struct." + args[1].ty.name
                if is_enum_type(st, args[1].ty.name):
                    elem_ty = "%enum." + args[1].ty.name
        let cnt: String = toString(s.counter)
        s.counter = s.counter + 1

        // Alloca element
        let ea: String = "%push_ea" + cnt
        s = emit_line(s, "  " + ea + " = alloca " + elem_ty)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + ea)

        if list_ref.contains(".addr") && list_ty_kind == TK_STRUCT():
            // Struct field push: GEP to field, load list to temp, push to temp,
            // WRITE BACK to struct field (matches Python text emitter pattern).
            let type_name: String = args[0].ty.name
            let cp: Int = type_name.find(":")
            let mut base_name: String = type_name
            if cp > 0 { base_name = type_name.substr(0, cp) }
            let struct_ty: String = "%struct." + base_name
            let field_idx: String = find_list_field_index(st, type_name, dest)
            let gep: String = "%push_gep" + cnt
            s = emit_line(s, "  " + gep + " = getelementptr inbounds " + struct_ty + ", ptr " + list_ref + ", i32 0, i32 " + field_idx)
            // Load list to temp alloca
            let tmp_sf: String = "%push_tmp" + cnt
            s = emit_line(s, "  " + tmp_sf + " = alloca " + llvm_list_rt())
            let ld_sf: String = "%push_ld" + cnt
            s = emit_line(s, "  " + ld_sf + " = load " + llvm_list_rt() + ", ptr " + gep)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + ld_sf + ", ptr " + tmp_sf)
            // Push to temp
            s = emit_rt_call_void(s, "__mn_list_push", "ptr " + tmp_sf + ", ptr " + ea)
            // Write back to struct field
            let wb_sf: String = "%push_wb" + cnt
            s = emit_line(s, "  " + wb_sf + " = load " + llvm_list_rt() + ", ptr " + tmp_sf)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + wb_sf + ", ptr " + gep)
        else if list_ref.contains(".addr"):
            // Simple alloca push: same temp+writeback pattern
            let tmp_sa: String = "%push_tmp" + cnt
            s = emit_line(s, "  " + tmp_sa + " = alloca " + llvm_list_rt())
            let ld_sa: String = "%push_ld" + cnt
            s = emit_line(s, "  " + ld_sa + " = load " + llvm_list_rt() + ", ptr " + list_ref)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + ld_sa + ", ptr " + tmp_sa)
            s = emit_rt_call_void(s, "__mn_list_push", "ptr " + tmp_sa + ", ptr " + ea)
            let wb_sa: String = "%push_wb" + cnt
            s = emit_line(s, "  " + wb_sa + " = load " + llvm_list_rt() + ", ptr " + tmp_sa)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + wb_sa + ", ptr " + list_ref)
        else:
            // Loaded list value — create temp alloca
            let la: String = "%push_la" + cnt
            s = emit_line(s, "  " + la + " = alloca " + llvm_list_rt())
            s = emit_line(s, "  store " + llvm_list_rt() + " " + list_ref + ", ptr " + la)
            s = emit_rt_call_void(s, "__mn_list_push", "ptr " + la + ", ptr " + ea)
    s

fn emit_list_init(st: EmitState, dest: Value, elem_ty: MIRType, elements: List<Value>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name

    // v5.6.5 Ve.1 fix — use GEP-trick for known aggregate element
    // types so LLVM's DataLayout computes the exact size at link time.
    //
    // v5.6.12 Lk.1 fix — scalar gate. With Lk.1 closed via destination
    // passing in lower_let (lower.mn::lower_let_list_hint path), the
    // 384-byte floor is no longer needed to mask the alloca-aliasing
    // leak. Use the actual LLVM type size for known scalar elem_ty
    // (Int=8, Float=8, Bool=8, ptr=8). The floor is retained ONLY for
    // genuinely-unknown elem_ty.kind, where we can't see the type at
    // emit time and a defensive over-allocation is cheaper than a
    // miscompile.
    //
    // Why this is safe now (not at v5.6.10): Lk.1's leak was never
    // about element sizing — it was about ListInit and the let-binding
    // pointing at different allocas. v5.6.12's destination passing
    // unifies them. Mutating pushes write to the same alloca that
    // drop-glue frees. The scalar gate just stops over-allocating
    // ~376 bytes of dead stack space per List<scalar>.
    let list_name: String = dn + ".new"
    let elem_llvm_ty: String = resolve_mir_type(elem_ty)
    let mut use_gep_trick: Bool = false
    if elem_llvm_ty.starts_with("%struct.") { use_gep_trick = true }
    if elem_llvm_ty.starts_with("%enum.") { use_gep_trick = true }
    if elem_llvm_ty.starts_with("{") { use_gep_trick = true }
    if use_gep_trick:
        let elem_sz: String = dn + ".elem.sz"
        s = emit_line(s, "  " + elem_sz + " = ptrtoint ptr getelementptr (" + elem_llvm_ty + ", ptr null, i32 1) to i64")
        s = emit_rt_call(s, list_name, llvm_list_rt(), "__mn_list_new", "i64 " + elem_sz)
    else:
        let mut elem_sz_n: Int = llvm_type_size(elem_llvm_ty)
        if elem_ty.kind == TK_UNKNOWN():
            // Genuinely unknown elem_ty — keep a defensive 384-byte
            // floor. Investigation candidate for v5.6.13: every UNKNOWN
            // here is a potential lowerer-side gap (let lower_let_list_hint
            // failed to propagate the type).
            if elem_sz_n < 384 { elem_sz_n = 384 }
        s = emit_rt_call(s, list_name, llvm_list_rt(), "__mn_list_new", "i64 " + toString(elem_sz_n))

    // v5.4.1 Phase 3.7 — hoist the alloca to the entry-block prelude
    // so it dominates drop-glue loads at every function exit, even
    // when emit_list_init is invoked from a conditional sub-block.
    // Zero-init the storage so __mn_list_free's null-data-ptr check
    // no-ops if the init store was bypassed by control flow.
    let alloca_name: String = dn + ".addr"
    s.entry_prelude_lines.push("  " + alloca_name + " = alloca " + llvm_list_rt() + ", align 8")
    s.entry_prelude_lines.push("  store " + llvm_list_rt() + " zeroinitializer, ptr " + alloca_name)
    // The init store stays at the original emission point.
    s = emit_line(s, llvm_store(llvm_list_rt(), list_name, alloca_name))
    let list_owned_name: String = ret_val_base(alloca_name)
    s.list_owned.push(list_owned_name)
    // v5.4.4 — parallel source: record the bare list-var name (e.g.
    // "t10") so drop glue can match Move(t10) from the lowerer.
    s.list_owned_source.push(ret_val_base(dn))

    // Push each element
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(elements):
            // Load final list
            let final_list: String = dest.name
            s = emit_line(s, llvm_load(final_list, llvm_list_rt(), alloca_name))
            return s
        let elem: Value = elements[i]
        let ety: String = resolve_mir_type(elem.ty)
        let elem_alloca: String = dn + ".e" + toString(i)
        s = emit_line(s, llvm_alloca(elem_alloca, ety))
        s = emit_line(s, llvm_store(ety, elem.name, elem_alloca))
        let cast_name: String = dn + ".c" + toString(i)
        s = emit_line(s, emit_bitcast(cast_name, ety + "*", elem_alloca, "ptr"))
        s = emit_rt_call_void(s, "__mn_list_push", "ptr " + alloca_name + ", ptr " + cast_name)
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// IndexGet instruction
// ---------------------------------------------------------------------------

fn emit_index_get(st: EmitState, dest: Value, obj: Value, idx: Value) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name

    // String indexing → char_at
    if obj.ty.kind == TK_STRING():
        s = emit_rt_call(s, dn, llvm_string(), "__mn_str_char_at", llvm_string() + " " + obj.name + ", i64 " + idx.name)
        return s

    // Map indexing → __mn_map_get(map_ptr, key_ptr)
    if obj.ty.kind == TK_MAP():
        let cnt_mg: String = toString(s.counter)
        s.counter = s.counter + 1
        let idx_ty: String = resolve_type(st, idx.ty)
        // Extract map pointer
        let mptr: String = "%mg_mptr" + cnt_mg
        if obj.name.contains(".addr"):
            let mld: String = "%mg_mld" + cnt_mg
            s = emit_line(s, "  " + mld + " = load " + llvm_map_type() + ", ptr " + obj.name)
            s = emit_line(s, "  " + mptr + " = extractvalue " + llvm_map_type() + " " + mld + ", 0")
        else:
            s = emit_line(s, "  " + mptr + " = extractvalue " + llvm_map_type() + " " + obj.name + ", 0")
        // Alloca key
        let ka: String = "%mg_ka" + cnt_mg
        s = emit_line(s, "  " + ka + " = alloca " + idx_ty)
        s = emit_line(s, "  store " + idx_ty + " " + idx.name + ", ptr " + ka)
        // Call __mn_map_get → ptr to value
        let vptr: String = "%mg_vp" + cnt_mg
        s = emit_line(s, "  " + vptr + " = call ptr @__mn_map_get(ptr " + mptr + ", ptr " + ka + ")")
        // Load value from pointer
        let dest_ty: String = resolve_type(st, dest.ty)
        if dest_ty != "i64" && dest_ty != "ptr":
            s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + vptr)
        else:
            s = emit_line(s, "  " + dn + " = load i64, ptr " + vptr)
        return s

    // List indexing
    let lt: String = llvm_list_rt()
    let tmp: String = dn + ".lp"
    s = emit_line(s, "  " + tmp + " = alloca " + lt)
    s = emit_line(s, "  store " + lt + " " + obj.name + ", " + "ptr " + tmp)

    let dest_ty: String = resolve_type(st, dest.ty)

    // v5.1.0 Perf.1: inline list access for 8-byte value-type elements.
    // Replaces opaque call @__mn_list_get with GEP+load so LLVM can see
    // through to the backing buffer (enables SROA, vectorization, hoisting).
    if dest_ty == "i64" || dest_ty == "double" || dest_ty == "ptr":
        let cnt_lg: String = toString(s.counter)
        s.counter = s.counter + 1
        // Inline bounds check (unsigned covers negative indices)
        let lenp: String = "%lg.lenp." + cnt_lg
        s = emit_line(s, "  " + lenp + " = getelementptr inbounds " + lt + ", ptr " + tmp + ", i32 0, i32 1")
        let ln: String = "%lg.len." + cnt_lg
        s = emit_line(s, "  " + ln + " = load i64, ptr " + lenp)
        let oob: String = "%lg.oob." + cnt_lg
        s = emit_line(s, "  " + oob + " = icmp uge i64 " + idx.name + ", " + ln)
        let trap_lbl: String = "lg.trap." + cnt_lg
        let ok_lbl: String = "lg.ok." + cnt_lg
        s = emit_line(s, "  br i1 " + oob + ", label %" + trap_lbl + ", label %" + ok_lbl)
        // Trap block
        s = emit_line(s, trap_lbl + ":")
        s = emit_line(s, "  call void @abort()")
        s = emit_line(s, "  unreachable")
        // Fast path: inline GEP + load
        s = emit_line(s, ok_lbl + ":")
        let dp: String = "%lg.dp." + cnt_lg
        s = emit_line(s, "  " + dp + " = getelementptr inbounds " + lt + ", ptr " + tmp + ", i32 0, i32 0")
        let data: String = "%lg.data." + cnt_lg
        s = emit_line(s, "  " + data + " = load ptr, ptr " + dp)
        // v5.6.11 Ve.4 — use runtime elem_size for the offset, not a constant
        // i64 stride. The 7 Ve.2 residual sites (`build_match_arms` and 5
        // others) allocate `List<Int> = []` with elem_size=384 (Lk.1 floor);
        // `__mn_list_push` writes at idx * 384 while a constant-stride GEP
        // would read at idx * 8 — mismatch produces garbage reads of
        // intra-buffer spillage. Loading elem_size from list field 3 makes
        // the read consistent with the push regardless of allocator stride.
        // SROA still elides this when elem_size is a known constant 8.
        let eszp: String = "%lg.eszp." + cnt_lg
        s = emit_line(s, "  " + eszp + " = getelementptr inbounds " + lt + ", ptr " + tmp + ", i32 0, i32 3")
        let esz: String = "%lg.esz." + cnt_lg
        s = emit_line(s, "  " + esz + " = load i64, ptr " + eszp)
        let off: String = "%lg.off." + cnt_lg
        s = emit_line(s, "  " + off + " = mul i64 " + idx.name + ", " + esz)
        let ep: String = "%lg.ep." + cnt_lg
        s = emit_line(s, "  " + ep + " = getelementptr inbounds i8, ptr " + data + ", i64 " + off)
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + ep)
    else:
        // Slow path: opaque call for String, Bool, structs, etc.
        let raw: String = dn + ".raw"
        s = emit_rt_call(s, raw, "ptr", "__mn_list_get", "ptr " + tmp + ", i64 " + idx.name)
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + raw)
    return s

// ---------------------------------------------------------------------------
// IndexSet instruction
// ---------------------------------------------------------------------------

fn emit_index_set(st: EmitState, obj: Value, idx: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let list_ref: String = obj.name
    let idx_name: String = idx.name
    let elem_name: String = val.name
    let elem_ty: String = resolve_type(st, val.ty)
    let cnt: String = toString(s.counter)
    s.counter = s.counter + 1

    // Map index set: entries[key] = value → __mn_map_set
    if obj.ty.kind == TK_MAP():
        let idx_ty: String = resolve_type(st, idx.ty)
        // Alloca key
        let ka: String = "%set_ka" + cnt
        s = emit_line(s, "  " + ka + " = alloca " + idx_ty)
        s = emit_line(s, "  store " + idx_ty + " " + idx_name + ", ptr " + ka)
        // Alloca value
        let va: String = "%set_va" + cnt
        s = emit_line(s, "  " + va + " = alloca " + elem_ty)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + va)
        // Load map pointer from alloca or value
        if list_ref.contains(".addr"):
            let map_ld: String = "%set_mld" + cnt
            s = emit_line(s, "  " + map_ld + " = load " + llvm_map_type() + ", ptr " + list_ref)
            let map_ptr: String = "%set_mptr" + cnt
            s = emit_line(s, "  " + map_ptr + " = extractvalue " + llvm_map_type() + " " + map_ld + ", 0")
            s = emit_rt_call_void(s, "__mn_map_set", "ptr " + map_ptr + ", ptr " + ka + ", ptr " + va)
        else:
            let map_ptr: String = "%set_mptr" + cnt
            s = emit_line(s, "  " + map_ptr + " = extractvalue " + llvm_map_type() + " " + list_ref + ", 0")
            s = emit_rt_call_void(s, "__mn_map_set", "ptr " + map_ptr + ", ptr " + ka + ", ptr " + va)
        return s

    // v5.1.0 Perf.1: inline list store for 8-byte value-type elements.
    let lt: String = llvm_list_rt()
    if elem_ty == "i64" || elem_ty == "double" || elem_ty == "ptr":
        // Build temp alloca for list value
        let la: String = "%ls.la" + cnt
        if list_ref.contains(".addr"):
            let ld: String = "%ls.ld" + cnt
            s = emit_line(s, "  " + la + " = alloca " + lt)
            s = emit_line(s, "  " + ld + " = load " + lt + ", ptr " + list_ref)
            s = emit_line(s, "  store " + lt + " " + ld + ", ptr " + la)
        else:
            s = emit_line(s, "  " + la + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + list_ref + ", ptr " + la)
        // Inline bounds check
        let lenp: String = "%ls.lenp." + cnt
        s = emit_line(s, "  " + lenp + " = getelementptr inbounds " + lt + ", ptr " + la + ", i32 0, i32 1")
        let ln: String = "%ls.len." + cnt
        s = emit_line(s, "  " + ln + " = load i64, ptr " + lenp)
        let oob: String = "%ls.oob." + cnt
        s = emit_line(s, "  " + oob + " = icmp uge i64 " + idx_name + ", " + ln)
        let trap_lbl: String = "ls.trap." + cnt
        let ok_lbl: String = "ls.ok." + cnt
        s = emit_line(s, "  br i1 " + oob + ", label %" + trap_lbl + ", label %" + ok_lbl)
        // Trap block
        s = emit_line(s, trap_lbl + ":")
        s = emit_line(s, "  call void @abort()")
        s = emit_line(s, "  unreachable")
        // Fast path: inline GEP + store
        s = emit_line(s, ok_lbl + ":")
        let dp: String = "%ls.dp." + cnt
        s = emit_line(s, "  " + dp + " = getelementptr inbounds " + lt + ", ptr " + la + ", i32 0, i32 0")
        let data: String = "%ls.data." + cnt
        s = emit_line(s, "  " + data + " = load ptr, ptr " + dp)
        // v5.6.11 Ve.4 — symmetric to emit_index_get: use runtime elem_size
        // for offset so the store stride matches `__mn_list_push`'s runtime
        // stride. See emit_index_get site for the full reasoning; without
        // this, `arr[i] = v` on a List<Int> allocated with the 384-byte
        // floor writes at offset i*8 while pushes write at offset i*384.
        let eszp: String = "%ls.eszp." + cnt
        s = emit_line(s, "  " + eszp + " = getelementptr inbounds " + lt + ", ptr " + la + ", i32 0, i32 3")
        let esz: String = "%ls.esz." + cnt
        s = emit_line(s, "  " + esz + " = load i64, ptr " + eszp)
        let off: String = "%ls.off." + cnt
        s = emit_line(s, "  " + off + " = mul i64 " + idx_name + ", " + esz)
        let ep: String = "%ls.ep." + cnt
        s = emit_line(s, "  " + ep + " = getelementptr inbounds i8, ptr " + data + ", i64 " + off)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + ep)
    else:
        // Slow path: opaque call for String, structs, etc.
        let ea: String = "%set_ea" + cnt
        s = emit_line(s, "  " + ea + " = alloca " + elem_ty)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + ea)

        if list_ref.contains(".addr"):
            let tmp_addr: String = "%set_tmp" + cnt
            s = emit_line(s, "  " + tmp_addr + " = alloca " + lt)
            let ld: String = "%set_ld" + cnt
            s = emit_line(s, "  " + ld + " = load " + lt + ", ptr " + list_ref)
            s = emit_line(s, "  store " + lt + " " + ld + ", ptr " + tmp_addr)
            s = emit_rt_call_void(s, "__mn_list_set", "ptr " + tmp_addr + ", i64 " + idx_name + ", ptr " + ea)
            let wb: String = "%set_wb" + cnt
            s = emit_line(s, "  " + wb + " = load " + lt + ", ptr " + tmp_addr)
            s = emit_line(s, "  store " + lt + " " + wb + ", ptr " + list_ref)
        else:
            let tmp_val: String = "%set_tmp" + cnt
            s = emit_line(s, "  " + tmp_val + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + list_ref + ", ptr " + tmp_val)
            s = emit_rt_call_void(s, "__mn_list_set", "ptr " + tmp_val + ", i64 " + idx_name + ", ptr " + ea)
    return s

// ---------------------------------------------------------------------------
// Alloca/Load/Store instructions
// ---------------------------------------------------------------------------

fn emit_alloca(st: EmitState, dest: Value, ty: MIRType) -> EmitState = emit_line(st, llvm_alloca(dest.name, resolve_type(st, ty)))

fn emit_load(st: EmitState, dest: Value, ptr: Value) -> EmitState = emit_line(st, llvm_load(dest.name, resolve_type(st, dest.ty), ptr.name))

fn emit_store(st: EmitState, ptr: Value, val: Value) -> EmitState:
    let val_ty: String = resolve_type(st, val.ty)
    let ptr_ty: String = resolve_type(st, ptr.ty)
    // When storing a generic None ({i1, ptr}) to a specific Option alloca
    // ({i1, %enum.T}), use zeroinitializer with the alloca's type instead.
    // None has tag=0 and null payload — zeroinitializer is equivalent.
    if val.ty.kind == TK_OPTION() && ptr_ty != val_ty && ptr_ty.starts_with("{"):
        return emit_line(st, "  store " + ptr_ty + " zeroinitializer, " + "ptr " + ptr.name)
    return emit_line(st, llvm_store(val_ty, val.name, ptr.name))

// ---------------------------------------------------------------------------
// MapInit instruction
// ---------------------------------------------------------------------------

fn emit_map_init(st: EmitState, dest: Value, key_ty: MIRType, val_ty: MIRType, pairs: List<KVPair>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    let cnt: String = toString(s.counter)
    s.counter = s.counter + 1

    // Determine key type tag: 0=int, 1=str, 2=float
    let mut key_tag: String = "1"
    if key_ty.kind == TK_INT() { key_tag = "0" }
    if key_ty.kind == TK_FLOAT() { key_tag = "2" }

    // v4.32.0 Phase 1.2: val_tag mirrors the Python bootstrap at
    // emit_llvm_text.py:3160 — 1 for String val types (so the runtime
    // knows to apply the heap-tag low-bit strip on reads), 0 otherwise.
    let mut val_tag: String = "0"
    if val_ty.kind == TK_STRING() { val_tag = "1" }

    // Key/val sizes: strings are 16 bytes ({ptr,i64}), ints are 8 bytes
    // Default val_size = 16 to safely handle enums/strings in untyped empty maps
    let mut key_size: String = "16"
    let mut val_size: String = "16"
    if key_ty.kind == TK_INT() { key_size = "8" }
    if key_ty.kind == TK_FLOAT() { key_size = "8" }
    if val_ty.kind == TK_INT() { val_size = "8" }
    if val_ty.kind == TK_FLOAT() { val_size = "8" }
    if val_ty.kind == TK_BOOL() { val_size = "8" }
    if val_ty.kind == TK_STRUCT() { val_size = "64" }
    if val_ty.kind == TK_ENUM() { val_size = "64" }

    // Call __mn_map_new(key_size, val_size, key_type, val_type) — 4 args
    // (v4.32.0 Phase 1.2 closes the arity mismatch flagged as a 7-cycle
    // carry-forward by Rattler at the v4.31.0 arc-end panel).
    let map_ptr: String = dn + ".mp"
    s = emit_line(s, "  " + map_ptr + " = call ptr @__mn_map_new(i64 " + key_size + ", i64 " + val_size + ", i64 " + key_tag + ", i64 " + val_tag + ")")

    // Insert each pair
    let npairs: Int = len(pairs)
    let mut i: Int = 0
    for _ in 0..1000:
        if i >= npairs:
            // Store map pointer into result: {ptr, i64} with ptr=map, i64=0
            s = emit_line(s, "  " + dn + ".s0 =insertvalue {ptr, i64} undef, ptr " + map_ptr + ", 0")
            s = emit_line(s, "  " + dn + " = insertvalue {ptr, i64} " + dn + ".s0, i64 0, 1")
            return s
        let pair: KVPair = pairs[i]
        let pi: String = toString(i)
        let k_ty: String = resolve_mir_type(pair.key.ty)
        let v_ty: String = resolve_mir_type(pair.val.ty)
        // Alloca key, store, bitcast to ptr
        let ka: String = dn + ".k" + pi
        s = emit_line(s, "  " + ka + " = alloca " + k_ty)
        s = emit_line(s, "  store " + k_ty + " " + pair.key.name + ", ptr " + ka)
        // Alloca val, store, bitcast to ptr
        let va: String = dn + ".v" + pi
        s = emit_line(s, "  " + va + " = alloca " + v_ty)
        s = emit_line(s, "  store " + v_ty + " " + pair.val.name + ", ptr " + va)
        // Call __mn_map_set(map, key_ptr, val_ptr)
        s = emit_rt_call_void(s, "__mn_map_set", "ptr " + map_ptr + ", ptr " + ka + ", ptr " + va)
        i = i + 1

    // Fallback: return empty map
    s = emit_line(s, "  " + dn + ".s0 =insertvalue {ptr, i64} undef, ptr " + map_ptr + ", 0")
    s = emit_line(s, "  " + dn + " = insertvalue {ptr, i64} " + dn + ".s0, i64 0, 1")
    return s

// ---------------------------------------------------------------------------
// EnumInit instruction
// ---------------------------------------------------------------------------

fn pack_to_i64(st: EmitState, val: String, ft: String, pk_name: String) -> EmitState:
    let mut s: EmitState = st
    if ft == "i64" { return s }
    if ft == "double":
        s = emit_line(s, "  " + pk_name + " = bitcast double " + val + " to i64")
        return next_ssa(s)
    if ft == "i1" || ft == "i8" || ft == "i16" || ft == "i32":
        s = emit_line(s, "  " + pk_name + " = zext " + ft + " " + val + " to i64")
        return next_ssa(s)
    if ft == "ptr":
        s = emit_line(s, "  " + pk_name + " = ptrtoint ptr " + val + " to i64")
        return next_ssa(s)
    return s

fn unpack_from_i64(st: EmitState, val: String, ft: String, upk_name: String) -> EmitState:
    let mut s: EmitState = st
    if ft == "i64" { return s }
    if ft == "double":
        s = emit_line(s, "  " + upk_name + " = bitcast i64 " + val + " to double")
        return next_ssa(s)
    if ft == "i1" || ft == "i8" || ft == "i16" || ft == "i32":
        s = emit_line(s, "  " + upk_name + " = trunc i64 " + val + " to " + ft)
        return next_ssa(s)
    if ft == "ptr":
        s = emit_line(s, "  " + upk_name + " = inttoptr i64 " + val + " to ptr")
        return next_ssa(s)
    return s

fn emit_enum_init(st: EmitState, dest: Value, ty: MIRType, variant: String, payload: List<Value>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    let tag_val: String = toString(resolve_variant_index(s, ty.name, variant))
    let enum_ty: String = resolve_mir_type(ty)
    let inline_slots: Int = lookup_enum_inline(s, ty.name)

    // v4.140.0 Cb.5: inline enum — pack payload fields into i64 slots.
    // Use named enum type (%enum.X) for insertvalue so SSA type matches the
    // declared function return / alloca types downstream.
    if inline_slots > 0:
        let n_slots: Int = max_int(inline_slots, 1)
        let mut cur: String = dn + ".ei0"
        s = emit_line(s, "  " + cur + " = insertvalue " + enum_ty + " undef, i64 " + tag_val + ", 0")
        s = next_ssa(s)
        let mut slot_i: Int = 0
        for _ in 0..3:
            if slot_i < n_slots:
                // Last slot writes to dn; earlier slots to temporaries.
                let mut nxt: String = dn + ".ei" + toString(slot_i + 1)
                if slot_i == n_slots - 1 { nxt = dn }
                if slot_i < len(payload):
                    let p: Value = payload[slot_i]
                    let ft: String = resolve_mir_type(p.ty)
                    if ft == "i64":
                        s = emit_line(s, "  " + nxt + " = insertvalue " + enum_ty + " " + cur + ", i64 " + p.name + ", " + toString(slot_i + 1))
                    else:
                        let pk: String = dn + ".pk" + toString(slot_i)
                        s = pack_to_i64(s, p.name, ft, pk)
                        s = emit_line(s, "  " + nxt + " = insertvalue " + enum_ty + " " + cur + ", i64 " + pk + ", " + toString(slot_i + 1))
                else:
                    s = emit_line(s, "  " + nxt + " = insertvalue " + enum_ty + " " + cur + ", i64 0, " + toString(slot_i + 1))
                cur = nxt
                slot_i = slot_i + 1
        return s

    // Boxed enum: { i64 tag, ptr payload } — existing path.
    //
    // v5.6.5 Ve.1 fix — defer sizing + offsets to LLVM via the GEP-trick
    // and typed GEPs. Matches Python's `_do_enum_init` at
    // emit_llvm_text.py:4770-4809: build an inline payload struct type,
    // ask LLVM for its ABI size via `ptrtoint ptr gep (<psty>, null, i32 1)`,
    // and address fields with `getelementptr <psty>, ptr, i32 0, i32 <idx>`.
    // LLVM's DataLayout resolves both at link time — no hand-computed
    // sizes, no "safe upper bound" hacks. Prior approach used hardcoded
    // 256-byte fallbacks for any `%struct.*` (caused FnDefData's 8-byte
    // overflow at parse_fn_body) and hand-summed field offsets that
    // diverged from LLVM's actual layout.
    if len(payload) > 0:
        let payload_ty: String = build_payload_type_from_values(s, payload)
        let ep: String = dn + ".ep"
        let sz: String = dn + ".sz"
        s = emit_line(s, "  " + sz + " = ptrtoint ptr getelementptr (" + payload_ty + ", ptr null, i32 1) to i64")
        s = emit_line(s, "  " + ep + " = call ptr @malloc(i64 " + sz + ")")
        let mut i: Int = 0
        let npayload: Int = len(payload)
        for _ in 0..100:
            if i < npayload:
                let p: Value = payload[i]
                let mut pty: String = resolve_mir_type(p.ty)
                // struct→enum rewrite (MIR may have kind:"struct" for enums)
                if pty.starts_with("%struct."):
                    if is_enum_type(s, p.ty.name):
                        pty = "%enum." + p.ty.name
                let ef: String = dn + ".ef" + toString(i)
                s = emit_line(s, "  " + ef + " = getelementptr inbounds " + payload_ty + ", ptr " + ep + ", i32 0, i32 " + toString(i))
                s = emit_line(s, "  store " + pty + " " + p.name + ", ptr " + ef)
                i = i + 1
        // v5.4.2 Phase 3.2 — track the payload box for drop glue. The
        // box is malloc'd here and owned by this frame; caller is the
        // sole owner after return. Aggregate-return escape guard in
        // emit_drop_glue already suppresses drops when the enum escapes
        // as an aggregate return value (see v5.4.1 Phase 4), so this
        // tracking is UAF-safe and closes the 50_match_or_patterns leak:
        //   fn main() { print(category(Token::Ident("x"))) }
        // where the box is consumed locally and never escapes.
        s = emit_track_boxed(s, ep)
        let ei1_pay: String = dn + ".ei1"
        s = emit_line(s, "  " + ei1_pay + " = insertvalue " + enum_ty + " undef, i64 " + tag_val + ", 0")
        s = emit_line(s, "  " + dn + " = insertvalue " + enum_ty + " " + ei1_pay + ", ptr " + ep + ", 1")
    else:
        let ei1_bare: String = dn + ".ei1"
        s = emit_line(s, "  " + ei1_bare + " = insertvalue " + enum_ty + " undef, i64 " + tag_val + ", 0")
        s = emit_line(s, "  " + dn + " = insertvalue " + enum_ty + " " + ei1_bare + ", ptr null, 1")
    return s

// v5.6.5 Ve.1 fix — build an inline LLVM struct type from a payload
// value list. Used by emit_enum_init so LLVM's DataLayout computes
// both the allocation size and per-field offsets correctly — matches
// Python's `psty = "{" + ", ".join(pflds) + "}"` in _do_enum_init.
fn build_payload_type_from_values(st: EmitState, payload: List<Value>) -> String:
    let mut result: String = "{ "
    let mut i: Int = 0
    let n: Int = len(payload)
    for _ in 0..100:
        if i >= n:
            return result + " }"
        let mut pty: String = resolve_mir_type(payload[i].ty)
        if pty.starts_with("%struct."):
            if is_enum_type(st, payload[i].ty.name):
                pty = "%enum." + payload[i].ty.name
        if i > 0:
            result = result + ", " + pty
        else:
            result = result + pty
        i = i + 1
    return result + " }"

// v5.6.5 Ve.1 fix — counterpart to build_payload_type_from_values,
// but resolves payload types from the enum registry (for extraction
// sites where we have a variant name rather than a value list).
// Returns "{ }" if the variant is unknown.
fn build_payload_type_from_variant(st: EmitState, enum_name: String, variant_name: String) -> String:
    let mut ei: Int = 0
    let nenums: Int = len(st.enum_infos)
    for _ in 0..500:
        if ei >= nenums { return "{ }" }
        let info: EnumInfo = st.enum_infos[ei]
        if info.name == enum_name:
            let mut vi: Int = 0
            let nvar: Int = len(info.variants)
            for _ in 0..500:
                if vi >= nvar { return "{ }" }
                if info.variants[vi].name == variant_name:
                    let types: List<MIRType> = info.variants[vi].payload_types
                    let mut result: String = "{ "
                    let mut fi: Int = 0
                    let nfty: Int = len(types)
                    for _ in 0..100:
                        if fi >= nfty:
                            return result + " }"
                        let mut pty: String = resolve_mir_type(types[fi])
                        if pty.starts_with("%struct."):
                            if is_enum_type(st, types[fi].name):
                                pty = "%enum." + types[fi].name
                        if fi > 0:
                            result = result + ", " + pty
                        else:
                            result = result + pty
                        fi = fi + 1
                    return result + " }"
                vi = vi + 1
        ei = ei + 1
    return "{ }"

fn compute_payload_alloc_size(st: EmitState, payload: List<Value>) -> Int:
    let mut total: Int = 0
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(payload) { return total }
        let mut pty: String = resolve_mir_type(payload[i].ty)
        // Same struct→enum rewrite as compute_field_offset — ensures
        // the size used here matches the field offsets below.
        if pty.starts_with("%struct."):
            if is_enum_type(st, payload[i].ty.name):
                pty = "%enum." + payload[i].ty.name
        let mut psz: Int = llvm_sizeof_st(st, pty)
        let rem: Int = psz % 8
        if rem != 0 { psz = psz + (8 - rem) }
        total = total + psz
        i = i + 1
    return total

fn compute_field_offset(st: EmitState, payload: List<Value>, field_idx: Int) -> Int:
    let mut offset: Int = 0
    let mut i: Int = 0
    for _ in 0..100:
        if i >= field_idx { return offset }
        let mut pty: String = resolve_mir_type(payload[i].ty)
        // Fix struct→enum misclassification
        if pty.starts_with("%struct."):
            if is_enum_type(st, payload[i].ty.name):
                pty = "%enum." + payload[i].ty.name
        let mut fsz: Int = llvm_sizeof_st(st, pty)
        let rem: Int = fsz % 8
        if rem != 0 { fsz = fsz + (8 - rem) }
        offset = offset + fsz
        i = i + 1
    return offset

fn resolve_variant_index(st: EmitState, enum_name: String, variant: String) -> Int:
    // Strip ":N" suffix if present (from indexed payload extraction)
    let mut vname: String = variant
    let colon: Int = variant.find(":")
    if colon >= 0:
        vname = variant.substr(0, colon)
    let mut i: Int = 0
    let neinfos2: Int = len(st.enum_infos)
    for _ in 0..500:
        if i < neinfos2:
            let info: EnumInfo = st.enum_infos[i]
            if info.name == enum_name:
                let mut vi: Int = 0
                let nvariants: Int = len(info.variants)
                for _ in 0..500:
                    if vi < nvariants:
                        if info.variants[vi].name == vname:
                            return vi
                        vi = vi + 1
            i = i + 1
    return 0

// Parse field index from "Variant:N" format. Returns N (0 if no colon).
// Uses return instead of conditional assignment (Python lowerer drops if-assignments).
fn parse_field_index(variant: String) -> Int:
    let colon_pos: Int = variant.find(":")
    if colon_pos < 0 { return 0 }
    let idx_char: String = variant.char_at(colon_pos + 1)
    return int(idx_char)

// Strip ":N" suffix from "Variant:N".
fn strip_colon_suffix(s: String) -> String:
    let colon_pos: Int = s.find(":")
    if colon_pos < 0 { return s }
    return s.substr(0, colon_pos)

// Extract everything after ":".
fn extract_after_colon(s: String, colon_pos: Int) -> String:
    let slen: Int = len(s)
    let start: Int = colon_pos + 1
    if start >= slen { return "" }
    return s.substr(start, slen - start)

// Compute byte offset to field_idx within a variant's payload.
// Sums llvm_type_size of fields 0..field_idx-1.
fn compute_payload_offset(st: EmitState, enum_name: String, variant_name: String, field_idx: Int) -> Int:
    let mut ei: Int = 0
    for _ in 0..500:
        if ei >= len(st.enum_infos) { return 0 }
        let info: EnumInfo = st.enum_infos[ei]
        if info.name == enum_name:
            let mut vi: Int = 0
            for _ in 0..500:
                if vi >= len(info.variants) { return 0 }
                if info.variants[vi].name == variant_name:
                    return sum_field_sizes(st, info.variants[vi].payload_types, field_idx)
                vi = vi + 1
        ei = ei + 1
    return 0

// Sum llvm_sizeof_st for fields 0..count-1 (v5.6.5 Ve.1: state-aware
// sizing so %struct.* resolves to the real registered size).
fn sum_field_sizes(st: EmitState, types: List<MIRType>, count: Int) -> Int:
    let mut total: Int = 0
    let mut i: Int = 0
    for _ in 0..100:
        if i >= count { return total }
        let mut pty: String = resolve_mir_type(types[i])
        // Fix struct→enum misclassification: MIR may have kind:"struct" for enums
        if pty.starts_with("%struct."):
            let tname: String = types[i].name
            if is_enum_type(st, tname):
                pty = "%enum." + tname
        let mut fsz: Int = llvm_sizeof_st(st, pty)
        let rem: Int = fsz % 8
        if rem != 0 { fsz = fsz + (8 - rem) }
        total = total + fsz
        i = i + 1
    return total

// Parse "Variant:N" → compute byte offset to field N within the variant's payload.
// Uses llvm_type_size for each prior field to sum the offset.
fn compute_variant_field_offset(st: EmitState, enum_name: String, variant_with_idx: String) -> Int:
    // Parse index from "Variant:N"
    let colon_pos: Int = variant_with_idx.find(":")
    if colon_pos < 0 { return 0 }
    let idx_str: String = variant_with_idx.substr(colon_pos + 1, len(variant_with_idx) - colon_pos - 1)
    let field_idx: Int = int(idx_str)
    if field_idx == 0 { return 0 }

    // Look up variant's payload types
    let variant_name: String = variant_with_idx.substr(0, colon_pos)
    let mut ei: Int = 0
    for _ in 0..500:
        if ei >= len(st.enum_infos) { return 0 }
        let info: EnumInfo = st.enum_infos[ei]
        if info.name == enum_name:
            let mut vi: Int = 0
            for _ in 0..500:
                if vi >= len(info.variants) { return 0 }
                if info.variants[vi].name == variant_name:
                    // Sum sizes of fields 0..field_idx-1
                    // v5.6.5 Ve.1: state-aware sizing so %struct.* resolves
                    // to the real registered size (not the 256 fallback).
                    let mut offset: Int = 0
                    let mut fi: Int = 0
                    for _ in 0..100:
                        if fi >= field_idx { return offset }
                        if fi >= len(info.variants[vi].payload_types) { return offset }
                        let fty: String = resolve_mir_type(info.variants[vi].payload_types[fi])
                        let mut fsz: Int = llvm_sizeof_st(st, fty)
                        let rem: Int = fsz % 8
                        if rem != 0 { fsz = fsz + (8 - rem) }
                        offset = offset + fsz
                        fi = fi + 1
                    return offset
                vi = vi + 1
        ei = ei + 1
    return 0

// ---------------------------------------------------------------------------
// EnumTag instruction
// ---------------------------------------------------------------------------

fn emit_enum_tag(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let enum_ty: String = resolve_type(st, val.ty)
    let dn: String = dest.name
    // For Result/Option the tag field is i1; for enums it's i64.
    // The lowerer types `dest` per its consumer: try-op declares
    // `mir_bool()` (TK_BOOL → expects i1 for `br i1`); match
    // declares the enum type itself (expects i64 for `switch i64`,
    // which `emit_mir_switch` hard-codes). Honor `dest.ty.kind`.
    if val.ty.kind == TK_RESULT() || val.ty.kind == TK_OPTION():
        if dest.ty.kind == TK_BOOL():
            s = emit_line(s, emit_extractvalue(dn, enum_ty, val.name, "0"))
        else:
            let raw_tag: String = dn + ".raw"
            s = emit_line(s, emit_extractvalue(raw_tag, enum_ty, val.name, "0"))
            s = emit_line(s, "  " + dn + " = zext i1 " + raw_tag + " to i64")
    else:
        s = emit_line(s, emit_extractvalue(dn, enum_ty, val.name, "0"))
    s

// ---------------------------------------------------------------------------
// EnumPayload instruction
// ---------------------------------------------------------------------------

fn emit_enum_payload(st: EmitState, dest: Value, val: Value, variant: String) -> EmitState:
    let mut s: EmitState = st
    let enum_ty: String = resolve_type(st, val.ty)
    let dn: String = dest.name

    // For Result/Option: use extractvalue on the inner struct
    if val.ty.kind == TK_RESULT():
        // Result = {i1, {ok_ty, err_ty}}. Extract inner struct, then payload.
        let inner_r: String = dn + ".inner"
        s = emit_line(s, "  " + inner_r + " = extractvalue " + enum_ty + " " + val.name + ", 1")
        // Ok payload at index 0, Err payload at index 1
        let mut ok_ty: String = llvm_ptr()
        let mut err_ty: String = llvm_ptr()
        if len(val.ty.args) >= 2:
            ok_ty = resolve_mir_type(val.ty.args[0])
            err_ty = resolve_mir_type(val.ty.args[1])
        let inner_ty_res: String = "{ " + ok_ty + ", " + err_ty + " }"
        // Strip ":N" suffix from variant name (lowerer passes "Ok:0", "Err:0")
        let base_variant: String = strip_colon_suffix(variant)
        if base_variant == "Ok":
            s = emit_line(s, "  " + dn + " = extractvalue " + inner_ty_res + " " + inner_r + ", 0")
        else:
            s = emit_line(s, "  " + dn + " = extractvalue " + inner_ty_res + " " + inner_r + ", 1")
        return s
    if val.ty.kind == TK_OPTION():
        // Universal erasure: Option = {i1, ptr}. Extract ptr, then load.
        let ptr_name: String = dn + ".ptr"
        s = emit_line(s, "  " + ptr_name + " = extractvalue " + enum_ty + " " + val.name + ", 1")
        // Use destination type for load — avoids struct/enum name mismatches
        let inner_ty_opt: String = resolve_type(st, dest.ty)
        s = emit_line(s, "  " + dn + " = load " + inner_ty_opt + ", ptr " + ptr_name)
        return s

    // v4.140.0 Cb.5: inline enum — extract i64 slot and unpack.
    let inline_slots_p: Int = lookup_enum_inline(s, val.ty.name)
    if inline_slots_p > 0:
        let field_idx_i: Int = parse_field_index(variant)
        let slot_idx_i: Int = field_idx_i + 1
        let mut dest_ty_i: String = resolve_mir_type(dest.ty)
        if dest_ty_i.starts_with("%struct."):
            if is_enum_type(s, dest.ty.name) { dest_ty_i = "%enum." + dest.ty.name }
        let raw_i: String = dn + ".raw"
        s = emit_line(s, "  " + raw_i + " = extractvalue " + enum_ty + " " + val.name + ", " + toString(slot_idx_i))
        if dest_ty_i == "i64":
            s = emit_line(s, "  " + dn + " = add i64 0, " + raw_i)
        else:
            s = unpack_from_i64(s, raw_i, dest_ty_i, dn)
        return s

    // Pointer-based enum: { i64 tag, ptr payload }.
    // Extract payload pointer using the named enum type.
    let pr: String = dn + ".pr"
    s = emit_line(s, "  " + pr + " = extractvalue " + enum_ty + " " + val.name + ", 1")

    // Determine the dest type
    let mut dest_ty: String = resolve_mir_type(dest.ty)
    // Correct struct→enum misclassification
    if dest_ty.starts_with("%struct."):
        let payload_name: String = dest.ty.name
        if is_enum_type(s, payload_name):
            dest_ty = "%enum." + payload_name

    // Parse field index from "Variant:N" suffix.
    let field_idx: Int = parse_field_index(variant)

    if field_idx > 0:
        // v5.6.5 Ve.1 fix — defer field-offset computation to LLVM via
        // a typed GEP. Matches Python's extraction path at
        // emit_llvm_text.py:4894-4898: build the inline payload struct
        // type from the variant's registered payload_types, then GEP
        // into field `field_idx` with element index. LLVM's DataLayout
        // resolves the byte offset at link time — guaranteed consistent
        // with the typed GEP used at emit_enum_init's storage site.
        let stripped_name: String = strip_colon_suffix(variant)
        let payload_ty: String = build_payload_type_from_variant(s, val.ty.name, stripped_name)
        let pf: String = dn + ".pf"
        s = emit_line(s, "  " + pf + " = getelementptr inbounds " + payload_ty + ", ptr " + pr + ", i32 0, i32 " + toString(field_idx))
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + pf)
    else:
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + pr)
    return s

// ---------------------------------------------------------------------------
// Option/Result wrapping
// ---------------------------------------------------------------------------

fn emit_wrap_some(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let val_ty: String = resolve_type(st, val.ty)
    let dn: String = dest.name

    // Heap-allocate the payload via malloc so the pointer survives function returns.
    // Stack alloca would be destroyed when the current function returns, leaving
    // a dangling pointer in the {i1, ptr} Option representation.
    let ea: String = dn + ".ea"
    let sz: String = dn + ".sz"
    s = emit_line(s, "  " + sz + " = ptrtoint ptr getelementptr (" + val_ty + ", ptr null, i32 1) to i64")
    s = emit_line(s, "  " + ea + " = call ptr @malloc(i64 " + sz + ")")
    // v5.23.1 Mb.2: track the malloc'd box for drop-glue freeing.
    // emit_drop_glue_boxed iterates st.boxed_owned at every ret and calls
    // free() unless the pointer aliases a returned value. Without this,
    // every Some(x) construction leaks the payload box on every fn exit
    // — the Te.5 if-let / while-let / let-else NEW LEAK class on
    // tests/golden/{88,90,91}.mn surfaces this latent gap, but it's also
    // the load-bearing leak in golden 17_option since v5.4.2.
    s = emit_track_boxed(s, ea)
    s = emit_line(s, "  store " + val_ty + " " + val.name + ", ptr " + ea)
    let opt_ty: String = llvm_option_type(llvm_ptr())
    let tag_name: String = dn + ".tag"
    s = emit_line(s, emit_insertvalue(tag_name, opt_ty, "undef", "1", "i1", "0"))
    s = emit_line(s, emit_insertvalue(dn, opt_ty, tag_name, ea, llvm_ptr(), "1"))
    return s

fn emit_wrap_none(st: EmitState, dest: Value, ty: MIRType) -> EmitState:
    // Universal erasure: all Option types are {i1, ptr}. None = {i1=0, null}.
    let opt_ty: String = llvm_option_type(llvm_ptr())
    let dn: String = dest.name
    let s: EmitState = emit_line(st, emit_insertvalue(dn, opt_ty, "undef", "0", "i1", "0"))
    s

fn emit_wrap_ok(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    // Use dest's Result type args for correct ok/err layout
    let res_ty: String = resolve_mir_type(dest.ty)
    let val_ty: String = resolve_mir_type(val.ty)
    let mut ok_ty: String = val_ty
    let mut err_ty: String = llvm_ptr()
    if len(dest.ty.args) >= 2:
        ok_ty = resolve_mir_type(dest.ty.args[0])
        err_ty = resolve_mir_type(dest.ty.args[1])
    let inner_ty: String = "{ " + ok_ty + ", " + err_ty + " }"
    let dn: String = dest.name

    let tag_name: String = dn + ".tag"
    s = emit_line(s, emit_insertvalue(tag_name, res_ty, "undef", "1", "i1", "0"))
    let inner_name: String = dn + ".inner"
    s = emit_line(s, emit_insertvalue(inner_name, inner_ty, "undef", val.name, ok_ty, "0"))
    s = emit_line(s, emit_insertvalue(dn, res_ty, tag_name, inner_name, inner_ty, "1"))
    return s

fn emit_wrap_err(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let res_ty: String = resolve_mir_type(dest.ty)
    let val_ty: String = resolve_mir_type(val.ty)
    let mut ok_ty: String = llvm_ptr()
    let mut err_ty: String = val_ty
    if len(dest.ty.args) >= 2:
        ok_ty = resolve_mir_type(dest.ty.args[0])
        err_ty = resolve_mir_type(dest.ty.args[1])
    let inner_ty: String = "{ " + ok_ty + ", " + err_ty + " }"
    let dn: String = dest.name

    let tag_name: String = dn + ".tag"
    s = emit_line(s, emit_insertvalue(tag_name, res_ty, "undef", "0", "i1", "0"))
    let inner_name: String = dn + ".inner"
    s = emit_line(s, emit_insertvalue(inner_name, inner_ty, "undef", val.name, err_ty, "1"))
    s = emit_line(s, emit_insertvalue(dn, res_ty, tag_name, inner_name, inner_ty, "1"))
    return s

// ---------------------------------------------------------------------------
// Unwrap instruction
// ---------------------------------------------------------------------------

fn emit_unwrap(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let val_ty: String = resolve_mir_type(val.ty)
    let dn: String = dest.name
    if val.ty.kind == TK_OPTION():
        // Universal erasure: Option is {i1, ptr}. Extract ptr, then load.
        let ptr_name: String = dn + ".ptr"
        s = emit_line(s, emit_extractvalue(ptr_name, val_ty, val.name, "1"))
        // Use destination type for the load — avoids struct/enum name mismatches
        let inner_ty: String = resolve_type(st, dest.ty)
        s = emit_line(s, "  " + dn + " = load " + inner_ty + ", ptr " + ptr_name)
    else if val.ty.kind == TK_RESULT():
        // Eu.1 (v5.26.1): Result is `{i1, {Ok_ty, Err_ty}}`. The single
        // `extractvalue ..., 1` returns the *inner* aggregate, not the Ok
        // payload, so consumers typed as Ok_ty get a width mismatch
        // (golden 47 — `?` operator on Result<Int, String>). Two
        // extractvalues — field 1 of outer (inner aggregate) then field 0
        // of inner (Ok payload).
        if len(val.ty.args) >= 2:
            let ok_ty: String = resolve_mir_type(val.ty.args[0])
            let err_ty: String = resolve_mir_type(val.ty.args[1])
            let inner_ty: String = "{" + ok_ty + ", " + err_ty + "}"
            let inner_name: String = dn + ".inner"
            s = emit_line(s, emit_extractvalue(inner_name, val_ty, val.name, "1"))
            s = emit_line(s, emit_extractvalue(dn, inner_ty, inner_name, "0"))
        else:
            s = emit_line(s, emit_extractvalue(dn, val_ty, val.name, "1"))
    else:
        // Non-option/non-result: direct extractvalue
        s = emit_line(s, emit_extractvalue(dn, val_ty, val.name, "1"))
    s

// ---------------------------------------------------------------------------
// Call instruction
// ---------------------------------------------------------------------------

fn emit_mir_call(st: EmitState, dest: Value, fn_name: String, args: List<Value>) -> EmitState:
    let dn: String = dest.name

    // Built-in: print / println
    if fn_name == "print":
        return emit_builtin_print(st, args)
    if fn_name == "println":
        return emit_builtin_println(st, args)
    if fn_name == "len":
        return emit_builtin_len(st, dest, args)
    if fn_name == "toString":
        return emit_builtin_tostring(st, dest, args)
    if fn_name == "str":
        return emit_builtin_tostring(st, dest, args)
    if fn_name == "int":
        return emit_builtin_int(st, dest, args)
    if fn_name == "float":
        return emit_builtin_float(st, dest, args)

    // Runtime: process + file I/O
    if fn_name == "__mn_argc":
        return emit_rt_call(st, dn, "i64", "__mn_argc", "")
    if fn_name == "__mn_argv":
        let as_argv: String = "i64 " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_argv", as_argv)
    if fn_name == "__mn_file_read_or_empty":
        let as_fr: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_file_read_or_empty", as_fr)
    if fn_name == "__mn_exit":
        return emit_rt_call_void(st, "__mn_exit", "i64 " + args[0].name)
    if fn_name == "__mn_file_write":
        let as_fw: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call(st, dn, "i64", "__mn_file_write", as_fw)
    if fn_name == "__mn_system":
        let as_sys: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_system", as_sys)
    if fn_name == "__mn_str_eprint":
        let as_epr: String = llvm_string() + " " + args[0].name
        return emit_rt_call_void(st, "__mn_str_eprint", as_epr)
    // v5.26.0 Mb.9: route the v5.23.2 Te.3.B.2 brace-deprecation
    // functions through emit_rt_call(_void). The default user-call
    // path uses is_byref_type_st (64-byte threshold), but MnString
    // is 16 bytes, so on Win64 it would pass the struct by value
    // while declare_runtime_fn already declared the parameter as
    // `ptr` (8-byte threshold via win64_rewrite_decl_params). gcc
    // implements `MnString source` per Win64 ABI as pass-by-hidden-
    // pointer, dereferences rcx as the struct pointer, and reads
    // the data buffer's bytes 8..16 as the length field. Mirrors
    // the v5.23.1 Mb.1 pattern for `__mn_indent_to_braces`. Once
    // mnc-stage1.exe is rebuilt with the Python-side fix, this
    // self-host fix keeps stage2.ll Win64-correct on its own.
    if fn_name == "__mn_count_user_brace_block_openers":
        let as_cbb: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_count_user_brace_block_openers", as_cbb)
    if fn_name == "__mn_emit_brace_deprecation_warning":
        let as_ebw: String = llvm_string() + " " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call_void(st, "__mn_emit_brace_deprecation_warning", as_ebw)
    // v5.29.0 Mb.10: route __mn_indent_to_braces through emit_rt_call
    // for the same Win64 ABI reason as v5.26.0 Mb.9 routed the
    // brace-deprecation siblings above. The Python emitter has had
    // this routing since v5.23.1 Mb.1 (emit_llvm_text.py:3632); the
    // self-host side was missed. Without this, stage2.ll emitted a
    // by-value call against a declare-as-`ptr` signature on Win64,
    // and gcc lowered the call as pass-by-hidden-pointer with rcx
    // pointing into the struct's data buffer instead of into a
    // valid MnString — SIGSEGV on the first source.len read in
    // __mn_indent_to_braces (publish run #50, x86_64-w64-mingw32).
    if fn_name == "__mn_indent_to_braces":
        let as_itb: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_indent_to_braces", as_itb)

    // chr/ord builtins
    if fn_name == "chr":
        return emit_rt_call(st, dn, llvm_string(), "__mn_str_chr", "i64 " + args[0].name)
    if fn_name == "ord":
        return emit_rt_call(st, dn, "i64", "__mn_str_ord", llvm_string() + " " + args[0].name)

    // I/O builtins (v3.41.0)
    if fn_name == "read_line":
        return emit_rt_call(st, dn, llvm_string(), "__mn_read_line", "")
    if fn_name == "read_file":
        let as_rf: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_file_read_or_empty", as_rf)
    if fn_name == "write_file":
        let as_wf: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call_void(st, "__mn_file_write", as_wf)
    if fn_name == "append_file":
        let as_af: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call_void(st, "__mn_file_append", as_af)
    if fn_name == "file_exists":
        let as_fe: String = llvm_string() + " " + args[0].name
        let cnt_fe: String = toString(st.counter)
        let mut s_fe: EmitState = st
        s_fe.counter = s_fe.counter + 1
        let fe_raw: String = "%fe_raw" + cnt_fe
        s_fe = emit_line(s_fe, "  " + fe_raw + " = call i64 @__mn_file_exists(" + as_fe + ")")
        s_fe = emit_line(s_fe, "  " + dn + " = icmp ne i64 " + fe_raw + ", 0")
        return s_fe
    if fn_name == "list_dir":
        let as_ld: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_list_rt(), "__mn_dir_list_strings", as_ld)
    // Network/crypto/regex builtins (v3.42.0)
    if fn_name == "http_get":
        let as_hg: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_http_get", as_hg)
    if fn_name == "sha256":
        let as_sh: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_sha256_str", as_sh)
    if fn_name == "base64_encode":
        let as_be: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_base64_encode_str", as_be)
    if fn_name == "base64_decode":
        let as_bd: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_base64_decode_str", as_bd)
    if fn_name == "hmac_sha256":
        let as_hm: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_hmac_sha256_str", as_hm)
    if fn_name == "hex_encode":
        let as_he: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_hex_encode_str", as_he)
    if fn_name == "random_bytes":
        return emit_rt_call(st, dn, llvm_string(), "__mn_random_bytes_str", "i64 " + args[0].name)
    if fn_name == "regex_match":
        // compile + exec + free pattern (matches Python emitter)
        let cnt_rm: String = toString(st.counter)
        let mut s_rm: EmitState = st
        s_rm.counter = s_rm.counter + 3
        let rh: String = "%rh" + cnt_rm
        let re: String = "%re" + cnt_rm
        let rf: String = "%rf" + cnt_rm
        s_rm = emit_line(s_rm, "  " + rh + " = call i64 @__mn_regex_compile_str(" + llvm_string() + " " + args[0].name + ")")
        s_rm = emit_line(s_rm, "  " + re + " = call i64 @__mn_regex_exec_str(i64 " + rh + ", " + llvm_string() + " " + args[1].name + ", i64 0)")
        s_rm = emit_line(s_rm, "  " + rf + " = call i64 @__mn_regex_free(i64 " + rh + ")")
        s_rm = emit_line(s_rm, "  " + dn + " = icmp sgt i64 " + re + ", 0")
        return s_rm
    if fn_name == "regex_replace":
        // compile + replace + free pattern (matches Python emitter)
        let cnt_rr: String = toString(st.counter)
        let mut s_rr: EmitState = st
        s_rr.counter = s_rr.counter + 3
        let rh2: String = "%rh2_" + cnt_rr
        let rr2: String = "%rr2_" + cnt_rr
        let rf2: String = "%rf2_" + cnt_rr
        s_rr = emit_line(s_rr, "  " + rh2 + " = call i64 @__mn_regex_compile_str(" + llvm_string() + " " + args[0].name + ")")
        s_rr = emit_line(s_rr, "  " + dn + " = call " + llvm_string() + " @__mn_regex_replace_str(i64 " + rh2 + ", " + llvm_string() + " " + args[1].name + ", " + llvm_string() + " " + args[2].name + ", i64 1)")
        s_rr = emit_line(s_rr, "  " + rf2 + " = call i64 @__mn_regex_free(i64 " + rh2 + ")")
        return s_rr
    // GPU builtins (v3.46.0)
    if fn_name == "gpu_available":
        let cnt_ga: String = toString(st.counter)
        let mut s_ga: EmitState = st
        s_ga.counter = s_ga.counter + 1
        let raw_ga: String = "%ga_raw" + cnt_ga
        s_ga = emit_line(s_ga, "  " + raw_ga + " = call i64 @__mn_gpu_available()")
        s_ga = emit_line(s_ga, "  " + dn + " = icmp ne i64 " + raw_ga + ", 0")
        return s_ga
    if fn_name == "gpu_device_name":
        return emit_rt_call(st, dn, llvm_string(), "__mn_gpu_device_name", "")
    if fn_name == "gpu_device_memory":
        return emit_rt_call(st, dn, "i64", "__mn_gpu_device_memory", "")
    if fn_name == "gpu_tensor_add" || fn_name == "gpu_tensor_sub" || fn_name == "gpu_tensor_mul" || fn_name == "gpu_tensor_div":
        // C runtime takes MnList* (ptr), so alloca+store to pass by pointer
        let cnt_gt: String = toString(st.counter)
        let mut s_gt: EmitState = st
        s_gt.counter = s_gt.counter + 2
        let pa: String = "%gta" + cnt_gt
        let pb: String = "%gtb" + cnt_gt
        s_gt = emit_line(s_gt, "  " + pa + " = alloca " + llvm_list_rt())
        s_gt = emit_line(s_gt, "  " + pb + " = alloca " + llvm_list_rt())
        s_gt = emit_line(s_gt, "  store " + llvm_list_rt() + " " + args[0].name + ", ptr " + pa)
        s_gt = emit_line(s_gt, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + pb)
        let mut rt_name: String = "__mn_gpu_tensor_add"
        if fn_name == "gpu_tensor_sub" { rt_name = "__mn_gpu_tensor_sub" }
        if fn_name == "gpu_tensor_mul" { rt_name = "__mn_gpu_tensor_mul" }
        if fn_name == "gpu_tensor_div" { rt_name = "__mn_gpu_tensor_div" }
        let as_gt: String = "ptr " + pa + ", ptr " + pb
        s_gt = emit_rt_call(s_gt, dn, llvm_list_rt(), rt_name, as_gt)
        return s_gt
    if fn_name == "gpu_tensor_matmul":
        let cnt_gm: String = toString(st.counter)
        let mut s_gm: EmitState = st
        s_gm.counter = s_gm.counter + 2
        let gma: String = "%gma" + cnt_gm
        let gmb: String = "%gmb" + cnt_gm
        s_gm = emit_line(s_gm, "  " + gma + " = alloca " + llvm_list_rt())
        s_gm = emit_line(s_gm, "  " + gmb + " = alloca " + llvm_list_rt())
        s_gm = emit_line(s_gm, "  store " + llvm_list_rt() + " " + args[0].name + ", ptr " + gma)
        s_gm = emit_line(s_gm, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + gmb)
        let as_gm: String = "ptr " + gma + ", ptr " + gmb + ", i64 " + args[2].name + ", i64 " + args[3].name + ", i64 " + args[4].name
        s_gm = emit_rt_call(s_gm, dn, llvm_list_rt(), "__mn_gpu_tensor_matmul", as_gm)
        return s_gm

    // v5.6.0 Sh.6 — tensor builtins routed to __mn_tensor_* runtime.
    // Tensor values travel as ptr in the self-hosted emitter (MIR kind
    // TENSOR currently resolves through the unknown fallthrough to i64 in
    // resolve_mir_type; the alloc call and these builtins all treat the
    // dest / arg as ptr). Mirrors emit_llvm_text.py:3568-3601.
    if fn_name == "tensor_rank":
        let as_tr: String = "ptr " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_rank", as_tr)
    if fn_name == "tensor_size":
        let as_ts: String = "ptr " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_size", as_ts)
    if fn_name == "tensor_get_f64":
        let as_tgf: String = "ptr " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call(st, dn, "double", "__mn_tensor_get_f64", as_tgf)
    if fn_name == "tensor_get_i64":
        let as_tgi: String = "ptr " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_get_i64", as_tgi)
    if fn_name == "tensor_shape_dim":
        let as_tsd: String = "ptr " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_shape_dim", as_tsd)
    if fn_name == "tensor_print":
        let as_tp: String = "ptr " + args[0].name
        return emit_rt_call_void(st, "__mn_tensor_print_f64", as_tp)

    // v5.6.1 Sh.6 Phase 2 — variadic tensor_*_nd calls. LLVM requires the
    // explicit function-type prefix `(ptr, i64, ...)` when calling a
    // varargs fn. args layout: [tensor, rank, i0, i1, ...] for get;
    // [tensor, rank, i0, ..., val] for set (val comes last, as a non-
    // variadic-style arg typed as double/i64).
    if fn_name == "__mn_tensor_get_f64_nd":
        let nargs_g: Int = len(args)
        let mut inner_g: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_g: Int = 2
        for _ in 0..128:
            if j_g < nargs_g:
                inner_g = inner_g + ", i64 " + args[j_g].name
                j_g = j_g + 1
        return emit_line(st, "  " + dn + " = call double (ptr, i64, ...) @__mn_tensor_get_f64_nd(" + inner_g + ")")
    if fn_name == "__mn_tensor_get_i64_nd":
        let nargs_gi: Int = len(args)
        let mut inner_gi: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_gi: Int = 2
        for _ in 0..128:
            if j_gi < nargs_gi:
                inner_gi = inner_gi + ", i64 " + args[j_gi].name
                j_gi = j_gi + 1
        return emit_line(st, "  " + dn + " = call i64 (ptr, i64, ...) @__mn_tensor_get_i64_nd(" + inner_gi + ")")
    if fn_name == "__mn_tensor_set_f64_nd":
        let nargs_s: Int = len(args)
        let mut inner_s: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_s: Int = 2
        let last_s: Int = nargs_s - 1
        for _ in 0..128:
            if j_s < last_s:
                inner_s = inner_s + ", i64 " + args[j_s].name
                j_s = j_s + 1
        if nargs_s >= 3:
            inner_s = inner_s + ", double " + args[last_s].name
        return emit_line(st, "  call void (ptr, i64, ...) @__mn_tensor_set_f64_nd(" + inner_s + ")")
    // v5.41.0 Ts.1 → v5.45.0 Ts.2.B — `__mn_tensor_reshape` and
    // `__mn_tensor_view` share the same call shape. Lowerer emits
    // Call(fn, [tensor, shape: List<Int>]). Runtime expects (ptr tensor,
    // ptr shape_list). Alloca a list-shaped slot, store the list value
    // into it, call with the alloca ptr. Both are aliasing now —
    // `noalias` dropped from the call (v5.45.0 swap).
    if fn_name == "__mn_tensor_reshape" || fn_name == "__mn_tensor_view":
        let cnt_rs: String = toString(st.counter)
        let mut s_rs: EmitState = st
        s_rs.counter = s_rs.counter + 1
        let mut prefix_rs: String = "treshape"
        if fn_name == "__mn_tensor_view" { prefix_rs = "tview" }
        let shp_p: String = "%" + prefix_rs + "_shape" + cnt_rs
        s_rs = emit_line(s_rs, "  " + shp_p + " = alloca " + llvm_list_rt())
        s_rs = emit_line(s_rs, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + shp_p)
        s_rs = emit_line(s_rs, "  " + dn + " = call ptr @" + fn_name + "(ptr " + args[0].name + ", ptr " + shp_p + ")")
        s_rs = emit_track_tensor(s_rs, dn)
        return s_rs

    // v5.6.3 Sh.6 Phase 4 — `__mn_tensor_slice` special case. Lowerer passes
    // flat args [tensor, s0, s1, ..., e0, e1, ..., rank]; the runtime
    // expects (ptr tensor, ptr starts_arr, ptr ends_arr, i64 rank). We
    // alloca two [ndim x i64] arrays, store each start/end value via
    // getelementptr + store, then call the runtime with the array ptrs.
    // Mirrors emit_llvm_text.py:3669-3717.
    if fn_name == "__mn_tensor_slice":
        let nargs_sl: Int = len(args)
        let rank_idx_sl: Int = nargs_sl - 1
        let ndim_sl: Int = (nargs_sl - 2) / 2
        let cnt_sl: String = toString(st.counter)
        let mut s_sl: EmitState = st
        s_sl.counter = s_sl.counter + 1

        let starts_arr: String = "%starts_arr" + cnt_sl
        let ends_arr: String = "%ends_arr" + cnt_sl
        let arr_ty: String = "[" + toString(ndim_sl) + " x i64]"
        s_sl = emit_line(s_sl, "  " + starts_arr + " = alloca " + arr_ty)
        s_sl = emit_line(s_sl, "  " + ends_arr + " = alloca " + arr_ty)

        let mut d_sl: Int = 0
        for _ in 0..128:
            if d_sl < ndim_sl:
                let d_str: String = toString(d_sl)
                let cnt_d: String = toString(s_sl.counter)
                s_sl.counter = s_sl.counter + 1
                let s_gep: String = "%sgep" + cnt_d
                let e_gep: String = "%egep" + cnt_d
                s_sl = emit_line(s_sl, "  " + s_gep + " = getelementptr inbounds " + arr_ty + ", ptr " + starts_arr + ", i64 0, i64 " + d_str)
                s_sl = emit_line(s_sl, "  " + e_gep + " = getelementptr inbounds " + arr_ty + ", ptr " + ends_arr + ", i64 0, i64 " + d_str)
                let s_val_name: String = args[1 + d_sl].name
                let e_val_name: String = args[1 + ndim_sl + d_sl].name
                s_sl = emit_line(s_sl, "  store i64 " + s_val_name + ", ptr " + s_gep)
                s_sl = emit_line(s_sl, "  store i64 " + e_val_name + ", ptr " + e_gep)
                d_sl = d_sl + 1

        let t_name_sl: String = args[0].name
        let rank_name_sl: String = args[rank_idx_sl].name
        s_sl = emit_line(s_sl, "  " + dn + " = call noalias ptr @__mn_tensor_slice(ptr " + t_name_sl + ", ptr " + starts_arr + ", ptr " + ends_arr + ", i64 " + rank_name_sl + ")")
        // v5.6.4 Rt.06 — track the fresh tensor for drop-glue.
        s_sl = emit_track_tensor(s_sl, dn)
        return s_sl

    // v5.45.0 Ts.3.B — `__mn_tensor_step_slice` special case. Lowerer
    // passes flat args [tensor, s0..s_{n-1}, e0..e_{n-1}, k0..k_{n-1},
    // rank] = 3*ndim + 2 args. Runtime expects (ptr tensor, ptr starts,
    // ptr ends, ptr steps, i64 rank). Alloca three [ndim x i64] arrays,
    // store each start/end/step value, call the runtime. No `noalias`
    // — consistent with v5.45.0 conservative omission across tensor-
    // producing exports. Mirrors emit_llvm_text.py:3992-4054.
    if fn_name == "__mn_tensor_step_slice":
        let nargs_ss: Int = len(args)
        let rank_idx_ss: Int = nargs_ss - 1
        let ndim_ss: Int = (nargs_ss - 2) / 3
        let cnt_ss: String = toString(st.counter)
        let mut s_ss: EmitState = st
        s_ss.counter = s_ss.counter + 1

        let starts_arr_ss: String = "%starts_arr" + cnt_ss
        let ends_arr_ss: String = "%ends_arr" + cnt_ss
        let steps_arr_ss: String = "%steps_arr" + cnt_ss
        let arr_ty_ss: String = "[" + toString(ndim_ss) + " x i64]"
        s_ss = emit_line(s_ss, "  " + starts_arr_ss + " = alloca " + arr_ty_ss)
        s_ss = emit_line(s_ss, "  " + ends_arr_ss + " = alloca " + arr_ty_ss)
        s_ss = emit_line(s_ss, "  " + steps_arr_ss + " = alloca " + arr_ty_ss)

        let mut d_ss: Int = 0
        for _ in 0..128:
            if d_ss < ndim_ss:
                let d_str_ss: String = toString(d_ss)
                let cnt_d_ss: String = toString(s_ss.counter)
                s_ss.counter = s_ss.counter + 1
                let s_gep_ss: String = "%sgep" + cnt_d_ss
                let e_gep_ss: String = "%egep" + cnt_d_ss
                let k_gep_ss: String = "%kgep" + cnt_d_ss
                s_ss = emit_line(s_ss, "  " + s_gep_ss + " = getelementptr inbounds " + arr_ty_ss + ", ptr " + starts_arr_ss + ", i64 0, i64 " + d_str_ss)
                s_ss = emit_line(s_ss, "  " + e_gep_ss + " = getelementptr inbounds " + arr_ty_ss + ", ptr " + ends_arr_ss + ", i64 0, i64 " + d_str_ss)
                s_ss = emit_line(s_ss, "  " + k_gep_ss + " = getelementptr inbounds " + arr_ty_ss + ", ptr " + steps_arr_ss + ", i64 0, i64 " + d_str_ss)
                let s_val_ss: String = args[1 + d_ss].name
                let e_val_ss: String = args[1 + ndim_ss + d_ss].name
                let k_val_ss: String = args[1 + 2 * ndim_ss + d_ss].name
                s_ss = emit_line(s_ss, "  store i64 " + s_val_ss + ", ptr " + s_gep_ss)
                s_ss = emit_line(s_ss, "  store i64 " + e_val_ss + ", ptr " + e_gep_ss)
                s_ss = emit_line(s_ss, "  store i64 " + k_val_ss + ", ptr " + k_gep_ss)
                d_ss = d_ss + 1

        let t_name_ss: String = args[0].name
        let rank_name_ss: String = args[rank_idx_ss].name
        s_ss = emit_line(s_ss, "  " + dn + " = call ptr @__mn_tensor_step_slice(ptr " + t_name_ss + ", ptr " + starts_arr_ss + ", ptr " + ends_arr_ss + ", ptr " + steps_arr_ss + ", i64 " + rank_name_ss + ")")
        s_ss = emit_track_tensor(s_ss, dn)
        return s_ss

    if fn_name == "__mn_tensor_set_i64_nd":
        let nargs_si: Int = len(args)
        let mut inner_si: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_si: Int = 2
        let last_si: Int = nargs_si - 1
        for _ in 0..128:
            if j_si < last_si:
                inner_si = inner_si + ", i64 " + args[j_si].name
                j_si = j_si + 1
        if nargs_si >= 3:
            inner_si = inner_si + ", i64 " + args[last_si].name
        return emit_line(st, "  call void (ptr, i64, ...) @__mn_tensor_set_i64_nd(" + inner_si + ")")

    // Map iteration helpers
    if fn_name == "__mn_map_keys":
        // Extract map pointer from {ptr, i64} and call __mn_map_keys(ptr)
        let cnt_mk: String = toString(st.counter)
        let mut s_mk: EmitState = st
        s_mk.counter = s_mk.counter + 1
        let mptr: String = "%mk_ptr" + cnt_mk
        s_mk = emit_line(s_mk, "  " + mptr + " = extractvalue " + llvm_map_type() + " " + args[0].name + ", 0")
        s_mk = emit_rt_call(s_mk, dn, llvm_list_rt(), "__mn_map_keys", "ptr " + mptr)
        return s_mk
    if fn_name == "__list_get_string":
        // Get element ptr from list, then load MnString from it
        let cnt_lg: String = toString(st.counter)
        let mut s_lg: EmitState = st
        s_lg.counter = s_lg.counter + 1
        // Alloca list to get ptr
        let la: String = "%lg_la" + cnt_lg
        s_lg = emit_line(s_lg, "  " + la + " = alloca " + llvm_list_rt())
        s_lg = emit_line(s_lg, "  store " + llvm_list_rt() + " " + args[0].name + ", ptr " + la)
        let ep: String = "%lg_ep" + cnt_lg
        s_lg = emit_line(s_lg, "  " + ep + " = call ptr @__mn_list_get(ptr " + la + ", i64 " + args[1].name + ")")
        s_lg = emit_line(s_lg, "  " + dn + " = load " + llvm_string() + ", ptr " + ep)
        return s_lg

    // BinOp fallback: when enum tag mismatch causes BinOp to reach Call dispatch,
    // the fn_name is "__op_<operator>". Convert to inline LLVM arithmetic.
    if fn_name.starts_with("__op_"):
        let op_ch: String = fn_name.replace("__op_", "")
        let an: String = args[0].name
        let bn: String = args[1].name
        if op_ch == "+" { return emit_line(st, emit_add(dn, llvm_int(), an, bn)) }
        if op_ch == "-" { return emit_line(st, emit_sub(dn, llvm_int(), an, bn)) }
        if op_ch == "*" { return emit_line(st, emit_mul(dn, llvm_int(), an, bn)) }
        if op_ch == "/" { return emit_line(st, emit_sdiv(dn, llvm_int(), an, bn)) }
        if op_ch == "%" { return emit_line(st, emit_srem(dn, llvm_int(), an, bn)) }
        if op_ch == "==" { return emit_line(st, emit_icmp(dn, "eq", llvm_int(), an, bn)) }
        if op_ch == "!=" { return emit_line(st, emit_icmp(dn, "ne", llvm_int(), an, bn)) }
        if op_ch == "<" { return emit_line(st, emit_icmp(dn, "slt", llvm_int(), an, bn)) }
        if op_ch == ">" { return emit_line(st, emit_icmp(dn, "sgt", llvm_int(), an, bn)) }
        if op_ch == "<=" { return emit_line(st, emit_icmp(dn, "sle", llvm_int(), an, bn)) }
        if op_ch == ">=" { return emit_line(st, emit_icmp(dn, "sge", llvm_int(), an, bn)) }
        if op_ch == "&&" { return emit_line(st, emit_and_instr(dn, an, bn)) }
        if op_ch == "||" { return emit_line(st, emit_or_instr(dn, an, bn)) }
        // Fallback for unknown operator
        return emit_line(st, emit_add(dn, llvm_int(), an, bn))

    // Range construction — inline {i64, i64} (no heap allocation needed)
    if fn_name == "__mn_range":
        let mut s_rng: EmitState = st
        let tmp_rng: String = dn + ".tmp"
        s_rng = emit_line(s_rng, "  " + tmp_rng + " = insertvalue {i64, i64} undef, i64 " + args[0].name + ", 0")
        s_rng = emit_line(s_rng, "  " + dn + " = insertvalue {i64, i64} " + tmp_rng + ", i64 " + args[1].name + ", 1")
        return s_rng
    if fn_name == "__mn_range_inclusive":
        let mut s_rngi: EmitState = st
        let inc: String = dn + ".inc"
        let tmp_rngi: String = dn + ".tmp"
        s_rngi = emit_line(s_rngi, "  " + inc + " = add i64 " + args[1].name + ", 1")
        s_rngi = emit_line(s_rngi, "  " + tmp_rngi + " = insertvalue {i64, i64} undef, i64 " + args[0].name + ", 0")
        s_rngi = emit_line(s_rngi, "  " + dn + " = insertvalue {i64, i64} " + tmp_rngi + ", i64 " + inc + ", 1")
        return s_rngi

    // Range field extraction (counter-based for-loops)
    if fn_name == "__mn_range_start":
        let mut s_rs: EmitState = st
        s_rs = emit_line(s_rs, "  " + dn + " = extractvalue {i64, i64} " + args[0].name + ", 0")
        return s_rs
    if fn_name == "__mn_range_end":
        let mut s_re: EmitState = st
        s_re = emit_line(s_re, "  " + dn + " = extractvalue {i64, i64} " + args[0].name + ", 1")
        return s_re

    // String builtins
    if fn_name == "split":
        let mut s_split: EmitState = st
        let as_split: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        s_split = emit_rt_call(s_split, dn, llvm_list_rt(), "__mn_str_split", as_split)
        return s_split
    if fn_name == "contains":
        let mut s_cont: EmitState = st
        let as_cont: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        s_cont = emit_rt_call(s_cont, dn, llvm_bool(), "__mn_str_contains", as_cont)
        return s_cont
    if fn_name == "replace":
        let mut s_repl: EmitState = st
        let as_repl: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name + ", " + llvm_string() + " " + args[2].name
        s_repl = emit_rt_call(s_repl, dn, llvm_string(), "__mn_str_replace", as_repl)
        return s_repl
    if fn_name == "byte_at":
        let mut s_ba: EmitState = st
        let as_ba: String = llvm_string() + " " + args[0].name + ", i64 " + args[1].name
        s_ba = emit_rt_call(s_ba, dn, llvm_int(), "__mn_str_byte_at", as_ba)
        return s_ba
    // join(sep, list) → String via C runtime. List passed by pointer.
    if fn_name == "join":
        let mut s_join: EmitState = st
        // Alloca the list and pass pointer (C runtime expects MnList*)
        let la: String = "%" + strip_percent(dn) + ".la"
        s_join = emit_line(s_join, "  " + la + " = alloca " + llvm_list_rt())
        s_join = emit_line(s_join, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + la)
        let as_join: String = llvm_string() + " " + args[0].name + ", ptr " + la
        s_join = emit_rt_call(s_join, dn, llvm_string(), "__mn_str_join", as_join)
        return s_join

    // List push: extract to helper to avoid return-inside-if bug
    if fn_name == "push":
        return emit_list_push_call(st, dest, args)

    // Synthetic struct constructor: __new_<StructName>(field_values...)
    // Use replace to remove the "__new_" prefix instead of substr
    // (substr has off-by-one issues in the compiled binary)
    if fn_name.contains("__new_"):
        let struct_name: String = fn_name.replace("__new_", "")
        let struct_ty: MIRType = mir_struct(struct_name)
        return emit_struct_init_from_values(st, dest, struct_ty, args)

    // Resolve operands for all other calls
    let mut s: EmitState = st

    // String methods: dispatched to __mn_str_<method> runtime functions
    if len(args) >= 1:
        let first_arg: Value = args[0]
        if first_arg.ty.kind == TK_STRING():
            let s0: String = first_arg.name
            if fn_name == "contains":
                s = emit_rt_call(s, dn, llvm_bool(), "__mn_str_contains", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "starts_with":
                s = emit_rt_call(s, dn, llvm_bool(), "__mn_str_starts_with", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "ends_with":
                s = emit_rt_call(s, dn, llvm_bool(), "__mn_str_ends_with", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "find":
                s = emit_rt_call(s, dn, llvm_int(), "__mn_str_find", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "char_at":
                s = emit_rt_call(s, dn, llvm_string(), "__mn_str_char_at", llvm_string() + " " + s0 + ", i64 " + args[1].name)
                return s
            if fn_name == "substr":
                if len(args) >= 3:
                    s = emit_rt_call(s, dn, llvm_string(), "__mn_str_substr", llvm_string() + " " + s0 + ", i64 " + args[1].name + ", i64 " + args[2].name)
                    return s
            if fn_name == "to_upper":
                s = emit_rt_call(s, dn, llvm_string(), "__mn_str_to_upper", llvm_string() + " " + s0)
                return s
            if fn_name == "to_lower":
                s = emit_rt_call(s, dn, llvm_string(), "__mn_str_to_lower", llvm_string() + " " + s0)
                return s
            if fn_name == "replace":
                if len(args) >= 3:
                    s = emit_rt_call(s, dn, llvm_string(), "__mn_str_replace", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name + ", " + llvm_string() + " " + args[2].name)
                    return s

    // Look up registered function parameter types (more reliable than MIR)
    let fn_opt_pre: Option<FnEntry> = find_function(s, fn_name)
    let mut reg_param_types: List<String> = []
    match fn_opt_pre:
        Some(fe) => { reg_param_types = fe.param_types }
        _ => {}

    // Build args with byref: large struct args → alloca + pass pointer
    let mut args_str: String = ""
    let mut j: Int = 0
    let nargs: Int = len(args)
    for _ in 0..500:
        if j < nargs:
            let mut aty: String = resolve_mir_type(args[j].ty)
            let mut an: String = args[j].name
            // Use registered param type when available.
            // Enum reinterpret: alloca+store+load for layout-compatible enums.
            // NEVER set an=zeroinitializer (that was the bug causing empty args).
            if j < len(reg_param_types):
                let rpt: String = reg_param_types[j]
                if rpt != aty && rpt != "i64":
                    // Enum type mismatch: reinterpret through memory
                    if aty.starts_with("%enum.") && rpt.starts_with("%enum.") && aty != rpt:
                        let rc_a: String = "%ecast" + toString(s.counter)
                        s.counter = s.counter + 1
                        s = emit_line(s, "  " + rc_a + " = alloca " + rpt)
                        s = emit_line(s, "  store " + aty + " " + an + ", ptr " + rc_a)
                        let rc_ld: String = "%ecast_ld" + toString(s.counter)
                        s.counter = s.counter + 1
                        s = emit_line(s, "  " + rc_ld + " = load " + rpt + ", ptr " + rc_a)
                        an = rc_ld
                    aty = rpt
            // Byref: large struct args → store to alloca, pass pointer
            let mut pass_ty: String = aty
            let mut pass_name: String = an
            if is_byref_type_st(s, aty):
                let ba: String = "%barg" + toString(s.counter)
                s.counter = s.counter + 1
                s = emit_line(s, "  " + ba + " = alloca " + aty)
                s = emit_line(s, "  store " + aty + " " + an + ", ptr " + ba)
                pass_ty = "ptr"
                pass_name = ba
            if j > 0:
                args_str = args_str + ", " + pass_ty + " " + pass_name
            else:
                args_str = pass_ty + " " + pass_name
            j = j + 1

    // Look up return type and handle sret for large struct returns
    let fn_opt: Option<FnEntry> = find_function(s, fn_name)
    match fn_opt {
        Some(fe) => {
            if fe.ret_type == "void" {
                return emit_line(s, emit_call_void(fn_name, args_str))
            }
            // v5.0.4 Cb.15: sret via per-target ABI classifier
            if use_sret_return(s, fe.ret_type) {
                let sret_a: String = "%sret" + toString(s.counter)
                s.counter = s.counter + 1
                s = emit_line(s, "  " + sret_a + " = alloca " + fe.ret_type)
                s = emit_line(s, "  store " + fe.ret_type + " zeroinitializer, ptr " + sret_a)
                let sret_arg: String = "ptr sret(" + fe.ret_type + ") " + sret_a
                let mut full_args: String = sret_arg
                if len(args_str) > 0 { full_args = sret_arg + ", " + args_str }
                s = emit_line(s, "  call void @" + fn_name + "(" + full_args + ")")
                s = emit_line(s, "  " + dn + " = load " + fe.ret_type + ", ptr " + sret_a)
                return s
            }
            s = emit_line(s, emit_call_ir(dn, fe.ret_type, fn_name, args_str))
            // v5.6.4 Rt.06 — attach tensor drop-glue tracking for the
            // 20 tensor binop runtime fns (broadcast / scalar / rscalar).
            // The non-Some arm (below) mirrors this injection for fns
            // not present in st.functions.
            if is_tensor_allocating_fn(fn_name) {
                s = emit_track_tensor(s, dn)
            }
            return s
        },
        _ => {
            let ret_ty: String = resolve_mir_type(dest.ty)
            if ret_ty == "void" {
                return emit_line(s, emit_call_void(fn_name, args_str))
            }
            // v5.0.4 Cb.15: sret via per-target ABI classifier
            if use_sret_return(s, ret_ty) {
                let sret_b: String = "%sret" + toString(s.counter)
                s.counter = s.counter + 1
                s = emit_line(s, "  " + sret_b + " = alloca " + ret_ty)
                s = emit_line(s, "  store " + ret_ty + " zeroinitializer, ptr " + sret_b)
                let sret_arg_b: String = "ptr sret(" + ret_ty + ") " + sret_b
                let mut full_args_b: String = sret_arg_b
                if len(args_str) > 0 { full_args_b = sret_arg_b + ", " + args_str }
                s = emit_line(s, "  call void @" + fn_name + "(" + full_args_b + ")")
                s = emit_line(s, "  " + dn + " = load " + ret_ty + ", ptr " + sret_b)
                return s
            }
            s = emit_line(s, emit_call_ir(dn, ret_ty, fn_name, args_str))
            // v5.6.4 Rt.06 — tensor tracking for non-FnEntry-registered calls.
            if is_tensor_allocating_fn(fn_name) {
                s = emit_track_tensor(s, dn)
            }
            return s
        }
    }

// ---------------------------------------------------------------------------
// Built-in function emission
// ---------------------------------------------------------------------------

fn emit_builtin_print(st: EmitState, args: List<Value>) -> EmitState:
    // print() in Mapanare adds a newline (like Python's print)
    if len(args) == 0:
        return emit_rt_call_void(st, "printf", "ptr @.newline")
    let arg: Value = args[0]
    let mut s: EmitState = st
    let an: String = arg.name

    if arg.ty.kind == TK_STRING():
        return emit_rt_call_void(s, "__mn_str_println", llvm_string() + " " + an)
    if arg.ty.kind == TK_FLOAT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_float_nl, double " + an + ")")
    if arg.ty.kind == TK_INT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")
    if arg.ty.kind == TK_BOOL():
        let cnt_b: String = str(s.counter)
        s.counter = s.counter + 1
        let bext: String = "%bext" + cnt_b
        s = emit_line(s, "  " + bext + " = zext i1 " + an + " to i64")
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + bext + ")")
    // Unknown type: default to integer (impl methods return i64)
    return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")

fn emit_builtin_println(st: EmitState, args: List<Value>) -> EmitState:
    if len(args) == 0:
        return emit_rt_call_void(st, "printf", "ptr @.newline")
    let arg: Value = args[0]
    let mut s: EmitState = st
    let an: String = arg.name

    if arg.ty.kind == TK_STRING():
        return emit_rt_call_void(s, "__mn_str_println", llvm_string() + " " + an)
    if arg.ty.kind == TK_FLOAT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_float_nl, double " + an + ")")
    if arg.ty.kind == TK_INT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")
    if arg.ty.kind == TK_BOOL():
        let cnt_bp: String = str(s.counter)
        s.counter = s.counter + 1
        let bextp: String = "%bext" + cnt_bp
        s = emit_line(s, "  " + bextp + " = zext i1 " + an + " to i64")
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + bextp + ")")
    // Unknown type: default to integer (impl methods return i64)
    return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")

fn emit_builtin_len(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0 { return st }
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_STRING():
        s = emit_rt_call(s, dn, llvm_int(), "__mn_str_len", llvm_string() + " " + an)
    else:
        if args[0].ty.kind == TK_MAP():
            // v5.15.1 — `len(map)` dispatch. Pre-existing gap surfaced
            // by the v5.15.0 map-comprehension test. The bootstrap maps
            // a Map value as `{ptr, i64}` where ``.0`` is the runtime
            // ``MnMap*``. ``__mn_map_len`` takes that pointer directly,
            // so extract field 0 and pass it.
            let tmp_mptr: String = dn + ".mp"
            let mt: String = llvm_map_type()
            s = emit_line(s, "  " + tmp_mptr + " = extractvalue " + mt + " " + an + ", 0")
            s = emit_rt_call(s, dn, llvm_int(), "__mn_map_len", "ptr " + tmp_mptr)
        else:
            // __mn_list_len expects a pointer; alloca+store the list value first
            let tmp: String = dn + ".lp"
            let lt: String = llvm_list_rt()
            s = emit_line(s, "  " + tmp + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + an + ", " + "ptr " + tmp)
            s = emit_rt_call(s, dn, llvm_int(), "__mn_list_len", "ptr " + tmp)
    return s

fn emit_builtin_tostring(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0 { return st }
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_STRING():
        return emit_copy(s, dest, args[0])
    if args[0].ty.kind == TK_BOOL():
        let cnt_zb: String = toString(s.counter)
        s.counter = s.counter + 1
        let zext_b: String = "%zb" + cnt_zb
        s = emit_line(s, "  " + zext_b + " = zext i1 " + an + " to i64")
        s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_bool", "i64 " + zext_b)
    else:
        if args[0].ty.kind == TK_FLOAT():
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_float", "double " + an)
        else:
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_int", "i64 " + an)
    return s

fn emit_builtin_int(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0 { return st }
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_FLOAT():
        s = emit_line(s, "  " + dn + " = fptosi double " + an + " to i64")
    else:
        if args[0].ty.kind == TK_INT():
            return emit_copy(s, dest, args[0])
        else:
            s = emit_rt_call(s, dn, llvm_int(), "__mn_str_to_int", llvm_string() + " " + an)
    return s

fn emit_builtin_float(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0 { return st }
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_INT():
        s = emit_line(s, "  " + dn + " = sitofp i64 " + an + " to double")
    else:
        if args[0].ty.kind == TK_FLOAT():
            return emit_copy(s, dest, args[0])
        else:
            s = emit_rt_call(s, dn, llvm_float(), "__mn_str_to_float", llvm_string() + " " + an)
    return s

// ---------------------------------------------------------------------------
// Return instruction
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// v5.4.0 Own.1 Phase 2 — Drop-glue emission
// ---------------------------------------------------------------------------
// Mirrors the Python _emit_drop_glue family (emit_llvm_text.py:1585+).
// Four per-resource helpers are called from emit_drop_glue, which is invoked
// by emit_mir_return before each `ret` instruction.  The helpers iterate
// st.str_owned / list_owned / boxed_owned, skip any local in st.moved_locals
// or whose name aliases the returned value, and emit the runtime free call.
//
// Phase 3 scope (this release): helpers are callable and correct when the
// owner lists are populated; tracker population (pushing names to
// str_owned / list_owned / boxed_owned when resource-bearing locals are
// emitted) is deferred to v5.4.1+.  With the lists empty, every helper is a
// no-op loop — stage2.ll is byte-identical except for the version placeholder
// and the lowerer-side Move markers from Phase 4.
//
// Simplifications vs Python:
//   - No multi-block null-check branch — __mn_str_free / __mn_list_free
//     already handle null data at the runtime layer.
//   - No ret-ptr alias detection — a local whose name matches ret_val_base
//     is skipped directly.  (Python builds ret_str_ptrs / ret_list_ptrs /
//     ret_ptr_fields so aliases through struct return values can also skip;
//     when tracker population lands in v5.4.1 we will revisit.)

fn list_has_string(lst: List<String>, name: String) -> Bool:
    let n: Int = len(lst)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n { return false }
        if lst[i] == name { return true }
        i = i + 1
    return false

fn ret_val_base(ret_val: String) -> String:
    // Strip a leading '%' so we can compare against the local name stored
    // in st.str_owned / list_owned / boxed_owned.  For non-local returns
    // (constants, SSA temps without a named local) this yields a string
    // that cannot match a local name anyway.
    if len(ret_val) == 0 { return "" }
    if ret_val.substr(0, 1) == "%" { return ret_val.substr(1, len(ret_val) - 1) }
    return ret_val

// ---------------------------------------------------------------------------
// v5.4.2 Phase 3.1 — String-returning builtin recognition
// ---------------------------------------------------------------------------
// Phase 3.2's hook (emit_mir_by_kind "call" branch) predicates tracking
// on `dest.ty.kind == TK_STRING()`, but the lowerer's generic call path
// at lower.mn:2258 defaults to mir_unknown() when __ret__fn_name isn't
// registered in lambda_vars — which is the case for all builtins not
// specially cased in lower_call_by_name (read_file, sha256, regex_replace,
// http_get, and friends). The IR is emitted with the correct llvm_string()
// return type because emit_mir_call dispatches by fn_name, but the MIR
// dest is typed TK_UNKNOWN, so Phase 3.2 skips tracking and the heap
// String leaks at function exit.
//
// This helper returns true for the Mapanare-level builtin names whose
// return type is String per mapanare/self/semantic.mn::builtin_return_type.
// It intentionally omits `str` / `toString` / `chr` / `__mn_argv` etc.
// because those ARE explicitly typed in lower_call_by_name and Phase 3.2
// picks them up directly.

fn is_string_returning_builtin(fn_name: String) -> Bool:
    if fn_name == "read_line" { return true }
    if fn_name == "read_file" { return true }
    if fn_name == "http_get" { return true }
    if fn_name == "sha256" { return true }
    if fn_name == "base64_encode" { return true }
    if fn_name == "base64_decode" { return true }
    if fn_name == "hmac_sha256" { return true }
    if fn_name == "hex_encode" { return true }
    if fn_name == "random_bytes" { return true }
    if fn_name == "regex_replace" { return true }
    if fn_name == "gpu_device_name" { return true }
    if fn_name == "join" { return true }
    if fn_name == "typeof" { return true }
    // v5.23.1 Mb.1: V.9 lifecycle leak — defensive belt-and-suspenders.
    // lower.mn already types the dest as mir_string() so the kind-based
    // branch at line 1650 catches it, but list this name explicitly so
    // any future refactor that loses the mir_string() hint still tracks.
    if fn_name == "__mn_indent_to_braces" { return true }
    return false

// ---------------------------------------------------------------------------
// v5.4.1 Phase 2 — shadow-slot tracking helpers
// ---------------------------------------------------------------------------
// Mirrors mapanare/emit_llvm_text.py::_track_string / _track_boxed /
// _track_closure (lines 1538–1566). Each helper allocates a tracking
// slot in the entry-block prelude (alloca + zero-init), stores the
// passed value into the slot at the current emission point, and
// records the slot's bare name in st.str_owned / st.boxed_owned for
// emit_drop_glue to consult before every ret.
//
// Reassignment to the same source variable is captured by allocating
// a fresh slot per call — the prior snapshot still lives in its own
// slot, so drop-glue frees both. __mn_str_free / @free tolerate null,
// so the zero-init is safe even when the slot is never stored to.

fn emit_track_string(st: EmitState, val_name: String) -> EmitState:
    let mut s: EmitState = st
    let idx: Int = s.counter
    s.counter = s.counter + 1
    let slot_base: String = "str_track." + toString(idx)
    let slot: String = "%" + slot_base
    // Entry-block prelude: alloca + zero-init.
    s.entry_prelude_lines.push("  " + slot + " = alloca {ptr, i64}, align 8")
    s.entry_prelude_lines.push("  store {ptr, i64} zeroinitializer, ptr " + slot)
    // v5.4.3 — Rt.03 fix: inside a loop body, free the slot's prior
    // contents before overwriting. Zero-init + __mn_str_free null-
    // tolerant: first iteration no-ops. Outside loops, unchanged.
    if s.loop_depth > 0:
        let prev_tmp: String = "%prev.str." + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + prev_tmp + " = load {ptr, i64}, ptr " + slot)
        s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + prev_tmp + ")")
    // Current emission point: snapshot the value into the slot.
    s = emit_line(s, "  store {ptr, i64} " + val_name + ", ptr " + slot)
    s.str_owned.push(slot_base)
    // v5.4.4 — record the SSA source name in parallel so drop glue
    // can consult moved_locals when the lowerer emits Move(val_name).
    s.str_owned_source.push(ret_val_base(val_name))
    return s

fn emit_track_boxed(st: EmitState, ptr_val: String) -> EmitState:
    let mut s: EmitState = st
    let idx: Int = s.counter
    s.counter = s.counter + 1
    let slot_base: String = "box_track." + toString(idx)
    let slot: String = "%" + slot_base
    s.entry_prelude_lines.push("  " + slot + " = alloca ptr, align 8")
    s.entry_prelude_lines.push("  store ptr null, ptr " + slot)
    // v5.4.3 — free-before-store in loop bodies. @free tolerates null.
    if s.loop_depth > 0:
        let prev_tmp: String = "%prev.box." + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + prev_tmp + " = load ptr, ptr " + slot)
        s = emit_line(s, "  call void @free(ptr " + prev_tmp + ")")
    s = emit_line(s, "  store ptr " + ptr_val + ", ptr " + slot)
    s.boxed_owned.push(slot_base)
    // v5.4.4 — record the boxed source SSA name for moved_locals match.
    s.boxed_owned_source.push(ret_val_base(ptr_val))
    return s

fn emit_track_closure(st: EmitState, val_name: String) -> EmitState:
    // Closure values are {ptr, ptr} (fn_ptr, env_ptr). We track the
    // env_ptr only — the fn_ptr is a code pointer that never needs
    // freeing. Extract idx=1 then route through the boxed-slot path so
    // the existing free(ptr) drop-glue handler picks it up.
    let mut s: EmitState = st
    let env_idx: Int = s.counter
    s.counter = s.counter + 1
    let env_tmp: String = "%clos.env." + toString(env_idx)
    s = emit_line(s, "  " + env_tmp + " = extractvalue {ptr, ptr} " + val_name + ", 1")
    emit_track_boxed(s, env_tmp)

// v5.6.4 Own.1 Phase 3 — Rt.06 tensor tracking.
// Mirrors emit_track_boxed structurally — tensor values are a single
// ptr (from __mn_tensor_alloc / _slice / broadcast / scalar / rscalar
// fns). Free function is __mn_tensor_free (void, null-tolerant per
// runtime/native/mapanare_runtime.c::mapanare_tensor_free).
//
// The loop-depth branch is load-bearing for 53_linear_regression:
// 10 epochs × ~4 fresh tensors per iter via `X * w + b`, `pred - y`,
// `error * X` — without intra-loop free-before-store, 40 tensors
// leak even with drop-glue at return. With it, each iteration's
// 4 live slots collapse via overwrite.
fn emit_track_tensor(st: EmitState, ptr_val: String) -> EmitState:
    let mut s: EmitState = st
    let idx: Int = s.counter
    s.counter = s.counter + 1
    let slot_base: String = "tens_track." + toString(idx)
    let slot: String = "%" + slot_base
    s.entry_prelude_lines.push("  " + slot + " = alloca ptr, align 8")
    s.entry_prelude_lines.push("  store ptr null, ptr " + slot)
    if s.loop_depth > 0:
        let prev_tmp: String = "%prev.tens." + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + prev_tmp + " = load ptr, ptr " + slot)
        s = emit_line(s, "  call void @__mn_tensor_free(ptr " + prev_tmp + ")")
    s = emit_line(s, "  store ptr " + ptr_val + ", ptr " + slot)
    s.tensor_owned.push(slot_base)
    s.tensor_owned_source.push(ret_val_base(ptr_val))
    return s

// v5.6.4 — predicate for runtime fns that return a freshly-allocated
// tensor `ptr` (i.e. every call site that needs emit_track_tensor).
// Used by the generic call path in emit_mir_call to attach tracking
// without duplicating the 20 tensor-binop emission branches. Must
// stay in sync with the explicit injection sites (emit_tensor_init
// and the __mn_tensor_slice special case): every fn listed here is
// tracked, every tracked call site is for a fn in this list.
fn is_tensor_allocating_fn(fn_name: String) -> Bool:
    if fn_name == "__mn_tensor_alloc" { return true }
    if fn_name == "__mn_tensor_slice" { return true }
    if fn_name == "__mn_tensor_reshape" { return true }
    // v5.45.0 Ts.2.B + Ts.3.B — view returns a refcount-aliased view
    // (still tracked: drop-glue must call __mn_tensor_free which is
    // refcount-aware as of Ts.2.A). step_slice returns a fresh
    // contiguous tensor (copy semantics).
    if fn_name == "__mn_tensor_view" { return true }
    if fn_name == "__mn_tensor_step_slice" { return true }
    if fn_name == "__mn_tensor_add_broadcast_f64" { return true }
    if fn_name == "__mn_tensor_sub_broadcast_f64" { return true }
    if fn_name == "__mn_tensor_mul_broadcast_f64" { return true }
    if fn_name == "__mn_tensor_div_broadcast_f64" { return true }
    if fn_name == "__mn_tensor_add_broadcast_i64" { return true }
    if fn_name == "__mn_tensor_sub_broadcast_i64" { return true }
    if fn_name == "__mn_tensor_mul_broadcast_i64" { return true }
    if fn_name == "__mn_tensor_div_broadcast_i64" { return true }
    if fn_name == "__mn_tensor_add_scalar_f64" { return true }
    if fn_name == "__mn_tensor_sub_scalar_f64" { return true }
    if fn_name == "__mn_tensor_mul_scalar_f64" { return true }
    if fn_name == "__mn_tensor_div_scalar_f64" { return true }
    if fn_name == "__mn_tensor_add_scalar_i64" { return true }
    if fn_name == "__mn_tensor_sub_scalar_i64" { return true }
    if fn_name == "__mn_tensor_mul_scalar_i64" { return true }
    if fn_name == "__mn_tensor_div_scalar_i64" { return true }
    if fn_name == "__mn_tensor_rsub_scalar_f64" { return true }
    if fn_name == "__mn_tensor_rdiv_scalar_f64" { return true }
    if fn_name == "__mn_tensor_rsub_scalar_i64" { return true }
    if fn_name == "__mn_tensor_rdiv_scalar_i64" { return true }
    return false

// ---------------------------------------------------------------------------
// v5.4.1 Phase 4 — return-escape detection
// ---------------------------------------------------------------------------
// emit_drop_glue_strings / _lists / _boxed each take a "ret_data_ptr"
// SSA name. When non-empty, the helper emits a per-slot icmp + br
// pattern that skips the free if the slot's loaded data pointer
// aliases the returned pointer. When empty (void return, scalar
// non-resource return, or aggregate return with conservative skip),
// the slot is freed unconditionally.
//
// Mirrors mapanare/emit_llvm_text.py::_emit_drop_glue_strings/_lists/
// _boxed (lines 1712–1849), with one structural simplification:
// branches inline into the same function body (Mapanare's emitter
// already uses inline label emission for bounds-check traps; same
// pattern applies here).

// v5.4.4 — Drop-glue OR-reduction helper.
// Emits: store i1 false to an entry-prelude alloca; per ret-ptr icmp +
// load acc + or + store; final load; br to skip_lbl/free_lbl.
// Extracted from the per-resource drop-glue helpers so the inner while
// loop is a top-level call rather than a deeply nested for-in-if inside
// the outer slot-iteration loop. The bootstrap emitter truncates output
// on the previous deep-nest pattern (observed at slot 25867 of
// emit_mir_call in stage2.ll); a top-level-call factoring avoids it.
fn emit_or_reduce_ret_match(st: EmitState, slot_ptr: String, ret_ptrs: List<String>, cnt: Int, prefix: String, skip_lbl: String, free_lbl: String) -> EmitState:
    let mut s: EmitState = st
    let nret: Int = len(ret_ptrs)
    let acc: String = "%drop." + prefix + "macc." + toString(cnt)
    s.entry_prelude_lines.push("  " + acc + " = alloca i1, align 1")
    s = emit_line(s, "  store i1 false, ptr " + acc)
    let mut ri: Int = 0
    while ri < nret:
        let rp: String = ret_ptrs[ri]
        let same: String = "%drop." + prefix + "same." + toString(cnt) + "." + toString(ri)
        let cur: String = "%drop." + prefix + "cur." + toString(cnt) + "." + toString(ri)
        let comb: String = "%drop." + prefix + "comb." + toString(cnt) + "." + toString(ri)
        s = emit_line(s, "  " + same + " = icmp eq ptr " + slot_ptr + ", " + rp)
        s = emit_line(s, "  " + cur + " = load i1, ptr " + acc)
        s = emit_line(s, "  " + comb + " = or i1 " + cur + ", " + same)
        s = emit_line(s, "  store i1 " + comb + ", ptr " + acc)
        ri = ri + 1
    let final_match: String = "%drop." + prefix + "final." + toString(cnt)
    s = emit_line(s, "  " + final_match + " = load i1, ptr " + acc)
    s = emit_line(s, "  br i1 " + final_match + ", label %" + skip_lbl + ", label %" + free_lbl)
    return s

fn emit_drop_glue_strings(st: EmitState, ret_str_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.str_owned)
    let ns: Int = len(s.str_owned_source)
    let nret: Int = len(ret_str_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n { return s }
        let name: String = s.str_owned[i]
        // v5.4.4 — consult str_owned_source[i] instead of the slot name.
        let mut source: String = ""
        if i < ns { source = s.str_owned_source[i] }
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let svtmp: String = "%drop.s" + toString(cnt)
            s = emit_line(s, "  " + svtmp + " = load {ptr, i64}, ptr %" + name)
            if nret > 0:
                let sptmp: String = "%drop.p" + toString(cnt)
                s = emit_line(s, "  " + sptmp + " = extractvalue {ptr, i64} " + svtmp + ", 0")
                let skip_lbl: String = "drop.skip." + toString(cnt)
                let free_lbl: String = "drop.free." + toString(cnt)
                s = emit_or_reduce_ret_match(s, sptmp, ret_str_ptrs, cnt, "s", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + svtmp + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + svtmp + ")")
        i = i + 1
    return s

fn emit_drop_glue_lists(st: EmitState, ret_list_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.list_owned)
    let ns: Int = len(s.list_owned_source)
    let nret: Int = len(ret_list_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n { return s }
        let name: String = s.list_owned[i]
        let mut source: String = ""
        if i < ns { source = s.list_owned_source[i] }
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            if nret > 0:
                let cnt: Int = s.counter
                s.counter = s.counter + 1
                let lvtmp: String = "%drop.lv" + toString(cnt)
                let lptmp: String = "%drop.lp" + toString(cnt)
                let free_lbl: String = "drop.lfree." + toString(cnt)
                let skip_lbl: String = "drop.lskip." + toString(cnt)
                s = emit_line(s, "  " + lvtmp + " = load " + llvm_list_rt() + ", ptr %" + name)
                s = emit_line(s, "  " + lptmp + " = extractvalue " + llvm_list_rt() + " " + lvtmp + ", 0")
                s = emit_or_reduce_ret_match(s, lptmp, ret_list_ptrs, cnt, "l", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @__mn_list_free(ptr %" + name + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @__mn_list_free(ptr %" + name + ")")
        i = i + 1
    return s

fn emit_drop_glue_boxed(st: EmitState, ret_box_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.boxed_owned)
    let ns: Int = len(s.boxed_owned_source)
    let nret: Int = len(ret_box_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n { return s }
        let name: String = s.boxed_owned[i]
        let mut source: String = ""
        if i < ns { source = s.boxed_owned_source[i] }
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let tmp: String = "%drop.b" + toString(cnt)
            s = emit_line(s, "  " + tmp + " = load ptr, ptr %" + name)
            if nret > 0:
                let free_lbl: String = "drop.bfree." + toString(cnt)
                let skip_lbl: String = "drop.bskip." + toString(cnt)
                s = emit_or_reduce_ret_match(s, tmp, ret_box_ptrs, cnt, "b", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @free(ptr " + tmp + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @free(ptr " + tmp + ")")
        i = i + 1
    return s

// v5.6.4 — tensor drop-glue (Rt.06).
//
// Mirrors emit_drop_glue_boxed: single `ptr` slot type, but calls
// __mn_tensor_free instead of @free. Runtime C guard at
// runtime/native/mapanare_gpu_builtins.c handles null (`if (!t) return`)
// — safe to call on the zero-initialised first-iter slot value.
//
// When ret_tensor_ptrs is non-empty, emit the same icmp-eq-or chain
// as the string / list / boxed helpers and short-circuit frees that
// alias the escaping return value. Over-approximates per PLAN §D4:
// the same ptr also lands in ret_box_ptrs, but each helper matches
// against its own slot list, so there is no double-free on the
// matching helper and no missed-free on the non-matching one
// (slots in the other list simply don't overlap).
fn emit_drop_glue_tensors(st: EmitState, ret_tensor_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.tensor_owned)
    let ns: Int = len(s.tensor_owned_source)
    let nret: Int = len(ret_tensor_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n { return s }
        let name: String = s.tensor_owned[i]
        let mut source: String = ""
        if i < ns { source = s.tensor_owned_source[i] }
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let tvtmp: String = "%drop.tv" + toString(cnt)
            s = emit_line(s, "  " + tvtmp + " = load ptr, ptr %" + name)
            if nret > 0:
                let free_lbl: String = "drop.tfree." + toString(cnt)
                let skip_lbl: String = "drop.tskip." + toString(cnt)
                s = emit_or_reduce_ret_match(s, tvtmp, ret_tensor_ptrs, cnt, "t", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @__mn_tensor_free(ptr " + tvtmp + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @__mn_tensor_free(ptr " + tvtmp + ")")
        i = i + 1
    return s

// v5.5.7 — destroy-path drop-glue for coroutines.
//
// Called from coro.cleanup before `coro.free` when the scheduler
// destroys an async fn frame at a suspend point. Iterates the
// usual owner lists unconditionally (no ret_val filter — there is
// no return value on this path) but still consults moved_locals so
// owners that were moved/consumed pre-suspend don't get
// double-freed.
//
// Tracking-slot allocas live in the entry-block prelude (v5.4.1)
// and are zero-initialised before any user instruction, so loads
// from them at coro.cleanup are well-defined even if the slot was
// never written. The runtime free helpers (__mn_str_free,
// __mn_list_free, free) are null-tolerant per v5.4.1 design, so
// loading a never-written slot just no-ops.
//
// SSA-name prefix is `%drop.d.*.N` (`d` = destroy) so it cannot
// collide with the `%drop.s|l|b.N` names produced by the normal-
// exit drop-glue helpers above.
fn emit_drop_glue_destroy(st: EmitState) -> EmitState:
    let mut s: EmitState = st
    // Strings
    let ns: Int = len(s.str_owned)
    let nss: Int = len(s.str_owned_source)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= ns { break }
        let name: String = s.str_owned[i]
        let mut source: String = ""
        if i < nss { source = s.str_owned_source[i] }
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let svtmp: String = "%drop.d.s" + toString(cnt)
            s = emit_line(s, "  " + svtmp + " = load {ptr, i64}, ptr %" + name)
            s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + svtmp + ")")
        i = i + 1
    // Lists
    let nl: Int = len(s.list_owned)
    let mut j: Int = 0
    for _ in 0..1024:
        if j >= nl { break }
        let lname: String = s.list_owned[j]
        let mut lsource: String = ""
        if j < len(s.list_owned_source) { lsource = s.list_owned_source[j] }
        let l_is_moved: Bool = (len(lsource) > 0) && list_has_string(s.moved_locals, lsource)
        if !l_is_moved:
            s = emit_line(s, "  call void @__mn_list_free(ptr %" + lname + ")")
        j = j + 1
    // Boxed
    let nb: Int = len(s.boxed_owned)
    let mut k: Int = 0
    for _ in 0..1024:
        if k >= nb { break }
        let bname: String = s.boxed_owned[k]
        let mut bsource: String = ""
        if k < len(s.boxed_owned_source) { bsource = s.boxed_owned_source[k] }
        let b_is_moved: Bool = (len(bsource) > 0) && list_has_string(s.moved_locals, bsource)
        if !b_is_moved:
            let cnt2: Int = s.counter
            s.counter = s.counter + 1
            let btmp: String = "%drop.d.b" + toString(cnt2)
            s = emit_line(s, "  " + btmp + " = load ptr, ptr %" + bname)
            s = emit_line(s, "  call void @free(ptr " + btmp + ")")
        k = k + 1
    // Tensors (v5.6.4 Rt.06). Parallel to the three loops above;
    // __mn_tensor_free is null-tolerant so loading a never-written
    // slot is a no-op.
    let nt: Int = len(s.tensor_owned)
    let mut m: Int = 0
    for _ in 0..1024:
        if m >= nt { break }
        let tname: String = s.tensor_owned[m]
        let mut tsource: String = ""
        if m < len(s.tensor_owned_source) { tsource = s.tensor_owned_source[m] }
        let t_is_moved: Bool = (len(tsource) > 0) && list_has_string(s.moved_locals, tsource)
        if !t_is_moved:
            let cnt3: Int = s.counter
            s.counter = s.counter + 1
            let ttmp: String = "%drop.d.t" + toString(cnt3)
            s = emit_line(s, "  " + ttmp + " = load ptr, ptr %" + tname)
            s = emit_line(s, "  call void @__mn_tensor_free(ptr " + ttmp + ")")
        m = m + 1
    return s

fn ret_ty_is_aggregate(st: EmitState, ret_ty: String) -> Bool:
    // v5.6.6 RESCOPE — Rt.04 cannot be closed by a one-level walk.
    // Attempt: re-lift the `%struct.*` guard with a struct-size gate
    // (N≤4 fields, M≤10 slots) so the walk fires for small data
    // structs like 62_list_output's `St { lines: List<String>, n: Int }`.
    // The walk extracts `lines` as a list ret-ptr and `n` skips
    // (not a resource); String drop glue alias-checks against the
    // list ret-ptr — but the tracked String slots' data pointers
    // are the INDIVIDUAL STRINGS *inside* the list, not the list
    // itself. The single-level walk doesn't see them; drop glue
    // frees them; caller's `__mn_str_join` reads freed memory →
    // confirmed heap-use-after-free under ASan.
    //
    // This is a STRUCT-OF-LIST-OF-STRING shape (2 levels deep).
    // The PLAN's exit criterion #1 (62_list_output CLEAN) is
    // unreachable without a multi-level walk that the PLAN
    // itself excluded as "v5.7.x scope or v6.0 borrow checker".
    //
    // Decision: keep `%struct.*` returns conservatively skipped
    // (62_list_output stays LEAK 9 objs / 141 B, baseline-gated)
    // until the borrow checker or multi-level walk lands. The
    // walk infrastructure at `emit_drop_glue:4753+` remains in
    // place for the future fix; the gate parameters (st: EmitState
    // signature) are preserved for the same reason.
    //
    // What this release DOES contribute: the signature change
    // threads `st` through `ret_ty_is_aggregate` so future re-
    // lift attempts can size-gate without another invasive
    // refactor. The first such attempt landed and reverted in
    // v5.4.4; the second (v5.6.6) lands and reverts here.
    if ret_ty.starts_with("%struct.") { return true }
    if ret_ty.starts_with("%enum.") { return true }
    if ret_ty.starts_with("{") && ret_ty != llvm_string() && ret_ty != llvm_list_rt():
        return true
    return false

fn emit_drop_glue(st: EmitState, ret_val: String, ret_ty: String) -> EmitState:
    // Fast path: no owners means nothing to drop.
    if len(st.str_owned) == 0 && len(st.list_owned) == 0 && len(st.boxed_owned) == 0 && len(st.tensor_owned) == 0:
        return st

    // Conservative skip for enum / option / result / anonymous struct
    // returns; for `%struct.*` the v5.6.6 size gate inside
    // `ret_ty_is_aggregate` decides whether to walk one level of fields
    // (small struct in small-slot fn) or skip (large struct or hot fn).
    if ret_ty_is_aggregate(st, ret_ty):
        return st

    // v5.6.9 Ve.3 — List return multi-level UAF: when the function returns
    // a list with ANY tracked owned resources (strings/lists/boxes), the
    // list elements may reference those resources THROUGH their fields,
    // not by the list's own data ptr. drop_glue_* alias-checks at one
    // level (against the list's data ptr); the inner refs are invisible.
    // Without multi-level alias analysis (v6.0 borrow-checker scope),
    // every drop fires unconditionally → UAF when caller dereferences
    // the returned list. Same RESCOPE pattern as v5.6.6 Rt.04 (List<String>
    // in returned struct).
    //
    // Closes Ve.3: `mir_opt::clone_instr_for_inline` returns
    // List<Instruction>. Each Instruction is `{i64 tag, ptr payload}` with
    // a heap-boxed payload tracked in `boxed_owned`. drop_glue_boxed at
    // function exit freed every payload, leaving dangling ptrs in the
    // returned list. emit_alloca later dereferenced those dangling ptrs
    // and read garbage Value names → __mn_str_concat → OOM with garbage
    // size on `/tmp/p1.mn`; SIGSEGV on full `mnc_all.mn` self-compile
    // (same class, different memory layout).
    //
    // Cost: intermediate strings/lists/boxes NOT in the returned list
    // leak. Accepted per v5.6.6 RESCOPE — UAF prevention > leak prevention.
    if ret_ty == llvm_list_rt() && len(st.boxed_owned) > 0:
        return st

    let mut s: EmitState = st
    let mut ret_str_ptrs: List<String> = []
    let mut ret_list_ptrs: List<String> = []
    let mut ret_box_ptrs: List<String> = []
    // v5.6.4 Rt.06 — tensor escape list. Populated in parallel with
    // ret_box_ptrs for scalar ptr returns and %struct.* ptr fields
    // (see PLAN §D4 for why dual-push is safe).
    let mut ret_tensor_ptrs: List<String> = []

    // Scalar String return: extract the data ptr once.
    if ret_ty == llvm_string() && len(ret_val) > 0:
        let cnt: Int = s.counter
        s.counter = s.counter + 1
        let p: String = "%ret.sp" + toString(cnt)
        s = emit_line(s, "  " + p + " = extractvalue {ptr, i64} " + ret_val + ", 0")
        ret_str_ptrs.push(p)
    // Scalar List return.
    if ret_ty == llvm_list_rt() && len(ret_val) > 0:
        let cnt: Int = s.counter
        s.counter = s.counter + 1
        let p: String = "%ret.lp" + toString(cnt)
        s = emit_line(s, "  " + p + " = extractvalue " + llvm_list_rt() + " " + ret_val + ", 0")
        ret_list_ptrs.push(p)
    // Scalar ptr return — could be a boxed enum payload or a tensor.
    // Push to both lists; each per-resource helper alias-checks its
    // own slot list, so the non-matching list is a no-op.
    if ret_ty == "ptr" && len(ret_val) > 0:
        ret_box_ptrs.push(ret_val)
        ret_tensor_ptrs.push(ret_val)

    // v5.4.4 — %struct.* return: walk one level of fields and extract
    // every String / List / ptr field into the corresponding ret-ptr
    // list. Combined with lowerer Move emission, the drop-glue per-
    // resource helpers can skip tracked slots that alias an escaping
    // field while freeing unescaped intermediates.
    if ret_ty.starts_with("%struct.") && len(ret_val) > 0:
        let sname: String = ret_ty.substr(8, len(ret_ty) - 8)
        let sopt: Option<StructEntry> = find_struct_entry(s, sname)
        match sopt {
            Some(sent) => {
                let nf: Int = len(sent.field_types)
                let mut fi: Int = 0
                while fi < nf {
                    let ft: String = sent.field_types[fi]
                    if ft == llvm_string() {
                        let cnt: Int = s.counter
                        s.counter = s.counter + 1
                        let fval: String = "%ret.ssf" + toString(cnt)
                        let fp: String = "%ret.ssp" + toString(cnt)
                        s = emit_line(s, "  " + fval + " = extractvalue " + ret_ty + " " + ret_val + ", " + toString(fi))
                        s = emit_line(s, "  " + fp + " = extractvalue {ptr, i64} " + fval + ", 0")
                        ret_str_ptrs.push(fp)
                    } else if ft == llvm_list_rt() {
                        let cnt: Int = s.counter
                        s.counter = s.counter + 1
                        let fval: String = "%ret.slf" + toString(cnt)
                        let fp: String = "%ret.slp" + toString(cnt)
                        s = emit_line(s, "  " + fval + " = extractvalue " + ret_ty + " " + ret_val + ", " + toString(fi))
                        s = emit_line(s, "  " + fp + " = extractvalue " + llvm_list_rt() + " " + fval + ", 0")
                        ret_list_ptrs.push(fp)
                    } else if ft == "ptr" {
                        let cnt: Int = s.counter
                        s.counter = s.counter + 1
                        let fp: String = "%ret.sbp" + toString(cnt)
                        s = emit_line(s, "  " + fp + " = extractvalue " + ret_ty + " " + ret_val + ", " + toString(fi))
                        // v5.6.4 Rt.06 — ptr field could be a tensor
                        // inside a struct return; dual-push same SSA
                        // to both escape lists.
                        ret_box_ptrs.push(fp)
                        ret_tensor_ptrs.push(fp)
                    }
                    fi = fi + 1
                }
            },
            _ => {}
        }

    s = emit_drop_glue_strings(s, ret_str_ptrs)
    s = emit_drop_glue_lists(s, ret_list_ptrs)
    s = emit_drop_glue_boxed(s, ret_box_ptrs)
    s = emit_drop_glue_tensors(s, ret_tensor_ptrs)
    return s

fn emit_mir_return(st: EmitState, val_opt: Option<Value>) -> EmitState:
    match val_opt {
        Some(val) => {
            let ty: String = st.current_ret_type
            // v5.5.4 Sh.4 Phase 2 — async fn ret rewrite. The
            // current_ret_type was set to "ASYNC_PTR:" + inner_ty by
            // emit_mir_function when entering an async fn. Instead of
            // emitting `ret <ty> <val>`, we box the value, mark the
            // Future as Ready, store the box into the payload slot,
            // and branch to %coro.final (the shared epilogue block).
            // Mirrors emit_llvm_text.py:2613–2628.
            if ty.starts_with("ASYNC_PTR:") {
                let inner_ty: String = ty.substr(10, len(ty) - 10)
                let mut sa: EmitState = emit_drop_glue(st, val.name, inner_ty)
                let n: Int = sa.counter
                sa.counter = n + 1
                let box_name: String = "%ret.box." + toString(n)
                let slot_name: String = "%ret.val.slot." + toString(n)
                sa = emit_line(sa, "  " + box_name + " = call ptr @malloc(i64 8)")
                sa = emit_line(sa, "  store " + inner_ty + " " + val.name + ", ptr " + box_name)
                sa = emit_line(sa, "  store i8 1, ptr %future")
                sa = emit_line(sa, "  " + slot_name + " = getelementptr inbounds {i8, ptr}, ptr %future, i32 0, i32 1")
                sa = emit_line(sa, "  store ptr " + box_name + ", ptr " + slot_name)
                return emit_line(sa, "  br label %coro.final")
            }
            if ty == "void" {
                let mut sv: EmitState = emit_drop_glue(st, "", ty)
                return emit_line(sv, emit_ret_void())
            }
            // v5.0.4 Cb.15: sret via per-target ABI classifier
            if use_sret_return(st, ty) {
                let mut s0: EmitState = emit_drop_glue(st, val.name, ty)
                let mut s: EmitState = emit_line(s0, "  store " + ty + " " + val.name + ", ptr %__sret__")
                return emit_line(s, emit_ret_void())
            }
            // main() returns i32 but Mapanare Int is i64 — truncate
            if ty == "i32" {
                let mut s1: EmitState = emit_drop_glue(st, val.name, ty)
                let trunc_name: String = val.name + ".trunc"
                let mut s: EmitState = emit_line(s1, "  " + trunc_name + " = trunc i64 " + val.name + " to i32")
                return emit_line(s, emit_ret("i32", trunc_name))
            }
            // v5.5.6 Sh.4 Phase 3: async-aware main — prepend
            // `call void @__mn_coro_scheduler_destroy()` so worker
            // threads are joined and mutexes / overflow queue freed
            // before the C ABI-level `ret i32`. Parallel to the
            // "i32" branch above. Drop-glue fires first (already the
            // pattern); destroy is idempotent per v5.1.4 runtime.
            if ty == "i32_async" {
                let mut sa2: EmitState = emit_drop_glue(st, val.name, "i32")
                sa2 = emit_line(sa2, "  call void @__mn_coro_scheduler_destroy()")
                let trunc_name_a: String = val.name + ".trunc"
                let mut sa3: EmitState = emit_line(sa2, "  " + trunc_name_a + " = trunc i64 " + val.name + " to i32")
                return emit_line(sa3, emit_ret("i32", trunc_name_a))
            }
            let mut s2: EmitState = emit_drop_glue(st, val.name, ty)
            return emit_line(s2, emit_ret(ty, val.name))
        },
        _ => {
            // For non-void functions, emit zeroinitializer return (dead code from
            // match arms that all terminate). For void functions, emit ret void.
            let ret_ty: String = st.current_ret_type
            // v5.5.4 Sh.4 Phase 2 — async fn ret void rewrite.
            // No value to box; just mark the Future as Ready (null
            // payload) and branch to the epilogue.
            if ret_ty.starts_with("ASYNC_PTR:") {
                let mut svn: EmitState = emit_drop_glue(st, "", "void")
                svn = emit_line(svn, "  store i8 1, ptr %future")
                return emit_line(svn, "  br label %coro.final")
            }
            // v5.5.6 Sh.4 Phase 3: dead-code fallback for async-aware
            // main (mirror of the value-carrying path above). Every
            // main exit must hit scheduler_destroy before the i32 ret.
            if ret_ty == "i32_async" {
                let mut svna: EmitState = emit_drop_glue(st, "", "i32")
                svna = emit_line(svna, "  call void @__mn_coro_scheduler_destroy()")
                return emit_line(svna, "  ret i32 0")
            }
            let mut sv2: EmitState = emit_drop_glue(st, "", ret_ty)
            if ret_ty != "void" {
                return emit_line(sv2, "  ret " + ret_ty + " zeroinitializer")
            }
            return emit_line(sv2, emit_ret_void())
        }
    }

// ---------------------------------------------------------------------------
// Switch instruction
// ---------------------------------------------------------------------------

fn emit_mir_switch(st: EmitState, tag: Value, cases: List<SwitchCase>, default_bb: String) -> EmitState:
    let mut s: EmitState = emit_line(st, emit_switch_hdr(tag.name, default_bb))
    // Resolve the enum name from the tag value's type for variant index lookup
    let enum_name: String = tag.ty.name

    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(cases):
            s = emit_line(s, "  ]")
            return s
        let c: SwitchCase = cases[i]
        // If the case value is a variant name (not a number), resolve to integer index
        // This mirrors the Python emitter's _vtag() method
        let mut case_val: String = c.tag_value
        if len(case_val) > 0:
            let first_ch: Int = c.tag_value.byte_at(0)
            // If not a digit (0-9) and not '-', it's a variant name → resolve to index
            if first_ch < 48 || first_ch > 57:
                if first_ch != 45:
                    // Hardcoded indices for Result/Option builtins
                    if case_val == "Ok" || case_val == "Some":
                        case_val = "1"
                    else if case_val == "Err" || case_val == "None":
                        case_val = "0"
                    else:
                        case_val = toString(resolve_variant_index(s, enum_name, case_val))
        s = emit_line(s, emit_switch_case(case_val, c.block_label))
        i = i + 1
    s = emit_line(s, "  ]")
    return s

// ---------------------------------------------------------------------------
// Agent instructions
// ---------------------------------------------------------------------------

fn emit_agent_spawn(st: EmitState, dest: Value, ty: MIRType, args: List<Value>) -> EmitState:
    let dn: String = dest.name
    let mut s: EmitState = st
    // Call agent spawn runtime function
    s = emit_rt_call(s, dn, "ptr", "__mn_agent_spawn", "ptr null, ptr null")
    s

fn emit_agent_send(st: EmitState, ag: Value, channel: String, val: Value) -> EmitState = emit_rt_call_void(st, "__mn_agent_send", "ptr " + ag.name + ", ptr null, ptr null")

fn emit_agent_sync(st: EmitState, dest: Value, ag: Value, channel: String) -> EmitState:
    let dn: String = dest.name
    let s2: EmitState = emit_rt_call(st, dn, "ptr", "__mn_agent_sync", "ptr " + ag.name + ", ptr null")
    s2

// ---------------------------------------------------------------------------
// Signal instructions
// ---------------------------------------------------------------------------

fn emit_signal_init(st: EmitState, dest: Value, ty: MIRType, val: Value) -> EmitState:
    let dn: String = dest.name
    let s2: EmitState = emit_rt_call(st, dn, "ptr", "__mn_signal_new", "ptr null")
    s2

fn emit_signal_get(st: EmitState, dest: Value, sig: Value) -> EmitState:
    let dn: String = dest.name
    let s2: EmitState = emit_rt_call(st, dn, "ptr", "__mn_signal_get", "ptr " + sig.name)
    s2

fn emit_signal_set(st: EmitState, sig: Value, val: Value) -> EmitState = emit_rt_call_void(st, "__mn_signal_set", "ptr " + sig.name + ", ptr null")

// ---------------------------------------------------------------------------
// StreamOp instruction
// ---------------------------------------------------------------------------

fn emit_stream_op(st: EmitState, dest: Value, kind: StreamOpKind, source: Value, args: List<Value>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    // Stream operations are runtime-dispatched; minimal LLVM lowering
    let s2: EmitState = emit_line(s, "  " + dn + " = bitcast ptr " + source.name + " to ptr")
    s2

// ---------------------------------------------------------------------------
// InterpConcat instruction
// ---------------------------------------------------------------------------

fn emit_interp_concat(st: EmitState, dest: Value, parts: List<Value>) -> EmitState:
    if len(parts) == 0:
        return emit_const(st, dest, mir_string(), "")
    if len(parts) == 1:
        return emit_copy(st, dest, parts[0])

    // Concatenate parts left-to-right using __mn_str_concat. The final
    // concat writes into `dest.name` directly so downstream uses of
    // `dest` resolve to a defined SSA value (v5.16.0 Te.4.D — fix
    // for "use of undefined value" when the chain has >1 join).
    let mut s: EmitState = st
    let dn: String = dest.name

    let mut acc: String = parts[0].name

    let mut i: Int = 1
    let nparts: Int = len(parts)
    for _ in 0..500:
        if i < nparts:
            let is_last: Bool = (i == nparts - 1)
            let mut tmp: String = dn + ".c" + toString(i)
            if is_last { tmp = dn }
            s = emit_rt_call(s, tmp, llvm_string(), "__mn_str_concat", llvm_string() + " " + acc + ", " + llvm_string() + " " + parts[i].name)
            // v5.4.1 Phase 3.4 — each __mn_str_concat result is a fresh
            // heap allocation. Track each intermediate so drop-glue
            // frees them; escape detection (Phase 4) skips the final
            // when it leaves via the return value.
            s = emit_track_string(s, tmp)
            acc = tmp
            i = i + 1
    return s

// ---------------------------------------------------------------------------
// Phi instruction
// ---------------------------------------------------------------------------

fn emit_mir_phi(st: EmitState, dest: Value, incoming: List<PhiEntry>) -> EmitState:
    let mut ty: String = resolve_type(st, dest.ty)
    let dn: String = dest.name

    let mut s: EmitState = st
    let mut skip: Bool = false
    if len(incoming) == 0 { skip = true }
    if ty == "void" { skip = true }
    // For Phis with i64 type (unresolved or unknown): recover the actual type.
    // Step 1: check MIR types of incoming values.
    if ty == "i64" && len(incoming) > 0:
        let mut ci: Int = 0
        for _ in 0..100:
            if ci < len(incoming):
                let inc_ty: String = resolve_type(st, incoming[ci].val.ty)
                if inc_ty != "i64" && inc_ty != "void":
                    ty = inc_ty
                ci = ci + 1
    // Step 2: if still i64, scan backwards through CURRENT FUNCTION's emitted
    // lines (stop at "define" or "entry:") for the incoming value's phi definition.
    if ty == "i64" && len(incoming) > 0:
        let mut ci2: Int = 0
        for _ in 0..20:
            if ci2 < len(incoming) && ty == "i64":
                let vname: String = incoming[ci2].val.name
                if vname != "zeroinitializer" && len(vname) > 1:
                    let search: String = vname + " = phi "
                    let mut li: Int = len(s.lines) - 1
                    for _ in 0..5000:
                        if li >= 0 && ty == "i64":
                            let line: String = s.lines[li]
                            // Stop at function boundary
                            if line.starts_with("define ") { li = -1 }
                            if line.starts_with("}") { li = -1 }
                            if li >= 0 && line.contains(search):
                                let ppos: Int = line.find(search) + len(search)
                                let rest: String = line.substr(ppos, len(line) - ppos)
                                let bpos: Int = rest.find(" [")
                                if bpos > 0:
                                    let fty: String = rest.substr(0, bpos)
                                    if fty != "i64" && fty != "void" { ty = fty }
                            li = li - 1
                ci2 = ci2 + 1

    if !skip:
        let mut phi_str: String = "  " + dn + " = phi " + ty + " "
        let mut i: Int = 0
        let nincoming: Int = len(incoming)
        for _ in 0..500:
            if i < nincoming:
                let e: PhiEntry = incoming[i]
                if i > 0:
                    phi_str = phi_str + ", "
                phi_str = phi_str + "[ " + e.val.name + ", %" + e.block_label + " ]"
                i = i + 1
        s = emit_line(s, phi_str)
    return s

// ---------------------------------------------------------------------------
// MIR basic block emission
// ---------------------------------------------------------------------------

fn emit_mir_basic_block(st: EmitState, bb: BasicBlock) -> EmitState:
    let mut s: EmitState = emit_line(st, bb.label + ":")
    // v5.4.3 — enter loop body. Lowerer emits block labels with
    // "for_body" / "while_body" / "mapfor_body" prefixes; inside those
    // blocks, emit_track_string / _boxed / _closure free prior slot
    // contents before storing (the shadow slot otherwise leaks every
    // iteration after the first). Matched pop before returning.
    let mut bumped: Bool = false
    if bb.label.starts_with("for_body") || bb.label.starts_with("while_body") || bb.label.starts_with("mapfor_body"):
        s.loop_depth = s.loop_depth + 1
        bumped = true
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(bb.instructions):
            if bumped { s.loop_depth = s.loop_depth - 1 }
            return s
        let inst: Instruction = bb.instructions[i]
        s = emit_mir_instruction(s, inst)
        i = i + 1
    if bumped { s.loop_depth = s.loop_depth - 1 }
    return s

// ---------------------------------------------------------------------------
// MIR function emission
// ---------------------------------------------------------------------------

// v5.5.6 Sh.4 Phase 3 — does any function in the module carry the
// `async` decorator?  Gates main's scheduler_init / scheduler_destroy
// injection and (via caller) the scheduler-driven BlockOn pattern.
// Free helper to avoid a Reg.1 EmitState struct bump.
fn module_has_async(module: MIRModule) -> Bool:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(module.functions) { return false }
        if fn_is_async(module.functions[i]) { return true }
        i = i + 1
    return false

fn emit_mir_function(st: EmitState, f: MIRFunction, module: MIRModule) -> EmitState:
    // Resolve return type
    let mut ret_ty: String = resolve_mir_type(f.return_type)
    if ret_ty.starts_with("%struct."):
        let ret_name: String = f.return_type.name
        if is_enum_type(st, ret_name):
            ret_ty = "%enum." + ret_name

    // v5.5.4 Sh.4 Phase 2 — async fn detection. When true, the
    // emitter wraps the function body in a presplit-coroutine frame:
    // coro.entry prologue + initial suspend + rewrite each ret to
    // store-into-future.payload + br %coro.final + append coro.final
    // / coro.cleanup / coro.ret epilogue. ret_ty stays the ORIGINAL
    // declared type T (used for box allocation in emit_mir_return);
    // abi_ret below becomes "ptr" (the Future<T> handle).
    let is_async: Bool = fn_is_async(f)

    // v5.0.4 Cb.15: use per-target ABI classifier for return sret.
    // Argument passing still uses is_byref_type_st (64B threshold).
    // v5.5.4: async fns never use sret (always return ptr directly).
    let use_sret: Bool = use_sret_return(st, ret_ty) && f.name != "main" && !is_async

    // Build parameter list with byref adjustments
    let mut params_str: String = ""
    let mut param_types: List<String> = []
    // If sret, first param is the return pointer
    if use_sret:
        params_str = "ptr noalias sret(" + ret_ty + ") %__sret__"
    let mut pi: Int = 0
    let nfparams: Int = len(f.params)
    for _ in 0..500:
        if pi < nfparams:
            let p_sig: MIRParam = f.params[pi]
            let pty_sig: String = resolve_mir_type(p_sig.ty)
            param_types.push(pty_sig)
            let need_sep: Bool = pi > 0 || use_sret
            let mut sep: String = ""
            if need_sep { sep = ", " }
            if is_byref_type_st(st, pty_sig):
                // Large param: pass by pointer
                params_str = params_str + sep + "ptr %" + p_sig.name + ".byref"
            else:
                params_str = params_str + sep + pty_sig + " %" + p_sig.name
            pi = pi + 1

    // Register function (with original types for caller resolution).
    // v5.5.4 Sh.4 Phase 2: async fns register with ret_type="ptr" so
    // callers emit `call ptr @foo()` — matching the ABI that the
    // coroutine prologue actually returns (a Future<T> handle). The
    // per-instance ret_ty variable stays the original T and is used
    // locally for box allocation inside emit_mir_return.
    // find_function searches backwards, so this entry overrides the
    // forward-declare entry at emit_mir_module.
    let mut reg_ret_ty: String = ret_ty
    if is_async { reg_ret_ty = "ptr" }
    let entry: FnEntry = new_fn_entry(f.name, reg_ret_ty, param_types)
    let mut s: EmitState = st
    s.functions.push(entry)

    // Track current function's return type and sret flag
    // main() uses i32 return (C ABI) for clean exit codes.
    // v5.5.4 Sh.4 Phase 2: async fns flag via an "ASYNC_PTR:" prefix
    // so emit_mir_return can branch to the ret-rewrite path while
    // still knowing the inner T for box allocation.
    // v5.5.6 Sh.4 Phase 3: when the module contains async fns, main
    // uses the "i32_async" sentinel so emit_mir_return can prepend
    // `call void @__mn_coro_scheduler_destroy()` before the truncate
    // + ret. Parallel to the ASYNC_PTR: pattern.
    let main_module_has_async: Bool = f.name == "main" && module_has_async(module)
    if f.name == "main":
        if main_module_has_async:
            s.current_ret_type = "i32_async"
        else:
            s.current_ret_type = "i32"
    else if is_async:
        s.current_ret_type = "ASYNC_PTR:" + ret_ty
    else:
        s.current_ret_type = ret_ty

    // v5.4.0 Own.1 Phase 2 — reset per-function ownership tracking.
    // These lists collect local names that currently own String / List /
    // boxed resources and those that have been transferred via Move, and
    // are consulted by emit_drop_glue before every ret.
    let fresh_str_owned: List<String> = []
    let fresh_list_owned: List<String> = []
    let fresh_boxed_owned: List<String> = []
    let fresh_moved_locals: List<String> = []
    let fresh_prelude: List<String> = []
    let fresh_body: List<String> = []
    s.str_owned = fresh_str_owned
    s.list_owned = fresh_list_owned
    s.boxed_owned = fresh_boxed_owned
    s.moved_locals = fresh_moved_locals
    s.entry_prelude_lines = fresh_prelude
    s.entry_block_body = fresh_body
    s.in_entry_block = false
    // v5.4.3 — reset loop depth per function; nested-loop tracking is
    // keyed on block-label prefix inside emit_mir_basic_block.
    s.loop_depth = 0
    // v5.4.4 — reset parallel source arrays alongside owner lists.
    let fresh_str_src: List<String> = []
    let fresh_list_src: List<String> = []
    let fresh_boxed_src: List<String> = []
    s.str_owned_source = fresh_str_src
    s.list_owned_source = fresh_list_src
    s.boxed_owned_source = fresh_boxed_src

    // Emit function header
    let fn_name: String = strip_percent(f.name)
    let is_lambda: Bool = fn_name != f.name
    let visibility: String = if is_lambda { "define internal" } else { "define" }
    let mut abi_ret: String = ret_ty
    if use_sret { abi_ret = "void" }
    // main() returns i32 (C ABI) instead of void for clean exit codes
    if fn_name == "main" { abi_ret = "i32" }
    // v5.5.4 Sh.4 Phase 2 — async fn ABI: return type is always the
    // Future handle (ptr), regardless of declared T.  The actual
    // result is carried inside the Future struct (set in emit_mir_return).
    let mut coro_attr: String = ""
    if is_async:
        abi_ret = "ptr"
        coro_attr = " presplitcoroutine"
    // v4.97.0: nounwind willreturn on all user-defined functions.
    // Mapanare has no exceptions (nounwind) and all functions terminate (willreturn).
    // Matches Python bootstrap at emit_llvm_text.py:2239-2244.
    s = emit_line(s, visibility + " " + abi_ret + " @" + fn_name + "(" + params_str + ") nounwind willreturn" + coro_attr + " {")

    // v5.5.4 Sh.4 Phase 2 — async fn coroutine prologue.
    // Emitted as a synthetic `coro.entry:` block that runs before
    // the user's entry block. It sets up the coroutine frame, the
    // Future struct that will be returned immediately (at initial
    // suspend), and switches into either %pre_entry (normal resume)
    // or %coro.cleanup (caller destroys the coroutine before it
    // completes). pre_entry is a trampoline to the MIR's first basic
    // block; this avoids having to reshuffle parameter stores that
    // the lowerer already placed inside the MIR entry.  Mirrors
    // mapanare/emit_llvm_text.py:2572–2605.
    if is_async:
        s = emit_line(s, "coro.entry:")
        s = emit_line(s, "  %coro.id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
        s = emit_line(s, "  %coro.size = call i64 @llvm.coro.size.i64()")
        s = emit_line(s, "  %coro.mem = call ptr @malloc(i64 %coro.size)")
        s = emit_line(s, "  %coro.hdl = call ptr @llvm.coro.begin(token %coro.id, ptr %coro.mem)")
        s = emit_line(s, "  %future = call ptr @malloc(i64 16)")
        s = emit_line(s, "  store i8 0, ptr %future")
        s = emit_line(s, "  %future.hdl.slot = getelementptr inbounds {i8, ptr}, ptr %future, i32 0, i32 1")
        s = emit_line(s, "  store ptr %coro.hdl, ptr %future.hdl.slot")
        s = emit_line(s, "  %coro.init.save = call token @llvm.coro.save(ptr %coro.hdl)")
        s = emit_line(s, "  %coro.init.susp = call i8 @llvm.coro.suspend(token %coro.init.save, i1 false)")
        s = emit_line(s, "  switch i8 %coro.init.susp, label %coro.ret [")
        s = emit_line(s, "    i8 0, label %pre_entry")
        s = emit_line(s, "    i8 1, label %coro.cleanup")
        s = emit_line(s, "  ]")
        s = emit_line(s, "pre_entry:")
        if len(f.blocks) > 0:
            s = emit_line(s, "  br label %" + f.blocks[0].label)
        else:
            s = emit_line(s, "  br label %coro.final")

    // Emit basic blocks — entry block gets byref param fixup.
    // Extracted from single loop to avoid return-in-for and else-branch bugs.
    let nblks: Int = len(f.blocks)

    // Entry block (index 0): emit byref param loads, then instructions
    if nblks > 0:
        let bb0: BasicBlock = f.blocks[0]
        s = emit_line(s, bb0.label + ":")
        // v5.4.1 — redirect emit_line to entry_block_body for the rest
        // of the function so we can splice the tracking-slot prelude
        // in front of the body. emit_track_string / _boxed / _closure
        // can fire from any block (e.g., a concat in a loop body), so
        // the redirect must remain on through every basic block, not
        // just the entry block. Flushed at function close before '}'.
        s.in_entry_block = true
        // v5.5.6 Sh.4 Phase 3: for async-aware main, emit
        // `call void @__mn_coro_scheduler_init(i32 0)` as the FIRST
        // buffered body line so every subsequent BlockOn sees an
        // initialised scheduler. 0 = auto-detect cores (respects
        // MAPANARE_ASYNC_THREADS env var inside the runtime). Mirrors
        // mapanare/emit_llvm_text.py:2500-2508.
        if main_module_has_async:
            s = emit_line(s, "  call void @__mn_coro_scheduler_init(i32 0)")
        // Emit byref loads: for each byref param, alloca + load from ptr + store
        let mut pi3: Int = 0
        let nfparams3: Int = len(f.params)
        for _ in 0..100:
            if pi3 < nfparams3:
                let p_byref: MIRParam = f.params[pi3]
                let pty_byref: String = resolve_mir_type(p_byref.ty)
                if is_byref_type_st(s, pty_byref):
                    s = emit_line(s, "  %" + p_byref.name + ".addr = alloca " + pty_byref)
                    s = emit_line(s, "  %" + p_byref.name + ".bp = load " + pty_byref + ", ptr %" + p_byref.name + ".byref")
                    s = emit_line(s, "  store " + pty_byref + " %" + p_byref.name + ".bp, ptr %" + p_byref.name + ".addr")
                pi3 = pi3 + 1
        // Build set of byref param names for skip detection
        let mut byref_names: List<String> = []
        let mut pn: Int = 0
        let nfparamsn: Int = len(f.params)
        for _ in 0..100:
            if pn < nfparamsn:
                let pp: MIRParam = f.params[pn]
                let ppty: String = resolve_mir_type(pp.ty)
                if is_byref_type_st(s, ppty):
                    byref_names.push(pp.name)
                pn = pn + 1
        // Emit block instructions, skipping Alloca+Store ONLY for byref params
        let mut ii: Int = 0
        let ninsts: Int = len(bb0.instructions)
        for _ in 0..2000:
            if ii < ninsts:
                let inst: Instruction = bb0.instructions[ii]
                let mut should_skip: Bool = false
                let ik: String = instr_kind(inst)
                if ik == "alloca":
                    should_skip = is_name_in_byref(byref_names, instr_dest(inst).name)
                if ik == "store":
                    should_skip = is_name_in_byref(byref_names, instr_store_ptr(inst).name)
                if !should_skip:
                    s = emit_mir_instruction(s, inst)
                ii = ii + 1

    // Remaining blocks (index 1..nblks-1) — still inside the function-
    // body buffer, so any emit_track_* calls from these blocks land
    // their alloca lines in entry_prelude_lines for the entry-block
    // splice below.
    let mut bi: Int = 1
    for _ in 0..2000:
        if bi < nblks:
            let bb: BasicBlock = f.blocks[bi]
            s = emit_mir_basic_block(s, bb)
            bi = bi + 1

    // v5.4.1 — close function-body buffering. Drain prelude (entry-
    // block allocas) into st.lines, then the body. The result IR has
    // tracking allocas at the top of the entry block followed by all
    // user instructions and trailing blocks, in correct LLVM order.
    if nblks > 0:
        s.in_entry_block = false
        let mut pk2: Int = 0
        let npre2: Int = len(s.entry_prelude_lines)
        // v5.4.4 — bumped prelude flush cap (emit_mir_call's drop glue
        // adds ~50 alloca lines on top of tracking-slot allocas).
        for _ in 0..65536:
            if pk2 >= npre2 { break }
            s.lines.push(s.entry_prelude_lines[pk2])
            pk2 = pk2 + 1
        let mut bk: Int = 0
        let nbody: Int = len(s.entry_block_body)
        // v5.4.4 — bumped body flush cap from 65536 to 1M to cover
        // functions whose drop glue (structs with multi-ret-ptr
        // extraction) produces >65k body lines — observed at
        // emit_mir_call in stage2.ll with ~66k lines.
        for _ in 0..1000000:
            if bk >= nbody { break }
            s.lines.push(s.entry_block_body[bk])
            bk = bk + 1

    // v5.5.4 Sh.4 Phase 2 — async fn coroutine epilogue.
    // Three trailing blocks: coro.final (final suspend — keeps the
    // frame alive so the caller can read the Future's result),
    // coro.cleanup (frees the frame memory), coro.ret (ends the
    // coroutine and returns the Future handle).  All `ret` in the
    // user body were rewritten by emit_mir_return to `br %coro.final`
    // + box-payload store; this trio is their landing pad. Mirrors
    // mapanare/emit_llvm_text.py:2669–2685.
    if is_async:
        s = emit_line(s, "coro.final:")
        s = emit_line(s, "  %coro.final.save = call token @llvm.coro.save(ptr %coro.hdl)")
        s = emit_line(s, "  %coro.final.susp = call i8 @llvm.coro.suspend(token %coro.final.save, i1 true)")
        s = emit_line(s, "  switch i8 %coro.final.susp, label %coro.ret [")
        s = emit_line(s, "    i8 0, label %coro.ret")
        s = emit_line(s, "    i8 1, label %coro.cleanup")
        s = emit_line(s, "  ]")
        s = emit_line(s, "coro.cleanup:")
        // v5.5.7 — destroy-path drop-glue: free String/List/boxed
        // locals tracked in this fn before the frame is freed.
        // No-op for the 5 Sh.4 goldens (their async fns hold no
        // heap-allocated locals) but the correct foundation for
        // future real-I/O async programs that allocate inside the
        // coroutine frame and may be cancelled mid-flight.
        s = emit_drop_glue_destroy(s)
        s = emit_line(s, "  %coro.mem.free = call ptr @llvm.coro.free(token %coro.id, ptr %coro.hdl)")
        s = emit_line(s, "  call void @free(ptr %coro.mem.free)")
        s = emit_line(s, "  br label %coro.ret")
        s = emit_line(s, "coro.ret:")
        s = emit_line(s, "  call i1 @llvm.coro.end(ptr %coro.hdl, i1 false, token none)")
        s = emit_line(s, "  ret ptr %future")

    s = emit_line(s, "}")
    return emit_blank(s)

// ---------------------------------------------------------------------------
// Format constants (printf format strings)
// ---------------------------------------------------------------------------

fn emit_format_constants(st: EmitState) -> EmitState:
    let mut s: EmitState = st
    s = emit_line(s, "@.newline = private constant [2 x i8] c\"\\0A\\00\", align 2")
    s = emit_line(s, "@.fmt_int = private constant [4 x i8] c\"%ld\\00\", align 2")
    s = emit_line(s, "@.fmt_int_nl = private constant [5 x i8] c\"%ld\\0A\\00\", align 2")
    s = emit_line(s, "@.fmt_float = private constant [4 x i8] c\"%lf\\00\", align 2")
    s = emit_line(s, "@.fmt_float_nl = private constant [5 x i8] c\"%lf\\0A\\00\", align 2")
    return emit_blank(s)

// ---------------------------------------------------------------------------
// Public API: emit_mir_module
// ---------------------------------------------------------------------------

fn str_join(sep: String, parts: List<String>) -> String = join(sep, parts)

pub fn emit_mir_module(module: MIRModule, module_name: String) -> String:
    let mut st: EmitState = new_emit_state(module_name)
    // v5.8.4 Wb.2 + v5.8.6 We.1: detect host before any IR is
    // emitted. The (is_windows, win_arch) pair gates a 3-way ABI
    // dispatch in declare_runtime_fn / emit_rt_call / use_sret_return:
    //   is_windows && win_arch == 64 → Win64 sret/sarg
    //   is_windows && win_arch == 32 → i686 cdecl sret/byval
    //   !is_windows                  → SysV / AAPCS64 by-value
    // OS-1 detection mechanism per v5.8.4 PLAN.md, refined in
    // v5.8.6 PLAN.md to disambiguate the 32-bit Windows case.
    let host_win: Int = __mn_host_is_windows()
    let host_bits: Int = __mn_host_arch_bits()
    if host_win != 0:
        st.is_windows = true
        st.win_arch = host_bits

    // Module header
    // v4.127.0: target datalayout + triple match the Python bootstrap defaults
    // from mapanare/targets.py::TARGET_X86_64_LINUX_GNU. LLVM uses the host
    // target if these are absent, but emitting them explicitly aligns the
    // self-hosted output with the bootstrap and removes a per-module diff.
    // v5.8.4 Wb.2 + v5.8.6 We.1: triple AND datalayout are now host-
    // aware (the v5.8.4 release fixed only the triple — datalayout
    // continued to emit the Linux/SysV layout on Windows builds, a
    // latent bug LLVM was forgiving about). Linux/Darwin → SysV;
    // Win64 → mingw x86_64 layout; Win32 → mingw i686 layout
    // (32-bit pointers, m:x mangling, S32 stack alignment).
    st = emit_line(st, "; ModuleID = '" + module_name + "'")
    st = emit_line(st, "source_filename = \"" + module_name + "\"")
    let mut layout_line: String = "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\""
    let mut triple_line: String = "target triple = \"x86_64-unknown-linux-gnu\""
    if use_win64_abi(st):
        layout_line = "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\""
        triple_line = "target triple = \"x86_64-w64-windows-gnu\""
    if use_i686_abi(st):
        layout_line = "target datalayout = \"e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:32-n8:16:32-a:0:32-S32\""
        triple_line = "target triple = \"i686-w64-windows-gnu\""
    st = emit_line(st, layout_line)
    st = emit_line(st, triple_line)
    st = emit_blank(st)

    // Format string constants
    st = emit_format_constants(st)

    // Runtime declarations
    st = declare_all_runtime(st)

    // Register struct types
    let mut si_idx: Int = 0
    let nmodstructs: Int = len(module.structs)
    for _ in 0..500:
        if si_idx < nmodstructs:
            st = register_mir_struct(st, module.structs[si_idx])
            si_idx = si_idx + 1

    // Register enum types
    let mut ei: Int = 0
    let nmodenums: Int = len(module.enums)
    for _ in 0..500:
        if ei < nmodenums:
            st = register_mir_enum(st, module.enums[ei])
            ei = ei + 1

    if len(module.structs) > 0 { st = emit_blank(st) }
    if len(module.enums) > 0 { st = emit_blank(st) }

    // Module-level constants
    let mut ci: Int = 0
    let nconsts: Int = len(module.consts)
    for _ in 0..500:
        if ci < nconsts:
            let mc: ModuleConst = module.consts[ci]
            if mc.is_string:
                let slen: Int = len(mc.str_value)
                let arr_ty: String = "[" + toString(slen) + " x i8]"
                st = emit_line(st, "@" + mc.name + " = private constant " + arr_ty + " c\"" + mc.str_value + "\"")
            else:
                st = emit_line(st, "@" + mc.name + " = private constant i64 " + toString(mc.int_value))
            ci = ci + 1
    if nconsts > 0 { st = emit_blank(st) }

    // Declare extern functions
    let mut xi: Int = 0
    let nmodexterns: Int = len(module.extern_fns)
    for _ in 0..500:
        if xi < nmodexterns:
            st = declare_mir_extern(st, module.extern_fns[xi])
            xi = xi + 1
    if len(module.extern_fns) > 0 { st = emit_blank(st) }

    // Forward-declare all functions (for mutual recursion)
    let mut dix: Int = 0
    let nmodfns: Int = len(module.functions)
    for _ in 0..5000:
        if dix < nmodfns:
            let f_decl: MIRFunction = module.functions[dix]
            // v5.5.4 Sh.4 Phase 2 — async fns have ABI return type
            // ptr (Future<T> handle) regardless of declared T. The
            // caller's BlockOn/AwaitSuspend handlers consume the ptr
            // and extract the inner T via GEP + load.
            let mut ret_ty: String = resolve_mir_type(f_decl.return_type)
            if fn_is_async(f_decl):
                ret_ty = "ptr"
            let mut fparams: String = ""
            let mut fpi: Int = 0
            let nfwdparams: Int = len(f_decl.params)
            for _ in 0..500:
                if fpi < nfwdparams:
                    let fp: MIRParam = f_decl.params[fpi]
                    let fpty: String = resolve_mir_type(fp.ty)
                    if fpi > 0:
                        fparams = fparams + ", " + fpty
                    else:
                        fparams = fpty
                    fpi = fpi + 1
            let mut fn_types: List<String> = []
            let mut fti: Int = 0
            for _ in 0..500:
                if fti < nfwdparams:
                    fn_types.push(resolve_mir_type(f_decl.params[fti].ty))
                    fti = fti + 1
            let fe: FnEntry = new_fn_entry(f_decl.name, ret_ty, fn_types)
            st.functions.push(fe)
            dix = dix + 1

    // Emit function bodies
    for fi in 0..len(module.functions):
        let f_emit: MIRFunction = module.functions[fi]
        if len(f_emit.blocks) > 0:
            st = emit_mir_function(st, f_emit, module)

    // Append string globals
    let mut gi: Int = 0
    let nstrglobals: Int = len(st.str_globals)
    for _ in 0..1000000:
        if gi < nstrglobals:
            st = emit_line(st, st.str_globals[gi])
            gi = gi + 1
    // v4.127.0: removed the TBAA tree (nodes !1–!9). It was declared but
    // never attached to any load/store via `!tbaa !N`, confirmed 100% dead
    // code by v4.109.0 forensics on the Python bootstrap. The Python
    // emitter removed it in v4.123.0 (mapanare/emit_llvm_text.py:923-933);
    // self-hosted now matches.
    //
    // v5.9.0 DX.2: replaces the __MN_VERSION__ source-tree placeholder
    // (v4.139.0 Dr.1) with a runtime call to ``__mn_version_string()``.
    // The compiler reads its own baked-in version (from MAPANARE_VERSION
    // at C-runtime compile time) and embeds it into the metadata node of
    // every program it emits. Closes the strict-fixed-point near miss
    // that has carried the VERSION-only diff since v4.140.0 — stage2 and
    // stage3 now embed identical strings because both compilers share the
    // same baked-in version.
    let mnc_version: String = __mn_version_string()
    st = emit_blank(st)
    st = emit_line(st, "!mapanare.version = !{!0}")
    st = emit_line(st, "!0 = !{!\"" + mnc_version + "\"}")

    // Join all lines into a single string
    return join("\n", st.lines)

// ===== main.mn =====
// main.mn — Compiler driver for the Mapanare self-hosted compiler.
// Wires the pipeline: source -> parse -> resolve imports -> lower -> emit_llvm -> LLVM IR.


// ---------------------------------------------------------------------------
// Compilation result
// ---------------------------------------------------------------------------

struct CompileResult:
    success: Bool
    ir_text: String
    errors: List<SemanticError>

fn new_compile_result(success: Bool, ir_text: String, errors: List<SemanticError>) -> CompileResult = new CompileResult { success: success, ir_text: ir_text, errors: errors }

// ---------------------------------------------------------------------------
// version — return the compiler version string
// ---------------------------------------------------------------------------

// v5.9.0 DX.2: version comes from ``__mn_version_string()``, a C-runtime
// export baked at C-compile time via ``-DMAPANARE_VERSION``. Replaces the
// v4.28.0 ``__MN_VERSION__`` source-tree placeholder + build-time
// substitution dance. The structural fix closes a class of staleness bugs
// (v4.28.0 forensics: 19 minors stale; v5.8.7 Windows publish: placeholder
// shipped as the literal). Mirrors the v5.8.6 We.1 host-detection pattern.
fn version() -> String = "mapanare " + __mn_version_string()

// v5.9.0 DX.1: --help / -h / help / help <sub> / <sub> --help all print
// usage. Pre-v5.9.0 these flags fell through the default-IR-emit branch
// and surfaced as ``error: cannot read file '--help'`` — every new user
// hit it.
fn print_help_text():
    print("mapanare " + __mn_version_string() + " - native compiler")
    print("")
    print("Usage:")
    print("  mnc <file.mn>             compile and run (default)")
    print("  mnc emit-llvm <file.mn>   compile to LLVM IR [-o output]")
    print("  mnc fmt <path...>         canonicalize whitespace [--check|--stdout]")
    print("  mnc run <file.mn>         compile and execute")
    print("  mnc build <file.mn|dir>   build native binary [-o output]")
    print("  mnc compile <file>        transpile + build (.py/.php/.ts/.go)")
    print("  mnc check <file.mn>       type-check [--all] [--werror]")
    print("  mnc init <path>           scaffold a new project [--name NAME]")
    print("  mnc test <file.mn>        compile, link, run, report pass/fail")
    print("  mnc lsp                   start the language server (stdio)")
    print("  mnc cache <stats|clean>   inspect or clear build cache")
    print("  mnc version               print version")
    print("  mnc --help                show this help")
    print("")
    print("For per-subcommand help: mnc help <subcommand>")
    print("Docs: https://mapanare.dev/docs")

// v5.10.0 Win.1b.D: prefer a bundled LLVM toolchain over PATH clang.
// Windows release ZIPs starting v5.10.0 ship clang.exe + lld-link.exe
// + LLVM-C.dll alongside the mnc/mapanare binary at <exe_dir>/llvm/.
// find_clang() returns that path if present, falls through to "clang"
// (PATH lookup) so non-bundled installs see no behavior change. The
// path is wrapped in quotes — install dirs containing spaces (e.g.
// ``C:\\Program Files\\Mapanare\\bin``) would otherwise tokenise wrong
// when concatenated into a __mn_system command string.
//
// Single-return structure (``let mut result``) is deliberate: during
// v5.10.0 fixed-point validation, the MIR inliner constant-folded an
// earlier multi-return draft of this function to the fallback
// ``"clang"`` literal at every call site, dropping the bundled-path
// branches entirely. The single-return form keeps the conditional
// logic intact through inlining + dead-code elimination.
fn find_clang() -> String:
    let mut result: String = "clang"
    let exe_dir: String = __mn_executable_dir()
    let bundled_win: String = exe_dir + "/llvm/clang.exe"
    if __mn_file_exists(bundled_win) != 0:
        result = "\"" + bundled_win + "\""
    else:
        let bundled_unix: String = exe_dir + "/llvm/clang"
        if __mn_file_exists(bundled_unix) != 0:
            result = "\"" + bundled_unix + "\""
    result

// v5.9.0 DX.3: probe clang once per invocation. Pre-v5.9.0 a missing
// clang (the default state on most Windows boxes) surfaced as bare
// ``error: clang failed`` with no install hint. The probe runs cold in
// <10 ms and replaces every ``error: clang failed`` site with a
// platform-aware install-instructions block. v5.10.0 Win.1b.D layers
// the bundled-LLVM lookup on top: if the bundle is present, we probe
// the bundled clang and never touch PATH.
fn check_clang_available() -> Bool:
    let clang_bin: String = find_clang()
    if __mn_host_is_windows() != 0:
        let rw: Int = __mn_system(clang_bin + " --version > NUL 2>NUL")
        return rw == 0
    let r: Int = __mn_system(clang_bin + " --version > /dev/null 2>/dev/null")
    return r == 0

fn print_clang_install_help():
    __mn_str_eprint("error: clang not found.\n")
    __mn_str_eprint("Mapanare needs clang to compile to native binaries.\n")
    __mn_str_eprint("Install LLVM and try again:\n")
    if __mn_host_is_windows() != 0:
        __mn_str_eprint("  winget install LLVM.LLVM\n")
        __mn_str_eprint("  (or download from https://llvm.org/builds)\n")
    else:
        __mn_str_eprint("  macOS: brew install llvm  (or xcode-select --install)\n")
        __mn_str_eprint("  Linux: apt install clang  (or your distro's equivalent)\n")
        __mn_str_eprint("  See https://llvm.org/builds for direct downloads.\n")

// v5.9.0 DX.3: when clang is found but exits non-zero, surface its
// stderr (which we previously swallowed via ``2>/dev/null``) so the
// user can see the real error instead of a bare "clang failed".
fn report_clang_failure():
    let err_path: String = __mn_clang_err_path()
    let stderr_text: String = __mn_file_read_or_empty(err_path)
    __mn_str_eprint("error: clang failed:\n")
    if len(stderr_text) > 0:
        __mn_str_eprint(stderr_text)
        if !stderr_text.ends_with("\n"):
            __mn_str_eprint("\n")

// v5.9.0 DX.3: stderr-capture suffix for shell-out clang invocations.
// Replaces ``2>/dev/null`` (stderr swallowed) with ``2><platform-temp>``
// so report_clang_failure() can read the real diagnostic.
fn clang_stderr_redirect() -> String = " 2>" + __mn_clang_err_path()

// v5.9.0 DX.4: pretty-print a byte count. Mirrors ``du -sh`` output
// shape so the cache-stats user-facing surface looks unchanged.
fn format_bytes(n: Int) -> String:
    if n < 1024:
        return str(n) + "B"
    if n < 1048576:
        let kb: Int = n / 1024
        return str(kb) + "K"
    if n < 1073741824:
        let mb: Int = n / 1048576
        return str(mb) + "M"
    let gb: Int = n / 1073741824
    return str(gb) + "G"

fn count_lines(s: String) -> Int:
    let n: Int = len(s)
    let mut count: Int = 0
    let mut i: Int = 0
    for _ in 0..1000000:
        if i >= n { break }
        if s.substr(i, 1) == "\n":
            count = count + 1
        i = i + 1
    count

fn print_subcommand_help(cmd: String):
    if cmd == "build":
        print("Usage: mnc build <file.mn|dir> [-o output] [--release|--debug|--small]")
        print("")
        print("Compile to native executable. Defaults to a.out.")
        print("Flags:")
        print("  -o <path>     output path (default: a.out)")
        print("  --release     -O2 + LTO + strip")
        print("  --debug       -O0, no strip")
        print("  --small       -Os + LTO + strip")
        return
    if cmd == "run":
        print("Usage: mnc run <file.mn> [args...]")
        print("")
        print("Compile and execute. Args after <file.mn> are forwarded to the program.")
        return
    if cmd == "test":
        print("Usage: mnc test <file.mn>")
        print("")
        print("Compile, link, run; print PASS or FAIL with reason.")
        return
    if cmd == "cache":
        print("Usage: mnc cache <stats|clean>")
        print("")
        print("  stats   show cache directory size and module count")
        print("  clean   delete the cache directory")
        return
    if cmd == "compile":
        print("Usage: mnc compile <file> [-o output]")
        print("")
        print("Transpile + build. Supported: .mn, .py, .php, .ts, .go")
        return
    if cmd == "emit-llvm":
        print("Usage: mnc emit-llvm <file.mn> [-o output]")
        print("")
        print("Compile to LLVM IR. Without -o, prints to stdout.")
        print("With -o <path>, writes to file.")
        return
    print_help_text()

// ---------------------------------------------------------------------------
// Path helpers for module resolution
// ---------------------------------------------------------------------------

// Extract directory part of a path: "/foo/bar/baz.mn" -> "/foo/bar/"
// Returns "" if no directory separator found.
// Scans from end to find last separator (avoids nested-assign MIR bug).
fn dir_of_path(path: String) -> String:
    let slen: Int = len(path)
    if slen == 0 { return "" }
    let mut i: Int = slen - 1
    for _ in 0..4096:
        if i < 0 { return "" }
        let ch: String = path.substr(i, 1)
        if ch == "/":
            return path.substr(0, i + 1)
        i = i - 1
    return ""

// Join import path segments with "/": ["stdlib", "math"] -> "stdlib/math"
fn join_import_path(segments: List<String>) -> String:
    let mut result: String = ""
    let mut i: Int = 0
    let n: Int = len(segments)
    for _ in 0..20:
        if i >= n { return result }
        if i > 0:
            result = result + "/" + segments[i]
        else:
            result = segments[i]
        i = i + 1
    return result

// Extract last path component: "stdlib/text" -> "text", "math" -> "math"
fn basename_of(path: String) -> String:
    let slen: Int = len(path)
    if slen == 0 { return "" }
    let mut i: Int = slen - 1
    for _ in 0..256:
        if i < 0 { return path }
        let ch: String = path.substr(i, 1)
        if ch == "/":
            return path.substr(i + 1, slen - i - 1)
        i = i - 1
    return path

// Extract file extension: "hello.py" -> ".py", "foo.mn" -> ".mn"
fn file_extension(filename: String) -> String:
    let flen: Int = len(filename)
    let mut i: Int = flen - 1
    for _ in 0..20:
        if i < 0 { return "" }
        if filename.substr(i, 1) == ".":
            return filename.substr(i, flen - i)
        i = i - 1
    return ""

// Try a single directory + relative path combination.
// Resolution order: <rel>.mn, <rel>/mod.mn, <rel>/<basename>.mn
fn try_resolve(dir: String, rel: String) -> String:
    let c1: String = dir + rel + ".mn"
    let r1: String = __mn_file_read_or_empty(c1)
    if len(r1) > 0 { return c1 }
    let c2: String = dir + rel + "/mod.mn"
    let r2: String = __mn_file_read_or_empty(c2)
    if len(r2) > 0 { return c2 }
    // Try <rel>/<basename>.mn (e.g., stdlib/text -> stdlib/text/text.mn)
    let base: String = basename_of(rel)
    if len(base) > 0:
        let c3: String = dir + rel + "/" + base + ".mn"
        let r3: String = __mn_file_read_or_empty(c3)
        if len(r3) > 0 { return c3 }
    return ""

// Resolve an import path to a file path, reading to check existence.
// Search order: source_dir, parent dirs of source_dir, then CWD.
// Returns "" if not found.
fn resolve_import_file(segments: List<String>, source_dir: String) -> String:
    let rel: String = join_import_path(segments)
    // Try relative to source directory and each parent up to root
    let mut dir: String = source_dir
    for _ in 0..20:
        if len(dir) == 0:
            // Try CWD-relative (empty prefix)
            let cwd_result: String = try_resolve("", rel)
            if len(cwd_result) > 0 { return cwd_result }
            return ""
        let result: String = try_resolve(dir, rel)
        if len(result) > 0 { return result }
        // Climb to parent: strip trailing slash, then find last slash
        let trimmed: String = dir.substr(0, len(dir) - 1)
        dir = dir_of_path(trimmed)
    return ""

// ---------------------------------------------------------------------------
// Definition dedup — remove earlier duplicates from circular imports.
// When module A imports B and B imports A, stubs from A appear before
// real definitions from B. Keep the LAST occurrence of each function name.
// ---------------------------------------------------------------------------

fn definition_name(defn: Definition) -> String:
    let dk: String = def_kind(defn)
    if dk == "fn_def" { return "__fn__" + def_fn_data(defn).name }
    if dk == "struct_def" { return "__st__" + def_struct_data(defn).name }
    if dk == "enum_def" { return "__en__" + def_enum_data(defn).name }
    if dk == "extern_fn_def" { return "__ex__" + def_extern_name(defn) }
    return ""

fn has_later_def(defs: List<Definition>, idx: Int, name: String, total: Int) -> Bool:
    // Check if any definition after idx has the same name
    let mut found: Bool = false
    let mut j: Int = idx + 1
    for _ in 0..10000:
        if j < total:
            if definition_name(defs[j]) == name:
                found = true
            j = j + 1
    found

fn dedup_definitions(defs: List<Definition>) -> List<Definition>:
    let mut result: List<Definition> = []
    let n: Int = len(defs)
    let mut i: Int = 0
    for _ in 0..10000:
        if i < n:
            let defn: Definition = defs[i]
            let name: String = definition_name(defn)
            // Keep definitions with no extractable name
            if len(name) == 0:
                result.push(defn)
            else:
                // Only keep if no later definition has the same name
                if has_later_def(defs, i, name, n) == false:
                    result.push(defn)
            i = i + 1
    result

// ---------------------------------------------------------------------------
// Import resolution — read imported files, parse, merge definitions
// ---------------------------------------------------------------------------

// Resolve all imports in a program. Reads imported files, parses them,
// and prepends their definitions to the program.
// visited tracks already-resolved files to prevent circular imports.
fn resolve_imports(program: Program, filename: String, visited: List<String>) -> Program:
    let source_dir: String = dir_of_path(filename)
    let mut all_defs: List<Definition> = []
    let mut vis: List<String> = visited
    vis.push(filename)

    // First pass: find and resolve import definitions
    let mut i: Int = 0
    let ndefs: Int = len(program.definitions)
    for _ in 0..2000:
        if i >= ndefs:
            // Append the original non-import definitions
            let mut j: Int = 0
            for _ in 0..10000:
                if j >= ndefs:
                    // Dedup: remove earlier stubs when real implementations exist
                    let deduped: List<Definition> = dedup_definitions(all_defs)
                    return start(deduped)
                let defn_j: Definition = program.definitions[j]
                if def_kind(defn_j) != "import_def":
                    all_defs.push(defn_j)
                j = j + 1
            let deduped2: List<Definition> = dedup_definitions(all_defs)
            return start(deduped2)
        let defn: Definition = program.definitions[i]
        if def_kind(defn) == "import_def":
            let imp_path: List<String> = def_import_path(defn)
            if len(imp_path) > 0:
                let resolved_file: String = resolve_import_file(imp_path, source_dir)
                if len(resolved_file) > 0:
                    // Check if already visited (circular import guard)
                    if is_visited(vis, resolved_file) == false:
                        vis.push(resolved_file)
                        let imp_source: String = __mn_file_read_or_empty(resolved_file)
                        if len(imp_source) > 0:
                            let imp_program: Program = parse(imp_source, resolved_file)
                            // Recursively resolve imports in the imported module
                            let resolved_imp: Program = resolve_imports(imp_program, resolved_file, vis)
                            // Prepend imported definitions (skip import defs themselves)
                            let mut k: Int = 0
                            let nimp: Int = len(resolved_imp.definitions)
                            for _ in 0..10000:
                                if k >= nimp { k = nimp + 1 }
                                if k < nimp:
                                    all_defs.push(resolved_imp.definitions[k])
                                    k = k + 1
        i = i + 1
    return start(all_defs)

fn is_visited(visited: List<String>, path: String) -> Bool:
    let mut i: Int = 0
    let n: Int = len(visited)
    for _ in 0..100:
        if i >= n { return false }
        if visited[i] == path { return true }
        i = i + 1
    return false

// ---------------------------------------------------------------------------
// compile — run the full pipeline on a source string
// ---------------------------------------------------------------------------

fn compile(source: String, filename: String) -> CompileResult:
    // Stage 1: parse
    let program: Program = parse(source, filename)

    // Stage 2: resolve imports — read imported files, parse, merge definitions
    let visited: List<String> = []
    let resolved: Program = resolve_imports(program, filename, visited)

    // Stage 3: semantic analysis
    // v4.52.0: check() returns errors; callers handle display (removed double-print)
    let errors: List<SemanticError> = check(resolved, filename)
    if len(errors) > 0:
        return new_compile_result(false, "", errors)

    // Stage 4: lower AST to MIR
    let mir_module: MIRModule = lower(resolved, filename)

    // Stage 5: optimize MIR (constant fold + dead block elimination)
    let opt_module: MIRModule = optimize_mir(mir_module)

    // Stage 5.5: verify MIR structural correctness before emission.
    // v4.27.0: closes the v4.5.0 CHANGELOG claim ("MIR verifier called before
    // emission") on the self-hosted side. Prior to this, verify_module was
    // defined in lower.mn but had zero call sites in the compile pipeline.
    let verify_errs: List<VerifyError> = verify_module(opt_module)
    if len(verify_errs) > 0:
        __mn_str_eprint("error: MIR verifier detected malformed IR before emission:\n")
        let mut vi: Int = 0
        for _ in 0..1000:
            if vi >= len(verify_errs):
                let empty: List<SemanticError> = []
                return new_compile_result(false, "", empty)
            let ve: VerifyError = verify_errs[vi]
            __mn_str_eprint("  ")
            __mn_str_eprint(ve.fn_name)
            __mn_str_eprint("::")
            __mn_str_eprint(ve.block_label)
            __mn_str_eprint(": ")
            __mn_str_eprint(ve.message)
            __mn_str_eprint("\n")
            vi = vi + 1

    // Stage 6: emit LLVM IR from MIR
    // v4.128.0: strip path + extension to match Python CLI's
    // `os.path.splitext(os.path.basename(filename))[0]` convention (mapanare/cli.py:183).
    // Aligns ModuleID and source_filename with bootstrap output.
    let base: String = basename_of(filename)
    let ext: String = file_extension(base)
    let stem: String = base.substr(0, len(base) - len(ext))
    let ir_text: String = emit_mir_module(opt_module, stem)
    let no_errors: List<SemanticError> = []
    return new_compile_result(true, ir_text, no_errors)

// ---------------------------------------------------------------------------
// format_error — format a SemanticError for display
// ---------------------------------------------------------------------------

fn format_error(err: SemanticError) -> String = err.filename + ":" + toString(err.line) + ":" + toString(err.column) + ": error: " + err.message

// ---------------------------------------------------------------------------
// compile_and_print — compile and print result or errors
// ---------------------------------------------------------------------------

fn compile_and_print(source: String, filename: String) -> CompileResult:
    let cr: CompileResult = compile(source, filename)

    if cr.success:
        print(cr.ir_text)
    else:
        for i in 0..len(cr.errors):
            let err: SemanticError = cr.errors[i]
            print(format_error(err))
    cr

// v5.10.0 hygiene: surface compile diagnostics in run-mode paths.
// Pre-this-fix run_program / run_test / run_build / run_compile
// printed only "error: compile failed" then exited, hiding the
// semantic-error details that run_emit_llvm correctly iterated.
// CI (test_semantic_wiring's TestRejectsBrokenPrograms) caught this
// — broken-program tests were checking stderr for "Undefined
// function" / "Type mismatch" / "immutable" / etc. which weren't
// being emitted in run mode. Latent v5.9.1 hygiene gap; surfaced
// here because v5.10.0's Bb.4 seed refresh made the new run-mode
// behavior canonical.
fn print_compile_errors(cr: CompileResult):
    for i in 0..len(cr.errors):
        let err: SemanticError = cr.errors[i]
        __mn_str_eprint(format_error(err))
        __mn_str_eprint("\n")

// ---------------------------------------------------------------------------
// mn_main — native compiler entry point (called from C shim)
//
// Reads source file from argv[1], compiles to LLVM IR, prints to stdout.
// Errors go to stderr. Returns exit code via __mn_exit.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// test — compile, link, run, report pass/fail
// ---------------------------------------------------------------------------

fn rename_main(ir: String) -> String = ir.replace("@main(", "@mn_main(")

// Link an object file with the Mapanare runtime.
// Tries precompiled libmapanare_rt.a first, falls back to C source.
fn link_with_runtime(obj_path: String, out_path: String) -> Int:
    let null_r: String = __mn_dev_null_redirect()
    let link_pre: String = "gcc " + obj_path + " runtime/native/libmapanare_rt.a -o " + out_path + " -no-pie -rdynamic -lm -lpthread" + null_r
    let r: Int = __mn_system(link_pre)
    if r == 0 { return 0 }
    let link_src: String = "gcc " + obj_path + " runtime/native/mapanare_core.c runtime/native/mn_user_main.c -I runtime/native -o " + out_path + " -no-pie -rdynamic -lm -lpthread" + null_r
    return __mn_system(link_src)

// v5.13.1 At.2: source-text scan for `@test fn NAME(...)`. The native
// compiler doesn't expose the AST to main.mn (compile() returns IR
// text only), so a line-based scan keeps the patch minimal — the
// Python bootstrap discovers the same way through test_runner.py's
// AST walk, but `mnc test` only has the source string in scope.
// Skips blank lines and `//` comments between `@test` and `fn`.
fn is_test_name_char(ch: String) -> Bool:
    if ch == "_" { return true }
    if ch >= "0" && ch <= "9" { return true }
    if ch >= "a" && ch <= "z" { return true }
    if ch >= "A" && ch <= "Z" { return true }
    return false

fn extract_fn_name(line: String) -> String:
    // line begins with "fn " — pull the identifier after it.
    let n: Int = len(line)
    let mut i: Int = 3
    let mut start: Int = 3
    for _ in 0..n:
        if i >= n { break }
        let ch: String = line.substr(i, 1)
        if !is_test_name_char(ch) { break }
        i = i + 1
    line.substr(start, i - start)

// Manual whitespace strip. lower.mn doesn't translate `.trim()` to
// `__mn_str_trim`, mirroring emit_llvm.mn::ws_trim — duplicated here
// instead of imported because mnc_all.mn is a flat concat and main is
// emitted last (no module-prefixed call sites for ws_trim available).
fn _trim_line(s: String) -> String:
    let n: Int = len(s)
    if n == 0 { return s }
    let mut start: Int = 0
    for _ in 0..10000:
        if start >= n { break }
        let c0: String = s.substr(start, 1)
        if c0 != " " && c0 != "\t" && c0 != "\r" { break }
        start = start + 1
    let mut end: Int = n
    for _ in 0..10000:
        if end <= start { break }
        let c1: String = s.substr(end - 1, 1)
        if c1 != " " && c1 != "\t" && c1 != "\r" { break }
        end = end - 1
    if start == 0 && end == n { return s }
    return s.substr(start, end - start)

// v5.13.1 At.2: manual line-by-line scan via substr instead of
// String.split — split() in the self-host stage1 returns a List
// where each element is empty when the source was passed in as a
// function parameter (suspect string-ownership bug, latent because
// no other call site in the compiler splits a parameter String).
// Patch-release scope: route around it; file an issue for v5.14.x.
fn discover_test_names(source: String) -> List<String>:
    let mut names: List<String> = []
    let n: Int = len(source)
    let mut pos: Int = 0
    for _ in 0..n:
        if pos >= n { break }
        let mut eol: Int = pos
        for _ in 0..n:
            if eol >= n { break }
            if source.substr(eol, 1) == "\n" { break }
            eol = eol + 1
        let line: String = _trim_line(source.substr(pos, eol - pos))
        if line == "@test":
            // Scan forward for the next non-blank, non-comment line
            let mut q: Int = eol + 1
            for _ in 0..n:
                if q >= n { break }
                let mut q_eol: Int = q
                for _ in 0..n:
                    if q_eol >= n { break }
                    if source.substr(q_eol, 1) == "\n" { break }
                    q_eol = q_eol + 1
                let nl: String = _trim_line(source.substr(q, q_eol - q))
                let mut consumed: Bool = false
                if len(nl) == 0:
                    q = q_eol + 1
                    consumed = true
                if !consumed:
                    if nl.starts_with("//"):
                        q = q_eol + 1
                        consumed = true
                if !consumed:
                    if nl.starts_with("fn "):
                        let nm: String = extract_fn_name(nl)
                        if len(nm) > 0 { names.push(nm) }
                    if nl.starts_with("pub fn "):
                        let nm2: String = extract_fn_name(nl.substr(4, len(nl) - 4))
                        if len(nm2) > 0 { names.push(nm2) }
                    break
        pos = eol + 1
    names

fn build_test_main_ir(test_name: String) -> String:
    // mn_user_main.c calls @mn_main(); synthesize one that calls a
    // single @test function and returns 0. Assertion failures inside
    // the test call __mn_assert_fail → exit(1) before we return.
    let mut s: String = "\n; v5.13.1 At.2: per-test entry point synthesized by mnc test.\n"
    s = s + "define i32 @mn_main() {\n"
    s = s + "  call void @" + test_name + "()\n"
    s = s + "  ret i32 0\n"
    s = s + "}\n"
    return s

fn run_one_test(base_ir: String, test_name: String, clang_bin: String) -> Bool:
    let ll_path: String = "/tmp/mnc_test_" + test_name + ".ll"
    let o_path: String = "/tmp/mnc_test_" + test_name + ".o"
    let exe_path: String = "/tmp/mnc_test_" + test_name
    let full_ir: String = base_ir + build_test_main_ir(test_name)
    __mn_file_write(ll_path, full_ir)

    let r1: Int = __mn_system(clang_bin + " -c -O0 " + ll_path + " -o " + o_path + clang_stderr_redirect())
    if r1 != 0:
        __mn_str_eprint("    FAIL ")
        __mn_str_eprint(test_name)
        __mn_str_eprint("\n")
        report_clang_failure()
        return false
    let r2: Int = link_with_runtime(o_path, exe_path)
    if r2 != 0:
        __mn_str_eprint("    FAIL ")
        __mn_str_eprint(test_name)
        __mn_str_eprint(" (link failed)\n")
        return false
    let r3: Int = __mn_system(exe_path)
    if r3 == 0:
        print("    PASS " + test_name)
        return true
    __mn_str_eprint("    FAIL ")
    __mn_str_eprint(test_name)
    __mn_str_eprint("\n")
    return false

fn run_test(filename: String):
    let source: String = __mn_file_read_or_empty(filename)
    if len(source) == 0:
        __mn_str_eprint("FAIL ")
        __mn_str_eprint(filename)
        __mn_str_eprint(" (cannot read file)\n")
        __mn_exit(1)
    // v5.9.0 DX.3: probe clang before any work so the failure mode is
    // an install-instructions message instead of an opaque "FAIL ... clang failed".
    if !check_clang_available():
        print_clang_install_help()
        __mn_exit(1)
    let test_names: List<String> = discover_test_names(source)
    let cr: CompileResult = compile(source, filename)
    if !cr.success:
        print_compile_errors(cr)
        __mn_str_eprint("FAIL ")
        __mn_str_eprint(filename)
        __mn_str_eprint(" (compile errors)\n")
        __mn_exit(1)
    if len(test_names) == 0:
        print(filename)
        print("    no @test functions found")
        return
    print(filename)
    let base_ir: String = rename_main(cr.ir_text)
    let clang_bin: String = find_clang()
    let mut passed: Int = 0
    let mut failed: Int = 0
    let mut i: Int = 0
    let n: Int = len(test_names)
    for _ in 0..n:
        if i >= n { break }
        let name: String = test_names[i]
        let ok: Bool = run_one_test(base_ir, name, clang_bin)
        if ok { passed = passed + 1 } else { failed = failed + 1 }
        i = i + 1
    print("")
    print("result: " + str(passed) + " passed, " + str(failed) + " failed (" + str(n) + " total)")
    if failed > 0 { __mn_exit(1) }

// ---------------------------------------------------------------------------
// build — compile, link, produce executable
// ---------------------------------------------------------------------------

fn run_build(filename: String):
    // v5.9.0 DX.3: probe clang up front for the single-file path. The
    // directory path delegates to mnc-build.sh which has its own
    // toolchain detection.
    let ext: String = file_extension(filename)
    if len(ext) > 0 && !check_clang_available():
        print_clang_install_help()
        __mn_exit(1)

    // Directory build: delegate to mnc-build.sh for incremental compilation
    if len(ext) == 0:
        let mut cmd: String = "bash scripts/mnc-build.sh " + filename
        // Forward remaining args (e.g., -o output --timing)
        let mut ai: Int = 3
        for _ in 0..20:
            if ai >= __mn_argc() { ai = __mn_argc() + 1 }
            if ai < __mn_argc():
                cmd = cmd + " " + __mn_argv(ai)
                ai = ai + 1
        let r: Int = __mn_system(cmd)
        if r != 0 { __mn_exit(r) }
        return

    // Single-file build
    // Parse flags: -o <output>, --release, --debug, --small
    let mut out_name: String = "a.out"
    let mut opt_flag: String = "-O1"
    let mut strip_flag: String = ""
    let mut lto_flag: String = ""
    let mut ai2: Int = 3
    for _ in 0..20:
        if ai2 >= __mn_argc() { ai2 = __mn_argc() + 1 }
        if ai2 < __mn_argc():
            let fl: String = __mn_argv(ai2)
            if fl == "-o" && ai2 + 1 < __mn_argc():
                out_name = __mn_argv(ai2 + 1)
                ai2 = ai2 + 2
            if fl == "--release":
                opt_flag = "-O2"
                lto_flag = " -flto"
                strip_flag = " -s"
                ai2 = ai2 + 1
            if fl == "--debug":
                opt_flag = "-O0"
                ai2 = ai2 + 1
            if fl == "--small":
                opt_flag = "-Os"
                lto_flag = " -flto"
                strip_flag = " -s"
                ai2 = ai2 + 1
            if fl != "-o" && fl != "--release" && fl != "--debug" && fl != "--small":
                ai2 = ai2 + 1

    let source: String = __mn_file_read_or_empty(filename)
    if len(source) <= 0:
        __mn_str_eprint("error: cannot read file '")
        __mn_str_eprint(filename)
        __mn_str_eprint("'\n")
        __mn_exit(1)
    let cr: CompileResult = compile(source, filename)
    if !cr.success:
        print_compile_errors(cr)
        __mn_exit(1)
    // Rename @main → @mn_main so the C wrapper provides the real main()
    __mn_file_write("/tmp/mnc_build.ll", rename_main(cr.ir_text))

    // Compile with selected optimization level. v5.9.0 DX.3: clang stderr
    // captured to a temp file so report_clang_failure() can surface the
    // real diagnostic instead of bare "clang failed". v5.10.0 Win.1b.D:
    // clang resolved via find_clang() — bundled if present, PATH otherwise.
    let clang_bin: String = find_clang()
    let clang_cmd: String = clang_bin + " -c " + opt_flag + " /tmp/mnc_build.ll -o /tmp/mnc_build.o" + clang_stderr_redirect()
    let r1: Int = __mn_system(clang_cmd)
    if r1 != 0:
        report_clang_failure()
        __mn_exit(1)

    // Link
    let r2: Int = link_with_runtime("/tmp/mnc_build.o", out_name)
    // Strip if release/small mode
    if len(strip_flag) > 0:
        let strip_cmd: String = "strip " + out_name + __mn_dev_null_redirect()
        __mn_system(strip_cmd)
    if r2 != 0:
        __mn_str_eprint("error: link failed\n")
        __mn_exit(1)

    print("built: " + out_name)

// ---------------------------------------------------------------------------
// run — compile, link, execute in one step
// ---------------------------------------------------------------------------

fn run_program(filename: String):
    let source: String = __mn_file_read_or_empty(filename)
    if len(source) <= 0:
        __mn_str_eprint("error: cannot read file '")
        __mn_str_eprint(filename)
        __mn_str_eprint("'\n")
        __mn_exit(1)
    // v5.9.0 DX.3: probe clang first; saves the user a wasted compile cycle
    // when the real fix is "install LLVM".
    if !check_clang_available():
        print_clang_install_help()
        __mn_exit(1)
    let cr: CompileResult = compile(source, filename)
    if !cr.success:
        print_compile_errors(cr)
        __mn_exit(1)
    __mn_file_write("/tmp/mnc_run.ll", rename_main(cr.ir_text))

    // Single-step compile+link via clang (faster than separate clang + gcc).
    // v5.10.0 Win.1b.D: clang resolved via find_clang() — bundled if present,
    // PATH otherwise. Both the fast path and the two-step fallback share it.
    let clang_bin: String = find_clang()
    let compile_cmd: String = clang_bin + " -O0 /tmp/mnc_run.ll runtime/native/libmapanare_rt.a -o /tmp/mnc_run -lm -lpthread" + clang_stderr_redirect()
    let r1: Int = __mn_system(compile_cmd)
    if r1 != 0:
        // Fall back to two-step compile+link
        let r1b: Int = __mn_system(clang_bin + " -c -O0 /tmp/mnc_run.ll -o /tmp/mnc_run.o" + clang_stderr_redirect())
        if r1b != 0:
            report_clang_failure()
            __mn_exit(1)
        let r2: Int = link_with_runtime("/tmp/mnc_run.o", "/tmp/mnc_run")
        if r2 != 0:
            __mn_str_eprint("error: link failed\n")
            __mn_exit(1)

    // Build command with forwarded args: /tmp/mnc_run [args...]
    let mut cmd: String = "/tmp/mnc_run"
    let mut ai: Int = 3
    for _ in 0..100:
        if ai >= __mn_argc() { ai = __mn_argc() + 1 }
        if ai < __mn_argc():
            cmd = cmd + " " + __mn_argv(ai)
            ai = ai + 1
    let r3: Int = __mn_system(cmd)
    if r3 != 0:
        __mn_exit(r3)

// ---------------------------------------------------------------------------
// emit-llvm — compile to LLVM IR, print to stdout or write to file with -o.
// v5.9.1 DX.5: lifted out of mn_main's default fall-through. Pre-v5.9.1
// `mnc <file.mn>` emitted IR; v5.9.1 makes that path implicit-run and
// moves IR-emission behind this explicit subcommand.
// ---------------------------------------------------------------------------

// v5.14.1 B.7: dump the result of running `__mn_indent_to_braces`
// over a source file. Used by tests/bootstrap/test_indent_preprocessor.py
// to assert byte-identical output between the Python and C
// implementations on every parseable golden.
fn run_preprocess(filename: String):
    let source: String = __mn_file_read_or_empty(filename)
    if len(source) <= 0:
        __mn_str_eprint("error: cannot read file '")
        __mn_str_eprint(filename)
        __mn_str_eprint("'\n")
        __mn_exit(1)
    let preprocessed: String = __mn_indent_to_braces(source)
    print(preprocessed)

fn run_emit_llvm(filename: String):
    let source: String = __mn_file_read_or_empty(filename)
    if len(source) <= 0:
        __mn_str_eprint("error: cannot read file '")
        __mn_str_eprint(filename)
        __mn_str_eprint("'\n")
        __mn_exit(1)
    let cr: CompileResult = compile(source, filename)
    if !cr.success:
        for i in 0..len(cr.errors):
            let err: SemanticError = cr.errors[i]
            __mn_str_eprint(format_error(err))
            __mn_str_eprint("\n")
        __mn_exit(1)
    // Optional `-o <path>`: write IR to file instead of stdout.
    let mut out_path: String = ""
    if __mn_argc() >= 5:
        let flag: String = __mn_argv(3)
        if flag == "-o":
            out_path = __mn_argv(4)
    if len(out_path) > 0:
        __mn_file_write(out_path, cr.ir_text)
    else:
        print(cr.ir_text)

// ---------------------------------------------------------------------------
// compile — transpile foreign source (.py/.php/.ts/.go) then compile to native.
// For non-.mn files, shells out to the transpiler binary (mnc-transpile) or
// falls back to the Python CLI for transpilation, then compiles the .mn output.
// ---------------------------------------------------------------------------

fn run_compile(filename: String):
    let source: String = __mn_file_read_or_empty(filename)
    if len(source) <= 0:
        __mn_str_eprint("error: cannot read file '")
        __mn_str_eprint(filename)
        __mn_str_eprint("'\n")
        __mn_exit(1)
    // v5.9.0 DX.3: probe clang up front. compile applies to both the .mn
    // and the foreign-source paths; both ultimately invoke clang.
    if !check_clang_available():
        print_clang_install_help()
        __mn_exit(1)

    let ext: String = file_extension(filename)

    // .mn files compile directly
    if ext == ".mn":
        let cr: CompileResult = compile(source, filename)
        if !cr.success:
            print_compile_errors(cr)
            __mn_exit(1)
        let mut out_name: String = "a.out"
        if __mn_argc() >= 4:
            let flag: String = __mn_argv(3)
            if flag == "-o" && __mn_argc() >= 5:
                out_name = __mn_argv(4)
        __mn_file_write("/tmp/mnc_compile.ll", rename_main(cr.ir_text))
        // v5.10.0 Win.1b.D: clang resolved via find_clang() — bundled if present.
        let clang_bin: String = find_clang()
        let r1: Int = __mn_system(clang_bin + " -c -O2 /tmp/mnc_compile.ll -o /tmp/mnc_compile.o" + clang_stderr_redirect())
        if r1 != 0:
            report_clang_failure()
            __mn_exit(1)
        let r2: Int = link_with_runtime("/tmp/mnc_compile.o", out_name)
        if r2 != 0:
            __mn_str_eprint("error: link failed\n")
            __mn_exit(1)
        print("compiled: " + out_name)
        return

    // Foreign source: transpile via mapanare CLI, then compile the .mn result
    let mut ok: Bool = false
    if ext == ".py" { ok = true }
    if ext == ".php" { ok = true }
    if ext == ".ts" { ok = true }
    if ext == ".go" { ok = true }
    if !ok:
        __mn_str_eprint("error: unsupported file type '")
        __mn_str_eprint(ext)
        __mn_str_eprint("' (supported: .mn, .py, .php, .ts, .go)\n")
        __mn_exit(1)

    // Transpile to .mn via the Python CLI (mapanare transpile <file> -o /tmp/mnc_transpiled.mn)
    let transpile_cmd: String = "mapanare transpile " + filename + " -o /tmp/mnc_transpiled.mn" + __mn_dev_null_redirect()
    let rt: Int = __mn_system(transpile_cmd)
    if rt != 0:
        __mn_str_eprint("error: transpilation failed for '")
        __mn_str_eprint(filename)
        __mn_str_eprint("'\n")
        __mn_exit(1)

    // Now compile the transpiled .mn source
    let mn_source: String = __mn_file_read_or_empty("/tmp/mnc_transpiled.mn")
    if len(mn_source) == 0:
        __mn_str_eprint("error: transpiler produced empty output\n")
        __mn_exit(1)

    let cr2: CompileResult = compile(mn_source, filename)
    if !cr2.success:
        print_compile_errors(cr2)
        __mn_exit(1)

    let mut out_name2: String = "a.out"
    if __mn_argc() >= 4:
        let flag2: String = __mn_argv(3)
        if flag2 == "-o" && __mn_argc() >= 5:
            out_name2 = __mn_argv(4)

    __mn_file_write("/tmp/mnc_compile.ll", rename_main(cr2.ir_text))
    // v5.10.0 Win.1b.D: clang resolved via find_clang() — bundled if present.
    let clang_bin: String = find_clang()
    let r3: Int = __mn_system(clang_bin + " -c -O2 /tmp/mnc_compile.ll -o /tmp/mnc_compile.o" + clang_stderr_redirect())
    if r3 != 0:
        report_clang_failure()
        __mn_exit(1)
    let r4: Int = link_with_runtime("/tmp/mnc_compile.o", out_name2)
    if r4 != 0:
        __mn_str_eprint("error: link failed\n")
        __mn_exit(1)
    print("compiled: " + out_name2)

// ---------------------------------------------------------------------------
// mn_main — native compiler entry point (called from C shim)
//
// Reads source file from argv[1], compiles to LLVM IR, prints to stdout.
// Errors go to stderr. Returns exit code via __mn_exit.
// ---------------------------------------------------------------------------

fn mn_main():
    if __mn_argc() < 2:
        __mn_str_eprint("usage: mnc <file.mn>           (compile and run)\n")
        __mn_str_eprint("       mnc emit-llvm <file.mn> (compile to IR)\n")
        __mn_str_eprint("       mnc test <file.mn>\n")
        __mn_str_eprint("       mnc build <file.mn|dir> [-o output] [--timing]\n")
        __mn_str_eprint("       mnc run <file.mn> [args...]\n")
        __mn_str_eprint("       mnc compile <file> [-o output]\n")
        __mn_str_eprint("       mnc cache <stats|clean>\n")
        __mn_str_eprint("       mnc version\n")
        __mn_str_eprint("       mnc --help              (or 'mnc help <subcommand>')\n")
        __mn_exit(1)
    let arg1: String = __mn_argv(1)

    // v5.9.0 DX.1: help dispatch — pre-v5.9.0 these fell through and
    // surfaced as ``error: cannot read file '--help'``.
    if arg1 == "--help" || arg1 == "-h" || arg1 == "help":
        if __mn_argc() >= 3:
            print_subcommand_help(__mn_argv(2))
        else:
            print_help_text()
        return

    // Per-subcommand help: ``mnc <sub> --help`` prints just that sub's
    // usage. Cheaper than threading a flag through each run_* helper.
    if __mn_argc() >= 3 && __mn_argv(2) == "--help":
        print_subcommand_help(arg1)
        return

    // Subcommands
    if arg1 == "test":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc test <file.mn>\n")
            __mn_exit(1)
        run_test(__mn_argv(2))
        return
    if arg1 == "build":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc build <file.mn> [-o output]\n")
            __mn_exit(1)
        run_build(__mn_argv(2))
        return
    if arg1 == "run":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc run <file.mn> [args...]\n")
            __mn_exit(1)
        run_program(__mn_argv(2))
        return
    if arg1 == "cache":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc cache <stats|clean>\n")
            __mn_exit(1)
        let cache_cmd: String = __mn_argv(2)
        // v5.9.0 DX.4: native rewrite. Pre-v5.9.0 both branches shelled
        // out to POSIX-only commands (``rm -rf`` / ``find ... | wc -l`` /
        // bash ``[ -d ... ]``); on Windows __mn_system invokes cmd.exe
        // and surfaced ``-d was unexpected at this time``. The runtime
        // helpers __mn_dir_remove_recursive / __mn_dir_count_files /
        // __mn_dir_total_size are platform-aware.
        if cache_cmd == "clean":
            if __mn_file_exists(".mnc_cache") == 0:
                print("No cache to clear.")
                return
            let rc: Int = __mn_dir_remove_recursive(".mnc_cache")
            if rc == 0:
                print("Cache cleared.")
            else:
                __mn_str_eprint("error: failed to remove .mnc_cache\n")
                __mn_exit(1)
            return
        if cache_cmd == "stats":
            if __mn_file_exists(".mnc_cache") == 0:
                print("No cache (run mnc build <dir> first)")
                return
            let count: Int = __mn_dir_count_files(".mnc_cache")
            let total: Int = __mn_dir_total_size(".mnc_cache")
            print("Cache: .mnc_cache/")
            print("  Files: " + str(count))
            print("  Size: " + format_bytes(total))
            if __mn_file_exists(".mnc_cache/manifest.txt") != 0:
                let manifest: String = __mn_file_read_or_empty(".mnc_cache/manifest.txt")
                print("  Modules: " + str(count_lines(manifest)))
            return
        __mn_str_eprint("unknown cache command: ")
        __mn_str_eprint(cache_cmd)
        __mn_str_eprint("\n")
        __mn_exit(1)
    if arg1 == "emit-llvm":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc emit-llvm <file.mn> [-o output]\n")
            __mn_exit(1)
        run_emit_llvm(__mn_argv(2))
        return
    // v5.14.1 B.7: hidden test hook — print the result of
    // `__mn_indent_to_braces(file)` to stdout. Used by the cross-
    // bootstrap test to verify the C preprocessor agrees byte-for-byte
    // with the Python `_indent_to_braces`.
    if arg1 == "preprocess":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc preprocess <file.mn>\n")
            __mn_exit(1)
        run_preprocess(__mn_argv(2))
        return
    // v5.13.0 Mc.2: fmt — canonicalize whitespace in .mn source. The
    // formatter logic lives in Python (mapanare/format.py); the native
    // dispatch shells out to ``mapanare fmt``. Porting format.py to .mn
    // is out of scope for v5.13.0 — the Python implementation is the
    // single source of truth, and a future Mc.* release can mirror it
    // in self/ if the shell-out becomes a measurable hot path.
    if arg1 == "fmt":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc fmt <path...> [--check] [--stdout] [--to-terse] [--to-braces]\n")
            __mn_exit(1)
        let mut fmt_cmd: String = "mapanare fmt"
        let mut fa: Int = 2
        for _ in 0..64:
            if fa >= __mn_argc() { fa = __mn_argc() + 1 }
            if fa < __mn_argc():
                fmt_cmd = fmt_cmd + " " + __mn_argv(fa)
                fa = fa + 1
        let fr: Int = __mn_system(fmt_cmd)
        if fr != 0 { __mn_exit(fr) }
        return
    // v5.18.0 Mc.4: check — shell out to ``mapanare check``. Native port
    // tracked on the follow-up docket; the Python implementation drives
    // diagnostics through the same parser+semantic stack the LSP uses.
    if arg1 == "check":
        let mut chk_cmd: String = "mapanare check"
        let mut ca: Int = 2
        for _ in 0..64:
            if ca >= __mn_argc() { ca = __mn_argc() + 1 }
            if ca < __mn_argc():
                chk_cmd = chk_cmd + " " + __mn_argv(ca)
                ca = ca + 1
        let cr_check: Int = __mn_system(chk_cmd)
        if cr_check != 0 { __mn_exit(cr_check) }
        return
    // v5.18.0 Mc.3: init — shell out to ``mapanare init``. Scaffolds a
    // new project from mapanare/templates/init/<template>/. Native port
    // tracked on the follow-up docket.
    if arg1 == "init":
        let mut init_cmd: String = "mapanare init"
        let mut ia: Int = 2
        for _ in 0..64:
            if ia >= __mn_argc() { ia = __mn_argc() + 1 }
            if ia < __mn_argc():
                init_cmd = init_cmd + " " + __mn_argv(ia)
                ia = ia + 1
        let ir_init: Int = __mn_system(init_cmd)
        if ir_init != 0 { __mn_exit(ir_init) }
        return
    // v5.18.0 Mc.1: lsp — shell out to the pygls-based language server.
    // Editor extensions launching ``mnc lsp`` get the same protocol they
    // would from ``mapanare lsp`` or ``mapanare-lsp``. Native ``.mn``
    // LSP is deferred (PLAN risk register).
    if arg1 == "lsp":
        let mut lsp_cmd: String = "mapanare lsp"
        let mut la: Int = 2
        for _ in 0..64:
            if la >= __mn_argc() { la = __mn_argc() + 1 }
            if la < __mn_argc():
                lsp_cmd = lsp_cmd + " " + __mn_argv(la)
                la = la + 1
        let lr: Int = __mn_system(lsp_cmd)
        if lr != 0 { __mn_exit(lr) }
        return
    if arg1 == "compile":
        if __mn_argc() < 3:
            __mn_str_eprint("usage: mnc compile <file> [-o output]\n")
            __mn_exit(1)
        run_compile(__mn_argv(2))
        return
    if arg1 == "version" || arg1 == "--version":
        print(version())
        return

    // v5.9.1 DX.5: implicit run is the default for .mn files. Pre-v5.9.1
    // the default was IR emission; that path moved to `mnc emit-llvm`.
    // v5.11.0 Pk.2: removed the one-release stderr deprecation hint that
    // v5.9.1 / v5.10.0 carried for downstream CI scripts.
    let filename: String = arg1
    let ext_check: String = file_extension(filename)
    if ext_check == ".mn":
        run_program(filename)
        return

    // Non-.mn files: error with migration hint pointing at the right surface.
    __mn_str_eprint("error: '")
    __mn_str_eprint(filename)
    __mn_str_eprint("' is not a .mn file.\n")
    __mn_str_eprint("       Use 'mnc emit-llvm <file>' for raw IR emission, or\n")
    __mn_str_eprint("       'mnc compile <file>' for transpilation (.py/.php/.ts/.go).\n")
    __mn_exit(1)
