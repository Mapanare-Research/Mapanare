// mir_opt.mn — MIR optimizer for the Mapanare self-hosted compiler.
// Seven passes: constant folding, constant propagation, dead block elimination,
// strength reduction, function inlining, LICM, escape analysis.
// v4.97.0: ported all Arc 11-12 optimization passes from Python bootstrap.
// Wired into compile() after lower(), before emit().

import self::mir

// ---------------------------------------------------------------------------
// Pass 1: Constant folding
// Fold BinOp(Const(a), op, Const(b)) → Const(result)
// ---------------------------------------------------------------------------

fn fold_int_binop(op: BinOpKind, a: Int, b: Int) -> Option<Int>:
    match op:
        Add => { return Some(a + b) }
        Sub => { return Some(a - b) }
        Mul => { return Some(a * b) }
        _ => { return none }

fn try_fold_instruction(inst: Instruction) -> Option<Instruction>:
    let ik: String = instr_kind(inst)
    if ik != "binop" { return none }
    let lhs: Value = instr_binop_lhs(inst)
    let rhs: Value = instr_binop_rhs(inst)
    let op: BinOpKind = instr_binop_op(inst)
    let dest: Value = instr_dest(inst)
    // Both operands must be named constants (format: literal value string)
    // Check if lhs and rhs names are integer literals
    if lhs.ty.kind != TK_INT() { return none }
    if rhs.ty.kind != TK_INT() { return none }
    // Names that start with % are SSA temps, not constants
    if lhs.name.starts_with("%") { return none }
    if rhs.name.starts_with("%") { return none }
    let a: Int = int(lhs.name)
    let b: Int = int(rhs.name)
    let result_opt: Option<Int> = fold_int_binop(op, a, b)
    match result_opt {
        Some(r) => {
            return Some(Instruction::Const(dest, mir_int(), toString(r)))
        },
        _ => { return none }
    }

fn constant_fold_block(bb: BasicBlock) -> BasicBlock:
    let mut new_instrs: List<Instruction> = []
    let mut i: Int = 0
    let mut changed: Bool = false
    for _ in 0..10000:
        if i >= len(bb.instructions):
            if changed:
                return new BasicBlock { label: bb.label, instructions: new_instrs }
            return bb
        let inst: Instruction = bb.instructions[i]
        let folded: Option<Instruction> = try_fold_instruction(inst)
        match folded {
            Some(new_inst) => {
                new_instrs.push(new_inst)
                changed = true
            },
            _ => { new_instrs.push(inst) }
        }
        i = i + 1
    return bb

fn constant_fold_function(f: MIRFunction) -> MIRFunction:
    let mut new_blocks: List<BasicBlock> = []
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(f.blocks):
            return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }
        new_blocks.push(constant_fold_block(f.blocks[i]))
        i = i + 1
    return f

// ---------------------------------------------------------------------------
// Pass 2: Constant propagation
// If Const(dest, ty, val), replace all uses of dest.name with the constant value.
// ---------------------------------------------------------------------------

struct ConstEntry:
    name: String
    value: String
    ty: MIRType

fn find_const(consts: List<ConstEntry>, name: String) -> Option<String>:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(consts) { return none }
        if consts[i].name == name { return Some(consts[i].value) }
        i = i + 1
    return none

fn find_const_ty(consts: List<ConstEntry>, name: String) -> MIRType:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(consts) { return mir_unknown() }
        if consts[i].name == name { return consts[i].ty }
        i = i + 1
    return mir_unknown()

fn replace_value(v: Value, consts: List<ConstEntry>) -> Value:
    let opt: Option<String> = find_const(consts, v.name)
    match opt {
        Some(cv) => {
            let ct: MIRType = find_const_ty(consts, v.name)
            return new Value { name: cv, ty: ct }
        },
        _ => { return v }
    }

fn propagate_in_instruction(inst: Instruction, consts: List<ConstEntry>) -> Instruction:
    let ik: String = instr_kind(inst)
    // Replace operands in BinOp
    if ik == "binop":
        let lhs: Value = replace_value(instr_binop_lhs(inst), consts)
        let rhs: Value = replace_value(instr_binop_rhs(inst), consts)
        return Instruction::BinOp(instr_dest(inst), instr_binop_op(inst), lhs, rhs)
    // Replace source in Copy
    if ik == "copy":
        let src: Value = replace_value(instr_copy_src(inst), consts)
        return Instruction::Copy(instr_dest(inst), src)
    return inst

fn const_prop_function(f: MIRFunction) -> MIRFunction:
    // Collect all Const definitions across all blocks
    let mut consts: List<ConstEntry> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let bb: BasicBlock = f.blocks[bi]
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(bb.instructions) { break }
            let inst: Instruction = bb.instructions[ii]
            if instr_kind(inst) == "const":
                let dest: Value = instr_dest(inst)
                let cval: String = instr_const_val(inst)
                // Only propagate simple integer constants (safe for BinOp operands)
                if len(cval) > 0 && dest.name.starts_with("%") && dest.ty.kind == TK_INT():
                    let entry: ConstEntry = new ConstEntry { name: dest.name, value: cval, ty: dest.ty }
                    consts.push(entry)
            ii = ii + 1
        bi = bi + 1
    if len(consts) == 0 { return f }
    // Propagate constants through instructions
    let mut new_blocks: List<BasicBlock> = []
    let mut bi2: Int = 0
    for _ in 0..5000:
        if bi2 >= len(f.blocks) { break }
        let bb: BasicBlock = f.blocks[bi2]
        let mut new_instrs: List<Instruction> = []
        let mut ji: Int = 0
        for _ in 0..10000:
            if ji >= len(bb.instructions) { break }
            new_instrs.push(propagate_in_instruction(bb.instructions[ji], consts))
            ji = ji + 1
        new_blocks.push(new BasicBlock { label: bb.label, instructions: new_instrs })
        bi2 = bi2 + 1
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }

// ---------------------------------------------------------------------------
// Pass 3: Dead block elimination
// Walk from entry block, mark reachable blocks, delete unreachable
// ---------------------------------------------------------------------------

fn collect_targets(inst: Instruction) -> List<String>:
    let ik: String = instr_kind(inst)
    let mut targets: List<String> = []
    if ik == "jump":
        targets.push(instr_jump_target(inst))
    if ik == "branch":
        targets.push(instr_branch_true(inst))
        targets.push(instr_branch_false(inst))
    if ik == "switch":
        // Switch: collect case targets + default
        let cases: List<SwitchCase> = instr_switch_cases(inst)
        let mut ci: Int = 0
        for _ in 0..200:
            if ci >= len(cases) { break }
            targets.push(cases[ci].block_label)
            ci = ci + 1
        targets.push(instr_switch_default(inst))
    return targets

fn is_in_list(name: String, lst: List<String>) -> Bool:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(lst) { return false }
        if lst[i] == name { return true }
        i = i + 1
    return false

fn clean_phi_entries(inst: Instruction, reachable: List<String>) -> Instruction:
    let entries: List<PhiEntry> = instr_phi_entries(inst)
    let mut kept: List<PhiEntry> = []
    let mut ei: Int = 0
    for _ in 0..200:
        if ei >= len(entries) { break }
        if is_in_list(entries[ei].block_label, reachable):
            kept.push(entries[ei])
        ei = ei + 1
    if len(kept) == len(entries) { return inst }
    return Instruction::Phi(instr_dest(inst), kept)

fn phi_needs_cleaning(bb: BasicBlock, reachable: List<String>) -> Bool:
    // Check if any PHI in this block references a non-reachable block
    let mut ji: Int = 0
    for _ in 0..10000:
        if ji >= len(bb.instructions) { break }
        let inst: Instruction = bb.instructions[ji]
        if instr_kind(inst) == "phi":
            let entries: List<PhiEntry> = instr_phi_entries(inst)
            let mut ei: Int = 0
            for _ in 0..200:
                if ei >= len(entries) { break }
                if is_in_list(entries[ei].block_label, reachable) == false:
                    return true
                ei = ei + 1
        ji = ji + 1
    return false

fn clean_phis_in_block(bb: BasicBlock, reachable: List<String>) -> BasicBlock:
    // Only rebuild if this block actually has PHIs referencing removed blocks
    if phi_needs_cleaning(bb, reachable) == false { return bb }
    let saved_label: String = bb.label
    let mut new_instrs: List<Instruction> = []
    let mut ji: Int = 0
    for _ in 0..10000:
        if ji >= len(bb.instructions) { break }
        let inst: Instruction = bb.instructions[ji]
        if instr_kind(inst) == "phi":
            let cleaned: Instruction = clean_phi_entries(inst, reachable)
            new_instrs.push(cleaned)
        else:
            new_instrs.push(inst)
        ji = ji + 1
    return new BasicBlock { label: saved_label, instructions: new_instrs }

fn block_terminator_targets(bb: BasicBlock) -> List<String>:
    // Only check the last instruction (terminator) — matches Python _compute_reachable
    if len(bb.instructions) == 0:
        let empty: List<String> = []
        return empty
    let last: Instruction = bb.instructions[len(bb.instructions) - 1]
    return collect_targets(last)

fn find_block_by_label(blocks: List<BasicBlock>, label: String) -> Option<BasicBlock>:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(blocks) { return none }
        if blocks[i].label == label { return Some(blocks[i]) }
        i = i + 1
    return none

fn add_targets_to_worklist(targets: List<String>, reachable: List<String>, worklist: List<String>) -> Bool:
    let mut ti: Int = 0
    let mut added: Bool = false
    for _ in 0..500:
        if ti >= len(targets) { break }
        if is_in_list(targets[ti], reachable) == false:
            reachable.push(targets[ti])
            worklist.push(targets[ti])
            added = true
        ti = ti + 1
    return added

fn collect_phi_refs(f: MIRFunction) -> List<String>:
    // Collect all block labels referenced by PHI entries in any block
    let mut refs: List<String> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            if instr_kind(f.blocks[bi].instructions[ii]) == "phi":
                let entries: List<PhiEntry> = instr_phi_entries(f.blocks[bi].instructions[ii])
                let mut ei: Int = 0
                for _ in 0..200:
                    if ei >= len(entries) { break }
                    if is_in_list(entries[ei].block_label, refs) == false:
                        refs.push(entries[ei].block_label)
                    ei = ei + 1
            ii = ii + 1
        bi = bi + 1
    return refs

fn dead_block_elim_function(f: MIRFunction) -> MIRFunction:
    if len(f.blocks) <= 1 { return f }
    // Fixed-point reachability: start with entry, iterate until stable
    let mut reachable: List<String> = []
    reachable.push(f.blocks[0].label)
    let mut changed: Bool = true
    for _ in 0..1000:
        if changed == false { break }
        changed = false
        let mut bi: Int = 0
        for _ in 0..5000:
            if bi >= len(f.blocks) { break }
            if is_in_list(f.blocks[bi].label, reachable):
                let targets: List<String> = block_terminator_targets(f.blocks[bi])
                let mut ti: Int = 0
                for _ in 0..500:
                    if ti >= len(targets) { break }
                    if is_in_list(targets[ti], reachable) == false:
                        reachable.push(targets[ti])
                        changed = true
                    ti = ti + 1
            bi = bi + 1
    // Also keep blocks referenced by PHI entries to avoid dangling labels
    let phi_refs: List<String> = collect_phi_refs(f)
    let mut pi: Int = 0
    for _ in 0..5000:
        if pi >= len(phi_refs) { break }
        if is_in_list(phi_refs[pi], reachable) == false:
            reachable.push(phi_refs[pi])
        pi = pi + 1
    // Extend reachability from PHI-preserved blocks (they may jump to other blocks)
    let mut changed2: Bool = true
    for _ in 0..1000:
        if changed2 == false { break }
        changed2 = false
        let mut bi2: Int = 0
        for _ in 0..5000:
            if bi2 >= len(f.blocks) { break }
            if is_in_list(f.blocks[bi2].label, reachable):
                let targets2: List<String> = block_terminator_targets(f.blocks[bi2])
                let mut ti2: Int = 0
                for _ in 0..500:
                    if ti2 >= len(targets2) { break }
                    if is_in_list(targets2[ti2], reachable) == false:
                        reachable.push(targets2[ti2])
                        changed2 = true
                    ti2 = ti2 + 1
            bi2 = bi2 + 1
    // v4.30.0 Phase 3.3: walk the surviving blocks once and drop PHI
    // entries that reference blocks that did NOT survive. Prior to
    // v4.30.0, ``clean_phis_in_block`` was defined (line 262) but
    // never invoked — Rattler #6 flagged it as dead-code-in-the-
    // optimizer. Without this step, the pass could leave a PHI
    // referencing a block that the block removal loop just deleted,
    // which is the "dangling label" class of bug.
    let mut cleaned_blocks: List<BasicBlock> = []
    let mut ki: Int = 0
    for _ in 0..5000:
        if ki >= len(f.blocks) { break }
        if is_in_list(f.blocks[ki].label, reachable):
            let cleaned: BasicBlock = clean_phis_in_block(f.blocks[ki], reachable)
            cleaned_blocks.push(cleaned)
        ki = ki + 1
    if len(cleaned_blocks) >= len(f.blocks):
        // Same block count — either nothing was dropped, or every
        // dropped block had already been pruned by a previous pass.
        // Still return the cleaned version because PHI entries may
        // have been trimmed even when no block vanished.
        return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: cleaned_blocks, decorators: f.decorators, is_public: f.is_public }
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: cleaned_blocks, decorators: f.decorators, is_public: f.is_public }

// ---------------------------------------------------------------------------
// Pass 4: Strength reduction (v4.97.0)
// x % 2^n → x & (2^n - 1) — replace modulo by power-of-two with bitmask
// ---------------------------------------------------------------------------

fn is_power_of_two(n: Int) -> Bool:
    if n <= 0 { return false }
    // n & (n-1) == 0 means n is a power of 2
    let check: Int = n - 1
    // Mapanare doesn't have bitwise AND on Int, so check manually
    // Powers of 2: 1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, ...
    let mut p: Int = 1
    for _ in 0..63:
        if p == n { return true }
        p = p * 2
    return false

fn power_of_two_mask(n: Int) -> Int:
    // Returns n - 1 (the bitmask for x % n when n is power of 2)
    return n - 1

fn try_strength_reduce(inst: Instruction) -> Option<Instruction>:
    let ik: String = instr_kind(inst)
    if ik != "binop" { return none }
    let op: BinOpKind = instr_binop_op(inst)
    // Only reduce Mod operations
    match op {
        Mod => {
            let rhs: Value = instr_binop_rhs(inst)
            // RHS must be a constant integer
            if rhs.ty.kind != TK_INT() { return none }
            if rhs.name.starts_with("%") { return none }
            let n: Int = int(rhs.name)
            if is_power_of_two(n) {
                let mask: Int = power_of_two_mask(n)
                let mask_val: Value = new Value { name: toString(mask), ty: rhs.ty }
                // x % 2^n → x & (2^n - 1)
                return Some(Instruction::BinOp(instr_dest(inst), BinOpKind::And, instr_binop_lhs(inst), mask_val))
            }
            return none
        },
        _ => { return none }
    }

fn strength_reduce_block(bb: BasicBlock) -> BasicBlock:
    let mut new_instrs: List<Instruction> = []
    let mut i: Int = 0
    let mut changed: Bool = false
    for _ in 0..10000:
        if i >= len(bb.instructions):
            if changed:
                return new BasicBlock { label: bb.label, instructions: new_instrs }
            return bb
        let inst: Instruction = bb.instructions[i]
        let reduced: Option<Instruction> = try_strength_reduce(inst)
        match reduced {
            Some(new_inst) => {
                new_instrs.push(new_inst)
                changed = true
            },
            _ => { new_instrs.push(inst) }
        }
        i = i + 1
    return bb

fn strength_reduce_function(f: MIRFunction) -> MIRFunction:
    let mut new_blocks: List<BasicBlock> = []
    let mut i: Int = 0
    let mut changed: Bool = false
    for _ in 0..5000:
        if i >= len(f.blocks):
            if changed:
                return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }
            return f
        let orig: BasicBlock = f.blocks[i]
        let reduced: BasicBlock = strength_reduce_block(orig)
        new_blocks.push(reduced)
        if reduced.label != orig.label || len(reduced.instructions) != len(orig.instructions):
            changed = true
        i = i + 1
    return f

// ---------------------------------------------------------------------------
// Pass 5: Function inlining (v4.97.0)
// Inline small, non-recursive, single-block callees into their call sites.
// Heuristic: body < 20 instructions, not recursive, call_count * body_size < 200.
// Caps at 5 inlines per function to prevent cascading.
// ---------------------------------------------------------------------------

struct FnLookupEntry:
    name: String
    func: MIRFunction

fn find_fn_by_name(lookup: List<FnLookupEntry>, name: String) -> Option<MIRFunction>:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(lookup) { return none }
        if lookup[i].name == name { return Some(lookup[i].func) }
        i = i + 1
    return none

fn instruction_count(f: MIRFunction) -> Int:
    let mut count: Int = 0
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return count }
        count = count + len(f.blocks[bi].instructions)
        bi = bi + 1
    return count

fn is_recursive(f: MIRFunction) -> Bool:
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return false }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            if instr_kind(inst) == "call":
                if instr_call_fn(inst) == f.name { return true }
            ii = ii + 1
        bi = bi + 1
    return false

fn should_inline(callee: MIRFunction, call_count: Int) -> Bool:
    // Only single-block callees (no branches, no phi, no switch)
    if len(callee.blocks) != 1 { return false }
    if is_recursive(callee) { return false }
    if callee.name == "main" { return false }
    // v5.5.4 Sh.4 Phase 1: never inline async fns. In v5.5.4+ the
    // emitter wraps every async fn with coroutine scaffolding
    // (presplitcoroutine attr + coro.id/begin prologue + future
    // alloc + initial suspend + ret→future.payload rewrite + coro.
    // final/cleanup/ret epilogue). Inlining that body into a non-
    // async caller would splice coroutine intrinsics into a
    // non-presplit function — LLVM's CoroSplit pass wouldn't run
    // and the IR would be malformed. Safe to reject categorically
    // because async fns are called via BlockOn or AwaitSuspend
    // (which handle the future extraction), never invoked as a
    // plain call whose result is used directly.
    if fn_is_async(callee) { return false }
    let body_size: Int = instruction_count(callee)
    if body_size == 0 { return false }
    if body_size > 20 { return false }
    if call_count * body_size > 200 { return false }
    return true

// Count how many times each function is called within fn
struct CallCount:
    name: String
    count: Int

fn count_calls(f: MIRFunction, lookup: List<FnLookupEntry>) -> List<CallCount>:
    let mut counts: List<CallCount> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            if instr_kind(inst) == "call":
                let fn_name: String = instr_call_fn(inst)
                // Check if this function exists in lookup
                let fn_opt: Option<MIRFunction> = find_fn_by_name(lookup, fn_name)
                match fn_opt {
                    Some(_) => {
                        // Find or create count entry
                        let mut found: Bool = false
                        let mut ci: Int = 0
                        for _ in 0..1000 {
                            if ci >= len(counts) { break }
                            if counts[ci].name == fn_name {
                                counts[ci] = new CallCount { name: fn_name, count: counts[ci].count + 1 }
                                found = true
                                break
                            }
                            ci = ci + 1
                        }
                        if found == false {
                            counts.push(new CallCount { name: fn_name, count: 1 })
                        }
                    },
                    _ => {}
                }
            ii = ii + 1
        bi = bi + 1
    return counts

fn get_call_count(counts: List<CallCount>, name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..1000:
        if i >= len(counts) { return 0 }
        if counts[i].name == name { return counts[i].count }
        i = i + 1
    return 0

// Rename a value with an inline prefix
fn rename_value(v: Value, prefix: String, renames: List<ConstEntry>) -> Value:
    // Check if this value has been renamed
    let opt: Option<String> = find_const(renames, v.name)
    match opt {
        Some(new_name) => { return new Value { name: new_name, ty: v.ty } },
        _ => {
            // If it starts with %, rename with prefix
            if v.name.starts_with("%") {
                let new_name: String = "%" + prefix + v.name.substr(1, len(v.name) - 1)
                return new Value { name: new_name, ty: v.ty }
            }
            return v
        }
    }

// v5.1.2 In.1: Replace one value name if it matches old_name.
fn replace_use(v: Value, old_name: String, new_name: String) -> Value:
    if v.name == old_name:
        return new Value { name: new_name, ty: v.ty }
    return v

// v5.1.2 In.1: Replace all VALUE USES (not definitions) of old_name with
// new_name in an instruction. Used after inlining to rename the caller's
// destination register to a fresh name across downstream instructions,
// preventing SSA name collisions that cause llvm-as to reject the IR.
fn replace_uses_in_instr(inst: Instruction, old_name: String, new_name: String) -> Instruction:
    let ik: String = instr_kind(inst)
    // No value uses
    if ik == "const" { return inst }
    if ik == "alloca" { return inst }
    if ik == "jump" { return inst }
    if ik == "wrap_none" { return inst }
    // Single-use instructions
    if ik == "copy":
        return Instruction::Copy(instr_dest(inst), replace_use(instr_copy_src(inst), old_name, new_name))
    if ik == "cast":
        return Instruction::Cast(instr_dest(inst), replace_use(instr_cast_src(inst), old_name, new_name), instr_cast_type(inst))
    if ik == "unaryop":
        return Instruction::UnaryOp(instr_dest(inst), instr_unaryop_op(inst), replace_use(instr_unaryop_operand(inst), old_name, new_name))
    if ik == "load":
        return Instruction::Load(instr_dest(inst), replace_use(instr_load_ptr(inst), old_name, new_name))
    if ik == "unwrap":
        return Instruction::Unwrap(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "enum_tag":
        return Instruction::EnumTag(instr_dest(inst), replace_use(instr_enumtag_val(inst), old_name, new_name))
    if ik == "enum_payload":
        return Instruction::EnumPayload(instr_dest(inst), replace_use(instr_enumpayload_val(inst), old_name, new_name), instr_enumpayload_variant(inst))
    if ik == "wrap_some":
        return Instruction::WrapSome(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "wrap_ok":
        return Instruction::WrapOk(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "wrap_err":
        return Instruction::WrapErr(instr_dest(inst), replace_use(instr_wrap_val(inst), old_name, new_name))
    if ik == "signal_get":
        return Instruction::SignalGet(instr_dest(inst), replace_use(instr_agentsync_agent(inst), old_name, new_name))
    // Two-use instructions
    if ik == "binop":
        return Instruction::BinOp(instr_dest(inst), instr_binop_op(inst), replace_use(instr_binop_lhs(inst), old_name, new_name), replace_use(instr_binop_rhs(inst), old_name, new_name))
    if ik == "store":
        return Instruction::Store(replace_use(instr_store_ptr(inst), old_name, new_name), replace_use(instr_store_val(inst), old_name, new_name))
    if ik == "field_get":
        return Instruction::FieldGet(instr_dest(inst), replace_use(instr_fieldget_obj(inst), old_name, new_name), instr_fieldget_name(inst))
    if ik == "field_set":
        return Instruction::FieldSet(replace_use(instr_fieldset_obj(inst), old_name, new_name), instr_fieldset_name(inst), replace_use(instr_fieldset_val(inst), old_name, new_name))
    if ik == "index_get":
        return Instruction::IndexGet(instr_dest(inst), replace_use(instr_indexget_obj(inst), old_name, new_name), replace_use(instr_indexget_idx(inst), old_name, new_name))
    if ik == "index_set":
        return Instruction::IndexSet(replace_use(instr_indexset_obj(inst), old_name, new_name), replace_use(instr_indexset_idx(inst), old_name, new_name), replace_use(instr_indexset_val(inst), old_name, new_name))
    if ik == "signal_set":
        return Instruction::SignalSet(replace_use(instr_agentsync_agent(inst), old_name, new_name), replace_use(instr_agentsend_val(inst), old_name, new_name))
    // Branch/switch — condition value
    if ik == "branch":
        return Instruction::Branch(replace_use(instr_branch_cond(inst), old_name, new_name), instr_branch_true(inst), instr_branch_false(inst))
    if ik == "switch":
        return Instruction::Switch(replace_use(instr_switch_tag(inst), old_name, new_name), instr_switch_cases(inst), instr_switch_default(inst))
    // Return
    if ik == "return":
        let rv: Option<Value> = instr_return_val(inst)
        match rv {
            Some(val) => {
                return Instruction::Return(Some(replace_use(val, old_name, new_name)))
            },
            _ => { return inst }
        }
    // Call — rename args (and fn_name when it's an indirect-call SSA value)
    if ik == "call":
        let args: List<Value> = instr_call_args(inst)
        let mut new_args: List<Value> = []
        let mut ai: Int = 0
        for _ in 0..100:
            if ai >= len(args) { break }
            new_args.push(replace_use(args[ai], old_name, new_name))
            ai = ai + 1
        // v5.7.0 Sh.7: indirect calls store the loaded SSA name as fn_name
        // (e.g. "%f_val0"). When the caller's dest is renamed downstream,
        // the indirect call's fn_name must follow.
        let mut new_fn: String = instr_call_fn(inst)
        if new_fn == old_name { new_fn = new_name }
        return Instruction::Call(instr_dest(inst), new_fn, new_args)
    // Phi — rename incoming values
    if ik == "phi":
        let entries: List<PhiEntry> = instr_phi_entries(inst)
        let mut new_entries: List<PhiEntry> = []
        let mut pi: Int = 0
        for _ in 0..100:
            if pi >= len(entries) { break }
            new_entries.push(new PhiEntry { block_label: entries[pi].block_label, val: replace_use(entries[pi].val, old_name, new_name) })
            pi = pi + 1
        return Instruction::Phi(instr_dest(inst), new_entries)
    // InterpConcat — rename parts
    if ik == "interp_concat":
        let parts: List<Value> = instr_concat_parts(inst)
        let mut new_parts: List<Value> = []
        let mut ci: Int = 0
        for _ in 0..100:
            if ci >= len(parts) { break }
            new_parts.push(replace_use(parts[ci], old_name, new_name))
            ci = ci + 1
        return Instruction::InterpConcat(instr_dest(inst), new_parts)
    // StructInit — rename field values
    if ik == "struct_init":
        let fields: List<FieldPair> = instr_struct_fields(inst)
        let mut new_fields: List<FieldPair> = []
        let mut fi: Int = 0
        for _ in 0..100:
            if fi >= len(fields) { break }
            new_fields.push(new FieldPair { name: fields[fi].name, val: replace_use(fields[fi].val, old_name, new_name) })
            fi = fi + 1
        return Instruction::StructInit(instr_dest(inst), instr_struct_type(inst), new_fields)
    // ListInit — rename elements
    if ik == "list_init":
        let elems: List<Value> = instr_list_elements(inst)
        let mut new_elems: List<Value> = []
        let mut ei: Int = 0
        for _ in 0..100:
            if ei >= len(elems) { break }
            new_elems.push(replace_use(elems[ei], old_name, new_name))
            ei = ei + 1
        return Instruction::ListInit(instr_dest(inst), instr_list_type(inst), new_elems)
    // EnumInit — rename payload values
    if ik == "enum_init":
        let payload: List<Value> = instr_enum_payload(inst)
        let mut new_payload: List<Value> = []
        let mut epi: Int = 0
        for _ in 0..100:
            if epi >= len(payload) { break }
            new_payload.push(replace_use(payload[epi], old_name, new_name))
            epi = epi + 1
        return Instruction::EnumInit(instr_dest(inst), instr_enum_type(inst), instr_enum_variant(inst), new_payload)
    // v5.5.2 Sh.4 Phase 3 — BlockOn/AwaitSuspend future operand rename.
    // Required so the inliner's post-call rename of the caller's dest
    // also updates BlockOn's future ref when block_on(inlined_call())
    // is in the source.  Without this, `%t0` survives after inlining
    // renamed it to `%_inl0_0_dst` and llvm-as rejects with "use of
    // undefined value '%t0'".
    if ik == "await_suspend":
        return Instruction::AwaitSuspend(instr_dest(inst), replace_use(instr_await_suspend_future(inst), old_name, new_name))
    if ik == "block_on":
        return Instruction::BlockOn(instr_dest(inst), replace_use(instr_block_on_future(inst), old_name, new_name))
    // For remaining rare types (agent_spawn, agent_send, agent_sync,
    // signal_init, stream_op, tensor_init, map_init), keep as-is.
    return inst

// Clone a single instruction with renamed values
fn clone_instr_for_inline(inst: Instruction, prefix: String, renames: List<ConstEntry>, merge_label: String) -> List<Instruction>:
    let ik: String = instr_kind(inst)
    let mut result: List<Instruction> = []

    // Return → Copy + Jump to merge
    if ik == "return":
        let ret_val: Option<Value> = instr_return_val(inst)
        match ret_val {
            Some(rv) => {
                let renamed_rv: Value = rename_value(rv, prefix, renames)
                let ret_dest: Value = new Value { name: "%" + prefix + "retval", ty: renamed_rv.ty }
                result.push(Instruction::Copy(ret_dest, renamed_rv))
            },
            _ => {}
        }
        result.push(Instruction::Jump(merge_label))
        return result

    // Const
    if ik == "const":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        result.push(Instruction::Const(new_dest, instr_const_type(inst), instr_const_val(inst)))
        return result

    // Copy
    if ik == "copy":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_src: Value = rename_value(instr_copy_src(inst), prefix, renames)
        result.push(Instruction::Copy(new_dest, new_src))
        return result

    // BinOp
    if ik == "binop":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_lhs: Value = rename_value(instr_binop_lhs(inst), prefix, renames)
        let new_rhs: Value = rename_value(instr_binop_rhs(inst), prefix, renames)
        result.push(Instruction::BinOp(new_dest, instr_binop_op(inst), new_lhs, new_rhs))
        return result

    // Call
    if ik == "call":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let args: List<Value> = instr_call_args(inst)
        let mut new_args: List<Value> = []
        let mut ai: Int = 0
        for _ in 0..100:
            if ai >= len(args) { break }
            new_args.push(rename_value(args[ai], prefix, renames))
            ai = ai + 1
        // v5.7.0 Sh.7: indirect calls have fn_name == "%localval" and
        // must be renamed alongside other SSA values; direct calls
        // (`@some_fn`) keep their bare-symbol name unchanged.
        let fn_str: String = instr_call_fn(inst)
        let mut new_fn_str: String = fn_str
        if fn_str.starts_with("%"):
            let bare: String = fn_str.substr(1, len(fn_str) - 1)
            let rn_opt: Option<String> = find_const(renames, fn_str)
            match rn_opt:
                Some(rn) => { new_fn_str = rn }
                _ => { new_fn_str = "%" + prefix + bare }
        result.push(Instruction::Call(new_dest, new_fn_str, new_args))
        return result

    // Alloca
    if ik == "alloca":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        result.push(Instruction::Alloca(new_dest, instr_alloca_type(inst)))
        return result

    // Load
    if ik == "load":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_ptr: Value = rename_value(instr_load_ptr(inst), prefix, renames)
        result.push(Instruction::Load(new_dest, new_ptr))
        return result

    // Store
    if ik == "store":
        let new_ptr: Value = rename_value(instr_store_ptr(inst), prefix, renames)
        let new_val: Value = rename_value(instr_store_val(inst), prefix, renames)
        result.push(Instruction::Store(new_ptr, new_val))
        return result

    // UnaryOp
    if ik == "unaryop":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_operand: Value = rename_value(instr_unaryop_operand(inst), prefix, renames)
        result.push(Instruction::UnaryOp(new_dest, instr_unaryop_op(inst), new_operand))
        return result

    // Cast
    if ik == "cast":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_src: Value = rename_value(instr_cast_src(inst), prefix, renames)
        result.push(Instruction::Cast(new_dest, new_src, instr_cast_type(inst)))
        return result

    // FieldGet — dest + obj (the v5.3.2 crash site)
    if ik == "field_get":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_obj: Value = rename_value(instr_fieldget_obj(inst), prefix, renames)
        result.push(Instruction::FieldGet(new_dest, new_obj, instr_fieldget_name(inst)))
        return result

    // FieldSet — no dest (void)
    if ik == "field_set":
        let new_obj: Value = rename_value(instr_fieldset_obj(inst), prefix, renames)
        let new_val: Value = rename_value(instr_fieldset_val(inst), prefix, renames)
        result.push(Instruction::FieldSet(new_obj, instr_fieldset_name(inst), new_val))
        return result

    // StructInit — dest + list of FieldPair
    if ik == "struct_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let fields: List<FieldPair> = instr_struct_fields(inst)
        let mut new_fields: List<FieldPair> = []
        let mut fi2: Int = 0
        for _ in 0..100:
            if fi2 >= len(fields) { break }
            new_fields.push(new FieldPair { name: fields[fi2].name, val: rename_value(fields[fi2].val, prefix, renames) })
            fi2 = fi2 + 1
        result.push(Instruction::StructInit(new_dest, instr_struct_type(inst), new_fields))
        return result

    // ListInit — dest + list of Value
    if ik == "list_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let elems: List<Value> = instr_list_elements(inst)
        let mut new_elems: List<Value> = []
        let mut ei2: Int = 0
        for _ in 0..100:
            if ei2 >= len(elems) { break }
            new_elems.push(rename_value(elems[ei2], prefix, renames))
            ei2 = ei2 + 1
        result.push(Instruction::ListInit(new_dest, instr_list_type(inst), new_elems))
        return result

    // TensorInit — dest + shape (ints, keep) + list of Value
    if ik == "tensor_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let t_elems: List<Value> = instr_tensor_elements(inst)
        let mut new_t_elems: List<Value> = []
        let mut ti2: Int = 0
        for _ in 0..100:
            if ti2 >= len(t_elems) { break }
            new_t_elems.push(rename_value(t_elems[ti2], prefix, renames))
            ti2 = ti2 + 1
        result.push(Instruction::TensorInit(new_dest, instr_tensor_type(inst), instr_tensor_shape(inst), new_t_elems))
        return result

    // IndexGet — dest + obj + idx
    if ik == "index_get":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_obj: Value = rename_value(instr_indexget_obj(inst), prefix, renames)
        let new_idx: Value = rename_value(instr_indexget_idx(inst), prefix, renames)
        result.push(Instruction::IndexGet(new_dest, new_obj, new_idx))
        return result

    // IndexSet — no dest (void)
    if ik == "index_set":
        let new_obj: Value = rename_value(instr_indexset_obj(inst), prefix, renames)
        let new_idx: Value = rename_value(instr_indexset_idx(inst), prefix, renames)
        let new_val: Value = rename_value(instr_indexset_val(inst), prefix, renames)
        result.push(Instruction::IndexSet(new_obj, new_idx, new_val))
        return result

    // MapInit — dest + key_type + val_type + list of KVPair
    if ik == "map_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let pairs: List<KVPair> = instr_map_pairs(inst)
        let mut new_pairs: List<KVPair> = []
        let mut mi2: Int = 0
        for _ in 0..100:
            if mi2 >= len(pairs) { break }
            new_pairs.push(new KVPair { key: rename_value(pairs[mi2].key, prefix, renames), val: rename_value(pairs[mi2].val, prefix, renames) })
            mi2 = mi2 + 1
        result.push(Instruction::MapInit(new_dest, instr_map_key_type(inst), instr_map_val_type(inst), new_pairs))
        return result

    // EnumInit — dest + type + variant + list of Value
    if ik == "enum_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let payload: List<Value> = instr_enum_payload(inst)
        let mut new_payload: List<Value> = []
        let mut epi2: Int = 0
        for _ in 0..100:
            if epi2 >= len(payload) { break }
            new_payload.push(rename_value(payload[epi2], prefix, renames))
            epi2 = epi2 + 1
        result.push(Instruction::EnumInit(new_dest, instr_enum_type(inst), instr_enum_variant(inst), new_payload))
        return result

    // EnumTag — dest + val
    if ik == "enum_tag":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_enumtag_val(inst), prefix, renames)
        result.push(Instruction::EnumTag(new_dest, new_val))
        return result

    // EnumPayload — dest + val + variant
    if ik == "enum_payload":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_enumpayload_val(inst), prefix, renames)
        result.push(Instruction::EnumPayload(new_dest, new_val, instr_enumpayload_variant(inst)))
        return result

    // WrapSome — dest + val
    if ik == "wrap_some":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::WrapSome(new_dest, new_val))
        return result

    // WrapNone — dest + type (no value operand)
    if ik == "wrap_none":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        result.push(Instruction::WrapNone(new_dest, instr_wrapnone_type(inst)))
        return result

    // WrapOk — dest + val
    if ik == "wrap_ok":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::WrapOk(new_dest, new_val))
        return result

    // WrapErr — dest + val
    if ik == "wrap_err":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::WrapErr(new_dest, new_val))
        return result

    // Unwrap — dest + val
    if ik == "unwrap":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_wrap_val(inst), prefix, renames)
        result.push(Instruction::Unwrap(new_dest, new_val))
        return result

    // InterpConcat — dest + list of Value
    if ik == "interp_concat":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let parts: List<Value> = instr_concat_parts(inst)
        let mut new_parts: List<Value> = []
        let mut ci2: Int = 0
        for _ in 0..100:
            if ci2 >= len(parts) { break }
            new_parts.push(rename_value(parts[ci2], prefix, renames))
            ci2 = ci2 + 1
        result.push(Instruction::InterpConcat(new_dest, new_parts))
        return result

    // Phi — dest + list of PhiEntry
    if ik == "phi":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let entries: List<PhiEntry> = instr_phi_entries(inst)
        let mut new_entries: List<PhiEntry> = []
        let mut pi4: Int = 0
        for _ in 0..100:
            if pi4 >= len(entries) { break }
            new_entries.push(new PhiEntry { block_label: prefix + entries[pi4].block_label, val: rename_value(entries[pi4].val, prefix, renames) })
            pi4 = pi4 + 1
        result.push(Instruction::Phi(new_dest, new_entries))
        return result

    // AgentSpawn — dest + type + list of Value
    if ik == "agent_spawn":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let a_args: List<Value> = instr_agent_args(inst)
        let mut new_a_args: List<Value> = []
        let mut ai2: Int = 0
        for _ in 0..100:
            if ai2 >= len(a_args) { break }
            new_a_args.push(rename_value(a_args[ai2], prefix, renames))
            ai2 = ai2 + 1
        result.push(Instruction::AgentSpawn(new_dest, instr_agent_type(inst), new_a_args))
        return result

    // AgentSend — no dest (void): agent + channel + val
    if ik == "agent_send":
        let new_agent: Value = rename_value(instr_agentsend_agent(inst), prefix, renames)
        let new_val: Value = rename_value(instr_agentsend_val(inst), prefix, renames)
        result.push(Instruction::AgentSend(new_agent, instr_agentsend_channel(inst), new_val))
        return result

    // AgentSync — dest + agent + channel
    if ik == "agent_sync":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_agent: Value = rename_value(instr_agentsync_agent(inst), prefix, renames)
        result.push(Instruction::AgentSync(new_dest, new_agent, instr_agentsync_channel(inst)))
        return result

    // SignalInit — dest + type + val
    if ik == "signal_init":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_val: Value = rename_value(instr_signal_val(inst), prefix, renames)
        result.push(Instruction::SignalInit(new_dest, instr_signal_type(inst), new_val))
        return result

    // SignalGet — dest + sig
    if ik == "signal_get":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_sig: Value = rename_value(instr_signalget_sig(inst), prefix, renames)
        result.push(Instruction::SignalGet(new_dest, new_sig))
        return result

    // SignalSet — no dest (void): sig + val
    if ik == "signal_set":
        let new_sig: Value = rename_value(instr_signalset_sig(inst), prefix, renames)
        let new_val: Value = rename_value(instr_signalset_val(inst), prefix, renames)
        result.push(Instruction::SignalSet(new_sig, new_val))
        return result

    // StreamOp — dest + kind + source + list of Value
    if ik == "stream_op":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_src: Value = rename_value(instr_streamop_source(inst), prefix, renames)
        let s_args: List<Value> = instr_streamop_args(inst)
        let mut new_s_args: List<Value> = []
        let mut si2: Int = 0
        for _ in 0..100:
            if si2 >= len(s_args) { break }
            new_s_args.push(rename_value(s_args[si2], prefix, renames))
            si2 = si2 + 1
        result.push(Instruction::StreamOp(new_dest, instr_streamop_kind(inst), new_src, new_s_args))
        return result

    // Jump — rename block label
    if ik == "jump":
        result.push(Instruction::Jump(prefix + instr_jump_target(inst)))
        return result

    // Branch — rename condition + block labels
    if ik == "branch":
        let new_cond: Value = rename_value(instr_branch_cond(inst), prefix, renames)
        result.push(Instruction::Branch(new_cond, prefix + instr_branch_true(inst), prefix + instr_branch_false(inst)))
        return result

    // Switch — rename tag + case/default labels
    if ik == "switch":
        let new_tag: Value = rename_value(instr_switch_tag(inst), prefix, renames)
        let cases: List<SwitchCase> = instr_switch_cases(inst)
        let mut new_cases: List<SwitchCase> = []
        let mut sci: Int = 0
        for _ in 0..100:
            if sci >= len(cases) { break }
            new_cases.push(new SwitchCase { tag_value: cases[sci].tag_value, block_label: prefix + cases[sci].block_label })
            sci = sci + 1
        result.push(Instruction::Switch(new_tag, new_cases, prefix + instr_switch_default(inst)))
        return result

    // v5.5.2 Sh.4 Phase 3 — AwaitSuspend/BlockOn rename in inlined body.
    // When an async fn like `outer()` (which may contain `await inner()`)
    // is inlined into main()'s BlockOn body, every AwaitSuspend inside
    // outer() needs its dest + future ref prefixed/renamed to the
    // inline scope so SSA stays valid. Without these cases the
    // fallthrough keeps the instruction as-is and llvm-as rejects with
    // duplicate-use or undefined-ref errors.
    if ik == "await_suspend":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_fut: Value = rename_value(instr_await_suspend_future(inst), prefix, renames)
        result.push(Instruction::AwaitSuspend(new_dest, new_fut))
        return result
    if ik == "block_on":
        let new_dest: Value = rename_value(instr_dest(inst), prefix, renames)
        let new_fut: Value = rename_value(instr_block_on_future(inst), prefix, renames)
        result.push(Instruction::BlockOn(new_dest, new_fut))
        return result
    // Fallthrough: any future variant added to Instruction — keep as-is
    result.push(inst)
    return result

// Rename PHI predecessor labels: old_label → new_label
fn rename_phi_pred(inst: Instruction, old_label: String, new_label: String) -> Instruction:
    if instr_kind(inst) != "phi" { return inst }
    let entries: List<PhiEntry> = instr_phi_entries(inst)
    let mut new_entries: List<PhiEntry> = []
    let mut changed: Bool = false
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(entries) { break }
        if entries[i].block_label == old_label:
            new_entries.push(new PhiEntry { block_label: new_label, val: entries[i].val })
            changed = true
        else:
            new_entries.push(entries[i])
        i = i + 1
    if changed:
        return Instruction::Phi(instr_dest(inst), new_entries)
    return inst

fn inline_small_functions(f: MIRFunction, lookup: List<FnLookupEntry>) -> MIRFunction:

    // Count calls per callee
    let call_counts: List<CallCount> = count_calls(f, lookup)
    if len(call_counts) == 0 { return f }

    // Find eligible callees
    let mut eligible: List<String> = []
    let mut ci: Int = 0
    for _ in 0..1000:
        if ci >= len(call_counts) { break }
        let cc: CallCount = call_counts[ci]
        let callee_opt: Option<MIRFunction> = find_fn_by_name(lookup, cc.name)
        match callee_opt {
            Some(callee) => {
                if should_inline(callee, cc.count) {
                    eligible.push(cc.name)
                }
            },
            _ => {}
        }
        ci = ci + 1
    if len(eligible) == 0 { return f }

    // Find first eligible call site and inline it
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return f }
        let bb: BasicBlock = f.blocks[bi]
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(bb.instructions) { break }
            let inst: Instruction = bb.instructions[ii]
            if instr_kind(inst) == "call":
                let callee_name: String = instr_call_fn(inst)
                if is_in_list(callee_name, eligible):
                    // Found an eligible call site — inline it
                    let callee_opt2: Option<MIRFunction> = find_fn_by_name(lookup, callee_name)
                    match callee_opt2 {
                        Some(callee) => {
                            // Safety: skip if arg count != param count (name collision)
                            let call_args_pre: List<Value> = instr_call_args(inst)
                            if len(call_args_pre) == len(callee.params) {

                            // Use block index + instruction index for unique prefix
                            let prefix: String = "_inl" + toString(bi) + "_" + toString(ii) + "_"
                            let merge_label: String = prefix + "ret"

                            // Build rename map: callee params → call arguments
                            let mut renames: List<ConstEntry> = []
                            let call_args: List<Value> = call_args_pre
                            let mut pi2: Int = 0
                            for _ in 0..100 {
                                if pi2 >= len(callee.params) { break }
                                if pi2 < len(call_args) {
                                    renames.push(new ConstEntry { name: "%" + callee.params[pi2].name, value: call_args[pi2].name, ty: call_args[pi2].ty })
                                }
                                pi2 = pi2 + 1
                            }

                            // Split: pre-call instructions
                            let mut pre_insts: List<Instruction> = []
                            let mut ki: Int = 0
                            for _ in 0..10000 {
                                if ki >= ii { break }
                                pre_insts.push(bb.instructions[ki])
                                ki = ki + 1
                            }

                            // Clone callee's single block instructions
                            let callee_entry: String = prefix + callee.blocks[0].label
                            pre_insts.push(Instruction::Jump(callee_entry))

                            // Clone callee block
                            let mut cloned_insts: List<Instruction> = []
                            let mut cli: Int = 0
                            for _ in 0..10000 {
                                if cli >= len(callee.blocks[0].instructions) { break }
                                let cloned: List<Instruction> = clone_instr_for_inline(callee.blocks[0].instructions[cli], prefix, renames, merge_label)
                                let mut cj: Int = 0
                                for _ in 0..10 {
                                    if cj >= len(cloned) { break }
                                    cloned_insts.push(cloned[cj])
                                    cj = cj + 1
                                }
                                cli = cli + 1
                            }

                            // Post-call instructions
                            // v5.1.2 In.1: use a fresh dest name for the inlined result
                            // to prevent SSA name collision. The original %tN may collide
                            // with names in other blocks after the LLVM emitter maps MIR
                            // names to LLVM IR (which requires function-wide uniqueness).
                            // All downstream uses of the original name are renamed.
                            let mut post_insts: List<Instruction> = []
                            let call_dest: Value = instr_dest(inst)
                            let do_rename: Bool = call_dest.name.starts_with("%")
                            let fresh_dest_name: String = "%" + prefix + "dst"
                            if do_rename {
                                let fresh_dest: Value = new Value { name: fresh_dest_name, ty: call_dest.ty }
                                let ret_val: Value = new Value { name: "%" + prefix + "retval", ty: call_dest.ty }
                                post_insts.push(Instruction::Copy(fresh_dest, ret_val))
                            }
                            let mut pi3: Int = ii + 1
                            for _ in 0..10000 {
                                if pi3 >= len(bb.instructions) { break }
                                if do_rename {
                                    post_insts.push(replace_uses_in_instr(bb.instructions[pi3], call_dest.name, fresh_dest_name))
                                } else {
                                    post_insts.push(bb.instructions[pi3])
                                }
                                pi3 = pi3 + 1
                            }

                            // Build new block list
                            let mut new_blocks: List<BasicBlock> = []
                            // Current block with pre-call instrs
                            new_blocks.push(new BasicBlock { label: bb.label, instructions: pre_insts })
                            // Cloned callee block
                            new_blocks.push(new BasicBlock { label: callee_entry, instructions: cloned_insts })
                            // Merge block with post-call instrs
                            new_blocks.push(new BasicBlock { label: merge_label, instructions: post_insts })
                            // Remaining blocks — rename uses of old dest name
                            // and fix PHI predecessors (bb.label → merge_label)
                            let orig_label: String = bb.label
                            let mut ri: Int = bi + 1
                            for _ in 0..5000 {
                                if ri >= len(f.blocks) { break }
                                let rbb: BasicBlock = f.blocks[ri]
                                let mut renamed_instrs: List<Instruction> = []
                                let mut rii: Int = 0
                                for _ in 0..10000 {
                                    if rii >= len(rbb.instructions) { break }
                                    let mut rinst: Instruction = rbb.instructions[rii]
                                    if do_rename {
                                        rinst = replace_uses_in_instr(rinst, call_dest.name, fresh_dest_name)
                                    }
                                    rinst = rename_phi_pred(rinst, orig_label, merge_label)
                                    renamed_instrs.push(rinst)
                                    rii = rii + 1
                                }
                                new_blocks.push(new BasicBlock { label: rbb.label, instructions: renamed_instrs })
                                ri = ri + 1
                            }
                            // Prepend blocks before current
                            let mut final_blocks: List<BasicBlock> = []
                            let mut fi: Int = 0
                            for _ in 0..5000 {
                                if fi >= bi { break }
                                final_blocks.push(f.blocks[fi])
                                fi = fi + 1
                            }
                            let mut ni: Int = 0
                            for _ in 0..5000 {
                                if ni >= len(new_blocks) { break }
                                final_blocks.push(new_blocks[ni])
                                ni = ni + 1
                            }

                            return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: final_blocks, decorators: f.decorators, is_public: f.is_public }
                            } // end param-count guard
                        },
                        _ => {}
                    }
            ii = ii + 1
        bi = bi + 1
    return f

// ---------------------------------------------------------------------------
// Pass 6: LICM — Loop-invariant code motion (v4.97.0)
// Detect natural loops via back-edge detection, hoist invariant instructions
// to the loop preheader.
// ---------------------------------------------------------------------------

// Compute successor labels for a block
fn block_successors(bb: BasicBlock) -> List<String>:
    if len(bb.instructions) == 0:
        let empty: List<String> = []
        return empty
    return collect_targets(bb.instructions[len(bb.instructions) - 1])

// Check if instruction is side-effect-free (safe to hoist)
fn is_pure_instruction(inst: Instruction) -> Bool:
    let ik: String = instr_kind(inst)
    // Pure: const, copy, binop, unaryop, cast
    if ik == "const" { return true }
    if ik == "copy" { return true }
    if ik == "binop" { return true }
    if ik == "unaryop" { return true }
    if ik == "cast" { return true }
    // Not pure: call, store, load (may have side effects), control flow
    return false

// Check if all uses of an instruction are defined outside the loop
fn is_loop_invariant(inst: Instruction, loop_body: List<String>, loop_defs: List<String>) -> Bool:
    if is_pure_instruction(inst) == false { return false }
    let ik: String = instr_kind(inst)
    // Check operands
    if ik == "binop":
        let lhs: Value = instr_binop_lhs(inst)
        let rhs: Value = instr_binop_rhs(inst)
        if lhs.name.starts_with("%") && is_in_list(lhs.name, loop_defs) { return false }
        if rhs.name.starts_with("%") && is_in_list(rhs.name, loop_defs) { return false }
        return true
    if ik == "copy":
        let src: Value = instr_copy_src(inst)
        if src.name.starts_with("%") && is_in_list(src.name, loop_defs) { return false }
        return true
    if ik == "unaryop":
        let operand: Value = instr_unaryop_operand(inst)
        if operand.name.starts_with("%") && is_in_list(operand.name, loop_defs) { return false }
        return true
    if ik == "cast":
        let src: Value = instr_cast_src(inst)
        if src.name.starts_with("%") && is_in_list(src.name, loop_defs) { return false }
        return true
    if ik == "const" { return true }
    return false

// Collect all definitions (dest names) in loop body blocks
fn collect_loop_defs(f: MIRFunction, loop_body: List<String>) -> List<String>:
    let mut defs: List<String> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        if is_in_list(f.blocks[bi].label, loop_body):
            let mut ii: Int = 0
            for _ in 0..10000:
                if ii >= len(f.blocks[bi].instructions) { break }
                let inst: Instruction = f.blocks[bi].instructions[ii]
                let dest: Value = instr_dest(inst)
                if len(dest.name) > 0 && dest.name.starts_with("%"):
                    if is_in_list(dest.name, defs) == false:
                        defs.push(dest.name)
                ii = ii + 1
        bi = bi + 1
    return defs

// Find the index of a block label that appears before position `before_idx`
fn find_earlier_block(blocks: List<BasicBlock>, label: String, before_idx: Int) -> Int:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= before_idx { return -1 }
        if blocks[i].label == label { return i }
        i = i + 1
    return -1

// Find a loop-invariant instruction in the loop body (excluding header)
// Returns (block_index, instruction_index) encoded as block_index * 100000 + inst_index
// Returns -1 if none found
fn find_invariant_in_loop(f: MIRFunction, header_idx: Int, back_idx: Int, loop_body: List<String>, loop_defs: List<String>) -> Int:
    let mut lbi: Int = header_idx + 1
    for _ in 0..5000:
        if lbi > back_idx { return -1 }
        let mut lii: Int = 0
        for _ in 0..10000:
            if lii >= len(f.blocks[lbi].instructions) { break }
            let linst: Instruction = f.blocks[lbi].instructions[lii]
            if is_loop_invariant(linst, loop_body, loop_defs):
                let dest: Value = instr_dest(linst)
                if len(dest.name) > 0:
                    return lbi * 100000 + lii
            lii = lii + 1
        lbi = lbi + 1
    return -1

// Hoist one instruction from src_block[src_idx] to header[before terminator]
fn hoist_instruction(f: MIRFunction, header_idx: Int, src_block_idx: Int, src_inst_idx: Int) -> MIRFunction:
    let hoisted: Instruction = f.blocks[src_block_idx].instructions[src_inst_idx]
    // Remove from source block
    let mut src_instrs: List<Instruction> = []
    let mut ri: Int = 0
    for _ in 0..10000:
        if ri >= len(f.blocks[src_block_idx].instructions) { break }
        if ri != src_inst_idx:
            src_instrs.push(f.blocks[src_block_idx].instructions[ri])
        ri = ri + 1
    // Insert into header before terminator
    let header_bb: BasicBlock = f.blocks[header_idx]
    let mut hdr_instrs: List<Instruction> = []
    let insert_pos: Int = len(header_bb.instructions) - 1
    let mut hi2: Int = 0
    for _ in 0..10000:
        if hi2 >= len(header_bb.instructions) { break }
        if hi2 == insert_pos:
            hdr_instrs.push(hoisted)
        hdr_instrs.push(header_bb.instructions[hi2])
        hi2 = hi2 + 1
    // Rebuild blocks
    let mut new_blocks: List<BasicBlock> = []
    let mut nbi: Int = 0
    for _ in 0..5000:
        if nbi >= len(f.blocks) { break }
        if nbi == header_idx:
            new_blocks.push(new BasicBlock { label: header_bb.label, instructions: hdr_instrs })
        else if nbi == src_block_idx:
            new_blocks.push(new BasicBlock { label: f.blocks[src_block_idx].label, instructions: src_instrs })
        else:
            new_blocks.push(f.blocks[nbi])
        nbi = nbi + 1
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }

// Simple LICM: find back edges, identify loop-invariant instructions, hoist to header
fn licm_function(f: MIRFunction) -> MIRFunction:
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { return f }
        let bb: BasicBlock = f.blocks[bi]
        let succs: List<String> = block_successors(bb)
        let mut s_idx: Int = 0
        for _ in 0..10:
            if s_idx >= len(succs) { break }
            let header_idx: Int = find_earlier_block(f.blocks, succs[s_idx], bi)
            if header_idx >= 0:
                // Found a back edge: bi → header_idx
                let mut loop_body: List<String> = []
                let mut li: Int = header_idx
                for _ in 0..5000:
                    if li > bi { break }
                    loop_body.push(f.blocks[li].label)
                    li = li + 1
                let loop_defs: List<String> = collect_loop_defs(f, loop_body)
                let encoded: Int = find_invariant_in_loop(f, header_idx, bi, loop_body, loop_defs)
                if encoded >= 0:
                    let src_block: Int = encoded / 100000
                    let src_inst: Int = encoded - src_block * 100000
                    return hoist_instruction(f, header_idx, src_block, src_inst)
            s_idx = s_idx + 1
        bi = bi + 1
    return f

// ---------------------------------------------------------------------------
// Pass 7: Escape analysis — heap-to-stack promotion (v4.97.0)
// Track allocations (StructInit, EnumInit, ListInit, etc.), determine if
// the allocated value escapes the function (returned, stored in struct,
// passed to unknown call). If non-escaping, mark for stack allocation.
// ---------------------------------------------------------------------------

fn is_alloc_instruction(inst: Instruction) -> Bool:
    let ik: String = instr_kind(inst)
    if ik == "struct_init" { return true }
    if ik == "enum_init" { return true }
    if ik == "list_init" { return true }
    if ik == "map_init" { return true }
    if ik == "wrap_some" { return true }
    if ik == "wrap_none" { return true }
    if ik == "wrap_ok" { return true }
    if ik == "wrap_err" { return true }
    if ik == "interp_concat" { return true }
    return false

// Check if a value name is used in ways that cause it to escape
fn check_escape(f: MIRFunction, alloc_name: String) -> Bool:
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            let ik: String = instr_kind(inst)
            // Returned — escapes
            if ik == "return":
                let rv: Option<Value> = instr_return_val(inst)
                match rv {
                    Some(val) => {
                        if val.name == alloc_name { return true }
                    },
                    _ => {}
                }
            // Stored in a struct field — escapes
            if ik == "field_set":
                if instr_fieldset_val(inst).name == alloc_name { return true }
            // Stored in a container — escapes
            if ik == "index_set":
                if instr_indexset_val(inst).name == alloc_name { return true }
            // Passed to a call (conservative: any call = escape)
            if ik == "call":
                let args: List<Value> = instr_call_args(inst)
                let mut ai: Int = 0
                for _ in 0..100:
                    if ai >= len(args) { break }
                    if args[ai].name == alloc_name { return true }
                    ai = ai + 1
            // Agent send — escapes
            if ik == "agent_send":
                if instr_agentsend_val(inst).name == alloc_name { return true }
            ii = ii + 1
        bi = bi + 1
    return false

fn escape_analysis_function(f: MIRFunction) -> MIRFunction:
    // v5.1.2 Ea.1: full escape analysis — identify non-escaping allocations.
    // The self-hosted Instruction enum does not carry an alloc_kind field
    // (unlike the Python MIR dataclasses), so the result cannot be annotated
    // on the instruction directly. Instead, we compute the escape set and
    // return f unchanged — the Python emitter (which IS the active emitter
    // during bootstrap and golden tests) already runs escape_analysis_promotion
    // via mir_opt.py. The self-hosted analysis serves as:
    //   (a) parity evidence that the computation mirrors Python's,
    //   (b) the hook point for when the self-hosted Instruction enum gains
    //       an alloc_kind discriminant (v5.2+ scope).

    // Find all allocation sites
    let mut alloc_names: List<String> = []
    let mut bi: Int = 0
    for _ in 0..5000:
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000:
            if ii >= len(f.blocks[bi].instructions) { break }
            let inst: Instruction = f.blocks[bi].instructions[ii]
            if is_alloc_instruction(inst):
                let dest: Value = instr_dest(inst)
                if dest.name.starts_with("%"):
                    alloc_names.push(dest.name)
            ii = ii + 1
        bi = bi + 1
    if len(alloc_names) == 0 { return f }

    // Run escape analysis for each allocation
    let mut non_escaping: Int = 0
    let mut ai: Int = 0
    for _ in 0..10000:
        if ai >= len(alloc_names) { break }
        let escapes: Bool = check_escape(f, alloc_names[ai])
        if escapes == false:
            non_escaping = non_escaping + 1
        ai = ai + 1

    // Analysis complete. non_escaping allocations identified but not yet
    // annotated (no alloc_kind field on self-hosted Instruction enum).
    // The Python emitter path handles the actual STACK promotion via
    // mir_opt.py::escape_analysis_promotion at line 1659.
    return f

// ---------------------------------------------------------------------------
// Public API: optimize a MIR module
// ---------------------------------------------------------------------------

pub fn optimize_mir(module: MIRModule) -> MIRModule:
    // Build function lookup table for inlining
    let mut lookup: List<FnLookupEntry> = []
    let mut li: Int = 0
    for _ in 0..5000:
        if li >= len(module.functions) { break }
        lookup.push(new FnLookupEntry { name: module.functions[li].name, func: module.functions[li] })
        li = li + 1
    let mut new_fns: List<MIRFunction> = []
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(module.functions):
            return new MIRModule { name: module.name, functions: new_fns, structs: module.structs, enums: module.enums, extern_fns: module.extern_fns, agents: module.agents, pipes: module.pipes, imports: module.imports, trait_names: module.trait_names, consts: module.consts }
        let f: MIRFunction = module.functions[i]
        // Pass 1: constant folding
        let f2: MIRFunction = constant_fold_function(f)
        // Pass 2: constant propagation
        let f3: MIRFunction = const_prop_function(f2)
        // Pass 3: dead block elimination
        let f4: MIRFunction = dead_block_elim_function(f3)
        // Pass 4: strength reduction (v4.97.0) — disabled v4.111.0
        // Corroborates with inline_small_functions in producing MIR that the
        // verifier rejects ("block has no instructions", "block does not end
        // with a terminator") on golden tests with user-defined functions
        // (03_function onward, 13 tests). Zero-ROI per v4.109.0.
        // v4.152.0 re-evaluation: safe (no crash, 54/66 goldens hold), but
        // still zero-ROI — pass runs, finds 0 mod-by-power-of-2 patterns in
        // the self-hosted MIR, golden IR byte-identical, stage2.ll +1 line
        // (the call itself). LLVM instcombine at -O2 covers this. Keep disabled.
        // Note: Python mir_opt.py has strength_reduction enabled (line 2390);
        // divergence is tolerable — self-hosted optimizer skip costs nothing.
        let f5: MIRFunction = f4
        // Pass 5: function inlining (v4.97.0)
        // v4.111.0: disabled — verify_block crash on golden tests with function calls.
        // v4.152.0 re-evaluation: crash GONE. SSA name collision remained (In.1).
        // v5.1.2 In.1 CLOSED: replace_uses_in_instr renames the caller's destination
        // register to a fresh prefixed name (%_inlN_M_dst) after inlining, and
        // renames all downstream uses in post-call and remaining blocks. The original
        // %tN name is never redefined. Python/self-hosted parity restored.
        let f6: MIRFunction = inline_small_functions(f5, lookup)
        // Pass 6: LICM (v4.97.0) — STILL DISABLED
        // v4.111.0: disabled — block_successors crash.
        // v4.152.0: crash GONE. 3 golden regressions (05_for_loop, 21_list_ops,
        //   33_break_continue) from duplicate definitions.
        // v5.1.2 Li.1: attempted re-enable. Unit tests pass (LICM logic is
        //   correct in isolation), but live golden tests reproduce the v4.152.0
        //   regressions. Root cause: licm_function hoists ONE instruction per
        //   call without a fixpoint loop, and the interaction with downstream
        //   passes creates patterns that duplicate defs. Needs proper preheader
        //   insertion + fixpoint to be safe. Li.1 remains OPEN for v5.2.
        let f7: MIRFunction = f6
        // Pass 7: escape analysis (v4.97.0)
        // v4.111.0: disabled — +0x3f3 crash on tests with user-defined functions.
        // v4.152.0: crash GONE (Ge.1 fix). Stub remained (Ea.1).
        // v5.1.2 Ea.1 CLOSED: escape_analysis_function now runs the full escape
        //   analysis (check_escape for each allocation site). The self-hosted
        //   Instruction enum lacks an alloc_kind field, so the result is computed
        //   but not annotated on instructions. The Python mir_opt.py version
        //   (escape_analysis_promotion) sets alloc_kind=STACK on the MIR
        //   dataclasses; the self-hosted path is parity-equivalent in analysis
        //   but defers codegen annotation to when the Instruction enum gains
        //   the alloc_kind discriminant (v5.2+ scope). Safe: returns f unchanged.
        let f8: MIRFunction = escape_analysis_function(f7)
        new_fns.push(f8)
        i = i + 1
    return module
