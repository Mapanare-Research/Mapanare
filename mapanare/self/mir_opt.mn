// mir_opt.mn — MIR optimizer for the Mapanare self-hosted compiler.
// Three passes: constant folding, constant propagation, dead block elimination.
// Wired into compile() after lower(), before emit().

import self::mir

// ---------------------------------------------------------------------------
// Pass 1: Constant folding
// Fold BinOp(Const(a), op, Const(b)) → Const(result)
// ---------------------------------------------------------------------------

fn fold_int_binop(op: BinOpKind, a: Int, b: Int) -> Option<Int> {
    match op {
        Add => { return Some(a + b) },
        Sub => { return Some(a - b) },
        Mul => { return Some(a * b) },
        _ => { return none }
    }
}

fn try_fold_instruction(inst: Instruction) -> Option<Instruction> {
    let ik: String = instr_kind(inst)
    if ik != "binop" { return none }
    let lhs: Value = instr_binop_lhs(inst)
    let rhs: Value = instr_binop_rhs(inst)
    let op: BinOpKind = instr_binop_op(inst)
    let dest: Value = instr_dest(inst)
    // Both operands must be named constants (format: literal value string)
    // Check if lhs and rhs names are integer literals
    if lhs.ty.kind != TK_INT() { return none }
    if rhs.ty.kind != TK_INT() { return none }
    // Names that start with % are SSA temps, not constants
    if lhs.name.starts_with("%") { return none }
    if rhs.name.starts_with("%") { return none }
    let a: Int = int(lhs.name)
    let b: Int = int(rhs.name)
    let result_opt: Option<Int> = fold_int_binop(op, a, b)
    match result_opt {
        Some(r) => {
            return Some(Instruction::Const(dest, mir_int(), toString(r)))
        },
        _ => { return none }
    }
}

fn constant_fold_block(bb: BasicBlock) -> BasicBlock {
    let mut new_instrs: List<Instruction> = []
    let mut i: Int = 0
    let mut changed: Bool = false
    for _ in 0..10000 {
        if i >= len(bb.instructions) {
            if changed {
                return new BasicBlock { label: bb.label, instructions: new_instrs }
            }
            return bb
        }
        let inst: Instruction = bb.instructions[i]
        let folded: Option<Instruction> = try_fold_instruction(inst)
        match folded {
            Some(new_inst) => {
                new_instrs.push(new_inst)
                changed = true
            },
            _ => { new_instrs.push(inst) }
        }
        i = i + 1
    }
    return bb
}

fn constant_fold_function(f: MIRFunction) -> MIRFunction {
    let mut new_blocks: List<BasicBlock> = []
    let mut i: Int = 0
    for _ in 0..5000 {
        if i >= len(f.blocks) {
            return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }
        }
        new_blocks.push(constant_fold_block(f.blocks[i]))
        i = i + 1
    }
    return f
}

// ---------------------------------------------------------------------------
// Pass 2: Constant propagation
// If Const(dest, ty, val), replace all uses of dest.name with the constant value.
// ---------------------------------------------------------------------------

struct ConstEntry {
    name: String,
    value: String,
    ty: MIRType
}

fn find_const(consts: List<ConstEntry>, name: String) -> Option<String> {
    let mut i: Int = 0
    for _ in 0..5000 {
        if i >= len(consts) { return none }
        if consts[i].name == name { return Some(consts[i].value) }
        i = i + 1
    }
    return none
}

fn find_const_ty(consts: List<ConstEntry>, name: String) -> MIRType {
    let mut i: Int = 0
    for _ in 0..5000 {
        if i >= len(consts) { return mir_unknown() }
        if consts[i].name == name { return consts[i].ty }
        i = i + 1
    }
    return mir_unknown()
}

fn replace_value(v: Value, consts: List<ConstEntry>) -> Value {
    let opt: Option<String> = find_const(consts, v.name)
    match opt {
        Some(cv) => {
            let ct: MIRType = find_const_ty(consts, v.name)
            return new Value { name: cv, ty: ct }
        },
        _ => { return v }
    }
}

fn propagate_in_instruction(inst: Instruction, consts: List<ConstEntry>) -> Instruction {
    let ik: String = instr_kind(inst)
    // Replace operands in BinOp
    if ik == "binop" {
        let lhs: Value = replace_value(instr_binop_lhs(inst), consts)
        let rhs: Value = replace_value(instr_binop_rhs(inst), consts)
        return Instruction::BinOp(instr_dest(inst), instr_binop_op(inst), lhs, rhs)
    }
    // Replace source in Copy
    if ik == "copy" {
        let src: Value = replace_value(instr_copy_src(inst), consts)
        return Instruction::Copy(instr_dest(inst), src)
    }
    return inst
}

fn const_prop_function(f: MIRFunction) -> MIRFunction {
    // Collect all Const definitions across all blocks
    let mut consts: List<ConstEntry> = []
    let mut bi: Int = 0
    for _ in 0..5000 {
        if bi >= len(f.blocks) { break }
        let bb: BasicBlock = f.blocks[bi]
        let mut ii: Int = 0
        for _ in 0..10000 {
            if ii >= len(bb.instructions) { break }
            let inst: Instruction = bb.instructions[ii]
            if instr_kind(inst) == "const" {
                let dest: Value = instr_dest(inst)
                let cval: String = instr_const_val(inst)
                // Only propagate simple integer constants (safe for BinOp operands)
                if len(cval) > 0 && dest.name.starts_with("%") && dest.ty.kind == TK_INT() {
                    let entry: ConstEntry = new ConstEntry { name: dest.name, value: cval, ty: dest.ty }
                    consts.push(entry)
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    if len(consts) == 0 { return f }
    // Propagate constants through instructions
    let mut new_blocks: List<BasicBlock> = []
    let mut bi2: Int = 0
    for _ in 0..5000 {
        if bi2 >= len(f.blocks) { break }
        let bb: BasicBlock = f.blocks[bi2]
        let mut new_instrs: List<Instruction> = []
        let mut ji: Int = 0
        for _ in 0..10000 {
            if ji >= len(bb.instructions) { break }
            new_instrs.push(propagate_in_instruction(bb.instructions[ji], consts))
            ji = ji + 1
        }
        new_blocks.push(new BasicBlock { label: bb.label, instructions: new_instrs })
        bi2 = bi2 + 1
    }
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }
}

// ---------------------------------------------------------------------------
// Pass 3: Dead block elimination
// Walk from entry block, mark reachable blocks, delete unreachable
// ---------------------------------------------------------------------------

fn collect_targets(inst: Instruction) -> List<String> {
    let ik: String = instr_kind(inst)
    let mut targets: List<String> = []
    if ik == "jump" {
        targets.push(instr_jump_target(inst))
    }
    if ik == "branch" {
        targets.push(instr_branch_true(inst))
        targets.push(instr_branch_false(inst))
    }
    if ik == "switch" {
        // Switch: collect case targets + default
        let cases: List<SwitchCase> = instr_switch_cases(inst)
        let mut ci: Int = 0
        for _ in 0..200 {
            if ci >= len(cases) { break }
            targets.push(cases[ci].block_label)
            ci = ci + 1
        }
        targets.push(instr_switch_default(inst))
    }
    return targets
}

fn is_in_list(name: String, lst: List<String>) -> Bool {
    let mut i: Int = 0
    for _ in 0..5000 {
        if i >= len(lst) { return false }
        if lst[i] == name { return true }
        i = i + 1
    }
    return false
}

fn clean_phi_entries(inst: Instruction, reachable: List<String>) -> Instruction {
    let entries: List<PhiEntry> = instr_phi_entries(inst)
    let mut kept: List<PhiEntry> = []
    let mut ei: Int = 0
    for _ in 0..200 {
        if ei >= len(entries) { break }
        if is_in_list(entries[ei].block_label, reachable) {
            kept.push(entries[ei])
        }
        ei = ei + 1
    }
    if len(kept) == len(entries) { return inst }
    return Instruction::Phi(instr_dest(inst), kept)
}

fn phi_needs_cleaning(bb: BasicBlock, reachable: List<String>) -> Bool {
    // Check if any PHI in this block references a non-reachable block
    let mut ji: Int = 0
    for _ in 0..10000 {
        if ji >= len(bb.instructions) { break }
        let inst: Instruction = bb.instructions[ji]
        if instr_kind(inst) == "phi" {
            let entries: List<PhiEntry> = instr_phi_entries(inst)
            let mut ei: Int = 0
            for _ in 0..200 {
                if ei >= len(entries) { break }
                if is_in_list(entries[ei].block_label, reachable) == false {
                    return true
                }
                ei = ei + 1
            }
        }
        ji = ji + 1
    }
    return false
}

fn clean_phis_in_block(bb: BasicBlock, reachable: List<String>) -> BasicBlock {
    // Only rebuild if this block actually has PHIs referencing removed blocks
    if phi_needs_cleaning(bb, reachable) == false { return bb }
    let saved_label: String = bb.label
    let mut new_instrs: List<Instruction> = []
    let mut ji: Int = 0
    for _ in 0..10000 {
        if ji >= len(bb.instructions) { break }
        let inst: Instruction = bb.instructions[ji]
        if instr_kind(inst) == "phi" {
            let cleaned: Instruction = clean_phi_entries(inst, reachable)
            new_instrs.push(cleaned)
        } else {
            new_instrs.push(inst)
        }
        ji = ji + 1
    }
    return new BasicBlock { label: saved_label, instructions: new_instrs }
}

fn block_terminator_targets(bb: BasicBlock) -> List<String> {
    // Only check the last instruction (terminator) — matches Python _compute_reachable
    if len(bb.instructions) == 0 {
        let empty: List<String> = []
        return empty
    }
    let last: Instruction = bb.instructions[len(bb.instructions) - 1]
    return collect_targets(last)
}

fn find_block_by_label(blocks: List<BasicBlock>, label: String) -> Option<BasicBlock> {
    let mut i: Int = 0
    for _ in 0..5000 {
        if i >= len(blocks) { return none }
        if blocks[i].label == label { return Some(blocks[i]) }
        i = i + 1
    }
    return none
}

fn add_targets_to_worklist(targets: List<String>, reachable: List<String>, worklist: List<String>) -> Bool {
    let mut ti: Int = 0
    let mut added: Bool = false
    for _ in 0..500 {
        if ti >= len(targets) { break }
        if is_in_list(targets[ti], reachable) == false {
            reachable.push(targets[ti])
            worklist.push(targets[ti])
            added = true
        }
        ti = ti + 1
    }
    return added
}

fn collect_phi_refs(f: MIRFunction) -> List<String> {
    // Collect all block labels referenced by PHI entries in any block
    let mut refs: List<String> = []
    let mut bi: Int = 0
    for _ in 0..5000 {
        if bi >= len(f.blocks) { break }
        let mut ii: Int = 0
        for _ in 0..10000 {
            if ii >= len(f.blocks[bi].instructions) { break }
            if instr_kind(f.blocks[bi].instructions[ii]) == "phi" {
                let entries: List<PhiEntry> = instr_phi_entries(f.blocks[bi].instructions[ii])
                let mut ei: Int = 0
                for _ in 0..200 {
                    if ei >= len(entries) { break }
                    if is_in_list(entries[ei].block_label, refs) == false {
                        refs.push(entries[ei].block_label)
                    }
                    ei = ei + 1
                }
            }
            ii = ii + 1
        }
        bi = bi + 1
    }
    return refs
}

fn dead_block_elim_function(f: MIRFunction) -> MIRFunction {
    if len(f.blocks) <= 1 { return f }
    // Fixed-point reachability: start with entry, iterate until stable
    let mut reachable: List<String> = []
    reachable.push(f.blocks[0].label)
    let mut changed: Bool = true
    for _ in 0..1000 {
        if changed == false { break }
        changed = false
        let mut bi: Int = 0
        for _ in 0..5000 {
            if bi >= len(f.blocks) { break }
            if is_in_list(f.blocks[bi].label, reachable) {
                let targets: List<String> = block_terminator_targets(f.blocks[bi])
                let mut ti: Int = 0
                for _ in 0..500 {
                    if ti >= len(targets) { break }
                    if is_in_list(targets[ti], reachable) == false {
                        reachable.push(targets[ti])
                        changed = true
                    }
                    ti = ti + 1
                }
            }
            bi = bi + 1
        }
    }
    // Also keep blocks referenced by PHI entries to avoid dangling labels
    let phi_refs: List<String> = collect_phi_refs(f)
    let mut pi: Int = 0
    for _ in 0..5000 {
        if pi >= len(phi_refs) { break }
        if is_in_list(phi_refs[pi], reachable) == false {
            reachable.push(phi_refs[pi])
        }
        pi = pi + 1
    }
    // Extend reachability from PHI-preserved blocks (they may jump to other blocks)
    let mut changed2: Bool = true
    for _ in 0..1000 {
        if changed2 == false { break }
        changed2 = false
        let mut bi2: Int = 0
        for _ in 0..5000 {
            if bi2 >= len(f.blocks) { break }
            if is_in_list(f.blocks[bi2].label, reachable) {
                let targets2: List<String> = block_terminator_targets(f.blocks[bi2])
                let mut ti2: Int = 0
                for _ in 0..500 {
                    if ti2 >= len(targets2) { break }
                    if is_in_list(targets2[ti2], reachable) == false {
                        reachable.push(targets2[ti2])
                        changed2 = true
                    }
                    ti2 = ti2 + 1
                }
            }
            bi2 = bi2 + 1
        }
    }
    // Keep only reachable blocks (now includes PHI-referenced blocks)
    let mut new_blocks: List<BasicBlock> = []
    let mut ki: Int = 0
    for _ in 0..5000 {
        if ki >= len(f.blocks) { break }
        if is_in_list(f.blocks[ki].label, reachable) {
            new_blocks.push(f.blocks[ki])
        }
        ki = ki + 1
    }
    if len(new_blocks) >= len(f.blocks) { return f }
    return new MIRFunction { name: f.name, params: f.params, return_type: f.return_type, blocks: new_blocks, decorators: f.decorators, is_public: f.is_public }
}

// ---------------------------------------------------------------------------
// Public API: optimize a MIR module
// ---------------------------------------------------------------------------

pub fn optimize_mir(module: MIRModule) -> MIRModule {
    let mut new_fns: List<MIRFunction> = []
    let mut i: Int = 0
    for _ in 0..5000 {
        if i >= len(module.functions) {
            return new MIRModule { name: module.name, functions: new_fns, structs: module.structs, enums: module.enums, extern_fns: module.extern_fns, agents: module.agents, pipes: module.pipes, imports: module.imports, trait_names: module.trait_names, consts: module.consts }
        }
        let f: MIRFunction = module.functions[i]
        let f2: MIRFunction = constant_fold_function(f)
        let f3: MIRFunction = const_prop_function(f2)
        let f4: MIRFunction = dead_block_elim_function(f3)
        new_fns.push(f4)
        i = i + 1
    }
    return module
}
