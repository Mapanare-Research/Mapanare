// lower.mn — AST → MIR lowering pass for the Mapanare self-hosted compiler.
// Core lowering logic: declaration registration, definition lowering,
// expression/statement lowering, control flow, pretty-printer, verifier.
//
// Data structures (MIRType, Value, Instruction, etc.) are in mir.mn.
// State management (LowerState, lookups, type resolution) is in lower_state.mn.

import self::ast
import self::mir
import self::lower_state

// ---------------------------------------------------------------------------
// Declaration registration (Pass 1)
// ---------------------------------------------------------------------------

fn register_declarations(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    // Pass 1: register enums first so struct field types can distinguish enum vs struct
    s = register_declarations_pass1(s, program)
    // Pass 2: register structs, impls, functions, imports
    s = register_declarations_pass2(s, program)
    s

// Pass 1: register enums. Extracted to helper to use return-based loop exit.
fn register_declarations_pass1(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(program.definitions) { return s }
        let defn: Definition = program.definitions[i]
        // Use register_enum_if_enum to avoid match PHI zeroinitializer bug
        s = register_enum_if_enum(s, defn)
        i = i + 1
    return s

// If defn is EnumDef, register it. Generic enums are deferred.
fn register_enum_if_enum(st: LowerState, defn: Definition) -> LowerState:
    if def_kind(defn) == "enum_def":
        let ed: EnumDefData = def_enum_data(defn)
        if len(ed.type_params) > 0:
            let mut new_st_ge: LowerState = st
            let mut ge_list: List<EnumDefData> = new_st_ge.generic_enums
            ge_list.push(ed)
            new_st_ge.generic_enums = ge_list
            return new_st_ge
        return register_enum(st, ed)
    return st

// Pass 2: register non-enum definitions. Extracted for return-based exit.
fn register_declarations_pass2(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(program.definitions) { return s }
        let defn: Definition = program.definitions[i]
        s = register_nonenums(s, defn)
        i = i + 1
    return s

// If defn is NOT EnumDef, register it. Otherwise return state unchanged.
fn register_nonenums(st: LowerState, defn: Definition) -> LowerState:
    if def_kind(defn) == "enum_def" { return st }
    return register_definition(st, defn)

fn register_definition(st: LowerState, defn: Definition) -> LowerState:
    let dk: String = def_kind(defn)
    if dk == "struct_def":
        let sd: StructDefData = def_struct_data(defn)
        if len(sd.type_params) > 0:
            let mut new_st_gs: LowerState = st
            let mut gs_list: List<StructDefData> = new_st_gs.generic_structs
            gs_list.push(sd)
            new_st_gs.generic_structs = gs_list
            return new_st_gs
        return register_struct(st, sd)
    if dk == "enum_def":
        let ed: EnumDefData = def_enum_data(defn)
        if len(ed.type_params) > 0:
            let mut new_st_ge: LowerState = st
            let mut ge_list: List<EnumDefData> = new_st_ge.generic_enums
            ge_list.push(ed)
            new_st_ge.generic_enums = ge_list
            return new_st_ge
        return register_enum(st, ed)
    if dk == "impl_def":
        let impl_target: String = def_impl_target(defn)
        // Check if target is a generic struct — if so, store methods for later monomorphization
        let gs_check: Option<StructDefData> = find_generic_struct(st, impl_target)
        match gs_check {
            Some(gs_data) => {
                // Store each method in generic_fns with target prefix and struct's type_params
                let mut s_gi: LowerState = st
                let gi_methods: List<FnDefData> = def_impl_methods(defn)
                let mut gi: Int = 0
                for _ in 0..500 {
                    if gi >= len(gi_methods) { return s_gi }
                    let gm: FnDefData = gi_methods[gi]
                    // Create a copy with prefixed name and struct type params
                    let prefixed_name: String = impl_target + "_" + gm.name
                    let impl_fn: FnDefData = new_fn_def_data(gm.span, prefixed_name, false, gs_data.type_params, gm.params, gm.return_type, gm.body, gm.decorators)
                    let mut gfn_list: List<FnDefData> = s_gi.generic_fns
                    gfn_list.push(impl_fn)
                    s_gi.generic_fns = gfn_list
                    gi = gi + 1
                }
                return s_gi
            },
            _ => { return register_impl(st, impl_target, def_impl_methods(defn)) }
        }
    if dk == "import_def":
        let info: ImportInfo = new_import_info(def_import_path(defn), def_import_items(defn))
        let mut new_st_imp: LowerState = st
        let mut mod_tmp: MIRModule = new_st_imp.module
        let mut imp_list: List<ImportInfo> = mod_tmp.imports
        imp_list.push(info)
        mod_tmp.imports = imp_list
        new_st_imp.module = mod_tmp
        return new_st_imp
    if dk == "export_def":
        let inner_opt: Option<Definition> = def_export_inner(defn)
        match inner_opt:
            Some(inner) => { return register_definition(st, inner) }
            _ => { return st }
    if dk == "fn_def":
        let fd: FnDefData = def_fn_data(defn)
        // Store generic functions for on-demand monomorphization
        if len(fd.type_params) > 0:
            let mut new_st_gen: LowerState = st
            let mut gfns: List<FnDefData> = new_st_gen.generic_fns
            gfns.push(fd)
            new_st_gen.generic_fns = gfns
            return new_st_gen
        // Register function return type via lambda_vars (top-level list,
        // properly COW-cloned). Using "__ret__fn_name" as the key.
        // This avoids the nested MIRModule.functions COW corruption issue.
        let ret_ty: MIRType = resolve_return_type_checked(st, fd.return_type)
        let ret_key: String = "__ret__" + fd.name
        let ret_val: String = tk_name(ret_ty.kind) + ":" + ret_ty.name
        let entry: LambdaEntry = new_lambda_entry(ret_key, ret_val)
        let mut new_st_fn: LowerState = st
        let mut lv_fn: List<LambdaEntry> = new_st_fn.lambda_vars
        lv_fn.push(entry)
        new_st_fn.lambda_vars = lv_fn
        return new_st_fn
    if dk == "extern_fn_def":
        return register_extern_fn(st, defn)
    if dk == "let_def":
        return register_module_let(st, defn)
    // v4.55.0: const_def — register same as let_def for lowering
    if dk == "const_def":
        return register_module_const(st, defn)
    return st

fn register_module_let(st: LowerState, defn: Definition) -> LowerState:
    let name: String = def_let_name(defn)
    let type_name: String = def_let_type(defn)
    let value_expr: Expr = def_let_value(defn)
    let ek: String = expr_kind(value_expr)
    let mut s: LowerState = st
    let mut mod_tmp: MIRModule = s.module
    let mut consts_list: List<ModuleConst> = mod_tmp.consts
    let mut lv: List<LambdaEntry> = s.lambda_vars
    if ek == "int_lit":
        let iv: Int = expr_int_val(value_expr)
        let mc: ModuleConst = new_module_const_int(name, type_name, iv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "int:" + toString(iv))
        lv.push(entry)
    if ek == "string_lit":
        let sv: String = expr_string_val(value_expr)
        let mc: ModuleConst = new_module_const_str(name, type_name, sv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "string:" + sv)
        lv.push(entry)
    if ek == "float_lit":
        let mc: ModuleConst = new_module_const_int(name, type_name, 0)
        consts_list.push(mc)
    if ek == "bool_lit":
        let bv: Int = 0
        if expr_bool_val(value_expr) { let bv: Int = 1 }
        let mc: ModuleConst = new_module_const_int(name, type_name, bv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "bool:" + toString(bv))
        lv.push(entry)
    mod_tmp.consts = consts_list
    s.module = mod_tmp
    s.lambda_vars = lv
    return s

// v4.55.0: const lowering — same as let but uses ConstDef accessors
fn register_module_const(st: LowerState, defn: Definition) -> LowerState:
    let name: String = def_const_name(defn)
    let te: TypeExpr = def_const_type_expr(defn)
    let type_name: String = type_expr_name(te)
    let value_expr: Expr = def_const_value(defn)
    let ek: String = expr_kind(value_expr)
    let mut s: LowerState = st
    let mut mod_tmp: MIRModule = s.module
    let mut consts_list: List<ModuleConst> = mod_tmp.consts
    let mut lv: List<LambdaEntry> = s.lambda_vars
    if ek == "int_lit":
        let iv: Int = expr_int_val(value_expr)
        let mc: ModuleConst = new_module_const_int(name, type_name, iv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "int:" + toString(iv))
        lv.push(entry)
    if ek == "string_lit":
        let sv: String = expr_string_val(value_expr)
        let mc: ModuleConst = new_module_const_str(name, type_name, sv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "string:" + sv)
        lv.push(entry)
    if ek == "float_lit":
        let mc: ModuleConst = new_module_const_int(name, type_name, 0)
        consts_list.push(mc)
    if ek == "bool_lit":
        let bv: Int = 0
        if expr_bool_val(value_expr) { let bv: Int = 1 }
        let mc: ModuleConst = new_module_const_int(name, type_name, bv)
        consts_list.push(mc)
        let entry: LambdaEntry = new_lambda_entry("__const__" + name, "bool:" + toString(bv))
        lv.push(entry)
    mod_tmp.consts = consts_list
    s.module = mod_tmp
    s.lambda_vars = lv
    return s

fn register_extern_fn(st: LowerState, defn: Definition) -> LowerState:
    let abi: String = def_extern_abi(defn)
    let fn_name: String = def_extern_name(defn)
    let params: List<Param> = def_extern_params(defn)
    let ret_opt: Option<TypeExpr> = def_extern_return_type(defn)

    // Resolve return type
    let ret_ty: MIRType = resolve_return_type_checked(st, ret_opt)

    // Register function return type in lambda_vars (for call resolution)
    let ret_key: String = "__ret__" + fn_name
    let ret_val: String = tk_name(ret_ty.kind) + ":" + ret_ty.name
    let entry: LambdaEntry = new_lambda_entry(ret_key, ret_val)
    let mut s: LowerState = st
    let mut lv: List<LambdaEntry> = s.lambda_vars
    lv.push(entry)
    s.lambda_vars = lv

    // Resolve parameter types
    let mut param_types: List<MIRType> = []
    let mut i: Int = 0
    for _ in 0..50:
        if i >= len(params):
            // Push ExternFnInfo to module.extern_fns
            let info: ExternFnInfo = new_extern_fn_info(abi, "", fn_name, param_types, ret_ty)
            let mut mod_tmp: MIRModule = s.module
            let mut ext_list: List<ExternFnInfo> = mod_tmp.extern_fns
            ext_list.push(info)
            mod_tmp.extern_fns = ext_list
            s.module = mod_tmp
            return s
        let p: Param = params[i]
        match p.type_annotation {
            Some(te) => {
                param_types.push(lower_resolve_type_checked(s, te))
            },
            _ => {
                param_types.push(mir_unknown())
            }
        }
        i = i + 1

    // Fallback: push whatever we have
    let info_fb: ExternFnInfo = new_extern_fn_info(abi, "", fn_name, param_types, ret_ty)
    let mut mod_fb: MIRModule = s.module
    let mut ext_fb: List<ExternFnInfo> = mod_fb.extern_fns
    ext_fb.push(info_fb)
    mod_fb.extern_fns = ext_fb
    s.module = mod_fb
    return s

fn register_struct(st: LowerState, data: StructDefData) -> LowerState:
    let mut fields: List<FieldPair> = []
    let mut field_names: List<String> = []
    let mut field_types: List<MIRType> = []
    let mut i: Int = 0
    let mut s: LowerState = st

    for _ in 0..500:
        if i >= len(data.fields):
            let info: StructInfo = new_struct_info(data.name, fields)
            s.module = module_push_struct(s.module, info)
            let sfi: StructFieldInfo = new_struct_field_info(data.name, field_names, field_types)
            let mut sf_lst: List<StructFieldInfo> = s.struct_fields
            sf_lst.push(sfi)
            s.struct_fields = sf_lst
            // Own.1 (v5.1.3): clear moved-ownership locals.
            // Mirrors Cb.7 pattern at monomorphize sites (lines 1795-1798).
            // fields/field_names/field_types ownership moved into module via
            // info and sfi. Zero headers so future drop-glue won't double-free.
            fields = []
            field_names = []
            field_types = []
            return s
        let field: StructField = data.fields[i]
        let fty: MIRType = lower_resolve_type_checked(s, field.type_annotation)
        let fp: FieldPair = new_field_pair(field.name, new_value("", fty))
        fields.push(fp)
        field_names.push(field.name)
        field_types.push(fty)
        i = i + 1
    return s

fn register_enum(st: LowerState, data: EnumDefData) -> LowerState:
    let mut variants: List<EnumVariantInfo> = []
    let mut variant_names: List<String> = []
    let mut i: Int = 0
    let mut s: LowerState = st

    for _ in 0..500:
        if i >= len(data.variants):
            let info: EnumInfo = new_enum_info(data.name, variants)
            s.module = module_push_enum(s.module, info)
            let evn: EnumVariantNames = new_enum_variant_names(data.name, variant_names)
            let mut ev_lst: List<EnumVariantNames> = s.enum_variants
            ev_lst.push(evn)
            s.enum_variants = ev_lst
            // Own.1 (v5.1.3): clear moved-ownership locals.
            // Mirrors Cb.7 pattern at monomorphize sites (lines 1997-1998).
            // variants/variant_names ownership moved into module via
            // info and evn. Zero headers so future drop-glue won't double-free.
            variants = []
            variant_names = []
            return s
        let variant: EnumVariant = data.variants[i]
        let mut payload_types: List<MIRType> = []
        let mut j: Int = 0
        for _ in 0..100:
            if j < len(variant.fields):
                let fty: MIRType = lower_resolve_type_expr(variant.fields[j])
                payload_types.push(fty)
                j = j + 1
        let vi: EnumVariantInfo = new_enum_variant_info(variant.name, payload_types)
        variants.push(vi)
        variant_names.push(variant.name)
        i = i + 1
    return s

fn register_impl(st: LowerState, target: String, methods: List<FnDefData>) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(methods) { return s }
        let method: FnDefData = methods[i]
        let key: String = target + "." + method.name
        let mir_name: String = target + "_" + method.name
        let entry: ImplEntry = new_impl_entry(key, mir_name)
        let mut im_lst: List<ImplEntry> = s.impl_methods
        im_lst.push(entry)
        s.impl_methods = im_lst
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// Definition lowering (Pass 2)
// ---------------------------------------------------------------------------

fn lower_definitions(st: LowerState, program: Program) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(program.definitions):
            return s
        let defn: Definition = program.definitions[i]
        let new_s: LowerState = lower_definition(s, defn)
        s = new_s
        i = i + 1
    return s

fn lower_definition(st: LowerState, defn: Definition) -> LowerState:
    let dk: String = def_kind(defn)
    if dk == "fn_def":
        let fd: FnDefData = def_fn_data(defn)
        if len(fd.type_params) > 0 { return st }
        return lower_fn(st, fd, "")
    if dk == "agent_def":
        return lower_agent(st, def_agent_data(defn))
    if dk == "impl_def":
        let impl_tgt: String = def_impl_target(defn)
        // Skip generic impls — methods lowered on demand via struct monomorphization
        let gs_lower: Option<StructDefData> = find_generic_struct(st, impl_tgt)
        match gs_lower:
            Some(_) => { return st }
            _ => { return lower_impl(st, impl_tgt, def_impl_methods(defn)) }
    if dk == "export_def":
        let inner_opt: Option<Definition> = def_export_inner(defn)
        match inner_opt {
            Some(inner) => {
                let s: LowerState = lower_definition(st, inner)
                return s
            },
            _ => { return st }
        }
    return st

// ---------------------------------------------------------------------------
// Function lowering
// ---------------------------------------------------------------------------

// Helper: build MIR params from FnDefData.params (helper for clarity)
fn build_mir_params(st: LowerState, fn_params: List<Param>) -> List<MIRParam>:
    let mut params: List<MIRParam> = []
    let mut pi: Int = 0
    for _ in 0..500:
        if pi >= len(fn_params) { return params }
        let p: Param = fn_params[pi]
        let pty: MIRType = lower_resolve_type_opt_checked(st, p.type_annotation)
        let mp: MIRParam = new_mir_param(p.name, pty)
        params.push(mp)
        pi = pi + 1
    return params

// Helper: collect decorator names (helper for clarity)
fn collect_decorator_names(decorators: List<Decorator>) -> List<String>:
    let mut names: List<String> = []
    let mut dix: Int = 0
    for _ in 0..100:
        if dix >= len(decorators) { return names }
        let dec: Decorator = decorators[dix]
        names.push(dec.name)
        dix = dix + 1
    return names

// Helper: bind params as variables in entry block (helper for clarity)
fn bind_fn_params(st: LowerState, fn_params: List<Param>) -> LowerState:
    let mut s: LowerState = st
    let mut bi: Int = 0
    for _ in 0..500:
        if bi >= len(fn_params) { return s }
        let p: Param = fn_params[bi]
        let pty: MIRType = lower_resolve_type_opt_checked(s, p.type_annotation)
        let addr_name: String = "%" + p.name + ".addr"
        let addr: Value = new_value(addr_name, pty)
        let param_val: Value = new_value("%" + p.name, pty)
        s = emit_instr(s, Instruction::Alloca(addr, pty))
        s = emit_instr(s, Instruction::Store(addr, param_val))
        s = define_var(s, p.name, addr, false)
        bi = bi + 1
    return s

fn lower_fn(st: LowerState, fn_def: FnDefData, name_prefix: String) -> LowerState:
    let fn_name: String = name_prefix + fn_def.name

    // Build params and decorators using helpers (helper for clarity)
    let params: List<MIRParam> = build_mir_params(st, fn_def.params)
    let ret_type: MIRType = resolve_return_type_checked(st, fn_def.return_type)
    let decorators: List<String> = collect_decorator_names(fn_def.decorators)

    let mir_fn: MIRFunction = new_mir_function(fn_name, params, ret_type, decorators, fn_def.public)

    // Save state
    let prev_fn: Option<MIRFunction> = st.current_fn
    let prev_block_idx: Int = st.current_block_idx
    let prev_tmp: Int = st.tmp_counter
    let prev_blk_cnt: Int = st.block_counter
    let prev_vars: List<VarInfo> = st.vars
    let prev_blocks: List<BasicBlock> = st.fn_blocks

    let mut s: LowerState = st
    s.current_fn = Some(mir_fn)
    s.tmp_counter = 0
    s.block_counter = 0
    // v5.20.1 Te.5.F — reset synthesized-base counter per fn so
    // `__mn_base_N` / `__mn_dst_N` numbering restarts at 0 each function.
    s.struct_update_counter = 0
    // v5.21.0 Te.6 — reset chained-compare temp counter per fn.
    s.chain_compare_counter = 0
    let fresh_vars: List<VarInfo> = []
    s.vars = fresh_vars
    let fresh_blocks: List<BasicBlock> = []
    s.fn_blocks = fresh_blocks

    // Create entry block
    s = add_block(s, "entry")
    s = set_block(s, 0)

    // Bind params as variables
    let mut bi: Int = 0
    s = bind_fn_params(s, fn_def.params)

    // Lower body
    let body_r: LowerResult = lower_block(s, fn_def.body)
    s = body_r.state

    // Add implicit return if block isn't terminated
    if !current_block_terminated(s):
        if ret_type.kind == TK_VOID():
            s = emit_instr(s, Instruction::Return(none))
        else:
            s = emit_instr(s, Instruction::Return(Some(body_r.value)))

    // Copy fn_blocks into MIRFunction and add to module.
    let mut final_fn: MIRFunction = mir_fn
    final_fn.blocks = s.fn_blocks
    s.module = module_push_function(s.module, final_fn)

    // Restore state
    s.current_fn = prev_fn
    s.current_block_idx = prev_block_idx
    s.tmp_counter = prev_tmp
    s.block_counter = prev_blk_cnt
    s.vars = prev_vars
    s.fn_blocks = prev_blocks

    return s

fn lower_agent(st: LowerState, data: AgentDefData) -> LowerState:
    let mut s: LowerState = st
    let mut method_names: List<String> = []

    // Lower each method
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(data.methods):
            let inputs: List<String> = extract_agent_input_names(data)
            let outputs: List<String> = extract_agent_output_names(data)
            let info: AgentInfo = new_agent_info(data.name, inputs, outputs, method_names)
            s.module = module_push_agent(s.module, info)
            return s
        let method: FnDefData = data.methods[i]
        s = lower_fn(s, method, data.name + "_")
        let method_mir_name: String = data.name + "_" + method.name
        method_names.push(method_mir_name)
        i = i + 1
    return s

fn extract_agent_input_names(data: AgentDefData) -> List<String>:
    let mut names: List<String> = []
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(data.inputs) { return names }
        let inp: AgentInput = data.inputs[i]
        names.push(inp.name)
        i = i + 1
    return names

fn extract_agent_output_names(data: AgentDefData) -> List<String>:
    let mut names: List<String> = []
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(data.outputs) { return names }
        let out: AgentOutput = data.outputs[i]
        names.push(out.name)
        i = i + 1
    return names

fn lower_impl(st: LowerState, target: String, methods: List<FnDefData>) -> LowerState:
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(methods) { return s }
        let method: FnDefData = methods[i]
        // Fix self parameter type: inject target struct type for untyped "self"
        let fixed: FnDefData = fix_self_param_type(method, target)
        s = lower_fn(s, fixed, target + "_")
        i = i + 1
    return s

fn fix_self_param_type(method: FnDefData, target: String) -> FnDefData:
    if len(method.params) == 0 { return method }
    let first: Param = method.params[0]
    if first.name != "self" { return method }
    // Check if self already has a type annotation
    match first.type_annotation:
        Some(_) => { return method }
        _ => {}
    // Inject target struct type for self
    let self_type: TypeExpr = TypeExpr::Named(target)
    let fixed_self: Param = new Param { span: first.span, name: "self", type_annotation: Some(self_type) }
    let mut new_params: List<Param> = []
    new_params.push(fixed_self)
    for pi in 1..len(method.params):
        new_params.push(method.params[pi])
    return new_fn_def_data(method.span, method.name, method.public, method.type_params, new_params, method.return_type, method.body, method.decorators)

// ---------------------------------------------------------------------------
// Block / statement lowering
// ---------------------------------------------------------------------------

fn lower_block(st: LowerState, block: Block) -> LowerResult:
    let s: LowerState = lower_push_scope(st)
    // Use helper to iterate statements (avoids return-inside-if-inside-for bug)
    let r: LowerResult = lower_block_stmts(s, block.stmts)
    let final_s: LowerState = lower_pop_scope(r.state)
    return new_lower_result(r.value, final_s)

// Helper: iterate block statements. Uses return-based exit.
fn lower_block_stmts(st: LowerState, stmts: List<Stmt>) -> LowerResult:
    let mut s: LowerState = st
    let mut last_val: Value = void_value()
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(stmts) { return new_lower_result(last_val, s) }
        if current_block_terminated(s) { return new_lower_result(last_val, s) }
        let stmt: Stmt = stmts[i]
        let r: LowerResult = lower_stmt(s, stmt)
        s = r.state
        last_val = r.value
        i = i + 1
    return new_lower_result(last_val, s)

fn lower_stmt(st: LowerState, stmt: Stmt) -> LowerResult:
    let sk: String = stmt_kind(stmt)
    if sk == "let":
        let s_let: LowerState = lower_let(st, stmt_let_name(stmt), stmt_let_mutable(stmt), stmt_let_type(stmt), stmt_let_value(stmt))
        return new_lower_result(void_value(), s_let)
    if sk == "expr_stmt":
        return lower_expr(st, stmt_expr(stmt))
    if sk == "return":
        let s_ret: LowerState = lower_return(st, stmt_return_val(stmt))
        return new_lower_result(void_value(), s_ret)
    if sk == "for":
        let s_for: LowerState = lower_for(st, stmt_for_var(stmt), stmt_for_iter(stmt), stmt_for_body(stmt))
        return new_lower_result(void_value(), s_for)
    if sk == "while":
        let s_while: LowerState = lower_while(st, stmt_while_cond(stmt), stmt_while_body(stmt))
        return new_lower_result(void_value(), s_while)
    if sk == "break":
        if st.loop_exit_label != "":
            let s_brk: LowerState = emit_instr(st, Instruction::Jump(st.loop_exit_label))
            return new_lower_result(void_value(), s_brk)
        return new_lower_result(void_value(), st)
    if sk == "continue":
        if st.loop_header_label != "":
            let s_cont: LowerState = emit_instr(st, Instruction::Jump(st.loop_header_label))
            return new_lower_result(void_value(), s_cont)
        return new_lower_result(void_value(), st)
    // v5.14.1 B.4: `pass` is a no-op — emit zero MIR.
    if sk == "pass" { return new_lower_result(void_value(), st) }
    if sk == "assert":
        let s_assert: LowerState = lower_assert(st, stmt_assert_expr(stmt), stmt_assert_msg(stmt))
        return new_lower_result(void_value(), s_assert)
    if sk == "signal_decl":
        let s_sig: LowerState = lower_signal_decl(st, stmt_signal_name(stmt), stmt_signal_mutable(stmt), stmt_signal_type(stmt), stmt_signal_value(stmt))
        return new_lower_result(void_value(), s_sig)
    if sk == "stream_decl":
        let s_strm: LowerState = lower_stream_decl(st, stmt_stream_name(stmt), stmt_stream_value(stmt))
        return new_lower_result(void_value(), s_strm)
    // v5.20.1 Te.5.F.D — `let Point { x, y } = expr`.
    if sk == "let_destructure":
        let s_ld: LowerState = lower_let_destructure(st, stmt_letdest_pattern(stmt), stmt_letdest_mutable(stmt), stmt_letdest_type(stmt), stmt_letdest_value(stmt))
        return new_lower_result(void_value(), s_ld)
    // v5.20.1 Te.5.F.E — `let Some(x) = expr else block`.
    if sk == "let_else":
        let s_le: LowerState = lower_let_else(st, stmt_letelse_pattern(stmt), stmt_letelse_scrutinee(stmt), stmt_letelse_else(stmt))
        return new_lower_result(void_value(), s_le)
    // v5.20.1 Te.5.F.E — `while let <pat> = expr block`.
    if sk == "while_let":
        let s_wl: LowerState = lower_while_let(st, stmt_whilelet_pattern(stmt), stmt_whilelet_scrutinee(stmt), stmt_whilelet_body(stmt))
        return new_lower_result(void_value(), s_wl)
    return new_lower_result(void_value(), st)

// ---------------------------------------------------------------------------
// Let binding
// ---------------------------------------------------------------------------

fn lower_let(st_in: LowerState, name: String, mutable: Bool, type_ann: Option<TypeExpr>, value: Expr) -> LowerState:
    // Check if the value expression is a None literal BEFORE lowering.
    // This flag is used later to decide whether to re-wrap with typed WrapNone.
    let mut is_none_literal: Bool = false
    if expr_kind(value) == "none_lit" { is_none_literal = true }

    // v5.15.1 — comprehension type-hint plumbing. When the RHS is a
    // comprehension and the binding has a `List<T>` / `Map<K, V>`
    // annotation, hand it to `lower_comprehension` via the lowerer
    // state so the synthesizer can thread it onto the internal
    // accumulator. Cleared in `lower_comprehension` on entry. Mirror
    // of Python `lower.py::_lower_let` v5.15.0 Te.2.
    let mut st: LowerState = st_in
    if expr_kind(value) == "comprehension":
        match type_ann:
            Some(_) => { st.comp_type_hint = type_ann }
            _ => { st.comp_type_hint = none }
    else:
        st.comp_type_hint = none

    // v5.6.7 Ve.2 fix — empty-list elem_ty propagation. When lowering
    // `let xs: List<T> = []`, the default path `lower_expr → lower_list`
    // can't see the type annotation and emits MIR with
    // `elem_ty.kind=TK_UNKNOWN`. Downstream, `resolve_mir_type` maps
    // UNKNOWN to "i64" and `emit_list_init` allocates 8-byte slots for
    // lists whose elements are 16-byte Strings, 48-byte Params, etc. —
    // silent corruption previously masked by a 384-byte floor. Fix:
    // when value is a list literal AND type_ann is `Generic("List", [T])`,
    // route through `lower_list_typed` so the emitter sees the
    // annotation's element type on `Instruction::ListInit`.
    //
    // v5.6.12 Lk.1 fix — destination passing for List let-bindings.
    // When the hint path applies, pre-compute the var's alloca name
    // and lower the list literal directly into it via
    // `lower_list_typed_into`. Skips the post-emit Alloca + Store pair
    // entirely (those would create a duplicate alloca + useless copy
    // — exactly the alloca-aliasing leak from v5.6.10 Lk.1).
    let hint_elem: MIRType = lower_let_list_hint(st, value, type_ann)
    if hint_elem.kind != TK_UNKNOWN():
        let mut s: LowerState = st
        // Reserve the var's name + alloca BEFORE lowering the value so
        // the ListInit dest (`%<name><M>`) and emit_list_init's derived
        // alloca name (`%<name><M>.addr`) match the var slot.
        let var_base: String = "%" + name + toString(s.tmp_counter)
        let addr_name: String = var_base + ".addr"
        s.tmp_counter = s.tmp_counter + 1

        // Resolve declared val_ty (List<T>). Carries the element-type
        // arg for downstream lookups (e.g. method dispatch).
        let mut val_ty: MIRType = mir_list()
        match type_ann {
            Some(te) => {
                let declared: MIRType = lower_resolve_type_checked(s, te)
                if declared.kind != TK_UNKNOWN() {
                    val_ty = declared
                }
            },
            _ => {}
        }

        // Lower into var_base. The emitter hoists the alloca + zero-init
        // into the entry prelude AND stores the new list into it; no
        // explicit Alloca/Store needed here.
        let r2: LowerResult = lower_list_typed_into(s, expr_list_elements(value), hint_elem, var_base)
        s = r2.state

        // Bind the var to the alloca derived from var_base.
        let addr2: Value = new_value(addr_name, val_ty)
        s = define_var(s, name, addr2, mutable)
        return s

    // v5.6.13 Layer 1 extension — destination passing for struct
    // let-bindings. The parser encodes `let foo: Foo = new Foo {...}`
    // as `Call(Ident("__new_Foo"), [val1, val2, ...])` — see
    // parser.mn::parse_struct_construct. lower_call_by_name unwraps
    // this into `Instruction::StructInit` with a fresh-tmp dest. For
    // a let-binding, route through lower_struct_new_into and use the
    // var's alloca name directly so the emitter's renamed `.addr`
    // scratch (was `.si` pre-v5.6.13) for `%foo<N>` produces
    // `%foo<N>.addr` — the let's binding alloca itself. One alloca
    // instead of (.addr scratch + .addr binding) and one fewer
    // load+store at the let boundary. Same mechanism as v5.6.12's
    // list path; no observable leak in the corpus drives this change
    // (preventive cleanup only).
    if expr_kind(value) == "call":
        let callee_v: Expr = expr_call_callee(value)
        if expr_kind(callee_v) == "ident":
            let callee_name_v: String = expr_ident_name(callee_v)
            if callee_name_v.starts_with("__new_"):
                let struct_name_v: String = callee_name_v.substr(6, len(callee_name_v) - 6)
                // Only non-generic registered structs go through the fast
                // path. Generics need try_monomorphize_struct in
                // lower_call_by_name; let those fall through to the
                // existing path.
                if is_struct_name(st, struct_name_v):
                    let mut s: LowerState = st
                    let var_base: String = "%" + name + toString(s.tmp_counter)
                    let addr_name: String = var_base + ".addr"
                    s.tmp_counter = s.tmp_counter + 1

                    let r2: LowerResult = lower_struct_new_into(s, struct_name_v, expr_call_args(value), var_base)
                    s = r2.state

                    let struct_ty: MIRType = mir_struct(struct_name_v)
                    let addr2: Value = new_value(addr_name, struct_ty)
                    s = define_var(s, name, addr2, mutable)
                    return s

    let r: LowerResult = lower_expr(st, value)
    let mut s: LowerState = r.state

    // Update lambda registration: lower_lambda left var_name empty
    let num_lv: Int = len(s.lambda_vars)
    if num_lv > 0:
        let last_e: LambdaEntry = s.lambda_vars[num_lv - 1]
        if last_e.var_name == "":
            let updated: LambdaEntry = new_lambda_entry(name, last_e.fn_name)
            s.lambda_vars[num_lv - 1] = updated

    // Prefer the declared type annotation over the expression's inferred type.
    // This is critical: function calls return mir_unknown(), but the declared
    // type (e.g., `let ch: String = lexer_peek(source)`) carries the real type.
    let mut val_ty: MIRType = r.value.ty
    let mut val: Value = r.value
    match type_ann {
        Some(te) => {
            let declared: MIRType = lower_resolve_type_checked(s, te)
            if declared.kind != TK_UNKNOWN() {
                val_ty = declared
                // Patch the value to carry the declared type (same SSA name, correct type)
                val = new_value(r.value.name, declared)
            }
        },
        _ => {}
    }

    // Find or create alloca for this variable (use counter for uniqueness
    // when the same variable name appears in different branches)
    let addr_name: String = "%" + name + toString(s.tmp_counter) + ".addr"
    s.tmp_counter = s.tmp_counter + 1

    let addr: Value = new_value(addr_name, val_ty)

    // Emit Alloca with the resolved type
    s = emit_instr(s, Instruction::Alloca(addr, val_ty))

    // For None stored to a typed Option alloca: re-emit WrapNone with the
    // declared type so the value and alloca types match.
    // ONLY do this for actual None literals (value name contains "tnone" or
    // is the WrapNone result), NOT for function call results that happen to
    // have untyped Option return. Check: if the expression was NoneLit, the
    // value name starts with "%t" and has no "_val" (it's a direct constant,
    // not a loaded variable or call result).
    if is_none_literal && val_ty.kind == TK_OPTION() && len(val_ty.args) > 0:
        let typed_none_r: LowerResult = make_value(s, val_ty, "tnone")
        s = emit_instr(typed_none_r.state, Instruction::WrapNone(typed_none_r.value, val_ty))
        val = typed_none_r.value

    // Store value to alloca
    s = emit_instr(s, Instruction::Store(addr, val))

    // Track the alloca address in our variable map
    s = define_var(s, name, addr, mutable)
    return s

// ---------------------------------------------------------------------------
// Return
// ---------------------------------------------------------------------------

fn lower_return(st: LowerState, value_opt: Option<Expr>) -> LowerState:
    match value_opt {
        Some(expr) => {
            let r: LowerResult = lower_expr(st, expr)
            // Return the value directly — no Copy needed.
            // (Avoids `add i64 0, %struct_val` type mismatch for struct returns.)
            return emit_instr(r.state, Instruction::Return(Some(r.value)))
        },
        _ => {
            return emit_instr(st, Instruction::Return(none))
        }
    }

// ---------------------------------------------------------------------------
// For loop
// ---------------------------------------------------------------------------

fn lower_for_map(st: LowerState, var_name: String, map_val: Value, body: Block) -> LowerState:
    let mut s: LowerState = st

    // Get keys list: __mn_map_keys(map_ptr)
    // First extract the map pointer from the {ptr, i64} map value
    let keys_r: LowerResult = make_value(s, mir_list(), "map_keys")
    s = keys_r.state
    let mut keys_args: List<Value> = []
    keys_args.push(map_val)
    s = emit_instr(s, Instruction::Call(keys_r.value, "__mn_map_keys", keys_args))

    // Get key count: len(keys)
    let len_r: LowerResult = make_value(s, mir_int(), "map_len")
    s = len_r.state
    let mut len_args: List<Value> = []
    len_args.push(keys_r.value)
    s = emit_instr(s, Instruction::Call(len_r.value, "len", len_args))

    // Counter alloca
    let counter_addr: Value = new_value("%for_counter" + toString(s.tmp_counter) + ".addr", mir_int())
    s.tmp_counter = s.tmp_counter + 1
    s = emit_instr(s, Instruction::Alloca(counter_addr, mir_int()))
    let zero_r: LowerResult = make_value(s, mir_int(), "zero")
    s = zero_r.state
    s = emit_instr(s, Instruction::Const(zero_r.value, mir_int(), "0"))
    s = emit_instr(s, Instruction::Store(counter_addr, zero_r.value))

    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let header_r: LowerResult = fresh_block_label(s, "mapfor_hdr")
    s = header_r.state
    let header_label: String = header_r.value.name
    s = add_block(s, header_label)
    let header_idx: Int = s.current_block_idx

    let body_r: LowerResult = fresh_block_label(s, "mapfor_body")
    s = body_r.state
    let body_label: String = body_r.value.name
    s = add_block(s, body_label)
    let body_idx: Int = s.current_block_idx

    let exit_r: LowerResult = fresh_block_label(s, "mapfor_exit")
    s = exit_r.state
    let exit_label: String = exit_r.value.name
    s = add_block(s, exit_label)
    let exit_idx: Int = s.current_block_idx

    // Entry → header
    s = set_block(s, entry_idx)
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Header: load counter, compare < len, branch
    s = set_block(s, header_idx)
    let ci: LowerResult = make_value(s, mir_int(), "mapfor_i")
    s = ci.state
    s = emit_instr(s, Instruction::Load(ci.value, counter_addr))
    let cmp: LowerResult = make_value(s, mir_bool(), "mapfor_cmp")
    s = cmp.state
    s = emit_instr(s, Instruction::BinOp(cmp.value, BinOpKind::Lt, ci.value, len_r.value))
    s = emit_instr(s, Instruction::Branch(cmp.value, body_label, exit_label))

    // Body: get key from list, define loop variable, execute body, increment
    s = set_block(s, body_idx)
    // Load current index
    let idx_val: LowerResult = make_value(s, mir_int(), "mapfor_idx")
    s = idx_val.state
    s = emit_instr(s, Instruction::Load(idx_val.value, counter_addr))
    // Get key from keys list: keys[idx]
    let key_r: LowerResult = make_value(s, mir_string(), "mapfor_key")
    s = key_r.state
    let mut get_args: List<Value> = []
    get_args.push(keys_r.value)
    get_args.push(idx_val.value)
    s = emit_instr(s, Instruction::Call(key_r.value, "__list_get_string", get_args))
    // Define loop variable
    let var_addr: LowerResult = make_value(s, mir_string(), var_name + "_addr")
    s = var_addr.state
    s = emit_instr(s, Instruction::Alloca(var_addr.value, mir_string()))
    s = emit_instr(s, Instruction::Store(var_addr.value, key_r.value))
    s = define_var(s, var_name, var_addr.value, false)

    s = lower_push_scope(s)
    let body_result: LowerResult = lower_block(s, body)
    s = body_result.state
    s = lower_pop_scope(s)

    // Increment counter, jump to header
    if !current_block_terminated(s):
        let inc_i: LowerResult = make_value(s, mir_int(), "mapfor_ci")
        s = inc_i.state
        s = emit_instr(s, Instruction::Load(inc_i.value, counter_addr))
        let one_r: LowerResult = make_value(s, mir_int(), "mapfor_one")
        s = one_r.state
        s = emit_instr(s, Instruction::Const(one_r.value, mir_int(), "1"))
        let inc_r: LowerResult = make_value(s, mir_int(), "mapfor_inc")
        s = inc_r.state
        s = emit_instr(s, Instruction::BinOp(inc_r.value, BinOpKind::Add, inc_i.value, one_r.value))
        s = emit_instr(s, Instruction::Store(counter_addr, inc_r.value))
        s = emit_instr(s, Instruction::Jump(header_label))

    s = set_block(s, exit_idx)
    return s

fn lower_for(st: LowerState, var_name: String, iterable: Expr, body: Block) -> LowerState:
    // Lower the iterable (Range expression: start..end, or collection)
    let iter_r: LowerResult = lower_expr(st, iterable)
    let mut s: LowerState = iter_r.state

    // Map iteration: cada key en map → iterate over __mn_map_keys(map)
    if iter_r.value.ty.kind == TK_MAP():
        return lower_for_map(s, var_name, iter_r.value, body)

    // Counter-based loop: use __mn_range_start/end to extract bounds.
    // SSA-based iterator can't mutate, so we use alloca counter.
    let counter_addr: Value = new_value("%for_counter" + toString(s.tmp_counter) + ".addr", mir_int())
    s.tmp_counter = s.tmp_counter + 1
    s = emit_instr(s, Instruction::Alloca(counter_addr, mir_int()))

    // Extract start/end from range via runtime calls
    let start_r: LowerResult = make_value(s, mir_int(), "for_start")
    s = start_r.state
    let mut start_args: List<Value> = []
    start_args.push(iter_r.value)
    s = emit_instr(s, Instruction::Call(start_r.value, "__mn_range_start", start_args))
    let end_r: LowerResult = make_value(s, mir_int(), "for_end")
    s = end_r.state
    let mut end_args: List<Value> = []
    end_args.push(iter_r.value)
    s = emit_instr(s, Instruction::Call(end_r.value, "__mn_range_end", end_args))

    // Store start value to counter
    s = emit_instr(s, Instruction::Store(counter_addr, start_r.value))

    // Save current (entry) block index
    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let header_r2: LowerResult = fresh_block_label(s, "for_header")
    s = header_r2.state
    let header_label: String = header_r2.value.name
    s = add_block(s, header_label)
    let header_idx: Int = s.current_block_idx

    let body_r2: LowerResult = fresh_block_label(s, "for_body")
    s = body_r2.state
    let body_label: String = body_r2.value.name
    s = add_block(s, body_label)
    let body_idx: Int = s.current_block_idx

    let exit_r2: LowerResult = fresh_block_label(s, "for_exit")
    s = exit_r2.state
    let exit_label: String = exit_r2.value.name
    s = add_block(s, exit_label)
    let exit_idx: Int = s.current_block_idx

    // Jump from entry block to header
    s = set_block(s, entry_idx)
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Header block: load counter, compare < end, branch
    s = set_block(s, header_idx)
    let counter_val: LowerResult = make_value(s, mir_int(), "for_i")
    s = counter_val.state
    s = emit_instr(s, Instruction::Load(counter_val.value, counter_addr))
    let cmp_r: LowerResult = make_value(s, mir_bool(), "for_cmp")
    s = cmp_r.state
    s = emit_instr(s, Instruction::BinOp(cmp_r.value, BinOpKind::Lt, counter_val.value, end_r.value))
    s = emit_instr(s, Instruction::Branch(cmp_r.value, body_label, exit_label))

    // Body block: define loop variable, execute body, increment counter
    s = set_block(s, body_idx)
    let loop_addr_r: LowerResult = make_value(s, mir_int(), var_name + "_addr")
    s = loop_addr_r.state
    s = emit_instr(s, Instruction::Alloca(loop_addr_r.value, mir_int()))
    // Load current counter value for the loop variable
    let cur_i: LowerResult = make_value(s, mir_int(), "cur_i")
    s = cur_i.state
    s = emit_instr(s, Instruction::Load(cur_i.value, counter_addr))
    s = emit_instr(s, Instruction::Store(loop_addr_r.value, cur_i.value))
    s = define_var(s, var_name, loop_addr_r.value, false)

    let old_header2: String = s.loop_header_label
    let old_exit2: String = s.loop_exit_label
    s.loop_header_label = header_label
    s.loop_exit_label = exit_label
    s = lower_push_scope(s)
    let body_result: LowerResult = lower_block(s, body)
    s = body_result.state
    s = lower_pop_scope(s)
    s.loop_header_label = old_header2
    s.loop_exit_label = old_exit2

    // Increment counter and jump back to header
    if !current_block_terminated(s):
        let inc_val: LowerResult = make_value(s, mir_int(), "for_inc")
        s = inc_val.state
        let inc_i: LowerResult = make_value(s, mir_int(), "for_ci")
        s = inc_i.state
        s = emit_instr(s, Instruction::Load(inc_i.value, counter_addr))
        let one_r: LowerResult = make_value(s, mir_int(), "one")
        s = one_r.state
        s = emit_instr(s, Instruction::Const(one_r.value, mir_int(), "1"))
        s = emit_instr(s, Instruction::BinOp(inc_val.value, BinOpKind::Add, inc_i.value, one_r.value))
        s = emit_instr(s, Instruction::Store(counter_addr, inc_val.value))
        s = emit_instr(s, Instruction::Jump(header_label))

    // Exit block
    s = set_block(s, exit_idx)
    return s

// ---------------------------------------------------------------------------
// While loop
// ---------------------------------------------------------------------------

fn lower_while(st: LowerState, cond: Expr, body: Block) -> LowerState:
    let mut s: LowerState = st
    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let header_r: LowerResult = fresh_block_label(s, "while_header")
    s = header_r.state
    let header_label: String = header_r.value.name
    s = add_block(s, header_label)
    let header_idx: Int = s.current_block_idx

    let body_r: LowerResult = fresh_block_label(s, "while_body")
    s = body_r.state
    let body_label: String = body_r.value.name
    s = add_block(s, body_label)
    let body_idx: Int = s.current_block_idx

    let exit_r: LowerResult = fresh_block_label(s, "while_exit")
    s = exit_r.state
    let exit_label: String = exit_r.value.name
    s = add_block(s, exit_label)
    let exit_idx: Int = s.current_block_idx

    // Jump from entry to header
    s = set_block(s, entry_idx)
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Header: evaluate condition, branch
    s = set_block(s, header_idx)
    let cond_r: LowerResult = lower_expr(s, cond)
    s = cond_r.state
    s = emit_instr(s, Instruction::Branch(cond_r.value, body_label, exit_label))

    // Body: save loop context, lower body, jump to header
    s = set_block(s, body_idx)
    let old_header: String = s.loop_header_label
    let old_exit: String = s.loop_exit_label
    s.loop_header_label = header_label
    s.loop_exit_label = exit_label
    s = lower_push_scope(s)
    let body_result: LowerResult = lower_block(s, body)
    s = body_result.state
    s = lower_pop_scope(s)
    s.loop_header_label = old_header
    s.loop_exit_label = old_exit
    if !current_block_terminated(s):
        s = emit_instr(s, Instruction::Jump(header_label))

    // Exit
    s = set_block(s, exit_idx)
    return s

// ---------------------------------------------------------------------------
// Assert
// ---------------------------------------------------------------------------

fn lower_assert(st: LowerState, cond_expr: Expr, msg: Option<String>) -> LowerState:
    let mut s: LowerState = st
    let cond_r: LowerResult = lower_expr(s, cond_expr)
    s = cond_r.state

    let ok_r: LowerResult = fresh_block_label(s, "assert_ok")
    s = ok_r.state
    let ok_label: String = ok_r.value.name
    s = add_block(s, ok_label)
    let ok_idx: Int = s.current_block_idx

    let fail_r: LowerResult = fresh_block_label(s, "assert_fail")
    s = fail_r.state
    let fail_label: String = fail_r.value.name
    s = add_block(s, fail_label)
    let fail_idx: Int = s.current_block_idx

    // Branch on condition
    let prev_idx: Int = s.current_block_idx
    s = set_block(s, s.current_block_idx - 2)
    s = emit_instr(s, Instruction::Branch(cond_r.value, ok_label, fail_label))

    // Fail block: call __mn_assert_fail. v5.13.1 At.2: pass the
    // user-supplied message (assert COND, "msg") through to the
    // runtime so `mnc test` failure output surfaces something more
    // useful than a bare "assertion failed". Pre-v5.13.1 this was
    // hardcoded to the literal string "assertion failed", which the
    // C side then prefixed with another "assertion failed" — the
    // user message was parsed and dropped.
    s = set_block(s, fail_idx)
    let msg_val: LowerResult = make_value(s, mir_string(), "assert_msg")
    s = msg_val.state
    let mut msg_str: String = ""
    match msg:
        Some(m) => { msg_str = m }
        _ => {}
    s = emit_instr(s, Instruction::Const(msg_val.value, mir_string(), msg_str))
    let mut fail_args: List<Value> = []
    fail_args.push(msg_val.value)
    let fail_ret: LowerResult = make_value(s, mir_void(), "assert_ret")
    s = fail_ret.state
    s = emit_instr(s, Instruction::Call(fail_ret.value, "__mn_assert_fail", fail_args))
    s = emit_instr(s, Instruction::Jump(ok_label))

    // OK block: continue
    s = set_block(s, ok_idx)
    return s

// ---------------------------------------------------------------------------
// Signal / stream declarations
// ---------------------------------------------------------------------------

fn lower_signal_decl(st: LowerState, name: String, mutable: Bool, type_ann: Option<TypeExpr>, value: Expr) -> LowerState:
    let init_r: LowerResult = lower_expr(st, value)
    let sig_type: MIRType = lower_resolve_type_opt(type_ann)
    let dest_r: LowerResult = make_value(init_r.state, mir_signal(), "sig")
    let mut s: LowerState = emit_instr(dest_r.state, Instruction::SignalInit(dest_r.value, sig_type, init_r.value))
    s = define_var(s, name, dest_r.value, mutable)
    s

fn lower_stream_decl(st: LowerState, name: String, value: Expr) -> LowerState:
    let r: LowerResult = lower_expr(st, value)
    define_var(r.state, name, r.value, false)

// ---------------------------------------------------------------------------
// Expression lowering
// ---------------------------------------------------------------------------

fn lower_expr(st: LowerState, expr: Expr) -> LowerResult:
    let ek: String = expr_kind(expr)
    if ek == "int_lit":
        let n: Int = expr_int_val(expr)
        let r_int: LowerResult = make_value(st, mir_int(), "t")
        let s_int: LowerState = emit_instr(r_int.state, Instruction::Const(r_int.value, mir_int(), toString(n)))
        return new_lower_result(r_int.value, s_int)
    if ek == "float_lit":
        let f: Float = expr_float_val(expr)
        let r_flt: LowerResult = make_value(st, mir_float(), "t")
        let s_flt: LowerState = emit_instr(r_flt.state, Instruction::Const(r_flt.value, mir_float(), toString(f)))
        return new_lower_result(r_flt.value, s_flt)
    if ek == "bool_lit":
        let b: Bool = expr_bool_val(expr)
        let r_bool: LowerResult = make_value(st, mir_bool(), "t")
        let mut val_str: String = "false"
        if b { val_str = "true" }
        let s_bool: LowerState = emit_instr(r_bool.state, Instruction::Const(r_bool.value, mir_bool(), val_str))
        return new_lower_result(r_bool.value, s_bool)
    if ek == "string_lit":
        let text: String = expr_string_val(expr)
        let r_str: LowerResult = make_value(st, mir_string(), "t")
        let s_str: LowerState = emit_instr(r_str.state, Instruction::Const(r_str.value, mir_string(), text))
        return new_lower_result(r_str.value, s_str)
    if ek == "char_lit":
        let ch: String = expr_char_val(expr)
        let r_chr: LowerResult = make_value(st, mir_string(), "t")
        let s_chr: LowerState = emit_instr(r_chr.state, Instruction::Const(r_chr.value, mir_string(), ch))
        return new_lower_result(r_chr.value, s_chr)
    if ek == "none_lit":
        let r_none: LowerResult = make_value(st, mir_option(), "t")
        let s_none: LowerState = emit_instr(r_none.state, Instruction::WrapNone(r_none.value, mir_option()))
        return new_lower_result(r_none.value, s_none)
    if ek == "ident":
        return lower_identifier(st, expr_ident_name(expr))
    if ek == "binary":
        return lower_binary(st, expr_binary_left(expr), expr_binary_op(expr), expr_binary_right(expr))
    if ek == "chained_cmp":
        return lower_chained_cmp(st, expr_chained_operands(expr), expr_chained_ops(expr))
    if ek == "unary":
        return lower_unary(st, expr_unary_op(expr), expr_unary_operand(expr))
    if ek == "call":
        return lower_call(st, expr_call_callee(expr), expr_call_args(expr))
    if ek == "method_call":
        return lower_method_call(st, expr_method_obj(expr), expr_method_name(expr), expr_method_args(expr))
    if ek == "field_access":
        return lower_field_access(st, expr_field_obj(expr), expr_field_name(expr))
    if ek == "namespace_access":
        return lower_namespace_access(st, expr_ns_name(expr), expr_ns_member(expr))
    if ek == "index":
        return lower_index(st, expr_index_obj(expr), expr_index_idx(expr))
    if ek == "tensor_index":
        return lower_tensor_index_get(st, expr_ti_obj(expr), expr_ti_indices(expr))
    if ek == "tensor_slice":
        return lower_tensor_slice(st, expr_slice_obj(expr), expr_slice_items(expr))
    if ek == "pipe":
        return lower_pipe(st, expr_pipe_left(expr), expr_pipe_right(expr))
    if ek == "range":
        return lower_range(st, expr_range_start(expr), expr_range_end(expr), expr_range_inclusive(expr))
    if ek == "lambda":
        return lower_lambda(st, expr_lambda_params(expr), expr_lambda_body(expr))
    if ek == "spawn":
        return lower_spawn(st, expr_spawn_callee(expr), expr_spawn_args(expr))
    if ek == "sync":
        return lower_sync(st, expr_sync_inner(expr))
    if ek == "await":
        // v5.5.1 Sh.4 Phase 2: emit AwaitSuspend MIR so the v5.5.2
        // emitter can wrap this in coro.save + coro.suspend + switch.
        // The inner expression evaluates to a Future<T>; dest receives T.
        let inner_r: LowerResult = lower_expr(st, expr_await_inner(expr))
        let dr_aw: LowerResult = make_value(inner_r.state, mir_unknown(), "t")
        let s_aw: LowerState = emit_instr(dr_aw.state, Instruction::AwaitSuspend(dr_aw.value, inner_r.value))
        return new_lower_result(dr_aw.value, s_aw)
    if ek == "send":
        return lower_send(st, expr_send_target(expr), expr_send_value(expr))
    if ek == "error_prop":
        return lower_error_prop(st, expr_errorprop_inner(expr))
    if ek == "list_lit":
        return lower_list(st, expr_list_elements(expr))
    // v5.16.0 Te.4.D — string interpolation. Mirrors
    // mapanare/lower.py::_lower_interp_string. Each non-StringLit part
    // is wrapped in a Cast-to-String (the emitter routes Cast(X→String)
    // to `__mn_str_from_int` / `_float` / `_bool` and emits a tracker
    // for the fresh allocation; Cast(String→String) is an alias).
    // The full chain becomes a single `InterpConcat` MIR instruction.
    if ek == "interp_string":
        return lower_interp_string(st, expr_interp_parts(expr))
    if ek == "tensor_lit":
        return lower_tensor(st, expr_tensor_elements(expr), expr_tensor_shape(expr))
    if ek == "map_lit":
        return lower_map(st, expr_map_entries(expr))
    if ek == "construct":
        return lower_construct(st, expr_construct_name(expr), expr_construct_fields(expr))
    // v5.20.1 Te.5.F.C — struct update: `new T { x: 5, ..base }`.
    if ek == "construct_update":
        return lower_struct_update(st, expr_construct_update_name(expr), expr_construct_update_overrides(expr), expr_construct_update_base(expr))
    // v5.20.1 Te.5.F.E — if-let.
    if ek == "if_let":
        return lower_if_let(st, expr_iflet_pattern(expr), expr_iflet_scrutinee(expr), expr_iflet_then(expr), expr_iflet_else(expr))
    if ek == "some_wrap":
        let inner: Expr = expr_wrap_inner(expr)
        let r_some: LowerResult = lower_expr(st, inner)
        let dr_some: LowerResult = make_value(r_some.state, mir_option(), "t")
        let s_some: LowerState = emit_instr(dr_some.state, Instruction::WrapSome(dr_some.value, r_some.value))
        // v5.4.4 — wrapper takes ownership of the payload.
        let s_some2: LowerState = emit_instr(s_some, Instruction::Move(r_some.value))
        return new_lower_result(dr_some.value, s_some2)
    if ek == "ok_wrap":
        let inner: Expr = expr_wrap_inner(expr)
        let r_ok: LowerResult = lower_expr(st, inner)
        let dr_ok: LowerResult = make_value(r_ok.state, mir_result(), "t")
        let s_ok: LowerState = emit_instr(dr_ok.state, Instruction::WrapOk(dr_ok.value, r_ok.value))
        // v5.4.4 — Ok wrapper owns its payload.
        let s_ok2: LowerState = emit_instr(s_ok, Instruction::Move(r_ok.value))
        return new_lower_result(dr_ok.value, s_ok2)
    if ek == "err_wrap":
        let inner: Expr = expr_wrap_inner(expr)
        let r_err: LowerResult = lower_expr(st, inner)
        let dr_err: LowerResult = make_value(r_err.state, mir_result(), "t")
        let s_err: LowerState = emit_instr(dr_err.state, Instruction::WrapErr(dr_err.value, r_err.value))
        // v5.4.4 — Err wrapper owns its payload.
        let s_err2: LowerState = emit_instr(s_err, Instruction::Move(r_err.value))
        return new_lower_result(dr_err.value, s_err2)
    if ek == "signal_val":
        return lower_signal_expr(st, expr_signal_inner(expr))
    if ek == "assign":
        return lower_assign(st, expr_assign_target(expr), expr_assign_op(expr), expr_assign_value(expr))
    if ek == "if":
        return lower_if(st, expr_if_cond(expr), expr_if_then(expr), expr_if_else(expr))
    if ek == "match":
        return lower_match(st, expr_match_subject(expr), expr_match_arms(expr))
    if ek == "comprehension":
        return lower_comprehension(st, expr)
    // Fallback
    let r_fallback: LowerResult = make_value(st, mir_unknown(), "t")
    return new_lower_result(r_fallback.value, r_fallback.state)

// ---------------------------------------------------------------------------
// Identifier lowering
// ---------------------------------------------------------------------------

fn lower_identifier(st: LowerState, name: String) -> LowerResult:
    // v4.134.0 Sh.12: bare `None` identifier. The lexer keyword
    // `KW_NONE` only matches lowercase `none`/`nada`; capital `None`
    // (used throughout self-hosted `.mn` sources) tokenizes as NAME
    // and parses as Expr::Ident("None"). Without this branch we'd
    // fall through to the "Unknown — emit placeholder" path below,
    // producing a Const(mir_unknown, "") that emit_const refuses to
    // materialise — leaving an undef SSA reference (%None<N>) that
    // breaks llvm-as. Mirror the parser KW_NONE → Expr::NoneLit
    // lowering at line 1196 so both spellings produce identical IR.
    if name == "None":
        let r_none: LowerResult = make_value(st, mir_option(), "tnone")
        let s_none: LowerState = emit_instr(r_none.state, Instruction::WrapNone(r_none.value, mir_option()))
        return new_lower_result(r_none.value, s_none)

    // Check variable scope
    let var_opt: Option<Value> = lookup_var(st, name)
    match var_opt {
        Some(addr) => {
            // var_opt now returns the alloca address. Emit a Load to get the value.
            let r_var: LowerResult = make_value(st, addr.ty, name + "_val")
            let s_var: LowerState = emit_instr(r_var.state, Instruction::Load(r_var.value, addr))
            return new_lower_result(r_var.value, s_var)
        },
        _ => {}
    }

    // Check if it's a module-level constant
    let const_key: String = "__const__" + name
    let const_opt: Option<String> = find_lambda(st, const_key)
    match const_opt {
        Some(const_val) => {
            if const_val.starts_with("int:") {
                let iv_str: String = const_val.substr(4, len(const_val) - 4)
                let r_const: LowerResult = make_value(st, mir_int(), name)
                let s_const: LowerState = emit_instr(r_const.state, Instruction::Const(r_const.value, mir_int(), iv_str))
                return new_lower_result(r_const.value, s_const)
            }
            if const_val.starts_with("string:") {
                let sv: String = const_val.substr(7, len(const_val) - 7)
                let r_const: LowerResult = make_value(st, mir_string(), name)
                let s_const: LowerState = emit_instr(r_const.state, Instruction::Const(r_const.value, mir_string(), sv))
                return new_lower_result(r_const.value, s_const)
            }
            if const_val.starts_with("bool:") {
                let bv_str: String = const_val.substr(5, len(const_val) - 5)
                let r_const: LowerResult = make_value(st, mir_bool(), name)
                let s_const: LowerState = emit_instr(r_const.state, Instruction::Const(r_const.value, mir_bool(), bv_str))
                return new_lower_result(r_const.value, s_const)
            }
        },
        _ => {}
    }

    // Check if it's a bare enum variant (no payload)
    if is_enum_variant(st, name):
        let enum_name: String = enum_name_for_variant(st, name)
        let enum_ty: MIRType = mir_enum(enum_name)
        let r_enum: LowerResult = make_value(st, enum_ty, "t")
        let empty_payload: List<Value> = []
        let s_enum: LowerState = emit_instr(r_enum.state, Instruction::EnumInit(r_enum.value, enum_ty, name, empty_payload))
        return new_lower_result(r_enum.value, s_enum)

    // Unknown — emit placeholder
    let r_unk: LowerResult = make_value(st, mir_unknown(), name)
    let s_unk: LowerState = emit_instr(r_unk.state, Instruction::Const(r_unk.value, mir_unknown(), ""))
    return new_lower_result(r_unk.value, s_unk)

// ---------------------------------------------------------------------------
// Binary expression lowering
// ---------------------------------------------------------------------------

// v5.6.2 Sh.6 Phase 3 — tensor broadcast + scalar binop dispatch.
// Mirrors mapanare/lower.py::_lower_tensor_binop. Routes tensor⊕tensor
// through __mn_tensor_{op}_broadcast_{ty}, tensor⊕scalar through
// _scalar_{ty}, and non-commutative scalar⊕tensor through
// _r{op}_scalar_{ty} (rsub / rdiv twins).
fn tensor_op_suffix(op: String) -> String:
    if op == "+" { return "add" }
    if op == "-" { return "sub" }
    if op == "*" { return "mul" }
    if op == "/" { return "div" }
    return "add"

fn is_tensor_value(v: Value) -> Bool = v.ty.kind == TK_TENSOR()

fn lower_tensor_binop(st: LowerState, op: String, lhs: Value, rhs: Value) -> LowerResult:
    let op_suffix: String = tensor_op_suffix(op)
    let mut tensor_val: Value = lhs
    if !is_tensor_value(lhs) { tensor_val = rhs }
    let elem_kind: Int = tensor_elem_kind_of(tensor_val)
    let mut ty_suffix: String = "f64"
    if elem_kind == TK_INT() { ty_suffix = "i64" }

    let both_tensor: Bool = is_tensor_value(lhs) && is_tensor_value(rhs)
    let mut dest_r: LowerResult = make_value(st, tensor_val.ty, "tbop")
    let mut args: List<Value> = []

    if both_tensor:
        let fn_name: String = "__mn_tensor_" + op_suffix + "_broadcast_" + ty_suffix
        args.push(lhs)
        args.push(rhs)
        let s1: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
        return new_lower_result(dest_r.value, s1)

    if is_tensor_value(lhs):
        // tensor op scalar
        let fn_name_ts: String = "__mn_tensor_" + op_suffix + "_scalar_" + ty_suffix
        args.push(lhs)
        args.push(rhs)
        let s2: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name_ts, args))
        return new_lower_result(dest_r.value, s2)

    // scalar op tensor
    if op == "+" || op == "*":
        // Commutative — forward scalar fn with args swapped
        let fn_name_cs: String = "__mn_tensor_" + op_suffix + "_scalar_" + ty_suffix
        args.push(rhs)
        args.push(lhs)
        let s3: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name_cs, args))
        return new_lower_result(dest_r.value, s3)
    // Non-commutative — reverse scalar fn (rsub / rdiv). Call takes
    // (scalar, tensor) per the Python recipe (emit_llvm_text.py:3781).
    let fn_name_rs: String = "__mn_tensor_r" + op_suffix + "_scalar_" + ty_suffix
    args.push(lhs)
    args.push(rhs)
    let s4: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name_rs, args))
    return new_lower_result(dest_r.value, s4)

fn lower_binary(st: LowerState, left: Expr, op: String, right: Expr) -> LowerResult:
    // Handle pipe operator
    if op == "|>":
        return lower_pipe(st, left, right)

    let lhs_r: LowerResult = lower_expr(st, left)
    let rhs_r: LowerResult = lower_expr(lhs_r.state, right)

    // Type coercion: if one operand is unknown and the other is typed,
    // propagate the known type to the unknown operand.
    let mut lhs_val: Value = lhs_r.value
    let mut rhs_val: Value = rhs_r.value
    if lhs_val.ty.kind == TK_UNKNOWN() && rhs_val.ty.kind != TK_UNKNOWN():
        lhs_val = new_value(lhs_val.name, rhs_val.ty)
    if rhs_val.ty.kind == TK_UNKNOWN() && lhs_val.ty.kind != TK_UNKNOWN():
        rhs_val = new_value(rhs_val.name, lhs_val.ty)

    // v5.6.2 Sh.6 Phase 3 — tensor binop dispatch before generic numeric arm.
    if is_tensor_value(lhs_val) || is_tensor_value(rhs_val):
        if op == "+" || op == "-" || op == "*" || op == "/":
            return lower_tensor_binop(rhs_r.state, op, lhs_val, rhs_val)

    let binop_opt: Option<BinOpKind> = binop_from_str(op)
    match binop_opt {
        Some(binop) => {
            // Use string comparison on the operator (not enum match on BinOpKind)
            // because enum match falls through in the compiled binary
            let is_cmp: Bool = op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "and" || op == "or"
            let mut result_ty: MIRType = lhs_val.ty
            if is_cmp { result_ty = mir_bool() }
            let dr_binop: LowerResult = make_value(rhs_r.state, result_ty, "t")
            let s_binop: LowerState = emit_instr(dr_binop.state, Instruction::BinOp(dr_binop.value, binop, lhs_val, rhs_val))
            return new_lower_result(dr_binop.value, s_binop)
        },
        _ => {
            // Unknown operator — emit as call
            let dr_opcall: LowerResult = make_value(rhs_r.state, mir_unknown(), "t")
            let mut args: List<Value> = []
            args.push(lhs_r.value)
            args.push(rhs_r.value)
            let s_opcall: LowerState = emit_instr(dr_opcall.state, Instruction::Call(dr_opcall.value, "__op_" + op, args))
            return new_lower_result(dr_opcall.value, s_opcall)
        }
    }

// ---------------------------------------------------------------------------
// v5.21.0 Te.6 — chained comparison lowering
// ---------------------------------------------------------------------------

// D4 triviality predicate: trivial = side-effect-free, single-evaluation
// read. Trivial operands skip the temp; everything else gets a temp so
// each operand evaluates exactly once (D3).
fn is_trivial_chain_operand(e: Expr) -> Bool:
    let k: String = expr_kind(e)
    if k == "ident" { return true }
    if k == "int_lit" { return true }
    if k == "float_lit" { return true }
    if k == "bool_lit" { return true }
    if k == "string_lit" { return true }
    if k == "char_lit" { return true }
    if k == "none_lit" { return true }
    return false

// Desugar `a op1 b op2 c op3 d` to
// `(a op1 b) && (b op2 c) && (c op3 d)`. Interior non-trivial operands
// are bound to a synthesized `__mn_chain_N` local before the chain so
// each operand evaluates exactly once. Mirror of
// `mapanare/lower.py::_lower_chained_compare`.
fn lower_chained_cmp(st: LowerState, operands: List<Expr>, ops: List<String>) -> LowerResult:
    let mut s: LowerState = st
    let n: Int = len(operands)
    // Replace non-trivial interior operands with bound temps.
    let mut chain_operands: List<Expr> = []
    let mut i: Int = 0
    for _ in 0..n:
        if i < n:
            chain_operands.push(operands[i])
            i = i + 1
    let mut j: Int = 1
    for _ in 0..n:
        if j < n - 1:
            let sub: Expr = chain_operands[j]
            if !is_trivial_chain_operand(sub):
                let tmp_idx: Int = s.chain_compare_counter
                s.chain_compare_counter = tmp_idx + 1
                let tmp_name: String = "__mn_chain_" + toString(tmp_idx)
                let synth_let: Stmt = Stmt::Let(tmp_name, false, none, sub)
                let let_r: LowerResult = lower_stmt(s, synth_let)
                s = let_r.state
                chain_operands[j] = Expr::Ident(tmp_name)
            j = j + 1
    // Build pairwise BinaryExprs joined by `&&`.
    let nops: Int = len(ops)
    let mut result: Expr = Expr::Binary(chain_operands[0], ops[0], chain_operands[1])
    let mut k: Int = 1
    for _ in 0..nops:
        if k < nops:
            let next_pair: Expr = Expr::Binary(chain_operands[k], ops[k], chain_operands[k + 1])
            result = Expr::Binary(result, "&&", next_pair)
            k = k + 1
    return lower_expr(s, result)

// ---------------------------------------------------------------------------
// Unary expression lowering
// ---------------------------------------------------------------------------

fn resolve_unary_result_type(uop: UnaryOpKind, operand_ty: MIRType) -> MIRType:
    if unaryop_kind_to_str(uop) == "not" { return mir_bool() }
    return operand_ty

fn lower_unary(st: LowerState, op: String, operand: Expr) -> LowerResult:
    let op_r: LowerResult = lower_expr(st, operand)
    let uop_opt: Option<UnaryOpKind> = unaryop_from_str(op)
    match uop_opt {
        Some(uop) => {
            let result_ty: MIRType = resolve_unary_result_type(uop, op_r.value.ty)
            let dr_uop: LowerResult = make_value(op_r.state, result_ty, "t")
            let s_uop: LowerState = emit_instr(dr_uop.state, Instruction::UnaryOp(dr_uop.value, uop, op_r.value))
            return new_lower_result(dr_uop.value, s_uop)
        },
        _ => {
            let dr_ucall: LowerResult = make_value(op_r.state, mir_unknown(), "t")
            let mut args: List<Value> = []
            args.push(op_r.value)
            let s_ucall: LowerState = emit_instr(dr_ucall.state, Instruction::Call(dr_ucall.value, "__unary_" + op, args))
            return new_lower_result(dr_ucall.value, s_ucall)
        }
    }

// ---------------------------------------------------------------------------
// Call lowering
// ---------------------------------------------------------------------------

fn lower_call(st: LowerState, callee: Expr, arg_exprs: List<Expr>) -> LowerResult:
    // Lower all arguments first (guard pattern for clarity)
    let mut s: LowerState = st
    let mut args: List<Value> = []
    let mut i: Int = 0
    let nae: Int = len(arg_exprs)
    for _ in 0..500:
        if i < nae:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            args.push(arg_r.value)
            i = i + 1

    // Dispatch on callee type
    let ck: String = expr_kind(callee)
    if ck == "ident":
        return lower_call_by_name(s, expr_ident_name(callee), args)
    if ck == "field_access":
        // obj.method(args) that parsed as Call(FieldAccess, args)
        let method: String = expr_field_name(callee)
        let obj_r: LowerResult = lower_expr(s, expr_field_obj(callee))
        let dr_meth: LowerResult = make_value(obj_r.state, mir_unknown(), "t")
        let mut all_args: List<Value> = []
        all_args.push(obj_r.value)
        for j in 0..len(args):
            all_args.push(args[j])
        let ns_meth: LowerState = emit_instr(dr_meth.state, Instruction::Call(dr_meth.value, method, all_args))
        return new_lower_result(dr_meth.value, ns_meth)
    if ck == "namespace_access":
        let ns: String = expr_ns_name(callee)
        let member: String = expr_ns_member(callee)
        // Check if this is an enum variant constructor: Enum::Variant(...)
        // Directly check if the namespace enum has this variant (avoids
        // returning the wrong enum when variants share names like Return).
        if is_variant_of_enum(s, ns, member):
            let enum_ty: MIRType = mir_enum(ns)
            let dr_evar: LowerResult = make_value(s, enum_ty, "t")
            let ns_evar: LowerState = emit_instr(dr_evar.state, Instruction::EnumInit(dr_evar.value, enum_ty, member, args))
            // v5.4.4 — enum variant owns its payload values.
            let ns_evar2: LowerState = emit_move_vals(ns_evar, args)
            return new_lower_result(dr_evar.value, ns_evar2)
        // For struct statics like Program::start(defs), try bare function
        // name first (the function is `start`, not `Program_start`).
        return lower_call_by_name(s, member, args)
    // Dynamic call (lambda, etc.)
    let callee_r: LowerResult = lower_expr(s, callee)
    let dr_dyn: LowerResult = make_value(callee_r.state, mir_unknown(), "t")
    let ns_dyn: LowerState = emit_instr(dr_dyn.state, Instruction::Call(dr_dyn.value, callee_r.value.name, args))
    return new_lower_result(dr_dyn.value, ns_dyn)

// ---------------------------------------------------------------------------
// Generics monomorphization
// ---------------------------------------------------------------------------

fn decode_ret_type(encoded: String) -> MIRType:
    if encoded == "" { return mir_unknown() }
    let colon: Int = encoded.find(":")
    if colon < 0 { return mir_unknown() }
    let kind: String = encoded.substr(0, colon)
    let name: String = encoded.substr(colon + 1, len(encoded))
    if kind == "int" { return mir_int() }
    if kind == "float" { return mir_float() }
    if kind == "string" { return mir_string() }
    if kind == "bool" { return mir_bool() }
    if kind == "void" { return mir_void() }
    if kind == "struct" { return mir_struct(name) }
    if kind == "enum" { return mir_enum(name) }
    if kind == "option" { return mir_option() }
    if kind == "result" { return mir_result() }
    if kind == "list" { return mir_list() }
    if kind == "map" { return mir_map() }
    return mir_unknown()

fn find_generic_fn(st: LowerState, name: String) -> Option<FnDefData>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_fns):
            if st.generic_fns[i].name == name { return Some(st.generic_fns[i]) }
            i = i + 1
    return none

fn mangle_generic_name(base: String, arg_types: List<MIRType>) -> String:
    let mut result: String = base + "__"
    let mut i: Int = 0
    for _ in 0..20:
        if i < len(arg_types):
            if i > 0 { result = result + "_" }
            let tk: Int = arg_types[i].kind
            if tk == TK_INT() { result = result + "Int" }
            if tk == TK_FLOAT() { result = result + "Float" }
            if tk == TK_BOOL() { result = result + "Bool" }
            if tk == TK_STRING() { result = result + "String" }
            if tk == TK_STRUCT() { result = result + arg_types[i].name }
            if tk == TK_ENUM() { result = result + arg_types[i].name }
            if tk == TK_LIST() { result = result + "List" }
            if tk == TK_MAP() { result = result + "Map" }
            if tk == TK_OPTION() { result = result + "Option" }
            if tk == TK_RESULT() { result = result + "Result" }
            if tk == TK_VOID() { result = result + "Void" }
            if tk == TK_UNKNOWN() { result = result + "Unknown" }
            i = i + 1
    result

fn infer_type_args_from_call(gfn: FnDefData, arg_types: List<MIRType>) -> List<MIRType>:
    // Build substitution: match type_params[i] against param annotations
    let mut result: List<MIRType> = []
    let ntp: Int = len(gfn.type_params)
    let mut ti: Int = 0
    for _ in 0..20:
        if ti < ntp:
            let tp_name: String = gfn.type_params[ti]
            // Find the first parameter whose type annotation matches this type param
            let mut found: Bool = false
            let mut pi: Int = 0
            for _ in 0..50:
                if pi < len(gfn.params) && !found:
                    let p: Param = gfn.params[pi]
                    match p.type_annotation {
                        Some(ann) => {
                            if type_expr_name(ann) == tp_name {
                                if pi < len(arg_types) {
                                    result.push(arg_types[pi])
                                    found = true
                                }
                            }
                        },
                        _ => {}
                    }
                    pi = pi + 1
            if !found { result.push(mir_unknown()) }
            ti = ti + 1
    result

fn substitute_type_annotation(ann: Option<TypeExpr>, type_params: List<String>, concrete: List<MIRType>) -> Option<TypeExpr>:
    match ann {
        Some(te) => {
            let te_name: String = type_expr_name(te)
            let mut i: Int = 0
            for _ in 0..20 {
                if i < len(type_params) {
                    if type_params[i] == te_name {
                        if i < len(concrete) {
                            // Replace with concrete type name
                            let mut cname: String = concrete[i].name
                            if cname == "" { cname = kind_to_type_name(concrete[i].kind) }
                            return Some(TypeExpr::Named(cname))
                        }
                    }
                    i = i + 1
                }
            }
            return ann
        },
        _ => { return none }
    }

fn specialize_fn(gfn: FnDefData, mangled: String, type_params: List<String>, concrete: List<MIRType>) -> FnDefData:
    // Build new params with substituted type annotations
    let mut new_params: List<Param> = []
    let mut pi: Int = 0
    for _ in 0..50:
        if pi < len(gfn.params):
            let p: Param = gfn.params[pi]
            let new_ann: Option<TypeExpr> = substitute_type_annotation(p.type_annotation, type_params, concrete)
            let np: Param = new Param { span: p.span, name: p.name, type_annotation: new_ann }
            new_params.push(np)
            pi = pi + 1
    // Substitute return type
    let new_ret: Option<TypeExpr> = substitute_type_annotation(gfn.return_type, type_params, concrete)
    let empty_tp: List<String> = []
    return new_fn_def_data(gfn.span, mangled, gfn.public, empty_tp, new_params, new_ret, gfn.body, gfn.decorators)

fn is_already_specialized(st: LowerState, mangled: String) -> Bool:
    // Check if __ret__mangled exists in lambda_vars
    let key: String = "__ret__" + mangled
    match find_lambda(st, key):
        Some(_) => { return true }
        _ => { return false }

fn try_monomorphize_call(st: LowerState, fn_name: String, args: List<Value>) -> LowerResult:
    let gfn_opt: Option<FnDefData> = find_generic_fn(st, fn_name)
    match gfn_opt {
        Some(gfn) => {
            // Infer concrete types from argument types
            let mut arg_types: List<MIRType> = []
            let mut ai: Int = 0
            for _ in 0..50 {
                if ai < len(args) {
                    arg_types.push(args[ai].ty)
                    ai = ai + 1
                }
            }
            let concrete: List<MIRType> = infer_type_args_from_call(gfn, arg_types)
            let mangled: String = mangle_generic_name(fn_name, concrete)

            let mut s: LowerState = st
            if !is_already_specialized(s, mangled) {
                // Specialize and lower the function
                let specialized: FnDefData = specialize_fn(gfn, mangled, gfn.type_params, concrete)
                s = lower_fn(s, specialized, "")
            }

            // Look up return type and emit call
            let ret_key: String = "__ret__" + mangled
            let ret_ty: MIRType = decode_ret_type(unwrap_or_default(find_lambda(s, ret_key), ""))

            let dr: LowerResult = make_value(s, ret_ty, "t")
            let s2: LowerState = emit_instr(dr.state, Instruction::Call(dr.value, mangled, args))
            return new_lower_result(dr.value, s2)
        },
        _ => {
            // Not a generic function — return sentinel
            return new_lower_result(void_value(), st)
        }
    }

fn find_type_param_index(type_params: List<String>, name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..20:
        if i < len(type_params):
            if type_params[i] == name { return i }
            i = i + 1
    return 0 - 1

fn substitute_field_type(st: LowerState, ann: Option<TypeExpr>, type_params: List<String>, concrete: List<MIRType>) -> MIRType:
    let fty: MIRType = lower_resolve_type_opt_checked(st, ann)
    match ann {
        Some(a) => {
            let idx: Int = find_type_param_index(type_params, type_expr_name(a))
            if idx >= 0 {
                if idx < len(concrete) { return concrete[idx] }
            }
            return fty
        },
        _ => { return fty }
    }

fn find_generic_struct(st: LowerState, name: String) -> Option<StructDefData>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_structs):
            if st.generic_structs[i].name == name { return Some(st.generic_structs[i]) }
            i = i + 1
    return none

fn infer_struct_type_args(gs: StructDefData, args: List<Value>) -> List<MIRType>:
    let mut concrete: List<MIRType> = []
    let mut ti: Int = 0
    for _ in 0..20:
        if ti < len(gs.type_params):
            let tp_name: String = gs.type_params[ti]
            let idx: Int = find_struct_field_for_tp(gs, tp_name)
            if idx >= 0:
                if idx < len(args) { concrete.push(args[idx].ty) }
            if idx < 0 { concrete.push(mir_unknown()) }
            ti = ti + 1
    concrete

fn find_struct_field_for_tp(gs: StructDefData, tp_name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..50:
        if i < len(gs.fields):
            if type_expr_name(gs.fields[i].type_annotation) == tp_name { return i }
            i = i + 1
    return 0 - 1

fn try_monomorphize_struct(st: LowerState, struct_name: String, args: List<Value>) -> LowerResult:
    let gs_opt: Option<StructDefData> = find_generic_struct(st, struct_name)
    match gs_opt {
        Some(gs) => {
            let concrete: List<MIRType> = infer_struct_type_args(gs, args)
            let mangled: String = mangle_generic_name(struct_name, concrete)

            let mut s: LowerState = st
            if !is_struct_name(s, mangled) {
                let mut fields: List<FieldPair> = []
                let mut field_names: List<String> = []
                let mut field_types: List<MIRType> = []
                let mut fi: Int = 0
                for _ in 0..500 {
                    if fi < len(gs.fields) {
                        let sf: StructField = gs.fields[fi]
                        let fty: MIRType = substitute_field_type(s, Some(sf.type_annotation), gs.type_params, concrete)
                        fields.push(new_field_pair(sf.name, new_value("", fty)))
                        field_names.push(sf.name)
                        field_types.push(fty)
                        fi = fi + 1
                    }
                }
                let info: StructInfo = new_struct_info(mangled, fields)
                s.module = module_push_struct(s.module, info)
                let sfi: StructFieldInfo = new_struct_field_info(mangled, field_names, field_types)
                let mut sf_lst: List<StructFieldInfo> = s.struct_fields
                sf_lst.push(sfi)
                s.struct_fields = sf_lst
                // Cb.7 (v4.144.0): clear moved-ownership locals.
                fields = []
                field_names = []
                field_types = []

                // Monomorphize generic impl methods for this struct
                s = monomorphize_impl_methods(s, struct_name, mangled, gs.type_params, concrete)
            }
            let fnames: List<String> = get_struct_field_names(s, mangled)
            let mut init_pairs: List<FieldPair> = []
            let mut pi: Int = 0
            for _ in 0..500 {
                if pi < len(fnames) {
                    if pi < len(args) { init_pairs.push(new_field_pair(fnames[pi], args[pi])) }
                    pi = pi + 1
                }
            }
            let struct_ty: MIRType = mir_struct(mangled)
            let dr: LowerResult = make_value(s, struct_ty, "t")
            let s2: LowerState = emit_instr(dr.state, Instruction::StructInit(dr.value, struct_ty, init_pairs))
            // v5.4.4 — StructInit takes ownership of each field value.
            let s3: LowerState = emit_move_fields(s2, init_pairs)
            return new_lower_result(dr.value, s3)
        },
        _ => { return new_lower_result(void_value(), st) }
    }

fn monomorphize_impl_methods(st: LowerState, base_name: String, mangled: String, type_params: List<String>, concrete: List<MIRType>) -> LowerState:
    // Find generic impl methods stored as "Base_method" in generic_fns
    let prefix: String = base_name + "_"
    let prefix_len: Int = len(prefix)
    let mut s: LowerState = st
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(s.generic_fns) { return s }
        let gfn: FnDefData = s.generic_fns[i]
        if starts_with(gfn.name, prefix):
            // This is a generic impl method — specialize it
            let method_name: String = substr(gfn.name, prefix_len, len(gfn.name) - prefix_len)
            let mir_name: String = mangled + "_" + method_name
            // Register impl method for dispatch
            let impl_key: String = mangled + "." + method_name
            let entry: ImplEntry = new_impl_entry(impl_key, mir_name)
            let mut im_list: List<ImplEntry> = s.impl_methods
            im_list.push(entry)
            s.impl_methods = im_list
            // Specialize the method
            let specialized: FnDefData = specialize_fn(gfn, mir_name, type_params, concrete)
            // Fix self param type to the monomorphized struct
            let fixed: FnDefData = fix_self_param_type(specialized, mangled)
            // Register return type
            let ret_ty: MIRType = resolve_return_type_checked(s, fixed.return_type)
            let ret_key: String = "__ret__" + mir_name
            let ret_val: String = tk_name(ret_ty.kind) + ":" + ret_ty.name
            let ret_entry: LambdaEntry = new_lambda_entry(ret_key, ret_val)
            let mut lv_list: List<LambdaEntry> = s.lambda_vars
            lv_list.push(ret_entry)
            s.lambda_vars = lv_list
            // Lower the specialized method (name is already set by specialize_fn)
            s = lower_fn(s, fixed, "")
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// Generic enum monomorphization
// ---------------------------------------------------------------------------

fn find_generic_enum(st: LowerState, name: String) -> Option<EnumDefData>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_enums):
            if st.generic_enums[i].name == name { return Some(st.generic_enums[i]) }
            i = i + 1
    return none

fn is_generic_enum_variant(st: LowerState, variant_name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_enums):
            let ge: EnumDefData = st.generic_enums[i]
            let mut j: Int = 0
            for _ in 0..100:
                if j < len(ge.variants):
                    if ge.variants[j].name == variant_name { return true }
                    j = j + 1
            i = i + 1
    return false

fn generic_enum_name_for_variant(st: LowerState, variant_name: String) -> String:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.generic_enums):
            let ge: EnumDefData = st.generic_enums[i]
            let mut j: Int = 0
            for _ in 0..100:
                if j < len(ge.variants):
                    if ge.variants[j].name == variant_name { return ge.name }
                    j = j + 1
            i = i + 1
    return ""

fn find_variant_in_enum(ge: EnumDefData, variant_name: String) -> Option<EnumVariant>:
    let mut i: Int = 0
    for _ in 0..100:
        if i < len(ge.variants):
            if ge.variants[i].name == variant_name { return Some(ge.variants[i]) }
            i = i + 1
    return none

fn infer_enum_type_args(ge: EnumDefData, variant: EnumVariant, args: List<Value>) -> List<MIRType>:
    // Match variant field type annotations against concrete arg types
    let mut concrete: List<MIRType> = []
    let mut ti: Int = 0
    for _ in 0..20:
        if ti < len(ge.type_params):
            let tp_name: String = ge.type_params[ti]
            // Find which variant field uses this type param
            let mut found: Bool = false
            let mut fi: Int = 0
            for _ in 0..100:
                if fi < len(variant.fields):
                    if type_expr_name(variant.fields[fi]) == tp_name:
                        if fi < len(args):
                            concrete.push(args[fi].ty)
                            found = true
                    fi = fi + 1
            if !found { concrete.push(mir_unknown()) }
            ti = ti + 1
    concrete

fn try_monomorphize_enum(st: LowerState, variant_name: String, args: List<Value>) -> LowerResult:
    let enum_name: String = generic_enum_name_for_variant(st, variant_name)
    if len(enum_name) == 0 { return new_lower_result(void_value(), st) }

    let ge_opt: Option<EnumDefData> = find_generic_enum(st, enum_name)
    match ge_opt {
        Some(ge) => {
            let v_opt: Option<EnumVariant> = find_variant_in_enum(ge, variant_name)
            match v_opt {
                Some(variant) => {
                    let concrete: List<MIRType> = infer_enum_type_args(ge, variant, args)
                    let mangled: String = mangle_generic_name(enum_name, concrete)

                    let mut s: LowerState = st
                    if !is_enum_name(s, mangled) {
                        // Monomorphize: create EnumInfo with substituted variant types
                        let mut new_variants: List<EnumVariantInfo> = []
                        let mut new_variant_names: List<String> = []
                        let mut vi: Int = 0
                        for _ in 0..500 {
                            if vi < len(ge.variants) {
                                let orig_v: EnumVariant = ge.variants[vi]
                                let mut payload_types: List<MIRType> = []
                                let mut fi: Int = 0
                                for _ in 0..100 {
                                    if fi < len(orig_v.fields) {
                                        let fty: MIRType = substitute_field_type(s, Some(orig_v.fields[fi]), ge.type_params, concrete)
                                        payload_types.push(fty)
                                        fi = fi + 1
                                    }
                                }
                                let vi_info: EnumVariantInfo = new_enum_variant_info(orig_v.name, payload_types)
                                new_variants.push(vi_info)
                                new_variant_names.push(orig_v.name)
                                vi = vi + 1
                            }
                        }
                        let info: EnumInfo = new_enum_info(mangled, new_variants)
                        s.module = module_push_enum(s.module, info)
                        let evn: EnumVariantNames = new_enum_variant_names(mangled, new_variant_names)
                        let mut ev_lst: List<EnumVariantNames> = s.enum_variants
                        ev_lst.push(evn)
                        s.enum_variants = ev_lst
                        // Ownership of the specialized enum metadata has moved
                        // into the returned state. Clear the local list headers
                        // so the function epilogue does not free the same
                        // buffers while the emitter still needs them.
                        new_variants = []
                        new_variant_names = []
                    }

                    // Emit EnumInit with mangled type name
                    let enum_ty: MIRType = mir_enum(mangled)
                    let dr_enum: LowerResult = make_value(s, enum_ty, "t")
                    let s2: LowerState = emit_instr(dr_enum.state, Instruction::EnumInit(dr_enum.value, enum_ty, variant_name, args))
                    // v5.4.4 — enum variant takes ownership of each arg.
                    let s3: LowerState = emit_move_vals(s2, args)
                    return new_lower_result(dr_enum.value, s3)
                },
                _ => { return new_lower_result(void_value(), st) }
            }
        },
        _ => { return new_lower_result(void_value(), st) }
    }

fn lower_call_by_name(st: LowerState, fn_name: String, args: List<Value>) -> LowerResult:
    // v5.5.1 Sh.4 Phase 2: block_on(future) — drive a coroutine to
    // completion from non-async context (e.g. main). Emit BlockOn MIR
    // so the v5.5.2 emitter can lower to scheduler_register +
    // scheduler_run + coro.destroy + value extraction.  Checked before
    // monomorphization: block_on is a builtin, not a user-defined fn.
    if fn_name == "block_on":
        if len(args) == 1:
            let dr_bo: LowerResult = make_value(st, mir_unknown(), "t")
            let s_bo: LowerState = emit_instr(dr_bo.state, Instruction::BlockOn(dr_bo.value, args[0]))
            return new_lower_result(dr_bo.value, s_bo)

    // Monomorphize generic function calls
    let mono_r: LowerResult = try_monomorphize_call(st, fn_name, args)
    if mono_r.value.name != "%void" { return mono_r }

    // Builtin void functions
    if fn_name == "print":
        let dr_print: LowerResult = make_value(st, mir_void(), "t")
        let s_print: LowerState = emit_instr(dr_print.state, Instruction::Call(dr_print.value, fn_name, args))
        return new_lower_result(dr_print.value, s_print)
    if fn_name == "println":
        let dr_pln: LowerResult = make_value(st, mir_void(), "t")
        let s_pln: LowerState = emit_instr(dr_pln.state, Instruction::Call(dr_pln.value, fn_name, args))
        return new_lower_result(dr_pln.value, s_pln)
    // Builtin conversion functions — set correct MIR return types
    if fn_name == "int":
        let dr_int: LowerResult = make_value(st, mir_int(), "t")
        let s_int: LowerState = emit_instr(dr_int.state, Instruction::Call(dr_int.value, fn_name, args))
        return new_lower_result(dr_int.value, s_int)
    if fn_name == "float":
        let dr_flt: LowerResult = make_value(st, mir_float(), "t")
        let s_flt: LowerState = emit_instr(dr_flt.state, Instruction::Call(dr_flt.value, fn_name, args))
        return new_lower_result(dr_flt.value, s_flt)
    if fn_name == "str" || fn_name == "toString":
        let dr_str: LowerResult = make_value(st, mir_string(), "t")
        let s_str: LowerState = emit_instr(dr_str.state, Instruction::Call(dr_str.value, fn_name, args))
        return new_lower_result(dr_str.value, s_str)
    if fn_name == "len":
        let dr_len: LowerResult = make_value(st, mir_int(), "t")
        let s_len: LowerState = emit_instr(dr_len.state, Instruction::Call(dr_len.value, fn_name, args))
        return new_lower_result(dr_len.value, s_len)

    // Runtime: process + file I/O
    if fn_name == "__mn_argc":
        let dr_argc: LowerResult = make_value(st, mir_int(), "t")
        let s_argc: LowerState = emit_instr(dr_argc.state, Instruction::Call(dr_argc.value, fn_name, args))
        return new_lower_result(dr_argc.value, s_argc)
    if fn_name == "__mn_argv":
        let dr_argv: LowerResult = make_value(st, mir_string(), "t")
        let s_argv: LowerState = emit_instr(dr_argv.state, Instruction::Call(dr_argv.value, fn_name, args))
        return new_lower_result(dr_argv.value, s_argv)
    if fn_name == "__mn_file_read_or_empty":
        let dr_fr: LowerResult = make_value(st, mir_string(), "t")
        let s_fr: LowerState = emit_instr(dr_fr.state, Instruction::Call(dr_fr.value, fn_name, args))
        return new_lower_result(dr_fr.value, s_fr)
    if fn_name == "__mn_exit":
        let dr_exit: LowerResult = make_value(st, mir_void(), "t")
        let s_exit: LowerState = emit_instr(dr_exit.state, Instruction::Call(dr_exit.value, fn_name, args))
        return new_lower_result(dr_exit.value, s_exit)
    if fn_name == "__mn_str_eprint":
        let dr_epr: LowerResult = make_value(st, mir_void(), "t")
        let s_epr: LowerState = emit_instr(dr_epr.state, Instruction::Call(dr_epr.value, fn_name, args))
        return new_lower_result(dr_epr.value, s_epr)
    // v5.8.4 Wb.2: __mn_host_is_win64 returns Int (0 or 1).
    if fn_name == "__mn_host_is_win64":
        let dr_hw: LowerResult = make_value(st, mir_int(), "t")
        let s_hw: LowerState = emit_instr(dr_hw.state, Instruction::Call(dr_hw.value, fn_name, args))
        return new_lower_result(dr_hw.value, s_hw)
    // v5.8.6 We.1: refined (is_windows, arch_bits) pair. Both return Int.
    if fn_name == "__mn_host_is_windows":
        let dr_hwn: LowerResult = make_value(st, mir_int(), "t")
        let s_hwn: LowerState = emit_instr(dr_hwn.state, Instruction::Call(dr_hwn.value, fn_name, args))
        return new_lower_result(dr_hwn.value, s_hwn)
    if fn_name == "__mn_host_arch_bits":
        let dr_hab: LowerResult = make_value(st, mir_int(), "t")
        let s_hab: LowerState = emit_instr(dr_hab.state, Instruction::Call(dr_hab.value, fn_name, args))
        return new_lower_result(dr_hab.value, s_hab)
    // v5.9.0 DX.2 / DX.3 / DX.4: native CLI hygiene exports.
    if fn_name == "__mn_version_string":
        let dr_vs: LowerResult = make_value(st, mir_string(), "t")
        let s_vs: LowerState = emit_instr(dr_vs.state, Instruction::Call(dr_vs.value, fn_name, args))
        return new_lower_result(dr_vs.value, s_vs)
    // v5.14.1 B.5/B.6: colon-block preprocessor — see runtime/native/
    // mapanare_core.c::__mn_indent_to_braces for why this lives in C.
    if fn_name == "__mn_indent_to_braces":
        let dr_itb: LowerResult = make_value(st, mir_string(), "t")
        let s_itb: LowerState = emit_instr(dr_itb.state, Instruction::Call(dr_itb.value, fn_name, args))
        return new_lower_result(dr_itb.value, s_itb)
    if fn_name == "__mn_dev_null_redirect":
        let dr_dn: LowerResult = make_value(st, mir_string(), "t")
        let s_dn: LowerState = emit_instr(dr_dn.state, Instruction::Call(dr_dn.value, fn_name, args))
        return new_lower_result(dr_dn.value, s_dn)
    if fn_name == "__mn_clang_err_path":
        let dr_ce: LowerResult = make_value(st, mir_string(), "t")
        let s_ce: LowerState = emit_instr(dr_ce.state, Instruction::Call(dr_ce.value, fn_name, args))
        return new_lower_result(dr_ce.value, s_ce)
    if fn_name == "__mn_dir_count_files":
        let dr_dcf: LowerResult = make_value(st, mir_int(), "t")
        let s_dcf: LowerState = emit_instr(dr_dcf.state, Instruction::Call(dr_dcf.value, fn_name, args))
        return new_lower_result(dr_dcf.value, s_dcf)
    if fn_name == "__mn_dir_total_size":
        let dr_dts: LowerResult = make_value(st, mir_int(), "t")
        let s_dts: LowerState = emit_instr(dr_dts.state, Instruction::Call(dr_dts.value, fn_name, args))
        return new_lower_result(dr_dts.value, s_dts)
    if fn_name == "__mn_dir_remove_recursive":
        let dr_drr: LowerResult = make_value(st, mir_int(), "t")
        let s_drr: LowerState = emit_instr(dr_drr.state, Instruction::Call(dr_drr.value, fn_name, args))
        return new_lower_result(dr_drr.value, s_drr)
    if fn_name == "__mn_file_exists":
        let dr_fe: LowerResult = make_value(st, mir_int(), "t")
        let s_fe: LowerState = emit_instr(dr_fe.state, Instruction::Call(dr_fe.value, fn_name, args))
        return new_lower_result(dr_fe.value, s_fe)
    // v5.10.0 Win.1b.D: directory of running binary, used by find_clang().
    if fn_name == "__mn_executable_dir":
        let dr_ed: LowerResult = make_value(st, mir_string(), "t")
        let s_ed: LowerState = emit_instr(dr_ed.state, Instruction::Call(dr_ed.value, fn_name, args))
        return new_lower_result(dr_ed.value, s_ed)
    // v5.6.0 Sh.6 — tensor builtin return types. Without these the default
    // mir_unknown resolves to i64 and emit_builtin_tostring would route
    // `str(tensor_get_f64(...))` through __mn_str_from_int with a double
    // arg (type mismatch). tensor_get_f64 must travel as Float.
    if fn_name == "tensor_rank":
        let dr_tr: LowerResult = make_value(st, mir_int(), "t")
        let s_tr: LowerState = emit_instr(dr_tr.state, Instruction::Call(dr_tr.value, fn_name, args))
        return new_lower_result(dr_tr.value, s_tr)
    if fn_name == "tensor_size":
        let dr_ts: LowerResult = make_value(st, mir_int(), "t")
        let s_ts: LowerState = emit_instr(dr_ts.state, Instruction::Call(dr_ts.value, fn_name, args))
        return new_lower_result(dr_ts.value, s_ts)
    if fn_name == "tensor_get_f64":
        let dr_tgf: LowerResult = make_value(st, mir_float(), "t")
        let s_tgf: LowerState = emit_instr(dr_tgf.state, Instruction::Call(dr_tgf.value, fn_name, args))
        return new_lower_result(dr_tgf.value, s_tgf)
    if fn_name == "tensor_get_i64":
        let dr_tgi: LowerResult = make_value(st, mir_int(), "t")
        let s_tgi: LowerState = emit_instr(dr_tgi.state, Instruction::Call(dr_tgi.value, fn_name, args))
        return new_lower_result(dr_tgi.value, s_tgi)
    if fn_name == "tensor_shape_dim":
        let dr_tsd: LowerResult = make_value(st, mir_int(), "t")
        let s_tsd: LowerState = emit_instr(dr_tsd.state, Instruction::Call(dr_tsd.value, fn_name, args))
        return new_lower_result(dr_tsd.value, s_tsd)
    if fn_name == "tensor_print":
        let dr_tp: LowerResult = make_value(st, mir_void(), "t")
        let s_tp: LowerState = emit_instr(dr_tp.state, Instruction::Call(dr_tp.value, fn_name, args))
        return new_lower_result(dr_tp.value, s_tp)

    if fn_name == "chr":
        let dr_chr: LowerResult = make_value(st, mir_string(), "t")
        let s_chr: LowerState = emit_instr(dr_chr.state, Instruction::Call(dr_chr.value, "chr", args))
        return new_lower_result(dr_chr.value, s_chr)
    if fn_name == "ord":
        let dr_ord: LowerResult = make_value(st, mir_int(), "t")
        let s_ord: LowerState = emit_instr(dr_ord.state, Instruction::Call(dr_ord.value, "ord", args))
        return new_lower_result(dr_ord.value, s_ord)

    // Handle Option/Result builtins
    if fn_name == "Some":
        if len(args) == 1:
            let dr_some: LowerResult = make_value(st, mir_option(), "t")
            let s_some: LowerState = emit_instr(dr_some.state, Instruction::WrapSome(dr_some.value, args[0]))
            // v5.4.4 — Some wrapper takes ownership.
            let s_some2: LowerState = emit_instr(s_some, Instruction::Move(args[0]))
            return new_lower_result(dr_some.value, s_some2)
    if fn_name == "Ok":
        if len(args) == 1:
            // Use the function's return type (with generic args) if available
            let mut res_ty_ok: MIRType = mir_result()
            match st.current_fn {
                Some(cf) => {
                    if cf.return_type.kind == TK_RESULT() {
                        res_ty_ok = cf.return_type
                    }
                },
                _ => {}
            }
            let dr_ok: LowerResult = make_value(st, res_ty_ok, "t")
            let s_ok: LowerState = emit_instr(dr_ok.state, Instruction::WrapOk(dr_ok.value, args[0]))
            // v5.4.4 — Ok wrapper takes ownership.
            let s_ok2: LowerState = emit_instr(s_ok, Instruction::Move(args[0]))
            return new_lower_result(dr_ok.value, s_ok2)
    if fn_name == "Err":
        if len(args) == 1:
            let mut res_ty_err: MIRType = mir_result()
            match st.current_fn {
                Some(cf) => {
                    if cf.return_type.kind == TK_RESULT() {
                        res_ty_err = cf.return_type
                    }
                },
                _ => {}
            }
            let dr_err: LowerResult = make_value(st, res_ty_err, "t")
            let s_err: LowerState = emit_instr(dr_err.state, Instruction::WrapErr(dr_err.value, args[0]))
            // v5.4.4 — Err wrapper takes ownership.
            let s_err2: LowerState = emit_instr(s_err, Instruction::Move(args[0]))
            return new_lower_result(dr_err.value, s_err2)

    // Handle __new_StructName calls (from `new StructName { ... }` syntax)
    if fn_name.starts_with("__new_"):
        let struct_name: String = fn_name.substr(6, len(fn_name) - 6)
        // Check for generic struct — specialize on demand
        let mono_struct_r: LowerResult = try_monomorphize_struct(st, struct_name, args)
        if mono_struct_r.value.name != "%void" { return mono_struct_r }
        if is_struct_name(st, struct_name):
            let field_names: List<String> = get_struct_field_names(st, struct_name)
            let struct_ty: MIRType = mir_struct(struct_name)
            let mut field_pairs: List<FieldPair> = []
            let mut fi: Int = 0
            let nfn: Int = len(field_names)
            let na: Int = len(args)
            for _ in 0..500:
                if fi < nfn:
                    if fi < na:
                        let fp: FieldPair = new_field_pair(field_names[fi], args[fi])
                        field_pairs.push(fp)
                        fi = fi + 1
            let dr_new: LowerResult = make_value(st, struct_ty, "t")
            let s_new: LowerState = emit_instr(dr_new.state, Instruction::StructInit(dr_new.value, struct_ty, field_pairs))
            // v5.4.4 — StructInit takes ownership of each field value.
            let s_new2: LowerState = emit_move_fields(s_new, field_pairs)
            return new_lower_result(dr_new.value, s_new2)

    // Check if it's a generic enum variant constructor (monomorphize on demand)
    if is_generic_enum_variant(st, fn_name):
        let ge_r: LowerResult = try_monomorphize_enum(st, fn_name, args)
        if ge_r.value.name != "%void" { return ge_r }

    // Check if it's an enum variant constructor
    if is_enum_variant(st, fn_name):
        let enum_name: String = enum_name_for_variant(st, fn_name)
        let enum_ty: MIRType = mir_enum(enum_name)
        let dr_enum: LowerResult = make_value(st, enum_ty, "t")
        let s_enum: LowerState = emit_instr(dr_enum.state, Instruction::EnumInit(dr_enum.value, enum_ty, fn_name, args))
        // v5.4.4 — enum variant takes ownership of payload args.
        let s_enum2: LowerState = emit_move_vals(s_enum, args)
        return new_lower_result(dr_enum.value, s_enum2)

    // Check if it's a struct constructor (use if instead of match to avoid
    // control flow issues with return-inside-match)
    if is_struct_name(st, fn_name):
        let field_names: List<String> = get_struct_field_names(st, fn_name)
        let struct_ty: MIRType = mir_struct(fn_name)
        let mut field_pairs: List<FieldPair> = []
        let mut fi: Int = 0
        let nfn: Int = len(field_names)
        let na: Int = len(args)
        for _ in 0..500:
            if fi < nfn:
                if fi < na:
                    let fp: FieldPair = new_field_pair(field_names[fi], args[fi])
                    field_pairs.push(fp)
                    fi = fi + 1
        let dr_ctor: LowerResult = make_value(st, struct_ty, "t")
        let s_ctor: LowerState = emit_instr(dr_ctor.state, Instruction::StructInit(dr_ctor.value, struct_ty, field_pairs))
        // v5.4.4 — StructInit takes ownership of each field value.
        let s_ctor2: LowerState = emit_move_fields(s_ctor, field_pairs)
        return new_lower_result(dr_ctor.value, s_ctor2)

    // v5.7.0 Sh.7: indirect call through a fn-typed local variable.
    // Mirrors mapanare/lower.py::_lower_call (v4.103.0 docket #5). When
    // an identifier resolves to a parameter/binding annotated
    // `fn(T) -> T`, the alloca's MIR type has kind TK_FN. Load the
    // value and emit a Call whose fn_name is the loaded SSA name —
    // emit_call_ir / emit_call_void recognise the leading `%` and
    // emit `call <ret_ty> %fn(<args>)` rather than `call ... @<name>`.
    let var_lookup: Option<Value> = lookup_var(st, fn_name)
    match var_lookup {
        Some(addr_v) => {
            if addr_v.ty.kind == TK_FN() {
                let load_r: LowerResult = make_value(st, addr_v.ty, fn_name + "_val")
                let load_s: LowerState = emit_instr(load_r.state, Instruction::Load(load_r.value, addr_v))
                let dr_ind: LowerResult = make_value(load_s, mir_unknown(), "t")
                let s_ind: LowerState = emit_instr(dr_ind.state, Instruction::Call(dr_ind.value, load_r.value.name, args))
                return new_lower_result(dr_ind.value, s_ind)
            }
        },
        _ => {}
    }

    // Resolve lambda variable names to actual function names
    let resolved: String = unwrap_or_default(find_lambda(st, fn_name), fn_name)

    // For non-lambda calls, emit directly (no state copy needed).
    // Look up function return type from lambda_vars registry (__ret__fn_name).
    if resolved.find(":") < 0:
        let mut call_ret: MIRType = mir_unknown()
        let ret_key: String = "__ret__" + resolved
        let ret_opt: Option<String> = find_lambda(st, ret_key)
        match ret_opt {
            Some(ret_encoded) => {
                // Decode "kind:name" → MIRType
                let colon: Int = ret_encoded.find(":")
                if colon >= 0 {
                    let kind: String = ret_encoded.substr(0, colon)
                    // substr(start, count) — count is clamped to s.len
                    let name: String = ret_encoded.substr(colon + 1, len(ret_encoded))
                    if kind == "struct" { call_ret = mir_struct(name) }
                    if kind == "enum" { call_ret = mir_enum(name) }
                    if kind == "int" { call_ret = mir_int() }
                    if kind == "float" { call_ret = mir_float() }
                    if kind == "string" { call_ret = mir_string() }
                    if kind == "bool" { call_ret = mir_bool() }
                    if kind == "void" { call_ret = mir_void() }
                    if kind == "option" { call_ret = mir_option() }
                    if kind == "result" {
                        // Look up the FULL parameterized return type from the
                        // module's function list (preserves generic args).
                        let mut found_full: Bool = false
                        let mut fk: Int = 0
                        for _ in 0..5000 {
                            if fk < len(st.module.functions) {
                                if st.module.functions[fk].name == resolved {
                                    call_ret = st.module.functions[fk].return_type
                                    found_full = true
                                    fk = len(st.module.functions)
                                }
                                fk = fk + 1
                            }
                        }
                        if found_full == false { call_ret = mir_result() }
                    }
                    if kind == "list" { call_ret = mir_list() }
                    if kind == "map" { call_ret = mir_map() }
                }
            },
            _ => {}
        }
        let dr_call: LowerResult = make_value(st, call_ret, "t")
        let s_call: LowerState = emit_instr(dr_call.state, Instruction::Call(dr_call.value, resolved, args))
        return new_lower_result(dr_call.value, s_call)

    // Lambda call with captures — decode "lambda1:x,y" and load captured vars.
    // Chain state through make_value/emit_instr (byref, no LowerState copy).
    let actual_fn: String = resolved.substr(0, resolved.find(":"))
    let cp: Int = resolved.find(":")
    let caps_str: String = resolved.substr(cp + 1, len(resolved))
    let cap_parts: List<String> = caps_str.split(",")
    return lower_call_with_captures(st, actual_fn, args, cap_parts, 0)

fn lower_call_with_captures(st: LowerState, fn_name: String, args: List<Value>, captures: List<String>, idx: Int) -> LowerResult:
    // Base case: all captures loaded — emit the call
    if idx >= len(captures):
        let dest_r: LowerResult = make_value(st, mir_unknown(), "t")
        let s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
        return new_lower_result(dest_r.value, s)

    // Load one captured variable and recurse
    let cap_name: String = captures[idx]
    let var_opt: Option<Value> = lookup_var(st, cap_name)
    match var_opt {
        Some(addr) => {
            let lr: LowerResult = make_value(st, addr.ty, "cap")
            let ns: LowerState = emit_instr(lr.state, Instruction::Load(lr.value, addr))
            args.push(lr.value)
            return lower_call_with_captures(ns, fn_name, args, captures, idx + 1)
        },
        _ => {
            return lower_call_with_captures(st, fn_name, args, captures, idx + 1)
        }
    }

// ---------------------------------------------------------------------------
// Method call lowering
// ---------------------------------------------------------------------------

fn str_method_return_type(method: String) -> MIRType:
    if method == "char_at" { return mir_string() }
    if method == "substr" { return mir_string() }
    if method == "to_upper" { return mir_string() }
    if method == "to_lower" { return mir_string() }
    if method == "replace" { return mir_string() }
    if method == "trim" { return mir_string() }
    if method == "trim_start" { return mir_string() }
    if method == "trim_end" { return mir_string() }
    if method == "concat" { return mir_string() }
    if method == "join" { return mir_string() }
    if method == "strip" { return mir_string() }
    if method == "upper" { return mir_string() }
    if method == "lower" { return mir_string() }
    if method == "slice" { return mir_string() }
    if method == "reverse" { return mir_string() }
    if method == "repeat" { return mir_string() }
    if method == "center" { return mir_string() }
    if method == "pad_start" { return mir_string() }
    if method == "pad_end" { return mir_string() }
    if method == "byte_at" { return mir_int() }
    if method == "find" { return mir_int() }
    if method == "index" { return mir_int() }
    if method == "len" { return mir_int() }
    if method == "count" { return mir_int() }
    if method == "starts_with" { return mir_bool() }
    if method == "ends_with" { return mir_bool() }
    if method == "contains" { return mir_bool() }
    if method == "is_empty" { return mir_bool() }
    if method == "split" { return mir_list() }
    return mir_unknown()

fn list_method_return_type(method: String) -> MIRType:
    if method == "len" { return mir_int() }
    if method == "push" { return mir_void() }
    if method == "is_empty" { return mir_bool() }
    if method == "contains" { return mir_bool() }
    if method == "pop" { return mir_unknown() }
    if method == "reverse" { return mir_list() }
    if method == "sort" { return mir_list() }
    if method == "concat" { return mir_list() }
    return mir_unknown()

fn map_method_return_type(method: String) -> MIRType:
    if method == "len" { return mir_int() }
    if method == "contains_key" { return mir_bool() }
    if method == "is_empty" { return mir_bool() }
    if method == "keys" { return mir_list() }
    if method == "values" { return mir_list() }
    if method == "get" { return mir_unknown() }
    if method == "set" { return mir_void() }
    if method == "remove" { return mir_void() }
    return mir_unknown()

fn lower_method_call(st: LowerState, obj: Expr, method: String, arg_exprs: List<Expr>) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)
    let mut s: LowerState = obj_r.state

    // Special handling for push: pass the list ALLOCA address (not the loaded value)
    // so the emitter can push directly to the alloca, avoiding copy semantics.
    if method == "push":
        return lower_push_method(s, obj, obj_r, arg_exprs)

    // v5.6.3 Sh.6 Phase 4 — tensor reduction methods
    // `a.sum()/.mean()/.max()/.min()/.argmax()/.argmin()` route to the
    // `__mn_tensor_{method}_{f64,i64}` runtime family. mean always goes
    // to the f64 variant (no _i64 runtime). Mirrors
    // mapanare/lower.py::_lower_method_call:2503-2522.
    if is_tensor_reduction_method(method):
        if obj_r.value.ty.kind == TK_TENSOR():
            let elem_kind_red: Int = tensor_elem_kind_of(obj_r.value)
            let mut ty_suffix: String = "f64"
            if elem_kind_red == TK_INT() { ty_suffix = "i64" }
            if method == "mean" { ty_suffix = "f64" }
            let red_fn: String = "__mn_tensor_" + method + "_" + ty_suffix
            let red_ret_ty: MIRType = tensor_reduction_ret_ty(method, elem_kind_red)
            let red_dest: LowerResult = make_value(s, red_ret_ty, "tred")
            let mut red_args: List<Value> = []
            red_args.push(obj_r.value)
            let s_red: LowerState = emit_instr(red_dest.state, Instruction::Call(red_dest.value, red_fn, red_args))
            return new_lower_result(red_dest.value, s_red)

    // Build arg list: [obj_value, arg_values...]
    let mut all_args: List<Value> = []
    all_args.push(obj_r.value)
    let nae: Int = len(arg_exprs)
    let mut i: Int = 0
    for _ in 0..500:
        if i < nae:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            all_args.push(arg_r.value)
            i = i + 1

    let mut ret_ty: MIRType = mir_unknown()
    if obj_r.value.ty.kind == TK_STRING():
        ret_ty = str_method_return_type(method)
    if obj_r.value.ty.kind == TK_LIST():
        ret_ty = list_method_return_type(method)
    if obj_r.value.ty.kind == TK_MAP():
        ret_ty = map_method_return_type(method)

    // Resolve impl method: if obj has struct/enum type, check impl_methods
    let mut call_name: String = method
    let obj_type_name: String = obj_r.value.ty.name
    if obj_type_name != "":
        let impl_key: String = obj_type_name + "." + method
        let impl_opt: Option<String> = lookup_impl_method(s, impl_key)
        match impl_opt:
            Some(mangled) => { call_name = mangled }
            _ => {}

    let dest_r: LowerResult = make_value(s, ret_ty, "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, call_name, all_args))
    return new_lower_result(dest_r.value, new_s)

fn lookup_impl_method(st: LowerState, key: String) -> Option<String>:
    let mut i: Int = 0
    for _ in 0..500:
        if i < len(st.impl_methods):
            if st.impl_methods[i].key == key { return Some(st.impl_methods[i].mir_name) }
            i = i + 1
    return none

// v5.4.4 Own.1 Phase 2 — Move-emission helpers.
// emit_move_vals / emit_move_fields append one Move instruction per
// input value. Used after list.push, map_set, struct_init, enum_init,
// and Option/Result wrappers so the emitter's drop glue can see that
// the resource's ownership transferred into the container.
fn emit_move_vals(st: LowerState, vals: List<Value>) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(vals)
    let mut i: Int = 0
    for _ in 0..500:
        if i >= n { return s }
        s = emit_instr(s, Instruction::Move(vals[i]))
        i = i + 1
    return s

fn emit_move_fields(st: LowerState, fields: List<FieldPair>) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(fields)
    let mut i: Int = 0
    for _ in 0..500:
        if i >= n { return s }
        s = emit_instr(s, Instruction::Move(fields[i].val))
        i = i + 1
    return s

fn emit_move_kvpairs(st: LowerState, pairs: List<KVPair>) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(pairs)
    let mut i: Int = 0
    for _ in 0..500:
        if i >= n { return s }
        s = emit_instr(s, Instruction::Move(pairs[i].key))
        s = emit_instr(s, Instruction::Move(pairs[i].val))
        i = i + 1
    return s

fn lower_push_method(st: LowerState, obj: Expr, obj_r: LowerResult, arg_exprs: List<Expr>) -> LowerResult:
    let mut s: LowerState = st
    // Lower the element
    let arg_r: LowerResult = lower_expr(s, arg_exprs[0])
    s = arg_r.state
    // Find the alloca for the list.
    // For simple Ident: use lookup_var → alloca address
    // For FieldAccess: use the struct alloca + field name
    //   The emitter handles this via the @field: prefix
    let list_ref: Value = find_list_alloca(s, obj, obj_r)
    let mut all_args: List<Value> = []
    all_args.push(list_ref)
    all_args.push(arg_r.value)
    let dest_r: LowerResult = make_value(s, mir_void(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, "push", all_args))
    // v5.4.4 — list.push copies the element into the list buffer; the
    // container owns it now. Drop glue must skip the caller's slot.
    let moved_s: LowerState = emit_instr(new_s, Instruction::Move(arg_r.value))
    return new_lower_result(dest_r.value, moved_s)

fn find_list_alloca(st: LowerState, obj: Expr, obj_r: LowerResult) -> Value:
    let ok: String = expr_kind(obj)
    if ok == "ident":
        // Simple variable push: use the variable's alloca directly
        let var_opt: Option<Value> = lookup_var(st, expr_ident_name(obj))
        match var_opt:
            Some(addr) => { return addr }
            _ => { return obj_r.value }
    if ok == "field_access":
        // struct.field.push(): GEP into the struct alloca
        // to get a pointer to the list field
        return find_field_alloca(st, expr_field_obj(obj), expr_field_name(obj), obj_r)
    return obj_r.value

fn find_field_alloca(st: LowerState, inner: Expr, field_name: String, obj_r: LowerResult) -> Value:
    if expr_kind(inner) == "ident":
        let name: String = expr_ident_name(inner)
        let var_opt: Option<Value> = lookup_var(st, name)
        match var_opt {
            Some(addr) => {
                // Encode the field name in the Value's type name
                // so the emitter can find the correct field index.
                // Convention: ty.name = "StructName:field_name"
                let combined: MIRType = new_mir_type(addr.ty.name + ":" + field_name, addr.ty.kind)
                return new_value(addr.name, combined)
            },
            _ => { return obj_r.value }
        }
    return obj_r.value

// ---------------------------------------------------------------------------
// Field access lowering
// ---------------------------------------------------------------------------

fn lookup_struct_field_type(st: LowerState, struct_name: String, field_name: String) -> MIRType:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.struct_fields) { return mir_unknown() }
        let info: StructFieldInfo = st.struct_fields[i]
        if info.name == struct_name:
            let mut j: Int = 0
            for _ in 0..500:
                if j >= len(info.field_names) { return mir_unknown() }
                if info.field_names[j] == field_name:
                    if j < len(info.field_types):
                        return info.field_types[j]
                    return mir_unknown()
                j = j + 1
        i = i + 1
    return mir_unknown()

fn lower_field_access(st: LowerState, obj: Expr, field_name: String) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)

    // Only emit SignalGet for actual signal types, not for struct .value fields
    if field_name == "value" && obj_r.value.ty.kind == TK_SIGNAL():
        let dr_sig: LowerResult = make_value(obj_r.state, mir_unknown(), "t")
        let s_sig: LowerState = emit_instr(dr_sig.state, Instruction::SignalGet(dr_sig.value, obj_r.value))
        return new_lower_result(dr_sig.value, s_sig)

    // Resolve field type from struct registry
    let field_ty: MIRType = lookup_struct_field_type(obj_r.state, obj_r.value.ty.name, field_name)

    let dr_fld: LowerResult = make_value(obj_r.state, field_ty, "t")
    let s_fld: LowerState = emit_instr(dr_fld.state, Instruction::FieldGet(dr_fld.value, obj_r.value, field_name))
    return new_lower_result(dr_fld.value, s_fld)

// ---------------------------------------------------------------------------
// Namespace access lowering
// ---------------------------------------------------------------------------

fn is_enum_name(st: LowerState, name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(st.enum_variants) { return false }
        if st.enum_variants[i].enum_name == name { return true }
        i = i + 1
    return false

fn lower_namespace_access(st: LowerState, ns: String, member: String) -> LowerResult:
    // Check if namespace is a registered enum → emit EnumInit
    if is_enum_name(st, ns):
        let enum_ty: MIRType = mir_enum(ns)
        let dr_ns_enum: LowerResult = make_value(st, enum_ty, "t")
        let eargs_enum: List<Value> = []
        let s_ns_enum: LowerState = emit_instr(dr_ns_enum.state, Instruction::EnumInit(dr_ns_enum.value, enum_ty, member, eargs_enum))
        return new_lower_result(dr_ns_enum.value, s_ns_enum)
    // Otherwise: module function call
    let dr_ns_mod: LowerResult = make_value(st, mir_unknown(), "t")
    let fn_name: String = ns + "_" + member
    let eargs_mod: List<Value> = []
    let s_ns_mod: LowerState = emit_instr(dr_ns_mod.state, Instruction::Call(dr_ns_mod.value, fn_name, eargs_mod))
    return new_lower_result(dr_ns_mod.value, s_ns_mod)

// ---------------------------------------------------------------------------
// Index lowering
// ---------------------------------------------------------------------------

fn lower_index(st: LowerState, obj: Expr, idx: Expr) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)

    // v5.6.1 Sh.6 Phase 2 — single-subscript on tensor (`b[0]`) routes
    // through the same __mn_tensor_get_*_nd runtime as multi-dim,
    // matching mapanare/lower.py::_lower_index.
    if obj_r.value.ty.kind == TK_TENSOR():
        let mut one_idx: List<Expr> = []
        one_idx.push(idx)
        let obj_name_e: Expr = Expr::NoneLit
        let idx_r_ti: LowerResult = lower_expr(obj_r.state, idx)
        let mut s_ti: LowerState = idx_r_ti.state

        let elem_kind_ti: Int = tensor_elem_kind_of(obj_r.value)
        let mut fn_name_ti: String = "__mn_tensor_get_f64_nd"
        let mut elem_ty_ti: MIRType = mir_float()
        if elem_kind_ti == TK_INT():
            fn_name_ti = "__mn_tensor_get_i64_nd"
            elem_ty_ti = mir_int()

        let rank_r_ti: LowerResult = make_value(s_ti, mir_int(), "trank")
        s_ti = emit_instr(rank_r_ti.state, Instruction::Const(rank_r_ti.value, mir_int(), "1"))

        let mut all_args_ti: List<Value> = []
        all_args_ti.push(obj_r.value)
        all_args_ti.push(rank_r_ti.value)
        all_args_ti.push(idx_r_ti.value)

        let dest_r_ti: LowerResult = make_value(s_ti, elem_ty_ti, "tget")
        let s_out: LowerState = emit_instr(dest_r_ti.state, Instruction::Call(dest_r_ti.value, fn_name_ti, all_args_ti))
        return new_lower_result(dest_r_ti.value, s_out)

    let idx_r: LowerResult = lower_expr(obj_r.state, idx)

    // For string indexing, result is a string (char_at)
    // For list indexing, result is the element type from List<T>.args[0]
    // For map indexing, result is the value type from Map<K,V>.args[1]
    let mut elem_ty: MIRType = mir_unknown()
    if obj_r.value.ty.kind == TK_STRING():
        elem_ty = mir_string()
    else if obj_r.value.ty.kind == TK_LIST():
        if len(obj_r.value.ty.args) > 0:
            elem_ty = obj_r.value.ty.args[0]
    else if obj_r.value.ty.kind == TK_MAP():
        if len(obj_r.value.ty.args) > 1:
            elem_ty = obj_r.value.ty.args[1]

    let dest_r: LowerResult = make_value(idx_r.state, elem_ty, "t")
    let s: LowerState = emit_instr(dest_r.state, Instruction::IndexGet(dest_r.value, obj_r.value, idx_r.value))
    return new_lower_result(dest_r.value, s)

// v5.6.1 Sh.6 Phase 2 — `a[i, j]` / `a[i, j, k]` lowered as a variadic
// Call to __mn_tensor_get_{f64,i64}_nd. Element type is pulled from the
// tensor value's MIR type args (populated by lower_tensor); defaults to
// Float when unknown, matching Python's _lower_tensor_get fallback.
fn tensor_elem_kind_of(v: Value) -> Int:
    if v.ty.kind == TK_TENSOR():
        if len(v.ty.args) > 0:
            return v.ty.args[0].kind
    return TK_FLOAT()

// v5.6.3 Sh.6 Phase 4 — helpers for tensor reduction method dispatch.
fn is_tensor_reduction_method(m: String) -> Bool:
    if m == "sum" { return true }
    if m == "mean" { return true }
    if m == "max" { return true }
    if m == "min" { return true }
    if m == "argmax" { return true }
    if m == "argmin" { return true }
    return false

// Return type for a tensor reduction method on element kind `elem_kind`:
//   sum/max/min → element type (Int or Float)
//   mean        → always Float (no i64 mean runtime)
//   argmax/argmin → Int
fn tensor_reduction_ret_ty(method: String, elem_kind: Int) -> MIRType:
    if method == "argmax" { return mir_int() }
    if method == "argmin" { return mir_int() }
    if method == "mean" { return mir_float() }
    if elem_kind == TK_INT() { return mir_int() }
    return mir_float()

fn lower_tensor_index_get(st: LowerState, obj: Expr, indices: List<Expr>) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)
    let mut s: LowerState = obj_r.state

    let mut idx_vals: List<Value> = []
    let mut i: Int = 0
    let nidx: Int = len(indices)
    for _ in 0..128:
        if i < nidx:
            let ir: LowerResult = lower_expr(s, indices[i])
            s = ir.state
            idx_vals.push(ir.value)
            i = i + 1

    let elem_kind: Int = tensor_elem_kind_of(obj_r.value)
    let mut fn_name: String = "__mn_tensor_get_f64_nd"
    let mut elem_ty: MIRType = mir_float()
    if elem_kind == TK_INT():
        fn_name = "__mn_tensor_get_i64_nd"
        elem_ty = mir_int()

    // rank constant
    let rank_r: LowerResult = make_value(s, mir_int(), "trank")
    s = emit_instr(rank_r.state, Instruction::Const(rank_r.value, mir_int(), toString(nidx)))

    // build args: [tensor, rank, i0, i1, ...]
    let mut all_args: List<Value> = []
    all_args.push(obj_r.value)
    all_args.push(rank_r.value)
    for k in 0..nidx:
        all_args.push(idx_vals[k])

    let dest_r: LowerResult = make_value(s, elem_ty, "tget")
    s = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, all_args))
    return new_lower_result(dest_r.value, s)

// v5.6.3 Sh.6 Phase 4 — `a[1..3, _]` lowers to a Call to __mn_tensor_slice
// with flat args `[tensor, s0, s1, ..., e0, e1, ..., rank]`. The emitter
// special-cases __mn_tensor_slice to repackage the flat args into two
// stack-allocated [rank × i64] arrays before calling the runtime.
// Mirrors mapanare/lower.py::_lower_tensor_slice:2788-2835.
fn lower_tensor_slice(st: LowerState, obj: Expr, items: List<IndexItem>) -> LowerResult:
    let obj_r: LowerResult = lower_expr(st, obj)
    let mut s: LowerState = obj_r.state

    let rank: Int = len(items)
    let mut starts: List<Value> = []
    let mut ends: List<Value> = []

    let mut d: Int = 0
    for _ in 0..128:
        if d < rank:
            let it: IndexItem = items[d]
            if it.kind == "range":
                // start
                let sv: LowerResult = make_value(s, mir_int(), "ci")
                s = sv.state
                if expr_kind(it.start) == "none_lit":
                    s = emit_instr(s, Instruction::Const(sv.value, mir_int(), "0"))
                    starts.push(sv.value)
                else:
                    let start_r: LowerResult = lower_expr(s, it.start)
                    s = start_r.state
                    starts.push(start_r.value)
                // end
                if expr_kind(it.end) == "none_lit":
                    let ev: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(ev.state, Instruction::Const(ev.value, mir_int(), "0"))
                    ends.push(ev.value)
                else:
                    let end_r: LowerResult = lower_expr(s, it.end)
                    s = end_r.state
                    ends.push(end_r.value)
            else:
                if it.kind == "wildcard":
                    // start = 0
                    let sv_w: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(sv_w.state, Instruction::Const(sv_w.value, mir_int(), "0"))
                    starts.push(sv_w.value)
                    // end = tensor_shape_dim(obj, d)
                    let dv: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(dv.state, Instruction::Const(dv.value, mir_int(), toString(d)))
                    let shape_dest: LowerResult = make_value(s, mir_int(), "sdim")
                    s = shape_dest.state
                    let mut shape_args: List<Value> = []
                    shape_args.push(obj_r.value)
                    shape_args.push(dv.value)
                    s = emit_instr(s, Instruction::Call(shape_dest.value, "tensor_shape_dim", shape_args))
                    ends.push(shape_dest.value)
                else:
                    // scalar in slice context — treat as [k, k+1]
                    let scalar_r: LowerResult = lower_expr(s, it.expr)
                    s = scalar_r.state
                    starts.push(scalar_r.value)
                    let one_r: LowerResult = make_value(s, mir_int(), "ci")
                    s = emit_instr(one_r.state, Instruction::Const(one_r.value, mir_int(), "1"))
                    let end_d: LowerResult = make_value(s, mir_int(), "send")
                    s = emit_instr(end_d.state, Instruction::BinOp(end_d.value, BinOpKind::Add, scalar_r.value, one_r.value))
                    ends.push(end_d.value)
            d = d + 1

    // rank constant
    let rank_r: LowerResult = make_value(s, mir_int(), "trank")
    s = emit_instr(rank_r.state, Instruction::Const(rank_r.value, mir_int(), toString(rank)))

    // Result type = Tensor<T> (same element type as obj)
    let elem_kind_sl: Int = tensor_elem_kind_of(obj_r.value)
    let mut elem_ty_sl: MIRType = mir_float()
    if elem_kind_sl == TK_INT() { elem_ty_sl = mir_int() }
    let res_ty: MIRType = mir_tensor_of(elem_ty_sl)

    let dest_sl: LowerResult = make_value(s, res_ty, "tslice")
    s = dest_sl.state

    // Flat args: [obj, s0, s1, ..., e0, e1, ..., rank]
    let mut all_args: List<Value> = []
    all_args.push(obj_r.value)
    for a_i in 0..rank:
        all_args.push(starts[a_i])
    for b_i in 0..rank:
        all_args.push(ends[b_i])
    all_args.push(rank_r.value)

    s = emit_instr(s, Instruction::Call(dest_sl.value, "__mn_tensor_slice", all_args))
    return new_lower_result(dest_sl.value, s)

// ---------------------------------------------------------------------------
// Pipe lowering
// ---------------------------------------------------------------------------

fn lower_pipe_call(arg_r: LowerResult, fn_name: String, extra_exprs: List<Expr>) -> LowerResult:
    let mut s: LowerState = arg_r.state
    let mut args: List<Value> = []
    args.push(arg_r.value)
    let mut i: Int = 0
    let nee: Int = len(extra_exprs)
    for _ in 0..500:
        if i < nee:
            let extra_r: LowerResult = lower_expr(s, extra_exprs[i])
            s = extra_r.state
            args.push(extra_r.value)
            i = i + 1
    let dest_r: LowerResult = make_value(s, mir_unknown(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
    return new_lower_result(dest_r.value, new_s)

fn lower_pipe_with_call(arg_r: LowerResult, callee: Expr, extra_arg_exprs: List<Expr>) -> LowerResult:
    if expr_kind(callee) == "ident":
        return lower_pipe_call(arg_r, expr_ident_name(callee), extra_arg_exprs)
    return new_lower_result(arg_r.value, arg_r.state)

fn lower_pipe(st: LowerState, left: Expr, right: Expr) -> LowerResult:
    let arg_r: LowerResult = lower_expr(st, left)

    let rk: String = expr_kind(right)
    if rk == "ident":
        // v5.6.10 — bind via typed let so the empty extras list flows
        // through `lower_let_list_hint` and gets a known elem_ty
        // (Expr is an enum → GEP-trick path in emit_list_init).
        let empty_extras: List<Expr> = []
        return lower_pipe_call(arg_r, expr_ident_name(right), empty_extras)
    if rk == "call":
        return lower_pipe_with_call(arg_r, expr_call_callee(right), expr_call_args(right))

    // General case
    let fn_r: LowerResult = lower_expr(arg_r.state, right)
    let dest_r: LowerResult = make_value(fn_r.state, mir_unknown(), "t")
    let mut args: List<Value> = []
    args.push(arg_r.value)
    let s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_r.value.name, args))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Range lowering
// ---------------------------------------------------------------------------

fn lower_range(st: LowerState, start: Expr, end: Expr, inclusive: Bool) -> LowerResult:
    let start_r: LowerResult = lower_expr(st, start)
    let end_r: LowerResult = lower_expr(start_r.state, end)
    let dest_r: LowerResult = make_value(end_r.state, mir_range(), "t")
    let mut fn_name: String = "__mn_range"
    if inclusive { fn_name = "__mn_range_inclusive" }
    let mut args: List<Value> = []
    args.push(start_r.value)
    args.push(end_r.value)
    let s: LowerState = emit_instr(dest_r.state, Instruction::Call(dest_r.value, fn_name, args))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Lambda lowering
// ---------------------------------------------------------------------------

fn find_expr_alloca(st: LowerState, expr: Expr, obj_r: LowerResult) -> Value:
    // For Ident(name), return the variable's alloca address
    if expr_kind(expr) == "ident":
        let var_opt: Option<Value> = lookup_var(st, expr_ident_name(expr))
        match var_opt:
            Some(addr) => { return addr }
            _ => { return obj_r.value }
    return obj_r.value

// Module mutation: extract list to local variable, push, reconstruct.
// This avoids struct field push (GEP index issues) by rebuilding the
// current MIRModule layout explicitly, including consts.
fn module_push_struct(m: MIRModule, info: StructInfo) -> MIRModule:
    let mut lst: List<StructInfo> = m.structs
    lst.push(info)
    new MIRModule { name: m.name, functions: m.functions, structs: lst, enums: m.enums, extern_fns: m.extern_fns, agents: m.agents, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn module_push_enum(m: MIRModule, info: EnumInfo) -> MIRModule:
    let mut lst: List<EnumInfo> = m.enums
    lst.push(info)
    new MIRModule { name: m.name, functions: m.functions, structs: m.structs, enums: lst, extern_fns: m.extern_fns, agents: m.agents, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn module_push_function(m: MIRModule, f: MIRFunction) -> MIRModule:
    let mut lst: List<MIRFunction> = m.functions
    lst.push(f)
    new MIRModule { name: m.name, functions: lst, structs: m.structs, enums: m.enums, extern_fns: m.extern_fns, agents: m.agents, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn module_push_agent(m: MIRModule, info: AgentInfo) -> MIRModule:
    let mut lst: List<AgentInfo> = m.agents
    lst.push(info)
    new MIRModule { name: m.name, functions: m.functions, structs: m.structs, enums: m.enums, extern_fns: m.extern_fns, agents: lst, pipes: m.pipes, imports: m.imports, trait_names: m.trait_names, consts: m.consts }

fn lower_arm_body(st: LowerState, body: MatchArmBody) -> LowerResult:
    if match_arm_body_kind(body) == "block" { return lower_block(st, match_arm_body_block(body)) }
    return lower_expr(st, match_arm_body_expr(body))

fn extract_ident_name(expr: Expr) -> String:
    if expr_kind(expr) == "ident" { return expr_ident_name(expr) }
    return ""

fn unwrap_or_default(opt: Option<String>, default: String) -> String:
    match opt:
        Some(val) => { return val }
        _ => { return default }

fn lambda_body_to_block(body: LambdaBody) -> Block:
    if lambda_body_kind(body) == "block" { return lambda_body_block(body) }
    let ret_stmt: Stmt = Stmt::Return(Some(lambda_body_expr(body)))
    let stmts: List<Stmt> = []
    stmts.push(ret_stmt)
    let span: Span = new_span(0, 0, 0, 0)
    return new_block(span, stmts)

fn count_actual_lambdas(st: LowerState) -> Int:
    let mut count: Int = 0
    let mut i: Int = 0
    for _ in 0..1000:
        if i >= len(st.lambda_vars) { return count }
        let e: LambdaEntry = st.lambda_vars[i]
        if !e.var_name.starts_with("__ret__"):
            count = count + 1
        i = i + 1
    return count

fn lower_lambda(st: LowerState, params: List<Param>, body: LambdaBody) -> LowerResult:
    // v5.7.0 Sh.7: name lambdas after the tmp_counter at creation time
    // (matching mapanare/lower.py::_lower_lambda which calls
    // self._fresh_tmp("lambda")). The harness compares function-name
    // sets; without this, bootstrap (lambdaN where N matches main's
    // tmp_counter) and stage1 (lambdaK from a separate
    // count_actual_lambdas counter) diverged on names like
    // 64_closure_typed.mn — bootstrap emitted lambda0/2/4 while
    // stage1 emitted lambda1/2/3, failing the function-name parity
    // check.
    let name_r: LowerResult = fresh_tmp(st, "lambda")
    let lambda_name: String = name_r.value.name.substr(1, len(name_r.value.name) - 1)

    let body_block: Block = lambda_body_to_block(body)

    // Build extended params: explicit params + captured parent vars
    let parent_vars: List<VarInfo> = name_r.state.vars
    let mut all_params: List<Param> = []
    let mut capture_suffix: String = ""
    for pi in 0..len(params):
        all_params.push(params[pi])
    let mut ci: Int = 0
    let npv: Int = len(parent_vars)
    for _ in 0..500:
        if ci < npv:
            let pv: VarInfo = parent_vars[ci]
            let cap_param: Param = new Param { span: new_span(0, 0, 0, 0), name: pv.name, type_annotation: none }
            all_params.push(cap_param)
            if ci == 0:
                capture_suffix = ":" + pv.name
            else:
                capture_suffix = capture_suffix + "," + pv.name
            ci = ci + 1

    // Create FnDefData with Int return type
    let span: Span = new_span(0, 0, 0, 0)
    let empty_type_params: List<String> = []
    let empty_decorators: List<Decorator> = []
    let int_ret: TypeExpr = make_int_type()
    let fn_def: FnDefData = new_fn_def_data(span, lambda_name, false, empty_type_params, all_params, Some(int_ret), body_block, empty_decorators)

    // Lower as a nested function (lower_fn saves/restores function scope)
    let mut s: LowerState = lower_fn(name_r.state, fn_def, "")

    // Register lambda with capture info
    let encoded_name: String = lambda_name + capture_suffix
    let entry: LambdaEntry = new_lambda_entry("", encoded_name)
    let mut lv_lam: List<LambdaEntry> = s.lambda_vars
    lv_lam.push(entry)
    s.lambda_vars = lv_lam

    // Return a reference to the lambda function
    let dest_r: LowerResult = make_value(s, mir_fn_type(), "t")
    s = emit_instr(dest_r.state, Instruction::Const(dest_r.value, mir_fn_type(), lambda_name))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Spawn / Sync / Send lowering
// ---------------------------------------------------------------------------

fn lower_spawn(st: LowerState, callee: Expr, arg_exprs: List<Expr>) -> LowerResult:
    let mut s: LowerState = st
    let mut args: List<Value> = []
    let mut i: Int = 0
    let nae_sp: Int = len(arg_exprs)
    for _ in 0..500:
        if i < nae_sp:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            args.push(arg_r.value)
            i = i + 1

    let agent_name: String = extract_ident_name(callee)

    let agent_ty: MIRType = mir_agent(agent_name)
    let dest_r: LowerResult = make_value(s, agent_ty, "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::AgentSpawn(dest_r.value, agent_ty, args))
    return new_lower_result(dest_r.value, new_s)

fn lower_sync(st: LowerState, inner: Expr) -> LowerResult:
    if expr_kind(inner) == "field_access":
        let obj_r: LowerResult = lower_expr(st, expr_field_obj(inner))
        let dr_sync_fa: LowerResult = make_value(obj_r.state, mir_unknown(), "t")
        let s_sync_fa: LowerState = emit_instr(dr_sync_fa.state, Instruction::AgentSync(dr_sync_fa.value, obj_r.value, expr_field_name(inner)))
        return new_lower_result(dr_sync_fa.value, s_sync_fa)
    let val_r: LowerResult = lower_expr(st, inner)
    let dr_sync_bare: LowerResult = make_value(val_r.state, mir_unknown(), "t")
    let s_sync_bare: LowerState = emit_instr(dr_sync_bare.state, Instruction::AgentSync(dr_sync_bare.value, val_r.value, ""))
    return new_lower_result(dr_sync_bare.value, s_sync_bare)

fn lower_send(st: LowerState, target: Expr, value: Expr) -> LowerResult:
    let val_r: LowerResult = lower_expr(st, value)

    if expr_kind(target) == "field_access":
        let obj_r: LowerResult = lower_expr(val_r.state, expr_field_obj(target))
        let s_field: LowerState = emit_instr(obj_r.state, Instruction::AgentSend(obj_r.value, expr_field_name(target), val_r.value))
        let dr_field: LowerResult = make_value(s_field, mir_void(), "t")
        let s2_field: LowerState = emit_instr(dr_field.state, Instruction::Const(dr_field.value, mir_void(), ""))
        return new_lower_result(dr_field.value, s2_field)
    let target_r: LowerResult = lower_expr(val_r.state, target)
    let s_plain: LowerState = emit_instr(target_r.state, Instruction::AgentSend(target_r.value, "", val_r.value))
    let dr_plain: LowerResult = make_value(s_plain, mir_void(), "t")
    let s2_plain: LowerState = emit_instr(dr_plain.state, Instruction::Const(dr_plain.value, mir_void(), ""))
    return new_lower_result(dr_plain.value, s2_plain)

// ---------------------------------------------------------------------------
// Error propagation lowering
// ---------------------------------------------------------------------------

// v4.33.0: fixed block ordering bug — add_block sets current_block_idx,
// so the Branch must be emitted BEFORE creating the ok/err blocks.
// Otherwise the Branch ends up in the err block and the entry block
// has no terminator (MIR verifier: "block does not end with a
// terminator").
fn lower_error_prop(st: LowerState, inner: Expr) -> LowerResult:
    let val_r: LowerResult = lower_expr(st, inner)
    let mut s: LowerState = val_r.state

    // Extract tag
    let tag_r: LowerResult = make_value(s, mir_bool(), "tag")
    s = emit_instr(tag_r.state, Instruction::EnumTag(tag_r.value, val_r.value))

    // Create block labels (but do NOT add them yet — we need to emit
    // the Branch into the CURRENT block first)
    let ok_label_r: LowerResult = fresh_block_label(s, "prop_ok")
    s = ok_label_r.state
    let ok_label: String = ok_label_r.value.name

    let err_label_r: LowerResult = fresh_block_label(s, "prop_err")
    s = err_label_r.state
    let err_label: String = err_label_r.value.name

    // Branch on tag — emitted into the CURRENT (entry) block
    s = emit_instr(s, Instruction::Branch(tag_r.value, ok_label, err_label))

    // Now create the target blocks (this switches current_block_idx)
    s = add_block(s, err_label)
    let err_idx: Int = s.current_block_idx

    // Error path: return the error
    s = emit_instr(s, Instruction::Return(Some(val_r.value)))

    // Create ok block
    s = add_block(s, ok_label)
    let ok_idx: Int = s.current_block_idx

    // Ok path: unwrap
    let dest_r: LowerResult = make_value(s, mir_unknown(), "t")
    s = emit_instr(dest_r.state, Instruction::Unwrap(dest_r.value, val_r.value))
    return new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// List lowering
// ---------------------------------------------------------------------------

fn lower_list(st: LowerState, elements: List<Expr>) -> LowerResult = lower_list_typed(st, elements, mir_unknown())

// v5.16.0 Te.4.D — lower a string-interpolation expression to a chain
// of concat operations. Mirrors mapanare/lower.py::_lower_interp_string.
//
// For each part:
//   * `StringLit` parts pass through unmodified (already mir_string-typed).
//   * Any other part is wrapped in `Cast(target=mir_string)`. The
//     emitter routes Cast(Int/Float/Bool→String) to the matching
//     `__mn_str_from_*` runtime call (with drop tracking on the fresh
//     allocation) and treats Cast(String→String) as an SSA alias.
//
// All resulting Values are bundled into a single `InterpConcat` MIR
// instruction; `emit_interp_concat` (already in emit_llvm.mn) chains
// `__mn_str_concat` calls left-to-right.
fn lower_interp_string(st: LowerState, parts: List<Expr>) -> LowerResult:
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let np: Int = len(parts)
    for _ in 0..1000:
        if i >= np { break }
        let p: Expr = parts[i]
        let pr: LowerResult = lower_expr(s, p)
        s = pr.state
        if expr_kind(p) == "string_lit":
            vals.push(pr.value)
        else:
            let cr: LowerResult = make_value(s, mir_string(), "t")
            s = emit_instr(cr.state, Instruction::Cast(cr.value, pr.value, mir_string()))
            vals.push(cr.value)
        i = i + 1
    let dr: LowerResult = make_value(s, mir_string(), "t")
    let s_final: LowerState = emit_instr(dr.state, Instruction::InterpConcat(dr.value, vals))
    return new_lower_result(dr.value, s_final)

// v5.6.7 Ve.2 fix — explicit-element-type variant for lowering list
// literals. When the context provides an element-type hint (e.g.
// `let xs: List<String> = []` from `lower_let`, pattern-match on
// `Generic("List", [inner])`), use it instead of the default
// `mir_unknown()` fallback when the literal is empty. Otherwise the
// emitter sees `elem_ty.kind=TK_UNKNOWN → resolve_mir_type returns
// "i64"`, and allocates 8-byte slots for lists that actually hold
// 16-byte Strings / 48-byte Params / variable-size structs — the
// exact root cause of the stage2 runtime corruption that had been
// masked by the 384-byte floor in `emit_list_init`.
fn lower_list_typed(st: LowerState, elements: List<Expr>, hinted_elem_ty: MIRType) -> LowerResult:
    // Touch st to force materialization before any list operations.
    // Without this, clang -O0 may leave the LowerState in stale registers
    // from the caller's sret return, causing corruption in subsequent ops.
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let nel: Int = len(elements)
    for _ in 0..2000:
        if i < nel:
            let el_r: LowerResult = lower_expr(s, elements[i])
            s = el_r.state
            vals.push(el_r.value)
            i = i + 1

    // Prefer the element type inferred from the first element (concrete,
    // post-lower). Fall back to the caller's hint (from the `let`
    // annotation). Last resort: mir_unknown() — safe because downstream
    // emit_list_init keeps a 384-byte floor for unknown/scalar fallback.
    let mut elem_type: MIRType = mir_unknown()
    if len(vals) > 0:
        let first_v: Value = vals[0]
        elem_type = first_v.ty
    else:
        if hinted_elem_ty.kind != TK_UNKNOWN():
            elem_type = hinted_elem_ty
    let dest_r: LowerResult = make_value(s, mir_list(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::ListInit(dest_r.value, elem_type, vals))
    return new_lower_result(dest_r.value, new_s)

// v5.6.12 Lk.1 fix — destination-passing variant of lower_list_typed.
// Closes the alloca-aliasing leak class at its structural root: when
// `let mut a: List<T> = []` is the value's destination, the lowerer
// emits the ListInit directly into a's slot instead of fresh-tmp'ing
// %t<N> and then copying it into %a<M>.addr (the duplicate-alloca
// pattern). The emitter's `dn + ".addr"` convention turns a `dest_name`
// of "%a<M>" into the alloca name "%a<M>.addr", which the caller then
// binds for the variable. One alloca, one tracking entry, no copy.
//
// Mirrors Rust's destination-passing codegen (PlaceRef in
// rustc_codegen_llvm) — result-location semantics rather than
// value-then-copy.
fn lower_list_typed_into(st: LowerState, elements: List<Expr>, hinted_elem_ty: MIRType, dest_name: String) -> LowerResult:
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let nel: Int = len(elements)
    for _ in 0..2000:
        if i < nel:
            let el_r: LowerResult = lower_expr(s, elements[i])
            s = el_r.state
            vals.push(el_r.value)
            i = i + 1
    let mut elem_type: MIRType = mir_unknown()
    if len(vals) > 0:
        let first_v: Value = vals[0]
        elem_type = first_v.ty
    else:
        if hinted_elem_ty.kind != TK_UNKNOWN():
            elem_type = hinted_elem_ty
    // Use the caller-supplied dest_name (e.g. "%indices0") instead of
    // fresh-tmp. tmp_counter is NOT bumped here; the caller already
    // reserved the slot when it picked the variable's name.
    let dest_val: Value = new_value(dest_name, mir_list())
    let new_s: LowerState = emit_instr(s, Instruction::ListInit(dest_val, elem_type, vals))
    return new_lower_result(dest_val, new_s)

// v5.6.7 Ve.2 helper — unwrap `List<T>` type annotation to T (as MIRType).
// Returns `mir_unknown()` for any type expression that isn't a
// recognized list generic; callers use the UNKNOWN sentinel to mean
// "no hint available".
fn extract_list_elem_ty(st: LowerState, te: TypeExpr) -> MIRType:
    match te {
        Generic(name, args) => {
            if name == "List" && len(args) >= 1 {
                return lower_resolve_type_checked(st, args[0])
            }
            return mir_unknown()
        },
        _ => { return mir_unknown() }
    }

// v5.6.7 Ve.2 helper — resolve a `let x: List<T> = []` pattern to its
// element type hint for `lower_list_typed`. Returns mir_unknown() when
// the pattern doesn't apply (value isn't a list literal, or type_ann
// isn't `List<T>`), letting the caller fall through to the default
// path.
fn lower_let_list_hint(st: LowerState, value: Expr, type_ann: Option<TypeExpr>) -> MIRType:
    if expr_kind(value) != "list_lit" { return mir_unknown() }
    match type_ann:
        Some(te) => { return extract_list_elem_ty(st, te) }
        _ => { return mir_unknown() }

// ---------------------------------------------------------------------------
// Tensor lowering (v4.42.0)
// ---------------------------------------------------------------------------

fn lower_tensor(st: LowerState, elements: List<Expr>, shape: List<Int>) -> LowerResult:
    let mut s: LowerState = st
    let mut vals: List<Value> = []
    let mut i: Int = 0
    let nel: Int = len(elements)
    for _ in 0..2000:
        if i < nel:
            let el_r: LowerResult = lower_expr(s, elements[i])
            s = el_r.state
            vals.push(el_r.value)
            i = i + 1

    let mut elem_type: MIRType = mir_unknown()
    if len(vals) > 0:
        let first_v: Value = vals[0]
        elem_type = first_v.ty
    // v5.6.0 Sh.6: tensor value is typed as TENSOR so emit_llvm.mn resolves
    // it as llvm_ptr() — matches the ret type of __mn_tensor_alloc and the
    // arg type of every __mn_tensor_* builtin. Without this the var slot
    // alloca'd for `let a = <tensor>` becomes i64 and llvm-as rejects the
    // ptr/i64 store mismatch.
    // v5.6.1 Sh.6 Phase 2: carry elem_type so `a[i, j]` can dispatch between
    // __mn_tensor_get_f64_nd and _i64_nd. resolve_mir_type still returns ptr.
    let dest_r: LowerResult = make_value(s, mir_tensor_of(elem_type), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::TensorInit(dest_r.value, elem_type, shape, vals))
    return new_lower_result(dest_r.value, new_s)

// ---------------------------------------------------------------------------
// Map lowering
// ---------------------------------------------------------------------------

fn lower_map(st: LowerState, entries: List<MapEntry>) -> LowerResult:
    let mut s: LowerState = st
    let mut pairs: List<KVPair> = []
    let mut i: Int = 0
    let nent: Int = len(entries)
    for _ in 0..2000:
        if i < nent:
            let entry: MapEntry = entries[i]
            let kr: LowerResult = lower_expr(s, entry.key)
            s = kr.state
            let vr: LowerResult = lower_expr(s, entry.value)
            s = vr.state
            pairs.push(new_kv_pair(kr.value, vr.value))
            i = i + 1

    let mut key_ty: MIRType = mir_string()
    let mut val_ty: MIRType = mir_unknown()
    if len(pairs) > 0:
        key_ty = pairs[0].key.ty
        val_ty = pairs[0].val.ty
    let dest_r: LowerResult = make_value(s, mir_map(), "t")
    let new_s: LowerState = emit_instr(dest_r.state, Instruction::MapInit(dest_r.value, key_ty, val_ty, pairs))
    // v5.4.4 — map owns each key/value pair.
    let moved_s: LowerState = emit_move_kvpairs(new_s, pairs)
    return new_lower_result(dest_r.value, moved_s)

// ---------------------------------------------------------------------------
// Comprehension lowering (v5.15.1 Cb.4)
//
// Mirrors mapanare/lower.py::_lower_comprehension. Synthesizes a fresh
// accumulator (`__mn_comp_N`), nested for/if structure, and per-step
// push (lists) or `m[k] = v` assignment (maps). The result is identical
// to a hand-written loop modulo SSA naming.
//
// For range iterables (e.g. `for x in 0..n`), emits a direct For. For
// non-range iterables (lists), emits the index-based pattern
// `for __i in 0..len(__src) { let target = __src[__i]; ... }` because
// `for x in some_list` is not yet supported by the generic ForLoop
// lowering (the runtime `__iter_*` shims only know about ranges).
// ---------------------------------------------------------------------------

fn wrap_comp_for(st: LowerState, clause: CompClause, inner: Block) -> Block:
    // Range iterables: direct ForLoop.
    if expr_kind(clause.iter) == "range":
        let mut stmts: List<Stmt> = []
        stmts.push(Stmt::For(clause.target, clause.iter, inner))
        return new_block(make_span(0, 0, 0, 0), stmts)

    // Non-range iterables: hoist source binding, iterate via index.
    let n: Int = st.tmp_counter
    let src_name: String = "__mn_comp_src_" + toString(n)
    let idx_name: String = "__mn_comp_i_" + toString(n)

    // Build inner: `let target = __src[__i]; <inner.stmts>`
    let get_elem: Expr = Expr::Index(Expr::Ident(src_name), Expr::Ident(idx_name))
    let mut body_stmts: List<Stmt> = []
    body_stmts.push(Stmt::Let(clause.target, false, none, get_elem))
    for i in 0..len(inner.stmts):
        body_stmts.push(inner.stmts[i])
    let new_body: Block = new_block(make_span(0, 0, 0, 0), body_stmts)

    let mut len_args: List<Expr> = []
    len_args.push(Expr::Ident(src_name))
    let len_call: Expr = Expr::Call(Expr::Ident("len"), len_args)
    let range_e: Expr = Expr::Range(Expr::IntLit(0), len_call, false)

    let mut outer_stmts: List<Stmt> = []
    outer_stmts.push(Stmt::Let(src_name, false, none, clause.iter))
    outer_stmts.push(Stmt::For(idx_name, range_e, new_body))
    return new_block(make_span(0, 0, 0, 0), outer_stmts)

fn lower_comprehension(st: LowerState, expr: Expr) -> LowerResult:
    let kind: String = expr_comp_kind(expr)
    let clauses: List<CompClause> = expr_comp_clauses(expr)

    // Snapshot and clear the type hint so nested comps inside the
    // element / key / value don't accidentally inherit it.
    let mut s: LowerState = st
    let type_hint: Option<TypeExpr> = s.comp_type_hint
    s.comp_type_hint = none

    // Reserve a stable accumulator name. `tmp_counter` bumps separately
    // from `__mn_comp_src_N` / `__mn_comp_i_N` (handed out by
    // `wrap_comp_for`).
    let comp_n: Int = s.tmp_counter
    s.tmp_counter = s.tmp_counter + 1
    let result_name: String = "__mn_comp_" + toString(comp_n)

    // Build the init expression and the per-iteration write expression.
    let empty_list_init: List<Expr> = []
    let mut init: Expr = Expr::ListLit(empty_list_init)
    let mut inner_call: Expr = Expr::NoneLit
    if kind == "list":
        let elem_opt: Option<Expr> = expr_comp_element(expr)
        let mut elem_e: Expr = Expr::NoneLit
        match elem_opt:
            Some(e) => { elem_e = e }
            _ => {}
        let mut push_args: List<Expr> = []
        push_args.push(elem_e)
        inner_call = Expr::MethodCall(Expr::Ident(result_name), "push", push_args)
    else:
        let key_opt: Option<Expr> = expr_comp_key(expr)
        let val_opt: Option<Expr> = expr_comp_value(expr)
        let mut key_e: Expr = Expr::NoneLit
        let mut val_e: Expr = Expr::NoneLit
        match key_opt:
            Some(k) => { key_e = k }
            _ => {}
        match val_opt:
            Some(v) => { val_e = v }
            _ => {}
        let empty_entries: List<MapEntry> = []
        init = Expr::MapLit(empty_entries)
        // Map insertion via `m[k] = v` — IndexSet handles both list and
        // map writes; mirrors Python's _AssignExpr/IndexExpr synthesis.
        let target_idx: Expr = Expr::Index(Expr::Ident(result_name), key_e)
        inner_call = Expr::Assign(target_idx, "=", val_e)

    // Synthesize and lower `let mut __mn_comp_N: <hint> = <init>`.
    let let_stmt: Stmt = Stmt::Let(result_name, true, type_hint, init)
    let let_r: LowerResult = lower_stmt(s, let_stmt)
    s = let_r.state

    // For map comprehensions with an explicit `Map<K, V>` annotation,
    // post-patch the most recent MapInit instruction's key/val types
    // (mirror of Python `lower.py::_lower_let` v5.15.0 Te.2.C). Without
    // this, indexing the comprehension's result would see UNKNOWN
    // value type and the LLVM emitter would fall back to raw-pointer
    // reads (printing `<?>`).
    if kind == "map":
        match type_hint:
            Some(te) => { s = patch_last_mapinit_types(s, te) }
            _ => {}

    // Build the loop body innermost-out: filters then for-clauses,
    // both in reverse source order.
    let mut body_stmts0: List<Stmt> = []
    body_stmts0.push(Stmt::ExprStmt(inner_call))
    let mut body: Block = new_block(make_span(0, 0, 0, 0), body_stmts0)
    let nclauses: Int = len(clauses)
    let mut ci: Int = nclauses - 1
    for _ in 0..32:
        if ci < 0 { break }
        let clause: CompClause = clauses[ci]
        // Wrap body in `if cond { body }` for each filter, reversed.
        let mut fi: Int = len(clause.conditions) - 1
        for _ in 0..32:
            if fi < 0 { break }
            let cond: Expr = clause.conditions[fi]
            let if_expr: Expr = Expr::If(cond, body, none)
            let mut wrap: List<Stmt> = []
            wrap.push(Stmt::ExprStmt(if_expr))
            body = new_block(make_span(0, 0, 0, 0), wrap)
            fi = fi - 1
        body = wrap_comp_for(s, clause, body)
        ci = ci - 1

    // Lower each statement of the synthesized outer block.
    let mut bi: Int = 0
    let nbs: Int = len(body.stmts)
    for _ in 0..256:
        if bi < nbs:
            let r_bs: LowerResult = lower_stmt(s, body.stmts[bi])
            s = r_bs.state
            bi = bi + 1

    // Return the populated accumulator (Load from its alloca).
    return lower_identifier(s, result_name)

// Find the most recent MapInit instruction in the current block and
// patch its key_type / val_type from a `Map<K, V>` TypeExpr. No-op if
// the type expression isn't shaped like Map<_, _>.
fn patch_last_mapinit_types(st: LowerState, te: TypeExpr) -> LowerState:
    if type_expr_kind(te) != "generic" { return st }
    if type_expr_name(te) != "Map" { return st }
    let args: List<TypeExpr> = type_expr_args(te)
    if len(args) < 2 { return st }
    let k_ty: MIRType = lower_resolve_type_checked(st, args[0])
    let v_ty: MIRType = lower_resolve_type_checked(st, args[1])

    let idx: Int = st.current_block_idx
    if idx < 0 { return st }
    if idx >= len(st.fn_blocks) { return st }
    let bb: BasicBlock = st.fn_blocks[idx]
    let mut instrs: List<Instruction> = bb.instructions
    let mut j: Int = len(instrs) - 1
    for _ in 0..512:
        if j < 0 { return st }
        let inst: Instruction = instrs[j]
        match inst {
            MapInit(dest, _, _, pairs) => {
                instrs[j] = Instruction::MapInit(dest, k_ty, v_ty, pairs)
                let new_bb: BasicBlock = new BasicBlock { label: bb.label, instructions: instrs }
                let mut blocks: List<BasicBlock> = st.fn_blocks
                blocks[idx] = new_bb
                let mut new_st: LowerState = st
                new_st.fn_blocks = blocks
                return new_st
            },
            _ => {}
        }
        j = j - 1
    return st

// ---------------------------------------------------------------------------
// v5.20.1 Te.5.F.D — Let destructure lowering
// ---------------------------------------------------------------------------

// Mirrors `mapanare/lower.py::_lower_let_destructure`. When the RHS is
// a bare Identifier already in scope, run field accesses directly on
// the source name (IR byte-identical to manual `let x = p.x; let y =
// p.y`). Otherwise lower the RHS once into a `__mn_dst_N` tmp.
fn lower_let_destructure(st: LowerState, pattern: StructPattern, outer_mut: Bool, type_ann: Option<TypeExpr>, value: Expr) -> LowerState:
    let mut s: LowerState = st

    // Bare-Ident RHS optimization: skip the synthesized base tmp.
    if expr_kind(value) == "ident":
        let src_name: String = expr_ident_name(value)
        let lookup: Option<Value> = lookup_var(s, src_name)
        match lookup {
            Some(_) => {
                return emit_destructure_pattern(s, pattern, src_name, outer_mut)
            },
            _ => {}
        }

    // General case: synthesize `let __mn_dst_N = value` first.
    let tmp_idx: Int = s.struct_update_counter
    s.struct_update_counter = tmp_idx + 1
    let base_name: String = "__mn_dst_" + toString(tmp_idx)
    s = lower_let(s, base_name, false, type_ann, value)
    return emit_destructure_pattern(s, pattern, base_name, outer_mut)

// Walk a StructPattern; emit per-field `let` for leaf bindings, recurse
// for nested struct sub-patterns. Mirrors `_emit_destructure_pattern`.
fn emit_destructure_pattern(st: LowerState, pattern: StructPattern, base_name: String, outer_mut: Bool) -> LowerState:
    let mut s: LowerState = st
    let n: Int = len(pattern.fields)
    let mut i: Int = 0
    for _ in 0..200:
        if i >= n { return s }
        let fp: FieldPattern = pattern.fields[i]
        let fa: Expr = Expr::FieldAccess(Expr::Ident(base_name), fp.name)
        match fp.sub_pattern {
            Some(sub) => {
                let nested_idx: Int = s.struct_update_counter
                s.struct_update_counter = nested_idx + 1
                let nested_base: String = "__mn_dst_" + toString(nested_idx)
                let none_t: Option<TypeExpr> = none
                s = lower_let(s, nested_base, false, none_t, fa)
                s = emit_destructure_pattern(s, sub, nested_base, outer_mut)
            },
            _ => {
                let mut leaf_mut: Bool = outer_mut
                if fp.mutable { leaf_mut = true }
                let none_t2: Option<TypeExpr> = none
                s = lower_let(s, fp.name, leaf_mut, none_t2, fa)
            }
        }
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// v5.20.1 Te.5.F.E — if-let / while-let / let-else
// ---------------------------------------------------------------------------

// Mirrors `mapanare/lower.py::_lower_if_let`. Desugars to a 2-arm
// match: success arm runs then_block, wildcard arm runs else_block
// (or empty Block when omitted).
fn lower_if_let(st: LowerState, pattern: Pattern, scrutinee: Expr, then_block: Block, else_block: Option<Block>) -> LowerResult:
    let none_guard: Option<Expr> = none
    let success_arm: MatchArm = new_match_arm(pattern, MatchArmBody::BlockBody(then_block), none_guard)
    let mut else_body_block: Block = then_block  // placeholder
    let empty_stmts: List<Stmt> = []
    else_body_block = new_block(make_span(0, 0, 0, 0), empty_stmts)
    match else_block {
        Some(eb) => { else_body_block = eb },
        _ => {}
    }
    let wildcard_arm: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(else_body_block), none_guard)
    let mut arms: List<MatchArm> = []
    arms.push(success_arm)
    arms.push(wildcard_arm)
    return lower_match(st, scrutinee, arms)

// Mirrors `_lower_while_let`. Desugars to:
//   while true { match scrutinee { pat => body, _ => break } }
fn lower_while_let(st: LowerState, pattern: Pattern, scrutinee: Expr, body: Block) -> LowerState:
    let none_guard: Option<Expr> = none
    let success_arm: MatchArm = new_match_arm(pattern, MatchArmBody::BlockBody(body), none_guard)
    let break_stmts: List<Stmt> = [Stmt::Break]
    let break_block: Block = new_block(make_span(0, 0, 0, 0), break_stmts)
    let break_arm: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(break_block), none_guard)
    let mut arms: List<MatchArm> = []
    arms.push(success_arm)
    arms.push(break_arm)
    let match_expr: Expr = Expr::Match(scrutinee, arms)
    let body_stmts: List<Stmt> = [Stmt::ExprStmt(match_expr)]
    let while_body: Block = new_block(make_span(0, 0, 0, 0), body_stmts)
    return lower_while(st, Expr::BoolLit(true), while_body)

// Mirrors `_lower_let_else`. Strategy 2 (synthesized return):
//   let bound = match scrutinee { Some(bound) => bound, _ => else_block }
// Pattern shapes supported in v5.20.1:
//   - Pattern::Wildcard
//   - ConstructorPat with 0 args                       (e.g. None)
//   - ConstructorPat with 1 ident arg (Some(x), Ok(v), Err(e))
//   - ConstructorPat with 1 wildcard arg (Some(_))
// Multi-binding patterns deferred to v5.21.0+.
fn lower_let_else(st: LowerState, pattern: Pattern, scrutinee: Expr, else_block: Block) -> LowerState:
    let mut s: LowerState = st
    // Note: Python raises a RuntimeError at lower time when the else
    // block doesn't diverge. The bootstrap can't easily emit a
    // structured diagnostic from inside lower; we proceed with the
    // desugar and let downstream type-check or runtime catch it.
    // `block_diverges` is exposed for the cross-bootstrap test that
    // exercises the negative case.
    let _div: Bool = block_diverges(else_block)

    let none_guard: Option<Expr> = none
    let pk: String = pattern_kind(pattern)

    // Wildcard or 0-arg / 1-wildcard-arg constructor: emit as match
    // statement with no outer binding.
    if pk == "wildcard":
        let wild_body: Block = new_block(make_span(0, 0, 0, 0), [])
        let arm0: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(wild_body), none_guard)
        let arms_w: List<MatchArm> = [arm0]
        let mr_w: LowerResult = lower_match(s, scrutinee, arms_w)
        return mr_w.state

    if pk == "constructor":
        let pargs: List<Pattern> = pattern_ctor_args(pattern)
        let nargs: Int = len(pargs)
        let mut single_ident: Bool = false
        let mut single_wild: Bool = false
        if nargs == 1:
            let pak: String = pattern_kind(pargs[0])
            if pak == "ident" { single_ident = true }
            if pak == "wildcard" { single_wild = true }

        if nargs == 0 || single_wild:
            // No outer binding — emit as match-statement.
            let empty_stmts: List<Stmt> = []
            let succ_body: Block = new_block(make_span(0, 0, 0, 0), empty_stmts)
            let succ_arm: MatchArm = new_match_arm(pattern, MatchArmBody::BlockBody(succ_body), none_guard)
            let wild_arm: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(else_block), none_guard)
            let arms_le: List<MatchArm> = [succ_arm, wild_arm]
            let mr_le: LowerResult = lower_match(s, scrutinee, arms_le)
            return mr_le.state

        if single_ident:
            // `let Some(x) = opt else { ... }` →
            // `let x = match opt { Some(x) => x, _ => else_block }`.
            let bound_name: String = pattern_ident_name(pargs[0])
            let succ_arm2: MatchArm = new_match_arm(pattern, MatchArmBody::ExprBody(Expr::Ident(bound_name)), none_guard)
            let wild_arm2: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(else_block), none_guard)
            let arms_si: List<MatchArm> = [succ_arm2, wild_arm2]
            let synth_match: Expr = Expr::Match(scrutinee, arms_si)
            let none_t: Option<TypeExpr> = none
            return lower_let(s, bound_name, false, none_t, synth_match)

    // Unsupported pattern shape — fall through; produces a degenerate
    // empty match that evaluates the scrutinee for side effects.
    let only_match_body: Block = new_block(make_span(0, 0, 0, 0), [])
    let arm_only: MatchArm = new_match_arm(Pattern::Wildcard, MatchArmBody::BlockBody(only_match_body), none_guard)
    let arms_default: List<MatchArm> = [arm_only]
    let mr_def: LowerResult = lower_match(s, scrutinee, arms_default)
    return mr_def.state

// v5.20.1 Te.5.F.E divergence helpers. Mirrors `_block_diverges` /
// `_stmt_diverges` / `_expr_or_block_diverges` in lower.py — used by
// `lower_let_else` to enforce D5/D6.
fn block_diverges(block: Block) -> Bool:
    if len(block.stmts) == 0 { return false }
    return stmt_diverges(block.stmts[len(block.stmts) - 1])

fn stmt_diverges(s: Stmt) -> Bool:
    let sk: String = stmt_kind(s)
    if sk == "return" { return true }
    if sk == "break" { return true }
    if sk == "continue" { return true }
    if sk == "expr_stmt":
        let e: Expr = stmt_expr(s)
        let ek: String = expr_kind(e)
        if ek == "call":
            let callee: Expr = expr_call_callee(e)
            if expr_kind(callee) == "ident":
                let cn: String = expr_ident_name(callee)
                if cn == "panic" { return true }
                if cn == "abort" { return true }
                if cn == "exit" { return true }
        if ek == "match":
            let arms: List<MatchArm> = expr_match_arms(e)
            if len(arms) == 0 { return false }
            let mut i: Int = 0
            for _ in 0..200:
                if i >= len(arms) { return true }
                if !match_arm_body_diverges(arms[i].body) { return false }
                i = i + 1
            return true
        if ek == "if":
            let then_b: Block = expr_if_then(e)
            if !block_diverges(then_b) { return false }
            let else_opt: Option<ElseClause> = expr_if_else(e)
            match else_opt {
                Some(ec) => {
                    let eck: String = else_clause_kind(ec)
                    if eck == "else_block":
                        return block_diverges(else_clause_block(ec))
                    return false
                },
                _ => { return false }
            }
    return false

fn match_arm_body_diverges(body: MatchArmBody) -> Bool:
    let bk: String = match_arm_body_kind(body)
    if bk == "block":
        return block_diverges(match_arm_body_block(body))
    let synth_stmt: Stmt = Stmt::ExprStmt(match_arm_body_expr(body))
    return stmt_diverges(synth_stmt)

// ---------------------------------------------------------------------------
// v5.20.1 Te.5.F.C — Struct update lowering
// ---------------------------------------------------------------------------

// Lower `new T { x: 5, ..base }` (and `new T { ..base }`) by synthesizing
// a regular Construct whose fields are in struct-declaration order:
// overrides slotted by name, holes filled with `__mn_base_N.<field>`
// accesses. Mirrors `mapanare/lower.py::_lower_struct_update`.
fn lower_struct_update(st: LowerState, name: String, overrides: List<FieldInit>, base: Expr) -> LowerResult:
    let mut s: LowerState = st

    // Resolve full field list. Reject unknown structs.
    if !is_struct_name(s, name):
        return lower_construct(s, name, overrides)
    let field_names: List<String> = get_struct_field_names(s, name)
    let nfn: Int = len(field_names)

    // Synthesize a fresh base tmp name. Use a dedicated counter so
    // tmp_counter stays byte-identical to the manual long form.
    let base_idx: Int = s.struct_update_counter
    s.struct_update_counter = base_idx + 1
    let base_tmp_name: String = "__mn_base_" + toString(base_idx)

    // Lower the base expression once and register it under the
    // synthesized name so later FieldAccess(Ident(base_tmp_name), ...)
    // lookups find the same Value.
    //
    // The bootstrap's `define_var` semantically registers an alloca
    // *pointer*; lower_identifier then emits a Load on lookup. Mirror
    // that contract here: alloca + store + define_var(addr).
    let base_r: LowerResult = lower_expr(s, base)
    s = base_r.state
    let struct_ty_b: MIRType = mir_struct(name)
    let base_addr: Value = new_value("%" + base_tmp_name + ".addr", struct_ty_b)
    s = emit_instr(s, Instruction::Alloca(base_addr, struct_ty_b))
    s = emit_instr(s, Instruction::Store(base_addr, base_r.value))
    s = define_var(s, base_tmp_name, base_addr, false)

    // Build the full FieldInit list in struct-declaration order.
    // Overrides take precedence; the rest are FieldAccess from base.
    let mut full_fields: List<FieldInit> = []
    let mut fi: Int = 0
    let novr: Int = len(overrides)
    for _ in 0..500:
        if fi < nfn:
            let fname: String = field_names[fi]
            let mut found_override: Bool = false
            let mut override_expr: Expr = Expr::NoneLit
            let mut oi: Int = 0
            for _ in 0..500:
                if oi < novr:
                    let ov: FieldInit = overrides[oi]
                    if ov.name == fname:
                        found_override = true
                        override_expr = ov.value
                        break
                    oi = oi + 1
            let mut val_expr: Expr = Expr::FieldAccess(Expr::Ident(base_tmp_name), fname)
            if found_override { val_expr = override_expr }
            let synth_fi: FieldInit = new FieldInit { span: make_span(0, 0, 0, 0), name: fname, value: val_expr }
            full_fields.push(synth_fi)
            fi = fi + 1

    return lower_construct(s, name, full_fields)

// ---------------------------------------------------------------------------
// Construct (struct literal) lowering
// ---------------------------------------------------------------------------

fn lower_construct(st: LowerState, name: String, field_inits: List<FieldInit>) -> LowerResult:
    let mut s: LowerState = st

    let nfields: Int = len(field_inits)

    // Lower each field value
    let mut vals: List<Value> = []
    let mut i: Int = 0
    for _ in 0..500:
        if i < nfields:
            let fi: FieldInit = field_inits[i]
            let val_r: LowerResult = lower_expr(s, fi.value)
            s = val_r.state
            vals.push(val_r.value)
            i = i + 1

    // Emit as Call to "__new_<StructName>" (emitter handles this specially)
    let struct_ty: MIRType = mir_struct(name)
    let dest_r: LowerResult = make_value(s, struct_ty, "t")
    s = emit_instr(dest_r.state, Instruction::Call(dest_r.value, "__new_" + name, vals))
    // v5.4.4 — struct literal takes ownership of each field expression.
    s = emit_move_vals(s, vals)
    return new_lower_result(dest_r.value, s)

// v5.6.13 Layer 1 extension — destination-passing variant of
// `__new_<Struct>` constructor lowering, mirroring v5.6.12's
// lower_list_typed_into. Used by lower_let when the value is a
// struct constructor. Pairs each positional arg with the struct's
// declared field name (matching lower_call_by_name's __new_ branch
// at line ~2374), then emits `Instruction::StructInit` with a
// caller-supplied dest_name instead of a fresh tmp. The emitter's
// renamed `.addr` scratch (see emit_struct_init / emit_struct_init
// _from_values) then materializes `%<dest_name>.addr` — which IS
// the let's binding alloca, eliminating the duplicate alloca + the
// load+store dance at the let boundary.
//
// Mirrors Rust's destination-passing codegen (PlaceRef in
// rustc_codegen_llvm) for non-list aggregate types.
fn lower_struct_new_into(st: LowerState, struct_name: String, arg_exprs: List<Expr>, dest_name: String) -> LowerResult:
    let mut s: LowerState = st

    // Lower each constructor argument (parallel to lower_call's arg
    // pre-lowering at line ~1644).
    let mut args: List<Value> = []
    let mut i: Int = 0
    let nae: Int = len(arg_exprs)
    for _ in 0..500:
        if i < nae:
            let arg_r: LowerResult = lower_expr(s, arg_exprs[i])
            s = arg_r.state
            args.push(arg_r.value)
            i = i + 1

    // Pair positional args with declared field names — same logic
    // as lower_call_by_name's __new_ branch at line ~2380.
    let field_names: List<String> = get_struct_field_names(s, struct_name)
    let struct_ty: MIRType = mir_struct(struct_name)
    let mut field_pairs: List<FieldPair> = []
    let mut fi: Int = 0
    let nfn: Int = len(field_names)
    let na: Int = len(args)
    for _ in 0..500:
        if fi < nfn:
            if fi < na:
                let fp: FieldPair = new_field_pair(field_names[fi], args[fi])
                field_pairs.push(fp)
                fi = fi + 1

    // Use caller-supplied dest_name (e.g. "%foo3") instead of
    // fresh-tmp. tmp_counter is NOT bumped here; the caller already
    // reserved the slot when it picked the variable's name.
    let dest_val: Value = new_value(dest_name, struct_ty)
    s = emit_instr(s, Instruction::StructInit(dest_val, struct_ty, field_pairs))
    // v5.4.4 — StructInit takes ownership of each field value.
    s = emit_move_fields(s, field_pairs)
    return new_lower_result(dest_val, s)

// ---------------------------------------------------------------------------
// Signal expression lowering
// ---------------------------------------------------------------------------

fn lower_signal_expr(st: LowerState, inner: Expr) -> LowerResult:
    let init_r: LowerResult = lower_expr(st, inner)
    let dest_r: LowerResult = make_value(init_r.state, mir_signal(), "t")
    let s: LowerState = emit_instr(dest_r.state, Instruction::SignalInit(dest_r.value, mir_signal(), init_r.value))
    new_lower_result(dest_r.value, s)

// ---------------------------------------------------------------------------
// Assignment lowering
// ---------------------------------------------------------------------------

// v5.6.10 Ve.2 residual helper — return the element-type hint for an
// assignment of `[]` to a `mut` typed `List<T>` variable. Mirrors the
// v5.6.7 `lower_let_list_hint` pattern but pulls the hint from the
// variable's alloca type instead of an explicit annotation. Returns
// `mir_unknown()` whenever the hint cannot be recovered, letting the
// caller fall through to `lower_expr` and the 384-byte safety floor in
// `emit_list_init`.
fn lower_assign_list_hint(st: LowerState, target: Expr, value: Expr) -> MIRType:
    if expr_kind(value) != "list_lit" { return mir_unknown() }
    if expr_kind(target) != "ident" { return mir_unknown() }
    let tname: String = expr_ident_name(target)
    let opt_addr: Option<Value> = lookup_var(st, tname)
    match opt_addr {
        Some(addr) => {
            if addr.ty.kind == TK_LIST() && len(addr.ty.args) > 0 {
                return addr.ty.args[0]
            }
            return mir_unknown()
        },
        _ => { return mir_unknown() }
    }

fn lower_assign(st: LowerState, target: Expr, op: String, value: Expr) -> LowerResult:
    // v5.6.10 — empty-list reassignment elem_ty hint. Same pattern as
    // v5.6.7's `lower_let`: route `xs = []` through `lower_list_typed`
    // when the variable's alloca carries a `List<T>` type. Without
    // this, the RHS lowers via `lower_list → lower_list_typed(... mir_unknown())`
    // and `emit_list_init` falls through to the 384-byte safety floor.
    let hint_elem_asgn: MIRType = lower_assign_list_hint(st, target, value)
    let val_r: LowerResult = if hint_elem_asgn.kind != TK_UNKNOWN() {
            lower_list_typed(st, expr_list_elements(value), hint_elem_asgn)
        } else {
            lower_expr(st, value)
        }
    let mut s: LowerState = val_r.state

    let tk: String = expr_kind(target)
    if tk == "ident":
        let name: String = expr_ident_name(target)
        if op != "=":
            // Compound assignment: x += 1 → x = x + 1
            let old_r: LowerResult = lower_identifier(s, name)
            s = old_r.state
            let op_str: String = strip_assign_op(op)
            let binop_opt: Option<BinOpKind> = binop_from_str(op_str)
            match binop_opt {
                Some(binop) => {
                    let result_r: LowerResult = make_value(s, old_r.value.ty, "t")
                    s = emit_instr(result_r.state, Instruction::BinOp(result_r.value, binop, old_r.value, val_r.value))

                    let var_opt_cmp: Option<Value> = lookup_var(s, name)
                    match var_opt_cmp {
                        Some(addr) => {
                            s = emit_instr(s, Instruction::Store(addr, result_r.value))
                            return new_lower_result(result_r.value, s)
                        },
                        _ => {}
                    }
                },
                _ => {}
            }

        let var_opt_asgn: Option<Value> = lookup_var(s, name)
        match var_opt_asgn {
            Some(addr) => {
                // Update var type if the new value is more specific
                // (e.g. from unknown/i64 to a concrete struct type)
                let mut store_addr: Value = addr
                if addr.ty.kind == TK_UNKNOWN() && val_r.value.ty.kind != TK_UNKNOWN() {
                    store_addr = new_value(addr.name, val_r.value.ty)
                    s = define_var(s, name, store_addr, true)
                }
                s = emit_instr(s, Instruction::Store(store_addr, val_r.value))
                return new_lower_result(val_r.value, s)
            },
            _ => {}
        }
        return new_lower_result(val_r.value, s)
    if tk == "field_access":
        // Pass the ALLOCA address (not loaded value) so the emitter
        // can GEP+store directly to the struct field.
        let fa_obj: Expr = expr_field_obj(target)
        let obj_r_fa: LowerResult = lower_expr(s, fa_obj)
        let obj_alloca: Value = find_expr_alloca(obj_r_fa.state, fa_obj, obj_r_fa)
        s = emit_instr(obj_r_fa.state, Instruction::FieldSet(obj_alloca, expr_field_name(target), val_r.value))
        return new_lower_result(val_r.value, s)
    if tk == "index":
        let obj_r_idx: LowerResult = lower_expr(s, expr_index_obj(target))
        let idx_r: LowerResult = lower_expr(obj_r_idx.state, expr_index_idx(target))
        s = emit_instr(idx_r.state, Instruction::IndexSet(obj_r_idx.value, idx_r.value, val_r.value))
        // v5.4.4 — map_set / list_set memcpy key+val into the container;
        // ownership transfers. Emit Move so drop glue skips the slot.
        s = emit_instr(s, Instruction::Move(idx_r.value))
        s = emit_instr(s, Instruction::Move(val_r.value))
        return new_lower_result(val_r.value, s)
    // v5.6.1 Sh.6 Phase 2 — `d[i, j] = val` for Tensor assignment. Lower as
    // a direct Call to __mn_tensor_set_{f64,i64}_nd (variadic); skip
    // IndexSet since the runtime owns the tensor storage.
    if tk == "tensor_index":
        let ti_obj: Expr = expr_ti_obj(target)
        let ti_idxs: List<Expr> = expr_ti_indices(target)
        let obj_r_ti: LowerResult = lower_expr(s, ti_obj)
        s = obj_r_ti.state

        let mut ti_idx_vals: List<Value> = []
        let mut ii: Int = 0
        let nti: Int = len(ti_idxs)
        for _ in 0..128:
            if ii < nti:
                let ir_ti: LowerResult = lower_expr(s, ti_idxs[ii])
                s = ir_ti.state
                ti_idx_vals.push(ir_ti.value)
                ii = ii + 1

        let elem_kind_ti: Int = tensor_elem_kind_of(obj_r_ti.value)
        let mut fn_name_ti: String = "__mn_tensor_set_f64_nd"
        if elem_kind_ti == TK_INT():
            fn_name_ti = "__mn_tensor_set_i64_nd"

        let rank_r_ti: LowerResult = make_value(s, mir_int(), "trank")
        s = emit_instr(rank_r_ti.state, Instruction::Const(rank_r_ti.value, mir_int(), toString(nti)))

        let mut all_args_ti: List<Value> = []
        all_args_ti.push(obj_r_ti.value)
        all_args_ti.push(rank_r_ti.value)
        for kk in 0..nti:
            all_args_ti.push(ti_idx_vals[kk])
        all_args_ti.push(val_r.value)

        let void_dest_ti: LowerResult = make_value(s, mir_void(), "tset")
        s = emit_instr(void_dest_ti.state, Instruction::Call(void_dest_ti.value, fn_name_ti, all_args_ti))
        return new_lower_result(val_r.value, s)
    return new_lower_result(val_r.value, s)

// Strip the '=' suffix from compound assignment operators: "+=" → "+"
fn strip_assign_op(op: String) -> String:
    if op == "+=" { return "+" }
    if op == "-=" { return "-" }
    if op == "*=" { return "*" }
    if op == "/=" { return "/" }
    if op == "%=" { return "%" }
    return op

// ---------------------------------------------------------------------------
// If/else lowering
// ---------------------------------------------------------------------------

fn build_if_phi_entries(then_term: Bool, else_term: Bool, then_val: Value, else_val: Value, then_lbl: String, else_lbl: String) -> List<PhiEntry>:
    let mut result: List<PhiEntry> = []
    // Add then arm if it has a usable value (not terminated, not void)
    let then_ok: Bool = !then_term
    let then_non_void: Bool = then_val.ty.kind != TK_VOID()
    if then_ok:
        if then_non_void:
            result.push(new_phi_entry(then_lbl, then_val))
    // Add else arm if it has a usable value
    let else_ok: Bool = !else_term
    let else_non_void: Bool = else_val.ty.kind != TK_VOID()
    if else_ok:
        if else_non_void:
            result.push(new_phi_entry(else_lbl, else_val))
    // If one arm has value but other is void, add undef for the void arm.
    // Ge.1r: zeroinitializer is a concrete all-zeros value that LLVM -O2
    // propagates through struct fields, corrupting list elem_size to 0.
    // undef means "don't care" and is safe for dead PHI branches.
    if len(result) == 1:
        let r0_pe: PhiEntry = result[0]
        let r0_val: Value = r0_pe.val
        let r0_ty: MIRType = r0_val.ty
        if then_ok:
            if !then_non_void:
                let zero_v_then: Value = new_value("undef", r0_ty)
                result.push(new_phi_entry(then_lbl, zero_v_then))
        if else_ok:
            if !else_non_void:
                let zero_v_else: Value = new_value("undef", r0_ty)
                result.push(new_phi_entry(else_lbl, zero_v_else))
    return result

fn infer_variant_payload_type(st: LowerState, subject: Value, variant_name: String, field_idx: Int) -> MIRType:
    // Result types
    if subject.ty.kind == TK_RESULT():
        if len(subject.ty.args) >= 2:
            if variant_name == "Ok" { return subject.ty.args[0] }
            if variant_name == "Err" { return subject.ty.args[1] }
    // Option types
    if subject.ty.kind == TK_OPTION():
        if len(subject.ty.args) >= 1:
            return subject.ty.args[0]
    // Regular enums — look up from module registry
    // Also handle kind=="struct" when the name is a registered enum
    // (happens when enum types appear as generic args, e.g. List<TomlValue>)
    let is_enum_kind: Bool = subject.ty.kind == TK_ENUM()
    let is_struct_actually_enum: Bool = subject.ty.kind == TK_STRUCT() && is_enum_name(st, subject.ty.name)
    if is_enum_kind || is_struct_actually_enum:
        let enum_name: String = subject.ty.name
        let mut ei: Int = 0
        let nei: Int = len(st.module.enums)
        for _ in 0..500:
            if ei < nei:
                let einfo: EnumInfo = st.module.enums[ei]
                if einfo.name == enum_name:
                    let mut vi: Int = 0
                    let nvi: Int = len(einfo.variants)
                    for _ in 0..500:
                        if vi < nvi:
                            let vinfo: EnumVariantInfo = einfo.variants[vi]
                            if vinfo.name == variant_name:
                                if field_idx < len(vinfo.payload_types):
                                    return vinfo.payload_types[field_idx]
                            vi = vi + 1
                ei = ei + 1
    return mir_unknown()

fn is_some_else_clause(clause: Option<ElseClause>) -> Bool:
    match clause:
        Some(c) => { return true }
        _ => { return false }

fn lower_else_clause(st: LowerState, clause_opt: Option<ElseClause>) -> LowerResult:
    match clause_opt {
        Some(clause) => {
            return lower_else_clause_inner(st, clause)
        },
        _ => { return new_lower_result(void_value(), st) }
    }

fn lower_else_clause_inner(st: LowerState, clause: ElseClause) -> LowerResult:
    if else_clause_kind(clause) == "else_block":
        return lower_block(st, else_clause_block(clause))
    return lower_if(st, else_clause_cond(clause), else_clause_then(clause), else_clause_else(clause))

fn lower_if(st: LowerState, cond: Expr, then_block: Block, else_clause: Option<ElseClause>) -> LowerResult:
    let cond_r: LowerResult = lower_expr(st, cond)
    let mut s: LowerState = cond_r.state

    // Save the current (entry) block index for the branch
    let entry_idx: Int = s.current_block_idx

    // Create blocks
    let then_label_r: LowerResult = fresh_block_label(s, "if_then")
    s = then_label_r.state
    let then_label: String = then_label_r.value.name
    s = add_block(s, then_label)
    let then_idx: Int = s.current_block_idx

    let else_label_r: LowerResult = fresh_block_label(s, "if_else")
    s = else_label_r.state
    let else_label: String = else_label_r.value.name
    s = add_block(s, else_label)
    let else_idx: Int = s.current_block_idx

    // Reserve if_merge label (block added AFTER then/else — see below)
    let merge_label_r: LowerResult = fresh_block_label(s, "if_merge")
    s = merge_label_r.state
    let merge_label: String = merge_label_r.value.name

    // Branch (emitted in the entry block, not the merge block)
    s = set_block(s, entry_idx)
    s = emit_instr(s, Instruction::Branch(cond_r.value, then_label, else_label))

    // Then block
    s = set_block(s, then_idx)
    let then_r: LowerResult = lower_block(s, then_block)
    s = then_r.state
    let then_val: Value = then_r.value
    let then_exit_idx: Int = s.current_block_idx
    let then_terminated: Bool = current_block_terminated(s)
    if !then_terminated:
        s = emit_instr(s, Instruction::Jump(merge_label))

    // Else block
    s = set_block(s, else_idx)
    let mut else_val: Value = void_value()
    let has_else: Bool = is_some_else_clause(else_clause)
    if has_else:
        let else_r: LowerResult = lower_else_clause(s, else_clause)
        s = else_r.state
        else_val = else_r.value
    let else_exit_idx: Int = s.current_block_idx
    let else_terminated: Bool = current_block_terminated(s)
    if !else_terminated:
        s = emit_instr(s, Instruction::Jump(merge_label))

    // NOW add the if_merge block — after all inner blocks from then/else
    s = add_block(s, merge_label)
    let merge_idx: Int = s.current_block_idx

    // Merge block with phi — only include arms that reach the merge block
    s = set_block(s, merge_idx)

    let then_exit_label: String = get_block_label(s, then_exit_idx)
    let else_exit_label: String = get_block_label(s, else_exit_idx)

    // Build Phi directly — no list intermediary to avoid return-by-value bugs.
    // Determine what kind of Phi we need:
    // - Both arms have values → 2-entry Phi
    // - One arm has value, other void → 2-entry Phi with zeroinitializer
    // - Neither has value → void fallback
    let then_ok: Bool = !then_terminated
    let mut then_non_void: Bool = true
    if then_val.ty.kind == TK_VOID() { then_non_void = false }
    if then_val.ty.kind == TK_UNKNOWN() { then_non_void = false }
    if then_val.name == "%void" { then_non_void = false }
    let else_ok: Bool = !else_terminated
    let mut else_non_void: Bool = true
    if else_val.ty.kind == TK_VOID() { else_non_void = false }
    if else_val.ty.kind == TK_UNKNOWN() { else_non_void = false }
    if else_val.name == "%void" { else_non_void = false }

    // Determine case using simple flags
    let mut both: Bool = false
    let mut only_then: Bool = false
    let mut only_else: Bool = false
    if then_ok:
        if then_non_void:
            if else_ok:
                if else_non_void:
                    both = true
                if !else_non_void:
                    only_then = true
        if !then_non_void:
            if else_ok:
                if else_non_void:
                    only_else = true
    if !then_ok:
        if else_ok:
            if else_non_void:
                only_else = true

    let mut final_val: Value = void_value()
    if both:
        // When both arms produce values, check if types match.
        // Mismatched types (e.g., i64 vs Expr from side-effect if-else) → void fallback.
        let types_match: Bool = then_val.ty.kind == else_val.ty.kind
        if types_match:
            let mut ents_both: List<PhiEntry> = []
            ents_both.push(new_phi_entry(then_exit_label, then_val))
            ents_both.push(new_phi_entry(else_exit_label, else_val))
            let rr_both: LowerResult = make_value(s, then_val.ty, "if_result")
            s = rr_both.state
            s = emit_instr(s, Instruction::Phi(rr_both.value, ents_both))
            final_val = rr_both.value
    if only_then:
        let mut ents_then: List<PhiEntry> = []
        ents_then.push(new_phi_entry(then_exit_label, then_val))
        // Only include else branch if it's not terminated (reaches merge).
        // Use "undef" (not "zeroinitializer") for the missing-value branch:
        // zeroinitializer is a concrete all-zeros value that LLVM -O2 propagates
        // through struct fields, corrupting list elem_size to 0 (Ge.1r).
        // undef means "don't care" — LLVM can fold it without injecting zeros.
        if !else_terminated:
            let zero_v_t: Value = new_value("undef", then_val.ty)
            ents_then.push(new_phi_entry(else_exit_label, zero_v_t))
        let rr_then: LowerResult = make_value(s, then_val.ty, "if_result")
        s = rr_then.state
        s = emit_instr(s, Instruction::Phi(rr_then.value, ents_then))
        final_val = rr_then.value
    if only_else:
        let mut ents_else: List<PhiEntry> = []
        // Only include then branch if it's not terminated (reaches merge).
        // Use "undef" for the same reason as the only_then case (Ge.1r).
        if !then_terminated:
            let zero_v_e: Value = new_value("undef", else_val.ty)
            ents_else.push(new_phi_entry(then_exit_label, zero_v_e))
        ents_else.push(new_phi_entry(else_exit_label, else_val))
        let rr_else: LowerResult = make_value(s, else_val.ty, "if_result")
        s = rr_else.state
        s = emit_instr(s, Instruction::Phi(rr_else.value, ents_else))
        final_val = rr_else.value
    let is_void: Bool = !both && !only_then && !only_else
    if is_void:
        let rr_void: LowerResult = make_value(s, mir_void(), "t")
        s = emit_instr(rr_void.state, Instruction::Const(rr_void.value, mir_void(), ""))
        final_val = rr_void.value
        // Both branches terminated — merge block is unreachable.
        // Emit return terminator AFTER const so current_block_terminated returns true
        // and callers don't emit additional jumps to this block's successors.
        let both_terminated: Bool = then_terminated && else_terminated
        if both_terminated:
            let fn_ret: MIRType = get_current_fn_ret_type(s)
            let dummy_val: Value = new_value("zeroinitializer", fn_ret)
            s = emit_instr(s, Instruction::Return(Some(dummy_val)))
    return new_lower_result(final_val, s)

fn get_current_fn_ret_type(st: LowerState) -> MIRType:
    match st.current_fn:
        Some(f) => { return f.return_type }
        _ => { return mir_void() }

fn get_block_label(st: LowerState, idx: Int) -> String:
    if idx >= 0:
        if idx < len(st.fn_blocks):
            let bb: BasicBlock = st.fn_blocks[idx]
            return bb.label
    return "unknown"

// ---------------------------------------------------------------------------
// Match lowering
// ---------------------------------------------------------------------------

struct MatchBuildResult:
    state: LowerState
    arm_labels: List<String>
    arm_indices: List<Int>
    cases: List<SwitchCase>
    default_label: String

fn build_match_arms(st: LowerState, arms: List<MatchArm>, merge_label: String) -> MatchBuildResult:
    let mut labels: List<String> = []
    let mut indices: List<Int> = []
    let mut cases: List<SwitchCase> = []
    let mut default_lbl: String = merge_label
    let mut s: LowerState = st
    let mut i: Int = 0
    let n: Int = len(arms)
    for _ in 0..500:
        if i < n:
            let label_r: LowerResult = fresh_block_label(s, "match_arm")
            s = label_r.state
            let label: String = label_r.value.name
            s = add_block(s, label)
            labels.push(label)
            indices.push(s.current_block_idx)
            let arm: MatchArm = arms[i]
            let pk_arm: String = pattern_kind(arm.pattern)
            if pk_arm == "constructor" { cases.push(new_switch_case(pattern_ctor_name(arm.pattern), label)) }
            if pk_arm == "literal" { cases.push(new_switch_case(get_literal_value(pattern_literal_expr(arm.pattern)), label)) }
            if pk_arm == "ident":
                let pn: String = pattern_ident_name(arm.pattern)
                if is_enum_variant(s, pn):
                    cases.push(new_switch_case(pn, label))
                else:
                    default_lbl = label
            if pk_arm == "wildcard" { default_lbl = label }
            // v4.35.0: or-patterns — add one switch case per alternative
            if pk_arm == "or":
                let alts: List<Pattern> = pattern_or_alts(arm.pattern)
                let mut oi: Int = 0
                for _ in 0..20:
                    if oi >= len(alts) { oi = len(alts) } else:
                        let alt: Pattern = alts[oi]
                        let apk: String = pattern_kind(alt)
                        if apk == "constructor" { cases.push(new_switch_case(pattern_ctor_name(alt), label)) }
                        if apk == "literal" { cases.push(new_switch_case(get_literal_value(pattern_literal_expr(alt)), label)) }
                        if apk == "ident":
                            let apn: String = pattern_ident_name(alt)
                            if is_enum_variant(s, apn) { cases.push(new_switch_case(apn, label)) } else { default_lbl = label }
                        if apk == "wildcard" { default_lbl = label }
                        oi = oi + 1
            i = i + 1
    // Build result ONLY after all mutations are done — avoids aliasing
    // the LowerState (which shares fn_blocks buffers with s)
    return new MatchBuildResult { state: s, arm_labels: labels, arm_indices: indices, cases: cases, default_label: default_lbl }

fn lower_match(st: LowerState, subject: Expr, arms: List<MatchArm>) -> LowerResult:
    let subject_r: LowerResult = lower_expr(st, subject)
    let mut s: LowerState = subject_r.state

    // Save entry block for switch/branch emission
    let match_entry_idx: Int = s.current_block_idx

    // Reserve merge label (block added AFTER arms — see below)
    let merge_label_r: LowerResult = fresh_block_label(s, "match_merge")
    s = merge_label_r.state
    let merge_label: String = merge_label_r.value.name

    // Create arm blocks AND build switch cases.
    // Note: we use build_match_arms which returns accumulated results,
    // avoiding the for-loop local variable aliasing bug in the compiled binary.
    let build_r: MatchBuildResult = build_match_arms(s, arms, merge_label)
    s = build_r.state
    let arm_labels: List<String> = build_r.arm_labels
    let arm_indices: List<Int> = build_r.arm_indices
    let cases: List<SwitchCase> = build_r.cases
    let default_label: String = build_r.default_label

    // Emit switch or branch (in the entry block)
    s = set_block(s, match_entry_idx)
    if len(cases) > 0:
        let tag_r: LowerResult = make_value(s, subject_r.value.ty, "tag")
        s = tag_r.state
        s = emit_instr(s, Instruction::EnumTag(tag_r.value, subject_r.value))
        s = emit_instr(s, Instruction::Switch(tag_r.value, cases, default_label))
    else:
        if len(arm_labels) > 0:
            s = emit_instr(s, Instruction::Jump(arm_labels[0]))

    // Lower each arm
    let mut arm_results: List<PhiEntry> = []
    let mut ai: Int = 0
    let na_match: Int = len(arms)
    for _ in 0..500:
        if ai < na_match:
            let arm: MatchArm = arms[ai]
            let arm_idx: Int = arm_indices[ai]

            s = set_block(s, arm_idx)
            s = lower_push_scope(s)

            // Bind pattern variables — uses helper + explicit typed temp
            // to preserve LowerState type (avoids emitter type tracking loss)
            let s_bound: LowerState = bind_arm_pattern(s, subject_r.value, arm.pattern)
            s = s_bound

            // v4.79.0 (CARRY_FORWARD P3): guard fall-through — evaluate
            // guard, branch on result. On guard failure, jump to the next
            // arm's block (which re-binds pattern variables and re-checks
            // its own guard). This is the jump-to-next approach, which is
            // correct for the common case where successive arms match the
            // same scrutinee type (e.g., integer guards). The Python
            // pipeline uses a full decision-tree rebuild on guard failure
            // (lower.py:3281-3290) — that approach handles complex cases
            // where the next arm's constructor pattern differs. Porting
            // the full decision-tree approach requires build_decision_tree
            // in the self-hosted lowerer (future work).
            match arm.guard {
                Some(guard_expr) => {
                    let guard_r: LowerResult = lower_expr(s, guard_expr)
                    s = guard_r.state
                    let pass_r: LowerResult = fresh_block_label(s, "guard_pass")
                    s = pass_r.state
                    let pass_label: String = pass_r.value.name
                    let fail_r: LowerResult = fresh_block_label(s, "guard_fail")
                    s = fail_r.state
                    let fail_label: String = fail_r.value.name
                    s = emit_instr(s, Instruction::Branch(guard_r.value, pass_label, fail_label))
                    // Guard fail: jump to next arm (re-bind + re-check)
                    // or to merge if this is the last arm.
                    s = add_block(s, fail_label)
                    if ai + 1 < na_match {
                        let next_label: String = arm_labels[ai + 1]
                        s = emit_instr(s, Instruction::Jump(next_label))
                    } else {
                        s = emit_instr(s, Instruction::Jump(merge_label))
                    }
                    // Guard pass: continue to body
                    s = add_block(s, pass_label)
                },
                None => {}
            }

            // Lower arm body
            let arm_val_r: LowerResult = lower_arm_body(s, arm.body)
            s = arm_val_r.state

            let exit_label: String = get_block_label(s, s.current_block_idx)
            let arm_terminated: Bool = current_block_terminated(s)

            // Jump to merge if not terminated
            if !arm_terminated:
                s = emit_instr(s, Instruction::Jump(merge_label))
                // Track arm result for phi (include all arms that reach merge).
                // Ge.1r: use undef (not zeroinitializer) for void results —
                // zeroinitializer propagates zeros through struct fields at -O2.
                //
                // v5.20.1 Te.5.F.E: TK_UNKNOWN is no longer demoted to undef.
                // The let-else desugar produces match arms whose body is
                // `Expr::Ident(bound_name)` where the bound name was attached
                // by `bind_one_pattern_field` with payload type from
                // `infer_variant_payload_type` — for function-call scrutinees,
                // that resolves to TK_UNKNOWN. Demoting to undef forces phi
                // skip, then `lower_let` sees void and emits `alloca void`.
                // Treating TK_UNKNOWN as a real value lets the emitter resolve
                // the LLVM type from incoming values (`emit_mir_phi` step 1).
                let arm_kind: Int = arm_val_r.value.ty.kind
                if arm_kind == TK_VOID() || arm_val_r.value.name == "%void":
                    let zero_arm: Value = new_value("undef", arm_val_r.value.ty)
                    let pe_zero: PhiEntry = new_phi_entry(exit_label, zero_arm)
                    arm_results.push(pe_zero)
                else:
                    let pe_val: PhiEntry = new_phi_entry(exit_label, arm_val_r.value)
                    arm_results.push(pe_val)
            s = lower_pop_scope(s)
            ai = ai + 1

    // NOW add the merge block — after all arms, so arm-internal blocks
    // (from nested if/match) are emitted first, avoiding forward references.
    s = add_block(s, merge_label)
    let merge_idx: Int = s.current_block_idx

    // Add undef entry for switch default→merge path (Ge.1r: not zeroinitializer)
    if default_label == merge_label && len(arm_results) > 0:
        let entry_label: String = get_block_label(s, match_entry_idx)
        let first_pe: PhiEntry = arm_results[0]
        let first_val: Value = first_pe.val
        let zero_ty: MIRType = first_val.ty
        let zero_def: Value = new_value("undef", zero_ty)
        let def_pe: PhiEntry = new_phi_entry(entry_label, zero_def)
        arm_results.push(def_pe)

    // Merge block
    s = set_block(s, merge_idx)
    // Skip PHI when all arm results are undef (dead match result)
    let mut all_zero: Bool = true
    if len(arm_results) > 0:
        let mut zi: Int = 0
        for _ in 0..500:
            if zi < len(arm_results):
                if arm_results[zi].val.name != "undef" && arm_results[zi].val.name != "zeroinitializer" { all_zero = false }
                zi = zi + 1
    if len(arm_results) > 0 && !all_zero:
        let first_pe2: PhiEntry = arm_results[0]
        let first_val2: Value = first_pe2.val
        let phi_ty: MIRType = first_val2.ty
        let rr_phi: LowerResult = make_value(s, phi_ty, "match_result")
        s = rr_phi.state
        s = emit_instr(s, Instruction::Phi(rr_phi.value, arm_results))
        return new_lower_result(rr_phi.value, s)

    // All arms terminated (all have return/break) OR all arms produced
    // void results (statement-context match, e.g. v5.20.1 if-let
    // / while-let / let-else when used in a `fn main()` body).
    // Merge block may be unreachable but callers may reference the
    // result. When fn_ret is void, emitting `alloca void` is invalid
    // LLVM — return void_value() and let the caller drop the result.
    let fn_ret: MIRType = get_current_fn_ret_type(s)
    if fn_ret.kind == TK_VOID():
        return new_lower_result(void_value(), s)
    let rr_unreach: LowerResult = make_value(s, fn_ret, "match_result")
    s = rr_unreach.state
    let dummy_addr: Value = new_value(rr_unreach.value.name + ".dummy", fn_ret)
    s = emit_instr(s, Instruction::Alloca(dummy_addr, fn_ret))
    s = emit_instr(s, Instruction::Load(rr_unreach.value, dummy_addr))
    return new_lower_result(rr_unreach.value, s)

fn get_literal_value(expr: Expr) -> String:
    let ek: String = expr_kind(expr)
    if ek == "int_lit" { return toString(expr_int_val(expr)) }
    if ek == "float_lit" { return toString(expr_float_val(expr)) }
    if ek == "bool_lit" { if expr_bool_val(expr) { return "true" } else { return "false" } }
    if ek == "string_lit" { return expr_string_val(expr) }
    return ""

// ---------------------------------------------------------------------------
// Pretty-printer
// ---------------------------------------------------------------------------

// Bind pattern fields for a constructor pattern like Rect(w, h).
// Extracted from inline loop for clarity.
// Uses return-based iteration (return works, break doesn't).
fn has_non_zero_phi(entries: List<PhiEntry>) -> Bool:
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(entries) { return false }
        let pe: PhiEntry = entries[i]
        if pe.val.name != "zeroinitializer" { return true }
        i = i + 1
    return false

fn bind_arm_pattern(st: LowerState, subject_val: Value, pat: Pattern) -> LowerState:
    let pk: String = pattern_kind(pat)
    if pk == "constructor":
        return bind_pattern_fields(st, subject_val, pattern_ctor_name(pat), pattern_ctor_args(pat))
    if pk == "ident":
        return bind_ident_pattern(st, subject_val, pattern_ident_name(pat))
    // v4.35.0: or-patterns — bind from first alternative
    if pk == "or":
        let alts: List<Pattern> = pattern_or_alts(pat)
        if len(alts) > 0:
            return bind_arm_pattern(st, subject_val, alts[0])
    return st

fn bind_ident_pattern(st: LowerState, subject_val: Value, name: String) -> LowerState:
    if is_enum_variant(st, name) { return st }
    let ident_addr: Value = new_value("%" + name + ".addr", subject_val.ty)
    let mut s: LowerState = emit_instr(st, Instruction::Alloca(ident_addr, subject_val.ty))
    s = emit_instr(s, Instruction::Store(ident_addr, subject_val))
    s = define_var(s, name, ident_addr, false)
    return s

fn bind_one_pattern_field(st: LowerState, sub_pat: Pattern, subject: Value, variant_name: String, pi: Int) -> LowerState:
    if pattern_kind(sub_pat) != "ident" { return st }
    let var_name: String = pattern_ident_name(sub_pat)
    let pay_ty: MIRType = infer_variant_payload_type(st, subject, variant_name, pi)
    let payload_r: LowerResult = make_value(st, pay_ty, var_name)
    let mut s: LowerState = payload_r.state
    let indexed_name: String = variant_name + ":" + toString(pi)
    s = emit_instr(s, Instruction::EnumPayload(payload_r.value, subject, indexed_name))
    let payload_addr: Value = new_value("%" + var_name + toString(s.tmp_counter) + ".addr", pay_ty)
    s.tmp_counter = s.tmp_counter + 1
    s = emit_instr(s, Instruction::Alloca(payload_addr, pay_ty))
    s = emit_instr(s, Instruction::Store(payload_addr, payload_r.value))
    s = define_var(s, var_name, payload_addr, false)
    return s

fn bind_pattern_fields(st: LowerState, subject: Value, variant_name: String, sub_patterns: List<Pattern>) -> LowerState:
    let mut s: LowerState = st
    let mut pi: Int = 0
    for _ in 0..100:
        if pi >= len(sub_patterns) { return s }
        let sub_pat: Pattern = sub_patterns[pi]
        let s_next: LowerState = bind_one_pattern_field(s, sub_pat, subject, variant_name, pi)
        s = s_next
        pi = pi + 1
    return s

fn format_value(v: Value) -> String = v.name

fn format_type(t: MIRType) -> String = t.name

fn format_instruction(inst: Instruction) -> String:
    let k: String = instr_kind(inst)
    let d: Value = instr_dest(inst)
    if k == "const" { return d.name + " = const " + format_type(instr_const_type(inst)) + " " + instr_const_val(inst) }
    if k == "copy" { return d.name + " = copy " + instr_copy_src(inst).name }
    if k == "cast" { return d.name + " = cast " + instr_cast_src(inst).name + " to " + format_type(instr_cast_type(inst)) }
    if k == "binop" { return d.name + " = binop " + instr_binop_lhs(inst).name + ", " + instr_binop_rhs(inst).name }
    if k == "unaryop" { return d.name + " = unaryop " + instr_unaryop_operand(inst).name }
    if k == "struct_init" { return d.name + " = struct_init " + format_type(instr_struct_type(inst)) }
    if k == "field_get" { return d.name + " = field_get " + instr_fieldget_obj(inst).name + "." + instr_fieldget_name(inst) }
    if k == "field_set" { return "field_set " + instr_fieldset_obj(inst).name + "." + instr_fieldset_name(inst) + " = " + instr_fieldset_val(inst).name }
    if k == "list_init" { return d.name + " = list_init " + format_type(instr_list_type(inst)) }
    if k == "index_get" { return d.name + " = index_get " + instr_indexget_obj(inst).name + "[" + instr_indexget_idx(inst).name + "]" }
    if k == "index_set" { return "index_set " + instr_indexset_obj(inst).name + "[" + instr_indexset_idx(inst).name + "] = " + instr_indexset_val(inst).name }
    if k == "alloca" { return d.name + " = alloca " + format_type(instr_alloca_type(inst)) }
    if k == "load" { return d.name + " = load " + instr_load_ptr(inst).name }
    if k == "store" { return "store " + instr_store_val(inst).name + " to " + instr_store_ptr(inst).name }
    if k == "map_init" { return "map_init" }
    if k == "enum_init" { return d.name + " = enum_init " + format_type(instr_enum_type(inst)) + "::" + instr_enum_variant(inst) }
    if k == "enum_tag" { return d.name + " = enum_tag " + instr_enumtag_val(inst).name }
    if k == "enum_payload" { return d.name + " = enum_payload " + instr_enumpayload_val(inst).name + "::" + instr_enumpayload_variant(inst) }
    if k == "wrap_some" { return d.name + " = wrap_some " + instr_wrap_val(inst).name }
    if k == "wrap_none" { return d.name + " = wrap_none " + format_type(instr_wrapnone_type(inst)) }
    if k == "wrap_ok" { return d.name + " = wrap_ok " + instr_wrap_val(inst).name }
    if k == "wrap_err" { return d.name + " = wrap_err " + instr_wrap_val(inst).name }
    if k == "unwrap" { return d.name + " = unwrap " + instr_wrap_val(inst).name }
    if k == "call" { return d.name + " = call " + instr_call_fn(inst) + "(...)" }
    if k == "return":
        let val_opt: Option<Value> = instr_return_val(inst)
        match val_opt:
            Some(v) => { return "ret " + v.name }
            _ => { return "ret void" }
    if k == "jump" { return "jump " + instr_jump_target(inst) }
    if k == "branch" { return "branch " + instr_branch_cond(inst).name + ", " + instr_branch_true(inst) + ", " + instr_branch_false(inst) }
    if k == "switch" { return "switch " + instr_switch_tag(inst).name + " default " + instr_switch_default(inst) }
    if k == "agent_spawn" { return d.name + " = agent_spawn " + format_type(instr_agent_type(inst)) }
    if k == "agent_send" { return "agent_send" }
    if k == "agent_sync" { return "agent_sync" }
    if k == "signal_init" { return d.name + " = signal_init " + format_type(instr_signal_type(inst)) + " " + instr_signal_val(inst).name }
    if k == "signal_get" { return d.name + " = signal_get " + instr_signalget_sig(inst).name }
    if k == "signal_set" { return "signal_set " + instr_signalset_sig(inst).name + " = " + instr_signalset_val(inst).name }
    if k == "stream_op" { return "stream_op" }
    if k == "interp_concat" { return d.name + " = interp_concat [...]" }
    if k == "phi" { return d.name + " = phi [...]" }
    return "<unknown_instruction>"

fn pretty_print_block(bb: BasicBlock) -> String:
    let mut result: String = "  " + bb.label + ":\n"
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(bb.instructions) { return result }
        let inst: Instruction = bb.instructions[i]
        result = result + "    " + format_instruction(inst) + "\n"
        i = i + 1
    return result

fn pretty_print_function(f: MIRFunction) -> String:
    let mut params_str: String = ""
    let mut i: Int = 0
    let nfp: Int = len(f.params)
    for _ in 0..500:
        if i < nfp:
            let p: MIRParam = f.params[i]
            if i > 0 { params_str = params_str + ", " }
            params_str = params_str + p.name + ": " + format_type(p.ty)
            i = i + 1

    let header: String = "fn " + f.name + "(" + params_str + ") -> " + format_type(f.return_type)
    if len(f.blocks) == 0 { return header + " {}" }

    let mut result: String = header + " {\n"
    let mut bi: Int = 0
    let nfb: Int = len(f.blocks)
    for _ in 0..2000:
        if bi < nfb:
            let bb: BasicBlock = f.blocks[bi]
            result = result + pretty_print_block(bb)
            bi = bi + 1
    result = result + "}"
    return result

fn pretty_print_module(module: MIRModule) -> String:
    let mut result: String = ""
    if module.name != "":
        result = "module " + module.name + "\n\n"

    // Print structs
    let mut si_idx: Int = 0
    let nms: Int = len(module.structs)
    for _ in 0..500:
        if si_idx < nms:
            let s: StructInfo = module.structs[si_idx]
            result = result + "struct " + s.name + " {...}\n"
            si_idx = si_idx + 1

    // Print enums
    let mut ei: Int = 0
    let nme: Int = len(module.enums)
    for _ in 0..500:
        if ei < nme:
            let e: EnumInfo = module.enums[ei]
            result = result + "enum " + e.name + " {...}\n"
            ei = ei + 1

    if len(module.structs) > 0 { result = result + "\n" }
    if len(module.enums) > 0 { result = result + "\n" }

    // Print functions
    let mut fi: Int = 0
    let nmf: Int = len(module.functions)
    for _ in 0..2000:
        if fi < nmf:
            let f: MIRFunction = module.functions[fi]
            result = result + pretty_print_function(f) + "\n\n"
            fi = fi + 1

    return result

// ---------------------------------------------------------------------------
// MIR verifier
// ---------------------------------------------------------------------------

struct VerifyError:
    fn_name: String
    block_label: String
    message: String

fn new_verify_error(fn_name: String, block: String, msg: String) -> VerifyError = new VerifyError { fn_name: fn_name, block_label: block, message: msg }

fn verify_module(module: MIRModule) -> List<VerifyError>:
    let mut errors: List<VerifyError> = []
    for i in 0..len(module.functions):
        let f: MIRFunction = module.functions[i]
        let fn_errors: List<VerifyError> = verify_function(f)
        for j in 0..len(fn_errors):
            errors.push(fn_errors[j])
    return errors

fn verify_function(f: MIRFunction) -> List<VerifyError>:
    let mut errors: List<VerifyError> = []

    if len(f.blocks) == 0:
        let e: VerifyError = new_verify_error(f.name, "", "function has no basic blocks")
        errors.push(e)
        return errors

    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(f.blocks) { return errors }
        let bb: BasicBlock = f.blocks[i]
        let bb_errors: List<VerifyError> = verify_block(f.name, bb, f)
        let mut j: Int = 0
        let nbe: Int = len(bb_errors)
        for _ in 0..2000:
            if j < nbe:
                errors.push(bb_errors[j])
                j = j + 1
        i = i + 1
    return errors

fn verify_block(fn_name: String, bb: BasicBlock, f: MIRFunction) -> List<VerifyError>:
    let mut errors: List<VerifyError> = []

    if len(bb.instructions) == 0:
        let e_empty: VerifyError = new_verify_error(fn_name, bb.label, "block has no instructions")
        errors.push(e_empty)
        return errors

    // Check terminator
    let last: Instruction = bb.instructions[len(bb.instructions) - 1]
    if !is_terminator(last):
        let e_noterm: VerifyError = new_verify_error(fn_name, bb.label, "block does not end with a terminator")
        errors.push(e_noterm)

    // Check no terminators in the middle
    let mut i: Int = 0
    let nbi_m1: Int = len(bb.instructions) - 1
    for _ in 0..2000:
        if i < nbi_m1:
            let inst_mid: Instruction = bb.instructions[i]
            if is_terminator(inst_mid):
                let e_midterm: VerifyError = new_verify_error(fn_name, bb.label, "terminator at position " + toString(i) + " (not last)")
                errors.push(e_midterm)
            i = i + 1

    // Check phi nodes are at the start
    let mut seen_non_phi: Bool = false
    let mut phi_i: Int = 0
    let nbi_phi: Int = len(bb.instructions)
    for _ in 0..2000:
        if phi_i < nbi_phi:
            let inst_phi: Instruction = bb.instructions[phi_i]
            if instr_kind(inst_phi) == "phi":
                if seen_non_phi:
                    let e_phi: VerifyError = new_verify_error(fn_name, bb.label, "phi node after non-phi instruction")
                    errors.push(e_phi)
            else:
                seen_non_phi = true
            phi_i = phi_i + 1

    return errors

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

pub fn lower(program: Program, module_name: String) -> MIRModule:
    let mut st: LowerState = new_lower_state(module_name)

    // Pass 1: register declarations
    st = register_declarations(st, program)

    // Pass 2: lower function bodies
    st = lower_definitions(st, program)

    return st.module
