// emit_llvm.mn — LLVM IR emitter for the Mapanare self-hosted compiler.
// Consumes MIR (from lower.mn) and produces LLVM IR text (string-based).
//
// Architecture:
//   - emit_mir_module walks MIR structs, enums, extern fns, then functions
//   - emit_mir_function emits function header + basic blocks
//   - emit_mir_basic_block emits block label + instructions
//   - emit_mir_instruction maps each MIR opcode to LLVM IR instructions
//   - A local counter produces unique SSA names (%0, %1, ...)
//
// LLVM type constants and IR string builders are in emit_llvm_ir.mn.

import self::mir
import self::emit_llvm_ir
import self::abi

// ---------------------------------------------------------------------------
// Emitter state
// ---------------------------------------------------------------------------

struct StructEntry:
    name: String
    field_names: List<String>
    field_types: List<String>
    llvm_type: String

fn new_struct_entry(name: String, fields: List<String>, types: List<String>, ty: String) -> StructEntry = new StructEntry { name: name, field_names: fields, field_types: types, llvm_type: ty }

fn lookup_struct_field_types(st: EmitState, name: String) -> List<String>:
    // v5.6.5 Ve.1 fix: register_internal_struct pushes entries with empty
    // field_types (field NAMES only, for find_field_index's index-0-bug
    // fallback). The real MIR registration pushes full entries later via
    // register_mir_struct. A forward match-first-entry search finds the
    // empty internal entry (e.g., for Value, MIRType, EmitState, LowerState)
    // instead of the real one — callers would then see a 0-length field list
    // and misbehave (compute_payload_alloc_size would fall back to the
    // 256 upper-bound, under-allocating FnDefData's 264 bytes, etc.).
    // Skip empty entries so the real later-registered entry wins.
    let mut i: Int = 0
    let nstructs: Int = len(st.structs)
    for _ in 0..10000:
        if i < nstructs:
            let entry: StructEntry = st.structs[i]
            if entry.name == name:
                if len(entry.field_types) > 0:
                    return entry.field_types
            i = i + 1
    let empty: List<String> = []
    return empty

struct FnEntry:
    name: String
    ret_type: String
    param_types: List<String>

fn new_fn_entry(name: String, ret: String, params: List<String>) -> FnEntry = new FnEntry { name: name, ret_type: ret, param_types: params }

struct EmitState:
    lines: List<String>
    counter: Int
    functions: List<FnEntry>
    structs: List<StructEntry>
    module_name: String
    str_counter: Int
    str_globals: List<String>
    current_ret_type: String
    enum_names: List<String>
    enum_infos: List<EnumInfo>
    enum_inline_slots: List<Int>
    // v5.4.0 Own.1 Phase 2 — per-function ownership tracking.
    // Reset at emit_fn entry. Read by emit_drop_glue before ret.
    str_owned: List<String>
    list_owned: List<String>
    boxed_owned: List<String>
    // v5.6.4 Own.1 Phase 3 — Rt.06 tensor drop-glue. Parallel to
    // str_owned / list_owned / boxed_owned, but slots are a single
    // ptr (tensors are heap-allocated via __mn_tensor_alloc and
    // returned as a raw ptr). Drop-glue iterates at function exit
    // and calls __mn_tensor_free on each non-moved, non-returned
    // slot. Mirrors mapanare/emit_llvm_text.py::_tensor_vars.
    tensor_owned: List<String>
    moved_locals: List<String>
    // v5.4.1 — entry-block prelude for tracking-slot allocas.
    // emit_track_string / _boxed / _closure can fire from any basic
    // block, so we accumulate alloca + zero-init lines here for the
    // whole function and flush at function close. Mirrors
    // emit_llvm_text.py self._ent.
    entry_prelude_lines: List<String>
    // v5.4.1 — buffered body of the current function. While
    // in_entry_block is true, emit_line redirects here so the prelude
    // can be spliced ahead of the body, placing tracking allocas at
    // the top of the entry block per LLVM ABI.
    entry_block_body: List<String>
    in_entry_block: Bool
    // v5.4.3 — nested-loop depth at the current emission point.
    // Pushed when emit_mir_basic_block enters a block whose label
    // starts with for_body / while_body / mapfor_body; popped when the
    // block's instructions finish. emit_track_string / _boxed /
    // _closure consult this to prepend free-before-store to tracking
    // stores inside loops, preventing the Rt.03 leak pattern.
    loop_depth: Int
    // v5.4.4 Own.1 Phase 2 — slot-to-source parallel arrays.
    // Each tracking slot is allocated for a specific SSA source name
    // (e.g. "t14"). The lowerer emits Move(t14) when the resource
    // transfers ownership; drop glue matches the slot's recorded
    // source against moved_locals to skip the free. Indexes align
    // with str_owned / list_owned / boxed_owned respectively.
    str_owned_source: List<String>
    list_owned_source: List<String>
    boxed_owned_source: List<String>
    // v5.6.4 — parallel source-SSA list for tensor_owned.
    tensor_owned_source: List<String>
    // v5.8.6 We.1: host target detection (OS-1 mechanism, refined).
    // Replaces the v5.8.4 single `is_win64` flag — that name claimed
    // to mean "Win64" but was set whenever `_WIN32` was defined
    // which is true for *both* i686-w64-mingw32 (32-bit cdecl) and
    // x86_64-w64-mingw32 (64-bit Win64). Splitting into a Windows
    // gate plus an explicit pointer-width field lets the emitter
    // dispatch a 3-way: SysV/AAPCS64 (default), Win64 sret/sarg
    // (is_windows && win_arch == 64), or i686 cdecl sret/byval
    // (is_windows && win_arch == 32). Use the helpers
    // `use_win64_abi(st)` / `use_i686_abi(st)` instead of reading
    // these fields directly. Set in emit_mir_module from
    // __mn_host_is_windows() + __mn_host_arch_bits() so the
    // *running* compiler emits IR for its own host.
    is_windows: Bool
    win_arch: Int

fn new_emit_state(module_name: String) -> EmitState:
    let lines: List<String> = []
    let functions: List<FnEntry> = []
    // Build internal struct entries BEFORE constructing EmitState.
    // This avoids the circular dependency: pushing to st.structs needs
    // EmitState field info, but EmitState isn't registered yet.
    let structs: List<StructEntry> = build_internal_struct_list()
    let str_globals: List<String> = []
    let enum_names: List<String> = []
    let enum_infos: List<EnumInfo> = []
    let enum_inline_slots: List<Int> = []
    let str_owned: List<String> = []
    let list_owned: List<String> = []
    let boxed_owned: List<String> = []
    let tensor_owned: List<String> = []
    let moved_locals: List<String> = []
    let entry_prelude_lines: List<String> = []
    let entry_block_body: List<String> = []
    let str_owned_source: List<String> = []
    let list_owned_source: List<String> = []
    let boxed_owned_source: List<String> = []
    let tensor_owned_source: List<String> = []
    return new EmitState { lines: lines, counter: 0, functions: functions, structs: structs, module_name: module_name, str_counter: 0, str_globals: str_globals, current_ret_type: "void", enum_names: enum_names, enum_infos: enum_infos, enum_inline_slots: enum_inline_slots, str_owned: str_owned, list_owned: list_owned, boxed_owned: boxed_owned, tensor_owned: tensor_owned, moved_locals: moved_locals, entry_prelude_lines: entry_prelude_lines, entry_block_body: entry_block_body, in_entry_block: false, loop_depth: 0, str_owned_source: str_owned_source, list_owned_source: list_owned_source, boxed_owned_source: boxed_owned_source, tensor_owned_source: tensor_owned_source, is_windows: false, win_arch: 0 }

fn build_internal_struct_list() -> List<StructEntry>:
    let mut list: List<StructEntry> = []
    // StructEntry MUST be first — make_entry creates StructEntry values,
    // and the emitter needs StructEntry's field info to generate correct
    // insertvalue indices for subsequent make_entry calls.
    list.push(make_entry("StructEntry", ["name", "field_names", "field_types", "llvm_type"]))
    list.push(make_entry("MIRModule", ["name", "functions", "structs", "enums", "extern_fns", "agents", "pipes", "imports", "trait_names", "consts"]))
    list.push(make_entry("LowerState", ["module", "current_fn", "current_block_idx", "tmp_counter", "block_counter", "vars", "scope_stack", "impl_methods", "struct_fields", "enum_variants", "lambda_vars", "fn_blocks", "generic_fns", "generic_structs", "generic_enums", "loop_header_label", "loop_exit_label", "comp_type_hint", "struct_update_counter", "chain_compare_counter", "expected_enum_name"]))
    list.push(make_entry("EmitState", ["lines", "counter", "functions", "structs", "module_name", "str_counter", "str_globals", "current_ret_type", "enum_names", "enum_infos", "enum_inline_slots", "str_owned", "list_owned", "boxed_owned", "tensor_owned", "moved_locals", "entry_prelude_lines", "entry_block_body", "in_entry_block", "loop_depth", "str_owned_source", "list_owned_source", "boxed_owned_source", "tensor_owned_source", "is_windows", "win_arch"]))
    list.push(make_entry("LowerResult", ["value", "state"]))
    list.push(make_entry("CompileResult", ["success", "ir_text", "errors"]))
    list.push(make_entry("MatchBuildResult", ["state", "arm_labels", "arm_indices", "cases", "default_label"]))
    list.push(make_entry("FnEntry", ["name", "ret_type", "param_types"]))
    // StructEntry already registered first (above)
    list.push(make_entry("VarInfo", ["name", "current", "mutable"]))
    list.push(make_entry("StructFieldInfo", ["name", "field_names", "field_types"]))
    list.push(make_entry("EnumVariantNames", ["enum_name", "variant_names"]))
    list.push(make_entry("LambdaEntry", ["var_name", "fn_name"]))
    list.push(make_entry("ExternFnInfo", ["abi", "module_name", "fn_name", "param_types", "return_type"]))
    list.push(make_entry("VerifyError", ["fn_name", "block_label", "message"]))
    list.push(make_entry("ImplEntry", ["key", "mir_name"]))
    list.push(make_entry("ImportInfo", ["path", "items"]))
    list.push(make_entry("ModuleConst", ["name", "type_name", "int_value", "str_value", "is_string"]))
    list.push(make_entry("AgentInfo", ["name", "inputs", "outputs", "method_names"]))
    list.push(make_entry("PipeInfo", ["name", "stages"]))
    list.push(make_entry("MIRFunction", ["name", "params", "return_type", "blocks", "decorators", "is_public"]))
    list.push(make_entry("BasicBlock", ["label", "instructions"]))
    list.push(make_entry("MIRType", ["name", "kind", "args"]))
    list.push(make_entry("Value", ["name", "ty"]))
    return list

fn make_entry(name: String, field_names: List<String>) -> StructEntry:
    let types: List<String> = []
    new_struct_entry(name, field_names, types, "%struct." + name)

// Pre-register internal compiler struct types that may not be in the MIR module.
// Without these, find_field_index returns 0 for all fields (index-0 bug).
fn register_internal_struct(st: EmitState, name: String, fields: List<String>) -> EmitState:
    let types: List<String> = []
    let entry: StructEntry = new_struct_entry(name, fields, types, "%struct." + name)
    st.structs.push(entry)
    st

fn register_all_internal_structs(st: EmitState) -> EmitState:
    let mut s: EmitState = st
    // MIRModule: name, functions, structs, enums, extern_fns, agents, pipes, imports, trait_names, consts
    s = register_internal_struct(s, "MIRModule", ["name", "functions", "structs", "enums", "extern_fns", "agents", "pipes", "imports", "trait_names", "consts"])
    // LowerState: module, current_fn, current_block_idx, tmp_counter, block_counter, vars, scope_stack, impl_methods, struct_fields, enum_variants, lambda_vars, fn_blocks, generic_fns, generic_structs, generic_enums, loop_header_label, loop_exit_label, comp_type_hint, struct_update_counter, chain_compare_counter, expected_enum_name
    s = register_internal_struct(s, "LowerState", ["module", "current_fn", "current_block_idx", "tmp_counter", "block_counter", "vars", "scope_stack", "impl_methods", "struct_fields", "enum_variants", "lambda_vars", "fn_blocks", "generic_fns", "generic_structs", "generic_enums", "loop_header_label", "loop_exit_label", "comp_type_hint", "struct_update_counter", "chain_compare_counter", "expected_enum_name"])
    // EmitState: lines, counter, functions, structs, module_name, str_counter, str_globals, current_ret_type, enum_names, enum_infos, enum_inline_slots, str_owned, list_owned, boxed_owned, tensor_owned, moved_locals, entry_prelude_lines, entry_block_body, in_entry_block, loop_depth, str_owned_source, list_owned_source, boxed_owned_source, tensor_owned_source, is_windows, win_arch
    s = register_internal_struct(s, "EmitState", ["lines", "counter", "functions", "structs", "module_name", "str_counter", "str_globals", "current_ret_type", "enum_names", "enum_infos", "enum_inline_slots", "str_owned", "list_owned", "boxed_owned", "tensor_owned", "moved_locals", "entry_prelude_lines", "entry_block_body", "in_entry_block", "loop_depth", "str_owned_source", "list_owned_source", "boxed_owned_source", "tensor_owned_source", "is_windows", "win_arch"])
    // LowerResult: value, state
    s = register_internal_struct(s, "LowerResult", ["value", "state"])
    // CompileResult: success, ir_text, errors
    s = register_internal_struct(s, "CompileResult", ["success", "ir_text", "errors"])
    // MatchBuildResult: state, arm_labels, arm_indices, cases, default_label
    s = register_internal_struct(s, "MatchBuildResult", ["state", "arm_labels", "arm_indices", "cases", "default_label"])
    // FnEntry: name, ret_type, param_types
    s = register_internal_struct(s, "FnEntry", ["name", "ret_type", "param_types"])
    // StructEntry: name, field_names, field_types, llvm_type
    s = register_internal_struct(s, "StructEntry", ["name", "field_names", "field_types", "llvm_type"])
    // VarInfo: name, current, mutable
    s = register_internal_struct(s, "VarInfo", ["name", "current", "mutable"])
    // StructFieldInfo: name, field_names, field_types
    s = register_internal_struct(s, "StructFieldInfo", ["name", "field_names", "field_types"])
    // EnumVariantNames: enum_name, variant_names
    s = register_internal_struct(s, "EnumVariantNames", ["enum_name", "variant_names"])
    // LambdaEntry: var_name, fn_name
    s = register_internal_struct(s, "LambdaEntry", ["var_name", "fn_name"])
    // ExternFnInfo: abi, module_name, fn_name, param_types, return_type
    s = register_internal_struct(s, "ExternFnInfo", ["abi", "module_name", "fn_name", "param_types", "return_type"])
    // VerifyError: fn_name, block_label, message
    s = register_internal_struct(s, "VerifyError", ["fn_name", "block_label", "message"])
    // ImplEntry: key, mir_name
    s = register_internal_struct(s, "ImplEntry", ["key", "mir_name"])
    // ImportInfo: path, items
    s = register_internal_struct(s, "ImportInfo", ["path", "items"])
    // ModuleConst: name, type_name, int_value, str_value, is_string
    s = register_internal_struct(s, "ModuleConst", ["name", "type_name", "int_value", "str_value", "is_string"])
    // AgentInfo: name, inputs, outputs, method_names
    s = register_internal_struct(s, "AgentInfo", ["name", "inputs", "outputs", "method_names"])
    // PipeInfo: name, stages
    s = register_internal_struct(s, "PipeInfo", ["name", "stages"])
    // MIRFunction: name, params, return_type, blocks, decorators, is_public
    s = register_internal_struct(s, "MIRFunction", ["name", "params", "return_type", "blocks", "decorators", "is_public"])
    // BasicBlock: label, instructions
    s = register_internal_struct(s, "BasicBlock", ["label", "instructions"])
    // MIRType: name, kind, args
    s = register_internal_struct(s, "MIRType", ["name", "kind", "args"])
    // Value: name, ty
    s = register_internal_struct(s, "Value", ["name", "ty"])
    return s

fn emit_global(st: EmitState, line: String) -> EmitState:
    st.str_globals.push(line)
    st

fn emit_fresh_tmp(st: EmitState, prefix: String) -> String = prefix + "." + toString(st.counter)

// ---------------------------------------------------------------------------
// Line emission
// ---------------------------------------------------------------------------

fn emit_line(st: EmitState, line: String) -> EmitState:
    // v5.4.1 — entry-block emission is buffered so the prelude
    // (tracking-slot allocas queued by emit_track_string / _boxed /
    // _closure) can be flushed in front of it before pushing to lines.
    if st.in_entry_block:
        st.entry_block_body.push(line)
    else:
        st.lines.push(line)
    st

fn emit_blank(st: EmitState) -> EmitState = emit_line(st, "")

// ---------------------------------------------------------------------------
// Counter helpers
// ---------------------------------------------------------------------------

fn next_ssa(st: EmitState) -> EmitState = st
    // Returns state with counter incremented; caller uses st.counter for name

fn ssa_name(st: EmitState) -> String = "%" + toString(st.counter)

fn next_str_name(st: EmitState) -> String = "@str." + toString(st.str_counter)

// ---------------------------------------------------------------------------
// Lookup helpers
// ---------------------------------------------------------------------------

fn find_function(st: EmitState, name: String) -> Option<FnEntry>:
    let mut i: Int = len(st.functions) - 1
    for _ in 0..2000:
        if i < 0: return none
        let f: FnEntry = st.functions[i]
        if f.name == name: return Some(f)
        i = i - 1
    return none

fn find_struct_entry(st: EmitState, name: String) -> Option<StructEntry>:
    let mut i: Int = len(st.structs) - 1
    for _ in 0..2000:
        if i < 0: return none
        let s: StructEntry = st.structs[i]
        if s.name == name: return Some(s)
        i = i - 1
    return none

// ---------------------------------------------------------------------------
// State-aware type resolution (corrects struct→enum misclassification)
// ---------------------------------------------------------------------------

fn resolve_type(st: EmitState, ty: MIRType) -> String:
    let resolved: String = resolve_mir_type(ty)
    if resolved.starts_with("%struct.") && is_enum_type(st, ty.name):
        return "%enum." + ty.name
    return resolved

// ---------------------------------------------------------------------------
// Runtime function declarations
// ---------------------------------------------------------------------------

// v4.32.0 Phase 1.2: mirrors the Python `_RUNTIME_FN_ATTRS` table at
// mapanare/emit_llvm_text.py:243-399. The v4.30.0 CARRY_FORWARD.md
// claim "six 7-cycle emitter items re-verified clean" was Python-side-
// only — Rattler #8 and Cobra #14 at the v4.31.0 arc-end panel flagged
// the self-hosted emitter as still producing plain `nounwind readonly`
// with no `noalias`/`willreturn` annotations. This release closes the
// asymmetry.
//
// The attribute rule (from emit_llvm_text.py:239-242):
//   - allocators  gain `noalias` (on return, ptr only) + `willreturn`
//   - read-only   queries gain `readonly` + `willreturn`
//   - every deterministic terminating function keeps `nounwind`
//
// `noalias` is a RETURN-VALUE attribute and LLVM rejects it on any non-
// pointer return type, so we emit it in the ret_prefix (before the
// return type) only when the declared ret is `ptr`. Every other
// attribute is a FUNCTION attribute and emitted as a suffix after the
// params list. This matches the split Python performs at
// emit_llvm_text.py:790-794.

fn declare_runtime_fn(st: EmitState, name: String, ret: String, params: String) -> EmitState:
    let mut ret_prefix: String = ""
    if ret == "ptr":
        ret_prefix = get_fn_ret_prefix(name)
    let suffix: String = get_fn_attrs(name)
    // v5.8.4 Wb.2 + v5.8.6 We.1: 3-way ABI dispatch.
    //
    //   Win64: aggregate-by-value params > 8 B → bare `ptr` (sarg
    //   pattern at call site); aggregate returns > 8 B → `void` with
    //   a `ptr sret(<orig>)` hidden first arg. Mirrors Python
    //   emit_llvm_text._decl_fn line 1271.
    //
    //   i686 cdecl: aggregate-by-value params > 8 B → `ptr byval(<orig>)
    //   align 4` (LLVM i686 backend lowers this as caller-pushes-by-
    //   value); aggregate returns > 8 B → same sret pattern as Win64.
    //   Empirical probe (i686-w64-mingw32-gcc 13) confirms structs
    //   sized 12 / 16 / 24 / 64 / 80 take this path; size 8 returns
    //   in EAX:EDX register pair without rewriting.
    //
    //   SysV / AAPCS64: by-value as today, no rewriting.
    if use_win64_abi(st):
        let abi_params: String = win64_rewrite_decl_params(params)
        let mut abi_ret: String = ret
        let mut prefix_args: String = ""
        if is_large_aggregate(ret):
            abi_ret = "void"
            prefix_args = "ptr sret(" + ret + ")"
            ret_prefix = ""
        let mut combined: String = abi_params
        if len(prefix_args) > 0:
            combined = prefix_args
            if len(abi_params) > 0:
                combined = prefix_args + ", " + abi_params
        let line_w: String = "declare " + ret_prefix + abi_ret + " @" + name + "(" + combined + ")" + suffix
        return emit_line(st, line_w)
    if use_i686_abi(st):
        let abi_params_i: String = i686_rewrite_decl_params(params)
        let mut abi_ret_i: String = ret
        let mut prefix_args_i: String = ""
        if is_large_aggregate(ret):
            abi_ret_i = "void"
            prefix_args_i = "ptr sret(" + ret + ") align 8"
            ret_prefix = ""
        let mut combined_i: String = abi_params_i
        if len(prefix_args_i) > 0:
            combined_i = prefix_args_i
            if len(abi_params_i) > 0:
                combined_i = prefix_args_i + ", " + abi_params_i
        let line_i: String = "declare " + ret_prefix + abi_ret_i + " @" + name + "(" + combined_i + ")" + suffix
        return emit_line(st, line_i)
    // v5.8.8 Da.1: SysV / AAPCS64 default — > 16 B aggregate returns
    // must use sret. SysV's "memory class" rule (AMD64 §3.2.3) and
    // AAPCS64's x8 indirect-result rule both lower a 40-byte struct
    // return via a hidden first-arg pointer. LLVM's x86_64 backend
    // *silently* rewrites first-class aggregate returns to sret-style
    // memory return, so the old `declare {ptr, i64, ...} @fn()` shape
    // worked on Linux by accident; LLVM's arm64 backend does not have
    // an equivalent rewrite, so the same IR miscompiles on Apple
    // Silicon. Emitting the canonical sret form on both targets
    // matches what clang produces from C and produces equivalent
    // machine code via either backend. See
    // docs/roadmap/v5/v5.8.7/PHASE_0_FINDINGS.md.
    let ret_size: Int = llvm_type_size(ret)
    if is_large_aggregate(ret) && ret_size > 16:
        let abi_ret_d: String = "void"
        let prefix_d: String = "ptr sret(" + ret + ") align 8"
        let mut combined_d: String = prefix_d
        if len(params) > 0:
            combined_d = prefix_d + ", " + params
        let line_d: String = "declare " + abi_ret_d + " @" + name + "(" + combined_d + ")" + suffix
        return emit_line(st, line_d)
    let line: String = "declare " + ret_prefix + ret + " @" + name + "(" + params + ")" + suffix
    return emit_line(st, line)

// v5.8.4 Wb.2: rewrites a comma-separated declaration param list for
// the Win64 ABI. Aggregate-by-value param types > 8 bytes (e.g.
// "{ptr, i64}", "{ptr, i64, i64, i64, i64}") become "ptr"; scalar
// params are unchanged. The runtime fn declarations are well-formed
// and known — their param strings are constant string literals built
// out of the llvm_string()/llvm_list_rt() helpers. We do textual
// rewrites on those exact known forms (rather than a general parser)
// because the brace-depth tracker has a Mapanare-side build-time bug
// that produced corrupted strings on this codepath. Listing the
// concrete prefixes is bounded and enumerable.
fn win64_rewrite_decl_params(params: String) -> String:
    let mut out: String = params
    // Replace each occurrence of an aggregate-by-value type with `ptr`.
    // Order matters — replace the longest first so substrings don't
    // partially match.
    out = replace_all_str(out, "{ptr, i64, i64, i64, i64}", "ptr")
    out = replace_all_str(out, "{ptr, i64, i64, i64}", "ptr")
    out = replace_all_str(out, "{ptr, i64, ptr, i64}", "ptr")
    out = replace_all_str(out, "{ptr, i64}", "ptr")
    out = replace_all_str(out, "{i64, i64}", "ptr")
    out = replace_all_str(out, "{i1, ptr}", "ptr")
    return out

// Simple non-overlapping string replacer: finds every occurrence of
// `needle` in `haystack` and replaces with `repl`. Pure Mapanare-side
// implementation — no runtime help needed.
fn replace_all_str(haystack: String, needle: String, repl: String) -> String:
    let nlen: Int = len(needle)
    if nlen == 0: return haystack
    let mut out: String = ""
    let mut start: Int = 0
    let hlen: Int = len(haystack)
    let mut i: Int = 0
    for _ in 0..10000:
        if i + nlen > hlen: break
        let candidate: String = haystack.substr(i, nlen)
        if candidate == needle:
            out = out + haystack.substr(start, i - start) + repl
            i = i + nlen
            start = i
        else:
            i = i + 1
    if start < hlen:
        out = out + haystack.substr(start, hlen - start)
    return out

// True iff `ty` is an aggregate value > 8 bytes — the Win64 threshold
// for sret/sarg lowering. Mirrors Python emit_llvm_text._is_large_struct.
fn is_large_aggregate(ty: String) -> Bool:
    if !ty.starts_with("{"): return false
    if !ty.ends_with("}"): return false
    return llvm_type_size(ty) > 8

// v5.8.6 We.1: ABI-mode dispatch helpers. Replace the v5.8.4 single
// `st.is_win64` boolean — that flag conflated "is Windows" with "use
// Win64 ABI rules" because its source `__mn_host_is_win64()` actually
// reads `_WIN32` (defined for both 32-bit and 64-bit Windows). Now
// the running compiler reads `__mn_host_is_windows()` +
// `__mn_host_arch_bits()` and these two helpers gate the three
// distinct ABI paths the emitter supports.
//
//   use_win64_abi(st) — Win64: aggregate args > 8 B alloca'd to ptr
//   (sarg pattern); aggregate returns > 8 B use sret void prefix.
//
//   use_i686_abi(st) — i686 cdecl: aggregate args > 8 B alloca'd
//   then passed as `ptr byval(<orig>) align 4`; aggregate returns
//   > 8 B use the same sret void prefix as Win64. Stack alignment
//   on i686 is 4 B (vs Win64's 16 B), so alloca + byval both use
//   align 4 to match clang's i686-w64-windows-gnu emission.
//
//   Default (neither): SysV / AAPCS64 — pass and return aggregates
//   by value as today.
fn use_win64_abi(st: EmitState) -> Bool:
    if !st.is_windows: return false
    if st.win_arch != 64: return false
    return true

fn use_i686_abi(st: EmitState) -> Bool:
    if !st.is_windows: return false
    if st.win_arch != 32: return false
    return true

// v5.8.6 We.1: rewrites a comma-separated declaration param list for
// the i686 cdecl ABI. Aggregate-by-value param types > 8 bytes get
// the `byval` attribute decoration so LLVM's i686 backend lowers
// them as stack-pushed-by-value (matching gcc/clang's C ABI for
// MnString-shaped runtime fns). Caller pushes the entire struct on
// the stack; callee reads from positive %ebp offsets. Mirrors clang
// --target=i686-w64-windows-gnu emission for `void f(MnString s)`.
fn i686_rewrite_decl_params(params: String) -> String:
    let mut out: String = params
    // Order matters — replace the longest first so substrings don't
    // partially match. Each aggregate-by-value type gets the
    // `ptr byval(<orig>) align 4` decoration.
    out = replace_all_str(out, "{ptr, i64, i64, i64, i64}", "ptr byval({ptr, i64, i64, i64, i64}) align 4")
    out = replace_all_str(out, "{ptr, i64, i64, i64}", "ptr byval({ptr, i64, i64, i64}) align 4")
    out = replace_all_str(out, "{ptr, i64, ptr, i64}", "ptr byval({ptr, i64, ptr, i64}) align 4")
    out = replace_all_str(out, "{ptr, i64}", "ptr byval({ptr, i64}) align 4")
    out = replace_all_str(out, "{i64, i64}", "ptr byval({i64, i64}) align 4")
    out = replace_all_str(out, "{i1, ptr}", "ptr byval({i1, ptr}) align 4")
    return out

// v5.8.6 We.1: like win64_sarg_rewrite_args but emits the byval-
// decorated form. Win64 expects callers to push a *pointer* to the
// caller-allocated struct; i686 cdecl expects callers to push the
// *struct contents* on the stack. The IR-level difference is the
// `byval(<agg_ty>) align 4` decoration on the pointer pass — LLVM's
// i686 backend reads this and generates the stack-push lowering.
// Pre-conditions identical to win64_sarg_rewrite_args; caller MUST
// follow with i686_sarg_advance_state on the same args_text + agg_ty
// to keep counter / alloca / store emission in sync.
fn i686_sarg_rewrite_args(args_text: String, agg_ty: String, st: EmitState) -> String:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0: return args_text
    let h_len: Int = len(args_text)
    if h_len == 0: return args_text
    let mut out: String = ""
    let mut start: Int = 0
    let mut i: Int = 0
    let mut sarg_n: Int = st.counter
    for _ in 0..1000:
        if i + aty_len > h_len: break
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            let mut j: Int = i + aty_len
            if j < h_len && args_text.substr(j, 1) == " ": j = j + 1
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len: break
                let c: String = args_text.substr(k, 1)
                if c == ",": break
                k = k + 1
            out = out + args_text.substr(start, i - start)
            out = out + "ptr byval(" + agg_ty + ") align 4 %sarg." + toString(sarg_n)
            sarg_n = sarg_n + 1
            i = k
            start = k
        else:
            i = i + 1
    if start < h_len:
        out = out + args_text.substr(start, h_len - start)
    return out

// v5.8.6 We.1: emits the alloca + store sarg-prelude lines for each
// occurrence of `agg_ty` in `args_text` for i686 cdecl. Mechanically
// identical to win64_sarg_advance_state except `align 4` on the
// alloca — i686's stack pointer alignment is 4 B, and clang's
// i686-w64-windows-gnu emission uses align 4 for stack-pushed
// aggregates regardless of contained field types (i64s included).
// Bumps `st.counter` once per occurrence; counter values must match
// those consumed by i686_sarg_rewrite_args on the same input.
fn i686_sarg_advance_state(st: EmitState, args_text: String, agg_ty: String) -> EmitState:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0: return st
    let h_len: Int = len(args_text)
    if h_len == 0: return st
    let mut s: EmitState = st
    let mut i: Int = 0
    for _ in 0..1000:
        if i + aty_len > h_len: break
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            let mut j: Int = i + aty_len
            if j < h_len && args_text.substr(j, 1) == " ": j = j + 1
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len: break
                let c: String = args_text.substr(k, 1)
                if c == ",": break
                k = k + 1
            let aval: String = ws_trim(args_text.substr(j, k - j))
            let sarg_n: Int = s.counter
            s.counter = s.counter + 1
            let slot: String = "%sarg." + toString(sarg_n)
            s = emit_line(s, "  " + slot + " = alloca " + agg_ty + ", align 4")
            s = emit_line(s, "  store " + agg_ty + " " + aval + ", ptr " + slot)
            i = k
        else:
            i = i + 1
    return s

// Manual whitespace trimming. The self-hosted lowerer doesn't yet
// translate `.trim()` method calls to `__mn_str_trim` runtime fn, so
// our helpers spell trimming out manually rather than rely on the
// String method.
fn ws_trim(s: String) -> String:
    let n: Int = len(s)
    if n == 0: return s
    let mut start: Int = 0
    for _ in 0..10000:
        if start >= n: break
        let c0: String = s.substr(start, 1)
        if c0 != " " && c0 != "\t": break
        start = start + 1
    let mut end: Int = n
    for _ in 0..10000:
        if end <= start: break
        let c1: String = s.substr(end - 1, 1)
        if c1 != " " && c1 != "\t": break
        end = end - 1
    if start == 0 && end == n: return s
    return s.substr(start, end - start)

// v5.8.4 Wb.2: emit a runtime function call with target-aware ABI
// handling. On non-Win64, identical to
//   emit_line(st, emit_call_ir(dn, ret_ty, fn_name, args_text)).
// On Win64, aggregate-by-value args > 8 bytes are rewritten to sarg
// (alloca + store + ptr) and aggregate returns > 8 bytes use sret
// (alloca + call void with hidden ptr + load). Mirrors Python
// emit_llvm_text._rt at line 1502.
//
// Args text format (caller-built):
//   "i64 5"
//   "{ptr, i64} %x, i64 5"
//   "{ptr, i64} %x, {ptr, i64} %y"
//   etc.
// We rewrite aggregate args in two passes:
//   1) For each known aggregate type literal that appears, generate
//      sarg alloca/store entries (one per occurrence), then
//   2) Replace the textual occurrence with "ptr %sarg.N".
fn emit_rt_call(st: EmitState, dn: String, ret_ty: String, fn_name: String, args_text: String) -> EmitState:
    if use_win64_abi(st):
        let mut s: EmitState = st
        let mut new_args: String = args_text
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, i64, i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, i64, i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i1, ptr}", s)
        s = win64_sarg_advance_state(s, args_text, "{i1, ptr}")
        if is_large_aggregate(ret_ty):
            let sret_n: Int = s.counter
            s.counter = s.counter + 1
            let sret_slot: String = "%sret." + toString(sret_n)
            s = emit_line(s, "  " + sret_slot + " = alloca " + ret_ty + ", align 8")
            let sret_arg: String = "ptr sret(" + ret_ty + ") " + sret_slot
            let mut combined: String = sret_arg
            if len(new_args) > 0:
                combined = sret_arg + ", " + new_args
            s = emit_line(s, "  call void @" + fn_name + "(" + combined + ")")
            s = emit_line(s, "  " + dn + " = load " + ret_ty + ", ptr " + sret_slot)
            return s
        return emit_line(s, emit_call_ir(dn, ret_ty, fn_name, new_args))
    if use_i686_abi(st):
        let mut s2: EmitState = st
        let mut new_args2: String = args_text
        // v5.8.6 We.1: same enumeration order as Win64 — replace
        // longest aggregate strings first to avoid substring overlap.
        // i686 emits `ptr byval(<orig>) align 4 %sarg.N` instead of
        // bare `ptr %sarg.N`, but the alloca + store + counter
        // mechanics are identical. align 4 on the alloca matches
        // i686 stack-alignment conventions and clang's i686 emission.
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, i64, i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, i64, i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i1, ptr}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i1, ptr}")
        if is_large_aggregate(ret_ty):
            let sret_n2: Int = s2.counter
            s2.counter = s2.counter + 1
            let sret_slot2: String = "%sret." + toString(sret_n2)
            s2 = emit_line(s2, "  " + sret_slot2 + " = alloca " + ret_ty + ", align 8")
            let sret_arg2: String = "ptr sret(" + ret_ty + ") align 8 " + sret_slot2
            let mut combined2: String = sret_arg2
            if len(new_args2) > 0:
                combined2 = sret_arg2 + ", " + new_args2
            s2 = emit_line(s2, "  call void @" + fn_name + "(" + combined2 + ")")
            s2 = emit_line(s2, "  " + dn + " = load " + ret_ty + ", ptr " + sret_slot2)
            return s2
        return emit_line(s2, emit_call_ir(dn, ret_ty, fn_name, new_args2))
    // v5.8.8 Da.1: SysV / AAPCS64 default — sret call shape for
    // > 16 B aggregate returns. Mirrors declare_runtime_fn's default
    // sret declaration. Caller alloca + sret call + load.
    let ret_sz_d: Int = llvm_type_size(ret_ty)
    if is_large_aggregate(ret_ty) && ret_sz_d > 16:
        let mut s_d: EmitState = st
        let sret_n_d: Int = s_d.counter
        s_d.counter = s_d.counter + 1
        let sret_slot_d: String = "%sret." + toString(sret_n_d)
        s_d = emit_line(s_d, "  " + sret_slot_d + " = alloca " + ret_ty + ", align 8")
        let sret_arg_d: String = "ptr sret(" + ret_ty + ") align 8 " + sret_slot_d
        let mut combined_d: String = sret_arg_d
        if len(args_text) > 0:
            combined_d = sret_arg_d + ", " + args_text
        s_d = emit_line(s_d, "  call void @" + fn_name + "(" + combined_d + ")")
        s_d = emit_line(s_d, "  " + dn + " = load " + ret_ty + ", ptr " + sret_slot_d)
        return s_d
    return emit_line(st, emit_call_ir(dn, ret_ty, fn_name, args_text))

// v5.8.4 Wb.2 + v5.8.6 We.1: void variant — same arg-rewrite logic,
// no return value to load. Ret is implicitly "void". 3-way dispatch
// parallels emit_rt_call.
fn emit_rt_call_void(st: EmitState, fn_name: String, args_text: String) -> EmitState:
    if use_win64_abi(st):
        let mut s: EmitState = st
        let mut new_args: String = args_text
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, i64, i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, i64, i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64, ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64, ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{ptr, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{ptr, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i64, i64}", s)
        s = win64_sarg_advance_state(s, args_text, "{i64, i64}")
        new_args = win64_sarg_rewrite_args(new_args, "{i1, ptr}", s)
        s = win64_sarg_advance_state(s, args_text, "{i1, ptr}")
        return emit_line(s, emit_call_void(fn_name, new_args))
    if use_i686_abi(st):
        let mut s2: EmitState = st
        let mut new_args2: String = args_text
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, i64, i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, i64, i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64, ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64, ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{ptr, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{ptr, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i64, i64}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i64, i64}")
        new_args2 = i686_sarg_rewrite_args(new_args2, "{i1, ptr}", s2)
        s2 = i686_sarg_advance_state(s2, args_text, "{i1, ptr}")
        return emit_line(s2, emit_call_void(fn_name, new_args2))
    return emit_line(st, emit_call_void(fn_name, args_text))

// Helper: scans `args_text` for occurrences of `agg_ty` followed by
// " <value>". For each, replaces the pair with "ptr %sarg.N" using
// fresh counters from `st.counter`. Returns rewritten text.
//
// Caveat: this function does NOT mutate `st` — it must NOT be called
// in isolation. The caller MUST follow with win64_sarg_advance_state
// using the same args_text and agg_ty so subsequent counters / emits
// stay consistent. We split the work this way because Mapanare's
// build-time emitter has trouble with mutual return-position passing
// of a struct + string from a single helper (binary corruption seen
// in a more general parser). The two-helper pattern uses only string
// concatenation and integer arithmetic which is well-tested.
fn win64_sarg_rewrite_args(args_text: String, agg_ty: String, st: EmitState) -> String:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0: return args_text
    let h_len: Int = len(args_text)
    if h_len == 0: return args_text
    let mut out: String = ""
    let mut start: Int = 0
    let mut i: Int = 0
    let mut sarg_n: Int = st.counter
    for _ in 0..1000:
        if i + aty_len > h_len: break
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            // After the type, expect " <value>" where <value> ends at
            // ',' or end-of-string.
            let mut j: Int = i + aty_len
            // Skip the leading space (LLVM IR convention "{ty} %v").
            if j < h_len && args_text.substr(j, 1) == " ": j = j + 1
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len: break
                let c: String = args_text.substr(k, 1)
                if c == ",": break
                k = k + 1
            // Append [start, i), then "ptr %sarg.N", then advance.
            out = out + args_text.substr(start, i - start)
            out = out + "ptr %sarg." + toString(sarg_n)
            sarg_n = sarg_n + 1
            i = k
            start = k
        else:
            i = i + 1
    if start < h_len:
        out = out + args_text.substr(start, h_len - start)
    return out

// Helper: emits the alloca + store sarg-prelude lines for each
// occurrence of `agg_ty` in `args_text`, mirroring the rewrite done
// by win64_sarg_rewrite_args. Bumps `st.counter` once per occurrence.
fn win64_sarg_advance_state(st: EmitState, args_text: String, agg_ty: String) -> EmitState:
    let aty_len: Int = len(agg_ty)
    if aty_len == 0: return st
    let h_len: Int = len(args_text)
    if h_len == 0: return st
    let mut s: EmitState = st
    let mut i: Int = 0
    for _ in 0..1000:
        if i + aty_len > h_len: break
        let head: String = args_text.substr(i, aty_len)
        if head == agg_ty:
            // Extract the value name immediately following.
            let mut j: Int = i + aty_len
            if j < h_len && args_text.substr(j, 1) == " ": j = j + 1
            let mut k: Int = j
            for _ in 0..1000:
                if k >= h_len: break
                let c: String = args_text.substr(k, 1)
                if c == ",": break
                k = k + 1
            let aval: String = ws_trim(args_text.substr(j, k - j))
            let sarg_n: Int = s.counter
            s.counter = s.counter + 1
            let slot: String = "%sarg." + toString(sarg_n)
            s = emit_line(s, "  " + slot + " = alloca " + agg_ty + ", align 8")
            s = emit_line(s, "  store " + agg_ty + " " + aval + ", ptr " + slot)
            i = k
        else:
            i = i + 1
    return s

// Return-value attribute prefix. Only ``noalias`` qualifies, and only
// for allocator functions that return a freshly-heap-allocated pointer
// the caller did not previously hold. LLVM rejects ``noalias`` on any
// non-pointer return type; the caller (``declare_runtime_fn``) guards
// this with ``if ret == "ptr"`` before invoking us.
fn get_fn_ret_prefix(name: String) -> String:
    if name == "malloc": return "noalias "
    if name == "__mn_alloc": return "noalias "
    if name == "__mn_map_new": return "noalias "
    if name == "__mn_signal_new": return "noalias "
    if name == "mapanare_agent_new": return "noalias "
    if name == "mn_arena_create": return "noalias "
    if name == "mn_arena_alloc": return "noalias "
    if name == "__mapanare_tensor_alloc": return "noalias "
    if name == "__mapanare_tensor_add": return "noalias "
    if name == "__mapanare_tensor_sub": return "noalias "
    if name == "__mapanare_tensor_mul": return "noalias "
    if name == "__mapanare_tensor_div": return "noalias "
    if name == "__mapanare_matmul": return "noalias "
    // v5.6.2 Sh.6 Phase 3 — broadcast / scalar / reverse-scalar binops
    // return a fresh heap-allocated tensor pointer (noalias).
    if name == "__mn_tensor_add_broadcast_f64": return "noalias "
    if name == "__mn_tensor_sub_broadcast_f64": return "noalias "
    if name == "__mn_tensor_mul_broadcast_f64": return "noalias "
    if name == "__mn_tensor_div_broadcast_f64": return "noalias "
    if name == "__mn_tensor_add_broadcast_i64": return "noalias "
    if name == "__mn_tensor_sub_broadcast_i64": return "noalias "
    if name == "__mn_tensor_mul_broadcast_i64": return "noalias "
    if name == "__mn_tensor_div_broadcast_i64": return "noalias "
    if name == "__mn_tensor_add_scalar_f64": return "noalias "
    if name == "__mn_tensor_sub_scalar_f64": return "noalias "
    if name == "__mn_tensor_mul_scalar_f64": return "noalias "
    if name == "__mn_tensor_div_scalar_f64": return "noalias "
    if name == "__mn_tensor_add_scalar_i64": return "noalias "
    if name == "__mn_tensor_sub_scalar_i64": return "noalias "
    if name == "__mn_tensor_mul_scalar_i64": return "noalias "
    if name == "__mn_tensor_div_scalar_i64": return "noalias "
    if name == "__mn_tensor_rsub_scalar_f64": return "noalias "
    if name == "__mn_tensor_rdiv_scalar_f64": return "noalias "
    if name == "__mn_tensor_rsub_scalar_i64": return "noalias "
    if name == "__mn_tensor_rdiv_scalar_i64": return "noalias "
    // v5.6.3 Sh.6 Phase 4 — slice returns a fresh heap tensor (noalias).
    if name == "__mn_tensor_slice": return "noalias "
    // v5.45.0 Ts.2.B — __mn_tensor_reshape semantic swap to alias.
    // The noalias attribute would be a lie under aliasing semantics
    // (writes to result visible in source). __mn_tensor_view is the
    // alias-flavor sibling shipped at v5.45.0. __mn_tensor_step_slice
    // returns a fresh contiguous tensor (copy semantics) — no noalias
    // for v5.45.0 conservatively (consistent with the rest of the
    // tensor-producing surface).
    return ""

// Function-attribute suffix. Mirrors the Python `_RUNTIME_FN_ATTRS`
// table, excluding `noalias` (which is a return-value attribute handled
// by get_fn_ret_prefix). Entries that aren't declared by this emitter
// (e.g. DB / HTML / crypto-str variants used only by the Python
// bootstrap) are included for consistency — unreachable declare calls
// won't fire the branches, and the cost of an unused branch is ~0.
fn get_fn_attrs(name: String) -> String:
    // -- Read-only string/collection queries --
    if name == "__mn_str_len": return " nounwind readonly willreturn"
    if name == "__mn_str_eq": return " nounwind readonly willreturn"
    if name == "__mn_str_cmp": return " nounwind readonly willreturn"
    if name == "__mn_str_hash": return " nounwind readonly willreturn"
    if name == "__mn_str_byte_at": return " nounwind readonly willreturn"
    if name == "__mn_str_starts_with": return " nounwind readonly willreturn"
    if name == "__mn_str_ends_with": return " nounwind readonly willreturn"
    if name == "__mn_str_find": return " nounwind readonly willreturn"
    if name == "__mn_str_contains": return " nounwind readonly willreturn"
    if name == "__mn_str_to_int": return " nounwind readonly willreturn"
    if name == "__mn_str_to_float": return " nounwind readonly willreturn"
    if name == "__mn_str_ord": return " nounwind readonly willreturn"
    if name == "__mn_list_len": return " nounwind readonly willreturn"
    if name == "__mn_list_get": return " nounwind readonly willreturn"
    if name == "__mn_map_len": return " nounwind readonly willreturn"
    if name == "__mn_map_contains": return " nounwind readonly willreturn"
    if name == "__mn_range": return " nounwind readonly willreturn"
    // -- Allocators (noalias in prefix; suffix = nounwind willreturn) --
    if name == "malloc": return " nounwind willreturn"
    if name == "__mn_alloc": return " nounwind willreturn"
    if name == "__mn_str_concat": return " nounwind willreturn"
    if name == "__mn_str_from_int": return " nounwind willreturn"
    if name == "__mn_str_from_float": return " nounwind willreturn"
    if name == "__mn_str_from_bool": return " nounwind willreturn"
    if name == "__mn_str_substr": return " nounwind willreturn"
    if name == "__mn_str_chr": return " nounwind willreturn"
    if name == "__mn_str_to_upper": return " nounwind willreturn"
    if name == "__mn_str_to_lower": return " nounwind willreturn"
    if name == "__mn_str_replace": return " nounwind willreturn"
    if name == "__mn_str_split": return " nounwind willreturn"
    if name == "__mn_str_trim": return " nounwind willreturn"
    if name == "__mn_str_join": return " nounwind willreturn"
    if name == "__mn_list_new": return " nounwind willreturn"
    if name == "__mn_list_concat": return " nounwind willreturn"
    if name == "__mn_map_new": return " nounwind willreturn"
    if name == "__mn_map_keys": return " nounwind willreturn"
    if name == "__mn_signal_new": return " nounwind willreturn"
    if name == "mapanare_agent_new": return " nounwind willreturn"
    if name == "mn_arena_create": return " nounwind willreturn"
    if name == "mn_arena_alloc": return " nounwind willreturn"
    // -- Cleanup / free (willreturn, no readonly — frees memory) --
    if name == "free": return " nounwind willreturn"
    if name == "__mn_str_free": return " nounwind willreturn"
    if name == "__mn_list_free": return " nounwind willreturn"
    if name == "__mn_map_free": return " nounwind willreturn"
    if name == "__mn_map_free_deep": return " nounwind willreturn"
    if name == "__mn_stream_free": return " nounwind willreturn"
    if name == "__mn_stream_free_chain": return " nounwind willreturn"
    if name == "__mn_range_free": return " nounwind willreturn"
    if name == "__mn_signal_free": return " nounwind willreturn"
    if name == "mn_arena_destroy": return " nounwind willreturn"
    if name == "__mapanare_tensor_free": return " nounwind willreturn"
    // -- Mutation (nounwind only — writes through caller-owned memory) --
    if name == "__mn_list_push": return " nounwind"
    if name == "__mn_list_set": return " nounwind"
    if name == "__mn_map_set": return " nounwind"
    if name == "__mn_map_get": return " nounwind"
    // -- Print / I/O writes (observable but terminate) --
    if name == "__mn_print": return " nounwind willreturn"
    if name == "__mn_println": return " nounwind willreturn"
    if name == "__mn_str_print": return " nounwind willreturn"
    if name == "__mn_str_println": return " nounwind willreturn"
    if name == "__mn_str_eprint": return " nounwind willreturn"
    if name == "__mn_indent_to_braces": return " nounwind willreturn"
    if name == "__mn_rewrite_arm_stmt_shorthand": return " nounwind willreturn"
    if name == "__mn_count_user_brace_block_openers": return " nounwind willreturn"
    if name == "__mn_emit_brace_deprecation_warning": return " nounwind willreturn"
    if name == "__mn_str_eprintln": return " nounwind willreturn"
    // -- I/O (v3.41.0) --
    if name == "__mn_read_line": return " nounwind willreturn"
    if name == "__mn_file_append": return " nounwind willreturn"
    if name == "__mn_dir_list_strings": return " nounwind willreturn"
    if name == "__mn_file_exists": return " nounwind readonly willreturn"
    if name == "__mn_file_remove": return " nounwind willreturn"
    if name == "__mn_file_size": return " nounwind readonly willreturn"
    if name == "__mn_file_mtime": return " nounwind readonly willreturn"
    if name == "__mn_dir_create": return " nounwind willreturn"
    if name == "__mn_dir_remove": return " nounwind willreturn"
    if name == "__mn_file_rename": return " nounwind willreturn"
    if name == "__mn_file_copy": return " nounwind willreturn"
    if name == "__mn_realpath": return " nounwind willreturn"
    if name == "__mn_tmpfile_path": return " nounwind willreturn"
    // -- Network / crypto / regex (v3.42.0) --
    if name == "__mn_http_get": return " nounwind willreturn"
    if name == "__mn_sha256_str": return " nounwind willreturn"
    if name == "__mn_base64_encode_str": return " nounwind willreturn"
    if name == "__mn_base64_decode_str": return " nounwind willreturn"
    if name == "__mn_hmac_sha256_str": return " nounwind willreturn"
    if name == "__mn_hex_encode_str": return " nounwind willreturn"
    if name == "__mn_random_bytes_str": return " nounwind willreturn"
    if name == "__mn_regex_compile_str": return " nounwind willreturn"
    if name == "__mn_regex_exec_str": return " nounwind willreturn"
    if name == "__mn_regex_replace_str": return " nounwind willreturn"
    if name == "__mn_regex_free": return " nounwind willreturn"
    // -- GPU (v3.46.0) --
    if name == "__mn_gpu_available": return " nounwind readonly willreturn"
    if name == "__mn_gpu_device_name": return " nounwind willreturn"
    if name == "__mn_gpu_device_memory": return " nounwind readonly willreturn"
    if name == "__mn_gpu_tensor_add": return " nounwind willreturn"
    if name == "__mn_gpu_tensor_sub": return " nounwind willreturn"
    if name == "__mn_gpu_tensor_mul": return " nounwind willreturn"
    if name == "__mn_gpu_tensor_div": return " nounwind willreturn"
    if name == "__mn_gpu_tensor_matmul": return " nounwind willreturn"
    // -- Tensor runtime --
    if name == "__mapanare_tensor_add": return " nounwind willreturn"
    if name == "__mapanare_tensor_sub": return " nounwind willreturn"
    if name == "__mapanare_tensor_mul": return " nounwind willreturn"
    if name == "__mapanare_tensor_div": return " nounwind willreturn"
    if name == "__mapanare_matmul": return " nounwind willreturn"
    if name == "__mapanare_tensor_alloc": return " nounwind willreturn"
    if name == "__mapanare_tensor_shape_eq": return " nounwind readonly willreturn"
    // v5.6.0 Sh.6 __mn_tensor_* attrs (mirrors emit_llvm_text.py RUNTIME_ATTRS).
    if name == "__mn_tensor_alloc": return " nounwind willreturn"
    if name == "__mn_tensor_free": return " nounwind willreturn"
    if name == "__mn_tensor_store_f64": return " nounwind willreturn"
    if name == "__mn_tensor_store_i64": return " nounwind willreturn"
    if name == "__mn_tensor_get_f64": return " nounwind readonly willreturn"
    if name == "__mn_tensor_get_i64": return " nounwind readonly willreturn"
    if name == "__mn_tensor_rank": return " nounwind readonly willreturn"
    if name == "__mn_tensor_size": return " nounwind readonly willreturn"
    if name == "__mn_tensor_shape_dim": return " nounwind readonly willreturn"
    if name == "__mn_tensor_print_f64": return " nounwind willreturn"
    // v5.6.1 Sh.6 Phase 2 — variadic nd getters/setters; nounwind only,
    // no `readonly` because LLVM varargs intrinsics are conservative.
    if name == "__mn_tensor_get_f64_nd": return " nounwind"
    if name == "__mn_tensor_get_i64_nd": return " nounwind"
    if name == "__mn_tensor_set_f64_nd": return " nounwind"
    if name == "__mn_tensor_set_i64_nd": return " nounwind"
    // v5.6.2 Sh.6 Phase 3 — broadcast / scalar / reverse-scalar binops
    // (mirrors emit_llvm_text.py:357-377). `noalias` is emitted as a
    // return-value prefix by get_fn_ret_prefix; the fn-attr suffix is
    // just `nounwind`.
    if name == "__mn_tensor_add_broadcast_f64": return " nounwind"
    if name == "__mn_tensor_sub_broadcast_f64": return " nounwind"
    if name == "__mn_tensor_mul_broadcast_f64": return " nounwind"
    if name == "__mn_tensor_div_broadcast_f64": return " nounwind"
    if name == "__mn_tensor_add_broadcast_i64": return " nounwind"
    if name == "__mn_tensor_sub_broadcast_i64": return " nounwind"
    if name == "__mn_tensor_mul_broadcast_i64": return " nounwind"
    if name == "__mn_tensor_div_broadcast_i64": return " nounwind"
    if name == "__mn_tensor_add_scalar_f64": return " nounwind"
    if name == "__mn_tensor_sub_scalar_f64": return " nounwind"
    if name == "__mn_tensor_mul_scalar_f64": return " nounwind"
    if name == "__mn_tensor_div_scalar_f64": return " nounwind"
    if name == "__mn_tensor_add_scalar_i64": return " nounwind"
    if name == "__mn_tensor_sub_scalar_i64": return " nounwind"
    if name == "__mn_tensor_mul_scalar_i64": return " nounwind"
    if name == "__mn_tensor_div_scalar_i64": return " nounwind"
    if name == "__mn_tensor_rsub_scalar_f64": return " nounwind"
    if name == "__mn_tensor_rdiv_scalar_f64": return " nounwind"
    if name == "__mn_tensor_rsub_scalar_i64": return " nounwind"
    if name == "__mn_tensor_rdiv_scalar_i64": return " nounwind"
    // v5.6.3 Sh.6 Phase 4 — reductions are readonly (pure over tensor data);
    // slice returns a new tensor (nounwind + noalias via ret prefix).
    if name == "__mn_tensor_sum_f64": return " nounwind readonly"
    if name == "__mn_tensor_mean_f64": return " nounwind readonly"
    if name == "__mn_tensor_max_f64": return " nounwind readonly"
    if name == "__mn_tensor_min_f64": return " nounwind readonly"
    if name == "__mn_tensor_argmax_f64": return " nounwind readonly"
    if name == "__mn_tensor_argmin_f64": return " nounwind readonly"
    if name == "__mn_tensor_sum_i64": return " nounwind readonly"
    if name == "__mn_tensor_max_i64": return " nounwind readonly"
    if name == "__mn_tensor_min_i64": return " nounwind readonly"
    if name == "__mn_tensor_argmax_i64": return " nounwind readonly"
    if name == "__mn_tensor_argmin_i64": return " nounwind readonly"
    if name == "__mn_tensor_slice": return " nounwind"
    if name == "__mn_tensor_reshape": return " nounwind"
    // v5.45.0 Ts.2.B / Ts.3.B — view + step_slice exports.
    if name == "__mn_tensor_view": return " nounwind"
    if name == "__mn_tensor_step_slice": return " nounwind"
    // -- Agent runtime (v3.43.0) --
    if name == "mapanare_agent_spawn": return " nounwind willreturn"
    if name == "mapanare_agent_send": return " nounwind willreturn"
    if name == "mapanare_agent_recv_blocking": return " nounwind"
    if name == "mapanare_agent_stop": return " nounwind willreturn"
    if name == "mapanare_agent_destroy": return " nounwind willreturn"
    if name == "__mn_agent_spawn": return " nounwind willreturn"
    if name == "__mn_agent_send": return " nounwind willreturn"
    if name == "__mn_agent_sync": return " nounwind willreturn"
    // -- Signal runtime --
    if name == "__mn_signal_get": return " nounwind"
    if name == "__mn_signal_set": return " nounwind willreturn"
    // -- Iterator --
    if name == "__iter_has_next": return " nounwind readonly willreturn"
    if name == "__iter_next": return " nounwind"
    // v5.1.0 Perf.1: inline list access emits bounds-check trap via abort()
    if name == "abort": return " noreturn nounwind"
    return ""

fn declare_all_runtime(st: EmitState) -> EmitState:
    let mut s: EmitState = st

    // String runtime
    s = declare_runtime_fn(s, "__mn_str_concat", llvm_string(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_eq", llvm_int(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_cmp", llvm_int(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_len", llvm_int(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_char_at", llvm_string(), llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_str_byte_at", llvm_int(), llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_str_substr", llvm_string(), llvm_string() + ", i64, i64")
    s = declare_runtime_fn(s, "__mn_str_from_int", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_str_from_bool", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_str_from_float", llvm_string(), "double")
    s = declare_runtime_fn(s, "__mn_str_to_int", llvm_int(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_to_float", llvm_float(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_println", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_print", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_starts_with", llvm_bool(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_ends_with", llvm_bool(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_find", llvm_int(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_join", llvm_string(), llvm_string() + ", ptr")

    // v5.4.1 Own.1 Phase 2 — drop-glue free entry points. Required by
    // emit_drop_glue_strings / _lists / _boxed once owner lists are
    // populated by emit_track_string / _boxed / _closure (see Phase
    // 3.x). __mn_str_free / __mn_list_free are heap-aware (skip
    // is_heap=0); free is the libc allocator the closure-env path
    // routes through.
    s = declare_runtime_fn(s, "__mn_str_free", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_list_free", "void", "ptr")
    s = declare_runtime_fn(s, "free", "void", "ptr")

    // List runtime
    s = declare_runtime_fn(s, "__mn_list_new", llvm_list_rt(), "i64")
    s = declare_runtime_fn(s, "__mn_list_push", "void", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_list_get", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_list_len", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_list_set", "void", "ptr, i64, ptr")
    s = declare_runtime_fn(s, "__mn_list_concat", llvm_list_rt(), "ptr, ptr")

    // Iterator runtime
    s = declare_runtime_fn(s, "__iter_has_next", llvm_bool(), "{i64, i64}")
    s = declare_runtime_fn(s, "__iter_next", llvm_int(), "{i64, i64}")
    s = declare_runtime_fn(s, "__mn_range", "{i64, i64}", "i64, i64")
    s = declare_runtime_fn(s, "__mn_range_free", "void", "ptr")

    // String methods
    s = declare_runtime_fn(s, "__mn_str_to_upper", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_to_lower", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_replace", llvm_string(), llvm_string() + ", " + llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_split", llvm_list_rt(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_str_trim", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_str_contains", llvm_bool(), llvm_string() + ", " + llvm_string())

    // v5.1.0 Perf.1: abort for inline list bounds-check trap
    s = declare_runtime_fn(s, "abort", "void", "")

    // Panic / process
    s = declare_runtime_fn(s, "__mn_panic", "void", llvm_string())
    // v5.13.1 At.2: assertion-failure runtime, called from the lowered
    // fail block of every `assert` statement (see lower_assert in
    // lower.mn). Pre-v5.13.1 the call was emitted but never declared,
    // so `mnc test` died at clang IR-parse with "use of undefined
    // value '@__mn_assert_fail'". Defined in runtime/native/mapanare_core.c.
    s = declare_runtime_fn(s, "__mn_assert_fail", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_exit", "void", "i64")
    s = declare_runtime_fn(s, "__mn_argc", "i64", "")
    s = declare_runtime_fn(s, "__mn_argv", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_file_read_or_empty", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_file_write", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_system", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_eprint", "void", llvm_string())
    s = declare_runtime_fn(s, "__mn_str_eprintln", "void", llvm_string())
    // v5.8.4 Wb.2: host-detect for ABI classifier OS-1 mechanism.
    // Kept declared so v5.8.5-vintage stage1 binaries and any
    // Mapanare-level code that calls __mn_host_is_win64 directly
    // continues to link.
    s = declare_runtime_fn(s, "__mn_host_is_win64", "i64", "")
    // v5.8.6 We.1: refined host detection — the (is_windows,
    // arch_bits) pair lets the emitter dispatch a 3-way ABI
    // (Win64 sret/sarg vs i686 cdecl sret/byval vs SysV by-value).
    s = declare_runtime_fn(s, "__mn_host_is_windows", "i64", "")
    s = declare_runtime_fn(s, "__mn_host_arch_bits", "i64", "")
    // v5.9.0 DX.2: build-time-baked version string. Replaces the
    // __MN_VERSION__ source-tree placeholder dance — the compiler now
    // calls this at runtime to embed its own version into both the
    // mnc-stage1 ``version()`` surface and the IR metadata node it
    // emits into compiled programs (see emit_metadata_node below).
    s = declare_runtime_fn(s, "__mn_version_string", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_indent_to_braces", llvm_string(), llvm_string())
    // v5.48.1 Te.3.D.4.4: match-arm statement-shorthand rewriter.
    // Wraps `Pat => return X` -> `Pat => { return X }` for stmt-keyword
    // arm bodies (return/da/break/sal/continue/sigue/pass). Runs after
    // __mn_indent_to_braces. Mirrors mapanare/parser.py::
    // _rewrite_arm_stmt_shorthand byte-for-byte; lives in the C runtime
    // for the same reason (bootstrap lower pathologies on a .mn port).
    s = declare_runtime_fn(s, "__mn_rewrite_arm_stmt_shorthand", llvm_string(), llvm_string())
    // v5.23.2 Te.3.B.2: brace-deprecation detector + warning emitter.
    // Counts user-written `{` block openers (excluding struct/map literals)
    // and emits a single stderr warning with `mnc fmt` migration hint.
    // Mirrors mapanare/parser.py::count_user_brace_block_openers and
    // ::_emit_brace_deprecation_warning byte-for-byte. Lives in C runtime
    // so the Python and native sides have a single source of truth (see
    // runtime/native/mapanare_core.c for the same C-routing rationale
    // as __mn_indent_to_braces).
    s = declare_runtime_fn(s, "__mn_count_user_brace_block_openers", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_emit_brace_deprecation_warning", "void", llvm_string() + ", i64")
    // v5.9.0 DX.4: native cache stats + dev-null redirect shim. Replaces
    // POSIX-only shell-outs (``find | wc -l``, ``du -sh``, ``rm -rf``,
    // ``2>/dev/null``) that fell through cmd.exe on Windows.
    s = declare_runtime_fn(s, "__mn_dev_null_redirect", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_dir_count_files", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_total_size", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_remove_recursive", "i64", llvm_string())
    // v5.9.0 DX.3: platform-portable temp path for clang stderr capture.
    s = declare_runtime_fn(s, "__mn_clang_err_path", llvm_string(), "")
    // v5.10.0 Win.1b.D: directory of the running binary. find_clang()
    // in main.mn calls this to locate a bundled LLVM toolchain at
    // <exe_dir>/llvm/clang(.exe) before falling back to PATH clang.
    s = declare_runtime_fn(s, "__mn_executable_dir", llvm_string(), "")

    // chr/ord
    s = declare_runtime_fn(s, "__mn_str_chr", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_str_ord", "i64", llvm_string())

    // Map runtime
    // v4.32.0 Phase 1.2: __mn_map_new takes (key_size, val_size, key_type, val_type)
    // — four i64 arguments. The runtime signature is at
    // runtime/native/mapanare_core.c:1561. Python bootstrap has always
    // passed four args; the self-hosted emitter was declaring three
    // (panel carry-forward, 7th cycle closed here).
    s = declare_runtime_fn(s, "__mn_map_new", "ptr", "i64, i64, i64, i64")
    s = declare_runtime_fn(s, "__mn_map_set", "void", "ptr, ptr, ptr")
    s = declare_runtime_fn(s, "__mn_map_get", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_map_len", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_map_contains", "i64", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_map_keys", llvm_list_rt(), "ptr")

    // Malloc (for enum payload allocation)
    s = declare_runtime_fn(s, "malloc", "ptr", "i64")

    // Printf
    s = declare_runtime_fn(s, "printf", "i32", "ptr, ...")

    // Tensor runtime
    s = declare_runtime_fn(s, "__mapanare_tensor_add", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_sub", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_mul", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_div", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_matmul", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_alloc", "ptr", "i64, i64*, i64")
    s = declare_runtime_fn(s, "__mapanare_tensor_free", "void", "ptr")
    s = declare_runtime_fn(s, "__mapanare_tensor_shape_eq", "i1", "ptr, ptr")
    s = declare_runtime_fn(s, "__mapanare_detect_gpus", "ptr", "")

    // v5.6.0 Sh.6: __mn_tensor_* — the full tensor-literal + builtin
    // runtime surface implemented in runtime/native/mapanare_gpu_builtins.c.
    // Mirrors the RUNTIME_ATTRS entries in mapanare/emit_llvm_text.py:
    // 337-398. Declared unconditionally; linker drops unused.
    s = declare_runtime_fn(s, "__mn_tensor_alloc", "ptr", "i64, ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_free", "void", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_store_f64", "void", "ptr, i64, double")
    s = declare_runtime_fn(s, "__mn_tensor_store_i64", "void", "ptr, i64, i64")
    s = declare_runtime_fn(s, "__mn_tensor_get_f64", "double", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_get_i64", "i64", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_rank", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_size", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_shape_dim", "i64", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_print_f64", "void", "ptr")

    // v5.6.1 Sh.6 Phase 2: variadic nd get/set for multi-dim indexing.
    // `...` at the tail of the params string emits as LLVM varargs; call
    // sites use the explicit function-type prefix form below.
    s = declare_runtime_fn(s, "__mn_tensor_get_f64_nd", "double", "ptr, i64, ...")
    s = declare_runtime_fn(s, "__mn_tensor_get_i64_nd", "i64", "ptr, i64, ...")
    s = declare_runtime_fn(s, "__mn_tensor_set_f64_nd", "void", "ptr, i64, ...")
    s = declare_runtime_fn(s, "__mn_tensor_set_i64_nd", "void", "ptr, i64, ...")

    // v5.6.2 Sh.6 Phase 3: broadcast / scalar / reverse-scalar binops.
    // Reverse-scalar fns take (scalar, tensor) — see emit_llvm_text.py:3781.
    s = declare_runtime_fn(s, "__mn_tensor_add_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_sub_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_mul_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_div_broadcast_f64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_add_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_sub_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_mul_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_div_broadcast_i64", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_add_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_sub_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_mul_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_div_scalar_f64", "ptr", "ptr, double")
    s = declare_runtime_fn(s, "__mn_tensor_add_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_sub_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_mul_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_div_scalar_i64", "ptr", "ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_rsub_scalar_f64", "ptr", "double, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_rdiv_scalar_f64", "ptr", "double, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_rsub_scalar_i64", "ptr", "i64, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_rdiv_scalar_i64", "ptr", "i64, ptr")

    // v5.6.3 Sh.6 Phase 4 — 6 reductions × 2 element types (- no mean_i64,
    // + 5 argmax/argmin always-i64 variants) = 11 runtime fns. All take a
    // single tensor ptr and return a scalar.
    s = declare_runtime_fn(s, "__mn_tensor_sum_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_mean_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_max_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_min_f64", "double", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmax_f64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmin_f64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_sum_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_max_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_min_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmax_i64", "i64", "ptr")
    s = declare_runtime_fn(s, "__mn_tensor_argmin_i64", "i64", "ptr")

    // v5.6.3 Sh.6 Phase 4 — tensor slice: runtime signature is
    // (ptr tensor, ptr starts, ptr ends, i64 rank). Self-hosted lowerer
    // passes flat args [tensor, s0..., e0..., rank]; emit_mir_call
    // repackages into stack allocated arrays before the call.
    s = declare_runtime_fn(s, "__mn_tensor_slice", "ptr", "ptr, ptr, ptr, i64")
    s = declare_runtime_fn(s, "__mn_tensor_reshape", "ptr", "ptr, ptr")
    // v5.45.0 Ts.2.B + Ts.3.B — view (aliasing) + step_slice (copy).
    s = declare_runtime_fn(s, "__mn_tensor_view", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_tensor_step_slice", "ptr", "ptr, ptr, ptr, ptr, i64")

    // Agent runtime
    s = declare_runtime_fn(s, "__mn_agent_spawn", "ptr", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_agent_send", "void", "ptr, ptr, ptr")
    s = declare_runtime_fn(s, "__mn_agent_sync", "ptr", "ptr, ptr")

    // Signal runtime
    s = declare_runtime_fn(s, "__mn_signal_new", "ptr", "ptr")
    s = declare_runtime_fn(s, "__mn_signal_get", "ptr", "ptr")
    s = declare_runtime_fn(s, "__mn_signal_set", "void", "ptr, ptr")

    // I/O builtins (v3.41.0)
    s = declare_runtime_fn(s, "__mn_read_line", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_file_append", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_file_exists", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_list_strings", llvm_list_rt(), llvm_string())
    // Network/crypto/regex builtins (v3.42.0)
    s = declare_runtime_fn(s, "__mn_http_get", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_sha256_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_base64_encode_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_base64_decode_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_hmac_sha256_str", llvm_string(), llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_hex_encode_str", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_random_bytes_str", llvm_string(), "i64")
    s = declare_runtime_fn(s, "__mn_regex_compile_str", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_regex_exec_str", "i64", "i64, " + llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_regex_replace_str", llvm_string(), "i64, " + llvm_string() + ", " + llvm_string() + ", i64")
    s = declare_runtime_fn(s, "__mn_regex_free", "i64", "i64")
    // Missing I/O builtins (v3.47.0)
    s = declare_runtime_fn(s, "__mn_file_remove", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_file_size", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_file_mtime", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_create", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_dir_remove", "i64", llvm_string())
    s = declare_runtime_fn(s, "__mn_file_rename", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_file_copy", "i64", llvm_string() + ", " + llvm_string())
    s = declare_runtime_fn(s, "__mn_realpath", llvm_string(), llvm_string())
    s = declare_runtime_fn(s, "__mn_tmpfile_path", llvm_string(), "")
    // GPU builtins (v3.46.0)
    s = declare_runtime_fn(s, "__mn_gpu_available", "i64", "")
    s = declare_runtime_fn(s, "__mn_gpu_device_name", llvm_string(), "")
    s = declare_runtime_fn(s, "__mn_gpu_device_memory", "i64", "")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_add", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_sub", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_mul", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_div", llvm_list_rt(), "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_gpu_tensor_matmul", llvm_list_rt(), "ptr, ptr, i64, i64, i64")

    // v5.5.2 Sh.4 Phase 3 — async runtime + LLVM coro intrinsics.
    // Mirrors Python bootstrap's emit_llvm_text.py:898–908 conditional
    // declaration block. We declare unconditionally here: the linker
    // drops unused declarations and IR-level cost is ~10 lines. This
    // avoids needing a _module_has_async scan pass at emission start.
    //
    // Scheduler entry points — runtime/native/mapanare_runtime.c v4.92.0+:
    s = declare_runtime_fn(s, "__mn_coro_scheduler_init", "void", "i32")
    s = declare_runtime_fn(s, "__mn_coro_scheduler_destroy", "void", "")
    s = declare_runtime_fn(s, "__mn_coro_scheduler_register", "void", "ptr")
    s = declare_runtime_fn(s, "__mn_coro_scheduler_run", "void", "")
    s = declare_runtime_fn(s, "__mn_coro_register_wait", "void", "ptr, ptr")
    s = declare_runtime_fn(s, "__mn_coro_spawn", "void", "ptr")
    // LLVM coroutine intrinsics — required once any async fn is emitted
    // with `presplitcoroutine`. v5.5.2 Option A: async fns stay plain
    // (no presplit wrapping), so these are never called — but we
    // declare them for llvm-as validity of programs that reference them
    // via AwaitSuspend / BlockOn.
    s = declare_runtime_fn(s, "llvm.coro.id", "token", "i32, ptr, ptr, ptr")
    s = declare_runtime_fn(s, "llvm.coro.alloc", "i1", "token")
    s = declare_runtime_fn(s, "llvm.coro.size.i64", "i64", "")
    s = declare_runtime_fn(s, "llvm.coro.begin", "ptr", "token, ptr")
    s = declare_runtime_fn(s, "llvm.coro.suspend", "i8", "token, i1")
    s = declare_runtime_fn(s, "llvm.coro.end", "i1", "ptr, i1, token")
    s = declare_runtime_fn(s, "llvm.coro.free", "ptr", "token, ptr")
    s = declare_runtime_fn(s, "llvm.coro.resume", "void", "ptr")
    s = declare_runtime_fn(s, "llvm.coro.destroy", "void", "ptr")
    s = declare_runtime_fn(s, "llvm.coro.done", "i1", "ptr")
    s = declare_runtime_fn(s, "llvm.coro.save", "token", "ptr")

    return emit_blank(s)

// ---------------------------------------------------------------------------
// Struct type registration from MIR
// ---------------------------------------------------------------------------

fn register_mir_struct(st: EmitState, info: StructInfo) -> EmitState:
    let mut field_names: List<String> = []
    let mut field_types: List<String> = []
    let mut llvm_fields: String = ""
    let mut fi: Int = 0

    for _ in 0..500:
        if fi >= len(info.fields):
            let ty: String = "{ " + llvm_fields + " }"
            let entry: StructEntry = new_struct_entry(info.name, field_names, field_types, ty)
            st.structs.push(entry)

            // Emit named struct type definition
            let mut s: EmitState = emit_line(st, "%struct." + info.name + " = type " + ty)
            return s
        let fp: FieldPair = info.fields[fi]
        let mut fty: String = resolve_mir_type(fp.val.ty)
        // Detect self-referential fields (e.g. TypeInfo has Option<TypeInfo>).
        // Replace with ptr to avoid infinite recursion in LLVM type layout.
        // Use boundary-aware match: check for exact type name followed by
        // non-alphanumeric (space, comma, }, etc.) to avoid false positives
        // like MatchArm matching MatchArmBody.
        let self_struct: String = "%struct." + info.name + " "
        let self_struct2: String = "%struct." + info.name + "}"
        let self_enum: String = "%enum." + info.name + " "
        let self_enum2: String = "%enum." + info.name + "}"
        if fty.contains(self_struct) || fty.contains(self_struct2) || fty.contains(self_enum) || fty.contains(self_enum2):
            fty = llvm_ptr()
        field_names.push(fp.name)
        field_types.push(fty)
        if fi > 0:
            llvm_fields = llvm_fields + ", " + fty
        else:
            llvm_fields = fty
        fi = fi + 1
    return st

// ---------------------------------------------------------------------------
// Enum type registration from MIR
// ---------------------------------------------------------------------------

fn is_enum_type(st: EmitState, name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.enum_names): return false
        if st.enum_names[i] == name: return true
        i = i + 1
    return false

fn is_struct_type(st: EmitState, name: String) -> Bool:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.structs): return false
        if st.structs[i].name == name: return true
        i = i + 1
    return false

// Compute size of an LLVM type in i64 units (8-byte slots)
fn type_size_in_slots(st: EmitState, ty: MIRType) -> Int:
    let resolved: String = resolve_mir_type(ty)
    if resolved == "i64": return 1
    if resolved == "double": return 1
    if resolved == "i1": return 1
    if resolved == "i8": return 1
    if resolved == "ptr": return 1
    if resolved == "void": return 0
    // String: {ptr, i64} = 2 slots
    if resolved == "{ptr, i64}": return 2
    // List: {ptr, i64, i64, i64, i64} = 5 slots (data, len, cap, elem_size, managed)
    if resolved == "{ptr, i64, i64, i64, i64}": return 5
    // Range: {i64, i64} = 2 slots
    if resolved == "{i64, i64}": return 2
    // Option: {i1, T} ≈ 2 slots minimum
    if ty.kind == TK_OPTION():
        if len(ty.args) > 0:
            return 1 + type_size_in_slots(st, ty.args[0])
        return 2
    // Result: {i1, {T, E}}
    if ty.kind == TK_RESULT(): return 4
    // Map: {ptr, i64} = 2 slots
    if ty.kind == TK_MAP(): return 2
    // Enum: 1 (tag) + max_payload_slots.
    // If registered, look up; otherwise return 48 (conservative for recursive enums).
    if ty.kind == TK_ENUM():
        let mut ei: Int = 0
        let neinfos: Int = len(st.enum_infos)
        for _ in 0..500:
            if ei < neinfos:
                let e_info: EnumInfo = st.enum_infos[ei]
                if e_info.name == ty.name:
                    return 1 + variant_payload_slots_max(st, e_info)
                ei = ei + 1
        // Not registered yet (recursive reference or forward ref): use 48 slots.
        // This is conservative: Expr needs ~30, Stmt ~25, Definition ~32.
        return 48
    // Struct: field_count * 4 (average 4 slots per field — covers Span=4, String=2, List=4)
    if ty.kind == TK_STRUCT():
        let struct_opt: Option<StructEntry> = find_struct_entry(st, ty.name)
        match struct_opt:
            Some(se) => return len(se.field_types) * 4
            _ => return 8
    // Default: 8 slots (conservative fallback)
    return 8

// Compute actual i64 slot count for a variant's payload.
// Extracted to a helper function because return-inside-for works,
// but cross-scope variable assignment after a for loop does not.
fn variant_payload_slots(st: EmitState, variant: EnumVariantInfo) -> Int:
    let mut total: Int = 0
    let mut pi: Int = 0
    for _ in 0..100:
        if pi >= len(variant.payload_types): return total
        total = total + type_size_in_slots(st, variant.payload_types[pi])
        pi = pi + 1
    return total

fn max_int(a: Int, b: Int) -> Int:
    if a > b: return a
    return b

// Max payload slots across all variants of an enum.
fn variant_payload_slots_max(st: EmitState, info: EnumInfo) -> Int:
    let mut mx: Int = 0
    let mut vi: Int = 0
    for _ in 0..500:
        if vi >= len(info.variants): return mx
        let count: Int = variant_payload_slots(st, info.variants[vi])
        // Use max_int instead of `if count > mx { mx = count }` because
        // the Python lowerer generates `store i64 0` for conditional
        // assignments inside for loops (cross-scope assignment bug).
        mx = max_int(mx, count)
        vi = vi + 1
    return mx

// v4.140.0 Cb.5: inline enum eligibility — mirrors Python _type_fits_inline_slot.
fn type_fits_inline_slot(resolved: String) -> Bool:
    // Cb.6 (v4.144.0): reject typed-pointer-legacy forms like "i64*".
    // Mapanare's emitter uses opaque `ptr`; any trailing `*` is a bug
    // in the caller or a stale type string from a legacy path.
    if resolved.ends_with("*"):
        return false
    if resolved == "i64": return true
    if resolved == "double": return true
    if resolved == "i1": return true
    if resolved == "i8": return true
    if resolved == "i16": return true
    if resolved == "i32": return true
    if resolved == "ptr": return true
    return false

fn is_enum_self_ref(enum_name: String, ty: MIRType) -> Bool:
    if ty.name == enum_name:
        if ty.kind == TK_ENUM() || ty.kind == TK_STRUCT(): return true
    if ty.kind == TK_OPTION():
        if len(ty.args) > 0:
            if ty.args[0].name == enum_name: return true
    if ty.kind == TK_RESULT():
        let mut ai: Int = 0
        for _ in 0..2:
            if ai < len(ty.args):
                if ty.args[ai].name == enum_name: return true
                ai = ai + 1
    return false

// v4.140.0 Cb.5: compute inline slot count for an enum (0 = boxed).
// Mirrors Python _compute_enum_inline_slots: every variant's payload
// fields must be i64-packable, no self-reference, max 2 fields.
fn compute_enum_inline_slots(st: EmitState, info: EnumInfo) -> Int:
    let max_inline: Int = 2
    let mut max_fields: Int = 0
    let mut vi: Int = 0
    for _ in 0..500:
        if vi >= len(info.variants): return max_fields
        let variant: EnumVariantInfo = info.variants[vi]
        let npt: Int = len(variant.payload_types)
        if npt > max_inline: return 0
        if npt > max_fields: max_fields = npt
        let mut fi: Int = 0
        for _ in 0..100:
            if fi < npt:
                if is_enum_self_ref(info.name, variant.payload_types[fi]): return 0
                let ft: String = resolve_mir_type(variant.payload_types[fi])
                if !type_fits_inline_slot(ft): return 0
                fi = fi + 1
        vi = vi + 1
    return max_fields

fn lookup_enum_inline(st: EmitState, enum_name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..10000:
        if i >= len(st.enum_names): return 0
        if st.enum_names[i] == enum_name: return st.enum_inline_slots[i]
        i = i + 1
    return 0

fn enum_inline_type(slots: Int) -> String:
    let n: Int = max_int(slots, 1)
    if n == 1: return "{i64, i64}"
    return "{i64, i64, i64}"

fn register_mir_enum(st: EmitState, info: EnumInfo) -> EmitState:
    let mut s: EmitState = st
    s.enum_names.push(info.name)
    s.enum_infos.push(info)
    let slots: Int = compute_enum_inline_slots(s, info)
    s.enum_inline_slots.push(slots)
    if slots > 0:
        s = emit_line(s, "%enum." + info.name + " = type " + enum_inline_type(slots))
    else:
        s = emit_line(s, "%enum." + info.name + " = type {i64, ptr}")
    return s

// ---------------------------------------------------------------------------
// Extern function declaration from MIR
// ---------------------------------------------------------------------------

fn is_already_declared(st: EmitState, name: String) -> Bool:
    // Check if a function was already declared in the runtime block
    let needle: String = "@" + name + "("
    let mut i: Int = 0
    let n: Int = len(st.lines)
    for _ in 0..10000:
        if i >= n: return false
        let line: String = st.lines[i]
        if line.starts_with("declare ") && line.contains(needle):
            return true
        i = i + 1
    return false

fn declare_mir_extern(st: EmitState, info: ExternFnInfo) -> EmitState:
    // Skip if already declared (avoids duplicate declarations)
    if is_already_declared(st, info.fn_name): return st
    let ret_ty: String = resolve_mir_type(info.return_type)
    let mut params_str: String = ""
    let mut i: Int = 0
    let nptypes: Int = len(info.param_types)
    for _ in 0..500:
        if i < nptypes:
            let pty: String = resolve_mir_type(info.param_types[i])
            if i > 0:
                params_str = params_str + ", " + pty
            else:
                params_str = pty
            i = i + 1
    return emit_line(st, "declare " + ret_ty + " @" + info.fn_name + "(" + params_str + ")")

// ---------------------------------------------------------------------------
// MIR instruction emission → LLVM IR
// ---------------------------------------------------------------------------

fn emit_mir_instruction(st: EmitState, inst: Instruction) -> EmitState:
    // String-tagged dispatch: uses instr_kind() from mir.mn (same module as
    // the Instruction enum) so that enum tags are always correct regardless
    // of which compiler produced this binary.  Dispatches via match-on-string
    // (not match-on-enum) for cross-compilation stability.
    let kind: String = instr_kind(inst)
    emit_mir_by_kind(st, inst, kind)

fn emit_mir_by_kind(st: EmitState, inst: Instruction, kind: String) -> EmitState:
    if kind == "const": return emit_const(st, instr_dest(inst), instr_const_type(inst), instr_const_val(inst))
    if kind == "copy": return emit_copy(st, instr_dest(inst), instr_copy_src(inst))
    if kind == "cast": return emit_cast(st, instr_dest(inst), instr_cast_src(inst), instr_cast_type(inst))
    if kind == "binop": return emit_binop(st, instr_dest(inst), instr_binop_op(inst), instr_binop_lhs(inst), instr_binop_rhs(inst))
    if kind == "unaryop": return emit_unaryop(st, instr_dest(inst), instr_unaryop_op(inst), instr_unaryop_operand(inst))
    if kind == "struct_init": return emit_struct_init(st, instr_dest(inst), instr_struct_type(inst), instr_struct_fields(inst))
    if kind == "field_get": return emit_field_get(st, instr_dest(inst), instr_fieldget_obj(inst), instr_fieldget_name(inst))
    if kind == "field_set": return emit_field_set(st, instr_fieldset_obj(inst), instr_fieldset_name(inst), instr_fieldset_val(inst))
    if kind == "list_init": return emit_list_init_checked(st, inst)
    if kind == "tensor_init": return emit_tensor_init(st, inst)
    if kind == "index_get": return emit_index_get(st, instr_dest(inst), instr_indexget_obj(inst), instr_indexget_idx(inst))
    if kind == "index_set": return emit_index_set(st, instr_indexset_obj(inst), instr_indexset_idx(inst), instr_indexset_val(inst))
    if kind == "alloca": return emit_alloca(st, instr_dest(inst), instr_alloca_type(inst))
    if kind == "load": return emit_load(st, instr_dest(inst), instr_load_ptr(inst))
    if kind == "store": return emit_store(st, instr_store_ptr(inst), instr_store_val(inst))
    if kind == "map_init": return emit_map_init(st, instr_dest(inst), instr_map_key_type(inst), instr_map_val_type(inst), instr_map_pairs(inst))
    if kind == "enum_init": return emit_enum_init(st, instr_dest(inst), instr_enum_type(inst), instr_enum_variant(inst), instr_enum_payload(inst))
    if kind == "enum_tag": return emit_enum_tag(st, instr_dest(inst), instr_enumtag_val(inst))
    if kind == "enum_payload": return emit_enum_payload(st, instr_dest(inst), instr_enumpayload_val(inst), instr_enumpayload_variant(inst))
    if kind == "wrap_some": return emit_wrap_some(st, instr_dest(inst), instr_wrap_val(inst))
    if kind == "wrap_none": return emit_wrap_none(st, instr_dest(inst), instr_wrapnone_type(inst))
    if kind == "wrap_ok": return emit_wrap_ok(st, instr_dest(inst), instr_wrap_val(inst))
    if kind == "wrap_err": return emit_wrap_err(st, instr_dest(inst), instr_wrap_val(inst))
    if kind == "unwrap": return emit_unwrap(st, instr_dest(inst), instr_wrap_val(inst))
    if kind == "call":
        let call_dest: Value = instr_dest(inst)
        let call_fn_name: String = instr_call_fn(inst)
        let mut s_call: EmitState = emit_mir_call(st, call_dest, call_fn_name, instr_call_args(inst))
        // v5.4.1 Phase 3.2 — track String results from runtime + user
        // calls. emit_mir_call has many branches but they all leave
        // dest in dn (the call's SSA result); a single post-call hook
        // here covers __mn_str_concat, __mn_str_from_int, substr,
        // user fns returning String, and so on. emit_track_string is
        // safe to call on values backed by .rodata (literal pass-
        // through) — __mn_str_free is_heap-aware.
        //
        // v5.4.2 Phase 3.1 — fallback for builtins whose MIR dest falls
        // through to mir_unknown() in lower_call_by_name (no specific
        // handler + no __ret__fn_name in lambda_vars). is_string_returning_
        // builtin matches the subset of semantic.mn::builtin_return_type
        // where return == "String" but lower.mn doesn't type-tag the dest.
        // Without this fallback, read_file / sha256 / regex_replace /
        // http_get / base64_* / hmac_sha256 / hex_encode / random_bytes
        // / gpu_device_name / read_line / join / typeof all leak.
        if call_dest.ty.kind == TK_STRING() || is_string_returning_builtin(call_fn_name):
            s_call = emit_track_string(s_call, call_dest.name)
        return s_call
    if kind == "return": return emit_mir_return(st, instr_return_val(inst))
    if kind == "jump": return emit_line(st, emit_br(instr_jump_target(inst)))
    if kind == "branch": return emit_mir_branch(st, inst)
    if kind == "switch": return emit_mir_switch(st, instr_switch_tag(inst), instr_switch_cases(inst), instr_switch_default(inst))
    if kind == "agent_spawn": return emit_agent_spawn(st, instr_dest(inst), instr_agent_type(inst), instr_agent_args(inst))
    if kind == "agent_send": return emit_agent_send(st, instr_agentsend_agent(inst), instr_agentsend_channel(inst), instr_agentsend_val(inst))
    if kind == "agent_sync": return emit_agent_sync(st, instr_dest(inst), instr_agentsync_agent(inst), instr_agentsync_channel(inst))
    if kind == "signal_init": return emit_signal_init(st, instr_dest(inst), instr_signal_type(inst), instr_signal_val(inst))
    if kind == "signal_get": return emit_signal_get(st, instr_dest(inst), instr_signalget_sig(inst))
    if kind == "signal_set": return emit_signal_set(st, instr_signalset_sig(inst), instr_signalset_val(inst))
    if kind == "stream_op": return emit_stream_op(st, instr_dest(inst), instr_streamop_kind(inst), instr_streamop_source(inst), instr_streamop_args(inst))
    if kind == "interp_concat": return emit_interp_concat(st, instr_dest(inst), instr_concat_parts(inst))
    if kind == "phi": return emit_mir_phi(st, instr_dest(inst), instr_phi_entries(inst))
    if kind == "move":
        // v5.4.0 Own.1 Phase 2 — record an explicit ownership transfer.
        // Push the stripped local name onto st.moved_locals so
        // emit_drop_glue skips it.  Idempotent: duplicates are ignored.
        // Lowerer Move emission is deferred to v5.4.1 (see RESCOPE.md);
        // this handler is symmetric with the Python _do_move stub
        // installed in Phase 1 and ready to consume lowerer output.
        let mv_val: Value = instr_move_val(inst)
        let stripped: String = ret_val_base(mv_val.name)
        if stripped == "": return st
        if list_has_string(st.moved_locals, stripped): return st
        let mut s: EmitState = st
        s.moved_locals.push(stripped)
        return s
    // v5.5.4 Sh.4 Phase 2 — real coroutine drive.
    // Async fns now return `ptr %future` from their initial suspend
    // (see emit_mir_function).  BlockOn and AwaitSuspend must drive
    // the suspended coroutine to its final suspend, then extract the
    // boxed return value from the future.payload slot.
    //
    // v5.5.4 is SYNCHRONOUS — the caller inline-resumes the coroutine
    // rather than registering it with the scheduler.  That's fine for
    // the 5 Sh.4 goldens (no real I/O, no cross-thread fanout) and
    // matches how LLVM's CoroElide optimizes trivially-inlinable
    // coroutines.  v5.5.6 adds the scheduler-driven path for
    // concurrency-aware programs.
    //
    // Critical (v4.102.0 foot-gun, emit_llvm_text.py:5459): the
    // future.payload slot initially holds the coroutine handle (set
    // during async fn prologue) but after the coroutine reaches its
    // final suspend, the slot is overwritten with the result-box
    // pointer.  Load the handle ONCE before coro.resume and reuse it
    // for coro.destroy — never reload slot 1 for the handle after
    // resume.
    if kind == "await_suspend":
        // v5.5.5: scheduler-driven AwaitSuspend. Replaces v5.5.4's
        // synchronous llvm.coro.resume drive with the real
        // save/suspend/switch pattern mirroring
        // emit_llvm_text.py:5305-5372 (the _fn_is_async branch).
        //
        // 6-block layout emitted inline (entry is the current BB):
        //   entry   -> fast-path: load future.state, goto ready if already 1
        //   aw.drive.N  -> load handle, coro.resume once, goto check
        //   aw.check.N  -> re-load state, goto ready or suspend
        //   aw.suspend.N -> register_wait + coro.save + coro.suspend + switch
        //   aw.resume.N -> scheduler woke us, fall through to ready
        //   aw.ready.N  -> load payload, extract value, destroy inner, free
        //
        // AwaitSuspend is only emitted inside async fns (semantic guard),
        // so %coro.hdl, coro.ret, coro.cleanup are always defined by
        // v5.5.4's emit_mir_function prologue/epilogue.
        let aw_dest: Value = instr_dest(inst)
        let aw_fut: Value = instr_await_suspend_future(inst)
        let n: Int = st.counter
        let mut s_aw: EmitState = st
        s_aw.counter = n + 1
        let tag: String = toString(n)
        let drive_lbl: String = "aw.drive." + tag
        let check_lbl: String = "aw.check." + tag
        let susp_lbl: String = "aw.suspend." + tag
        let res_lbl: String = "aw.resume." + tag
        let rdy_lbl: String = "aw.ready." + tag
        let sp: String = "%aw.st.ptr." + tag
        let sv: String = "%aw.st." + tag
        let rd: String = "%aw.rdy." + tag
        let hp: String = "%aw.hdl.ptr." + tag
        let hd: String = "%aw.hdl." + tag
        let s2: String = "%aw.st2." + tag
        let rd2: String = "%aw.rdy2." + tag
        let sav: String = "%aw.save." + tag
        let sus: String = "%aw.susp." + tag
        let vp: String = "%aw.val.ptr." + tag
        let vb: String = "%aw.val.box." + tag
        let vr: String = "%aw.val." + tag

        s_aw = emit_line(s_aw, "  ; v5.5.7 await_suspend " + tag + " — scheduler-driven suspend + cleanup")
        // v5.5.7 — hoist the inner-handle load into the entry BB
        // (BEFORE the fast-path branch) so %aw.hdl.N dominates every
        // edge into aw.ready.N (fast-path, drive→check→ready, and
        // scheduler-resume→ready). Required to call coro.destroy +
        // free in aw.ready.N without violating SSA dominance.
        // The inner coroutine has already initialised future.handle
        // by the time we reach AwaitSuspend (initial-suspend path of
        // the inner's coro.entry stored %coro.hdl into slot 1), so
        // the load is well-defined.
        s_aw = emit_line(s_aw, "  " + hp + " = getelementptr inbounds {i8, ptr}, ptr " + aw_fut.name + ", i32 0, i32 1")
        s_aw = emit_line(s_aw, "  " + hd + " = load ptr, ptr " + hp)
        // Fast-path: check if future is already Ready.
        s_aw = emit_line(s_aw, "  " + sp + " = getelementptr inbounds {i8, ptr}, ptr " + aw_fut.name + ", i32 0, i32 0")
        s_aw = emit_line(s_aw, "  " + sv + " = load i8, ptr " + sp)
        s_aw = emit_line(s_aw, "  " + rd + " = icmp eq i8 " + sv + ", 1")
        s_aw = emit_line(s_aw, "  br i1 " + rd + ", label %" + rdy_lbl + ", label %" + drive_lbl)

        // aw.drive.N — resume once, go to check. Handle was already
        // loaded in entry (hoisted v5.5.7); reuse %aw.hdl.N here.
        s_aw = emit_line(s_aw, drive_lbl + ":")
        s_aw = emit_line(s_aw, "  call void @llvm.coro.resume(ptr " + hd + ")")
        s_aw = emit_line(s_aw, "  br label %" + check_lbl)

        // aw.check.N — re-check readiness after driving.
        s_aw = emit_line(s_aw, check_lbl + ":")
        s_aw = emit_line(s_aw, "  " + s2 + " = load i8, ptr " + sp)
        s_aw = emit_line(s_aw, "  " + rd2 + " = icmp eq i8 " + s2 + ", 1")
        s_aw = emit_line(s_aw, "  br i1 " + rd2 + ", label %" + rdy_lbl + ", label %" + susp_lbl)

        // aw.suspend.N — register wait, save, suspend outer, switch.
        s_aw = emit_line(s_aw, susp_lbl + ":")
        s_aw = emit_line(s_aw, "  call void @__mn_coro_register_wait(ptr %coro.hdl, ptr " + aw_fut.name + ")")
        s_aw = emit_line(s_aw, "  " + sav + " = call token @llvm.coro.save(ptr %coro.hdl)")
        s_aw = emit_line(s_aw, "  " + sus + " = call i8 @llvm.coro.suspend(token " + sav + ", i1 false)")
        s_aw = emit_line(s_aw, "  switch i8 " + sus + ", label %coro.ret [")
        s_aw = emit_line(s_aw, "    i8 0, label %" + res_lbl)
        s_aw = emit_line(s_aw, "    i8 1, label %coro.cleanup")
        s_aw = emit_line(s_aw, "  ]")

        // aw.resume.N — scheduler resumed us.
        s_aw = emit_line(s_aw, res_lbl + ":")
        s_aw = emit_line(s_aw, "  br label %" + rdy_lbl)

        // aw.ready.N — future is Ready, extract payload + destroy.
        // v5.5.7: with %aw.hdl.N hoisted to entry (above), it now
        // dominates this block from all three predecessors — the
        // fast-path branch, aw.check.N→ready, and aw.resume.N→ready.
        // Safe to call coro.destroy + free without an SSA
        // dominance violation.
        //
        // Mirrors v5.5.6's BlockOn cleanup. v4.102.0 foot-gun
        // applies: %aw.hdl.N was loaded BEFORE any potential
        // scheduler_run drive (in the entry BB), so the slot-1
        // clobber that scheduler_run performs (overwriting the
        // handle with the result box) is irrelevant — we still
        // hold the original handle in %aw.hdl.N.
        s_aw = emit_line(s_aw, rdy_lbl + ":")
        s_aw = emit_line(s_aw, "  " + vp + " = getelementptr inbounds {i8, ptr}, ptr " + aw_fut.name + ", i32 0, i32 1")
        s_aw = emit_line(s_aw, "  " + vb + " = load ptr, ptr " + vp)
        s_aw = emit_line(s_aw, "  " + vr + " = load i64, ptr " + vb)
        s_aw = emit_line(s_aw, "  " + aw_dest.name + " = add i64 0, " + vr)
        s_aw = emit_line(s_aw, "  call void @llvm.coro.destroy(ptr " + hd + ")")
        s_aw = emit_line(s_aw, "  call void @free(ptr " + vb + ")")
        s_aw = emit_line(s_aw, "  call void @free(ptr " + aw_fut.name + ")")
        return s_aw
    if kind == "block_on":
        // v5.5.6 Sh.4 Phase 3 — scheduler-driven BlockOn. Replaces
        // v5.5.4's inline llvm.coro.resume drive. Mirrors the
        // scheduler-driven path of emit_llvm_text.py:5429-5441 (the
        // `_module_has_async` branch of `_do_block_on`). The
        // synchronous fallback is unreachable here because BlockOn is
        // only lowered inside modules that already contain async fns;
        // `module_has_async` is therefore true for every main that
        // reaches this emitter.
        //
        // The scheduler runs the caller thread as worker 0 and drives
        // any additional pre-spawned workers (v5.1.4 lazy-spawn policy)
        // until `active_tasks == 0`. When it returns, the registered
        // coroutine's final-suspend path has written `future.state=1`
        // and stored the boxed payload into future.payload. v4.102.0's
        // handle-reload foot-gun still applies: slot 1 of the Future
        // is now the RESULT BOX, not the coroutine handle, so we keep
        // `%bo.hdl.<tag>` (loaded BEFORE register) around for
        // llvm.coro.destroy.
        let bo_dest: Value = instr_dest(inst)
        let bo_fut: Value = instr_block_on_future(inst)
        let n: Int = st.counter
        let mut s_bo: EmitState = st
        s_bo.counter = n + 1
        let tag: String = toString(n)
        s_bo = emit_line(s_bo, "  ; v5.5.6 block_on " + tag + " — scheduler-driven")
        let hp: String = "%bo.hdl.ptr." + tag
        let hd: String = "%bo.hdl." + tag
        let vp: String = "%bo.val.ptr." + tag
        let vb: String = "%bo.val.box." + tag
        let vr: String = "%bo.val." + tag
        // Load the handle BEFORE register: scheduler_run overwrites
        // future.payload with the result box, so re-reading slot 1
        // afterwards would hand coro.destroy an 8-byte malloc'd int
        // and segfault.
        s_bo = emit_line(s_bo, "  " + hp + " = getelementptr inbounds {i8, ptr}, ptr " + bo_fut.name + ", i32 0, i32 1")
        s_bo = emit_line(s_bo, "  " + hd + " = load ptr, ptr " + hp)
        // Register + run — drains active_tasks to 0 and participates
        // as worker 0 alongside any lazily-spawned worker threads.
        s_bo = emit_line(s_bo, "  call void @__mn_coro_scheduler_register(ptr " + hd + ")")
        s_bo = emit_line(s_bo, "  call void @__mn_coro_scheduler_run()")
        // Extract result: payload slot now holds the boxed T.
        s_bo = emit_line(s_bo, "  " + vp + " = getelementptr inbounds {i8, ptr}, ptr " + bo_fut.name + ", i32 0, i32 1")
        s_bo = emit_line(s_bo, "  " + vb + " = load ptr, ptr " + vp)
        s_bo = emit_line(s_bo, "  " + vr + " = load i64, ptr " + vb)
        s_bo = emit_line(s_bo, "  " + bo_dest.name + " = add i64 0, " + vr)
        // Cleanup — reuse `hd` loaded above (slot 1 is clobbered now).
        s_bo = emit_line(s_bo, "  call void @llvm.coro.destroy(ptr " + hd + ")")
        s_bo = emit_line(s_bo, "  call void @free(ptr " + vb + ")")
        s_bo = emit_line(s_bo, "  call void @free(ptr " + bo_fut.name + ")")
        return s_bo
    __mn_str_eprint("ERROR: unknown MIR instruction kind: ")
    __mn_str_eprint(kind)
    __mn_str_eprint("\n")
    return st

fn emit_mir_branch(st: EmitState, inst: Instruction) -> EmitState:
    let cond: Value = instr_branch_cond(inst)
    emit_line(st, emit_cbranch(cond.name, instr_branch_true(inst), instr_branch_false(inst)))

fn emit_list_init_checked(st: EmitState, inst: Instruction) -> EmitState:
    let dest: Value = instr_dest(inst)
    let elem_ty: MIRType = instr_list_type(inst)
    let elements: List<Value> = instr_list_elements(inst)
    // v5.6.7 Ve.2 fix — when dest is definitively `TK_LIST` (set by
    // `make_value(s, mir_list(), "t")` in `lower_list_typed`), skip
    // the struct-reinterpretation heuristics below. They were added
    // to handle cases where the lowerer mis-typed a struct literal as
    // a list init, but they misfire for correctly-typed
    // `List<SomeStruct>` literals (where elem_ty.name matches a
    // registered struct) — the whole ListInit gets dropped and
    // replaced with a broken struct_init, leaving the list dest
    // undefined at every use site.
    if dest.ty.kind == TK_LIST():
        return emit_list_init(st, dest, elem_ty, elements)
    let struct_check: Option<StructEntry> = find_struct_entry(st, dest.ty.name)
    let struct_check2: Option<StructEntry> = find_struct_entry(st, elem_ty.name)
    match struct_check:
        Some(_) => return emit_struct_init_from_values(st, dest, dest.ty, elements)
        _ => {}
    match struct_check2:
        Some(_) => return emit_struct_init_from_values(st, dest, elem_ty, elements)
        _ => {}
    return emit_list_init(st, dest, elem_ty, elements)

// ---------------------------------------------------------------------------
// Tensor literal emission (v4.42.0)
// ---------------------------------------------------------------------------

fn emit_tensor_init(st: EmitState, inst: Instruction) -> EmitState:
    // v5.6.0 Sh.6: Full tensor literal emission, mirroring
    // emit_llvm_text.py::_do_tensor_init (v4.42.0).
    //   1. Stack-allocate [rank x i64] shape array
    //   2. Store each shape dimension
    //   3. Call __mn_tensor_alloc(rank, shape_ptr, elem_size) -> dest
    //   4. For each element: __mn_tensor_store_{f64,i64}(dest, idx, elem)
    // Element type is inferred from the first lowered element's MIRType
    // (see lower.mn::lower_tensor). Int/Bool -> i64 storage; everything
    // else -> f64 (consistent with the tensor element types the goldens
    // actually exercise).
    let dest: Value = instr_dest(inst)
    let elem_type: MIRType = instr_tensor_type(inst)
    let shape: List<Int> = instr_tensor_shape(inst)
    let elements: List<Value> = instr_tensor_elements(inst)
    let mut s: EmitState = st
    let dn: String = dest.name
    let rank: Int = len(shape)
    let rank_str: String = toString(rank)
    let shape_arr_ty: String = "[" + rank_str + " x i64]"

    // Step 1: alloca shape array. Lives in entry-block prelude so it
    // dominates the alloc call regardless of control flow.
    let shape_a: String = dn + ".shape"
    s.entry_prelude_lines.push("  " + shape_a + " = alloca " + shape_arr_ty + ", align 8")

    // Step 2: store each dim value. Stays at emission point.
    let mut i_dim: Int = 0
    for _ in 0..32:
        if i_dim >= rank: break
        let gep: String = dn + ".sd" + toString(i_dim)
        s = emit_line(s, "  " + gep + " = getelementptr inbounds " + shape_arr_ty + ", ptr " + shape_a + ", i64 0, i64 " + toString(i_dim))
        s = emit_line(s, "  store i64 " + toString(shape[i_dim]) + ", ptr " + gep)
        i_dim = i_dim + 1

    // Step 3: pick store fn + ty based on element type.
    let mut store_fn: String = "__mn_tensor_store_f64"
    let mut store_ty: String = "double"
    if elem_type.kind == TK_INT():
        store_fn = "__mn_tensor_store_i64"
        store_ty = "i64"
    if elem_type.kind == TK_BOOL():
        store_fn = "__mn_tensor_store_i64"
        store_ty = "i64"

    // Step 4: call __mn_tensor_alloc. Element size is always 8 (double
    // or int64). v5.6.4 Rt.06 — result is tracked for drop-glue;
    // emit_drop_glue emits __mn_tensor_free on non-moved, non-returned
    // slots at every ret edge.
    s = emit_line(s, "  " + dn + " = call noalias ptr @__mn_tensor_alloc(i64 " + rank_str + ", ptr " + shape_a + ", i64 8)")
    s = emit_track_tensor(s, dn)

    // Step 5: store each element. Elements are lowered to their own SSA
    // names; types match elem_type by construction in lower_tensor.
    let mut j: Int = 0
    for _ in 0..100000:
        if j >= len(elements): break
        let elem: Value = elements[j]
        // Note: "en" is a Mapanare keyword (Spanish "in"), so use `elem_val`
        // for the SSA name — identifiers that collide with keywords cause
        // `let en: String` bindings to silently infer as <unknown>/Option
        // downstream, triggering "String + Option" binop errors during
        // self-compilation.
        let elem_val: String = elem.name
        // If the element is a constant from parse but its MIR type doesn't
        // match store_ty, coerce. UnaryExpr(-, FloatLit) arrives as Float
        // already from semantic inference, so coercion is rare. Keep the
        // simple happy path first; sitofp/fptosi deferred to v5.6.1 if
        // broadcast/mixed literals hit the edge case.
        s = emit_line(s, "  call void @" + store_fn + "(ptr " + dn + ", i64 " + toString(j) + ", " + store_ty + " " + elem_val + ")")
        j = j + 1
    return s

// ---------------------------------------------------------------------------
// Const instruction
// ---------------------------------------------------------------------------

fn emit_const(st: EmitState, dest: Value, ty: MIRType, val: String) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    let llvm_ty: String = resolve_mir_type(ty)

    // Void constants are no-ops
    if ty.kind == TK_VOID():
        return s

    // String constant: emit global at module level, build struct inline
    if ty.kind == TK_STRING():
        // Escape special chars for LLVM IR string constants
        let escaped: String = val.replace("\\", "\\5C").replace("\"", "\\22").replace("\n", "\\0A").replace("\t", "\\09").replace("\r", "\\0D")
        let slen: Int = len(val)
        let gname: String = next_str_name(s)
        s.str_counter = s.str_counter + 1
        let arr_ty: String = "[" + toString(slen) + " x i8]"
        s = emit_global(s, gname + " = private constant " + arr_ty + " c\"" + escaped + "\", align 2")
        let ptr_name: String = dn + ".ptr"
        s = emit_line(s, "  " + ptr_name + " = getelementptr inbounds " + arr_ty + ", " + "ptr " + gname + ", i64 0, i64 0")
        let s1_name: String = dn + ".s1"
        s = emit_line(s, emit_insertvalue(s1_name, llvm_string(), "undef", ptr_name, "ptr", "0"))
        s = emit_line(s, emit_insertvalue(dn, llvm_string(), s1_name, toString(slen), "i64", "1"))
        // v5.4.1 note: do NOT track String literal Consts. Their data
        // ptr points at .rodata so __mn_str_free is_heap=0 no-ops on
        // them, but tracking each literal explodes stage2.ll
        // quadratically (e.g. get_fn_attrs has ~225 returns × ~225
        // literals → every ret emits drop-glue for every tracked
        // literal, producing ~250k drop-glue lines in one function).
        // Python's _mkstr omits tracking for the same reason. Heap
        // allocations from runtime calls (Phase 3.2) ARE tracked.
        return s

    // Bool constant
    if ty.kind == TK_BOOL():
        let mut bval: String = "0"
        if val == "true": bval = "1"
        s = emit_line(s, "  " + dn + " = add i1 0, " + bval)
        return s

    // Int constant: emit `%dest = add i64 0, <val>` to define the SSA value
    if ty.kind == TK_INT():
        s = emit_line(s, "  " + dn + " = add i64 0, " + val)
        return s

    // Float constant: emit `%dest = fadd double 0.0, <val>`
    // Ensure the value has a decimal point for valid LLVM IR.
    // Handle scientific notation: "1e+09" → "1.0e+09" (not "1e+09.0")
    if ty.kind == TK_FLOAT():
        let mut fval: String = val
        if fval.contains("e"):
            // Scientific notation — ensure mantissa has a decimal point
            if !fval.contains("."):
                let mut ei: Int = 0
                for ci in 0..len(fval):
                    if fval.char_at(ci) == "e": ei = ci
                fval = fval.substr(0, ei) + ".0" + fval.substr(ei, len(fval) - ei)
        else:
            if !fval.contains("."): fval = fval + ".0"
        s = emit_line(s, "  " + dn + " = fadd double 0.0, " + fval)
        return s

    // Struct constant (undef initializer for struct construction)
    if ty.kind == TK_STRUCT():
        s = emit_line(s, "  " + dn + " = insertvalue " + llvm_ty + " undef, " + llvm_ty + " undef, 0")
        return s

    // Function constant: emit function pointer reference
    if ty.kind == TK_FN():
        s = emit_line(s, "  " + dn + " = bitcast void ()* @" + val + " to ptr")
        return s

    // Unknown type — no-op
    return s

// ---------------------------------------------------------------------------
// Copy instruction
// ---------------------------------------------------------------------------

fn emit_copy(st: EmitState, dest: Value, src: Value) -> EmitState:
    let mut s: EmitState = st
    let ty: String = resolve_type(st, dest.ty)
    let src_ty: String = resolve_type(st, src.ty)
    // Use source type when dest is unknown/scalar but source is aggregate.
    // This handles match pattern bindings where the payload type is known
    // from enum info but the pattern variable type is unknown.
    let mut use_ty: String = ty
    if ty == "ptr":
        use_ty = src_ty
    if ty == "i64" && (src_ty.starts_with("%struct.") || src_ty.starts_with("%enum.") || src_ty.starts_with("{")):
        use_ty = src_ty

    // Bool: use bitwise identity (and true)
    if ty == "i1":
        return emit_line(s, "  " + dest.name + " = and i1 " + src.name + ", true")
    // Aggregate types (structs, enums, options, results, lists) cannot use `add`.
    // Use alloca/store/load to copy the value through memory.
    if use_ty.starts_with("%struct.") || use_ty.starts_with("%enum.") || use_ty.starts_with("{"):
        let tmp_a: String = dest.name + ".cpy"
        s = emit_line(s, "  " + tmp_a + " = alloca " + use_ty)
        s = emit_line(s, "  store " + use_ty + " " + src.name + ", " + "ptr " + tmp_a)
        return emit_line(s, "  " + dest.name + " = load " + use_ty + ", " + "ptr " + tmp_a)
    // Scalars (i64, double, ptr, etc.): use add 0 identity
    return emit_line(s, "  " + dest.name + " = add " + use_ty + " 0, " + src.name)

// ---------------------------------------------------------------------------
// Cast instruction
// ---------------------------------------------------------------------------

fn emit_cast(st: EmitState, dest: Value, src: Value, target_ty: MIRType) -> EmitState:
    let mut s: EmitState = st
    let sn: String = src.name
    let dn: String = dest.name

    let src_ty: String = resolve_mir_type(src.ty)
    let dst_ty: String = resolve_mir_type(target_ty)

    // Int → Float
    if src.ty.kind == TK_INT():
        if target_ty.kind == TK_FLOAT():
            s = emit_line(s, "  " + dn + " = sitofp i64 " + sn + " to double")
            return s
    // Float → Int
    if src.ty.kind == TK_FLOAT():
        if target_ty.kind == TK_INT():
            s = emit_line(s, "  " + dn + " = fptosi double " + sn + " to i64")
            return s
    // v5.16.0 Te.4.D — Int/Float/Bool → String for string interpolation.
    // Mirrors mapanare/emit_llvm_text.py::_do_cast. Emits the matching
    // `__mn_str_from_*` runtime call and tracks the fresh allocation
    // for drop-glue. Cast(String→String) collapses to emit_copy (no
    // tracker — alias of source).
    if target_ty.kind == TK_STRING():
        if src.ty.kind == TK_STRING():
            return emit_copy(s, dest, src)
        if src.ty.kind == TK_INT():
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_int", "i64 " + sn)
            s = emit_track_string(s, dn)
            return s
        if src.ty.kind == TK_FLOAT():
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_float", "double " + sn)
            s = emit_track_string(s, dn)
            return s
        if src.ty.kind == TK_BOOL():
            let cnt_zb: String = toString(s.counter)
            s.counter = s.counter + 1
            let zext_b: String = "%zb" + cnt_zb
            s = emit_line(s, "  " + zext_b + " = zext i1 " + sn + " to i64")
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_bool", "i64 " + zext_b)
            s = emit_track_string(s, dn)
            return s
        // Unknown source type — assume i64 (best-effort, matches
        // emit_builtin_tostring's fallback).
        s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_int", "i64 " + sn)
        s = emit_track_string(s, dn)
        return s
    // Fallback: bitcast
    s = emit_line(s, emit_bitcast(dn, src_ty, sn, dst_ty))
    return s

// ---------------------------------------------------------------------------
// BinOp instruction
// ---------------------------------------------------------------------------

fn emit_binop(st: EmitState, dest: Value, op: BinOpKind, lhs: Value, rhs: Value) -> EmitState:
    let mut s: EmitState = st
    let ln: String = lhs.name
    let rn: String = rhs.name

    let dn: String = dest.name
    let is_float: Bool = lhs.ty.kind == TK_FLOAT()
    let is_string: Bool = lhs.ty.kind == TK_STRING()
    let is_bool: Bool = lhs.ty.kind == TK_BOOL()
    let mut cmp_ty: String = llvm_int()
    if is_bool: cmp_ty = "i1"

    // Use binop_kind_to_str (defined in lower.mn where BinOpKind is local)
    // to convert the enum tag to a string, then dispatch with if/else
    let op_str: String = binop_kind_to_str(op)

    if op_str == "add":
        if is_string:
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_concat", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            // v5.4.1 Phase 4 — binop "+" on Strings lowers to a direct
            // emit_call_ir, bypassing the call-dispatch hook in Phase
            // 3.2. Track the heap-allocated concat result here.
            s = emit_track_string(s, dn)
        else if lhs.ty.kind == TK_LIST():
            // List concatenation: alloca both sides, call __mn_list_concat
            let la_name: String = dn + ".la"
            let ra_name: String = dn + ".ra"
            s = emit_line(s, "  " + la_name + " = alloca " + llvm_list_rt())
            s = emit_line(s, "  store " + llvm_list_rt() + " " + ln + ", ptr " + la_name)
            s = emit_line(s, "  " + ra_name + " = alloca " + llvm_list_rt())
            s = emit_line(s, "  store " + llvm_list_rt() + " " + rn + ", ptr " + ra_name)
            s = emit_rt_call(s, dn, llvm_list_rt(), "__mn_list_concat", "ptr " + la_name + ", ptr " + ra_name)
        else:
            if is_float { s = emit_line(s, emit_fadd(dn, ln, rn)) } else { s = emit_line(s, emit_add(dn, llvm_int(), ln, rn)) }
    else if op_str == "sub":
        if is_float { s = emit_line(s, emit_fsub(dn, ln, rn)) } else { s = emit_line(s, emit_sub(dn, llvm_int(), ln, rn)) }
    else if op_str == "mul":
        if is_float { s = emit_line(s, emit_fmul(dn, ln, rn)) } else { s = emit_line(s, emit_mul(dn, llvm_int(), ln, rn)) }
    else if op_str == "div":
        if is_float { s = emit_line(s, emit_fdiv(dn, ln, rn)) } else { s = emit_line(s, emit_sdiv(dn, llvm_int(), ln, rn)) }
    else if op_str == "mod":
        if is_float { s = emit_line(s, emit_frem(dn, ln, rn)) } else { s = emit_line(s, emit_srem(dn, llvm_int(), ln, rn)) }
    else if op_str == "eq":
        if is_string:
            let eq_raw_eq: String = dn + ".sr"
            s = emit_rt_call(s, eq_raw_eq, llvm_int(), "__mn_str_eq", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "ne", llvm_int(), eq_raw_eq, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "eq", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "eq", cmp_ty, ln, rn)) }
    else if op_str == "ne":
        if is_string:
            let eq_raw_ne: String = dn + ".sr"
            s = emit_rt_call(s, eq_raw_ne, llvm_int(), "__mn_str_eq", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "eq", llvm_int(), eq_raw_ne, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "ne", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "ne", cmp_ty, ln, rn)) }
    else if op_str == "lt":
        if is_string:
            let cmp_r_lt: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_lt, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "slt", llvm_int(), cmp_r_lt, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "lt", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "slt", llvm_int(), ln, rn)) }
    else if op_str == "gt":
        if is_string:
            let cmp_r_gt: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_gt, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "sgt", llvm_int(), cmp_r_gt, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "gt", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "sgt", llvm_int(), ln, rn)) }
    else if op_str == "le":
        if is_string:
            let cmp_r_le: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_le, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "sle", llvm_int(), cmp_r_le, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "le", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "sle", llvm_int(), ln, rn)) }
    else if op_str == "ge":
        if is_string:
            let cmp_r_ge: String = dn + ".sc"
            s = emit_rt_call(s, cmp_r_ge, llvm_int(), "__mn_str_cmp", llvm_string() + " " + ln + ", " + llvm_string() + " " + rn)
            s = emit_line(s, emit_icmp(dn, "sge", llvm_int(), cmp_r_ge, "0"))
        else:
            if is_float { s = emit_line(s, emit_fcmp(dn, "ge", ln, rn)) } else { s = emit_line(s, emit_icmp(dn, "sge", llvm_int(), ln, rn)) }
    else if op_str == "and":
        s = emit_line(s, emit_and_instr(dn, ln, rn))
    else if op_str == "or":
        s = emit_line(s, emit_or_instr(dn, ln, rn))
    else:
        // Fallback: add
        s = emit_line(s, emit_add(dn, llvm_int(), ln, rn))

    return s

// ---------------------------------------------------------------------------
// UnaryOp instruction
// ---------------------------------------------------------------------------

fn emit_unaryop(st: EmitState, dest: Value, op: UnaryOpKind, operand: Value) -> EmitState:
    let mut s: EmitState = st
    let on: String = operand.name
    let dn: String = dest.name
    let op_str: String = unaryop_kind_to_str(op)

    if op_str == "neg":
        if operand.ty.kind == TK_FLOAT():
            s = emit_line(s, emit_fneg(dn, on))
        else:
            s = emit_line(s, emit_neg(dn, llvm_int(), on))
        return s
    if op_str == "not":
        s = emit_line(s, emit_not(dn, on))
        return s
    return s

// ---------------------------------------------------------------------------
// StructInit instruction
// ---------------------------------------------------------------------------

fn emit_struct_init(st: EmitState, dest: Value, ty: MIRType, fields: List<FieldPair>) -> EmitState:
    let struct_ty: String = resolve_mir_type(ty)
    let mut s: EmitState = st
    let dn: String = dest.name
    let mut agg: String = "undef"
    let mut i: Int = 0

    // Lookup struct field types from the registry (more reliable than MIR types)
    let field_types: List<String> = lookup_struct_field_types(s, ty.name)

    let nfields: Int = len(fields)
    for _ in 0..500:
        if i < nfields:
            let fp: FieldPair = fields[i]
            let mut fty: String = resolve_mir_type(fp.val.ty)
            let val_name: String = fp.val.name
            // If MIR type is unknown, use the registered struct field type
            if fty == "i64" && fp.val.ty.kind == TK_UNKNOWN() && i < len(field_types):
                fty = field_types[i]
            let tmp_name: String = dn + ".f" + toString(i)
            s = emit_line(s, emit_insertvalue(tmp_name, struct_ty, agg, val_name, fty, toString(i)))
            agg = tmp_name
            i = i + 1
    // Copy the final insertvalue result to dest via alloca/store/load
    // (aggregate types cannot use `add 0` identity).
    //
    // v5.6.13 — scratch alloca renamed `.si` → `.addr` so that the
    // destination-passing path in `lower_let` (struct branch) lands
    // its binding alloca on the SAME name the emitter materializes
    // here. When dn is a v5.6.13 destination-passed name (e.g.
    // "%foo3"), `dn + ".addr"` IS the let-binding's alloca; for
    // tmp-prefixed dests (e.g. "%t<N>") this is just a rename of
    // the v5.6.12 scratch with no behavioral change (downstream
    // SROA elides it).
    if nfields > 0:
        let cpy_a: String = dn + ".addr"
        s = emit_line(s, "  " + cpy_a + " = alloca " + struct_ty)
        s = emit_line(s, "  store " + struct_ty + " " + agg + ", " + "ptr " + cpy_a)
        s = emit_line(s, "  " + dn + " = load " + struct_ty + ", " + "ptr " + cpy_a)
    return s

// ---------------------------------------------------------------------------
// FieldGet instruction
// ---------------------------------------------------------------------------

fn emit_field_get(st: EmitState, dest: Value, obj: Value, field_name: String) -> EmitState:
    let mut s: EmitState = st
    let on: String = obj.name
    let dn: String = dest.name
    let obj_ty: String = resolve_type(st, obj.ty)

    // String .len → extractvalue index 1, then mask off the is_heap
    // flag (v4.100.0 packs is_heap into bit 63 of the second eightbyte;
    // the LLVM struct type is still {ptr, i64} so LLVM hands back the
    // raw word). The C runtime sees the bitfield directly and doesn't
    // need the mask; Mapanare-emitted IR has to apply it.
    if obj.ty.kind == TK_STRING():
        if field_name == "len":
            let raw: String = dn + ".raw"
            s = emit_line(s, emit_extractvalue(raw, llvm_string(), on, "1"))
            s = emit_line(s, "  " + dn + " = and i64 " + raw + ", 9223372036854775807")
            return s
        // String methods (contains, starts_with, etc.) — not struct fields.
        // The actual call is handled by the Call instruction that follows.
        // Just pass the object through as the "method reference".
        return emit_copy(s, dest, obj)

    // List .len
    if obj.ty.kind == TK_LIST():
        if field_name == "len":
            let lt: String = llvm_list_rt()
            let tmp: String = dn + ".lp"
            s = emit_line(s, "  " + tmp + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + on + ", " + "ptr " + tmp)
            s = emit_rt_call(s, dn, llvm_int(), "__mn_list_len", "ptr " + tmp)
            return s
        // List methods (push, etc.) — pass object through
        return emit_copy(s, dest, obj)

    // Look up field index from registered structs (internal + module)
    let struct_opt: Option<StructEntry> = find_struct_entry(s, obj.ty.name)
    match struct_opt:
        Some(se) =>:
            let idx: Int = find_field_index(se.field_names, field_name)
            s = emit_line(s, emit_extractvalue(dn, obj_ty, on, toString(idx)))
            return s
        _ =>:
            // Struct not registered — emit index 0 with error to stderr
            __mn_str_eprint("ERROR: struct not registered: ")
            __mn_str_eprint(obj.ty.name)
            __mn_str_eprint(".")
            __mn_str_eprint(field_name)
            __mn_str_eprint("\n")
            s = emit_line(s, emit_extractvalue(dn, obj_ty, on, "0"))
            return s

fn find_field_index_placeholder_deleted() -> Int: return 0

fn find_field_index(fields: List<String>, name: String) -> Int:
    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(fields): return 0
        if fields[i] == name: return i
        i = i + 1
    return 0

// ---------------------------------------------------------------------------
// FieldSet instruction
// ---------------------------------------------------------------------------

fn emit_field_set(st: EmitState, obj: Value, field_name: String, val: Value) -> EmitState:
    let mut s: EmitState = st

    let val_ty: String = resolve_mir_type(val.ty)

    // Look up field index from registered structs
    let struct_opt: Option<StructEntry> = find_struct_entry(s, obj.ty.name)
    let mut idx: Int = 0
    match struct_opt:
        Some(se) =>:
            idx = find_field_index(se.field_names, field_name)
        _ =>:
            __mn_str_eprint("ERROR: struct not registered for field_set: ")
            __mn_str_eprint(obj.ty.name)
            __mn_str_eprint(".")
            __mn_str_eprint(field_name)
            __mn_str_eprint("\n")
    let struct_ty: String = resolve_type(s, obj.ty)
    if obj.name.contains(".addr"):
        let gep: String = "%" + strip_percent(obj.name) + "_fp" + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + gep + " = getelementptr inbounds " + struct_ty + ", ptr " + obj.name + ", i32 0, i32 " + toString(idx))
        s = emit_line(s, "  store " + val_ty + " " + val.name + ", ptr " + gep)
    else:
        let tmp_name: String = "%" + strip_percent(obj.name) + "_set" + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, emit_insertvalue(tmp_name, struct_ty, obj.name, val.name, val_ty, toString(idx)))
    return s

// ---------------------------------------------------------------------------
// ListInit instruction
// ---------------------------------------------------------------------------

fn strip_percent(name: String) -> String:
    if name.starts_with("%"):
        return name.substr(1, len(name) - 1)
    return name

fn has_struct(st: EmitState, name: String) -> Bool:
    let opt: Option<StructEntry> = find_struct_entry(st, name)
    match opt:
        Some(_) => return true
        _ => return false

fn try_emit_struct_construct(st: EmitState, dest: Value, fn_name: String, args: List<Value>) -> EmitState:
    // Check if fn_name is "__new_<StructName>" and emit struct construction.
    // Uses ternary expressions to avoid early returns inside if/match.
    let is_new: Bool = len(fn_name) > 6
    let mut prefix: String = ""
    if is_new: prefix = fn_name.substr(0, 6)
    let mut struct_name: String = ""
    if prefix == "__new_": struct_name = fn_name.substr(6, len(fn_name) - 6)
    let mut found: Bool = false
    if struct_name != "": found = has_struct(st, struct_name)
    let mut result: EmitState = st
    if found: result = emit_struct_init_from_values(st, dest, dest.ty, args)
    return result

fn emit_struct_init_from_values(st: EmitState, dest: Value, ty: MIRType, values: List<Value>) -> EmitState:
    // Build struct from a list of values (field order matches struct definition)
    let struct_ty: String = resolve_mir_type(ty)
    let mut s: EmitState = st
    let dn: String = dest.name
    let mut agg: String = "undef"
    let nfields: Int = len(values)

    // Lookup registered field types for this struct
    let field_types: List<String> = lookup_struct_field_types(s, ty.name)

    let mut i: Int = 0
    for _ in 0..500:
        if i < nfields:
            let v: Value = values[i]
            let mut fty: String = resolve_type(st, v.ty)
            let vname: String = v.name
            // Always prefer registered field types for struct construction.
            // MIR value types are often wrong (unknown/empty name) due to
            // COW corruption in nested lists. The emitter's struct registry
            // (from type definitions) is authoritative.
            if i < len(field_types):
                let rft: String = field_types[i]
                if len(rft) > 2 && rft != "i64":
                    fty = rft
            let tmp_name: String = dn + ".f" + toString(i)
            s = emit_line(s, emit_insertvalue(tmp_name, struct_ty, agg, vname, fty, toString(i)))
            agg = tmp_name
            i = i + 1
    // Copy the final insertvalue result to dest.
    //
    // v5.6.13 — scratch alloca renamed `.si` → `.addr` to align with
    // emit_struct_init above. See that function's comment for the
    // destination-passing rationale.
    if nfields > 0:
        let cpy_a: String = dn + ".addr"
        s = emit_line(s, "  " + cpy_a + " = alloca " + struct_ty)
        s = emit_line(s, "  store " + struct_ty + " " + agg + ", " + "ptr " + cpy_a)
        s = emit_line(s, "  " + dn + " = load " + struct_ty + ", " + "ptr " + cpy_a)
    return s

fn find_list_field_index(st: EmitState, struct_name: String, dest: Value) -> String:
    // The struct_name may be "StructName:field_name" (encoded by lowerer)
    let colon_pos: Int = struct_name.find(":")
    if colon_pos > 0:
        let base: String = strip_colon_suffix(struct_name)
        let field: String = extract_after_colon(struct_name, colon_pos)
        let opt: Option<StructEntry> = find_struct_entry(st, base)
        match opt:
            Some(se) =>:
                let idx: Int = find_field_index(se.field_names, field)
                return toString(idx)
            _ => return "0"
    return "0"

fn find_alloca_by_search(lines: List<String>, value_name: String) -> String:
    // Search FORWARD for "value_name =load TYPE, ptr %alloca"
    // Use the LAST match (most recent load of this value)
    let search_pat: String = value_name + " = load"
    let n: Int = len(lines)
    let mut result: String = ""
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= n: return result
        let line: String = lines[i]
        if line.contains(search_pat):
            let pp: Int = line.find(", ptr ")
            if pp > 0:
                result = line.substr(pp + 6, len(line) - pp - 6)
        i = i + 1
    return result

fn is_name_in_byref(byref_names: List<String>, name: String) -> Bool:
    // Check if alloca name matches a byref param EXACTLY.
    // Alloca names: "%{param_name}.addr" (params have no counter suffix).
    // Local vars: "%{name}{counter}.addr" — these should NOT match.
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(byref_names): return false
        let bn: String = byref_names[i]
        // Exact match: the alloca is %{param_name}.addr
        let expected: String = "%" + bn + ".addr"
        if name == expected: return true
        i = i + 1
    return false

// v4.112.0 docket #7: real struct size computation.
// llvm_type_size() returns 256 for all %struct.Foo (a safe upper
// bound for malloc), but that over-classifies small user structs as
// byref. is_byref_type_st() resolves %struct.Foo through the
// registered struct table and uses the inline {...} form for size
// computation, matching the Python bootstrap's _tsz behavior.
fn is_byref_type_st(st: EmitState, ty: String) -> Bool:
    // Named struct: resolve to inline {...} form via registered entry.
    if ty.starts_with("%struct."):
        let sz_real: Int = struct_byte_size(st, ty)
        if sz_real > 64: return true
        return false
    // Inline struct: compute directly.
    if ty.starts_with("{"):
        let sz_lit: Int = llvm_type_size(ty)
        if sz_lit > 64: return true
    return false

// Back-compat wrapper for any call site that lacks EmitState access.
// Uses the legacy 256 heuristic (over-classifies named structs as
// byref) — only called from contexts where st is not threaded.
fn is_byref_type(ty: String) -> Bool:
    if ty.starts_with("%struct."):
        let sz_st: Int = llvm_type_size(ty)
        if sz_st > 64: return true
        return false
    if ty.starts_with("{"):
        let sz_lit: Int = llvm_type_size(ty)
        if sz_lit > 64: return true
    return false

// Compute real byte size of a named struct type by looking up its
// llvm_type (the inline {...} form) in the struct table.
// Returns 256 as a safe upper bound if the struct is not registered
// (e.g. forward reference before registration, opaque type).
fn struct_byte_size(st: EmitState, ty: String) -> Int = llvm_sizeof_st(st, ty)
    // v5.6.10 — delegate to llvm_sizeof_st for correct recursive sizing.
    //
    // Prior body walked the struct table via llvm_aggregate_size which
    // counts ALL commas in entry.llvm_type — including those inside
    // nested aggregates like `{ptr, i64}` (a String field) — yielding
    // wrong totals (e.g. Value = 24 instead of 80; the registry stub
    // entries pushed by register_internal_struct also shadowed real
    // entries with named "%struct.X" form). v5.6.8 documented the bug
    // and tested this delegation against Ve.3; the patch was reverted
    // because it didn't close Ve.3. v5.6.10 re-applies it post-Ve.3:
    // llvm_sizeof_st uses lookup_struct_field_types which skips
    // empty-fields stub entries (v5.6.5 fix) and recursively resolves
    // each field at its real LLVM size, then 8-byte aligns each field.
    //
    // Cost: stage2.ll grows ~7% from corrected sret/byref classification
    // (more functions hit the > 16-byte threshold and switch to sret).
    // v5.6.10/PLAN.md §D2 conditions the patch on green sanitizers and
    // a preserved fixed-point — verified post-Ve.3 in the v5.6.10
    // session report.

// v5.0.4 Cb.15: compute real byte size of a named enum type.
// Inline enums: (1 + max_inline_slots) * 8 bytes.
// Boxed enums: {i64, ptr} = 16 bytes.
// Returns 16 as default if not found (all boxed enums are 16B).
fn enum_byte_size(st: EmitState, ty: String) -> Int:
    if !ty.starts_with("%enum."): return llvm_type_size(ty)
    let name: String = ty.substr(6, len(ty) - 6)
    let mut i: Int = 0
    let n: Int = len(st.enum_names)
    for _ in 0..10000:
        if i >= n: return 16
        if st.enum_names[i] == name:
            if i < len(st.enum_inline_slots):
                let slots: Int = st.enum_inline_slots[i]
                if slots > 0:
                    // Inline: tag (i64) + N payload slots (each i64)
                    return (1 + slots) * 8
            return 16
        i = i + 1
    return 16

// v5.0.4 Cb.15: ABI-aware sret classification for return types.
// Replaces is_byref_type_st for return values only. Uses per-target
// ABI classifier (abi.mn) instead of the blanket 64B threshold.
// Argument passing still uses is_byref_type_st (64B threshold).
//
// Mirrors mapanare/emit_llvm_text.py::_use_sret (v4.149.0 E5/ABI.1).
fn use_sret_return(st: EmitState, ty: String) -> Bool:
    // Scalars: never sret
    let is_agg: Bool = ty.starts_with("{") || ty.starts_with("%struct.") || ty.starts_with("%enum.")
    if !is_agg: return false
    // Compute byte size — resolve named types through tables
    let mut sz: Int = 0
    if ty.starts_with("%struct."):
        sz = struct_byte_size(st, ty)
    else:
        if ty.starts_with("%enum."):
            sz = enum_byte_size(st, ty)
        else:
            sz = llvm_type_size(ty)
    // Classify per target ABI.
    // v5.8.4 Wb.2 + v5.8.6 We.1: host-aware via EmitState's
    // is_windows + win_arch fields (set in emit_mir_module from
    // __mn_host_is_windows() + __mn_host_arch_bits()). Mirrors the
    // Python emitter's self._use_sret which dispatches off
    // self._triple. The 3-way dispatch lets i686-w64-mingw32 use
    // its > 8 B sret threshold instead of inheriting Win64 rules.
    if use_win64_abi(st):
        return abi_classify_return_sret(true, sz, "x86_64-w64-windows-gnu")
    if use_i686_abi(st):
        return abi_classify_return_sret(true, sz, "i686-w64-windows-gnu")
    return abi_classify_return_sret(true, sz, "x86_64-unknown-linux-gnu")

fn find_alloca_for_value(st: EmitState, value_name: String) -> String:
    // Scan backward through emitted lines to find:
    //   %value_name =load TYPE, ptr %ALLOCA
    // Return %ALLOCA name so FieldSet can store back.
    let search: String = value_name + " ="
    let n: Int = len(st.lines)
    let mut i: Int = n - 1
    for _ in 0..10000:
        if i < 0: return ""
        let line: String = st.lines[i]
        if line.contains(search):
            if line.contains("load"):
                let ptr_pos: Int = line.find(", ptr ")
                if ptr_pos > 0:
                    let after: String = line.substr(ptr_pos + 6, len(line) - ptr_pos - 6)
                    return after
            return ""
        i = i - 1
    return ""

fn llvm_type_size(ty: String) -> Int:
    if ty == "i1": return 1
    if ty == "i8": return 1
    if ty == "i32": return 4
    if ty == "i64": return 8
    if ty == "double": return 8
    if ty == "ptr": return 8
    if ty == "void": return 0
    // String = {ptr, i64} = 16
    if ty == llvm_string(): return 16
    // List = {ptr, i64, i64, i64, i64} = 40 (data, len, cap, elem_size, managed)
    if ty == llvm_list_rt(): return 40
    // v5.0.6 Rt.4: enum layouts depend on inline slot count:
    //   boxed        {i64, ptr}        = 16 bytes
    //   1-slot inline {i64, i64}       = 16 bytes
    //   2-slot inline {i64, i64, i64}  = 24 bytes  (Rt.1 v4.124.0)
    // llvm_type_size cannot see EmitState, so return the safe upper
    // bound (24) for any %enum.*. Callers use this for alloca/malloc
    // sizing; over-allocating by up to 8B is safe, under-allocating is
    // a latent heap overflow. The prior "always 16" hardcode + comment
    // became actively false once Rt.1 landed.
    if ty.starts_with("%enum."): return 24
    // Structs: use field_count * 32 as safe upper bound.
    // This is used for malloc allocation, so must be >= actual size.
    if ty.starts_with("%struct."): return 256
    // Aggregate types: count fields
    if ty.starts_with("{"): return llvm_aggregate_size(ty)
    return 8

fn llvm_aggregate_size(ty: String) -> Int:
    // Count comma-separated fields, each assumed 8 bytes
    let inner: String = ty.substr(1, len(ty) - 2)
    let parts: List<String> = inner.split(",")
    len(parts) * 8

// v5.6.5 Ve.1 fix — state-aware ABI byte size.
// llvm_type_size returns a hardcoded 256 for any %struct.* (safe upper
// bound in theory, but false for FnDefData = 264 bytes → malloc(256) +
// store %struct.FnDefData writes 8 B past the block). This helper
// resolves %struct.X through the registered struct table and sums
// field sizes recursively, padding each field to 8-byte alignment
// (safe for all Mapanare struct layouts — every aggregate contains at
// least one ptr/i64 field and so has align 8).
fn llvm_sizeof_st(st: EmitState, ty: String) -> Int:
    if ty.starts_with("%struct."):
        let sname: String = ty.substr(8, len(ty) - 8)
        let ftypes: List<String> = lookup_struct_field_types(st, sname)
        let nf: Int = len(ftypes)
        if nf == 0:
            // Unknown struct (forward reference or only an internal
            // empty-field_types entry registered) — fall back to the
            // legacy upper bound so we never alloc too little.
            // Self-referential fields are rewritten to `ptr` in
            // register_mir_struct, so recursion always terminates.
            return 256
        let mut total: Int = 0
        let mut i: Int = 0
        for _ in 0..500:
            if i >= nf: return total
            let mut fsz: Int = llvm_sizeof_st(st, ftypes[i])
            let rem: Int = fsz % 8
            if rem != 0: fsz = fsz + (8 - rem)
            total = total + fsz
            i = i + 1
        return total
    return llvm_type_size(ty)

fn emit_list_push_call(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    let mut s: EmitState = st
    if len(args) >= 2:
        let list_ref: String = args[0].name
        let list_ty_kind: Int = args[0].ty.kind
        let elem_name: String = args[1].name
        let mut elem_ty: String = resolve_type(st, args[1].ty)
        if elem_ty == "i64": elem_ty = resolve_mir_type(args[1].ty)
        // If type is still i64 but the list knows its element type from
        // type args, use that. Handles cross-module field access where the
        // element's own MIR type wasn't fully resolved.
        if elem_ty == "i64":
            if len(args[0].ty.args) > 0:
                let list_elem_ty: String = resolve_mir_type(args[0].ty.args[0])
                if list_elem_ty != "i64":
                    elem_ty = list_elem_ty
        // If type is still i64 but the MIR type has a struct/enum name,
        // use the named type. This handles struct-in-list push where the
        // lowerer's type info doesn't propagate through method dispatch.
        if elem_ty == "i64":
            if len(args[1].ty.name) > 0:
                if is_struct_type(st, args[1].ty.name):
                    elem_ty = "%struct." + args[1].ty.name
                if is_enum_type(st, args[1].ty.name):
                    elem_ty = "%enum." + args[1].ty.name
        let cnt: String = toString(s.counter)
        s.counter = s.counter + 1

        // Alloca element
        let ea: String = "%push_ea" + cnt
        s = emit_line(s, "  " + ea + " = alloca " + elem_ty)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + ea)

        if list_ref.contains(".addr") && list_ty_kind == TK_STRUCT():
            // Struct field push: GEP to field, load list to temp, push to temp,
            // WRITE BACK to struct field (matches Python text emitter pattern).
            let type_name: String = args[0].ty.name
            let cp: Int = type_name.find(":")
            let mut base_name: String = type_name
            if cp > 0: base_name = type_name.substr(0, cp)
            let struct_ty: String = "%struct." + base_name
            let field_idx: String = find_list_field_index(st, type_name, dest)
            let gep: String = "%push_gep" + cnt
            s = emit_line(s, "  " + gep + " = getelementptr inbounds " + struct_ty + ", ptr " + list_ref + ", i32 0, i32 " + field_idx)
            // Load list to temp alloca
            let tmp_sf: String = "%push_tmp" + cnt
            s = emit_line(s, "  " + tmp_sf + " = alloca " + llvm_list_rt())
            let ld_sf: String = "%push_ld" + cnt
            s = emit_line(s, "  " + ld_sf + " = load " + llvm_list_rt() + ", ptr " + gep)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + ld_sf + ", ptr " + tmp_sf)
            // Push to temp
            s = emit_rt_call_void(s, "__mn_list_push", "ptr " + tmp_sf + ", ptr " + ea)
            // Write back to struct field
            let wb_sf: String = "%push_wb" + cnt
            s = emit_line(s, "  " + wb_sf + " = load " + llvm_list_rt() + ", ptr " + tmp_sf)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + wb_sf + ", ptr " + gep)
        else if list_ref.contains(".addr"):
            // Simple alloca push: same temp+writeback pattern
            let tmp_sa: String = "%push_tmp" + cnt
            s = emit_line(s, "  " + tmp_sa + " = alloca " + llvm_list_rt())
            let ld_sa: String = "%push_ld" + cnt
            s = emit_line(s, "  " + ld_sa + " = load " + llvm_list_rt() + ", ptr " + list_ref)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + ld_sa + ", ptr " + tmp_sa)
            s = emit_rt_call_void(s, "__mn_list_push", "ptr " + tmp_sa + ", ptr " + ea)
            let wb_sa: String = "%push_wb" + cnt
            s = emit_line(s, "  " + wb_sa + " = load " + llvm_list_rt() + ", ptr " + tmp_sa)
            s = emit_line(s, "  store " + llvm_list_rt() + " " + wb_sa + ", ptr " + list_ref)
        else:
            // Loaded list value — create temp alloca
            let la: String = "%push_la" + cnt
            s = emit_line(s, "  " + la + " = alloca " + llvm_list_rt())
            s = emit_line(s, "  store " + llvm_list_rt() + " " + list_ref + ", ptr " + la)
            s = emit_rt_call_void(s, "__mn_list_push", "ptr " + la + ", ptr " + ea)
    s

fn emit_list_init(st: EmitState, dest: Value, elem_ty: MIRType, elements: List<Value>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name

    // v5.6.5 Ve.1 fix — use GEP-trick for known aggregate element
    // types so LLVM's DataLayout computes the exact size at link time.
    //
    // v5.6.12 Lk.1 fix — scalar gate. With Lk.1 closed via destination
    // passing in lower_let (lower.mn::lower_let_list_hint path), the
    // 384-byte floor is no longer needed to mask the alloca-aliasing
    // leak. Use the actual LLVM type size for known scalar elem_ty
    // (Int=8, Float=8, Bool=8, ptr=8). The floor is retained ONLY for
    // genuinely-unknown elem_ty.kind, where we can't see the type at
    // emit time and a defensive over-allocation is cheaper than a
    // miscompile.
    //
    // Why this is safe now (not at v5.6.10): Lk.1's leak was never
    // about element sizing — it was about ListInit and the let-binding
    // pointing at different allocas. v5.6.12's destination passing
    // unifies them. Mutating pushes write to the same alloca that
    // drop-glue frees. The scalar gate just stops over-allocating
    // ~376 bytes of dead stack space per List<scalar>.
    let list_name: String = dn + ".new"
    let elem_llvm_ty: String = resolve_mir_type(elem_ty)
    let mut use_gep_trick: Bool = false
    if elem_llvm_ty.starts_with("%struct."): use_gep_trick = true
    if elem_llvm_ty.starts_with("%enum."): use_gep_trick = true
    if elem_llvm_ty.starts_with("{"): use_gep_trick = true
    if use_gep_trick:
        let elem_sz: String = dn + ".elem.sz"
        s = emit_line(s, "  " + elem_sz + " = ptrtoint ptr getelementptr (" + elem_llvm_ty + ", ptr null, i32 1) to i64")
        s = emit_rt_call(s, list_name, llvm_list_rt(), "__mn_list_new", "i64 " + elem_sz)
    else:
        let mut elem_sz_n: Int = llvm_type_size(elem_llvm_ty)
        if elem_ty.kind == TK_UNKNOWN():
            // Genuinely unknown elem_ty — keep a defensive 384-byte
            // floor. Investigation candidate for v5.6.13: every UNKNOWN
            // here is a potential lowerer-side gap (let lower_let_list_hint
            // failed to propagate the type).
            if elem_sz_n < 384: elem_sz_n = 384
        s = emit_rt_call(s, list_name, llvm_list_rt(), "__mn_list_new", "i64 " + toString(elem_sz_n))

    // v5.4.1 Phase 3.7 — hoist the alloca to the entry-block prelude
    // so it dominates drop-glue loads at every function exit, even
    // when emit_list_init is invoked from a conditional sub-block.
    // Zero-init the storage so __mn_list_free's null-data-ptr check
    // no-ops if the init store was bypassed by control flow.
    let alloca_name: String = dn + ".addr"
    s.entry_prelude_lines.push("  " + alloca_name + " = alloca " + llvm_list_rt() + ", align 8")
    s.entry_prelude_lines.push("  store " + llvm_list_rt() + " zeroinitializer, ptr " + alloca_name)
    // The init store stays at the original emission point.
    s = emit_line(s, llvm_store(llvm_list_rt(), list_name, alloca_name))
    let list_owned_name: String = ret_val_base(alloca_name)
    s.list_owned.push(list_owned_name)
    // v5.4.4 — parallel source: record the bare list-var name (e.g.
    // "t10") so drop glue can match Move(t10) from the lowerer.
    s.list_owned_source.push(ret_val_base(dn))

    // Push each element
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(elements):
            // Load final list
            let final_list: String = dest.name
            s = emit_line(s, llvm_load(final_list, llvm_list_rt(), alloca_name))
            return s
        let elem: Value = elements[i]
        let ety: String = resolve_mir_type(elem.ty)
        let elem_alloca: String = dn + ".e" + toString(i)
        s = emit_line(s, llvm_alloca(elem_alloca, ety))
        s = emit_line(s, llvm_store(ety, elem.name, elem_alloca))
        let cast_name: String = dn + ".c" + toString(i)
        s = emit_line(s, emit_bitcast(cast_name, ety + "*", elem_alloca, "ptr"))
        s = emit_rt_call_void(s, "__mn_list_push", "ptr " + alloca_name + ", ptr " + cast_name)
        i = i + 1
    return s

// ---------------------------------------------------------------------------
// IndexGet instruction
// ---------------------------------------------------------------------------

fn emit_index_get(st: EmitState, dest: Value, obj: Value, idx: Value) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name

    // String indexing → char_at
    if obj.ty.kind == TK_STRING():
        s = emit_rt_call(s, dn, llvm_string(), "__mn_str_char_at", llvm_string() + " " + obj.name + ", i64 " + idx.name)
        return s

    // Map indexing → __mn_map_get(map_ptr, key_ptr)
    if obj.ty.kind == TK_MAP():
        let cnt_mg: String = toString(s.counter)
        s.counter = s.counter + 1
        let idx_ty: String = resolve_type(st, idx.ty)
        // Extract map pointer
        let mptr: String = "%mg_mptr" + cnt_mg
        if obj.name.contains(".addr"):
            let mld: String = "%mg_mld" + cnt_mg
            s = emit_line(s, "  " + mld + " = load " + llvm_map_type() + ", ptr " + obj.name)
            s = emit_line(s, "  " + mptr + " = extractvalue " + llvm_map_type() + " " + mld + ", 0")
        else:
            s = emit_line(s, "  " + mptr + " = extractvalue " + llvm_map_type() + " " + obj.name + ", 0")
        // Alloca key
        let ka: String = "%mg_ka" + cnt_mg
        s = emit_line(s, "  " + ka + " = alloca " + idx_ty)
        s = emit_line(s, "  store " + idx_ty + " " + idx.name + ", ptr " + ka)
        // Call __mn_map_get → ptr to value
        let vptr: String = "%mg_vp" + cnt_mg
        s = emit_line(s, "  " + vptr + " = call ptr @__mn_map_get(ptr " + mptr + ", ptr " + ka + ")")
        // Load value from pointer
        let dest_ty: String = resolve_type(st, dest.ty)
        if dest_ty != "i64" && dest_ty != "ptr":
            s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + vptr)
        else:
            s = emit_line(s, "  " + dn + " = load i64, ptr " + vptr)
        return s

    // List indexing
    let lt: String = llvm_list_rt()
    let tmp: String = dn + ".lp"
    s = emit_line(s, "  " + tmp + " = alloca " + lt)
    s = emit_line(s, "  store " + lt + " " + obj.name + ", " + "ptr " + tmp)

    let dest_ty: String = resolve_type(st, dest.ty)

    // v5.1.0 Perf.1: inline list access for 8-byte value-type elements.
    // Replaces opaque call @__mn_list_get with GEP+load so LLVM can see
    // through to the backing buffer (enables SROA, vectorization, hoisting).
    if dest_ty == "i64" || dest_ty == "double" || dest_ty == "ptr":
        let cnt_lg: String = toString(s.counter)
        s.counter = s.counter + 1
        // Inline bounds check (unsigned covers negative indices)
        let lenp: String = "%lg.lenp." + cnt_lg
        s = emit_line(s, "  " + lenp + " = getelementptr inbounds " + lt + ", ptr " + tmp + ", i32 0, i32 1")
        let ln: String = "%lg.len." + cnt_lg
        s = emit_line(s, "  " + ln + " = load i64, ptr " + lenp)
        let oob: String = "%lg.oob." + cnt_lg
        s = emit_line(s, "  " + oob + " = icmp uge i64 " + idx.name + ", " + ln)
        let trap_lbl: String = "lg.trap." + cnt_lg
        let ok_lbl: String = "lg.ok." + cnt_lg
        s = emit_line(s, "  br i1 " + oob + ", label %" + trap_lbl + ", label %" + ok_lbl)
        // Trap block
        s = emit_line(s, trap_lbl + ":")
        s = emit_line(s, "  call void @abort()")
        s = emit_line(s, "  unreachable")
        // Fast path: inline GEP + load
        s = emit_line(s, ok_lbl + ":")
        let dp: String = "%lg.dp." + cnt_lg
        s = emit_line(s, "  " + dp + " = getelementptr inbounds " + lt + ", ptr " + tmp + ", i32 0, i32 0")
        let data: String = "%lg.data." + cnt_lg
        s = emit_line(s, "  " + data + " = load ptr, ptr " + dp)
        // v5.6.11 Ve.4 — use runtime elem_size for the offset, not a constant
        // i64 stride. The 7 Ve.2 residual sites (`build_match_arms` and 5
        // others) allocate `List<Int> = []` with elem_size=384 (Lk.1 floor);
        // `__mn_list_push` writes at idx * 384 while a constant-stride GEP
        // would read at idx * 8 — mismatch produces garbage reads of
        // intra-buffer spillage. Loading elem_size from list field 3 makes
        // the read consistent with the push regardless of allocator stride.
        // SROA still elides this when elem_size is a known constant 8.
        let eszp: String = "%lg.eszp." + cnt_lg
        s = emit_line(s, "  " + eszp + " = getelementptr inbounds " + lt + ", ptr " + tmp + ", i32 0, i32 3")
        let esz: String = "%lg.esz." + cnt_lg
        s = emit_line(s, "  " + esz + " = load i64, ptr " + eszp)
        let off: String = "%lg.off." + cnt_lg
        s = emit_line(s, "  " + off + " = mul i64 " + idx.name + ", " + esz)
        let ep: String = "%lg.ep." + cnt_lg
        s = emit_line(s, "  " + ep + " = getelementptr inbounds i8, ptr " + data + ", i64 " + off)
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + ep)
    else:
        // Slow path: opaque call for String, Bool, structs, etc.
        let raw: String = dn + ".raw"
        s = emit_rt_call(s, raw, "ptr", "__mn_list_get", "ptr " + tmp + ", i64 " + idx.name)
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + raw)
    return s

// ---------------------------------------------------------------------------
// IndexSet instruction
// ---------------------------------------------------------------------------

fn emit_index_set(st: EmitState, obj: Value, idx: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let list_ref: String = obj.name
    let idx_name: String = idx.name
    let elem_name: String = val.name
    let elem_ty: String = resolve_type(st, val.ty)
    let cnt: String = toString(s.counter)
    s.counter = s.counter + 1

    // Map index set: entries[key] = value → __mn_map_set
    if obj.ty.kind == TK_MAP():
        let idx_ty: String = resolve_type(st, idx.ty)
        // Alloca key
        let ka: String = "%set_ka" + cnt
        s = emit_line(s, "  " + ka + " = alloca " + idx_ty)
        s = emit_line(s, "  store " + idx_ty + " " + idx_name + ", ptr " + ka)
        // Alloca value
        let va: String = "%set_va" + cnt
        s = emit_line(s, "  " + va + " = alloca " + elem_ty)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + va)
        // Load map pointer from alloca or value
        if list_ref.contains(".addr"):
            let map_ld: String = "%set_mld" + cnt
            s = emit_line(s, "  " + map_ld + " = load " + llvm_map_type() + ", ptr " + list_ref)
            let map_ptr: String = "%set_mptr" + cnt
            s = emit_line(s, "  " + map_ptr + " = extractvalue " + llvm_map_type() + " " + map_ld + ", 0")
            s = emit_rt_call_void(s, "__mn_map_set", "ptr " + map_ptr + ", ptr " + ka + ", ptr " + va)
        else:
            let map_ptr: String = "%set_mptr" + cnt
            s = emit_line(s, "  " + map_ptr + " = extractvalue " + llvm_map_type() + " " + list_ref + ", 0")
            s = emit_rt_call_void(s, "__mn_map_set", "ptr " + map_ptr + ", ptr " + ka + ", ptr " + va)
        return s

    // v5.1.0 Perf.1: inline list store for 8-byte value-type elements.
    let lt: String = llvm_list_rt()
    if elem_ty == "i64" || elem_ty == "double" || elem_ty == "ptr":
        // Build temp alloca for list value
        let la: String = "%ls.la" + cnt
        if list_ref.contains(".addr"):
            let ld: String = "%ls.ld" + cnt
            s = emit_line(s, "  " + la + " = alloca " + lt)
            s = emit_line(s, "  " + ld + " = load " + lt + ", ptr " + list_ref)
            s = emit_line(s, "  store " + lt + " " + ld + ", ptr " + la)
        else:
            s = emit_line(s, "  " + la + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + list_ref + ", ptr " + la)
        // Inline bounds check
        let lenp: String = "%ls.lenp." + cnt
        s = emit_line(s, "  " + lenp + " = getelementptr inbounds " + lt + ", ptr " + la + ", i32 0, i32 1")
        let ln: String = "%ls.len." + cnt
        s = emit_line(s, "  " + ln + " = load i64, ptr " + lenp)
        let oob: String = "%ls.oob." + cnt
        s = emit_line(s, "  " + oob + " = icmp uge i64 " + idx_name + ", " + ln)
        let trap_lbl: String = "ls.trap." + cnt
        let ok_lbl: String = "ls.ok." + cnt
        s = emit_line(s, "  br i1 " + oob + ", label %" + trap_lbl + ", label %" + ok_lbl)
        // Trap block
        s = emit_line(s, trap_lbl + ":")
        s = emit_line(s, "  call void @abort()")
        s = emit_line(s, "  unreachable")
        // Fast path: inline GEP + store
        s = emit_line(s, ok_lbl + ":")
        let dp: String = "%ls.dp." + cnt
        s = emit_line(s, "  " + dp + " = getelementptr inbounds " + lt + ", ptr " + la + ", i32 0, i32 0")
        let data: String = "%ls.data." + cnt
        s = emit_line(s, "  " + data + " = load ptr, ptr " + dp)
        // v5.6.11 Ve.4 — symmetric to emit_index_get: use runtime elem_size
        // for offset so the store stride matches `__mn_list_push`'s runtime
        // stride. See emit_index_get site for the full reasoning; without
        // this, `arr[i] = v` on a List<Int> allocated with the 384-byte
        // floor writes at offset i*8 while pushes write at offset i*384.
        let eszp: String = "%ls.eszp." + cnt
        s = emit_line(s, "  " + eszp + " = getelementptr inbounds " + lt + ", ptr " + la + ", i32 0, i32 3")
        let esz: String = "%ls.esz." + cnt
        s = emit_line(s, "  " + esz + " = load i64, ptr " + eszp)
        let off: String = "%ls.off." + cnt
        s = emit_line(s, "  " + off + " = mul i64 " + idx_name + ", " + esz)
        let ep: String = "%ls.ep." + cnt
        s = emit_line(s, "  " + ep + " = getelementptr inbounds i8, ptr " + data + ", i64 " + off)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + ep)
    else:
        // Slow path: opaque call for String, structs, etc.
        let ea: String = "%set_ea" + cnt
        s = emit_line(s, "  " + ea + " = alloca " + elem_ty)
        s = emit_line(s, "  store " + elem_ty + " " + elem_name + ", ptr " + ea)

        if list_ref.contains(".addr"):
            let tmp_addr: String = "%set_tmp" + cnt
            s = emit_line(s, "  " + tmp_addr + " = alloca " + lt)
            let ld: String = "%set_ld" + cnt
            s = emit_line(s, "  " + ld + " = load " + lt + ", ptr " + list_ref)
            s = emit_line(s, "  store " + lt + " " + ld + ", ptr " + tmp_addr)
            s = emit_rt_call_void(s, "__mn_list_set", "ptr " + tmp_addr + ", i64 " + idx_name + ", ptr " + ea)
            let wb: String = "%set_wb" + cnt
            s = emit_line(s, "  " + wb + " = load " + lt + ", ptr " + tmp_addr)
            s = emit_line(s, "  store " + lt + " " + wb + ", ptr " + list_ref)
        else:
            let tmp_val: String = "%set_tmp" + cnt
            s = emit_line(s, "  " + tmp_val + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + list_ref + ", ptr " + tmp_val)
            s = emit_rt_call_void(s, "__mn_list_set", "ptr " + tmp_val + ", i64 " + idx_name + ", ptr " + ea)
    return s

// ---------------------------------------------------------------------------
// Alloca/Load/Store instructions
// ---------------------------------------------------------------------------

fn emit_alloca(st: EmitState, dest: Value, ty: MIRType) -> EmitState = emit_line(st, llvm_alloca(dest.name, resolve_type(st, ty)))

fn emit_load(st: EmitState, dest: Value, ptr: Value) -> EmitState = emit_line(st, llvm_load(dest.name, resolve_type(st, dest.ty), ptr.name))

fn emit_store(st: EmitState, ptr: Value, val: Value) -> EmitState:
    let val_ty: String = resolve_type(st, val.ty)
    let ptr_ty: String = resolve_type(st, ptr.ty)
    // When storing a generic None ({i1, ptr}) to a specific Option alloca
    // ({i1, %enum.T}), use zeroinitializer with the alloca's type instead.
    // None has tag=0 and null payload — zeroinitializer is equivalent.
    if val.ty.kind == TK_OPTION() && ptr_ty != val_ty && ptr_ty.starts_with("{"):
        return emit_line(st, "  store " + ptr_ty + " zeroinitializer, " + "ptr " + ptr.name)
    return emit_line(st, llvm_store(val_ty, val.name, ptr.name))

// ---------------------------------------------------------------------------
// MapInit instruction
// ---------------------------------------------------------------------------

fn emit_map_init(st: EmitState, dest: Value, key_ty: MIRType, val_ty: MIRType, pairs: List<KVPair>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    let cnt: String = toString(s.counter)
    s.counter = s.counter + 1

    // Determine key type tag: 0=int, 1=str, 2=float
    let mut key_tag: String = "1"
    if key_ty.kind == TK_INT(): key_tag = "0"
    if key_ty.kind == TK_FLOAT(): key_tag = "2"

    // v4.32.0 Phase 1.2: val_tag mirrors the Python bootstrap at
    // emit_llvm_text.py:3160 — 1 for String val types (so the runtime
    // knows to apply the heap-tag low-bit strip on reads), 0 otherwise.
    let mut val_tag: String = "0"
    if val_ty.kind == TK_STRING(): val_tag = "1"

    // Key/val sizes: strings are 16 bytes ({ptr,i64}), ints are 8 bytes
    // Default val_size = 16 to safely handle enums/strings in untyped empty maps
    let mut key_size: String = "16"
    let mut val_size: String = "16"
    if key_ty.kind == TK_INT(): key_size = "8"
    if key_ty.kind == TK_FLOAT(): key_size = "8"
    if val_ty.kind == TK_INT(): val_size = "8"
    if val_ty.kind == TK_FLOAT(): val_size = "8"
    if val_ty.kind == TK_BOOL(): val_size = "8"
    if val_ty.kind == TK_STRUCT(): val_size = "64"
    if val_ty.kind == TK_ENUM(): val_size = "64"

    // Call __mn_map_new(key_size, val_size, key_type, val_type) — 4 args
    // (v4.32.0 Phase 1.2 closes the arity mismatch flagged as a 7-cycle
    // carry-forward by Rattler at the v4.31.0 arc-end panel).
    let map_ptr: String = dn + ".mp"
    s = emit_line(s, "  " + map_ptr + " = call ptr @__mn_map_new(i64 " + key_size + ", i64 " + val_size + ", i64 " + key_tag + ", i64 " + val_tag + ")")

    // Insert each pair
    let npairs: Int = len(pairs)
    let mut i: Int = 0
    for _ in 0..1000:
        if i >= npairs:
            // Store map pointer into result: {ptr, i64} with ptr=map, i64=0
            s = emit_line(s, "  " + dn + ".s0 =insertvalue {ptr, i64} undef, ptr " + map_ptr + ", 0")
            s = emit_line(s, "  " + dn + " = insertvalue {ptr, i64} " + dn + ".s0, i64 0, 1")
            return s
        let pair: KVPair = pairs[i]
        let pi: String = toString(i)
        let k_ty: String = resolve_mir_type(pair.key.ty)
        let v_ty: String = resolve_mir_type(pair.val.ty)
        // Alloca key, store, bitcast to ptr
        let ka: String = dn + ".k" + pi
        s = emit_line(s, "  " + ka + " = alloca " + k_ty)
        s = emit_line(s, "  store " + k_ty + " " + pair.key.name + ", ptr " + ka)
        // Alloca val, store, bitcast to ptr
        let va: String = dn + ".v" + pi
        s = emit_line(s, "  " + va + " = alloca " + v_ty)
        s = emit_line(s, "  store " + v_ty + " " + pair.val.name + ", ptr " + va)
        // Call __mn_map_set(map, key_ptr, val_ptr)
        s = emit_rt_call_void(s, "__mn_map_set", "ptr " + map_ptr + ", ptr " + ka + ", ptr " + va)
        i = i + 1

    // Fallback: return empty map
    s = emit_line(s, "  " + dn + ".s0 =insertvalue {ptr, i64} undef, ptr " + map_ptr + ", 0")
    s = emit_line(s, "  " + dn + " = insertvalue {ptr, i64} " + dn + ".s0, i64 0, 1")
    return s

// ---------------------------------------------------------------------------
// EnumInit instruction
// ---------------------------------------------------------------------------

fn pack_to_i64(st: EmitState, val: String, ft: String, pk_name: String) -> EmitState:
    let mut s: EmitState = st
    if ft == "i64": return s
    if ft == "double":
        s = emit_line(s, "  " + pk_name + " = bitcast double " + val + " to i64")
        return next_ssa(s)
    if ft == "i1" || ft == "i8" || ft == "i16" || ft == "i32":
        s = emit_line(s, "  " + pk_name + " = zext " + ft + " " + val + " to i64")
        return next_ssa(s)
    if ft == "ptr":
        s = emit_line(s, "  " + pk_name + " = ptrtoint ptr " + val + " to i64")
        return next_ssa(s)
    return s

fn unpack_from_i64(st: EmitState, val: String, ft: String, upk_name: String) -> EmitState:
    let mut s: EmitState = st
    if ft == "i64": return s
    if ft == "double":
        s = emit_line(s, "  " + upk_name + " = bitcast i64 " + val + " to double")
        return next_ssa(s)
    if ft == "i1" || ft == "i8" || ft == "i16" || ft == "i32":
        s = emit_line(s, "  " + upk_name + " = trunc i64 " + val + " to " + ft)
        return next_ssa(s)
    if ft == "ptr":
        s = emit_line(s, "  " + upk_name + " = inttoptr i64 " + val + " to ptr")
        return next_ssa(s)
    return s

fn emit_enum_init(st: EmitState, dest: Value, ty: MIRType, variant: String, payload: List<Value>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    let tag_val: String = toString(resolve_variant_index(s, ty.name, variant))
    let enum_ty: String = resolve_mir_type(ty)
    let inline_slots: Int = lookup_enum_inline(s, ty.name)

    // v4.140.0 Cb.5: inline enum — pack payload fields into i64 slots.
    // Use named enum type (%enum.X) for insertvalue so SSA type matches the
    // declared function return / alloca types downstream.
    if inline_slots > 0:
        let n_slots: Int = max_int(inline_slots, 1)
        let mut cur: String = dn + ".ei0"
        s = emit_line(s, "  " + cur + " = insertvalue " + enum_ty + " undef, i64 " + tag_val + ", 0")
        s = next_ssa(s)
        let mut slot_i: Int = 0
        for _ in 0..3:
            if slot_i < n_slots:
                // Last slot writes to dn; earlier slots to temporaries.
                let mut nxt: String = dn + ".ei" + toString(slot_i + 1)
                if slot_i == n_slots - 1: nxt = dn
                if slot_i < len(payload):
                    let p: Value = payload[slot_i]
                    let ft: String = resolve_mir_type(p.ty)
                    if ft == "i64":
                        s = emit_line(s, "  " + nxt + " = insertvalue " + enum_ty + " " + cur + ", i64 " + p.name + ", " + toString(slot_i + 1))
                    else:
                        let pk: String = dn + ".pk" + toString(slot_i)
                        s = pack_to_i64(s, p.name, ft, pk)
                        s = emit_line(s, "  " + nxt + " = insertvalue " + enum_ty + " " + cur + ", i64 " + pk + ", " + toString(slot_i + 1))
                else:
                    s = emit_line(s, "  " + nxt + " = insertvalue " + enum_ty + " " + cur + ", i64 0, " + toString(slot_i + 1))
                cur = nxt
                slot_i = slot_i + 1
        return s

    // Boxed enum: { i64 tag, ptr payload } — existing path.
    //
    // v5.6.5 Ve.1 fix — defer sizing + offsets to LLVM via the GEP-trick
    // and typed GEPs. Matches Python's `_do_enum_init` at
    // emit_llvm_text.py:4770-4809: build an inline payload struct type,
    // ask LLVM for its ABI size via `ptrtoint ptr gep (<psty>, null, i32 1)`,
    // and address fields with `getelementptr <psty>, ptr, i32 0, i32 <idx>`.
    // LLVM's DataLayout resolves both at link time — no hand-computed
    // sizes, no "safe upper bound" hacks. Prior approach used hardcoded
    // 256-byte fallbacks for any `%struct.*` (caused FnDefData's 8-byte
    // overflow at parse_fn_body) and hand-summed field offsets that
    // diverged from LLVM's actual layout.
    if len(payload) > 0:
        let payload_ty: String = build_payload_type_from_values(s, payload)
        let ep: String = dn + ".ep"
        let sz: String = dn + ".sz"
        s = emit_line(s, "  " + sz + " = ptrtoint ptr getelementptr (" + payload_ty + ", ptr null, i32 1) to i64")
        s = emit_line(s, "  " + ep + " = call ptr @malloc(i64 " + sz + ")")
        let mut i: Int = 0
        let npayload: Int = len(payload)
        for _ in 0..100:
            if i < npayload:
                let p: Value = payload[i]
                let mut pty: String = resolve_mir_type(p.ty)
                // struct→enum rewrite (MIR may have kind:"struct" for enums)
                if pty.starts_with("%struct."):
                    if is_enum_type(s, p.ty.name):
                        pty = "%enum." + p.ty.name
                let ef: String = dn + ".ef" + toString(i)
                s = emit_line(s, "  " + ef + " = getelementptr inbounds " + payload_ty + ", ptr " + ep + ", i32 0, i32 " + toString(i))
                s = emit_line(s, "  store " + pty + " " + p.name + ", ptr " + ef)
                i = i + 1
        // v5.4.2 Phase 3.2 — track the payload box for drop glue. The
        // box is malloc'd here and owned by this frame; caller is the
        // sole owner after return. Aggregate-return escape guard in
        // emit_drop_glue already suppresses drops when the enum escapes
        // as an aggregate return value (see v5.4.1 Phase 4), so this
        // tracking is UAF-safe and closes the 50_match_or_patterns leak:
        //   fn main() { print(category(Token::Ident("x"))) }
        // where the box is consumed locally and never escapes.
        s = emit_track_boxed(s, ep)
        let ei1_pay: String = dn + ".ei1"
        s = emit_line(s, "  " + ei1_pay + " = insertvalue " + enum_ty + " undef, i64 " + tag_val + ", 0")
        s = emit_line(s, "  " + dn + " = insertvalue " + enum_ty + " " + ei1_pay + ", ptr " + ep + ", 1")
    else:
        let ei1_bare: String = dn + ".ei1"
        s = emit_line(s, "  " + ei1_bare + " = insertvalue " + enum_ty + " undef, i64 " + tag_val + ", 0")
        s = emit_line(s, "  " + dn + " = insertvalue " + enum_ty + " " + ei1_bare + ", ptr null, 1")
    return s

// v5.6.5 Ve.1 fix — build an inline LLVM struct type from a payload
// value list. Used by emit_enum_init so LLVM's DataLayout computes
// both the allocation size and per-field offsets correctly — matches
// Python's `psty = "{" + ", ".join(pflds) + "}"` in _do_enum_init.
fn build_payload_type_from_values(st: EmitState, payload: List<Value>) -> String:
    let mut result: String = "{ "
    let mut i: Int = 0
    let n: Int = len(payload)
    for _ in 0..100:
        if i >= n:
            return result + " }"
        let mut pty: String = resolve_mir_type(payload[i].ty)
        if pty.starts_with("%struct."):
            if is_enum_type(st, payload[i].ty.name):
                pty = "%enum." + payload[i].ty.name
        if i > 0:
            result = result + ", " + pty
        else:
            result = result + pty
        i = i + 1
    return result + " }"

// v5.6.5 Ve.1 fix — counterpart to build_payload_type_from_values,
// but resolves payload types from the enum registry (for extraction
// sites where we have a variant name rather than a value list).
// Returns "{ }" if the variant is unknown.
fn build_payload_type_from_variant(st: EmitState, enum_name: String, variant_name: String) -> String:
    let mut ei: Int = 0
    let nenums: Int = len(st.enum_infos)
    for _ in 0..500:
        if ei >= nenums: return "{ }"
        let info: EnumInfo = st.enum_infos[ei]
        if info.name == enum_name:
            let mut vi: Int = 0
            let nvar: Int = len(info.variants)
            for _ in 0..500:
                if vi >= nvar: return "{ }"
                if info.variants[vi].name == variant_name:
                    let types: List<MIRType> = info.variants[vi].payload_types
                    let mut result: String = "{ "
                    let mut fi: Int = 0
                    let nfty: Int = len(types)
                    for _ in 0..100:
                        if fi >= nfty:
                            return result + " }"
                        let mut pty: String = resolve_mir_type(types[fi])
                        if pty.starts_with("%struct."):
                            if is_enum_type(st, types[fi].name):
                                pty = "%enum." + types[fi].name
                        if fi > 0:
                            result = result + ", " + pty
                        else:
                            result = result + pty
                        fi = fi + 1
                    return result + " }"
                vi = vi + 1
        ei = ei + 1
    return "{ }"

fn compute_payload_alloc_size(st: EmitState, payload: List<Value>) -> Int:
    let mut total: Int = 0
    let mut i: Int = 0
    for _ in 0..100:
        if i >= len(payload): return total
        let mut pty: String = resolve_mir_type(payload[i].ty)
        // Same struct→enum rewrite as compute_field_offset — ensures
        // the size used here matches the field offsets below.
        if pty.starts_with("%struct."):
            if is_enum_type(st, payload[i].ty.name):
                pty = "%enum." + payload[i].ty.name
        let mut psz: Int = llvm_sizeof_st(st, pty)
        let rem: Int = psz % 8
        if rem != 0: psz = psz + (8 - rem)
        total = total + psz
        i = i + 1
    return total

fn compute_field_offset(st: EmitState, payload: List<Value>, field_idx: Int) -> Int:
    let mut offset: Int = 0
    let mut i: Int = 0
    for _ in 0..100:
        if i >= field_idx: return offset
        let mut pty: String = resolve_mir_type(payload[i].ty)
        // Fix struct→enum misclassification
        if pty.starts_with("%struct."):
            if is_enum_type(st, payload[i].ty.name):
                pty = "%enum." + payload[i].ty.name
        let mut fsz: Int = llvm_sizeof_st(st, pty)
        let rem: Int = fsz % 8
        if rem != 0: fsz = fsz + (8 - rem)
        offset = offset + fsz
        i = i + 1
    return offset

fn resolve_variant_index(st: EmitState, enum_name: String, variant: String) -> Int:
    // Strip ":N" suffix if present (from indexed payload extraction)
    let mut vname: String = variant
    let colon: Int = variant.find(":")
    if colon >= 0:
        vname = variant.substr(0, colon)
    let mut i: Int = 0
    let neinfos2: Int = len(st.enum_infos)
    for _ in 0..500:
        if i < neinfos2:
            let info: EnumInfo = st.enum_infos[i]
            if info.name == enum_name:
                let mut vi: Int = 0
                let nvariants: Int = len(info.variants)
                for _ in 0..500:
                    if vi < nvariants:
                        if info.variants[vi].name == vname:
                            return vi
                        vi = vi + 1
            i = i + 1
    return 0

// Parse field index from "Variant:N" format. Returns N (0 if no colon).
// Uses return instead of conditional assignment (Python lowerer drops if-assignments).
fn parse_field_index(variant: String) -> Int:
    let colon_pos: Int = variant.find(":")
    if colon_pos < 0: return 0
    let idx_char: String = variant.char_at(colon_pos + 1)
    return int(idx_char)

// Strip ":N" suffix from "Variant:N".
fn strip_colon_suffix(s: String) -> String:
    let colon_pos: Int = s.find(":")
    if colon_pos < 0: return s
    return s.substr(0, colon_pos)

// Extract everything after ":".
fn extract_after_colon(s: String, colon_pos: Int) -> String:
    let slen: Int = len(s)
    let start: Int = colon_pos + 1
    if start >= slen: return ""
    return s.substr(start, slen - start)

// Compute byte offset to field_idx within a variant's payload.
// Sums llvm_type_size of fields 0..field_idx-1.
fn compute_payload_offset(st: EmitState, enum_name: String, variant_name: String, field_idx: Int) -> Int:
    let mut ei: Int = 0
    for _ in 0..500:
        if ei >= len(st.enum_infos): return 0
        let info: EnumInfo = st.enum_infos[ei]
        if info.name == enum_name:
            let mut vi: Int = 0
            for _ in 0..500:
                if vi >= len(info.variants): return 0
                if info.variants[vi].name == variant_name:
                    return sum_field_sizes(st, info.variants[vi].payload_types, field_idx)
                vi = vi + 1
        ei = ei + 1
    return 0

// Sum llvm_sizeof_st for fields 0..count-1 (v5.6.5 Ve.1: state-aware
// sizing so %struct.* resolves to the real registered size).
fn sum_field_sizes(st: EmitState, types: List<MIRType>, count: Int) -> Int:
    let mut total: Int = 0
    let mut i: Int = 0
    for _ in 0..100:
        if i >= count: return total
        let mut pty: String = resolve_mir_type(types[i])
        // Fix struct→enum misclassification: MIR may have kind:"struct" for enums
        if pty.starts_with("%struct."):
            let tname: String = types[i].name
            if is_enum_type(st, tname):
                pty = "%enum." + tname
        let mut fsz: Int = llvm_sizeof_st(st, pty)
        let rem: Int = fsz % 8
        if rem != 0: fsz = fsz + (8 - rem)
        total = total + fsz
        i = i + 1
    return total

// Parse "Variant:N" → compute byte offset to field N within the variant's payload.
// Uses llvm_type_size for each prior field to sum the offset.
fn compute_variant_field_offset(st: EmitState, enum_name: String, variant_with_idx: String) -> Int:
    // Parse index from "Variant:N"
    let colon_pos: Int = variant_with_idx.find(":")
    if colon_pos < 0: return 0
    let idx_str: String = variant_with_idx.substr(colon_pos + 1, len(variant_with_idx) - colon_pos - 1)
    let field_idx: Int = int(idx_str)
    if field_idx == 0: return 0

    // Look up variant's payload types
    let variant_name: String = variant_with_idx.substr(0, colon_pos)
    let mut ei: Int = 0
    for _ in 0..500:
        if ei >= len(st.enum_infos): return 0
        let info: EnumInfo = st.enum_infos[ei]
        if info.name == enum_name:
            let mut vi: Int = 0
            for _ in 0..500:
                if vi >= len(info.variants): return 0
                if info.variants[vi].name == variant_name:
                    // Sum sizes of fields 0..field_idx-1
                    // v5.6.5 Ve.1: state-aware sizing so %struct.* resolves
                    // to the real registered size (not the 256 fallback).
                    let mut offset: Int = 0
                    let mut fi: Int = 0
                    for _ in 0..100:
                        if fi >= field_idx: return offset
                        if fi >= len(info.variants[vi].payload_types): return offset
                        let fty: String = resolve_mir_type(info.variants[vi].payload_types[fi])
                        let mut fsz: Int = llvm_sizeof_st(st, fty)
                        let rem: Int = fsz % 8
                        if rem != 0: fsz = fsz + (8 - rem)
                        offset = offset + fsz
                        fi = fi + 1
                    return offset
                vi = vi + 1
        ei = ei + 1
    return 0

// ---------------------------------------------------------------------------
// EnumTag instruction
// ---------------------------------------------------------------------------

fn emit_enum_tag(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let enum_ty: String = resolve_type(st, val.ty)
    let dn: String = dest.name
    // For Result/Option the tag field is i1; for enums it's i64.
    // The lowerer types `dest` per its consumer: try-op declares
    // `mir_bool()` (TK_BOOL → expects i1 for `br i1`); match
    // declares the enum type itself (expects i64 for `switch i64`,
    // which `emit_mir_switch` hard-codes). Honor `dest.ty.kind`.
    if val.ty.kind == TK_RESULT() || val.ty.kind == TK_OPTION():
        if dest.ty.kind == TK_BOOL():
            s = emit_line(s, emit_extractvalue(dn, enum_ty, val.name, "0"))
        else:
            let raw_tag: String = dn + ".raw"
            s = emit_line(s, emit_extractvalue(raw_tag, enum_ty, val.name, "0"))
            s = emit_line(s, "  " + dn + " = zext i1 " + raw_tag + " to i64")
    else:
        s = emit_line(s, emit_extractvalue(dn, enum_ty, val.name, "0"))
    s

// ---------------------------------------------------------------------------
// EnumPayload instruction
// ---------------------------------------------------------------------------

fn emit_enum_payload(st: EmitState, dest: Value, val: Value, variant: String) -> EmitState:
    let mut s: EmitState = st
    let enum_ty: String = resolve_type(st, val.ty)
    let dn: String = dest.name

    // For Result/Option: use extractvalue on the inner struct
    if val.ty.kind == TK_RESULT():
        // Result = {i1, {ok_ty, err_ty}}. Extract inner struct, then payload.
        let inner_r: String = dn + ".inner"
        s = emit_line(s, "  " + inner_r + " = extractvalue " + enum_ty + " " + val.name + ", 1")
        // Ok payload at index 0, Err payload at index 1
        let mut ok_ty: String = llvm_ptr()
        let mut err_ty: String = llvm_ptr()
        if len(val.ty.args) >= 2:
            ok_ty = resolve_mir_type(val.ty.args[0])
            err_ty = resolve_mir_type(val.ty.args[1])
        let inner_ty_res: String = "{ " + ok_ty + ", " + err_ty + " }"
        // Strip ":N" suffix from variant name (lowerer passes "Ok:0", "Err:0")
        let base_variant: String = strip_colon_suffix(variant)
        if base_variant == "Ok":
            s = emit_line(s, "  " + dn + " = extractvalue " + inner_ty_res + " " + inner_r + ", 0")
        else:
            s = emit_line(s, "  " + dn + " = extractvalue " + inner_ty_res + " " + inner_r + ", 1")
        return s
    if val.ty.kind == TK_OPTION():
        // Universal erasure: Option = {i1, ptr}. Extract ptr, then load.
        let ptr_name: String = dn + ".ptr"
        s = emit_line(s, "  " + ptr_name + " = extractvalue " + enum_ty + " " + val.name + ", 1")
        // Use destination type for load — avoids struct/enum name mismatches
        let inner_ty_opt: String = resolve_type(st, dest.ty)
        s = emit_line(s, "  " + dn + " = load " + inner_ty_opt + ", ptr " + ptr_name)
        return s

    // v4.140.0 Cb.5: inline enum — extract i64 slot and unpack.
    let inline_slots_p: Int = lookup_enum_inline(s, val.ty.name)
    if inline_slots_p > 0:
        let field_idx_i: Int = parse_field_index(variant)
        let slot_idx_i: Int = field_idx_i + 1
        let mut dest_ty_i: String = resolve_mir_type(dest.ty)
        if dest_ty_i.starts_with("%struct."):
            if is_enum_type(s, dest.ty.name): dest_ty_i = "%enum." + dest.ty.name
        let raw_i: String = dn + ".raw"
        s = emit_line(s, "  " + raw_i + " = extractvalue " + enum_ty + " " + val.name + ", " + toString(slot_idx_i))
        if dest_ty_i == "i64":
            s = emit_line(s, "  " + dn + " = add i64 0, " + raw_i)
        else:
            s = unpack_from_i64(s, raw_i, dest_ty_i, dn)
        return s

    // Pointer-based enum: { i64 tag, ptr payload }.
    // Extract payload pointer using the named enum type.
    let pr: String = dn + ".pr"
    s = emit_line(s, "  " + pr + " = extractvalue " + enum_ty + " " + val.name + ", 1")

    // Determine the dest type
    let mut dest_ty: String = resolve_mir_type(dest.ty)
    // Correct struct→enum misclassification
    if dest_ty.starts_with("%struct."):
        let payload_name: String = dest.ty.name
        if is_enum_type(s, payload_name):
            dest_ty = "%enum." + payload_name

    // Parse field index from "Variant:N" suffix.
    let field_idx: Int = parse_field_index(variant)

    if field_idx > 0:
        // v5.6.5 Ve.1 fix — defer field-offset computation to LLVM via
        // a typed GEP. Matches Python's extraction path at
        // emit_llvm_text.py:4894-4898: build the inline payload struct
        // type from the variant's registered payload_types, then GEP
        // into field `field_idx` with element index. LLVM's DataLayout
        // resolves the byte offset at link time — guaranteed consistent
        // with the typed GEP used at emit_enum_init's storage site.
        let stripped_name: String = strip_colon_suffix(variant)
        let payload_ty: String = build_payload_type_from_variant(s, val.ty.name, stripped_name)
        let pf: String = dn + ".pf"
        s = emit_line(s, "  " + pf + " = getelementptr inbounds " + payload_ty + ", ptr " + pr + ", i32 0, i32 " + toString(field_idx))
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + pf)
    else:
        s = emit_line(s, "  " + dn + " = load " + dest_ty + ", ptr " + pr)
    return s

// ---------------------------------------------------------------------------
// Option/Result wrapping
// ---------------------------------------------------------------------------

fn emit_wrap_some(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let val_ty: String = resolve_type(st, val.ty)
    let dn: String = dest.name

    // Heap-allocate the payload via malloc so the pointer survives function returns.
    // Stack alloca would be destroyed when the current function returns, leaving
    // a dangling pointer in the {i1, ptr} Option representation.
    let ea: String = dn + ".ea"
    let sz: String = dn + ".sz"
    s = emit_line(s, "  " + sz + " = ptrtoint ptr getelementptr (" + val_ty + ", ptr null, i32 1) to i64")
    s = emit_line(s, "  " + ea + " = call ptr @malloc(i64 " + sz + ")")
    // v5.23.1 Mb.2: track the malloc'd box for drop-glue freeing.
    // emit_drop_glue_boxed iterates st.boxed_owned at every ret and calls
    // free() unless the pointer aliases a returned value. Without this,
    // every Some(x) construction leaks the payload box on every fn exit
    // — the Te.5 if-let / while-let / let-else NEW LEAK class on
    // tests/golden/{88,90,91}.mn surfaces this latent gap, but it's also
    // the load-bearing leak in golden 17_option since v5.4.2.
    s = emit_track_boxed(s, ea)
    s = emit_line(s, "  store " + val_ty + " " + val.name + ", ptr " + ea)
    let opt_ty: String = llvm_option_type(llvm_ptr())
    let tag_name: String = dn + ".tag"
    s = emit_line(s, emit_insertvalue(tag_name, opt_ty, "undef", "1", "i1", "0"))
    s = emit_line(s, emit_insertvalue(dn, opt_ty, tag_name, ea, llvm_ptr(), "1"))
    return s

fn emit_wrap_none(st: EmitState, dest: Value, ty: MIRType) -> EmitState:
    // Universal erasure: all Option types are {i1, ptr}. None = {i1=0, null}.
    let opt_ty: String = llvm_option_type(llvm_ptr())
    let dn: String = dest.name
    let s: EmitState = emit_line(st, emit_insertvalue(dn, opt_ty, "undef", "0", "i1", "0"))
    s

fn emit_wrap_ok(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    // Use dest's Result type args for correct ok/err layout
    let res_ty: String = resolve_mir_type(dest.ty)
    let val_ty: String = resolve_mir_type(val.ty)
    let mut ok_ty: String = val_ty
    let mut err_ty: String = llvm_ptr()
    if len(dest.ty.args) >= 2:
        ok_ty = resolve_mir_type(dest.ty.args[0])
        err_ty = resolve_mir_type(dest.ty.args[1])
    let inner_ty: String = "{ " + ok_ty + ", " + err_ty + " }"
    let dn: String = dest.name

    let tag_name: String = dn + ".tag"
    s = emit_line(s, emit_insertvalue(tag_name, res_ty, "undef", "1", "i1", "0"))
    let inner_name: String = dn + ".inner"
    s = emit_line(s, emit_insertvalue(inner_name, inner_ty, "undef", val.name, ok_ty, "0"))
    s = emit_line(s, emit_insertvalue(dn, res_ty, tag_name, inner_name, inner_ty, "1"))
    return s

fn emit_wrap_err(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let res_ty: String = resolve_mir_type(dest.ty)
    let val_ty: String = resolve_mir_type(val.ty)
    let mut ok_ty: String = llvm_ptr()
    let mut err_ty: String = val_ty
    if len(dest.ty.args) >= 2:
        ok_ty = resolve_mir_type(dest.ty.args[0])
        err_ty = resolve_mir_type(dest.ty.args[1])
    let inner_ty: String = "{ " + ok_ty + ", " + err_ty + " }"
    let dn: String = dest.name

    let tag_name: String = dn + ".tag"
    s = emit_line(s, emit_insertvalue(tag_name, res_ty, "undef", "0", "i1", "0"))
    let inner_name: String = dn + ".inner"
    s = emit_line(s, emit_insertvalue(inner_name, inner_ty, "undef", val.name, err_ty, "1"))
    s = emit_line(s, emit_insertvalue(dn, res_ty, tag_name, inner_name, inner_ty, "1"))
    return s

// ---------------------------------------------------------------------------
// Unwrap instruction
// ---------------------------------------------------------------------------

fn emit_unwrap(st: EmitState, dest: Value, val: Value) -> EmitState:
    let mut s: EmitState = st
    let val_ty: String = resolve_mir_type(val.ty)
    let dn: String = dest.name
    if val.ty.kind == TK_OPTION():
        // Universal erasure: Option is {i1, ptr}. Extract ptr, then load.
        let ptr_name: String = dn + ".ptr"
        s = emit_line(s, emit_extractvalue(ptr_name, val_ty, val.name, "1"))
        // Use destination type for the load — avoids struct/enum name mismatches
        let inner_ty: String = resolve_type(st, dest.ty)
        s = emit_line(s, "  " + dn + " = load " + inner_ty + ", ptr " + ptr_name)
    else if val.ty.kind == TK_RESULT():
        // Eu.1 (v5.26.1): Result is `{i1, {Ok_ty, Err_ty}}`. The single
        // `extractvalue ..., 1` returns the *inner* aggregate, not the Ok
        // payload, so consumers typed as Ok_ty get a width mismatch
        // (golden 47 — `?` operator on Result<Int, String>). Two
        // extractvalues — field 1 of outer (inner aggregate) then field 0
        // of inner (Ok payload).
        if len(val.ty.args) >= 2:
            let ok_ty: String = resolve_mir_type(val.ty.args[0])
            let err_ty: String = resolve_mir_type(val.ty.args[1])
            let inner_ty: String = "{" + ok_ty + ", " + err_ty + "}"
            let inner_name: String = dn + ".inner"
            s = emit_line(s, emit_extractvalue(inner_name, val_ty, val.name, "1"))
            s = emit_line(s, emit_extractvalue(dn, inner_ty, inner_name, "0"))
        else:
            s = emit_line(s, emit_extractvalue(dn, val_ty, val.name, "1"))
    else:
        // Non-option/non-result: direct extractvalue
        s = emit_line(s, emit_extractvalue(dn, val_ty, val.name, "1"))
    s

// ---------------------------------------------------------------------------
// Call instruction
// ---------------------------------------------------------------------------

fn emit_mir_call(st: EmitState, dest: Value, fn_name: String, args: List<Value>) -> EmitState:
    let dn: String = dest.name

    // Built-in: print / println
    if fn_name == "print":
        return emit_builtin_print(st, args)
    if fn_name == "println":
        return emit_builtin_println(st, args)
    if fn_name == "len":
        return emit_builtin_len(st, dest, args)
    if fn_name == "toString":
        return emit_builtin_tostring(st, dest, args)
    if fn_name == "str":
        return emit_builtin_tostring(st, dest, args)
    if fn_name == "int":
        return emit_builtin_int(st, dest, args)
    if fn_name == "float":
        return emit_builtin_float(st, dest, args)

    // Runtime: process + file I/O
    if fn_name == "__mn_argc":
        return emit_rt_call(st, dn, "i64", "__mn_argc", "")
    if fn_name == "__mn_argv":
        let as_argv: String = "i64 " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_argv", as_argv)
    if fn_name == "__mn_file_read_or_empty":
        let as_fr: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_file_read_or_empty", as_fr)
    if fn_name == "__mn_exit":
        return emit_rt_call_void(st, "__mn_exit", "i64 " + args[0].name)
    if fn_name == "__mn_file_write":
        let as_fw: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call(st, dn, "i64", "__mn_file_write", as_fw)
    if fn_name == "__mn_system":
        let as_sys: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_system", as_sys)
    if fn_name == "__mn_str_eprint":
        let as_epr: String = llvm_string() + " " + args[0].name
        return emit_rt_call_void(st, "__mn_str_eprint", as_epr)
    // v5.26.0 Mb.9: route the v5.23.2 Te.3.B.2 brace-deprecation
    // functions through emit_rt_call(_void). The default user-call
    // path uses is_byref_type_st (64-byte threshold), but MnString
    // is 16 bytes, so on Win64 it would pass the struct by value
    // while declare_runtime_fn already declared the parameter as
    // `ptr` (8-byte threshold via win64_rewrite_decl_params). gcc
    // implements `MnString source` per Win64 ABI as pass-by-hidden-
    // pointer, dereferences rcx as the struct pointer, and reads
    // the data buffer's bytes 8..16 as the length field. Mirrors
    // the v5.23.1 Mb.1 pattern for `__mn_indent_to_braces`. Once
    // mnc-stage1.exe is rebuilt with the Python-side fix, this
    // self-host fix keeps stage2.ll Win64-correct on its own.
    if fn_name == "__mn_count_user_brace_block_openers":
        let as_cbb: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_count_user_brace_block_openers", as_cbb)
    if fn_name == "__mn_emit_brace_deprecation_warning":
        let as_ebw: String = llvm_string() + " " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call_void(st, "__mn_emit_brace_deprecation_warning", as_ebw)
    // v5.29.0 Mb.10: route __mn_indent_to_braces through emit_rt_call
    // for the same Win64 ABI reason as v5.26.0 Mb.9 routed the
    // brace-deprecation siblings above. The Python emitter has had
    // this routing since v5.23.1 Mb.1 (emit_llvm_text.py:3632); the
    // self-host side was missed. Without this, stage2.ll emitted a
    // by-value call against a declare-as-`ptr` signature on Win64,
    // and gcc lowered the call as pass-by-hidden-pointer with rcx
    // pointing into the struct's data buffer instead of into a
    // valid MnString — SIGSEGV on the first source.len read in
    // __mn_indent_to_braces (publish run #50, x86_64-w64-mingw32).
    if fn_name == "__mn_indent_to_braces":
        let as_itb: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_indent_to_braces", as_itb)
    // v5.48.1 Te.3.D.4.4: match-arm shorthand rewriter — same Win64
    // ABI routing rationale as __mn_indent_to_braces above.
    if fn_name == "__mn_rewrite_arm_stmt_shorthand":
        let as_rass: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_rewrite_arm_stmt_shorthand", as_rass)

    // v5.49.0 Wn.2 — Win64 ABI routing for `__mn_file_exists`. Same
    // rationale as the Mb.9 / Mb.10 / Te.3.D.4.4 entries above:
    // without this routing, `find_clang()` at
    // `mapanare/self/main.mn:80` falls through to the default-path
    // emission which uses `is_byref_type_st` (64-byte threshold for
    // user-fn ABI). MnString is 16 bytes, so on Win64 the call site
    // emitted `{ptr, i64}` aggregate-by-value while
    // `declare_runtime_fn` had already emitted `ptr` per Win64
    // (8-byte threshold). gcc lowered the C side as
    // pass-by-hidden-pointer and dereferenced rcx as a
    // struct-pointer pointing into the path data buffer →
    // garbage `path.len` → `__mn_alloc` 8 EB OOM. See
    // `docs/roadmap/v5/v5.49.0/PRE_PHASE_AUDIT.md`. Scope is
    // deliberately narrow to match the established
    // one-symbol-per-release precedent and keep the IR-size gate
    // green; the broader sweep across every MnString-arg
    // `__mn_*` symbol is a v5.49.x carry candidate (registry-driven
    // refactor preferred over more inline branches).
    if fn_name == "__mn_file_exists":
        let as_fe: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_file_exists", as_fe)

    // chr/ord builtins
    if fn_name == "chr":
        return emit_rt_call(st, dn, llvm_string(), "__mn_str_chr", "i64 " + args[0].name)
    if fn_name == "ord":
        return emit_rt_call(st, dn, "i64", "__mn_str_ord", llvm_string() + " " + args[0].name)

    // I/O builtins (v3.41.0)
    if fn_name == "read_line":
        return emit_rt_call(st, dn, llvm_string(), "__mn_read_line", "")
    if fn_name == "read_file":
        let as_rf: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_file_read_or_empty", as_rf)
    if fn_name == "write_file":
        let as_wf: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call_void(st, "__mn_file_write", as_wf)
    if fn_name == "append_file":
        let as_af: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call_void(st, "__mn_file_append", as_af)
    if fn_name == "file_exists":
        let as_fe: String = llvm_string() + " " + args[0].name
        let cnt_fe: String = toString(st.counter)
        let mut s_fe: EmitState = st
        s_fe.counter = s_fe.counter + 1
        let fe_raw: String = "%fe_raw" + cnt_fe
        s_fe = emit_line(s_fe, "  " + fe_raw + " = call i64 @__mn_file_exists(" + as_fe + ")")
        s_fe = emit_line(s_fe, "  " + dn + " = icmp ne i64 " + fe_raw + ", 0")
        return s_fe
    if fn_name == "list_dir":
        let as_ld: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_list_rt(), "__mn_dir_list_strings", as_ld)
    // Network/crypto/regex builtins (v3.42.0)
    if fn_name == "http_get":
        let as_hg: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_http_get", as_hg)
    if fn_name == "sha256":
        let as_sh: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_sha256_str", as_sh)
    if fn_name == "base64_encode":
        let as_be: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_base64_encode_str", as_be)
    if fn_name == "base64_decode":
        let as_bd: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_base64_decode_str", as_bd)
    if fn_name == "hmac_sha256":
        let as_hm: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_hmac_sha256_str", as_hm)
    if fn_name == "hex_encode":
        let as_he: String = llvm_string() + " " + args[0].name
        return emit_rt_call(st, dn, llvm_string(), "__mn_hex_encode_str", as_he)
    if fn_name == "random_bytes":
        return emit_rt_call(st, dn, llvm_string(), "__mn_random_bytes_str", "i64 " + args[0].name)
    if fn_name == "regex_match":
        // compile + exec + free pattern (matches Python emitter)
        let cnt_rm: String = toString(st.counter)
        let mut s_rm: EmitState = st
        s_rm.counter = s_rm.counter + 3
        let rh: String = "%rh" + cnt_rm
        let re: String = "%re" + cnt_rm
        let rf: String = "%rf" + cnt_rm
        s_rm = emit_line(s_rm, "  " + rh + " = call i64 @__mn_regex_compile_str(" + llvm_string() + " " + args[0].name + ")")
        s_rm = emit_line(s_rm, "  " + re + " = call i64 @__mn_regex_exec_str(i64 " + rh + ", " + llvm_string() + " " + args[1].name + ", i64 0)")
        s_rm = emit_line(s_rm, "  " + rf + " = call i64 @__mn_regex_free(i64 " + rh + ")")
        s_rm = emit_line(s_rm, "  " + dn + " = icmp sgt i64 " + re + ", 0")
        return s_rm
    if fn_name == "regex_replace":
        // compile + replace + free pattern (matches Python emitter)
        let cnt_rr: String = toString(st.counter)
        let mut s_rr: EmitState = st
        s_rr.counter = s_rr.counter + 3
        let rh2: String = "%rh2_" + cnt_rr
        let rr2: String = "%rr2_" + cnt_rr
        let rf2: String = "%rf2_" + cnt_rr
        s_rr = emit_line(s_rr, "  " + rh2 + " = call i64 @__mn_regex_compile_str(" + llvm_string() + " " + args[0].name + ")")
        s_rr = emit_line(s_rr, "  " + dn + " = call " + llvm_string() + " @__mn_regex_replace_str(i64 " + rh2 + ", " + llvm_string() + " " + args[1].name + ", " + llvm_string() + " " + args[2].name + ", i64 1)")
        s_rr = emit_line(s_rr, "  " + rf2 + " = call i64 @__mn_regex_free(i64 " + rh2 + ")")
        return s_rr
    // GPU builtins (v3.46.0)
    if fn_name == "gpu_available":
        let cnt_ga: String = toString(st.counter)
        let mut s_ga: EmitState = st
        s_ga.counter = s_ga.counter + 1
        let raw_ga: String = "%ga_raw" + cnt_ga
        s_ga = emit_line(s_ga, "  " + raw_ga + " = call i64 @__mn_gpu_available()")
        s_ga = emit_line(s_ga, "  " + dn + " = icmp ne i64 " + raw_ga + ", 0")
        return s_ga
    if fn_name == "gpu_device_name":
        return emit_rt_call(st, dn, llvm_string(), "__mn_gpu_device_name", "")
    if fn_name == "gpu_device_memory":
        return emit_rt_call(st, dn, "i64", "__mn_gpu_device_memory", "")
    if fn_name == "gpu_tensor_add" || fn_name == "gpu_tensor_sub" || fn_name == "gpu_tensor_mul" || fn_name == "gpu_tensor_div":
        // C runtime takes MnList* (ptr), so alloca+store to pass by pointer
        let cnt_gt: String = toString(st.counter)
        let mut s_gt: EmitState = st
        s_gt.counter = s_gt.counter + 2
        let pa: String = "%gta" + cnt_gt
        let pb: String = "%gtb" + cnt_gt
        s_gt = emit_line(s_gt, "  " + pa + " = alloca " + llvm_list_rt())
        s_gt = emit_line(s_gt, "  " + pb + " = alloca " + llvm_list_rt())
        s_gt = emit_line(s_gt, "  store " + llvm_list_rt() + " " + args[0].name + ", ptr " + pa)
        s_gt = emit_line(s_gt, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + pb)
        let mut rt_name: String = "__mn_gpu_tensor_add"
        if fn_name == "gpu_tensor_sub": rt_name = "__mn_gpu_tensor_sub"
        if fn_name == "gpu_tensor_mul": rt_name = "__mn_gpu_tensor_mul"
        if fn_name == "gpu_tensor_div": rt_name = "__mn_gpu_tensor_div"
        let as_gt: String = "ptr " + pa + ", ptr " + pb
        s_gt = emit_rt_call(s_gt, dn, llvm_list_rt(), rt_name, as_gt)
        return s_gt
    if fn_name == "gpu_tensor_matmul":
        let cnt_gm: String = toString(st.counter)
        let mut s_gm: EmitState = st
        s_gm.counter = s_gm.counter + 2
        let gma: String = "%gma" + cnt_gm
        let gmb: String = "%gmb" + cnt_gm
        s_gm = emit_line(s_gm, "  " + gma + " = alloca " + llvm_list_rt())
        s_gm = emit_line(s_gm, "  " + gmb + " = alloca " + llvm_list_rt())
        s_gm = emit_line(s_gm, "  store " + llvm_list_rt() + " " + args[0].name + ", ptr " + gma)
        s_gm = emit_line(s_gm, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + gmb)
        let as_gm: String = "ptr " + gma + ", ptr " + gmb + ", i64 " + args[2].name + ", i64 " + args[3].name + ", i64 " + args[4].name
        s_gm = emit_rt_call(s_gm, dn, llvm_list_rt(), "__mn_gpu_tensor_matmul", as_gm)
        return s_gm

    // v5.6.0 Sh.6 — tensor builtins routed to __mn_tensor_* runtime.
    // Tensor values travel as ptr in the self-hosted emitter (MIR kind
    // TENSOR currently resolves through the unknown fallthrough to i64 in
    // resolve_mir_type; the alloc call and these builtins all treat the
    // dest / arg as ptr). Mirrors emit_llvm_text.py:3568-3601.
    if fn_name == "tensor_rank":
        let as_tr: String = "ptr " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_rank", as_tr)
    if fn_name == "tensor_size":
        let as_ts: String = "ptr " + args[0].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_size", as_ts)
    if fn_name == "tensor_get_f64":
        let as_tgf: String = "ptr " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call(st, dn, "double", "__mn_tensor_get_f64", as_tgf)
    if fn_name == "tensor_get_i64":
        let as_tgi: String = "ptr " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_get_i64", as_tgi)
    if fn_name == "tensor_shape_dim":
        let as_tsd: String = "ptr " + args[0].name + ", i64 " + args[1].name
        return emit_rt_call(st, dn, "i64", "__mn_tensor_shape_dim", as_tsd)
    if fn_name == "tensor_print":
        let as_tp: String = "ptr " + args[0].name
        return emit_rt_call_void(st, "__mn_tensor_print_f64", as_tp)

    // v5.6.1 Sh.6 Phase 2 — variadic tensor_*_nd calls. LLVM requires the
    // explicit function-type prefix `(ptr, i64, ...)` when calling a
    // varargs fn. args layout: [tensor, rank, i0, i1, ...] for get;
    // [tensor, rank, i0, ..., val] for set (val comes last, as a non-
    // variadic-style arg typed as double/i64).
    if fn_name == "__mn_tensor_get_f64_nd":
        let nargs_g: Int = len(args)
        let mut inner_g: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_g: Int = 2
        for _ in 0..128:
            if j_g < nargs_g:
                inner_g = inner_g + ", i64 " + args[j_g].name
                j_g = j_g + 1
        return emit_line(st, "  " + dn + " = call double (ptr, i64, ...) @__mn_tensor_get_f64_nd(" + inner_g + ")")
    if fn_name == "__mn_tensor_get_i64_nd":
        let nargs_gi: Int = len(args)
        let mut inner_gi: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_gi: Int = 2
        for _ in 0..128:
            if j_gi < nargs_gi:
                inner_gi = inner_gi + ", i64 " + args[j_gi].name
                j_gi = j_gi + 1
        return emit_line(st, "  " + dn + " = call i64 (ptr, i64, ...) @__mn_tensor_get_i64_nd(" + inner_gi + ")")
    if fn_name == "__mn_tensor_set_f64_nd":
        let nargs_s: Int = len(args)
        let mut inner_s: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_s: Int = 2
        let last_s: Int = nargs_s - 1
        for _ in 0..128:
            if j_s < last_s:
                inner_s = inner_s + ", i64 " + args[j_s].name
                j_s = j_s + 1
        if nargs_s >= 3:
            inner_s = inner_s + ", double " + args[last_s].name
        return emit_line(st, "  call void (ptr, i64, ...) @__mn_tensor_set_f64_nd(" + inner_s + ")")
    // v5.41.0 Ts.1 → v5.45.0 Ts.2.B — `__mn_tensor_reshape` and
    // `__mn_tensor_view` share the same call shape. Lowerer emits
    // Call(fn, [tensor, shape: List<Int>]). Runtime expects (ptr tensor,
    // ptr shape_list). Alloca a list-shaped slot, store the list value
    // into it, call with the alloca ptr. Both are aliasing now —
    // `noalias` dropped from the call (v5.45.0 swap).
    if fn_name == "__mn_tensor_reshape" || fn_name == "__mn_tensor_view":
        let cnt_rs: String = toString(st.counter)
        let mut s_rs: EmitState = st
        s_rs.counter = s_rs.counter + 1
        let mut prefix_rs: String = "treshape"
        if fn_name == "__mn_tensor_view": prefix_rs = "tview"
        let shp_p: String = "%" + prefix_rs + "_shape" + cnt_rs
        s_rs = emit_line(s_rs, "  " + shp_p + " = alloca " + llvm_list_rt())
        s_rs = emit_line(s_rs, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + shp_p)
        s_rs = emit_line(s_rs, "  " + dn + " = call ptr @" + fn_name + "(ptr " + args[0].name + ", ptr " + shp_p + ")")
        s_rs = emit_track_tensor(s_rs, dn)
        return s_rs

    // v5.6.3 Sh.6 Phase 4 — `__mn_tensor_slice` special case. Lowerer passes
    // flat args [tensor, s0, s1, ..., e0, e1, ..., rank]; the runtime
    // expects (ptr tensor, ptr starts_arr, ptr ends_arr, i64 rank). We
    // alloca two [ndim x i64] arrays, store each start/end value via
    // getelementptr + store, then call the runtime with the array ptrs.
    // Mirrors emit_llvm_text.py:3669-3717.
    if fn_name == "__mn_tensor_slice":
        let nargs_sl: Int = len(args)
        let rank_idx_sl: Int = nargs_sl - 1
        let ndim_sl: Int = (nargs_sl - 2) / 2
        let cnt_sl: String = toString(st.counter)
        let mut s_sl: EmitState = st
        s_sl.counter = s_sl.counter + 1

        let starts_arr: String = "%starts_arr" + cnt_sl
        let ends_arr: String = "%ends_arr" + cnt_sl
        let arr_ty: String = "[" + toString(ndim_sl) + " x i64]"
        s_sl = emit_line(s_sl, "  " + starts_arr + " = alloca " + arr_ty)
        s_sl = emit_line(s_sl, "  " + ends_arr + " = alloca " + arr_ty)

        let mut d_sl: Int = 0
        for _ in 0..128:
            if d_sl < ndim_sl:
                let d_str: String = toString(d_sl)
                let cnt_d: String = toString(s_sl.counter)
                s_sl.counter = s_sl.counter + 1
                let s_gep: String = "%sgep" + cnt_d
                let e_gep: String = "%egep" + cnt_d
                s_sl = emit_line(s_sl, "  " + s_gep + " = getelementptr inbounds " + arr_ty + ", ptr " + starts_arr + ", i64 0, i64 " + d_str)
                s_sl = emit_line(s_sl, "  " + e_gep + " = getelementptr inbounds " + arr_ty + ", ptr " + ends_arr + ", i64 0, i64 " + d_str)
                let s_val_name: String = args[1 + d_sl].name
                let e_val_name: String = args[1 + ndim_sl + d_sl].name
                s_sl = emit_line(s_sl, "  store i64 " + s_val_name + ", ptr " + s_gep)
                s_sl = emit_line(s_sl, "  store i64 " + e_val_name + ", ptr " + e_gep)
                d_sl = d_sl + 1

        let t_name_sl: String = args[0].name
        let rank_name_sl: String = args[rank_idx_sl].name
        s_sl = emit_line(s_sl, "  " + dn + " = call noalias ptr @__mn_tensor_slice(ptr " + t_name_sl + ", ptr " + starts_arr + ", ptr " + ends_arr + ", i64 " + rank_name_sl + ")")
        // v5.6.4 Rt.06 — track the fresh tensor for drop-glue.
        s_sl = emit_track_tensor(s_sl, dn)
        return s_sl

    // v5.45.0 Ts.3.B — `__mn_tensor_step_slice` special case. Lowerer
    // passes flat args [tensor, s0..s_{n-1}, e0..e_{n-1}, k0..k_{n-1},
    // rank] = 3*ndim + 2 args. Runtime expects (ptr tensor, ptr starts,
    // ptr ends, ptr steps, i64 rank). Alloca three [ndim x i64] arrays,
    // store each start/end/step value, call the runtime. No `noalias`
    // — consistent with v5.45.0 conservative omission across tensor-
    // producing exports. Mirrors emit_llvm_text.py:3992-4054.
    if fn_name == "__mn_tensor_step_slice":
        let nargs_ss: Int = len(args)
        let rank_idx_ss: Int = nargs_ss - 1
        let ndim_ss: Int = (nargs_ss - 2) / 3
        let cnt_ss: String = toString(st.counter)
        let mut s_ss: EmitState = st
        s_ss.counter = s_ss.counter + 1

        let starts_arr_ss: String = "%starts_arr" + cnt_ss
        let ends_arr_ss: String = "%ends_arr" + cnt_ss
        let steps_arr_ss: String = "%steps_arr" + cnt_ss
        let arr_ty_ss: String = "[" + toString(ndim_ss) + " x i64]"
        s_ss = emit_line(s_ss, "  " + starts_arr_ss + " = alloca " + arr_ty_ss)
        s_ss = emit_line(s_ss, "  " + ends_arr_ss + " = alloca " + arr_ty_ss)
        s_ss = emit_line(s_ss, "  " + steps_arr_ss + " = alloca " + arr_ty_ss)

        let mut d_ss: Int = 0
        for _ in 0..128:
            if d_ss < ndim_ss:
                let d_str_ss: String = toString(d_ss)
                let cnt_d_ss: String = toString(s_ss.counter)
                s_ss.counter = s_ss.counter + 1
                let s_gep_ss: String = "%sgep" + cnt_d_ss
                let e_gep_ss: String = "%egep" + cnt_d_ss
                let k_gep_ss: String = "%kgep" + cnt_d_ss
                s_ss = emit_line(s_ss, "  " + s_gep_ss + " = getelementptr inbounds " + arr_ty_ss + ", ptr " + starts_arr_ss + ", i64 0, i64 " + d_str_ss)
                s_ss = emit_line(s_ss, "  " + e_gep_ss + " = getelementptr inbounds " + arr_ty_ss + ", ptr " + ends_arr_ss + ", i64 0, i64 " + d_str_ss)
                s_ss = emit_line(s_ss, "  " + k_gep_ss + " = getelementptr inbounds " + arr_ty_ss + ", ptr " + steps_arr_ss + ", i64 0, i64 " + d_str_ss)
                let s_val_ss: String = args[1 + d_ss].name
                let e_val_ss: String = args[1 + ndim_ss + d_ss].name
                let k_val_ss: String = args[1 + 2 * ndim_ss + d_ss].name
                s_ss = emit_line(s_ss, "  store i64 " + s_val_ss + ", ptr " + s_gep_ss)
                s_ss = emit_line(s_ss, "  store i64 " + e_val_ss + ", ptr " + e_gep_ss)
                s_ss = emit_line(s_ss, "  store i64 " + k_val_ss + ", ptr " + k_gep_ss)
                d_ss = d_ss + 1

        let t_name_ss: String = args[0].name
        let rank_name_ss: String = args[rank_idx_ss].name
        s_ss = emit_line(s_ss, "  " + dn + " = call ptr @__mn_tensor_step_slice(ptr " + t_name_ss + ", ptr " + starts_arr_ss + ", ptr " + ends_arr_ss + ", ptr " + steps_arr_ss + ", i64 " + rank_name_ss + ")")
        s_ss = emit_track_tensor(s_ss, dn)
        return s_ss

    if fn_name == "__mn_tensor_set_i64_nd":
        let nargs_si: Int = len(args)
        let mut inner_si: String = "ptr " + args[0].name + ", i64 " + args[1].name
        let mut j_si: Int = 2
        let last_si: Int = nargs_si - 1
        for _ in 0..128:
            if j_si < last_si:
                inner_si = inner_si + ", i64 " + args[j_si].name
                j_si = j_si + 1
        if nargs_si >= 3:
            inner_si = inner_si + ", i64 " + args[last_si].name
        return emit_line(st, "  call void (ptr, i64, ...) @__mn_tensor_set_i64_nd(" + inner_si + ")")

    // Map iteration helpers
    if fn_name == "__mn_map_keys":
        // Extract map pointer from {ptr, i64} and call __mn_map_keys(ptr)
        let cnt_mk: String = toString(st.counter)
        let mut s_mk: EmitState = st
        s_mk.counter = s_mk.counter + 1
        let mptr: String = "%mk_ptr" + cnt_mk
        s_mk = emit_line(s_mk, "  " + mptr + " = extractvalue " + llvm_map_type() + " " + args[0].name + ", 0")
        s_mk = emit_rt_call(s_mk, dn, llvm_list_rt(), "__mn_map_keys", "ptr " + mptr)
        return s_mk
    if fn_name == "__list_get_string":
        // Get element ptr from list, then load MnString from it
        let cnt_lg: String = toString(st.counter)
        let mut s_lg: EmitState = st
        s_lg.counter = s_lg.counter + 1
        // Alloca list to get ptr
        let la: String = "%lg_la" + cnt_lg
        s_lg = emit_line(s_lg, "  " + la + " = alloca " + llvm_list_rt())
        s_lg = emit_line(s_lg, "  store " + llvm_list_rt() + " " + args[0].name + ", ptr " + la)
        let ep: String = "%lg_ep" + cnt_lg
        s_lg = emit_line(s_lg, "  " + ep + " = call ptr @__mn_list_get(ptr " + la + ", i64 " + args[1].name + ")")
        s_lg = emit_line(s_lg, "  " + dn + " = load " + llvm_string() + ", ptr " + ep)
        return s_lg

    // BinOp fallback: when enum tag mismatch causes BinOp to reach Call dispatch,
    // the fn_name is "__op_<operator>". Convert to inline LLVM arithmetic.
    if fn_name.starts_with("__op_"):
        let op_ch: String = fn_name.replace("__op_", "")
        let an: String = args[0].name
        let bn: String = args[1].name
        if op_ch == "+": return emit_line(st, emit_add(dn, llvm_int(), an, bn))
        if op_ch == "-": return emit_line(st, emit_sub(dn, llvm_int(), an, bn))
        if op_ch == "*": return emit_line(st, emit_mul(dn, llvm_int(), an, bn))
        if op_ch == "/": return emit_line(st, emit_sdiv(dn, llvm_int(), an, bn))
        if op_ch == "%": return emit_line(st, emit_srem(dn, llvm_int(), an, bn))
        if op_ch == "==": return emit_line(st, emit_icmp(dn, "eq", llvm_int(), an, bn))
        if op_ch == "!=": return emit_line(st, emit_icmp(dn, "ne", llvm_int(), an, bn))
        if op_ch == "<": return emit_line(st, emit_icmp(dn, "slt", llvm_int(), an, bn))
        if op_ch == ">": return emit_line(st, emit_icmp(dn, "sgt", llvm_int(), an, bn))
        if op_ch == "<=": return emit_line(st, emit_icmp(dn, "sle", llvm_int(), an, bn))
        if op_ch == ">=": return emit_line(st, emit_icmp(dn, "sge", llvm_int(), an, bn))
        if op_ch == "&&": return emit_line(st, emit_and_instr(dn, an, bn))
        if op_ch == "||": return emit_line(st, emit_or_instr(dn, an, bn))
        // Fallback for unknown operator
        return emit_line(st, emit_add(dn, llvm_int(), an, bn))

    // Range construction — inline {i64, i64} (no heap allocation needed)
    if fn_name == "__mn_range":
        let mut s_rng: EmitState = st
        let tmp_rng: String = dn + ".tmp"
        s_rng = emit_line(s_rng, "  " + tmp_rng + " = insertvalue {i64, i64} undef, i64 " + args[0].name + ", 0")
        s_rng = emit_line(s_rng, "  " + dn + " = insertvalue {i64, i64} " + tmp_rng + ", i64 " + args[1].name + ", 1")
        return s_rng
    if fn_name == "__mn_range_inclusive":
        let mut s_rngi: EmitState = st
        let inc: String = dn + ".inc"
        let tmp_rngi: String = dn + ".tmp"
        s_rngi = emit_line(s_rngi, "  " + inc + " = add i64 " + args[1].name + ", 1")
        s_rngi = emit_line(s_rngi, "  " + tmp_rngi + " = insertvalue {i64, i64} undef, i64 " + args[0].name + ", 0")
        s_rngi = emit_line(s_rngi, "  " + dn + " = insertvalue {i64, i64} " + tmp_rngi + ", i64 " + inc + ", 1")
        return s_rngi

    // Range field extraction (counter-based for-loops)
    if fn_name == "__mn_range_start":
        let mut s_rs: EmitState = st
        s_rs = emit_line(s_rs, "  " + dn + " = extractvalue {i64, i64} " + args[0].name + ", 0")
        return s_rs
    if fn_name == "__mn_range_end":
        let mut s_re: EmitState = st
        s_re = emit_line(s_re, "  " + dn + " = extractvalue {i64, i64} " + args[0].name + ", 1")
        return s_re

    // String builtins
    if fn_name == "split":
        let mut s_split: EmitState = st
        let as_split: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        s_split = emit_rt_call(s_split, dn, llvm_list_rt(), "__mn_str_split", as_split)
        return s_split
    if fn_name == "contains":
        let mut s_cont: EmitState = st
        let as_cont: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name
        s_cont = emit_rt_call(s_cont, dn, llvm_bool(), "__mn_str_contains", as_cont)
        return s_cont
    if fn_name == "replace":
        let mut s_repl: EmitState = st
        let as_repl: String = llvm_string() + " " + args[0].name + ", " + llvm_string() + " " + args[1].name + ", " + llvm_string() + " " + args[2].name
        s_repl = emit_rt_call(s_repl, dn, llvm_string(), "__mn_str_replace", as_repl)
        return s_repl
    if fn_name == "byte_at":
        let mut s_ba: EmitState = st
        let as_ba: String = llvm_string() + " " + args[0].name + ", i64 " + args[1].name
        s_ba = emit_rt_call(s_ba, dn, llvm_int(), "__mn_str_byte_at", as_ba)
        return s_ba
    // join(sep, list) → String via C runtime. List passed by pointer.
    if fn_name == "join":
        let mut s_join: EmitState = st
        // Alloca the list and pass pointer (C runtime expects MnList*)
        let la: String = "%" + strip_percent(dn) + ".la"
        s_join = emit_line(s_join, "  " + la + " = alloca " + llvm_list_rt())
        s_join = emit_line(s_join, "  store " + llvm_list_rt() + " " + args[1].name + ", ptr " + la)
        let as_join: String = llvm_string() + " " + args[0].name + ", ptr " + la
        s_join = emit_rt_call(s_join, dn, llvm_string(), "__mn_str_join", as_join)
        return s_join

    // List push: extract to helper to avoid return-inside-if bug
    if fn_name == "push":
        return emit_list_push_call(st, dest, args)

    // Synthetic struct constructor: __new_<StructName>(field_values...)
    // Use replace to remove the "__new_" prefix instead of substr
    // (substr has off-by-one issues in the compiled binary)
    if fn_name.contains("__new_"):
        let struct_name: String = fn_name.replace("__new_", "")
        let struct_ty: MIRType = mir_struct(struct_name)
        return emit_struct_init_from_values(st, dest, struct_ty, args)

    // Resolve operands for all other calls
    let mut s: EmitState = st

    // String methods: dispatched to __mn_str_<method> runtime functions
    if len(args) >= 1:
        let first_arg: Value = args[0]
        if first_arg.ty.kind == TK_STRING():
            let s0: String = first_arg.name
            if fn_name == "contains":
                s = emit_rt_call(s, dn, llvm_bool(), "__mn_str_contains", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "starts_with":
                s = emit_rt_call(s, dn, llvm_bool(), "__mn_str_starts_with", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "ends_with":
                s = emit_rt_call(s, dn, llvm_bool(), "__mn_str_ends_with", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "find":
                s = emit_rt_call(s, dn, llvm_int(), "__mn_str_find", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name)
                return s
            if fn_name == "char_at":
                s = emit_rt_call(s, dn, llvm_string(), "__mn_str_char_at", llvm_string() + " " + s0 + ", i64 " + args[1].name)
                return s
            if fn_name == "substr":
                if len(args) >= 3:
                    s = emit_rt_call(s, dn, llvm_string(), "__mn_str_substr", llvm_string() + " " + s0 + ", i64 " + args[1].name + ", i64 " + args[2].name)
                    return s
            if fn_name == "to_upper":
                s = emit_rt_call(s, dn, llvm_string(), "__mn_str_to_upper", llvm_string() + " " + s0)
                return s
            if fn_name == "to_lower":
                s = emit_rt_call(s, dn, llvm_string(), "__mn_str_to_lower", llvm_string() + " " + s0)
                return s
            if fn_name == "replace":
                if len(args) >= 3:
                    s = emit_rt_call(s, dn, llvm_string(), "__mn_str_replace", llvm_string() + " " + s0 + ", " + llvm_string() + " " + args[1].name + ", " + llvm_string() + " " + args[2].name)
                    return s

    // Look up registered function parameter types (more reliable than MIR)
    let fn_opt_pre: Option<FnEntry> = find_function(s, fn_name)
    let mut reg_param_types: List<String> = []
    match fn_opt_pre:
        Some(fe) => reg_param_types = fe.param_types
        _ => {}

    // Build args with byref: large struct args → alloca + pass pointer
    let mut args_str: String = ""
    let mut j: Int = 0
    let nargs: Int = len(args)
    for _ in 0..500:
        if j < nargs:
            let mut aty: String = resolve_mir_type(args[j].ty)
            let mut an: String = args[j].name
            // Use registered param type when available.
            // Enum reinterpret: alloca+store+load for layout-compatible enums.
            // NEVER set an=zeroinitializer (that was the bug causing empty args).
            if j < len(reg_param_types):
                let rpt: String = reg_param_types[j]
                if rpt != aty && rpt != "i64":
                    // Enum type mismatch: reinterpret through memory
                    if aty.starts_with("%enum.") && rpt.starts_with("%enum.") && aty != rpt:
                        let rc_a: String = "%ecast" + toString(s.counter)
                        s.counter = s.counter + 1
                        s = emit_line(s, "  " + rc_a + " = alloca " + rpt)
                        s = emit_line(s, "  store " + aty + " " + an + ", ptr " + rc_a)
                        let rc_ld: String = "%ecast_ld" + toString(s.counter)
                        s.counter = s.counter + 1
                        s = emit_line(s, "  " + rc_ld + " = load " + rpt + ", ptr " + rc_a)
                        an = rc_ld
                    aty = rpt
            // Byref: large struct args → store to alloca, pass pointer
            let mut pass_ty: String = aty
            let mut pass_name: String = an
            if is_byref_type_st(s, aty):
                let ba: String = "%barg" + toString(s.counter)
                s.counter = s.counter + 1
                s = emit_line(s, "  " + ba + " = alloca " + aty)
                s = emit_line(s, "  store " + aty + " " + an + ", ptr " + ba)
                pass_ty = "ptr"
                pass_name = ba
            if j > 0:
                args_str = args_str + ", " + pass_ty + " " + pass_name
            else:
                args_str = pass_ty + " " + pass_name
            j = j + 1

    // Look up return type and handle sret for large struct returns
    let fn_opt: Option<FnEntry> = find_function(s, fn_name)
    match fn_opt:
        Some(fe) =>:
            if fe.ret_type == "void":
                return emit_line(s, emit_call_void(fn_name, args_str))
            // v5.0.4 Cb.15: sret via per-target ABI classifier
            if use_sret_return(s, fe.ret_type):
                let sret_a: String = "%sret" + toString(s.counter)
                s.counter = s.counter + 1
                s = emit_line(s, "  " + sret_a + " = alloca " + fe.ret_type)
                s = emit_line(s, "  store " + fe.ret_type + " zeroinitializer, ptr " + sret_a)
                let sret_arg: String = "ptr sret(" + fe.ret_type + ") " + sret_a
                let mut full_args: String = sret_arg
                if len(args_str) > 0: full_args = sret_arg + ", " + args_str
                s = emit_line(s, "  call void @" + fn_name + "(" + full_args + ")")
                s = emit_line(s, "  " + dn + " = load " + fe.ret_type + ", ptr " + sret_a)
                return s
            s = emit_line(s, emit_call_ir(dn, fe.ret_type, fn_name, args_str))
            // v5.6.4 Rt.06 — attach tensor drop-glue tracking for the
            // 20 tensor binop runtime fns (broadcast / scalar / rscalar).
            // The non-Some arm (below) mirrors this injection for fns
            // not present in st.functions.
            if is_tensor_allocating_fn(fn_name):
                s = emit_track_tensor(s, dn)
            return s
        _ =>:
            let ret_ty: String = resolve_mir_type(dest.ty)
            if ret_ty == "void":
                return emit_line(s, emit_call_void(fn_name, args_str))
            // v5.0.4 Cb.15: sret via per-target ABI classifier
            if use_sret_return(s, ret_ty):
                let sret_b: String = "%sret" + toString(s.counter)
                s.counter = s.counter + 1
                s = emit_line(s, "  " + sret_b + " = alloca " + ret_ty)
                s = emit_line(s, "  store " + ret_ty + " zeroinitializer, ptr " + sret_b)
                let sret_arg_b: String = "ptr sret(" + ret_ty + ") " + sret_b
                let mut full_args_b: String = sret_arg_b
                if len(args_str) > 0: full_args_b = sret_arg_b + ", " + args_str
                s = emit_line(s, "  call void @" + fn_name + "(" + full_args_b + ")")
                s = emit_line(s, "  " + dn + " = load " + ret_ty + ", ptr " + sret_b)
                return s
            s = emit_line(s, emit_call_ir(dn, ret_ty, fn_name, args_str))
            // v5.6.4 Rt.06 — tensor tracking for non-FnEntry-registered calls.
            if is_tensor_allocating_fn(fn_name):
                s = emit_track_tensor(s, dn)
            return s

// ---------------------------------------------------------------------------
// Built-in function emission
// ---------------------------------------------------------------------------

fn emit_builtin_print(st: EmitState, args: List<Value>) -> EmitState:
    // print() in Mapanare adds a newline (like Python's print)
    if len(args) == 0:
        return emit_rt_call_void(st, "printf", "ptr @.newline")
    let arg: Value = args[0]
    let mut s: EmitState = st
    let an: String = arg.name

    if arg.ty.kind == TK_STRING():
        return emit_rt_call_void(s, "__mn_str_println", llvm_string() + " " + an)
    if arg.ty.kind == TK_FLOAT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_float_nl, double " + an + ")")
    if arg.ty.kind == TK_INT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")
    if arg.ty.kind == TK_BOOL():
        let cnt_b: String = str(s.counter)
        s.counter = s.counter + 1
        let bext: String = "%bext" + cnt_b
        s = emit_line(s, "  " + bext + " = zext i1 " + an + " to i64")
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + bext + ")")
    // Unknown type: default to integer (impl methods return i64)
    return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")

fn emit_builtin_println(st: EmitState, args: List<Value>) -> EmitState:
    if len(args) == 0:
        return emit_rt_call_void(st, "printf", "ptr @.newline")
    let arg: Value = args[0]
    let mut s: EmitState = st
    let an: String = arg.name

    if arg.ty.kind == TK_STRING():
        return emit_rt_call_void(s, "__mn_str_println", llvm_string() + " " + an)
    if arg.ty.kind == TK_FLOAT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_float_nl, double " + an + ")")
    if arg.ty.kind == TK_INT():
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")
    if arg.ty.kind == TK_BOOL():
        let cnt_bp: String = str(s.counter)
        s.counter = s.counter + 1
        let bextp: String = "%bext" + cnt_bp
        s = emit_line(s, "  " + bextp + " = zext i1 " + an + " to i64")
        return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + bextp + ")")
    // Unknown type: default to integer (impl methods return i64)
    return emit_line(s, "  call i32 (ptr, ...) @printf(ptr @.fmt_int_nl, i64 " + an + ")")

fn emit_builtin_len(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0: return st
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_STRING():
        s = emit_rt_call(s, dn, llvm_int(), "__mn_str_len", llvm_string() + " " + an)
    else:
        if args[0].ty.kind == TK_MAP():
            // v5.15.1 — `len(map)` dispatch. Pre-existing gap surfaced
            // by the v5.15.0 map-comprehension test. The bootstrap maps
            // a Map value as `{ptr, i64}` where ``.0`` is the runtime
            // ``MnMap*``. ``__mn_map_len`` takes that pointer directly,
            // so extract field 0 and pass it.
            let tmp_mptr: String = dn + ".mp"
            let mt: String = llvm_map_type()
            s = emit_line(s, "  " + tmp_mptr + " = extractvalue " + mt + " " + an + ", 0")
            s = emit_rt_call(s, dn, llvm_int(), "__mn_map_len", "ptr " + tmp_mptr)
        else:
            // __mn_list_len expects a pointer; alloca+store the list value first
            let tmp: String = dn + ".lp"
            let lt: String = llvm_list_rt()
            s = emit_line(s, "  " + tmp + " = alloca " + lt)
            s = emit_line(s, "  store " + lt + " " + an + ", " + "ptr " + tmp)
            s = emit_rt_call(s, dn, llvm_int(), "__mn_list_len", "ptr " + tmp)
    return s

fn emit_builtin_tostring(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0: return st
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_STRING():
        return emit_copy(s, dest, args[0])
    if args[0].ty.kind == TK_BOOL():
        let cnt_zb: String = toString(s.counter)
        s.counter = s.counter + 1
        let zext_b: String = "%zb" + cnt_zb
        s = emit_line(s, "  " + zext_b + " = zext i1 " + an + " to i64")
        s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_bool", "i64 " + zext_b)
    else:
        if args[0].ty.kind == TK_FLOAT():
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_float", "double " + an)
        else:
            s = emit_rt_call(s, dn, llvm_string(), "__mn_str_from_int", "i64 " + an)
    return s

fn emit_builtin_int(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0: return st
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_FLOAT():
        s = emit_line(s, "  " + dn + " = fptosi double " + an + " to i64")
    else:
        if args[0].ty.kind == TK_INT():
            return emit_copy(s, dest, args[0])
        else:
            s = emit_rt_call(s, dn, llvm_int(), "__mn_str_to_int", llvm_string() + " " + an)
    return s

fn emit_builtin_float(st: EmitState, dest: Value, args: List<Value>) -> EmitState:
    if len(args) == 0: return st
    let mut s: EmitState = st
    let an: String = args[0].name
    let dn: String = dest.name

    if args[0].ty.kind == TK_INT():
        s = emit_line(s, "  " + dn + " = sitofp i64 " + an + " to double")
    else:
        if args[0].ty.kind == TK_FLOAT():
            return emit_copy(s, dest, args[0])
        else:
            s = emit_rt_call(s, dn, llvm_float(), "__mn_str_to_float", llvm_string() + " " + an)
    return s

// ---------------------------------------------------------------------------
// Return instruction
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// v5.4.0 Own.1 Phase 2 — Drop-glue emission
// ---------------------------------------------------------------------------
// Mirrors the Python _emit_drop_glue family (emit_llvm_text.py:1585+).
// Four per-resource helpers are called from emit_drop_glue, which is invoked
// by emit_mir_return before each `ret` instruction.  The helpers iterate
// st.str_owned / list_owned / boxed_owned, skip any local in st.moved_locals
// or whose name aliases the returned value, and emit the runtime free call.
//
// Phase 3 scope (this release): helpers are callable and correct when the
// owner lists are populated; tracker population (pushing names to
// str_owned / list_owned / boxed_owned when resource-bearing locals are
// emitted) is deferred to v5.4.1+.  With the lists empty, every helper is a
// no-op loop — stage2.ll is byte-identical except for the version placeholder
// and the lowerer-side Move markers from Phase 4.
//
// Simplifications vs Python:
//   - No multi-block null-check branch — __mn_str_free / __mn_list_free
//     already handle null data at the runtime layer.
//   - No ret-ptr alias detection — a local whose name matches ret_val_base
//     is skipped directly.  (Python builds ret_str_ptrs / ret_list_ptrs /
//     ret_ptr_fields so aliases through struct return values can also skip;
//     when tracker population lands in v5.4.1 we will revisit.)

fn list_has_string(lst: List<String>, name: String) -> Bool:
    let n: Int = len(lst)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n: return false
        if lst[i] == name: return true
        i = i + 1
    return false

fn ret_val_base(ret_val: String) -> String:
    // Strip a leading '%' so we can compare against the local name stored
    // in st.str_owned / list_owned / boxed_owned.  For non-local returns
    // (constants, SSA temps without a named local) this yields a string
    // that cannot match a local name anyway.
    if len(ret_val) == 0: return ""
    if ret_val.substr(0, 1) == "%": return ret_val.substr(1, len(ret_val) - 1)
    return ret_val

// ---------------------------------------------------------------------------
// v5.4.2 Phase 3.1 — String-returning builtin recognition
// ---------------------------------------------------------------------------
// Phase 3.2's hook (emit_mir_by_kind "call" branch) predicates tracking
// on `dest.ty.kind == TK_STRING()`, but the lowerer's generic call path
// at lower.mn:2258 defaults to mir_unknown() when __ret__fn_name isn't
// registered in lambda_vars — which is the case for all builtins not
// specially cased in lower_call_by_name (read_file, sha256, regex_replace,
// http_get, and friends). The IR is emitted with the correct llvm_string()
// return type because emit_mir_call dispatches by fn_name, but the MIR
// dest is typed TK_UNKNOWN, so Phase 3.2 skips tracking and the heap
// String leaks at function exit.
//
// This helper returns true for the Mapanare-level builtin names whose
// return type is String per mapanare/self/semantic.mn::builtin_return_type.
// It intentionally omits `str` / `toString` / `chr` / `__mn_argv` etc.
// because those ARE explicitly typed in lower_call_by_name and Phase 3.2
// picks them up directly.

fn is_string_returning_builtin(fn_name: String) -> Bool:
    if fn_name == "read_line": return true
    if fn_name == "read_file": return true
    if fn_name == "http_get": return true
    if fn_name == "sha256": return true
    if fn_name == "base64_encode": return true
    if fn_name == "base64_decode": return true
    if fn_name == "hmac_sha256": return true
    if fn_name == "hex_encode": return true
    if fn_name == "random_bytes": return true
    if fn_name == "regex_replace": return true
    if fn_name == "gpu_device_name": return true
    if fn_name == "join": return true
    if fn_name == "typeof": return true
    // v5.23.1 Mb.1: V.9 lifecycle leak — defensive belt-and-suspenders.
    // lower.mn already types the dest as mir_string() so the kind-based
    // branch at line 1650 catches it, but list this name explicitly so
    // any future refactor that loses the mir_string() hint still tracks.
    if fn_name == "__mn_indent_to_braces": return true
    // v5.48.1 Te.3.D.4.4: same belt-and-suspenders for the new
    // match-arm shorthand rewriter — lower.mn types its dest as
    // mir_string() but list explicitly so refactors that drop the
    // mir_string() hint still tracks.
    if fn_name == "__mn_rewrite_arm_stmt_shorthand": return true
    return false

// ---------------------------------------------------------------------------
// v5.4.1 Phase 2 — shadow-slot tracking helpers
// ---------------------------------------------------------------------------
// Mirrors mapanare/emit_llvm_text.py::_track_string / _track_boxed /
// _track_closure (lines 1538–1566). Each helper allocates a tracking
// slot in the entry-block prelude (alloca + zero-init), stores the
// passed value into the slot at the current emission point, and
// records the slot's bare name in st.str_owned / st.boxed_owned for
// emit_drop_glue to consult before every ret.
//
// Reassignment to the same source variable is captured by allocating
// a fresh slot per call — the prior snapshot still lives in its own
// slot, so drop-glue frees both. __mn_str_free / @free tolerate null,
// so the zero-init is safe even when the slot is never stored to.

fn emit_track_string(st: EmitState, val_name: String) -> EmitState:
    let mut s: EmitState = st
    let idx: Int = s.counter
    s.counter = s.counter + 1
    let slot_base: String = "str_track." + toString(idx)
    let slot: String = "%" + slot_base
    // Entry-block prelude: alloca + zero-init.
    s.entry_prelude_lines.push("  " + slot + " = alloca {ptr, i64}, align 8")
    s.entry_prelude_lines.push("  store {ptr, i64} zeroinitializer, ptr " + slot)
    // v5.4.3 — Rt.03 fix: inside a loop body, free the slot's prior
    // contents before overwriting. Zero-init + __mn_str_free null-
    // tolerant: first iteration no-ops. Outside loops, unchanged.
    if s.loop_depth > 0:
        let prev_tmp: String = "%prev.str." + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + prev_tmp + " = load {ptr, i64}, ptr " + slot)
        s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + prev_tmp + ")")
    // Current emission point: snapshot the value into the slot.
    s = emit_line(s, "  store {ptr, i64} " + val_name + ", ptr " + slot)
    s.str_owned.push(slot_base)
    // v5.4.4 — record the SSA source name in parallel so drop glue
    // can consult moved_locals when the lowerer emits Move(val_name).
    s.str_owned_source.push(ret_val_base(val_name))
    return s

fn emit_track_boxed(st: EmitState, ptr_val: String) -> EmitState:
    let mut s: EmitState = st
    let idx: Int = s.counter
    s.counter = s.counter + 1
    let slot_base: String = "box_track." + toString(idx)
    let slot: String = "%" + slot_base
    s.entry_prelude_lines.push("  " + slot + " = alloca ptr, align 8")
    s.entry_prelude_lines.push("  store ptr null, ptr " + slot)
    // v5.4.3 — free-before-store in loop bodies. @free tolerates null.
    if s.loop_depth > 0:
        let prev_tmp: String = "%prev.box." + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + prev_tmp + " = load ptr, ptr " + slot)
        s = emit_line(s, "  call void @free(ptr " + prev_tmp + ")")
    s = emit_line(s, "  store ptr " + ptr_val + ", ptr " + slot)
    s.boxed_owned.push(slot_base)
    // v5.4.4 — record the boxed source SSA name for moved_locals match.
    s.boxed_owned_source.push(ret_val_base(ptr_val))
    return s

fn emit_track_closure(st: EmitState, val_name: String) -> EmitState:
    // Closure values are {ptr, ptr} (fn_ptr, env_ptr). We track the
    // env_ptr only — the fn_ptr is a code pointer that never needs
    // freeing. Extract idx=1 then route through the boxed-slot path so
    // the existing free(ptr) drop-glue handler picks it up.
    let mut s: EmitState = st
    let env_idx: Int = s.counter
    s.counter = s.counter + 1
    let env_tmp: String = "%clos.env." + toString(env_idx)
    s = emit_line(s, "  " + env_tmp + " = extractvalue {ptr, ptr} " + val_name + ", 1")
    emit_track_boxed(s, env_tmp)

// v5.6.4 Own.1 Phase 3 — Rt.06 tensor tracking.
// Mirrors emit_track_boxed structurally — tensor values are a single
// ptr (from __mn_tensor_alloc / _slice / broadcast / scalar / rscalar
// fns). Free function is __mn_tensor_free (void, null-tolerant per
// runtime/native/mapanare_runtime.c::mapanare_tensor_free).
//
// The loop-depth branch is load-bearing for 53_linear_regression:
// 10 epochs × ~4 fresh tensors per iter via `X * w + b`, `pred - y`,
// `error * X` — without intra-loop free-before-store, 40 tensors
// leak even with drop-glue at return. With it, each iteration's
// 4 live slots collapse via overwrite.
fn emit_track_tensor(st: EmitState, ptr_val: String) -> EmitState:
    let mut s: EmitState = st
    let idx: Int = s.counter
    s.counter = s.counter + 1
    let slot_base: String = "tens_track." + toString(idx)
    let slot: String = "%" + slot_base
    s.entry_prelude_lines.push("  " + slot + " = alloca ptr, align 8")
    s.entry_prelude_lines.push("  store ptr null, ptr " + slot)
    if s.loop_depth > 0:
        let prev_tmp: String = "%prev.tens." + toString(s.counter)
        s.counter = s.counter + 1
        s = emit_line(s, "  " + prev_tmp + " = load ptr, ptr " + slot)
        s = emit_line(s, "  call void @__mn_tensor_free(ptr " + prev_tmp + ")")
    s = emit_line(s, "  store ptr " + ptr_val + ", ptr " + slot)
    s.tensor_owned.push(slot_base)
    s.tensor_owned_source.push(ret_val_base(ptr_val))
    return s

// v5.6.4 — predicate for runtime fns that return a freshly-allocated
// tensor `ptr` (i.e. every call site that needs emit_track_tensor).
// Used by the generic call path in emit_mir_call to attach tracking
// without duplicating the 20 tensor-binop emission branches. Must
// stay in sync with the explicit injection sites (emit_tensor_init
// and the __mn_tensor_slice special case): every fn listed here is
// tracked, every tracked call site is for a fn in this list.
fn is_tensor_allocating_fn(fn_name: String) -> Bool:
    if fn_name == "__mn_tensor_alloc": return true
    if fn_name == "__mn_tensor_slice": return true
    if fn_name == "__mn_tensor_reshape": return true
    // v5.45.0 Ts.2.B + Ts.3.B — view returns a refcount-aliased view
    // (still tracked: drop-glue must call __mn_tensor_free which is
    // refcount-aware as of Ts.2.A). step_slice returns a fresh
    // contiguous tensor (copy semantics).
    if fn_name == "__mn_tensor_view": return true
    if fn_name == "__mn_tensor_step_slice": return true
    if fn_name == "__mn_tensor_add_broadcast_f64": return true
    if fn_name == "__mn_tensor_sub_broadcast_f64": return true
    if fn_name == "__mn_tensor_mul_broadcast_f64": return true
    if fn_name == "__mn_tensor_div_broadcast_f64": return true
    if fn_name == "__mn_tensor_add_broadcast_i64": return true
    if fn_name == "__mn_tensor_sub_broadcast_i64": return true
    if fn_name == "__mn_tensor_mul_broadcast_i64": return true
    if fn_name == "__mn_tensor_div_broadcast_i64": return true
    if fn_name == "__mn_tensor_add_scalar_f64": return true
    if fn_name == "__mn_tensor_sub_scalar_f64": return true
    if fn_name == "__mn_tensor_mul_scalar_f64": return true
    if fn_name == "__mn_tensor_div_scalar_f64": return true
    if fn_name == "__mn_tensor_add_scalar_i64": return true
    if fn_name == "__mn_tensor_sub_scalar_i64": return true
    if fn_name == "__mn_tensor_mul_scalar_i64": return true
    if fn_name == "__mn_tensor_div_scalar_i64": return true
    if fn_name == "__mn_tensor_rsub_scalar_f64": return true
    if fn_name == "__mn_tensor_rdiv_scalar_f64": return true
    if fn_name == "__mn_tensor_rsub_scalar_i64": return true
    if fn_name == "__mn_tensor_rdiv_scalar_i64": return true
    return false

// ---------------------------------------------------------------------------
// v5.4.1 Phase 4 — return-escape detection
// ---------------------------------------------------------------------------
// emit_drop_glue_strings / _lists / _boxed each take a "ret_data_ptr"
// SSA name. When non-empty, the helper emits a per-slot icmp + br
// pattern that skips the free if the slot's loaded data pointer
// aliases the returned pointer. When empty (void return, scalar
// non-resource return, or aggregate return with conservative skip),
// the slot is freed unconditionally.
//
// Mirrors mapanare/emit_llvm_text.py::_emit_drop_glue_strings/_lists/
// _boxed (lines 1712–1849), with one structural simplification:
// branches inline into the same function body (Mapanare's emitter
// already uses inline label emission for bounds-check traps; same
// pattern applies here).

// v5.4.4 — Drop-glue OR-reduction helper.
// Emits: store i1 false to an entry-prelude alloca; per ret-ptr icmp +
// load acc + or + store; final load; br to skip_lbl/free_lbl.
// Extracted from the per-resource drop-glue helpers so the inner while
// loop is a top-level call rather than a deeply nested for-in-if inside
// the outer slot-iteration loop. The bootstrap emitter truncates output
// on the previous deep-nest pattern (observed at slot 25867 of
// emit_mir_call in stage2.ll); a top-level-call factoring avoids it.
fn emit_or_reduce_ret_match(st: EmitState, slot_ptr: String, ret_ptrs: List<String>, cnt: Int, prefix: String, skip_lbl: String, free_lbl: String) -> EmitState:
    let mut s: EmitState = st
    let nret: Int = len(ret_ptrs)
    let acc: String = "%drop." + prefix + "macc." + toString(cnt)
    s.entry_prelude_lines.push("  " + acc + " = alloca i1, align 1")
    s = emit_line(s, "  store i1 false, ptr " + acc)
    let mut ri: Int = 0
    while ri < nret:
        let rp: String = ret_ptrs[ri]
        let same: String = "%drop." + prefix + "same." + toString(cnt) + "." + toString(ri)
        let cur: String = "%drop." + prefix + "cur." + toString(cnt) + "." + toString(ri)
        let comb: String = "%drop." + prefix + "comb." + toString(cnt) + "." + toString(ri)
        s = emit_line(s, "  " + same + " = icmp eq ptr " + slot_ptr + ", " + rp)
        s = emit_line(s, "  " + cur + " = load i1, ptr " + acc)
        s = emit_line(s, "  " + comb + " = or i1 " + cur + ", " + same)
        s = emit_line(s, "  store i1 " + comb + ", ptr " + acc)
        ri = ri + 1
    let final_match: String = "%drop." + prefix + "final." + toString(cnt)
    s = emit_line(s, "  " + final_match + " = load i1, ptr " + acc)
    s = emit_line(s, "  br i1 " + final_match + ", label %" + skip_lbl + ", label %" + free_lbl)
    return s

fn emit_drop_glue_strings(st: EmitState, ret_str_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.str_owned)
    let ns: Int = len(s.str_owned_source)
    let nret: Int = len(ret_str_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n: return s
        let name: String = s.str_owned[i]
        // v5.4.4 — consult str_owned_source[i] instead of the slot name.
        let mut source: String = ""
        if i < ns: source = s.str_owned_source[i]
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let svtmp: String = "%drop.s" + toString(cnt)
            s = emit_line(s, "  " + svtmp + " = load {ptr, i64}, ptr %" + name)
            if nret > 0:
                let sptmp: String = "%drop.p" + toString(cnt)
                s = emit_line(s, "  " + sptmp + " = extractvalue {ptr, i64} " + svtmp + ", 0")
                let skip_lbl: String = "drop.skip." + toString(cnt)
                let free_lbl: String = "drop.free." + toString(cnt)
                s = emit_or_reduce_ret_match(s, sptmp, ret_str_ptrs, cnt, "s", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + svtmp + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + svtmp + ")")
        i = i + 1
    return s

fn emit_drop_glue_lists(st: EmitState, ret_list_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.list_owned)
    let ns: Int = len(s.list_owned_source)
    let nret: Int = len(ret_list_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n: return s
        let name: String = s.list_owned[i]
        let mut source: String = ""
        if i < ns: source = s.list_owned_source[i]
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            if nret > 0:
                let cnt: Int = s.counter
                s.counter = s.counter + 1
                let lvtmp: String = "%drop.lv" + toString(cnt)
                let lptmp: String = "%drop.lp" + toString(cnt)
                let free_lbl: String = "drop.lfree." + toString(cnt)
                let skip_lbl: String = "drop.lskip." + toString(cnt)
                s = emit_line(s, "  " + lvtmp + " = load " + llvm_list_rt() + ", ptr %" + name)
                s = emit_line(s, "  " + lptmp + " = extractvalue " + llvm_list_rt() + " " + lvtmp + ", 0")
                s = emit_or_reduce_ret_match(s, lptmp, ret_list_ptrs, cnt, "l", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @__mn_list_free(ptr %" + name + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @__mn_list_free(ptr %" + name + ")")
        i = i + 1
    return s

fn emit_drop_glue_boxed(st: EmitState, ret_box_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.boxed_owned)
    let ns: Int = len(s.boxed_owned_source)
    let nret: Int = len(ret_box_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n: return s
        let name: String = s.boxed_owned[i]
        let mut source: String = ""
        if i < ns: source = s.boxed_owned_source[i]
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let tmp: String = "%drop.b" + toString(cnt)
            s = emit_line(s, "  " + tmp + " = load ptr, ptr %" + name)
            if nret > 0:
                let free_lbl: String = "drop.bfree." + toString(cnt)
                let skip_lbl: String = "drop.bskip." + toString(cnt)
                s = emit_or_reduce_ret_match(s, tmp, ret_box_ptrs, cnt, "b", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @free(ptr " + tmp + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @free(ptr " + tmp + ")")
        i = i + 1
    return s

// v5.6.4 — tensor drop-glue (Rt.06).
//
// Mirrors emit_drop_glue_boxed: single `ptr` slot type, but calls
// __mn_tensor_free instead of @free. Runtime C guard at
// runtime/native/mapanare_gpu_builtins.c handles null (`if (!t) return`)
// — safe to call on the zero-initialised first-iter slot value.
//
// When ret_tensor_ptrs is non-empty, emit the same icmp-eq-or chain
// as the string / list / boxed helpers and short-circuit frees that
// alias the escaping return value. Over-approximates per PLAN §D4:
// the same ptr also lands in ret_box_ptrs, but each helper matches
// against its own slot list, so there is no double-free on the
// matching helper and no missed-free on the non-matching one
// (slots in the other list simply don't overlap).
fn emit_drop_glue_tensors(st: EmitState, ret_tensor_ptrs: List<String>) -> EmitState:
    let mut s: EmitState = st
    let n: Int = len(s.tensor_owned)
    let ns: Int = len(s.tensor_owned_source)
    let nret: Int = len(ret_tensor_ptrs)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= n: return s
        let name: String = s.tensor_owned[i]
        let mut source: String = ""
        if i < ns: source = s.tensor_owned_source[i]
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let tvtmp: String = "%drop.tv" + toString(cnt)
            s = emit_line(s, "  " + tvtmp + " = load ptr, ptr %" + name)
            if nret > 0:
                let free_lbl: String = "drop.tfree." + toString(cnt)
                let skip_lbl: String = "drop.tskip." + toString(cnt)
                s = emit_or_reduce_ret_match(s, tvtmp, ret_tensor_ptrs, cnt, "t", skip_lbl, free_lbl)
                s = emit_line(s, free_lbl + ":")
                s = emit_line(s, "  call void @__mn_tensor_free(ptr " + tvtmp + ")")
                s = emit_line(s, "  br label %" + skip_lbl)
                s = emit_line(s, skip_lbl + ":")
            else:
                s = emit_line(s, "  call void @__mn_tensor_free(ptr " + tvtmp + ")")
        i = i + 1
    return s

// v5.5.7 — destroy-path drop-glue for coroutines.
//
// Called from coro.cleanup before `coro.free` when the scheduler
// destroys an async fn frame at a suspend point. Iterates the
// usual owner lists unconditionally (no ret_val filter — there is
// no return value on this path) but still consults moved_locals so
// owners that were moved/consumed pre-suspend don't get
// double-freed.
//
// Tracking-slot allocas live in the entry-block prelude (v5.4.1)
// and are zero-initialised before any user instruction, so loads
// from them at coro.cleanup are well-defined even if the slot was
// never written. The runtime free helpers (__mn_str_free,
// __mn_list_free, free) are null-tolerant per v5.4.1 design, so
// loading a never-written slot just no-ops.
//
// SSA-name prefix is `%drop.d.*.N` (`d` = destroy) so it cannot
// collide with the `%drop.s|l|b.N` names produced by the normal-
// exit drop-glue helpers above.
fn emit_drop_glue_destroy(st: EmitState) -> EmitState:
    let mut s: EmitState = st
    // Strings
    let ns: Int = len(s.str_owned)
    let nss: Int = len(s.str_owned_source)
    let mut i: Int = 0
    for _ in 0..1024:
        if i >= ns: break
        let name: String = s.str_owned[i]
        let mut source: String = ""
        if i < nss: source = s.str_owned_source[i]
        let is_moved: Bool = (len(source) > 0) && list_has_string(s.moved_locals, source)
        if !is_moved:
            let cnt: Int = s.counter
            s.counter = s.counter + 1
            let svtmp: String = "%drop.d.s" + toString(cnt)
            s = emit_line(s, "  " + svtmp + " = load {ptr, i64}, ptr %" + name)
            s = emit_line(s, "  call void @__mn_str_free({ptr, i64} " + svtmp + ")")
        i = i + 1
    // Lists
    let nl: Int = len(s.list_owned)
    let mut j: Int = 0
    for _ in 0..1024:
        if j >= nl: break
        let lname: String = s.list_owned[j]
        let mut lsource: String = ""
        if j < len(s.list_owned_source): lsource = s.list_owned_source[j]
        let l_is_moved: Bool = (len(lsource) > 0) && list_has_string(s.moved_locals, lsource)
        if !l_is_moved:
            s = emit_line(s, "  call void @__mn_list_free(ptr %" + lname + ")")
        j = j + 1
    // Boxed
    let nb: Int = len(s.boxed_owned)
    let mut k: Int = 0
    for _ in 0..1024:
        if k >= nb: break
        let bname: String = s.boxed_owned[k]
        let mut bsource: String = ""
        if k < len(s.boxed_owned_source): bsource = s.boxed_owned_source[k]
        let b_is_moved: Bool = (len(bsource) > 0) && list_has_string(s.moved_locals, bsource)
        if !b_is_moved:
            let cnt2: Int = s.counter
            s.counter = s.counter + 1
            let btmp: String = "%drop.d.b" + toString(cnt2)
            s = emit_line(s, "  " + btmp + " = load ptr, ptr %" + bname)
            s = emit_line(s, "  call void @free(ptr " + btmp + ")")
        k = k + 1
    // Tensors (v5.6.4 Rt.06). Parallel to the three loops above;
    // __mn_tensor_free is null-tolerant so loading a never-written
    // slot is a no-op.
    let nt: Int = len(s.tensor_owned)
    let mut m: Int = 0
    for _ in 0..1024:
        if m >= nt: break
        let tname: String = s.tensor_owned[m]
        let mut tsource: String = ""
        if m < len(s.tensor_owned_source): tsource = s.tensor_owned_source[m]
        let t_is_moved: Bool = (len(tsource) > 0) && list_has_string(s.moved_locals, tsource)
        if !t_is_moved:
            let cnt3: Int = s.counter
            s.counter = s.counter + 1
            let ttmp: String = "%drop.d.t" + toString(cnt3)
            s = emit_line(s, "  " + ttmp + " = load ptr, ptr %" + tname)
            s = emit_line(s, "  call void @__mn_tensor_free(ptr " + ttmp + ")")
        m = m + 1
    return s

fn ret_ty_is_aggregate(st: EmitState, ret_ty: String) -> Bool:
    // v5.6.6 RESCOPE — Rt.04 cannot be closed by a one-level walk.
    // Attempt: re-lift the `%struct.*` guard with a struct-size gate
    // (N≤4 fields, M≤10 slots) so the walk fires for small data
    // structs like 62_list_output's `St { lines: List<String>, n: Int }`.
    // The walk extracts `lines` as a list ret-ptr and `n` skips
    // (not a resource); String drop glue alias-checks against the
    // list ret-ptr — but the tracked String slots' data pointers
    // are the INDIVIDUAL STRINGS *inside* the list, not the list
    // itself. The single-level walk doesn't see them; drop glue
    // frees them; caller's `__mn_str_join` reads freed memory →
    // confirmed heap-use-after-free under ASan.
    //
    // This is a STRUCT-OF-LIST-OF-STRING shape (2 levels deep).
    // The PLAN's exit criterion #1 (62_list_output CLEAN) is
    // unreachable without a multi-level walk that the PLAN
    // itself excluded as "v5.7.x scope or v6.0 borrow checker".
    //
    // Decision: keep `%struct.*` returns conservatively skipped
    // (62_list_output stays LEAK 9 objs / 141 B, baseline-gated)
    // until the borrow checker or multi-level walk lands. The
    // walk infrastructure at `emit_drop_glue:4753+` remains in
    // place for the future fix; the gate parameters (st: EmitState
    // signature) are preserved for the same reason.
    //
    // What this release DOES contribute: the signature change
    // threads `st` through `ret_ty_is_aggregate` so future re-
    // lift attempts can size-gate without another invasive
    // refactor. The first such attempt landed and reverted in
    // v5.4.4; the second (v5.6.6) lands and reverts here.
    if ret_ty.starts_with("%struct."): return true
    if ret_ty.starts_with("%enum."): return true
    if ret_ty.starts_with("{") && ret_ty != llvm_string() && ret_ty != llvm_list_rt():
        return true
    return false

fn emit_drop_glue(st: EmitState, ret_val: String, ret_ty: String) -> EmitState:
    // Fast path: no owners means nothing to drop.
    if len(st.str_owned) == 0 && len(st.list_owned) == 0 && len(st.boxed_owned) == 0 && len(st.tensor_owned) == 0:
        return st

    // Conservative skip for enum / option / result / anonymous struct
    // returns; for `%struct.*` the v5.6.6 size gate inside
    // `ret_ty_is_aggregate` decides whether to walk one level of fields
    // (small struct in small-slot fn) or skip (large struct or hot fn).
    if ret_ty_is_aggregate(st, ret_ty):
        return st

    // v5.6.9 Ve.3 — List return multi-level UAF: when the function returns
    // a list with ANY tracked owned resources (strings/lists/boxes), the
    // list elements may reference those resources THROUGH their fields,
    // not by the list's own data ptr. drop_glue_* alias-checks at one
    // level (against the list's data ptr); the inner refs are invisible.
    // Without multi-level alias analysis (v6.0 borrow-checker scope),
    // every drop fires unconditionally → UAF when caller dereferences
    // the returned list. Same RESCOPE pattern as v5.6.6 Rt.04 (List<String>
    // in returned struct).
    //
    // Closes Ve.3: `mir_opt::clone_instr_for_inline` returns
    // List<Instruction>. Each Instruction is `{i64 tag, ptr payload}` with
    // a heap-boxed payload tracked in `boxed_owned`. drop_glue_boxed at
    // function exit freed every payload, leaving dangling ptrs in the
    // returned list. emit_alloca later dereferenced those dangling ptrs
    // and read garbage Value names → __mn_str_concat → OOM with garbage
    // size on `/tmp/p1.mn`; SIGSEGV on full `mnc_all.mn` self-compile
    // (same class, different memory layout).
    //
    // Cost: intermediate strings/lists/boxes NOT in the returned list
    // leak. Accepted per v5.6.6 RESCOPE — UAF prevention > leak prevention.
    if ret_ty == llvm_list_rt() && len(st.boxed_owned) > 0:
        return st

    let mut s: EmitState = st
    let mut ret_str_ptrs: List<String> = []
    let mut ret_list_ptrs: List<String> = []
    let mut ret_box_ptrs: List<String> = []
    // v5.6.4 Rt.06 — tensor escape list. Populated in parallel with
    // ret_box_ptrs for scalar ptr returns and %struct.* ptr fields
    // (see PLAN §D4 for why dual-push is safe).
    let mut ret_tensor_ptrs: List<String> = []

    // Scalar String return: extract the data ptr once.
    if ret_ty == llvm_string() && len(ret_val) > 0:
        let cnt: Int = s.counter
        s.counter = s.counter + 1
        let p: String = "%ret.sp" + toString(cnt)
        s = emit_line(s, "  " + p + " = extractvalue {ptr, i64} " + ret_val + ", 0")
        ret_str_ptrs.push(p)
    // Scalar List return.
    if ret_ty == llvm_list_rt() && len(ret_val) > 0:
        let cnt: Int = s.counter
        s.counter = s.counter + 1
        let p: String = "%ret.lp" + toString(cnt)
        s = emit_line(s, "  " + p + " = extractvalue " + llvm_list_rt() + " " + ret_val + ", 0")
        ret_list_ptrs.push(p)
    // Scalar ptr return — could be a boxed enum payload or a tensor.
    // Push to both lists; each per-resource helper alias-checks its
    // own slot list, so the non-matching list is a no-op.
    if ret_ty == "ptr" && len(ret_val) > 0:
        ret_box_ptrs.push(ret_val)
        ret_tensor_ptrs.push(ret_val)

    // v5.4.4 — %struct.* return: walk one level of fields and extract
    // every String / List / ptr field into the corresponding ret-ptr
    // list. Combined with lowerer Move emission, the drop-glue per-
    // resource helpers can skip tracked slots that alias an escaping
    // field while freeing unescaped intermediates.
    if ret_ty.starts_with("%struct.") && len(ret_val) > 0:
        let sname: String = ret_ty.substr(8, len(ret_ty) - 8)
        let sopt: Option<StructEntry> = find_struct_entry(s, sname)
        match sopt:
            Some(sent) =>:
                let nf: Int = len(sent.field_types)
                let mut fi: Int = 0
                while fi < nf:
                    let ft: String = sent.field_types[fi]
                    if ft == llvm_string():
                        let cnt: Int = s.counter
                        s.counter = s.counter + 1
                        let fval: String = "%ret.ssf" + toString(cnt)
                        let fp: String = "%ret.ssp" + toString(cnt)
                        s = emit_line(s, "  " + fval + " = extractvalue " + ret_ty + " " + ret_val + ", " + toString(fi))
                        s = emit_line(s, "  " + fp + " = extractvalue {ptr, i64} " + fval + ", 0")
                        ret_str_ptrs.push(fp)
                    else if ft == llvm_list_rt():
                        let cnt: Int = s.counter
                        s.counter = s.counter + 1
                        let fval: String = "%ret.slf" + toString(cnt)
                        let fp: String = "%ret.slp" + toString(cnt)
                        s = emit_line(s, "  " + fval + " = extractvalue " + ret_ty + " " + ret_val + ", " + toString(fi))
                        s = emit_line(s, "  " + fp + " = extractvalue " + llvm_list_rt() + " " + fval + ", 0")
                        ret_list_ptrs.push(fp)
                    else if ft == "ptr":
                        let cnt: Int = s.counter
                        s.counter = s.counter + 1
                        let fp: String = "%ret.sbp" + toString(cnt)
                        s = emit_line(s, "  " + fp + " = extractvalue " + ret_ty + " " + ret_val + ", " + toString(fi))
                        // v5.6.4 Rt.06 — ptr field could be a tensor
                        // inside a struct return; dual-push same SSA
                        // to both escape lists.
                        ret_box_ptrs.push(fp)
                        ret_tensor_ptrs.push(fp)
                    fi = fi + 1
            _ => {}

    s = emit_drop_glue_strings(s, ret_str_ptrs)
    s = emit_drop_glue_lists(s, ret_list_ptrs)
    s = emit_drop_glue_boxed(s, ret_box_ptrs)
    s = emit_drop_glue_tensors(s, ret_tensor_ptrs)
    return s

fn emit_mir_return(st: EmitState, val_opt: Option<Value>) -> EmitState:
    match val_opt:
        Some(val) =>:
            let ty: String = st.current_ret_type
            // v5.5.4 Sh.4 Phase 2 — async fn ret rewrite. The
            // current_ret_type was set to "ASYNC_PTR:" + inner_ty by
            // emit_mir_function when entering an async fn. Instead of
            // emitting `ret <ty> <val>`, we box the value, mark the
            // Future as Ready, store the box into the payload slot,
            // and branch to %coro.final (the shared epilogue block).
            // Mirrors emit_llvm_text.py:2613–2628.
            if ty.starts_with("ASYNC_PTR:"):
                let inner_ty: String = ty.substr(10, len(ty) - 10)
                let mut sa: EmitState = emit_drop_glue(st, val.name, inner_ty)
                let n: Int = sa.counter
                sa.counter = n + 1
                let box_name: String = "%ret.box." + toString(n)
                let slot_name: String = "%ret.val.slot." + toString(n)
                sa = emit_line(sa, "  " + box_name + " = call ptr @malloc(i64 8)")
                sa = emit_line(sa, "  store " + inner_ty + " " + val.name + ", ptr " + box_name)
                sa = emit_line(sa, "  store i8 1, ptr %future")
                sa = emit_line(sa, "  " + slot_name + " = getelementptr inbounds {i8, ptr}, ptr %future, i32 0, i32 1")
                sa = emit_line(sa, "  store ptr " + box_name + ", ptr " + slot_name)
                return emit_line(sa, "  br label %coro.final")
            if ty == "void":
                let mut sv: EmitState = emit_drop_glue(st, "", ty)
                return emit_line(sv, emit_ret_void())
            // v5.0.4 Cb.15: sret via per-target ABI classifier
            if use_sret_return(st, ty):
                let mut s0: EmitState = emit_drop_glue(st, val.name, ty)
                let mut s: EmitState = emit_line(s0, "  store " + ty + " " + val.name + ", ptr %__sret__")
                return emit_line(s, emit_ret_void())
            // main() returns i32 but Mapanare Int is i64 — truncate
            if ty == "i32":
                let mut s1: EmitState = emit_drop_glue(st, val.name, ty)
                let trunc_name: String = val.name + ".trunc"
                let mut s: EmitState = emit_line(s1, "  " + trunc_name + " = trunc i64 " + val.name + " to i32")
                return emit_line(s, emit_ret("i32", trunc_name))
            // v5.5.6 Sh.4 Phase 3: async-aware main — prepend
            // `call void @__mn_coro_scheduler_destroy()` so worker
            // threads are joined and mutexes / overflow queue freed
            // before the C ABI-level `ret i32`. Parallel to the
            // "i32" branch above. Drop-glue fires first (already the
            // pattern); destroy is idempotent per v5.1.4 runtime.
            if ty == "i32_async":
                let mut sa2: EmitState = emit_drop_glue(st, val.name, "i32")
                sa2 = emit_line(sa2, "  call void @__mn_coro_scheduler_destroy()")
                let trunc_name_a: String = val.name + ".trunc"
                let mut sa3: EmitState = emit_line(sa2, "  " + trunc_name_a + " = trunc i64 " + val.name + " to i32")
                return emit_line(sa3, emit_ret("i32", trunc_name_a))
            let mut s2: EmitState = emit_drop_glue(st, val.name, ty)
            return emit_line(s2, emit_ret(ty, val.name))
        _ =>:
            // For non-void functions, emit zeroinitializer return (dead code from
            // match arms that all terminate). For void functions, emit ret void.
            let ret_ty: String = st.current_ret_type
            // v5.5.4 Sh.4 Phase 2 — async fn ret void rewrite.
            // No value to box; just mark the Future as Ready (null
            // payload) and branch to the epilogue.
            if ret_ty.starts_with("ASYNC_PTR:"):
                let mut svn: EmitState = emit_drop_glue(st, "", "void")
                svn = emit_line(svn, "  store i8 1, ptr %future")
                return emit_line(svn, "  br label %coro.final")
            // v5.5.6 Sh.4 Phase 3: dead-code fallback for async-aware
            // main (mirror of the value-carrying path above). Every
            // main exit must hit scheduler_destroy before the i32 ret.
            if ret_ty == "i32_async":
                let mut svna: EmitState = emit_drop_glue(st, "", "i32")
                svna = emit_line(svna, "  call void @__mn_coro_scheduler_destroy()")
                return emit_line(svna, "  ret i32 0")
            let mut sv2: EmitState = emit_drop_glue(st, "", ret_ty)
            if ret_ty != "void":
                return emit_line(sv2, "  ret " + ret_ty + " zeroinitializer")
            return emit_line(sv2, emit_ret_void())

// ---------------------------------------------------------------------------
// Switch instruction
// ---------------------------------------------------------------------------

fn emit_mir_switch(st: EmitState, tag: Value, cases: List<SwitchCase>, default_bb: String) -> EmitState:
    let mut s: EmitState = emit_line(st, emit_switch_hdr(tag.name, default_bb))
    // Resolve the enum name from the tag value's type for variant index lookup
    let enum_name: String = tag.ty.name

    let mut i: Int = 0
    for _ in 0..500:
        if i >= len(cases):
            s = emit_line(s, "  ]")
            return s
        let c: SwitchCase = cases[i]
        // If the case value is a variant name (not a number), resolve to integer index
        // This mirrors the Python emitter's _vtag() method
        let mut case_val: String = c.tag_value
        if len(case_val) > 0:
            let first_ch: Int = c.tag_value.byte_at(0)
            // If not a digit (0-9) and not '-', it's a variant name → resolve to index
            if first_ch < 48 || first_ch > 57:
                if first_ch != 45:
                    // Hardcoded indices for Result/Option builtins
                    if case_val == "Ok" || case_val == "Some":
                        case_val = "1"
                    else if case_val == "Err" || case_val == "None":
                        case_val = "0"
                    else:
                        case_val = toString(resolve_variant_index(s, enum_name, case_val))
        s = emit_line(s, emit_switch_case(case_val, c.block_label))
        i = i + 1
    s = emit_line(s, "  ]")
    return s

// ---------------------------------------------------------------------------
// Agent instructions
// ---------------------------------------------------------------------------

fn emit_agent_spawn(st: EmitState, dest: Value, ty: MIRType, args: List<Value>) -> EmitState:
    let dn: String = dest.name
    let mut s: EmitState = st
    // Call agent spawn runtime function
    s = emit_rt_call(s, dn, "ptr", "__mn_agent_spawn", "ptr null, ptr null")
    s

fn emit_agent_send(st: EmitState, ag: Value, channel: String, val: Value) -> EmitState = emit_rt_call_void(st, "__mn_agent_send", "ptr " + ag.name + ", ptr null, ptr null")

fn emit_agent_sync(st: EmitState, dest: Value, ag: Value, channel: String) -> EmitState:
    let dn: String = dest.name
    let s2: EmitState = emit_rt_call(st, dn, "ptr", "__mn_agent_sync", "ptr " + ag.name + ", ptr null")
    s2

// ---------------------------------------------------------------------------
// Signal instructions
// ---------------------------------------------------------------------------

fn emit_signal_init(st: EmitState, dest: Value, ty: MIRType, val: Value) -> EmitState:
    let dn: String = dest.name
    let s2: EmitState = emit_rt_call(st, dn, "ptr", "__mn_signal_new", "ptr null")
    s2

fn emit_signal_get(st: EmitState, dest: Value, sig: Value) -> EmitState:
    let dn: String = dest.name
    let s2: EmitState = emit_rt_call(st, dn, "ptr", "__mn_signal_get", "ptr " + sig.name)
    s2

fn emit_signal_set(st: EmitState, sig: Value, val: Value) -> EmitState = emit_rt_call_void(st, "__mn_signal_set", "ptr " + sig.name + ", ptr null")

// ---------------------------------------------------------------------------
// StreamOp instruction
// ---------------------------------------------------------------------------

fn emit_stream_op(st: EmitState, dest: Value, kind: StreamOpKind, source: Value, args: List<Value>) -> EmitState:
    let mut s: EmitState = st
    let dn: String = dest.name
    // Stream operations are runtime-dispatched; minimal LLVM lowering
    let s2: EmitState = emit_line(s, "  " + dn + " = bitcast ptr " + source.name + " to ptr")
    s2

// ---------------------------------------------------------------------------
// InterpConcat instruction
// ---------------------------------------------------------------------------

fn emit_interp_concat(st: EmitState, dest: Value, parts: List<Value>) -> EmitState:
    if len(parts) == 0:
        return emit_const(st, dest, mir_string(), "")
    if len(parts) == 1:
        return emit_copy(st, dest, parts[0])

    // Concatenate parts left-to-right using __mn_str_concat. The final
    // concat writes into `dest.name` directly so downstream uses of
    // `dest` resolve to a defined SSA value (v5.16.0 Te.4.D — fix
    // for "use of undefined value" when the chain has >1 join).
    let mut s: EmitState = st
    let dn: String = dest.name

    let mut acc: String = parts[0].name

    let mut i: Int = 1
    let nparts: Int = len(parts)
    for _ in 0..500:
        if i < nparts:
            let is_last: Bool = (i == nparts - 1)
            let mut tmp: String = dn + ".c" + toString(i)
            if is_last: tmp = dn
            s = emit_rt_call(s, tmp, llvm_string(), "__mn_str_concat", llvm_string() + " " + acc + ", " + llvm_string() + " " + parts[i].name)
            // v5.4.1 Phase 3.4 — each __mn_str_concat result is a fresh
            // heap allocation. Track each intermediate so drop-glue
            // frees them; escape detection (Phase 4) skips the final
            // when it leaves via the return value.
            s = emit_track_string(s, tmp)
            acc = tmp
            i = i + 1
    return s

// ---------------------------------------------------------------------------
// Phi instruction
// ---------------------------------------------------------------------------

fn emit_mir_phi(st: EmitState, dest: Value, incoming: List<PhiEntry>) -> EmitState:
    let mut ty: String = resolve_type(st, dest.ty)
    let dn: String = dest.name

    let mut s: EmitState = st
    let mut skip: Bool = false
    if len(incoming) == 0: skip = true
    if ty == "void": skip = true
    // For Phis with i64 type (unresolved or unknown): recover the actual type.
    // Step 1: check MIR types of incoming values.
    if ty == "i64" && len(incoming) > 0:
        let mut ci: Int = 0
        for _ in 0..100:
            if ci < len(incoming):
                let inc_ty: String = resolve_type(st, incoming[ci].val.ty)
                if inc_ty != "i64" && inc_ty != "void":
                    ty = inc_ty
                ci = ci + 1
    // Step 2: if still i64, scan backwards through CURRENT FUNCTION's emitted
    // lines (stop at "define" or "entry:") for the incoming value's phi definition.
    if ty == "i64" && len(incoming) > 0:
        let mut ci2: Int = 0
        for _ in 0..20:
            if ci2 < len(incoming) && ty == "i64":
                let vname: String = incoming[ci2].val.name
                if vname != "zeroinitializer" && len(vname) > 1:
                    let search: String = vname + " = phi "
                    let mut li: Int = len(s.lines) - 1
                    for _ in 0..5000:
                        if li >= 0 && ty == "i64":
                            let line: String = s.lines[li]
                            // Stop at function boundary
                            if line.starts_with("define "): li = -1
                            if line.starts_with("}"): li = -1
                            if li >= 0 && line.contains(search):
                                let ppos: Int = line.find(search) + len(search)
                                let rest: String = line.substr(ppos, len(line) - ppos)
                                let bpos: Int = rest.find(" [")
                                if bpos > 0:
                                    let fty: String = rest.substr(0, bpos)
                                    if fty != "i64" && fty != "void": ty = fty
                            li = li - 1
                ci2 = ci2 + 1

    if !skip:
        let mut phi_str: String = "  " + dn + " = phi " + ty + " "
        let mut i: Int = 0
        let nincoming: Int = len(incoming)
        for _ in 0..500:
            if i < nincoming:
                let e: PhiEntry = incoming[i]
                if i > 0:
                    phi_str = phi_str + ", "
                phi_str = phi_str + "[ " + e.val.name + ", %" + e.block_label + " ]"
                i = i + 1
        s = emit_line(s, phi_str)
    return s

// ---------------------------------------------------------------------------
// MIR basic block emission
// ---------------------------------------------------------------------------

fn emit_mir_basic_block(st: EmitState, bb: BasicBlock) -> EmitState:
    let mut s: EmitState = emit_line(st, bb.label + ":")
    // v5.4.3 — enter loop body. Lowerer emits block labels with
    // "for_body" / "while_body" / "mapfor_body" prefixes; inside those
    // blocks, emit_track_string / _boxed / _closure free prior slot
    // contents before storing (the shadow slot otherwise leaks every
    // iteration after the first). Matched pop before returning.
    let mut bumped: Bool = false
    if bb.label.starts_with("for_body") || bb.label.starts_with("while_body") || bb.label.starts_with("mapfor_body"):
        s.loop_depth = s.loop_depth + 1
        bumped = true
    let mut i: Int = 0
    for _ in 0..2000:
        if i >= len(bb.instructions):
            if bumped: s.loop_depth = s.loop_depth - 1
            return s
        let inst: Instruction = bb.instructions[i]
        s = emit_mir_instruction(s, inst)
        i = i + 1
    if bumped: s.loop_depth = s.loop_depth - 1
    return s

// ---------------------------------------------------------------------------
// MIR function emission
// ---------------------------------------------------------------------------

// v5.5.6 Sh.4 Phase 3 — does any function in the module carry the
// `async` decorator?  Gates main's scheduler_init / scheduler_destroy
// injection and (via caller) the scheduler-driven BlockOn pattern.
// Free helper to avoid a Reg.1 EmitState struct bump.
fn module_has_async(module: MIRModule) -> Bool:
    let mut i: Int = 0
    for _ in 0..5000:
        if i >= len(module.functions): return false
        if fn_is_async(module.functions[i]): return true
        i = i + 1
    return false

fn emit_mir_function(st: EmitState, f: MIRFunction, module: MIRModule) -> EmitState:
    // Resolve return type
    let mut ret_ty: String = resolve_mir_type(f.return_type)
    if ret_ty.starts_with("%struct."):
        let ret_name: String = f.return_type.name
        if is_enum_type(st, ret_name):
            ret_ty = "%enum." + ret_name

    // v5.5.4 Sh.4 Phase 2 — async fn detection. When true, the
    // emitter wraps the function body in a presplit-coroutine frame:
    // coro.entry prologue + initial suspend + rewrite each ret to
    // store-into-future.payload + br %coro.final + append coro.final
    // / coro.cleanup / coro.ret epilogue. ret_ty stays the ORIGINAL
    // declared type T (used for box allocation in emit_mir_return);
    // abi_ret below becomes "ptr" (the Future<T> handle).
    let is_async: Bool = fn_is_async(f)

    // v5.0.4 Cb.15: use per-target ABI classifier for return sret.
    // Argument passing still uses is_byref_type_st (64B threshold).
    // v5.5.4: async fns never use sret (always return ptr directly).
    let use_sret: Bool = use_sret_return(st, ret_ty) && f.name != "main" && !is_async

    // Build parameter list with byref adjustments
    let mut params_str: String = ""
    let mut param_types: List<String> = []
    // If sret, first param is the return pointer
    if use_sret:
        params_str = "ptr noalias sret(" + ret_ty + ") %__sret__"
    let mut pi: Int = 0
    let nfparams: Int = len(f.params)
    for _ in 0..500:
        if pi < nfparams:
            let p_sig: MIRParam = f.params[pi]
            let pty_sig: String = resolve_mir_type(p_sig.ty)
            param_types.push(pty_sig)
            let need_sep: Bool = pi > 0 || use_sret
            let mut sep: String = ""
            if need_sep: sep = ", "
            if is_byref_type_st(st, pty_sig):
                // Large param: pass by pointer
                params_str = params_str + sep + "ptr %" + p_sig.name + ".byref"
            else:
                params_str = params_str + sep + pty_sig + " %" + p_sig.name
            pi = pi + 1

    // Register function (with original types for caller resolution).
    // v5.5.4 Sh.4 Phase 2: async fns register with ret_type="ptr" so
    // callers emit `call ptr @foo()` — matching the ABI that the
    // coroutine prologue actually returns (a Future<T> handle). The
    // per-instance ret_ty variable stays the original T and is used
    // locally for box allocation inside emit_mir_return.
    // find_function searches backwards, so this entry overrides the
    // forward-declare entry at emit_mir_module.
    let mut reg_ret_ty: String = ret_ty
    if is_async: reg_ret_ty = "ptr"
    let entry: FnEntry = new_fn_entry(f.name, reg_ret_ty, param_types)
    let mut s: EmitState = st
    s.functions.push(entry)

    // Track current function's return type and sret flag
    // main() uses i32 return (C ABI) for clean exit codes.
    // v5.5.4 Sh.4 Phase 2: async fns flag via an "ASYNC_PTR:" prefix
    // so emit_mir_return can branch to the ret-rewrite path while
    // still knowing the inner T for box allocation.
    // v5.5.6 Sh.4 Phase 3: when the module contains async fns, main
    // uses the "i32_async" sentinel so emit_mir_return can prepend
    // `call void @__mn_coro_scheduler_destroy()` before the truncate
    // + ret. Parallel to the ASYNC_PTR: pattern.
    let main_module_has_async: Bool = f.name == "main" && module_has_async(module)
    if f.name == "main":
        if main_module_has_async:
            s.current_ret_type = "i32_async"
        else:
            s.current_ret_type = "i32"
    else if is_async:
        s.current_ret_type = "ASYNC_PTR:" + ret_ty
    else:
        s.current_ret_type = ret_ty

    // v5.4.0 Own.1 Phase 2 — reset per-function ownership tracking.
    // These lists collect local names that currently own String / List /
    // boxed resources and those that have been transferred via Move, and
    // are consulted by emit_drop_glue before every ret.
    let fresh_str_owned: List<String> = []
    let fresh_list_owned: List<String> = []
    let fresh_boxed_owned: List<String> = []
    let fresh_moved_locals: List<String> = []
    let fresh_prelude: List<String> = []
    let fresh_body: List<String> = []
    s.str_owned = fresh_str_owned
    s.list_owned = fresh_list_owned
    s.boxed_owned = fresh_boxed_owned
    s.moved_locals = fresh_moved_locals
    s.entry_prelude_lines = fresh_prelude
    s.entry_block_body = fresh_body
    s.in_entry_block = false
    // v5.4.3 — reset loop depth per function; nested-loop tracking is
    // keyed on block-label prefix inside emit_mir_basic_block.
    s.loop_depth = 0
    // v5.4.4 — reset parallel source arrays alongside owner lists.
    let fresh_str_src: List<String> = []
    let fresh_list_src: List<String> = []
    let fresh_boxed_src: List<String> = []
    s.str_owned_source = fresh_str_src
    s.list_owned_source = fresh_list_src
    s.boxed_owned_source = fresh_boxed_src

    // Emit function header
    let fn_name: String = strip_percent(f.name)
    let is_lambda: Bool = fn_name != f.name
    let visibility: String = if is_lambda { "define internal" } else { "define" }
    let mut abi_ret: String = ret_ty
    if use_sret: abi_ret = "void"
    // main() returns i32 (C ABI) instead of void for clean exit codes
    if fn_name == "main": abi_ret = "i32"
    // v5.5.4 Sh.4 Phase 2 — async fn ABI: return type is always the
    // Future handle (ptr), regardless of declared T.  The actual
    // result is carried inside the Future struct (set in emit_mir_return).
    let mut coro_attr: String = ""
    if is_async:
        abi_ret = "ptr"
        coro_attr = " presplitcoroutine"
    // v4.97.0: nounwind willreturn on all user-defined functions.
    // Mapanare has no exceptions (nounwind) and all functions terminate (willreturn).
    // Matches Python bootstrap at emit_llvm_text.py:2239-2244.
    s = emit_line(s, visibility + " " + abi_ret + " @" + fn_name + "(" + params_str + ") nounwind willreturn" + coro_attr + " {")

    // v5.5.4 Sh.4 Phase 2 — async fn coroutine prologue.
    // Emitted as a synthetic `coro.entry:` block that runs before
    // the user's entry block. It sets up the coroutine frame, the
    // Future struct that will be returned immediately (at initial
    // suspend), and switches into either %pre_entry (normal resume)
    // or %coro.cleanup (caller destroys the coroutine before it
    // completes). pre_entry is a trampoline to the MIR's first basic
    // block; this avoids having to reshuffle parameter stores that
    // the lowerer already placed inside the MIR entry.  Mirrors
    // mapanare/emit_llvm_text.py:2572–2605.
    if is_async:
        s = emit_line(s, "coro.entry:")
        s = emit_line(s, "  %coro.id = call token @llvm.coro.id(i32 0, ptr null, ptr null, ptr null)")
        s = emit_line(s, "  %coro.size = call i64 @llvm.coro.size.i64()")
        s = emit_line(s, "  %coro.mem = call ptr @malloc(i64 %coro.size)")
        s = emit_line(s, "  %coro.hdl = call ptr @llvm.coro.begin(token %coro.id, ptr %coro.mem)")
        s = emit_line(s, "  %future = call ptr @malloc(i64 16)")
        s = emit_line(s, "  store i8 0, ptr %future")
        s = emit_line(s, "  %future.hdl.slot = getelementptr inbounds {i8, ptr}, ptr %future, i32 0, i32 1")
        s = emit_line(s, "  store ptr %coro.hdl, ptr %future.hdl.slot")
        s = emit_line(s, "  %coro.init.save = call token @llvm.coro.save(ptr %coro.hdl)")
        s = emit_line(s, "  %coro.init.susp = call i8 @llvm.coro.suspend(token %coro.init.save, i1 false)")
        s = emit_line(s, "  switch i8 %coro.init.susp, label %coro.ret [")
        s = emit_line(s, "    i8 0, label %pre_entry")
        s = emit_line(s, "    i8 1, label %coro.cleanup")
        s = emit_line(s, "  ]")
        s = emit_line(s, "pre_entry:")
        if len(f.blocks) > 0:
            s = emit_line(s, "  br label %" + f.blocks[0].label)
        else:
            s = emit_line(s, "  br label %coro.final")

    // Emit basic blocks — entry block gets byref param fixup.
    // Extracted from single loop to avoid return-in-for and else-branch bugs.
    let nblks: Int = len(f.blocks)

    // Entry block (index 0): emit byref param loads, then instructions
    if nblks > 0:
        let bb0: BasicBlock = f.blocks[0]
        s = emit_line(s, bb0.label + ":")
        // v5.4.1 — redirect emit_line to entry_block_body for the rest
        // of the function so we can splice the tracking-slot prelude
        // in front of the body. emit_track_string / _boxed / _closure
        // can fire from any block (e.g., a concat in a loop body), so
        // the redirect must remain on through every basic block, not
        // just the entry block. Flushed at function close before '}'.
        s.in_entry_block = true
        // v5.5.6 Sh.4 Phase 3: for async-aware main, emit
        // `call void @__mn_coro_scheduler_init(i32 0)` as the FIRST
        // buffered body line so every subsequent BlockOn sees an
        // initialised scheduler. 0 = auto-detect cores (respects
        // MAPANARE_ASYNC_THREADS env var inside the runtime). Mirrors
        // mapanare/emit_llvm_text.py:2500-2508.
        if main_module_has_async:
            s = emit_line(s, "  call void @__mn_coro_scheduler_init(i32 0)")
        // Emit byref loads: for each byref param, alloca + load from ptr + store
        let mut pi3: Int = 0
        let nfparams3: Int = len(f.params)
        for _ in 0..100:
            if pi3 < nfparams3:
                let p_byref: MIRParam = f.params[pi3]
                let pty_byref: String = resolve_mir_type(p_byref.ty)
                if is_byref_type_st(s, pty_byref):
                    s = emit_line(s, "  %" + p_byref.name + ".addr = alloca " + pty_byref)
                    s = emit_line(s, "  %" + p_byref.name + ".bp = load " + pty_byref + ", ptr %" + p_byref.name + ".byref")
                    s = emit_line(s, "  store " + pty_byref + " %" + p_byref.name + ".bp, ptr %" + p_byref.name + ".addr")
                pi3 = pi3 + 1
        // Build set of byref param names for skip detection
        let mut byref_names: List<String> = []
        let mut pn: Int = 0
        let nfparamsn: Int = len(f.params)
        for _ in 0..100:
            if pn < nfparamsn:
                let pp: MIRParam = f.params[pn]
                let ppty: String = resolve_mir_type(pp.ty)
                if is_byref_type_st(s, ppty):
                    byref_names.push(pp.name)
                pn = pn + 1
        // Emit block instructions, skipping Alloca+Store ONLY for byref params
        let mut ii: Int = 0
        let ninsts: Int = len(bb0.instructions)
        for _ in 0..2000:
            if ii < ninsts:
                let inst: Instruction = bb0.instructions[ii]
                let mut should_skip: Bool = false
                let ik: String = instr_kind(inst)
                if ik == "alloca":
                    should_skip = is_name_in_byref(byref_names, instr_dest(inst).name)
                if ik == "store":
                    should_skip = is_name_in_byref(byref_names, instr_store_ptr(inst).name)
                if !should_skip:
                    s = emit_mir_instruction(s, inst)
                ii = ii + 1

    // Remaining blocks (index 1..nblks-1) — still inside the function-
    // body buffer, so any emit_track_* calls from these blocks land
    // their alloca lines in entry_prelude_lines for the entry-block
    // splice below.
    let mut bi: Int = 1
    for _ in 0..2000:
        if bi < nblks:
            let bb: BasicBlock = f.blocks[bi]
            s = emit_mir_basic_block(s, bb)
            bi = bi + 1

    // v5.4.1 — close function-body buffering. Drain prelude (entry-
    // block allocas) into st.lines, then the body. The result IR has
    // tracking allocas at the top of the entry block followed by all
    // user instructions and trailing blocks, in correct LLVM order.
    if nblks > 0:
        s.in_entry_block = false
        let mut pk2: Int = 0
        let npre2: Int = len(s.entry_prelude_lines)
        // v5.4.4 — bumped prelude flush cap (emit_mir_call's drop glue
        // adds ~50 alloca lines on top of tracking-slot allocas).
        for _ in 0..65536:
            if pk2 >= npre2: break
            s.lines.push(s.entry_prelude_lines[pk2])
            pk2 = pk2 + 1
        let mut bk: Int = 0
        let nbody: Int = len(s.entry_block_body)
        // v5.4.4 — bumped body flush cap from 65536 to 1M to cover
        // functions whose drop glue (structs with multi-ret-ptr
        // extraction) produces >65k body lines — observed at
        // emit_mir_call in stage2.ll with ~66k lines.
        for _ in 0..1000000:
            if bk >= nbody: break
            s.lines.push(s.entry_block_body[bk])
            bk = bk + 1

    // v5.5.4 Sh.4 Phase 2 — async fn coroutine epilogue.
    // Three trailing blocks: coro.final (final suspend — keeps the
    // frame alive so the caller can read the Future's result),
    // coro.cleanup (frees the frame memory), coro.ret (ends the
    // coroutine and returns the Future handle).  All `ret` in the
    // user body were rewritten by emit_mir_return to `br %coro.final`
    // + box-payload store; this trio is their landing pad. Mirrors
    // mapanare/emit_llvm_text.py:2669–2685.
    if is_async:
        s = emit_line(s, "coro.final:")
        s = emit_line(s, "  %coro.final.save = call token @llvm.coro.save(ptr %coro.hdl)")
        s = emit_line(s, "  %coro.final.susp = call i8 @llvm.coro.suspend(token %coro.final.save, i1 true)")
        s = emit_line(s, "  switch i8 %coro.final.susp, label %coro.ret [")
        s = emit_line(s, "    i8 0, label %coro.ret")
        s = emit_line(s, "    i8 1, label %coro.cleanup")
        s = emit_line(s, "  ]")
        s = emit_line(s, "coro.cleanup:")
        // v5.5.7 — destroy-path drop-glue: free String/List/boxed
        // locals tracked in this fn before the frame is freed.
        // No-op for the 5 Sh.4 goldens (their async fns hold no
        // heap-allocated locals) but the correct foundation for
        // future real-I/O async programs that allocate inside the
        // coroutine frame and may be cancelled mid-flight.
        s = emit_drop_glue_destroy(s)
        s = emit_line(s, "  %coro.mem.free = call ptr @llvm.coro.free(token %coro.id, ptr %coro.hdl)")
        s = emit_line(s, "  call void @free(ptr %coro.mem.free)")
        s = emit_line(s, "  br label %coro.ret")
        s = emit_line(s, "coro.ret:")
        s = emit_line(s, "  call i1 @llvm.coro.end(ptr %coro.hdl, i1 false, token none)")
        s = emit_line(s, "  ret ptr %future")

    s = emit_line(s, "}")
    return emit_blank(s)

// ---------------------------------------------------------------------------
// Format constants (printf format strings)
// ---------------------------------------------------------------------------

fn emit_format_constants(st: EmitState) -> EmitState:
    let mut s: EmitState = st
    s = emit_line(s, "@.newline = private constant [2 x i8] c\"\\0A\\00\", align 2")
    s = emit_line(s, "@.fmt_int = private constant [4 x i8] c\"%ld\\00\", align 2")
    s = emit_line(s, "@.fmt_int_nl = private constant [5 x i8] c\"%ld\\0A\\00\", align 2")
    s = emit_line(s, "@.fmt_float = private constant [4 x i8] c\"%lf\\00\", align 2")
    s = emit_line(s, "@.fmt_float_nl = private constant [5 x i8] c\"%lf\\0A\\00\", align 2")
    return emit_blank(s)

// ---------------------------------------------------------------------------
// Public API: emit_mir_module
// ---------------------------------------------------------------------------

fn str_join(sep: String, parts: List<String>) -> String = join(sep, parts)

pub fn emit_mir_module(module: MIRModule, module_name: String) -> String:
    let mut st: EmitState = new_emit_state(module_name)
    // v5.8.4 Wb.2 + v5.8.6 We.1: detect host before any IR is
    // emitted. The (is_windows, win_arch) pair gates a 3-way ABI
    // dispatch in declare_runtime_fn / emit_rt_call / use_sret_return:
    //   is_windows && win_arch == 64 → Win64 sret/sarg
    //   is_windows && win_arch == 32 → i686 cdecl sret/byval
    //   !is_windows                  → SysV / AAPCS64 by-value
    // OS-1 detection mechanism per v5.8.4 PLAN.md, refined in
    // v5.8.6 PLAN.md to disambiguate the 32-bit Windows case.
    let host_win: Int = __mn_host_is_windows()
    let host_bits: Int = __mn_host_arch_bits()
    if host_win != 0:
        st.is_windows = true
        st.win_arch = host_bits

    // Module header
    // v4.127.0: target datalayout + triple match the Python bootstrap defaults
    // from mapanare/targets.py::TARGET_X86_64_LINUX_GNU. LLVM uses the host
    // target if these are absent, but emitting them explicitly aligns the
    // self-hosted output with the bootstrap and removes a per-module diff.
    // v5.8.4 Wb.2 + v5.8.6 We.1: triple AND datalayout are now host-
    // aware (the v5.8.4 release fixed only the triple — datalayout
    // continued to emit the Linux/SysV layout on Windows builds, a
    // latent bug LLVM was forgiving about). Linux/Darwin → SysV;
    // Win64 → mingw x86_64 layout; Win32 → mingw i686 layout
    // (32-bit pointers, m:x mangling, S32 stack alignment).
    st = emit_line(st, "; ModuleID = '" + module_name + "'")
    st = emit_line(st, "source_filename = \"" + module_name + "\"")
    let mut layout_line: String = "target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\""
    let mut triple_line: String = "target triple = \"x86_64-unknown-linux-gnu\""
    if use_win64_abi(st):
        layout_line = "target datalayout = \"e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\""
        triple_line = "target triple = \"x86_64-w64-windows-gnu\""
    if use_i686_abi(st):
        layout_line = "target datalayout = \"e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:32-n8:16:32-a:0:32-S32\""
        triple_line = "target triple = \"i686-w64-windows-gnu\""
    st = emit_line(st, layout_line)
    st = emit_line(st, triple_line)
    st = emit_blank(st)

    // Format string constants
    st = emit_format_constants(st)

    // Runtime declarations
    st = declare_all_runtime(st)

    // Register struct types
    let mut si_idx: Int = 0
    let nmodstructs: Int = len(module.structs)
    for _ in 0..500:
        if si_idx < nmodstructs:
            st = register_mir_struct(st, module.structs[si_idx])
            si_idx = si_idx + 1

    // Register enum types
    let mut ei: Int = 0
    let nmodenums: Int = len(module.enums)
    for _ in 0..500:
        if ei < nmodenums:
            st = register_mir_enum(st, module.enums[ei])
            ei = ei + 1

    if len(module.structs) > 0: st = emit_blank(st)
    if len(module.enums) > 0: st = emit_blank(st)

    // Module-level constants
    let mut ci: Int = 0
    let nconsts: Int = len(module.consts)
    for _ in 0..500:
        if ci < nconsts:
            let mc: ModuleConst = module.consts[ci]
            if mc.is_string:
                let slen: Int = len(mc.str_value)
                let arr_ty: String = "[" + toString(slen) + " x i8]"
                st = emit_line(st, "@" + mc.name + " = private constant " + arr_ty + " c\"" + mc.str_value + "\"")
            else:
                st = emit_line(st, "@" + mc.name + " = private constant i64 " + toString(mc.int_value))
            ci = ci + 1
    if nconsts > 0: st = emit_blank(st)

    // Declare extern functions
    let mut xi: Int = 0
    let nmodexterns: Int = len(module.extern_fns)
    for _ in 0..500:
        if xi < nmodexterns:
            st = declare_mir_extern(st, module.extern_fns[xi])
            xi = xi + 1
    if len(module.extern_fns) > 0: st = emit_blank(st)

    // Forward-declare all functions (for mutual recursion)
    let mut dix: Int = 0
    let nmodfns: Int = len(module.functions)
    for _ in 0..5000:
        if dix < nmodfns:
            let f_decl: MIRFunction = module.functions[dix]
            // v5.5.4 Sh.4 Phase 2 — async fns have ABI return type
            // ptr (Future<T> handle) regardless of declared T. The
            // caller's BlockOn/AwaitSuspend handlers consume the ptr
            // and extract the inner T via GEP + load.
            let mut ret_ty: String = resolve_mir_type(f_decl.return_type)
            if fn_is_async(f_decl):
                ret_ty = "ptr"
            let mut fparams: String = ""
            let mut fpi: Int = 0
            let nfwdparams: Int = len(f_decl.params)
            for _ in 0..500:
                if fpi < nfwdparams:
                    let fp: MIRParam = f_decl.params[fpi]
                    let fpty: String = resolve_mir_type(fp.ty)
                    if fpi > 0:
                        fparams = fparams + ", " + fpty
                    else:
                        fparams = fpty
                    fpi = fpi + 1
            let mut fn_types: List<String> = []
            let mut fti: Int = 0
            for _ in 0..500:
                if fti < nfwdparams:
                    fn_types.push(resolve_mir_type(f_decl.params[fti].ty))
                    fti = fti + 1
            let fe: FnEntry = new_fn_entry(f_decl.name, ret_ty, fn_types)
            st.functions.push(fe)
            dix = dix + 1

    // Emit function bodies
    for fi in 0..len(module.functions):
        let f_emit: MIRFunction = module.functions[fi]
        if len(f_emit.blocks) > 0:
            st = emit_mir_function(st, f_emit, module)

    // Append string globals
    let mut gi: Int = 0
    let nstrglobals: Int = len(st.str_globals)
    for _ in 0..1000000:
        if gi < nstrglobals:
            st = emit_line(st, st.str_globals[gi])
            gi = gi + 1
    // v4.127.0: removed the TBAA tree (nodes !1–!9). It was declared but
    // never attached to any load/store via `!tbaa !N`, confirmed 100% dead
    // code by v4.109.0 forensics on the Python bootstrap. The Python
    // emitter removed it in v4.123.0 (mapanare/emit_llvm_text.py:923-933);
    // self-hosted now matches.
    //
    // v5.9.0 DX.2: replaces the __MN_VERSION__ source-tree placeholder
    // (v4.139.0 Dr.1) with a runtime call to ``__mn_version_string()``.
    // The compiler reads its own baked-in version (from MAPANARE_VERSION
    // at C-runtime compile time) and embeds it into the metadata node of
    // every program it emits. Closes the strict-fixed-point near miss
    // that has carried the VERSION-only diff since v4.140.0 — stage2 and
    // stage3 now embed identical strings because both compilers share the
    // same baked-in version.
    let mnc_version: String = __mn_version_string()
    st = emit_blank(st)
    st = emit_line(st, "!mapanare.version = !{!0}")
    st = emit_line(st, "!0 = !{!\"" + mnc_version + "\"}")

    // Join all lines into a single string
    return join("\n", st.lines)
