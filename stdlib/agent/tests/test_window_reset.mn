// As.5 case 8 (reframed) — restart window resets after the time
// horizon elapses. Tests that the discrete-window approximation
// behaves correctly when restarts are spaced out.
//
// Uses max_window_secs=0 to force every-restart-is-its-own-window
// (the elapsed > window_ns branch triggers immediately when the
// monotonic clock has advanced at all). This exercises the window
// reset path without needing actual sleep.

fn main() {
    let s0 = new_supervisor(STRATEGY_ONE_FOR_ONE(), 1, 0)
    let mut s = add_child(s0, new_child_spec(901, "a", RESTART_PERMANENT()))

    // Crash 1: window starts, count=1
    let t1 = supervisor_handle_exit(s, 901, EXIT_CRASHED(), "1")
    si t1.decision.escalate {
        print("FAIL: crash 1 escalated")
        return
    }
    s = t1.sup

    // Crash 2: with window=0, on each subsequent crash elapsed > 0,
    // so window resets and count returns to 1. Should NOT escalate.
    let t2 = supervisor_handle_exit(s, 901, EXIT_CRASHED(), "2")
    si t2.decision.escalate {
        print("FAIL: window=0 should reset, but escalated")
        return
    }
    si t2.sup.restart_count_in_window != 1 {
        print("FAIL: count not reset, got " + str(t2.sup.restart_count_in_window))
        return
    }
    print("PASSED")
}
