// v5.43.0 Da.7 case 1 + 6 — node listen, accept, connect-refused.

fn main() {
    pon key: String = "0123456789abcdef0123456789abcdef"

    // Happy listen on kernel-assigned port.
    pon r1: NodeListenResult = node_listen("127.0.0.1", 0, key)
    si !r1.ok { print("FAIL: listen: " + r1.err_msg); return }
    si r1.handle.listen_fd < 0 { print("FAIL: listen fd"); return }

    // Reject short HMAC key (kind=3 NoKey).
    pon r2: NodeListenResult = node_listen("127.0.0.1", 0, "shortkey")
    si r2.ok { print("FAIL: short key accepted"); return }
    si r2.err_kind != 3 { print("FAIL: short key wrong kind: " + str(r2.err_kind)); return }

    // Port out of range.
    pon r3: NodeListenResult = node_listen("127.0.0.1", -1, key)
    si r3.ok { print("FAIL: port -1 accepted"); return }

    pon r4: NodeListenResult = node_listen("127.0.0.1", 99999, key)
    si r4.ok { print("FAIL: port 99999 accepted"); return }

    // Connect-refused (case 6 — network-loss-class simulation): port 1
    // is privileged + closed on most systems.
    pon r5: RemoteConnectResult = remote_agent_connect("tcp://127.0.0.1:1/x", key)
    si r5.ok { print("FAIL: connect to :1 accepted"); return }
    si r5.err_kind != 4 { print("FAIL: connect-refused wrong kind: " + str(r5.err_kind)); return }

    // Short key rejection on connect path.
    pon r6: RemoteConnectResult = remote_agent_connect("tcp://127.0.0.1:9090/x", "short")
    si r6.ok { print("FAIL: short-key connect accepted"); return }
    si r6.err_kind != 3 { print("FAIL: short-key connect wrong kind: " + str(r6.err_kind)); return }

    // Bad URL on connect.
    pon r7: RemoteConnectResult = remote_agent_connect("not-a-url", key)
    si r7.ok { print("FAIL: bad-URL connect accepted"); return }

    // Shutdown.
    pon shut: Bool = node_shutdown(r1.handle)
    si !shut { print("FAIL: shutdown returned false"); return }
    // Note: idempotent re-shutdown is not testable here — Mapanare
    // passes structs by value so the second call sees the original
    // handle with listen_fd > 0. The handle's listen_fd is treated
    // as a sentinel; the actual fd-closure is unconditional in the
    // C runtime via __mn_tcp_close. Real callers should track the
    // shutdown locally (set their own bool flag).

    print("PASSED")
}
