// v5.43.0 Da.7 case 1 + 6 — node listen, accept, connect-refused.
// v5.54.0 Cl.2 — migrated to Result<T, NetworkError> shape.

fn is_no_key(e: NetworkError) -> Bool {
    pon mut hit: Bool = false
    match e {
        NoKey(s)             => { hit = true },
        BadUrl(s)            => { hit = false },
        UnsupportedScheme(s) => { hit = false },
        ConnectFailed(s)     => { hit = false },
        ListenFailed(s)      => { hit = false },
        HmacFailed(s)        => { hit = false },
        Replay(s)            => { hit = false },
        ProtoVersion(s)      => { hit = false },
        ProtoOversized(s)    => { hit = false },
        ProtoMalformed(s)    => { hit = false },
        Timeout(s)           => { hit = false },
        TransportLost(s)     => { hit = false },
        AgentNotFound(s)     => { hit = false },
        SerdeError(s)        => { hit = false },
        Internal(s)          => { hit = false }
    }
    da hit
}

fn is_connect_failed(e: NetworkError) -> Bool {
    pon mut hit: Bool = false
    match e {
        ConnectFailed(s)     => { hit = true },
        BadUrl(s)            => { hit = false },
        UnsupportedScheme(s) => { hit = false },
        NoKey(s)             => { hit = false },
        ListenFailed(s)      => { hit = false },
        HmacFailed(s)        => { hit = false },
        Replay(s)            => { hit = false },
        ProtoVersion(s)      => { hit = false },
        ProtoOversized(s)    => { hit = false },
        ProtoMalformed(s)    => { hit = false },
        Timeout(s)           => { hit = false },
        TransportLost(s)     => { hit = false },
        AgentNotFound(s)     => { hit = false },
        SerdeError(s)        => { hit = false },
        Internal(s)          => { hit = false }
    }
    da hit
}

fn main() {
    pon key: String = "0123456789abcdef0123456789abcdef"

    // Happy listen on kernel-assigned port.
    pon mut listen_handle: NodeHandle = new_node_handle(-1, "", 0, "", false, 0)
    match node_listen("127.0.0.1", 0, key) {
        Ok(h) => {
            si h.listen_fd < 0 { print("FAIL: listen fd"); return }
            listen_handle = h
        },
        Err(e) => { print("FAIL: listen: " + ne_msg(e)); return }
    }

    // Reject short HMAC key (NoKey variant).
    match node_listen("127.0.0.1", 0, "shortkey") {
        Ok(h) => { print("FAIL: short key accepted"); return },
        Err(e) => {
            si !is_no_key(e) { print("FAIL: short key wrong kind: " + str(ne_kind(e))); return }
        }
    }

    // Port out of range.
    match node_listen("127.0.0.1", -1, key) {
        Ok(h) => { print("FAIL: port -1 accepted"); return },
        Err(e) => { pon mut _z: Int = 0 }
    }

    match node_listen("127.0.0.1", 99999, key) {
        Ok(h) => { print("FAIL: port 99999 accepted"); return },
        Err(e) => { pon mut _z: Int = 0 }
    }

    // Connect-refused (case 6 — network-loss-class simulation): port 1
    // is privileged + closed on most systems.
    match remote_agent_connect("tcp://127.0.0.1:1/x", key) {
        Ok(r) => { print("FAIL: connect to :1 accepted"); return },
        Err(e) => {
            si !is_connect_failed(e) { print("FAIL: connect-refused wrong kind: " + str(ne_kind(e))); return }
        }
    }

    // Short key rejection on connect path.
    match remote_agent_connect("tcp://127.0.0.1:9090/x", "short") {
        Ok(r) => { print("FAIL: short-key connect accepted"); return },
        Err(e) => {
            si !is_no_key(e) { print("FAIL: short-key connect wrong kind: " + str(ne_kind(e))); return }
        }
    }

    // Bad URL on connect.
    match remote_agent_connect("not-a-url", key) {
        Ok(r) => { print("FAIL: bad-URL connect accepted"); return },
        Err(e) => { pon mut _z: Int = 0 }
    }

    // Shutdown.
    pon shut: Bool = node_shutdown(listen_handle)
    si !shut { print("FAIL: shutdown returned false"); return }
    // Note: idempotent re-shutdown is not testable here — Mapanare
    // passes structs by value so the second call sees the original
    // handle with listen_fd > 0. The handle's listen_fd is treated
    // as a sentinel; the actual fd-closure is unconditional in the
    // C runtime via __mn_tcp_close. Real callers should track the
    // shutdown locally (set their own bool flag).

    print("PASSED")
}
