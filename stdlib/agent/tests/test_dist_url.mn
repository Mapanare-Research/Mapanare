// v5.43.0 Da.7 — URL parsing surface.

fn main() {
    // Happy paths.
    pon r1: UrlParseResult = parse_agent_url("tcp://127.0.0.1:9090/worker-1")
    si !r1.ok { print("FAIL: tcp URL: " + r1.err_msg); return }
    si r1.url.scheme != "tcp" || r1.url.host != "127.0.0.1" || r1.url.port != 9090 || r1.url.agent_id != "worker-1" {
        print("FAIL: tcp URL fields"); return
    }

    pon r2: UrlParseResult = parse_agent_url("tls://example.com:443/api")
    si !r2.ok { print("FAIL: tls URL: " + r2.err_msg); return }
    si !url_is_tls(r2.url) { print("FAIL: url_is_tls"); return }
    si r2.url.port != 443 { print("FAIL: tls port"); return }

    // unix:// rejected with kind=2 (UnsupportedScheme).
    pon r3: UrlParseResult = parse_agent_url("unix:///tmp/sock/a")
    si r3.ok { print("FAIL: unix accepted"); return }
    si r3.err_kind != 2 { print("FAIL: unix wrong kind: " + str(r3.err_kind)); return }

    // Bad shapes.
    pon r4: UrlParseResult = parse_agent_url("nothttp")
    si r4.ok { print("FAIL: bare URL"); return }

    pon r5: UrlParseResult = parse_agent_url("tcp://host:abc/x")
    si r5.ok { print("FAIL: non-numeric port"); return }

    pon r6: UrlParseResult = parse_agent_url("tcp://host:99999/x")
    si r6.ok { print("FAIL: port out of range"); return }

    pon r7: UrlParseResult = parse_agent_url("tcp://host:0/x")
    si r7.ok { print("FAIL: port 0"); return }

    pon r8: UrlParseResult = parse_agent_url("tcp://host:8080/")
    si r8.ok { print("FAIL: empty agent-id"); return }

    pon r9: UrlParseResult = parse_agent_url("")
    si r9.ok { print("FAIL: empty URL"); return }

    pon r10: UrlParseResult = parse_agent_url("http://host:8080/x")
    si r10.ok { print("FAIL: http scheme"); return }
    si r10.err_kind != 2 { print("FAIL: http wrong kind: " + str(r10.err_kind)); return }

    print("PASSED")
}
