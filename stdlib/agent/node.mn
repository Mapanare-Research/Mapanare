// node.mn — Node listener + per-connection state for distributed agents v0
//
// v5.43.0 Da.3 — third manifesto-arc release.
//
// SHAPE: synchronous listener API. The user runs the accept loop
// explicitly via node_accept_one + own loop control. Async / dedicated
// "node agent" wiring is a v5.43.x ergonomic upgrade — would require
// reliable fn-typed parameters in the agent runtime (the v5.42.0
// As.* lesson). For v5.43.0 v0, synchronous accept-then-handle is
// the right scope.
//
// Wire format: every read pulls one length-prefixed Frame body via
// __mn_node_read_frame_str (handled in C, capped at 100 MB), then
// decode_frame validates HMAC + sequence in pure Mapanare.
//
// Depends on (in concat order):
//   - url.mn (NetworkError variants, parse_agent_url)
//   - remote_proto.mn (Frame, encode_frame, decode_frame, validate_key)
//
// LANGUAGE QUIRK NOTES:
//   - Single-line struct literals only (`new T { f: v, ... }`).
//   - extern declarations: ONE owning module per symbol. node.mn owns
//     the C-runtime extern declarations for __mn_node_*; remote_proto.mn
//     owns the crypto + chr externs; url.mn owns nothing C-side. Adding
//     remote.mn (Phase 3 second module) adds no new externs — it
//     reuses node.mn's.

// ---------------------------------------------------------------------------
// C runtime externs
// ---------------------------------------------------------------------------

extern "C" fn __mn_node_listen_str(host: String, port: Int, backlog: Int) -> Int
extern "C" fn __mn_node_accept(listen_fd: Int, is_tls: Int, server_ctx: Int) -> Int
extern "C" fn __mn_node_connect_str(host: String, port: Int, is_tls: Int, sni: String) -> Int
extern "C" fn __mn_node_write_str(conn: Int, body: String) -> Int
extern "C" fn __mn_node_read_frame_str(conn: Int) -> String
extern "C" fn __mn_node_close(conn: Int)
extern "C" fn __mn_node_get_fd(conn: Int) -> Int
extern "C" fn __mn_tls_server_ctx_new_str(cert: String, key: String) -> Int
extern "C" fn __mn_tls_server_ctx_free_handle(ctx: Int)

// ---------------------------------------------------------------------------
// NodeHandle — opaque listener state.
//   listen_fd:      kernel socket fd >= 0; -1 after node_shutdown.
//   bind_addr:      what was passed to node_listen (informational).
//   bind_port:      same.
//   key:            HMAC key, validated to be >= 32 raw bytes.
//   is_tls:         true iff this is a TLS listener (server_ctx != 0).
//   server_ctx:     pointer to MnTlsServerCtx as i64; 0 for plaintext.
// ---------------------------------------------------------------------------

pub tipo NodeHandle {
    listen_fd: Int,
    bind_addr: String,
    bind_port: Int,
    key: String,
    is_tls: Bool,
    server_ctx: Int
}

fn new_node_handle(fd: Int, addr: String, port: Int, key: String, is_tls: Bool, ctx: Int) -> NodeHandle {
    da new NodeHandle { listen_fd: fd, bind_addr: addr, bind_port: port, key: key, is_tls: is_tls, server_ctx: ctx }
}

// ---------------------------------------------------------------------------
// v5.43.0 Da.* lowerer-bug workaround — flat result structs.
//
// Originally I wanted Result<NodeHandle, NetworkError> at every boundary
// (PROMPT-spec). At v5.43.0 HEAD the Mapanare lowerer has three known
// bugs in this combination:
//
//   1. Result-wrap-shape mismatch when Ok is a non-trivial struct
//      (v5.36.0 Js.0.B class). Variant tag of Err corrupts to first
//      variant index.
//   2. Variant-tag corruption on `Err(<expr-of-enum-type>)` rewrap
//      where the expression is a struct field access or match-bound
//      name. Same root cause; tag becomes 0.
//   3. Nested match `match Err(e) { ... match e { N-arm } }` silently
//      fails to fire any inner arm when the enum has 15+ variants.
//
// The clean fix lives in the lowerer (v5.43.x candidate). For the
// v5.43.0 first cut, every public function that returns a struct on
// success uses a flat `(ok: Bool, ..., err_kind: Int, err_msg: String)`
// shape. Less elegant than Result<T, E> but sidesteps all three bugs.
//
// err_kind values: see ne_kind in url.mn (1=BadUrl ... 15=Internal).
//
// node_listen — bind a plaintext (tcp://) listener.
// node_listen_tls — bind a tls:// listener with server cert + private key.
//
// Per v5.43.0 Da.4 invariant, hosts are resolved via __mn_tcp_listen.
// Pass "127.0.0.1" or "0.0.0.0" or empty for INADDR_ANY.
// ---------------------------------------------------------------------------

pub tipo NodeListenResult {
    ok: Bool,
    handle: NodeHandle,
    err_kind: Int,
    err_msg: String
}

fn listen_ok(h: NodeHandle) -> NodeListenResult {
    da new NodeListenResult { ok: true, handle: h, err_kind: 0, err_msg: "" }
}

fn listen_err(kind: Int, msg: String) -> NodeListenResult {
    pon empty: NodeHandle = new_node_handle(-1, "", 0, "", false, 0)
    da new NodeListenResult { ok: false, handle: empty, err_kind: kind, err_msg: msg }
}

pub fn node_listen(addr: String, port: Int, key: String) -> NodeListenResult {
    si len(key) < 32 {
        da listen_err(3, "MAPANARE_NODE_KEY must be at least 32 raw bytes (got " + str(len(key)) + ")")
    }
    si port < 0 || port > 65535 {
        da listen_err(5, "port out of range 0..65535: " + str(port))
    }
    pon fd: Int = __mn_node_listen_str(addr, port, 32)
    si fd < 0 {
        da listen_err(5, "__mn_node_listen_str failed for " + addr + ":" + str(port))
    }
    da listen_ok(new_node_handle(fd, addr, port, key, false, 0))
}

pub fn node_listen_tls(addr: String, port: Int, key: String, cert_path: String, key_path: String) -> NodeListenResult {
    si len(key) < 32 {
        da listen_err(3, "MAPANARE_NODE_KEY must be at least 32 raw bytes (got " + str(len(key)) + ")")
    }
    si port < 0 || port > 65535 {
        da listen_err(5, "port out of range 0..65535: " + str(port))
    }
    pon ctx: Int = __mn_tls_server_ctx_new_str(cert_path, key_path)
    si ctx == 0 {
        da listen_err(5, "TLS server context init failed (cert=" + cert_path + ", key=" + key_path + ")")
    }
    pon fd: Int = __mn_node_listen_str(addr, port, 32)
    si fd < 0 {
        __mn_tls_server_ctx_free_handle(ctx)
        da listen_err(5, "__mn_node_listen_str failed for tls://" + addr + ":" + str(port))
    }
    da listen_ok(new_node_handle(fd, addr, port, key, true, ctx))
}

// ---------------------------------------------------------------------------
// NodeConnection — opaque per-connection state.
//   conn:            mn_node_conn_t * cast to i64 (from C runtime).
//   key:             HMAC key, copied from NodeHandle at accept time.
//   last_seen_recv:  watermark for replay rejection; starts at 0.
//   next_seq_send:   monotonic counter; starts at 1.
// ---------------------------------------------------------------------------

pub tipo NodeConnection {
    conn: Int,
    key: String,
    last_seen_recv: Int,
    next_seq_send: Int
}

fn new_connection(conn_handle: Int, key: String) -> NodeConnection {
    da new NodeConnection { conn: conn_handle, key: key, last_seen_recv: 0, next_seq_send: 1 }
}

// ---------------------------------------------------------------------------
// node_accept_one — block until one client connects, then perform the
// TLS handshake (if applicable). Synchronous; user runs the loop.
// Returns NodeAcceptResult { ok, conn, err_kind, err_msg }.
// ---------------------------------------------------------------------------

pub tipo NodeAcceptResult {
    ok: Bool,
    conn: NodeConnection,
    err_kind: Int,
    err_msg: String
}

fn accept_ok(c: NodeConnection) -> NodeAcceptResult {
    da new NodeAcceptResult { ok: true, conn: c, err_kind: 0, err_msg: "" }
}

fn accept_err(kind: Int, msg: String) -> NodeAcceptResult {
    pon empty: NodeConnection = new NodeConnection { conn: 0, key: "", last_seen_recv: 0, next_seq_send: 1 }
    da new NodeAcceptResult { ok: false, conn: empty, err_kind: kind, err_msg: msg }
}

pub fn node_accept_one(n: NodeHandle) -> NodeAcceptResult {
    si n.listen_fd < 0 {
        da accept_err(5, "node already shut down")
    }
    pon mut is_tls_int: Int = 0
    si n.is_tls { is_tls_int = 1 }
    pon conn_handle: Int = __mn_node_accept(n.listen_fd, is_tls_int, n.server_ctx)
    si conn_handle == 0 {
        da accept_err(4, "accept or TLS handshake failed")
    }
    da accept_ok(new_connection(conn_handle, n.key))
}

// ---------------------------------------------------------------------------
// node_shutdown — close the listening fd + free the TLS server ctx.
// Idempotent. Returns false if already shut down.
// ---------------------------------------------------------------------------

pub fn node_shutdown(n: NodeHandle) -> Bool {
    si n.listen_fd < 0 {
        da false
    }
    si n.server_ctx != 0 {
        __mn_tls_server_ctx_free_handle(n.server_ctx)
    }
    // The listening socket is just an int64_t fd; close directly via
    // the existing TCP close runtime entry. node.c does not own
    // listening-socket lifecycle (it only manages mn_node_conn_t for
    // accepted connections).
    __mn_tcp_close(n.listen_fd)
    da true
}

extern "C" fn __mn_tcp_close(fd: Int)

// ---------------------------------------------------------------------------
// conn_send_frame — encode + write one frame. Updates next_seq_send.
// Returns the updated NodeConnection on success.
// ---------------------------------------------------------------------------

pub tipo ConnSendResult {
    ok: Bool,
    conn: NodeConnection,
    err_kind: Int,
    err_msg: String
}

fn send_ok(c: NodeConnection) -> ConnSendResult {
    da new ConnSendResult { ok: true, conn: c, err_kind: 0, err_msg: "" }
}

fn send_err(c: NodeConnection, kind: Int, msg: String) -> ConnSendResult {
    da new ConnSendResult { ok: false, conn: c, err_kind: kind, err_msg: msg }
}

pub fn conn_send_frame(c: NodeConnection, msg_type: Int, payload: String) -> ConnSendResult {
    pon f: Frame = new_frame(msg_type, c.next_seq_send, payload)
    pon body: String = encode_frame(f, c.key)
    pon rc: Int = __mn_node_write_str(c.conn, body)
    si rc == -2 {
        da send_err(c, 9, "frame body exceeds 100 MB cap")
    }
    si rc != 0 {
        da send_err(c, 12, "__mn_node_write_str failed (rc=" + str(rc) + ")")
    }
    pon updated: NodeConnection = new NodeConnection { conn: c.conn, key: c.key, last_seen_recv: c.last_seen_recv, next_seq_send: c.next_seq_send + 1 }
    da send_ok(updated)
}

// ---------------------------------------------------------------------------
// conn_recv_frame — read one frame, verify HMAC, replay-check, update
// last_seen. Returns ConnRecvResult with flat ok/err shape (per the
// v5.43.0 Da.* lowerer-bug workaround).
// ---------------------------------------------------------------------------

pub tipo ConnRecvResult {
    ok: Bool,
    conn: NodeConnection,
    frame: Frame,
    err_kind: Int,
    err_msg: String
}

fn recv_ok(c: NodeConnection, f: Frame) -> ConnRecvResult {
    da new ConnRecvResult { ok: true, conn: c, frame: f, err_kind: 0, err_msg: "" }
}

fn recv_err(c: NodeConnection, kind: Int, msg: String) -> ConnRecvResult {
    pon empty: Frame = new_frame(0, 0, "")
    da new ConnRecvResult { ok: false, conn: c, frame: empty, err_kind: kind, err_msg: msg }
}

pub fn conn_recv_frame(c: NodeConnection) -> ConnRecvResult {
    pon body: String = __mn_node_read_frame_str(c.conn)
    si len(body) == 0 {
        da recv_err(c, 12, "__mn_node_read_frame_str returned empty (peer close or error)")
    }
    pon dr: DecodeResult = decode_frame(body, c.key, c.last_seen_recv)
    si !dr.ok {
        // Reclassify dr.err into our flat (kind, msg) shape. dr.err is
        // a NetworkError; pass through fn-arg extraction (works) to
        // get the original message + variant kind via ne_kind.
        pon kind: Int = ne_kind(dr.err)
        pon msg: String = ne_msg(dr.err)
        da recv_err(c, kind, msg)
    }
    pon updated: NodeConnection = new NodeConnection { conn: c.conn, key: c.key, last_seen_recv: dr.frame.sequence, next_seq_send: c.next_seq_send }
    da recv_ok(updated, dr.frame)
}

// Helper: extract the message String from a NetworkError variant.
// Single match on parameter — works (v5.x lowerer is fine here).
pub fn ne_msg(e: NetworkError) -> String {
    pon mut out: String = ""
    match e {
        BadUrl(s) => { out = s },
        UnsupportedScheme(s) => { out = s },
        NoKey(s) => { out = s },
        ConnectFailed(s) => { out = s },
        ListenFailed(s) => { out = s },
        HmacFailed(s) => { out = s },
        Replay(s) => { out = s },
        ProtoVersion(s) => { out = s },
        ProtoOversized(s) => { out = s },
        ProtoMalformed(s) => { out = s },
        Timeout(s) => { out = s },
        TransportLost(s) => { out = s },
        AgentNotFound(s) => { out = s },
        SerdeError(s) => { out = s },
        Internal(s) => { out = s }
    }
    da out
}

// Helper: classify a NetworkError into an int kind 1..15. Same shape
// as the test-side ne_kind in phase3 smoke; defined here too so
// callers don't need to redefine it. Single match on parameter.
pub fn ne_kind(e: NetworkError) -> Int {
    pon mut k: Int = 0
    match e {
        BadUrl(s) => { k = 1 },
        UnsupportedScheme(s) => { k = 2 },
        NoKey(s) => { k = 3 },
        ConnectFailed(s) => { k = 4 },
        ListenFailed(s) => { k = 5 },
        HmacFailed(s) => { k = 6 },
        Replay(s) => { k = 7 },
        ProtoVersion(s) => { k = 8 },
        ProtoOversized(s) => { k = 9 },
        ProtoMalformed(s) => { k = 10 },
        Timeout(s) => { k = 11 },
        TransportLost(s) => { k = 12 },
        AgentNotFound(s) => { k = 13 },
        SerdeError(s) => { k = 14 },
        Internal(s) => { k = 15 }
    }
    da k
}

// ---------------------------------------------------------------------------
// conn_close — terminate one connection. Always succeeds.
// ---------------------------------------------------------------------------

pub fn conn_close(c: NodeConnection) -> Bool {
    __mn_node_close(c.conn)
    da true
}
