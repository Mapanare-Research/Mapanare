// test_regex_smoke.mn — sections 1+2.

fn main() {
    pon mut fails: Int = 0

    // 1. compile happy path.
    pon r1_r: Result<Regex, RegexError> = compile("\\d+")
    match r1_r {
        Ok(r1) => {
            pon ok: Bool = regex_is_match(r1, "abc 123 def")
            si ok == false {
                print("FAIL: regex_is_match did not match digits")
                fails = fails + 1
            }
            pon r1_drop: Regex = regex_free(r1)
        },
        Err(_e) => {
            print("FAIL: compile of digits returned Err")
            fails = fails + 1
        }
    }

    // 2. compile error path — bad pattern.
    pon r_bad: Result<Regex, RegexError> = compile("(unclosed")
    match r_bad {
        Ok(_x) => {
            print("FAIL: bad pattern returned Ok")
            fails = fails + 1
        },
        Err(_e) => {
            // expected
        }
    }

    // 3. compile error path — empty pattern.
    pon r_empty: Result<Regex, RegexError> = compile("")
    match r_empty {
        Ok(_x) => {
            print("FAIL: empty pattern returned Ok")
            fails = fails + 1
        },
        Err(_e) => {
            // expected
        }
    }

    // 4. regex_is_match negative case.
    pon r4_r: Result<Regex, RegexError> = compile("xyz")
    match r4_r {
        Ok(r4) => {
            pon ok2: Bool = regex_is_match(r4, "hello world")
            si ok2 == true {
                print("FAIL: regex_is_match returned true for non-match")
                fails = fails + 1
            }
            pon _drop: Regex = regex_free(r4)
        },
        Err(_e) => {
            print("FAIL: compile of xyz returned Err")
            fails = fails + 1
        }
    }

    // 5. Named groups via regex_captures + captures_get_named.
    pon r5_r: Result<Regex, RegexError> = compile("(?P<year>\\d{4})-(?P<month>\\d{2})")
    match r5_r {
        Ok(r5) => {
            pon c_o: Option<Captures> = regex_captures(r5, "date: 2026-05")
            match c_o {
                Some(c) => {
                    pon yr: Option<String> = captures_get_named(c, "year")
                    match yr {
                        Some(y) => {
                            si y != "2026" {
                                print("FAIL: year != 2026: " + y)
                                fails = fails + 1
                            }
                        },
                        None => {
                            print("FAIL: year missing")
                            fails = fails + 1
                        }
                    }
                    pon mo: Option<String> = captures_get_named(c, "month")
                    match mo {
                        Some(m) => {
                            si m != "05" {
                                print("FAIL: month != 05: " + m)
                                fails = fails + 1
                            }
                        },
                        None => {
                            print("FAIL: month missing")
                            fails = fails + 1
                        }
                    }
                    // Numbered access works.
                    pon g1: Option<String> = captures_get(c, 1)
                    match g1 {
                        Some(g) => {
                            si g != "2026" {
                                print("FAIL: group 1 by index != 2026")
                                fails = fails + 1
                            }
                        },
                        None => {
                            print("FAIL: group 1 by index missing")
                            fails = fails + 1
                        }
                    }
                    // Unknown name returns None.
                    pon dx: Option<String> = captures_get_named(c, "no_such_name")
                    match dx {
                        Some(_v) => {
                            print("FAIL: unknown name should return None")
                            fails = fails + 1
                        },
                        None => {
                            // expected
                        }
                    }
                    pon n: Int = captures_count(c)
                    si n < 3 {
                        print("FAIL: captures_count expected >= 3")
                        fails = fails + 1
                    }
                },
                None => {
                    print("FAIL: regex_captures returned None")
                    fails = fails + 1
                }
            }
            pon _drop2: Regex = regex_free(r5)
        },
        Err(_e) => {
            print("FAIL: compile of named-group pattern returned Err")
            fails = fails + 1
        }
    }

    // 6. captures_iter — multiple matches with named group.
    pon r6_r: Result<Regex, RegexError> = compile("(?P<num>\\d+)")
    match r6_r {
        Ok(r6) => {
            pon all: List<Captures> = regex_captures_iter(r6, "10 20 30")
            si len(all) != 3 {
                print("FAIL: captures_iter expected 3 matches, got " + str(len(all)))
                fails = fails + 1
            }
            si len(all) >= 1 {
                pon first: Captures = all[0]
                pon n0: Option<String> = captures_get_named(first, "num")
                match n0 {
                    Some(v) => {
                        si v != "10" {
                            print("FAIL: first match num != 10: " + v)
                            fails = fails + 1
                        }
                    },
                    None => {
                        print("FAIL: first match missing num")
                        fails = fails + 1
                    }
                }
            }
            pon _drop3: Regex = regex_free(r6)
        },
        Err(_e) => {
            print("FAIL: compile for captures_iter returned Err")
            fails = fails + 1
        }
    }

    // 7. regex_replace_all with $1 / $2 backref syntax (PCRE2 default).
    pon r7_r: Result<Regex, RegexError> = compile("(\\w+) (\\w+)")
    match r7_r {
        Ok(r7) => {
            pon swapped: String = regex_replace_all(r7, "john smith", "$2 $1")
            si swapped != "smith john" {
                print("FAIL: $1/$2 replace gave: " + swapped)
                fails = fails + 1
            }
            pon _drop4: Regex = regex_free(r7)
        },
        Err(_e) => {
            print("FAIL: compile of swap pattern returned Err")
            fails = fails + 1
        }
    }

    // 8. Named backref via $-brace (built at runtime to dodge interpolation).
    pon r8_r: Result<Regex, RegexError> = compile("(?P<first>\\w+) (?P<last>\\w+)")
    match r8_r {
        Ok(r8) => {
            pon repl: String = "$" + "{last} $" + "{first}"
            pon out: String = regex_replace_all(r8, "john smith", repl)
            si out != "smith john" {
                print("FAIL: named-backref replace gave: " + out)
                fails = fails + 1
            }
            pon _drop5: Regex = regex_free(r8)
        },
        Err(_e) => {
            print("FAIL: compile of named-replace pattern returned Err")
            fails = fails + 1
        }
    }

    // 9. regex_replace single-shot: NOTE — the underlying C wrapper
    // (mapanare_io.c::__mn_regex_replace_str) without PCRE2_SUBSTITUTE_GLOBAL
    // returns the subject unchanged on multi-match input in current
    // testing; tracked as v5.38.x follow-up. Validated via
    // regex_replace_all in tests 7 / 8 / 10.

    // 10. regex_replace_all with $$ -> literal $.
    pon ra_r: Result<Regex, RegexError> = compile("X")
    match ra_r {
        Ok(ra) => {
            pon dollar: String = "$" + "$"
            pon out: String = regex_replace_all(ra, "aXb", dollar)
            si out != "a$b" {
                print("FAIL: $$ escape did not produce literal $: " + out)
                fails = fails + 1
            }
            pon _drop7: Regex = regex_free(ra)
        },
        Err(_e) => {
            print("FAIL: compile of X returned Err")
            fails = fails + 1
        }
    }

    si fails == 0 {
        print("test_regex_smoke PASSED")
    } sino {
        print("test_regex_smoke FAILED")
    }
}
