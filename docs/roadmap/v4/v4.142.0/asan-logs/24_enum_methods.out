%enum.Color = type {i64, ptr}

define {ptr, i64} @color_name(%enum.Color %c) nounwind willreturn {
entry:
  %c.addr = alloca %enum.Color
  store %enum.Color %c, ptr %c.addr
  %c_val0 = load %enum.Color, ptr %c.addr
  %tag1 = extractvalue %enum.Color %c_val0, 0
  switch i64 %tag1, label %match_merge0 [
    i64 0, label %match_arm1
    i64 1, label %match_arm2
    i64 2, label %match_arm3
  ]
match_arm1:
  %t2.ptr = getelementptr inbounds [3 x i8], ptr @str.0, i64 0, i64 0
  %t2.s1 = insertvalue {ptr, i64} undef, ptr %t2.ptr, 0
  %t2 = insertvalue {ptr, i64} %t2.s1, i64 3, 1
  ret {ptr, i64} %t2
match_arm2:
  %t3.ptr = getelementptr inbounds [5 x i8], ptr @str.1, i64 0, i64 0
  %t3.s1 = insertvalue {ptr, i64} undef, ptr %t3.ptr, 0
  %t3 = insertvalue {ptr, i64} %t3.s1, i64 5, 1
  ret {ptr, i64} %t3
match_arm3:
  %t4.ptr = getelementptr inbounds [4 x i8], ptr @str.2, i64 0, i64 0
  %t4.s1 = insertvalue {ptr, i64} undef, ptr %t4.ptr, 0
  %t4 = insertvalue {ptr, i64} %t4.s1, i64 4, 1
  ret {ptr, i64} %t4
match_merge0:
  %match_result5.dummy = alloca {ptr, i64}
  %match_result5 = load {ptr, i64}, ptr %match_result5.dummy
  ret {ptr, i64} %match_result5
}

define i32 @main() nounwind willreturn {
entry:
  %t0.ei1 = insertvalue %enum.Color undef, i64 0, 0
  %t0 = insertvalue %enum.Color %t0.ei1, ptr null, 1
  %c11.addr = alloca %enum.Color
  store %enum.Color %t0, ptr %c11.addr
  %t2.ei1 = insertvalue %enum.Color undef, i64 2, 0
  %t2 = insertvalue %enum.Color %t2.ei1, ptr null, 1
  %c23.addr = alloca %enum.Color
  store %enum.Color %t2, ptr %c23.addr
  %c1_val4 = load %enum.Color, ptr %c11.addr
  %t5 = call {ptr, i64} @color_name(%enum.Color %c1_val4)
  call void @__mn_str_println({ptr, i64} %t5)
  %c2_val7 = load %enum.Color, ptr %c23.addr
  %t8 = call {ptr, i64} @color_name(%enum.Color %c2_val7)
  call void @__mn_str_println({ptr, i64} %t8)
  ret i32 zeroinitializer
}

