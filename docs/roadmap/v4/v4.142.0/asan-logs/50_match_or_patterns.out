%enum.Token = type {i64, ptr}

define {ptr, i64} @category(%enum.Token %t) nounwind willreturn {
entry:
  %t.addr = alloca %enum.Token
  store %enum.Token %t, ptr %t.addr
  %t_val0 = load %enum.Token, ptr %t.addr
  %tag1 = extractvalue %enum.Token %t_val0, 0
  switch i64 %tag1, label %match_merge0 [
    i64 0, label %match_arm1
    i64 1, label %match_arm1
    i64 2, label %match_arm2
    i64 3, label %match_arm2
    i64 4, label %match_arm2
    i64 5, label %match_arm3
    i64 6, label %match_arm4
  ]
match_arm1:
  %t2.ptr = getelementptr inbounds [8 x i8], ptr @str.0, i64 0, i64 0
  %t2.s1 = insertvalue {ptr, i64} undef, ptr %t2.ptr, 0
  %t2 = insertvalue {ptr, i64} %t2.s1, i64 8, 1
  br label %match_merge0
match_arm2:
  %t3.ptr = getelementptr inbounds [14 x i8], ptr @str.1, i64 0, i64 0
  %t3.s1 = insertvalue {ptr, i64} undef, ptr %t3.ptr, 0
  %t3 = insertvalue {ptr, i64} %t3.s1, i64 14, 1
