  %t5.s1 = insertvalue {ptr, i64} undef, ptr %t5.ptr, 0
  %t5 = insertvalue {ptr, i64} %t5.s1, i64 4, 1
  br label %match_merge0
match_merge0:
  %match_result6 = phi {ptr, i64} [ %t2, %match_arm1 ], [ %t3, %match_arm2 ], [ %t4, %match_arm3 ], [ %t5, %match_arm4 ], [ zeroinitializer, %entry ]
  ret {ptr, i64} %match_result6
}

define i32 @main() nounwind willreturn {
entry:
