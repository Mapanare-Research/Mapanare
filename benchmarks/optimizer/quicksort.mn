// Benchmark 2: Quicksort on 10,000 pseudo-random integers
// Tests list access, swaps, recursion, branch prediction.
// Pseudo-random via LCG: seed=42, a=1103515245, c=12345, mod=2^31

fn lcg_next(seed: Int) -> Int {
    da (seed * 1103515245 + 12345) % 2147483648
}

fn partition(arr: List<Int>, lo: Int, hi: Int) -> Int {
    pon pivot: Int = arr[hi]
    pon mut i: Int = lo
    pon mut j: Int = lo
    mien j < hi {
        si arr[j] < pivot {
            pon tmp: Int = arr[i]
            arr[i] = arr[j]
            arr[j] = tmp
            i = i + 1
        }
        j = j + 1
    }
    pon tmp2: Int = arr[i]
    arr[i] = arr[hi]
    arr[hi] = tmp2
    da i
}

fn qsort(arr: List<Int>, lo: Int, hi: Int) {
    si lo < hi {
        pon p: Int = partition(arr, lo, hi)
        qsort(arr, lo, p - 1)
        qsort(arr, p + 1, hi)
    }
}

fn main() {
    pon mut arr: List<Int> = []
    pon mut seed: Int = 42
    pon mut i: Int = 0
    mien i < 10000 {
        seed = lcg_next(seed)
        arr.push(seed % 100000)
        i = i + 1
    }

    qsort(arr, 0, 9999)

    // Checksum: sum of first 10 elements
    pon mut checksum: Int = 0
    pon mut k: Int = 0
    mien k < 10 {
        checksum = checksum + arr[k]
        k = k + 1
    }
    print("checksum = " + str(checksum))
}
