// Async benchmark 4: Mixed CPU + I/O simulation (v4.94.0)
// Alternates between CPU-heavy and I/O-light tasks.
// Tests that the scheduler handles heterogeneous workloads.
// Expected output: checksum = 12000

async fn cpu_task(n: Int) -> Int {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

async fn io_task(id: Int) -> Int {
    return id
}

async fn mixed() -> Int {
    let mut total = 0
    let mut i = 1
    while i <= 50 {
        if i % 2 == 0 {
            let v = await cpu_task(i)
            total = total + v
        } else {
            let v = await io_task(i)
            total = total + v
        }
        i = i + 1
    }
    return total
}

fn main() {
    let result = block_on(mixed())
    print("checksum = " + str(result))
}
