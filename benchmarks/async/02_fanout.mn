// Async benchmark 2: Fan-out (v4.94.0)
// Spawns N independent CPU-bound async tasks, awaits all results.
// This is the best case for multi-threading — fully parallel.
// Expected output: checksum = 171700

async fn compute(n: Int) -> Int {
    // Sum 1..n (CPU work to keep the coroutine busy)
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    return total
}

async fn fanout() -> Int {
    // 100 independent tasks, each sums 1..i for i in 1..100
    // Total = sum(i*(i+1)/2 for i in 1..100) = 171700
    // Simplified: await sequentially (scheduler handles parallelism)
    let mut total = 0
    let mut i = 1
    while i <= 100 {
        let v = await compute(i)
        total = total + v
        i = i + 1
    }
    return total
}

fn main() {
    let result = block_on(fanout())
    print("checksum = " + str(result))
}
