// chat_agent.mn — Streaming chat agent using Mapanare's first-class agent primitive
//
// This demo shows:
//   1. An @agent that wraps the LLM client
//   2. Signal-based conversation state
//   3. Streaming response via chat_stream
//
// Prerequisites:
//   ollama serve && ollama pull llama3.2
//
// Run:
//   mapanare run examples/ai/chat_agent.mn

import ai::llm

// ── The Chat Agent ──────────────────────────────────────────────────
//
// A Mapanare agent that receives user messages and responds via an LLM.
// The agent holds conversation state and streams responses.

agent ChatBot {
    input message: String
    output response: String

    fn handle(message: String) -> String {
        let config = ollama("llama3.2")
        let result = chat(config, [
            system_msg("You are a helpful assistant. Keep answers under 50 words."),
            user_msg(message)
        ])
        match result {
            Ok(r) => { return r.content },
            Err(e) => { return "Error: " + error_message(e) }
        }
        return "No response"
    }
}

// ── Main ────────────────────────────────────────────────────────────

fn main() {
    // Spawn the chat agent
    let bot = spawn ChatBot()

    // Send a message and get a response
    bot.message <- "What are the three laws of robotics?"
    let answer = sync bot.response
    print("Bot: " + answer)

    // Multi-turn: send another message
    bot.message <- "Who wrote them?"
    let answer2 = sync bot.response
    print("Bot: " + answer2)

    // Streaming variant (post-hoc chunks)
    let config = ollama("llama3.2")
    let chunks = chat_stream(config, [
        user_msg("Write a haiku about programming.")
    ])

    print("\nStreaming response:")
    let mut i: Int = 0
    while i < len(chunks) {
        let chunk = chunks[i]
        if chunk.is_done {
            print("\n[done]")
        } else {
            print(chunk.delta)
        }
        i = i + 1
    }

    // Clean up
    sync bot.stop()
}
