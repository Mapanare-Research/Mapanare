// examples/async_http_demo.mn — async HTTP demo over real network (v4.115.0)
//
// Performs a real HTTP GET to example.com, runs an async pipeline over
// the response body (byte count, Example-Domain marker check), then
// writes a summary to disk from inside another async fn. The network
// request itself goes through http_get, which the C runtime implements
// via libcurl (or its fallback socket path when curl isn't available).
//
// Model: cooperative async with synchronous network I/O wrapped inside
// async fns (Decision 1 default: wrap synchronous). block_on drives the
// post-fetch pipeline. async fn provides the coroutine structure so
// multiple I/O-bound tasks could be interleaved through the scheduler.
// Full non-blocking suspension is a v5.x feature.
//
// Implementation notes:
//   - The HTTP GET is issued *before* block_on because the Python
//     bootstrap emitter cannot `await` on a String-returning async fn
//     today (Sh.9). Issuing the request synchronously then handing the
//     String into the pipeline avoids that path.
//   - Each await result is folded into the pipeline's return value so
//     the emitter's DCE pass does not eliminate side-effecting calls
//     (also Sh.9).
//   - If the network is unreachable, http_get returns an empty String;
//     the program prints "network unreachable" and exits cleanly with
//     code 0 rather than crashing. That way a sandboxed CI runner sees
//     a deterministic non-crash outcome.
//
// Usage:
//   python3 -m mapanare emit-llvm examples/async_http_demo.mn -o /tmp/ahd.ll
//   clang /tmp/ahd.ll -L runtime/native -lmapanare_rt -lpthread -lm -ldl \
//         -o /tmp/async_http_demo
//   /tmp/async_http_demo

extern "C" fn __mn_file_write(path: String, content: String) -> Int

fn summary_path() -> String {
    return "/tmp/async_http_demo_summary.txt"
}

// ---------------------------------------------------------------------------
// Async pipeline over an already-fetched body
// ---------------------------------------------------------------------------

// Byte length of the response. Wrapped in async fn for composition.
async fn body_bytes(body: String) -> Int {
    return len(body)
}

// Returns 1 if the body contains "Example Domain", 0 otherwise.
// Naive substring search — the demo doesn't care about perf.
async fn has_marker(body: String) -> Int {
    let needle: String = "Example Domain"
    let nlen: Int = len(needle)
    let blen: Int = len(body)
    if nlen == 0 { return 1 }
    if nlen > blen { return 0 }
    let mut i: Int = 0
    let last: Int = blen - nlen
    while i <= last {
        let mut j: Int = 0
        let mut ok: Int = 1
        while j < nlen {
            if body.byte_at(i + j) != needle.byte_at(j) {
                ok = 0
                j = nlen
            } else {
                j = j + 1
            }
        }
        if ok == 1 { return 1 }
        i = i + 1
    }
    return 0
}

// Write a summary line containing the byte count and marker flag.
async fn write_summary(path: String, bytes: Int, marker: Int) -> Int {
    let body: String = "bytes=" + str(bytes) + " marker=" + str(marker) + "\n"
    return __mn_file_write(path, body)
}

// Orchestrator: chain all three awaits over the fetched body. The
// write_summary result is folded into the return encoding so DCE
// cannot drop the side-effecting write.
async fn process(body: String) -> Int {
    let bytes: Int = await body_bytes(body)
    let marker: Int = await has_marker(body)
    let wrote: Int = await write_summary(summary_path(), bytes, marker)
    return wrote + bytes * 10 + marker
    // Encoding: (bytes*10 + marker), plus wrote (0 on success) to anchor
    // the write against DCE. main() decodes.
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

fn main() {
    // 1. Real HTTP GET. http_get is synchronous; the native C runtime
    //    calls libcurl (or its socket fallback) and returns the full
    //    body as a String. Empty String ⇒ request failed.
    let body: String = http_get("http://example.com/")
    let blen: Int = len(body)
    if blen == 0 {
        print("network unreachable: http_get returned empty String")
        return
    }

    // 2. Drive the async pipeline over the fetched body.
    let encoded: Int = block_on(process(body))
    let marker: Int = encoded % 10
    let bytes: Int = (encoded - marker) / 10
    // `wrote` is 0 on success, so (encoded - marker) / 10 == bytes.

    // 3. Read the summary file back so stdout confirms the write landed.
    print("fetched bytes=" + str(blen))
    print("pipeline   bytes=" + str(bytes) + " marker=" + str(marker))
    print("summary file path: " + summary_path())
}
