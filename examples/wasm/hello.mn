// Hello World — WebAssembly
// Compile: mapanare emit-wasm examples/wasm/hello.mn
// Run: load in browser via playground

fn fib(n: Int) -> Int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() {
    print("Hello from Mapanare on WASM!")
    print("The AI-native language, running in the browser.")
    let x: Int = fib(10)
    print("fib(10) = ")
    print(str(x))
}
