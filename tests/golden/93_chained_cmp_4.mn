// v5.21.0 Te.6 — 4-element chained comparison.
//
// `a < b < c < d` chains three pairwise comparisons joined by `&&`.
// Mixed-direction chains are also legal (`a < b > c`), each
// adjacent pair evaluated independently — this golden covers the
// uniform-direction case; mixed directions are exercised in a
// dedicated golden.

fn ascending(a: Int, b: Int, c: Int, d: Int) -> Bool:
    return a < b < c < d

fn main():
    print(str(ascending(1, 2, 3, 4)))
    print(str(ascending(1, 2, 2, 4)))
    print(str(ascending(4, 3, 2, 1)))
