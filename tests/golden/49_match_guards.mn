fn classify(n: Int) -> String {
    match n {
        x if x < 0 => "negative",
        0 => "zero",
        x if x > 0 && x < 10 => "small",
        x if x >= 10 => "large",
        _ => "unreachable"
    }
}

fn main() {
    print(classify(-5))
    print(classify(0))
    print(classify(3))
    print(classify(42))
}
