// v4.101.0 regression: list.push of a heap-allocated string across a
// function boundary must not free the string via drop glue. Before the
// fix, the pushed element's data pointer was freed at function exit,
// so downstream readers of the list saw use-after-free garbage — the
// signature of this bug was a 16-byte prefix of random bytes on every
// string that had been pushed then inspected later via join(). This
// is the minimal reproducer.

struct St:
    lines: List<String>
    n: Int

fn emit_line(st: St, line: String) -> St:
    let mut s: St = st
    s.lines.push(line)
    return s

fn add_decl(st: St, name: String, ret: String) -> St:
    let mut s: St = st
    let line: String = "declare " + ret + " @" + name + "()"
    return emit_line(s, line)

fn main():
    let empty: List<String> = []
    let st0: St = new St { lines: empty, n: 0 }
    let mut st: St = st0
    st = add_decl(st, "foo", "i64")
    st = add_decl(st, "bar", "void")
    st = add_decl(st, "baz", "double")
    let out: String = join("\n", st.lines)
    print(out)
