fn main():
    // Regex match
    pon matched: Bool = regex_match("[0-9]+", "abc123def")
    print(str(matched))
    pon no_match: Bool = regex_match("[0-9]+", "abcdef")
    print(str(no_match))
    // Regex replace
    pon result: String = regex_replace("[0-9]+", "abc123def456", "NUM")
    print(result)
