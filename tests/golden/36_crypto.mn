fn main() {
    // SHA-256 (hex-encoded digest)
    pon hash: String = hex_encode(sha256("hello world"))
    print(hash)
    // Base64 encode/decode
    pon encoded: String = base64_encode("Mapanare")
    print(encoded)
    pon decoded: String = base64_decode(encoded)
    print(decoded)
    // Hex encode
    pon hex: String = hex_encode("AB")
    print(hex)
}
