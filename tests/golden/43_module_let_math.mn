// Golden test: module-level `let` used as named constants in arithmetic.
//
// v4.27.0 Path B recovery: replaces the former 43_gpu_kernel.mn. That file
// used the `const` keyword plus a "gpu kernel params" label but did not
// actually test GPU dispatch (which goes through the gpu_tensor_* builtins,
// not a source-level decorator). The `@gpu` / `@cuda` / `@vulkan` decorators
// were removed in v4.27.0.

let BLOCK_SIZE: Int = 256
let GRID_SIZE: Int = 1

fn compute_threads() -> Int {
    return BLOCK_SIZE * GRID_SIZE
}

fn main() {
    print(compute_threads())
    print("threads computed via module let")
}
