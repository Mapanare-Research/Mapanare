// Golden test: async fn + await — value flows through async pipeline.
// async fn runs synchronously (single-threaded mode), await unwraps result.

async fn compute(x: Int) -> Int {
    return x * 2
}

async fn greet(name: String) -> String {
    return "Hello, " + name + "!"
}

fn main() {
    let result: Int = await compute(21)
    print(result)
    print("\n")
    let msg: String = await greet("Mapanare")
    print(msg)
    print("\n")
}
