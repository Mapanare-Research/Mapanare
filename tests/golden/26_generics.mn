// tests/golden/26_generics.mn — Generic function + struct monomorphization

fn identity<T>(x: T) -> T {
    return x
}

fn first<A, B>(a: A, b: B) -> A {
    return a
}

struct Pair<A, B> {
    first: A,
    second: B
}

fn main() {
    let a: Int = identity(42)
    print(a)
    let b: Bool = identity(true)
    print(b)
    let c: Int = first(10, 20)
    print(c)

    // Generic struct
    let p = new Pair { first: 100, second: true }
    print(p.first)
}
