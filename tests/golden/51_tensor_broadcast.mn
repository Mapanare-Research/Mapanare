// Golden test: tensor broadcasting (v4.44.0)
//
// Tests NumPy-style broadcasting for +, -, *, / with same-shape,
// row+column, rank extension, and scalar broadcasts.

fn main():
    // Same-shape addition
    let a = Tensor<Float>[[1.0, 2.0], [3.0, 4.0]]
    let b = Tensor<Float>[[10.0, 20.0], [30.0, 40.0]]
    let c = a + b
    print(str(tensor_get_f64(c, 0)))
    print(str(tensor_get_f64(c, 3)))

    // Subtraction
    let d = b - a
    print(str(tensor_get_f64(d, 0)))
    print(str(tensor_get_f64(d, 3)))

    // Multiplication
    let e = a * b
    print(str(tensor_get_f64(e, 0)))

    // Division
    let f = b / a
    print(str(tensor_get_f64(f, 0)))

    // Scalar + tensor
    let g = a + 100.0
    print(str(tensor_get_f64(g, 0)))
    print(str(tensor_get_f64(g, 3)))

    // Tensor * scalar
    let h = a * 2.0
    print(str(tensor_get_f64(h, 0)))
    print(str(tensor_get_f64(h, 3)))

    // Integer tensor ops
    let ia = Tensor<Int>[10, 20, 30]
    let ib = Tensor<Int>[1, 2, 3]
    let ic = ia + ib
    print(str(tensor_get_i64(ic, 0)))
    print(str(tensor_get_i64(ic, 2)))

// Expected output:
// 11
// 44
// 9
// 36
// 10
// 10
// 101
// 104
// 2
// 8
// 11
// 33
