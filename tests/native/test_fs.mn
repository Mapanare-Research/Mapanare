// tests/native/test_fs.mn — File system tests using native test runner
// Uses C runtime functions directly (stdlib::fs wrappers have Result ABI issues)

usa stdlib::test::runner

extern "C" fn __mn_file_write(path: String, content: String) -> Int
extern "C" fn __mn_file_exists(path: String) -> Int
extern "C" fn __mn_file_remove(path: String) -> Int
extern "C" fn __mn_file_size(path: String) -> Int

fn main() -> Int {
    let mut pass: Int = 0
    let mut fail: Int = 0
    let mut r: Int = 0

    let path: String = "/tmp/mapanare_test_fs.txt"
    let content: String = "hello from mapanare"

    // --- write ---
    let wr: Int = __mn_file_write(path, content)
    r = check_eq("write returns 0", wr, 0)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // --- exists ---
    let ex: Int = __mn_file_exists(path)
    r = check_eq("exists after write", ex, 1)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // --- read ---
    let data: String = __mn_file_read_or_empty(path)
    r = check_eq_str("read content", data, content)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // --- size ---
    let sz: Int = __mn_file_size(path)
    r = check_eq("file size", sz, 19)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // --- remove ---
    let rm: Int = __mn_file_remove(path)
    r = check_eq("remove returns 0", rm, 0)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // --- not exists after remove ---
    let ex2: Int = __mn_file_exists(path)
    r = check_eq("not exists after remove", ex2, 0)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    return test_report(pass, fail)
}
