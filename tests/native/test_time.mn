// tests/native/test_time.mn — Time stdlib tests using native test runner
// Note: now_ns/delay_ms/stopwatch require __mn_clock_monotonic_ns (not in C runtime yet).
// Testing pure conversion functions only.

usa stdlib::test::runner
usa stdlib::time

fn main() -> Int {
    let mut pass: Int = 0
    let mut fail: Int = 0
    let mut r: Int = 0

    // --- unit conversions ---
    r = check_eq("ns_to_ms(1000000)", ns_to_ms(1000000), 1)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq("ms_to_ns(1)", ms_to_ns(1), 1000000)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq("ns_to_s(1000000000)", ns_to_s(1000000000), 1)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq("s_to_ns(1)", s_to_ns(1), 1000000000)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq("ns_to_ms(0)", ns_to_ms(0), 0)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq("ns_to_ms(500000)", ns_to_ms(500000), 0)
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    // --- format_duration_ms ---
    r = check_eq_str("format_duration_ms(0)", format_duration_ms(0), "0ms")
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq_str("format_duration_ms(500)", format_duration_ms(500), "500ms")
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq_str("format_duration_ms(1500)", format_duration_ms(1500), "1.5s")
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq_str("format_duration_ms(2000)", format_duration_ms(2000), "2s")
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq_str("format_duration_ms(60000)", format_duration_ms(60000), "1m")
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }
    r = check_eq_str("format_duration_ms(61000)", format_duration_ms(61000), "1m 1s")
    if r == 1 { pass = pass + 1 } else { fail = fail + 1 }

    return test_report(pass, fail)
}
