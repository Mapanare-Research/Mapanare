// Loop ownership regression: expected output 3000, with bounded memory.
// No aliases of a result survive to the next factory call.
fn make_values() -> Map<String, Int>:
    return #{"a": 1, "bb": 2, "ccc": 3}

fn main():
    let mut total: Int = 0
    for i in 0..1000:
        let values = make_values()
        total = total + len(values)
    print(total)
