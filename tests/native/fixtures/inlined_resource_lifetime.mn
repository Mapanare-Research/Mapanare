// Regression: score must retain its cleanup boundary inside main's loop.
// Inlining its allocations used to overwrite function-exit ownership slots.
fn measure(text: String, values: List<Int>) -> Int:
    if len(values) > 0:
        return len(text) + values[0]
    return 0

fn score(n: Int) -> Int:
    let text: String = "item-" + str(n)
    let values: List<Int> = [n, 1]
    return measure(text, values) + measure(text, values) + values[0]

fn main():
    let mut total: Int = 0
    for i in 0..1000:
        total = total + score(i)
    print(total)
