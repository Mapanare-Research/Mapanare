# v4.32.0 Phase 2.1: libmapanare_rt.a is produced by `make build-rt`
# from runtime/native/*.c. A committed copy is source-clean, artifact-
# stale (Boa M1 at the v4.31.0 arc-end panel caught the committed
# archive carrying __mn_list_oob_buf after the source had removed it).
# The archive lives in runtime/native/ at build time but never in the
# tree.
runtime/native/*.a
runtime/native/libmapanare_rt.a

# Vendored portable toolchain (w64devkit) — downloaded by CI into toolchain/
# before PyInstaller runs, or by developers for local release-bundle testing.
# Never commit; this is ~200MB and platform-specific.
/toolchain/
/.tmp-tc/
/.tmp-toolchain-dl/
/.tmp-llvm/
/.tmp_probe.py
/tmp_smoke_*.mn
/tmp_smoke_*.py
/tmp_smoke_*.exe
/tmp_smoke_*.obj
mapanare/self/*.o
mapanare/self/mnc-stage1
mapanare/self/mnc-stage1.exe
mapanare/self/mnc-stage1-*
mapanare/self/mnc-stage2*
mapanare/self/mnc-stage3*
# v4.29.0: stage2.ll / stage3.ll are produced fresh by
# scripts/verify_fixed_point.sh on every run (to /tmp/). Any checked-in
# copy is a stale snapshot waiting to become a lie — the v4.17.0
# "fixed-point bootstrap" claim shipped with a zero-byte
# mapanare/self/stage3.ll from March 21, 2026 that predated v4.20.0
# (v4.26.0 panel: Cobra #4). Ignore them so they can never again be a
# "lie waiting to happen".
mapanare/self/stage2.ll
mapanare/self/stage3.ll
# main.ll is the concatenated stage1 source emitted by build_stage1.py;
# regenerable on every build, was committed at >100MB and broke push.
mapanare/self/main.ll
tmp*.py
